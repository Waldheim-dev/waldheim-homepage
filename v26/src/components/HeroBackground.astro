---
const { title, subtitle, image } = Astro.props;
---

<div class="relative isolate">
    <div aria-hidden="true" class="absolute inset-0 flex justify-center items-center p-12">
        <figure class="rounded-3xl overflow-hidden relative w-full h-full">
            <img src={image} class="object-contains w-full" alt="" />
        </figure>
    </div>
    <div class="py-24 sm:py-32 lg:pb-40 z-10 relative">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-2xl text-center bg-white/30 p-12 rounded-3xl border-1 border-white/30 shadow-md shadow-white/30 backdrop-blur-md ">
                <h1 class="text-balance text-5xl font-semibold tracking-tight text-gray-900 dark:text-slate-200 sm:text-7xl">{title}</h1>
                <p class="mt-8 text-pretty text-lg font-medium text-gray-800 dark:text-slate-400 sm:text-xl/8">{subtitle}</p>
                <slot />
            </div>
        </div>
    </div>
</div>