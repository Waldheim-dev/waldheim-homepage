---
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pricing from '../../../components/content/Pricing.astro';
import Partner from '../../../components/content/Partner.astro';
import { SchemaUtils } from '../../../utils/schema';
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home'
}, {
  name: 'Service'
}, {
  name: 'DevOps',
  link: Astro.url.href
}]);

const titel = 'DevSecOps Services - Automatisierung & Sicherheit - waldheim.dev';
const description = 'Optimieren Sie Ihre Softwareentwicklung mit DevSecOps: Automatisierung, Sicherheit und Effizienz für GitHub & GitLab. Wir beschleunigen Ihre Entwicklungsprozesse';
const keywords = 'DevSecOps, DevOps, Continuous Integration, Continuous Delivery, CI/CD, Automatisierung, GitHub, GitLab, Sicherheit, Softwareentwicklung';
---

<BaseLayout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <div class="relative">
    <div class="mx-auto max-w-7xl lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-8">
      <div
        class="px-6 pb-24 pt-10 sm:pb-32 lg:col-span-7 lg:px-0 lg:pb-56 lg:pt-48 xl:col-span-6"
      >
        <div class="mx-auto max-w-2xl lg:mx-0">
          <div class="hidden sm:mt-32 sm:flex lg:mt-16">
            <div
              class="relative rounded-full px-3 py-1 text-sm leading-6 text-gray-500 dark:text-gray-400 ring-1 ring-gray-900/10 hover:ring-gray-900/20 dark:ring-gray-50/10 dark:hover:ring-gray-50/20"
            >
              Sichere und automatisierte Softwareentwicklung – meine Expertise für Ihren Erfolg
            </div>
          </div>
          <h1
            class="mt-24 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:mt-10 sm:text-6xl"
          >
            DevSecOps & GitOps: Ich mache Ihre Entwicklung schneller, sicherer und effizienter
          </h1>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Ich unterstütze Sie bei der Optimierung Ihrer Entwicklungsprozesse. Mit DevSecOps und GitOps automatisiere
            ich Ihre Abläufe, erhöhe die Sicherheit Ihrer Anwendungen und verkürze die Time-to-Market. Keine
            Einheitslösung, sondern maßgeschneiderte Strategien, die zu Ihrem Unternehmen passen.
          </p>
          <div class="mt-10 flex items-center justify-start flex-wrap gap-x-6">
            <a
              href="mailto:kontakt@waldheim.dev"
              class="flex gap-1 rounded-md bg-primary-600 dark:bg-emerald-800 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 dark:hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
            >Jetzt beraten lassen
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="animate-pulse w-5 h-5"
              >
                <path
                  d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
                ></path>
                <path
                  d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <div
        class="relative lg:col-span-5 lg:-mr-8 xl:absolute xl:inset-0 xl:left-1/2 xl:mr-0"
      >
        <img
          class="aspect-3/2 w-full bg-gray-50 object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full lg:rounded-bl-4xl"
          src="https://images.unsplash.com/photo-1631624210938-539575f92e3c?q=80&w=2187&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2102&q=80"
          alt=""
        />
      </div>
    </div>
  </div>

  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:text-center">
        <h2
          class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600"
        >
          DevSecOps: Mehr als nur ein Buzzword – mein Ansatz
        </h2>
        <p
          class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl"
        >
          Zeitersparnis durch Optimierung
        </p>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
          Ich helfe Ihnen, das volle Potenzial von DevSecOps auszuschöpfen. Profitieren Sie von:
        </p>
      </div>
      <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
        <dl
          class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16"
        >
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800"
              >
                <i class="fa-regular text-white fa-circle-nodes"></i>
              </div>
              Containerisierung (Docker & Kubernetes)
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Ich sorge für isolierte, skalierbare und portable Anwendungen – egal ob on-premise oder in der Cloud.
            </dd>
          </div>
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800"
              >
                <i class="fa-regular text-white fa-brain"></i>
              </div>
              Künstliche Intelligenz (KI)
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Ich integriere KI-gestützte Tools zur Prozessoptimierung, Code-Analyse und Qualitätssicherung – DSGVO-konform.
            </dd>
          </div>
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800"
              >
                <i class="fa-regular text-white fa-shield"></i>
              </div>
              Security-Automatisierung
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Ich implementiere automatisierte Sicherheitschecks in jeder Phase des Entwicklungsprozesses – für sichere Software von Anfang an.
            </dd>
          </div>
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800"
              >
                <i class="fa-regular text-white fa-flask-vial"></i>
              </div>
              CI/CD & Testautomatisierung
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Ich beschleunige Ihre Entwicklungszyklen durch automatisierte Builds, Tests und Deployments. So können Sie sich auf das Wesentliche konzentrieren: Ihre Software.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
      <h2 class="text-base/7 font-semibold text-primary-600 dark:text-emerald-600">Schnelleres Deployment, höhere Qualität – meine Leistungen</h2>
      <p
        class="mt-2 max-w-lg text-pretty text-4xl font-medium tracking-tight text-gray-950 dark:text-white sm:text-5xl">
        Ich optimiere Ihren gesamten Deployment-Prozess – von der Entwicklung bis zum Betrieb.</p>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
        <div class="relative lg:col-span-3">
          <div
            class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
          <div
            class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-t-[calc(2rem+1px)] lg:rounded-tl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left"
                 src="/bento/bento-01-performance.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Performance-Optimierung</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Bauen in
                Lichtgeschwindigkeit</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Ich analysiere und optimiere Ihre Build-Prozesse, um maximale Geschwindigkeit und Effizienz zu erreichen.</p>
            </div>
          </div>
          <div
            class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-3">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 lg:rounded-tr-[2rem]"></div>
          <div
            class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] lg:rounded-tr-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left lg:object-right"
                 src="/bento/bento-01-releases.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Automatisierte Releases</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Schnelle
                Deployments</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Ich richte vollautomatische Release-Pipelines ein, die häufige, zuverlässige und qualitativ hochwertige Software-Updates ermöglichen.</p>
            </div>
          </div>
          <div
            class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 lg:rounded-tr-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 lg:rounded-bl-[2rem]"></div>
          <div
            class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] lg:rounded-bl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left"
                 src="/bento/bento-01-speed.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Skalierbarkeit & Flexibilität</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Gemacht für
                Powerusers</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Ich mache Ihre Infrastruktur fit für die Zukunft – skalierbar, flexibel und ortsunabhängig.</p>
            </div>
          </div>
          <div
            class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 lg:rounded-bl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 "></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)]">
            <img class="h-80 object-cover object-center"
                 src="/bento/bento-01-integrations.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Tool-Integration</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Nutze die Power deiner
                Tools</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Ich sorge für eine nahtlose Zusammenarbeit Ihrer Entwicklungstools – für einen effizienten Workflow.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div
            class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
          <div
            class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-b-[calc(2rem+1px)] lg:rounded-br-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-center"
                 src="/bento/bento-01-network.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Ortsunabhängig</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Global entwickeln und
                nutzen</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Frei von Orten kannst du sicher und
                stabil arbeiten.</p>
            </div>
          </div>
          <div
            class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
        </div>
      </div>
    </div>
  </div>


  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600">
          Deployment-Strategien im Vergleich – meine Empfehlungen
        </h2>
        <p
          class="mt-2 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Welches Deployment kann was?
        <p></p>
        <p
          class="mx-auto mt-6 max-w-2xl text-center text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          Ich helfe Ihnen, die passende Deployment-Methode für Ihre Anforderungen zu finden. Hier ein Überblick:
        </p>

        <!-- lg+ -->
        <div class="isolate mt-20">
          <div class="relative -mx-8">
            <div class="absolute inset-x-4 inset-y-0 -z-10 flex">
              <div
                class="flex w-1/4 px-4"
                style="margin-left: 75%"
                aria-hidden="true"
              >
                <div
                  class="w-full rounded-t-xl border-x border-t border-gray-900/10 bg-gray-400/5 dark:border-gray-50/10 dark:bg-slate-900/60"
                >
                </div>
              </div>
            </div>
            <table
              class="w-full table-fixed border-separate border-spacing-x-8 text-left"
            >
              <caption class="sr-only">Deployment Vergleiche (vereinfachte Darstellung)</caption>
              <colgroup>
                <col class="w-1/4" />
                <col class="w-1/4" />
                <col class="w-1/4" />
                <col class="w-1/4" />
              </colgroup>
              <thead>
              <tr>
                <td></td>
                <th scope="col" class="px-6 pt-6 xl:px-8 xl:pt-8">
                  <div
                    class="text-sm font-semibold leading-7 text-gray-900 dark:text-white"
                  >
                    Native (Skripte/SSH)
                  </div>
                </th>
                <th scope="col" class="px-6 pt-6 xl:px-8 xl:pt-8">
                  <div
                    class="text-sm font-semibold leading-7 text-gray-900 dark:text-white"
                  >
                    Docker
                  </div>
                </th>
                <th scope="col" class="px-6 pt-6 xl:px-8 xl:pt-8">
                  <div
                    class="text-sm font-semibold leading-7 text-gray-900 dark:text-white"
                  >
                    Kubernetes (Cluster)
                  </div>
                </th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <th
                  scope="colgroup"
                  colspan="4"
                  class="pb-4 pt-8 text-sm font-semibold leading-6 text-gray-900 dark:text-white"
                >
                  Features
                  <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/10 dark:bg-white/10">
                  </div>
                </th>
              </tr>
              <tr>
                <th
                  scope="row"
                  class="py-4 text-sm font-normal leading-6 text-gray-900 dark:text-white"
                >
                  Deployment-Prinzip
                  <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/5 dark:bg-white/5">
                  </div>
                </th>
                <td class="px-6 py-4 xl:px-8">
                  <div class="text-center text-sm leading-6 text-gray-500">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="mx-auto h-5 w-5 text-gray-400"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z"
                      ></path>
                    </svg>

                    <span class="sr-only">Manuell / Push (CI/CD)</span>
                  </div>
                </td>
                <td class="px-6 py-4 xl:px-8">
                  <div class="text-center text-sm leading-6 text-gray-500">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="mx-auto h-5 w-5 text-gray-400"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"
                      ></path>
                    </svg>

                    <span class="sr-only">Push (CI/CD)</span>
                  </div>
                </td>
                <td class="px-6 py-4 xl:px-8">
                  <div
                    class="text-center text-sm leading-6 text-gray-500"
                    title="Pull-Prinzip mit Flux"
                  >
                  </div>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    class="mx-auto h-5 w-5 text-gray-400"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
                    ></path>
                  </svg>
                  <span class="sr-only">Pull (GitOps, z.B. Flux)</span>
                </td>
              </tr>
              </tbody>
              <tr>
                <th
                  scope="row"
                  class="py-4 text-sm font-normal leading-6 text-gray-900 dark:text-white"
                >
                  Einrichtungszeit
                  <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/5 dark:bg-white/5">
                  </div>
                </th>
                <td class="px-6 py-4 xl:px-8">
                  <div class="text-center text-sm leading-6 text-gray-500">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                         stroke="currentColor"
                         class="mx-auto h-5 w-5 text-gray-400">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M15.042 21.672 13.684 16.6m0 0-2.51 2.225.569-9.47 5.227 7.917-3.286-.672ZM12 2.25V4.5m5.834.166-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243-1.59-1.59" />
                    </svg>
                    <span class="sr-only">Hoch</span>
                  </div>
                </td>
                <td class="px-6 py-4 xl:px-8">
                  <div class="text-center text-sm leading-6 text-gray-500">
                    <img src="/brands/docker-icon.svg" class="mx-auto h-5 w-5" alt="Docker" />
                    <span class="sr-only">Mittel</span>

                  </div>
                </td>
                <td class="px-6 py-4 xl:px-8">
                  <div class="text-center text-sm leading-6 text-gray-500">
                    <img src="/brands/kubernetes.svg" class="mx-auto h-5 w-5" alt="Docker" />
                    <span class="sr-only">Hoch (aber langfristige Vorteile)</span>

                  </div>
                </td>
              </tr>
              <tr>
                <th
                  scope="row"
                  class="py-4 text-sm font-normal leading-6 text-gray-900 dark:text-white"
                >
                  Entwicklungsumgebung
                  <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/5 dark:bg-white/5">
                  </div>
                </th>
                <td class="px-6 py-4 xl:px-8">
                  <svg
                    class="mx-auto h-5 w-5 text-primary-600 dark:text-emerald-600"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"></path>
                  </svg>
                  <span class="sr-only">Enthalten</span>
                </td>
                <td class="px-6 py-4 xl:px-8">
                  <svg
                    class="mx-auto h-5 w-5 text-primary-600 dark:text-emerald-600"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
