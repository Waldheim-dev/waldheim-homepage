---
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import KarriereProject from '../../components/KarriereProject.astro';
import Pricing from '../../components/content/Pricing.astro';
import { SchemaUtils } from '../../utils/schema';

const SITE_TITLE = 'Waldheim.dev - Über mich';
const SITE_DESCRIPTION = "Erfahre mehr über mich und meine Karriere. Als Entwickler und DevSecOps-Spezialist bin ich immer nah am Geschehen. Ich teile gerne immer mein Wissen und häufe es weiter an.";

const karriere = (await getCollection('karriere')).sort(
  (a, b) => b.data.from.valueOf() - a.data.from.valueOf()
);

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home'
}, {
  name: 'Über mich',
  link: Astro.url.href
}]);


const titel = "Über mich - waldheim.dev: IT-Experte Markus Waldheim"
const description = "Lernen Sie mich kennen: Markus Waldheim, IT-Experte mit Leidenschaft für Qualität. Mein Werdegang, meine Skills und meine Projekte. Ihr Partner für IT-Lösungen in Augsburg, München und darüber hinaus."
const keywords = "Über mich, Markus Waldheim, IT-Experte, Lebenslauf, Skills, Erfahrung, Projekte, Werdegang, Persönlich, Augsburg, München"

---

<BaseLayout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>

  <div class='relative isolate overflow-hidden bg-linear-to-b from-primary-100/20 pt-14'>
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-linear-to-tr from-[#97bea0] to-[#6b9e78] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
    <div class='mx-auto max-w-7xl px-6 py-32 sm:py-40 lg:px-8'>
      <div class='mx-auto max-w-2xl lg:mx-0 lg:grid lg:max-w-none lg:grid-cols-2 lg:gap-x-16 lg:gap-y-6 xl:grid-cols-1 xl:grid-rows-1 xl:gap-x-8'>
        <h1 class='max-w-2xl text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl lg:col-span-2 xl:col-auto'>Erfahrener IT-Experte mit Leidenschaft für Qualität und Innovation</h1>
        <div class='mt-6 max-w-xl lg:mt-0 xl:col-end-1 xl:row-start-1'>
          <p class='text-lg leading-8 text-gray-600 dark:text-slate-300'>Als Entwickler und DevSecOps-Spezialist mit über 10 Jahren Erfahrung teile ich mein Wissen und unterstütze Unternehmen bei der Optimierung ihrer IT-Prozesse.</p>

          <div class='mt-10 flex items-center flex-wrap gap-x-6'>
            <a
              href='mailto:kontakt@waldheim.dev'
              class='flex gap-1 rounded-md bg-primary-600 dark:bg-emerald-800 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600'
            >Kostenloses Erstgespräch
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="animate-pulse w-5 h-5"
              >
                <path
                  d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
                ></path>
                <path
                  d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
                ></path>
              </svg>
            </a>
            <a
              href="/referenzen/"
              class="flex gap-1 text-sm font-semibold leading-6 text-primary-900 dark:text-white"
            >Meine Referenzen
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"></path>
              </svg>
            </a>
          </div>
        </div>
        <figure class='mt-10 aspect-square w-full max-w-lg rounded-2xl sm:mt-16 lg:mt-0 lg:max-w-none xl:row-span-2 xl:row-end-2 xl:mt-36 overflow-hidden'>
          <img src="/markus_waldheim_if.jpg" alt="Markus Waldheim" class="object-cover h-full w-full" loading="lazy"/>
        </figure>
      </div>
    </div>
    <div class='absolute inset-x-0 bottom-0 -z-10 h-24 bg-linear-to-t from-white dark:from-slate-950  sm:h-32'></div>
  </div>

  <div class='py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl lg:mx-0 lg:max-w-none'>
        <h2 class='text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl'>Mein Antrieb: Effizienz und Innovation</h2>
        <div class='mt-6 flex flex-col gap-x-8 gap-y-20 lg:flex-row'>
          <div class='lg:w-full lg:max-w-2xl lg:flex-auto'>
            <p class='text-xl leading-8 text-gray-600 dark:text-slate-400'>Ich bin überzeugt, dass Prozesse kontinuierlich optimiert und beschleunigt werden können. Mein Ziel ist es, Verschwendung zu vermeiden und die bestmöglichen Ergebnisse zu erzielen.</p>
            <p class='mt-10 max-w-xl text-base leading-7 text-gray-700 dark:text-slate-300'>Ob durch die Entwicklung maßgeschneiderter Tools zur Analyse und Optimierung oder durch die Umgestaltung und Automatisierung Ihrer Entwicklungsprozesse – ich finde die effizienteste Lösung für Ihre Anforderungen.</p>
          </div>
          <div class='lg:flex lg:flex-auto lg:justify-center'>
            <dl class='w-64 space-y-8 xl:w-80'>
              <div class='flex flex-col-reverse gap-y-4'>
                <dt class='text-base leading-7 text-gray-600 dark:text-slate-400'>Produktivitätssteigerung durch KI-gestützte Tools</dt>
                <dd class='text-5xl font-semibold tracking-tight text-gray-900 dark:text-white'>+150%</dd>
              </div>
              <div class='flex flex-col-reverse gap-y-4'>
                <dt class='text-base leading-7 text-gray-600 dark:text-slate-400'>Bevorzugte Projektmethode</dt>
                <dd class='text-5xl font-semibold tracking-tight text-gray-900 dark:text-white'>Scrum</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="px-6 py-24 sm:py-32 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600">Mein beruflicher Weg</p>
      <h2 class="mt-2 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">Karriere-Highlights</h2>
      <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-slate-400 ">Hier ist ein Überblick über meine bisherigen beruflichen Stationen und aktuellen Projekte.  Diese Informationen spiegeln meine persönliche Erfahrung wider.</p>
    </div>
    <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 lg:py-40 divide-y divide-gray-900/10  dark:divide-white/10">
      { karriere.map(kar => (  /*  Ersetze 'karriere' und 'kar' durch deine tatsächlichen Variablen-Namen */
        <div class="mx-auto max-w-4xl pb-12 divide-y divide-gray-900/10">
          <div class="mx-auto">
            <p class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600"><FormattedDate date={kar.data.from} /> - {kar.data.to ? (<FormattedDate date={kar.data.to} />) : ('heute')}
            </p>
            <h2 class="text-2xl font-bold leading-10 tracking-tight text-gray-900 dark:text-white">{kar.data.company}</h2>
            <p class="text-base leading-7 text-gray-600 dark:text-slate-400 font-medium">{kar.data.position}</p>
            <p class="text-base leading-7 text-gray-600 dark:text-slate-400 ">{kar.data.description}</p>
          </div>
          { kar.data.projects && (
            <KarriereProject projects={kar.data.projects} /> /* Ersetze 'KarriereProject' durch deine tatsächliche Komponente */
          )}
        </div>
      ))}
    </div>
  </div>



  <Pricing />
</BaseLayout>