---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';


const { title, description, pubDate, heroImage } = Astro.props;


const blogPosts = (await getCollection('blog',(data) => data.slug !== Astro.params.slug)).sort(
(a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate)
)
---
<style>
    h1 {
        font-size: 3rem !important;
        line-height: 4rem !important;
        font-weight: bold !important;
    }

    h2 {
        font-size: 1.5rem !important;
        line-height: 2.5rem !important;
        font-weight: bold !important;
    }

    p {
        margin: 1rem 0 !important;
    }
</style>

<BaseLayout title={title} description={description}>

  <div class='bg-white  dark:bg-slate-800 px-6 py-6 lg:px-8'>
    <div class='mx-auto max-w-3xl text-base leading-7 text-gray-700 dark:text-gray-300'>
      {heroImage && <img width={720} height={360} src={heroImage} loading='lazy' alt=''  class='aspect-[7/4] w-full rounded-2xl object-cover'/>}
      <h1 class='mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-50'>{title}</h1>

      <div class="relative mt-6">
        <FormattedDate date={pubDate} /><br>
        {description}
      </div>
      <div class="relative mt-6">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-gray-300"></div>
        </div>
      </div>
      <div class="mt-16 prose dark:prose-invert">
        <slot />
      </div>

      <div class='relative mt-6'>
        <div class='absolute inset-0 flex items-center' aria-hidden='true'>
          <div class='w-full border-t border-gray-300'></div>
        </div>
      </div>
    </div>
  </div>



  <div class='bg-white dark:bg-slate-800 py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl text-center'>
        <h2 class='text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl'>Neuigkeiten</h2>
        <p class='mt-2 text-lg leading-8 text-gray-600 dark:text-gray-300'>Bleibe auf dem neusten und schaue dir an, was es alles neues gibt. Top Themen und Unternehmen-Highlights.</p>
      </div>
      <div
        class='mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3'>


        {
          blogPosts.map(async (post) => {

            return (
              <a href={`/blog/${post.slug}/`}>
                <article
                  class='relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 pt-80 sm:pt-48 lg:pt-80'>
                  <img
                    src={post.data.heroImage} loading='lazy'
                    alt={post.data.title} class='absolute inset-0 -z-10 h-full w-full object-cover'>
                  <div class='absolute inset-0 -z-10 rounded-2xl ring-1 ring-inset ring-gray-900/10'></div>

                <div class="relative isolate flex flex-col bg-slate-900/40  backdrop-blur-sm justify-end p-8 pt-4">
                  <div class='flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300'>
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  <h3 class='mt-3 text-lg font-semibold leading-6 text-white'>
                    <span class='absolute inset-0'></span>
                    {post.data.title}
                  </h3>
                  <p
                    class='flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300 line-clamp-2'>{post.data.description}</p>
                    </div>
                </article>
              </a>
              );
              })
              }
              </div>
              </div>
              </div>
</BaseLayout>
