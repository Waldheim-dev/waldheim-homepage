---
import '../styles/tailwind.css';
import '../styles/styles.scss';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { ClientRouter } from 'astro:transitions';
import { Schema } from 'astro-seo-schema';
import { SchemaUtils } from '../utils/schema';

export interface Props {
  title: string;
  description: string;
  image?: string;
  keywords?: string;
  schema?: any[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organisationSchema = SchemaUtils.getOrganizationSchema({
  name: 'Waldheim.dev',
  url: Astro.url.href,
  logo: new URL('/waldheim.dev.svg', Astro.url).href,
  description: 'Waldheim.dev - Design, Beratung und Entwicklung',
  email: 'kontakt@waldheim.dev',
  address: {
    streetAddress: 'Werner-Haas-Str. 8',
    postalCode: '86153',
    addressLocality: 'Augsburg',
    addressCountry: 'DE',
    addressRegion: 'Bayern',
  },
});


const softwareApplicationEcoFree = SchemaUtils.getSoftwareApplicationSchema({
  name: "Ecodrive Free",
  applicationCategory: "UtilityApplication",
  operatingSystem: "WebApplication",
  price: 0.00,
  priceCurrency: "EUR",
  billingFrequency: "P1M",
})

const softwareApplicationEcoBasic = SchemaUtils.getSoftwareApplicationSchema({
  name: "Ecodrive Basic",
  applicationCategory: "UtilityApplication",
  operatingSystem: "WebApplication",
  price: 5.00,
  priceCurrency: "EUR",
  billingFrequency: "P1M",
})

const softwareApplicationEcoPro = SchemaUtils.getSoftwareApplicationSchema({
  name: "Ecodrive Pro",
  applicationCategory: "UtilityApplication",
  operatingSystem: "WebApplication",
  price: 15.00,
  priceCurrency: "EUR",
  billingFrequency: "P1M",
})

const softwareApplicationEcoUltimate = SchemaUtils.getSoftwareApplicationSchema({
  name: "Ecodrive Premium",
  applicationCategory: "UtilityApplication",
  operatingSystem: "WebApplication",
  price: 250.00,
  priceCurrency: "EUR",
  billingFrequency: "P1M",
})

const {
  title = 'Waldheim.dev - Design, Beratung und Entwicklung',
  description = 'Lassen sie sich mit höchster Qualität für einzelne Projekte in der Entwicklung, Design und IT-Administration unterstützen.',
  image = '/placeholder-social.jpg',
  schema = [],
  keywords = 'Waldheim.dev, Design, Beratung, Entwicklung, IT-Service, IT-Administration, Webentwicklung, DevSecOps, Smart Home, Verbandssoftware, Augsburg, München, Bayern, Deutschland',
} = Astro.props;

schema.push(organisationSchema);
schema.push(softwareApplicationEcoFree);
schema.push(softwareApplicationEcoBasic);
schema.push(softwareApplicationEcoPro);
---
<style>
    main {
        padding: 0;
    }
</style>
<html lang="de" class="scroll-smooth">
<head>

  <!-- Base Layouts -->
  <meta charset="utf-8" />
  <base href="/" />
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicons/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">
  <link rel="manifest" href="/favicons/site.webmanifest">
  <link rel="mask-icon" href="/favicons/safari-pinned-tab.svg" color="#5bbad5">
  <link rel="shortcut icon" href="/favicons/favicon.ico">
  <meta name="msapplication-TileColor" content="#ffffff">
  <meta name="msapplication-config" content="/favicons/browserconfig.xml">
  <meta name="theme-color" content="#ffffff">


  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Global Metadata -->
  <meta name="generator" content={Astro.generator} />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="seobility" content="2a0e1520daef1d7919c04534790b25ab">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={new URL(image, Astro.url)} />

  {schema.map(schem => (
    <Schema
      item={schem}
    />
  ))}

  <!-- Import Tailwind JS -->
  <script type="module" src="/cookieconsent-config.js"></script>

  <!-- Google tag (gtag.js) -->
  <script data-category="analytics" async src="https://www.googletagmanager.com/gtag/js?id=G-F6PFMBR146"></script>
  <script
  type="text/plain"
  data-category="analytics">
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-F6PFMBR146');
  </script>
  <ClientRouter />
  </head>
  <body>
  <Header />
  <main class='bg-white dark:bg-slate-950 relative overflow-hidden'>
  <slot />

  </main>
  <Footer />
  </body>
  </html>
