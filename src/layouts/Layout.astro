---
import { Schema } from 'astro-seo-schema';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { SchemaUtils } from '../utils/schema';
import Banner from '../components/Banner.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  schema?: any[];
  robots?: string;
}

// Canonical URL ohne Query-Parameter & mit normalisiertem Trailing Slash
let canonicalPath = Astro.url.pathname;

// Trailing Slash hinzufügen (falls nicht vorhanden und keine Datei)
if (!canonicalPath.endsWith('/') && !canonicalPath.includes('.')) {
  canonicalPath += '/';
}

// Canonical ohne Query-Parameter (verhindert Duplikate durch ?utm_source etc.)
const canonicalURL = new URL(canonicalPath, Astro.site).href;

const organisationSchema = SchemaUtils.getOrganizationSchema({
  name: 'Waldheim.dev',
  url: Astro.url.href,
  logo: new URL('/waldheim.dev.svg', Astro.url).href,
  description: 'Waldheim.dev - Design, Beratung und Entwicklung in Augsburg & München.',
  email: 'kontakt@waldheim.dev',
  address: {
    addressLocality: 'Augsburg',
    addressRegion: 'Bayern',
    addressCountry: 'DE'
  }
});

const personSchema = SchemaUtils.getPersonSchema({
  name: 'Markus Waldheim',
  url: 'https://waldheim.dev',
  jobTitle: 'Software Architect & IT Consultant',
  description: 'Experte für DevSecOps, individuelle Softwareentwicklung und Cloud-Architekturen.',
  image: new URL('/markus/markus_waldheim.webp', Astro.url).href,
  sameAs: [
    'https://www.linkedin.com/in/markus-waldheim-03827a312/',
    'https://github.com/Waldheim-dev',
    'https://gitlab.com/mwaldheim'
  ]
});

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Waldheim.dev',
  image: new URL('/waldheim.dev.png', Astro.url).href,
  url: 'https://www.waldheim.dev',
  telephone: '',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Augsburg',
    addressRegion: 'Bayern',
    addressCountry: 'DE'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 48.3705,
    longitude: 10.8978
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00'
  }
};

const softwareApplicationEcoFree = SchemaUtils.getSoftwareApplicationSchema({
  name: 'Ecodrive Free',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'WebApplication',
  price: 0.0,
  priceCurrency: 'EUR',
  billingFrequency: 'P1M'
});

const softwareApplicationEcoBasic = SchemaUtils.getSoftwareApplicationSchema({
  name: 'Ecodrive Basic',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'WebApplication',
  price: 5.0,
  priceCurrency: 'EUR',
  billingFrequency: 'P1M'
});

const softwareApplicationEcoPro = SchemaUtils.getSoftwareApplicationSchema({
  name: 'Ecodrive Pro',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'WebApplication',
  price: 15.0,
  priceCurrency: 'EUR',
  billingFrequency: 'P1M'
});

const softwareApplicationEcoPremium = SchemaUtils.getSoftwareApplicationSchema({
  name: 'Ecodrive Premium',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'WebApplication',
  price: 250.0,
  priceCurrency: 'EUR',
  billingFrequency: 'P1M'
});

const {
  title = 'Waldheim.dev - Design, Beratung und Entwicklung',
  description = 'Lassen sie sich mit höchster Qualität für einzelne Projekte in der Entwicklung, Design und IT-Administration unterstützen.',
  image = '/placeholder-social.jpg',
  schema = [],
  keywords = 'Waldheim.dev, Design, Beratung, Entwicklung, IT-Service, IT-Administration, Webentwicklung, DevSecOps, Smart Home, Verbandssoftware, Augsburg, München, Bayern, Deutschland',
  robots = 'index, follow'
} = Astro.props;

schema.push(organisationSchema);
schema.push(personSchema);
schema.push(localBusinessSchema);
schema.push(softwareApplicationEcoFree);
schema.push(softwareApplicationEcoBasic);
schema.push(softwareApplicationEcoPro);
schema.push(softwareApplicationEcoPremium);
---

<!doctype html>
<html lang="de" class="scroll-smooth">
<head>
  <!-- Base Layouts -->
  <meta charset="utf-8" />
  <base href="/" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Favicons -->
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/favicons/apple-touch-icon.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="/favicons/favicon-32x32.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="192x192"
    href="/favicons/android-chrome-192x192.png"
  />
  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="/favicons/favicon-16x16.png"
  />
  <link rel="manifest" href="/favicons/site.webmanifest" />
  <link
    rel="mask-icon"
    href="/favicons/safari-pinned-tab.svg"
    color="#5bbad5"
  />
  <link rel="shortcut icon" href="/favicons/favicon.ico" />
  <meta name="msapplication-TileColor" content="#020617" />
  <meta
    name="msapplication-config"
    content="/favicons/browserconfig.xml"
  />
  <meta name="theme-color" content="#020617" />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="robots" content={robots} />

  <!-- Global Metadata -->
  <meta name="generator" content={Astro.generator} />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="de-DE" href={canonicalURL} />
  <link rel="alternate" hreflang="de-AT" href={canonicalURL} />
  <link rel="alternate" hreflang="de-CH" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />

  <!-- sherpa-blue Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="seobility" content="2a0e1520daef1d7919c04534790b25ab" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.url)} />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={Astro.url} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={new URL(image, Astro.url)} />

  {schema.map((schem) =>
    <Schema item={schem} />)}

  <script type="module" src="/cookieconsent-config.js" is:inline />
  <script src="https://cdn.jsdelivr.net/npm/vanilla-lazyload@19.1.3/dist/lazyload.min.js"></script>

  <script is:inline data-category="analytics" async
          src="https://www.googletagmanager.com/gtag/js?id=G-F6PFMBR146" />
  <script is:inline data-category="analytics">
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());

    gtag('config', 'G-F6PFMBR146');
  </script>

  <script data-category="analytics" is:inline>
    (function(c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function() {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', 'qlyjqk783c');
  </script>
  <!-- GSAP CDN (Fallback, falls nicht via pnpm installiert) -->
  <script defer src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/gsap.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollTrigger.min.js"></script>

  <script
  async
  src="https://cdn.jsdelivr.net/npm/vanilla-lazyload@19.1.3/dist/lazyload.min.js"
></script>
  <script is:inline>
  // Set the options globally
  // to make LazyLoad self-initialize
  window.lazyLoadOptions = {
    // Your custom settings go here
  };
  // Listen to the initialization event
  // and get the instance of LazyLoad
  window.addEventListener(
    "LazyLoad::Initialized",
    function (event) {
      window.lazyLoadInstance = event.detail.instance;
    },
    false
  );
</script>
<script is:inline>
  document.addEventListener('astro:page-load', async () => {
    if (!window.gsap) {
      console.warn('GSAP ist nicht geladen.');
      return;
    }
    if (!window.gsap.ScrollTrigger) {
      console.warn('GSAP ScrollTrigger ist nicht geladen.');
    } else {
      window.gsap.ScrollTrigger.getAll().forEach(trigger => trigger.kill());
    }

    // Verzögere die Initialisierung, damit alle Elemente im DOM sind
    requestAnimationFrame(() => {
      const fadeEls = window.gsap.utils.toArray('.gsap-fadein');
      if (fadeEls.length === 0) {
        console.warn('Keine .gsap-fadein Elemente gefunden.');
      }
      fadeEls.forEach(function(el, i) {
        window.gsap.from(el, {
          opacity: 0,
          y: 40,
          duration: 0.7,
          delay: 0.01 * i,
          ease: 'power1.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 90%',
            toggleActions: 'play none none none',
          }
        });
      });
      // Micro-Interaction für .gsap-wiggle (z.B. Icons)
      window.gsap.utils.toArray('.gsap-wiggle').forEach(function(el) {
        el.addEventListener('mouseenter', function() {
          window.gsap.to(el, { rotation: 10, yoyo: true, repeat: 1, duration: 0.15, ease: 'power1.inOut' });
        });
        el.addEventListener('mouseleave', function() {
          window.gsap.to(el, { rotation: 0, duration: 0.15, ease: 'power1.inOut' });
        });
      });
      // Button Hover-Scale
      window.gsap.utils.toArray('a.gsap-btn,button.gsap-btn').forEach(function(el) {
        el.addEventListener('mouseenter', function() {
          window.gsap.to(el, { scale: 1.07, duration: 0.18, ease: 'power1.out' });
        });
        el.addEventListener('mouseleave', function() {
          window.gsap.to(el, { scale: 1, duration: 0.18, ease: 'power1.in' });
        });
      });

      // Mouse Follower
      const cursorBlur = document.getElementById('cursor-blur');
      if (cursorBlur) {
        window.addEventListener('mousemove', (e) => {
          window.gsap.to(cursorBlur, {
            x: e.clientX,
            y: e.clientY,
            xPercent: -50,
            yPercent: -50,
            duration: 0.6,
            ease: 'power2.out'
          });
        });
      }
    });
  });
</script>

  <ClientRouter />
  <style is:global>
    #cursor-blur {
      position: fixed;
      top: 0;
      left: 0;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(14, 165, 233, 0.2) 0%, rgba(14, 165, 233, 0) 70%);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      filter: blur(80px);
      will-change: transform;
      mix-blend-mode: screen;
    }
  </style>
</head>
<body class="bg-meg-bg-dark text-meg-text-primary-dark flex-col gap-4 selection:bg-meg-accent selection:text-white antialiased transition-colors duration-300 ease-in-out">
<div id="cursor-blur"></div>
<header class="sticky top-0 z-50 max-w-7xl max-sm:w-full mx-auto py-2 px-2">
  <Nav />
</header>
<header class="max-w-7xl max-sm:w-full mx-auto py-2 px-2">
  <Banner />
</header>
<main class="min-h-[50vh]">
  <slot />
</main>
<footer>
  <Footer />
</footer>
</body>
</html>
