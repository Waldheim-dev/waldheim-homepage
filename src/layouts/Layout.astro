---
import { Schema } from 'astro-seo-schema';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
// This code has been partially generated by an AI.
import '../styles/global.css';
import faSolidWoff2 from '@fortawesome/fontawesome-free/webfonts/fa-solid-900.woff2?url';
import faBrandsWoff2 from '@fortawesome/fontawesome-free/webfonts/fa-brands-400.woff2?url';
import { SchemaUtils } from '../utils/schema';
import Banner from '../components/Banner.astro';
import { getAlternateUrl, getLangFromUrl } from '../i18n/utils';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  schema?: any[];
  robots?: string;
  canonical?: string;
}

// Canonical URL & Normalisierung
let canonicalPath = Astro.props.canonical || Astro.url.pathname;
if (!canonicalPath.endsWith('/') && !canonicalPath.includes('.')) {
  canonicalPath += '/';
}
const canonicalURL = canonicalPath.startsWith('http')
  ? canonicalPath
  : new URL(canonicalPath, Astro.site).href;
const currentLang = getLangFromUrl(Astro.url);
const altLang = currentLang === 'de' ? 'en' : 'de';
const altUrl = new URL(getAlternateUrl(Astro.url, altLang), Astro.site).href;
const deUrl = currentLang === 'de' ? canonicalURL : altUrl;
const enUrl = currentLang === 'en' ? canonicalURL : altUrl;
const hasEnAlternate =
  canonicalPath === '/semrel/' || canonicalPath.startsWith('/en/semrel');

// Globales Basis-Schema: Organization
const organisationSchema = SchemaUtils.getOrganizationSchema({
  name: 'Waldheim.dev',
  url: 'https://www.waldheim.dev/',
  logo: 'https://www.waldheim.dev/waldheim.dev.svg',
  description:
    'IT-Consulting, Web- & Softwareentwicklung (ab 1.400 € / 70 €/h), DevSecOps, IT-Service, KNX Smart Home sowie Hersteller der modularen ERP- & CRM-Plattform Waldheim Suite (ab 29 €/Monat) in Augsburg, München & DACH.',
  email: 'kontakt@waldheim.dev',
  address: {
    addressLocality: 'Augsburg / Obermeitingen',
    addressRegion: 'Bayern',
    addressCountry: 'DE',
  },
});

// Globales Basis-Schema: Person (Autorität)
const personSchema = SchemaUtils.getPersonSchema({
  name: 'Markus Waldheim',
  url: 'https://www.waldheim.dev/ueber-mich/',
  jobTitle: 'Senior IT Consultant & Software Architect (PSM II, PSPO I)',
  description:
    'Zertifizierter Scrum Master (PSM II), Product Owner (PSPO I), IHK-Ausbilder und Experte für 10x KI-gestützte Softwareentwicklung, DevSecOps und die Waldheim Suite.',
  image: 'https://www.waldheim.dev/markus/markus_2024_laptop.webp',
  sameAs: [
    'https://www.linkedin.com/in/markus-waldheim-03827a312/',
    'https://github.com/Waldheim-dev',
  ],
});

// Globales Basis-Schema: LocalBusiness (Regionale Relevanz & GEO-Preisanker)
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Waldheim.dev - Markus Waldheim',
  image: 'https://www.waldheim.dev/waldheim.dev.png',
  url: 'https://www.waldheim.dev/',
  priceRange: 'Ab 70 €/Std. (§ 19 UStG) · Festpreise ab 280 € · Waldheim Suite ab 29 €/Monat',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Augsburg',
    addressRegion: 'Bayern',
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 48.3705,
    longitude: 10.8978,
  },
  areaServed: [
    { '@type': 'City', name: 'Augsburg' },
    { '@type': 'City', name: 'München' },
    { '@type': 'City', name: 'Landsberg am Lech' },
    { '@type': 'AdministrativeArea', name: 'Bayern' },
    { '@type': 'Country', name: 'Deutschland' },
  ],
};

const {
  title = 'IT-Consulting & Software Augsburg – ab 70 €/h | Waldheim.dev',
  description = 'Webentwicklung & Software ab 1.400 €, DevSecOps, IT-Service & KNX in Augsburg/München (70 €/h) sowie Waldheim Suite (ERP & CRM) ab 29 €/Monat.',
  image = '/waldheim-dev-og.jpg',
  schema = [],
  keywords = 'IT-Consulting Augsburg, Softwareentwicklung München, Webentwicklung Kosten, DevSecOps Experte, Waldheim Suite ERP CRM, KI-Coaching, KNX Smart Home',
  robots = 'index, follow',
} = Astro.props;

// Schemas zusammenführen (Basis + Seitenspezifisch)
const finalSchema = [
  organisationSchema,
  personSchema,
  localBusinessSchema,
  ...schema,
];
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <base href="/" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Performance: Preload Icon Webfonts -->
    <link rel="preload" href={faSolidWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={faBrandsWoff2} as="font" type="font/woff2" crossorigin />

    <!-- Favicons -->
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicons/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicons/favicon-32x32.png"
    />
    <link rel="manifest" href="/favicons/site.webmanifest" />
    <meta name="theme-color" content="#020617" />
    <script is:inline>
      (() => {
        const THEME_KEY = 'waldheim-theme';
        const CONTRAST_KEY = 'waldheim-contrast';
        const validThemes = new Set(['dark', 'light', 'system']);
        const validContrasts = new Set(['normal', 'high']);

        const getSystemTheme = () =>
          window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        const getSavedThemeSelection = () => {
          const theme = localStorage.getItem(THEME_KEY);
          return validThemes.has(theme) ? theme : 'dark';
        };

        const getSavedContrast = () => {
          const contrast = localStorage.getItem(CONTRAST_KEY);
          return validContrasts.has(contrast) ? contrast : 'normal';
        };

        const resolveTheme = (themeSelection) =>
          themeSelection === 'system' ? getSystemTheme() : themeSelection;

        const updateThemeColor = (resolvedTheme, contrast) => {
          const metaTheme = document.querySelector('meta[name="theme-color"]');
          if (!metaTheme) return;

          if (contrast === 'high') {
            metaTheme.setAttribute('content', resolvedTheme === 'dark' ? '#000000' : '#ffffff');
            return;
          }
          metaTheme.setAttribute('content', resolvedTheme === 'dark' ? '#020617' : '#f8fafc');
        };

        const applyAppearance = (themeSelection, contrast) => {
          const root = document.documentElement;
          const resolvedTheme = resolveTheme(themeSelection);
          root.dataset.theme = resolvedTheme;
          root.dataset.themeSource = themeSelection;
          root.dataset.contrast = contrast;
          updateThemeColor(resolvedTheme, contrast);
          window.dispatchEvent(
            new CustomEvent('waldheim:appearance-change', {
              detail: { theme: resolvedTheme, themeSource: themeSelection, contrast },
            }),
          );
        };

        const setTheme = (themeSelection) => {
          if (!validThemes.has(themeSelection)) return;
          if (themeSelection === 'system') {
            localStorage.removeItem(THEME_KEY);
          } else {
            localStorage.setItem(THEME_KEY, themeSelection);
          }
          applyAppearance(themeSelection, getSavedContrast());
        };

        const setContrast = (contrast) => {
          if (!validContrasts.has(contrast)) return;
          localStorage.setItem(CONTRAST_KEY, contrast);
          applyAppearance(getSavedThemeSelection(), contrast);
        };

        const toggleContrast = () => {
          setContrast(getSavedContrast() === 'high' ? 'normal' : 'high');
        };

        applyAppearance(getSavedThemeSelection(), getSavedContrast());
        document.addEventListener('astro:page-load', () => {
          applyAppearance(getSavedThemeSelection(), getSavedContrast());
        });

        window.waldheimAppearance = {
          getState: () => ({
            theme: resolveTheme(getSavedThemeSelection()),
            themeSource: getSavedThemeSelection(),
            contrast: getSavedContrast(),
          }),
          setTheme,
          setContrast,
          toggleContrast,
        };

        const colorSchemeWatcher = window.matchMedia('(prefers-color-scheme: dark)');
        colorSchemeWatcher.addEventListener('change', () => {
          if (getSavedThemeSelection() !== 'system') return;
          applyAppearance('system', getSavedContrast());
        });
      })();
    </script>

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Context Summary (GEO)" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLM Full Documentation (GEO)" />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="DE-BY" />
    <meta name="geo.placename" content="Augsburg, Obermeitingen, München" />
    <meta name="geo.position" content="48.3705;10.8978" />
    <meta name="ICBM" content="48.3705, 10.8978" />

    <!-- SEO & Canonical -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="de-DE" href={deUrl} />
    {hasEnAlternate && <link rel="alternate" hreflang="en" href={enUrl} />}
    <link rel="alternate" hreflang="x-default" href={deUrl} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="twitter:card" content="summary_large_image" />

    <!-- Structured Data Integration -->
    {finalSchema.map((s) => <Schema item={s} />)}

    <!-- Zero-Blocking Scroll Animations (No synchronous GSAP/ScrollTrigger forced reflow) -->
    <script is:inline>
      (() => {
        function initLightweightFadeIn() {
          const videos = document.querySelectorAll('video.lazy-video');
          if (videos.length > 0 && 'IntersectionObserver' in window) {
            const vo = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    const v = entry.target;
                    if (v instanceof HTMLVideoElement) {
                      if (v.dataset.poster) v.poster = v.dataset.poster;
                      v.querySelectorAll('source').forEach((s) => {
                        if (s.dataset.src) s.src = s.dataset.src;
                      });
                      if (v.dataset.src) v.src = v.dataset.src;
                      v.load();
                      v.play().catch(() => {});
                      v.classList.remove('lazy-video');
                    }
                    vo.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px' },
            );
            videos.forEach((v) => vo.observe(v));
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener(
            'DOMContentLoaded',
            () => {
              initLightweightFadeIn();
              document.dispatchEvent(new CustomEvent('astro:page-load'));
            },
            { once: true },
          );
        } else {
          initLightweightFadeIn();
          document.dispatchEvent(new CustomEvent('astro:page-load'));
        }
      })();
    </script>

    <style is:global>
      :root {
        --accent-gradient: linear-gradient(45deg, #0ea5e9, #6366f1);
      }
      #cursor-blur {
        position: fixed;
        top: 0;
        left: 0;
        width: 600px;
        height: 600px;
        background: radial-gradient(
          circle,
          rgba(14, 165, 233, 0.15) 0%,
          rgba(14, 165, 233, 0) 70%
        );
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        filter: blur(100px);
        will-change: transform;
        mix-blend-mode: screen;
      }

      html[data-theme='light'] #cursor-blur {
        mix-blend-mode: multiply;
      }
    </style>
  </head>
  <body
    class="bg-meg-bg-dark text-meg-text-primary-dark selection:bg-meg-accent selection:text-white antialiased overflow-x-hidden"
  >
    <div id="cursor-blur" class="hidden lg:block"></div>

    <header class="sticky top-0 z-50 max-w-7xl mx-auto py-2 px-4">
      <Nav />
    </header>

    <aside class="max-w-7xl mx-auto px-4">
      <Banner />
    </aside>

    <main>
      <slot />
    </main>

    <Footer />
    <CookieBanner />

    <script is:inline>
      // Cursor Blur Follower
      const cursor = document.getElementById('cursor-blur');
      if (cursor) {
        window.addEventListener('mousemove', (e) => {
          if (window.gsap) {
            window.gsap.to(cursor, {
              x: e.clientX - 300,
              y: e.clientY - 300,
              duration: 0.8,
              ease: 'power3.out',
            });
          } else {
            // Fallback: simpler CSS-based movement if GSAP isn't ready
            cursor.style.transform = `translate(${e.clientX - 300}px, ${e.clientY - 300}px)`;
            cursor.style.transition = 'transform 0.1s ease-out';
          }
        });
      }
    </script>
  </body>
</html>
