---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
const { title, description, pubDate, heroImage, overview, assets, tags, general, frontend, backend } = Astro.props;



const projects = (await getCollection('project')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).filter((project) => project.slug !== Astro.params.slug);
---

<style>
    h1 {
        font-size: 3rem !important;
        line-height: 4rem !important;
        font-weight: bold !important;
    }

    h2 {
        font-size: 1.5rem !important;
        line-height: 2.5rem !important;
        font-weight: bold !important;
    }

    p {
        margin: 1rem 0 !important;
    }

    .w-1\/2 {
        flex: 1 2 calc(50% - 1rem) !important;
        max-width: 50%;
    }
</style>
<BaseHead title={title} description={description} />

<BaseLayout>
  <meta charset='utf-8' />
  <div class='bg-white  dark:bg-slate-800 px-6 py-6 lg:px-8'>
    <div class='mx-auto max-w-3xl text-base leading-7 text-gray-700 dark:text-gray-300'>
      {heroImage && <img width={720} height={360} src={heroImage} loading='lazy' alt=''
                         class='aspect-[7/4] w-full rounded-2xl object-cover' />}
      <h1 class='mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl dark:text-gray-50'>{title}</h1>

      <div class='relative mt-6'>
        <FormattedDate date={pubDate} />
        <br>
        {description}
      </div>
      <div class='relative mt-6 flex flex-wrap gap-2'>
        {overview.map((item) => (
          <div class='overflow-hidden flex-1 w-1/2 bg-white dark:bg-slate-900 shadow sm:rounded-lg'>
            <div class='px-4 py-5 sm:p-6 text-gray-800 dark:text-gray-300'>
              <strong set:html={item.title}></strong><br>
              {item.link ? (
                <a href={item.link}>{item.meta} <i class='fa-regular fa-arrow-up-right-from-square'></i></a>) : (
                <span set:html={item.meta}></span>)}
            </div>
          </div>
        ))}
      </div>
      <div class='relative mt-6'>
        <div class='absolute inset-0 flex items-center' aria-hidden='true'>
          <div class='w-full border-t border-gray-300'></div>
        </div>
      </div>
      <div class='relative pt-6 flex gap-1 items-center whitespace-nowrap flex-wrap'>
        {tags.map((item) => (
          <span
            class='inline-flex items-center rounded-md bg-purple-50 dark:bg-purple-400/10 px-2 py-1 text-xs font-medium text-purple-700 dark:text-purple-400 ring-1 ring-inset ring-purple-700/10 dark:ring-purple-400/30'>{item}</span>
        ))}
      </div>
      {general && general.length > 0 ?
        (
          <div class='relative mt-6'><h2>Allgemein</h2>
            <ul>
              {general.map((item) => (
                <li set:html={item}></li>
              ))}
            </ul>
          </div>) : null
      }
      {frontend && frontend.length > 0 ?
        (
          <div class='relative mt-6'><h2>Frontend</h2>
            <ul>
              {frontend.map((item) => (
                <li set:html={item}></li>
              ))}
            </ul>
          </div>) : null
      }
      {backend && backend.length > 0 ?
        (
          <div class='relative mt-6'><h2>Backend</h2>
            <ul>
              {backend.map((item) => (
                <li set:html={item}></li>
              ))}
            </ul>
          </div>) : null
      }

      {assets && assets.length > 0 ? (
        <div class='relative mt-6'><h2>Assets</h2>
          {assets.map((item) => (
            <img width={720} height={360} src={item} alt='' class='mt-6 aspect-[7/4] w-full rounded-2xl object-cover'
                 loading='lazy' />
          ))}
        </div>) : null}


      <div class='relative mt-6'>
        <div class='absolute inset-0 flex items-center' aria-hidden='true'>
          <div class='w-full border-t border-gray-300'></div>
        </div>
      </div>

    </div>
  </div>

  <div class='bg-white dark:bg-slate-800 py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl text-center'>
        <h1 class='text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl'>Projekte der
          Waldheim.dev</h1>
        <p class='mt-2 text-lg leading-8 text-gray-600 dark:text-gray-300'>Alle Projekte chronologisch.</p>
      </div>
      <div
        class='mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3'>


        {
          projects.map(async (project) => {

            return (
              <a href={`/projects/${project.slug}/`}>
                <article
                  class='relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 px-8 pb-8 pt-80 sm:pt-48 lg:pt-80'>
                  <img
                    src={project.data.heroImage} loading='lazy'
                    alt={project.data.title} class='absolute inset-0 -z-10 h-full w-full object-cover'>
                  <div class='absolute inset-0 -z-10 bg-gradient-to-t from-gray-900 via-gray-900/40'></div>
                  <div class='absolute inset-0 -z-10 rounded-2xl ring-1 ring-inset ring-gray-900/10'></div>

                  <div class='flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300'>
                    <FormattedDate date={project.data.pubDate} />
                  </div>
                  <h3 class='mt-3 text-lg font-semibold leading-6 text-white'>
                    <span class='absolute inset-0'></span>
                    {project.data.title}
                  </h3>
                  <p
                    class='flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300'>{project.data.shortDescription}</p>
                </article>
              </a>
            );
          })
          }
          </div>
          </div>
          </div>

          </BaseLayout>