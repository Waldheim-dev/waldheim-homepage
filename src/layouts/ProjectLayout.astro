---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import FlipCard from '../components/FlipCard.astro';

type Props = CollectionEntry<'project'>['data'];

const {
  title,
  description,
  pubDate,
  heroImage,
  client,
  tags,
  techStack,
  category,
  general,
  frontend,
  backend,
  design,
  problem,
  solution,
  assets,
  shortDescription,
  overview,
} = Astro.props;

const skills = await getCollection('skills');
---

<style>
  h1 {
    font-size: 3rem !important;
    line-height: 4rem !important;
    font-weight: bold !important;
  }

  h2 {
    font-size: 1.5rem !important;
    line-height: 2.5rem !important;
    font-weight: bold !important;
  }

  p {
    margin: 1rem 0 !important;
  }

  .w-1\/2 {
    flex: 1 2 calc(50% - 1rem) !important;
    max-width: 50%;
  }
</style>
<!-- Hero -->
<!-- The Problem -->
<!-- Description -->
<!-- Project and Client infos -->
<!-- Techstack & tags -->
<!-- Process -->
<!-- Solution -->
<!-- BE, FE, Generel, Design -->
<!-- Assets -->

<BaseLayout title={title} description={shortDescription ?? description} image={heroImage}>
  <meta charset="utf-8" />
  <div
    class="bg-white dark:bg-slate-800 text-gray-700 dark:text-gray-300 px-6 py-6 lg:px-8"
  >
    <div class="relative isolate pt-14">
      <div
        class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
        aria-hidden="true"
      >
        <div
          class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
          style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
        >
        </div>
      </div>
      <div class="py-24 sm:py-32 lg:pb-40">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-2xl text-center">
            <h1
              class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl"
            >
              {title}
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
              {shortDescription ? shortDescription : description}
            </p>
          </div>
          {
            heroImage ? (
              <div class="mt-16 flow-root sm:mt-24">
                <div class="-m-2 rounded-xl bg-gray-900/5 dark:bg-gray-50/5 p-2 ring-1 ring-inset ring-gray-900/10 dark:ring-gray-50/10 lg:-m-4 lg:rounded-2xl lg:p-4">
                  <img
                    src={heroImage}
                    alt={title}
                    loading="lazy"
                    width="2432"
                    height="1442"
                    class="rounded-md shadow-2xl ring-1 ring-gray-900/10 dark:ring-gray-50/10 aspect-[7/4] object-cover"
                  />
                </div>
              </div>
            ) : null
          }
        </div>
      </div>
      <div
        class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]"
        aria-hidden="true"
      >
        <div
          class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]"
          style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
        >
        </div>
      </div>
    </div>
  </div>

  {
    client && overview ? (
      <div class="bg-white dark:bg-slate-800 py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto grid max-w-2xl grid-cols-1 items-start gap-x-8 gap-y-16 sm:gap-y-24 lg:mx-0 lg:max-w-none lg:grid-cols-2">
            <div class="lg:pr-4">
              <div class="relative overflow-hidden rounded-3xl bg-gray-900 px-6 pb-9 pt-64 shadow-2xl sm:px-12 lg:max-w-lg lg:px-8 lg:pb-8 xl:px-10 xl:pb-10">
                <img
                  class="absolute inset-0 h-full w-full object-cover brightness-125 saturate-0"
                  src="https://images.unsplash.com/photo-1630569267625-157f8f9d1a7e?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=2669&q=80"
                  alt=""
                />
                <div class="absolute inset-0 bg-gray-900 mix-blend-multiply" />
                <div
                  class="absolute left-1/2 top-1/2 -ml-16 -translate-x-1/2 -translate-y-1/2 transform-gpu blur-3xl"
                  aria-hidden="true"
                >
                  <div
                    class="aspect-[1097/845] w-[68.5625rem] bg-gradient-to-tr from-[#ff4694] to-[#776fff] opacity-40"
                    style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
                  />
                </div>
                <figure class="relative isolate">
                  <h2 class="text-white">{client.name}</h2>
                  {client.web ? (
                    <a
                      href={client.web.url}
                      class="flex gap-1 text-white"
                      rel="nofollow"
                    >
                      {client.web.name}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                        />
                      </svg>
                    </a>
                  ) : null}
                </figure>
              </div>
              
            </div>
            <div>
              <div class="text-base leading-7 text-gray-700 dark:text-gray-300 lg:max-w-lg">
                <p class="text-base font-semibold leading-7 text-indigo-600 dark:text-indigo-400">
                  Firmenwerte
                </p>
                <div class="max-w-xl">
                  {client.shortDescription ? (
                    <p class="mt-6">{client.shortDescription}</p>
                  ) : null}
                  <p class="mt-6">{client.description}</p>
                </div>
              </div>
              <dl class="mt-10 flex flex-wrap gap-8 border-t border-gray-900/10 dark:border-gray-50/10 pt-10">
                {overview.map((item) => (
                  <div>
                    <dt class="text-sm font-semibold leading-6 text-gray-600 dark:text-gray-400">
                      {item.title}
                    </dt>
                    <dd class="mt-2 text-3xl font-bold leading-10 tracking-tight text-gray-900 dark:text-gray-50">
                      {item.meta}
                    </dd>
                  </div>
                ))}
              </dl>
              {client.web ? (
                <div class="mt-10 flex">
                  <a
                    href={client.web?.url}
                    class="text-base font-semibold leading-7 text-indigo-600 dark:text-indigo-400"
                    rel="nofollow"
                  >
                    Mehr über diese Firma <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              ) : null}
            </div>
          </div>
        </div>
      </div>
    ) : null
  }

  <!-- Problem -->
  {
    problem ? (
      <div class="relative isolate overflow-hidden bg-gray-900 dark:bg-gray-800">
        <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Das Problem
            </h2>
            <p
              class="mx-auto mt-6 text-lg leading-8 text-gray-300"
              set:text={problem}
            />
          </div>
        </div>
        <svg
          viewBox="0 0 1024 1024"
          class="absolute left-1/2 top-1/2 -z-10 h-[64rem] w-[64rem] -translate-x-1/2 [mask-image:radial-gradient(closest-side,white,transparent)]"
          aria-hidden="true"
        >
          <circle
            cx="512"
            cy="512"
            r="512"
            fill="url(#8d958450-c69f-4251-94bc-4e091a323369)"
            fill-opacity="0.7"
          />
          <defs>
            <radialGradient id="8d958450-c69f-4251-94bc-4e091a323369">
              <stop stop-color="#7775D6" />
              <stop offset="1" stop-color="#E935C1" />
            </radialGradient>
          </defs>
        </svg>
      </div>
    ) : null
  }

  {
    techStack && techStack.length > 0 ? (
      <div class="bg-white dark:bg-slate-800 py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <h2 class="text-center text-lg font-semibold leading-8 text-gray-900 dark:text-white">
            Mit welchem Tech-Stack habe ich gearbeitet?
          </h2>
          <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="-mx-6 grid grid-cols-2 gap-2 overflow-hidden sm:mx-0 md:grid-cols-6">
              {techStack.map((item) => {
                return (
                  <FlipCard
                    entry={skills.find((skill) => skill.id === item.id)}
                  />
                );
              })}
            </div>
          </div>
        </div>
      </div>
    ) : null
  }

  <!-- Solution -->

  {
    solution ? (
      <div class="bg-indigo-700 dark:bg-indigo-800">
        <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8">
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
              Unsere Lösung
            </h2>
            <p
              class="mx-auto mt-6 text-lg leading-8 text-indigo-200"
              set:text={solution}
            />
          </div>
        </div>
      </div>
    ) : null
  }

  <div class="bg-white dark:bg-slate-800 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div
        class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-3"
      >
        <h2
          class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl"
        >
          Auf was habe ich geachtet?
        </h2>
        <dl class="col-span-2 grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2">
          {
            design && design.length > 0 ? (
              <div>
                <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-50">
                  <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600">
                    <svg
                      class="h-6 w-6 text-white"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-6 h-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008Z"
                      />
                    </svg>
                  </div>
                  Design
                </dt>
                <dd class="mt-1 text-base leading-7 text-gray-600 dark:text-gray-400">
                  <ul class="list-disc ml-5">
                    {design.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                </dd>
              </div>
            ) : null
          }
          {
            frontend && frontend.length > 0 ? (
              <div>
                <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-50">
                  <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600">
                    <svg
                      class="h-6 w-6 text-white"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-6 h-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
                      />
                    </svg>
                  </div>
                  Frontend
                </dt>
                <dd class="mt-1 text-base leading-7 text-gray-600 dark:text-gray-400">
                  <ul class="list-disc ml-5">
                    {frontend.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                </dd>
              </div>
            ) : null
          }
          {
            backend && backend.length > 0 ? (
              <div>
                <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-50">
                  <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600">
                    <svg
                      class="h-6 w-6 text-white"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-6 h-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M5.25 14.25h13.5m-13.5 0a3 3 0 0 1-3-3m3 3a3 3 0 1 0 0 6h13.5a3 3 0 1 0 0-6m-16.5-3a3 3 0 0 1 3-3h13.5a3 3 0 0 1 3 3m-19.5 0a4.5 4.5 0 0 1 .9-2.7L5.737 5.1a3.375 3.375 0 0 1 2.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 0 1 .9 2.7m0 0a3 3 0 0 1-3 3m0 3h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Zm-3 6h.008v.008h-.008v-.008Zm0-6h.008v.008h-.008v-.008Z"
                      />
                    </svg>
                  </div>
                  Backend
                </dt>
                <dd class="mt-1 text-base leading-7 text-gray-600 dark:text-gray-400">
                  <ul class="list-disc ml-5">
                    {backend.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                </dd>
              </div>
            ) : null
          }
          {
            general && general.length > 0 ? (
              <div>
                <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-50">
                  <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-600">
                    <svg
                      class="h-6 w-6 text-white"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-6 h-6"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="m21 7.5-2.25-1.313M21 7.5v2.25m0-2.25-2.25 1.313M3 7.5l2.25-1.313M3 7.5l2.25 1.313M3 7.5v2.25m9 3 2.25-1.313M12 12.75l-2.25-1.313M12 12.75V15m0 6.75 2.25-1.313M12 21.75V19.5m0 2.25-2.25-1.313m0-16.875L12 2.25l2.25 1.313M21 14.25v2.25l-2.25 1.313m-13.5 0L3 16.5v-2.25"
                      />
                    </svg>
                  </div>
                  Allgemein
                </dt>
                <dd class="mt-1 text-base leading-7 text-gray-600 dark:text-gray-400">
                  <ul class="list-disc ml-5">
                    {general.map((item) => (
                      <li set:html={item} />
                    ))}
                  </ul>
                </dd>
              </div>
            ) : null
          }
        </dl>
      </div>
    </div>
  </div>

  {
    assets && assets.length > 0 ? (
      <div class="bg-white dark:bg-slate-800  py-6 sm:py-8 lg:py-12">
        <div class="mx-auto max-w-screen-2xl px-4 md:px-8">
          <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
            <div class="flex items-center gap-12">
              <h2 class="text-2xl font-bold text-gray-800 lg:text-3xl dark:text-white">
                Assets
              </h2>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
            {assets.map((image) => {
              const small =
                'group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md:h-80';
              const large =
                'group relative flex h-48 items-end overflow-hidden rounded-lg bg-gray-100 shadow-lg md:col-span-2 md:h-80';
              return (
                <span
                  class={
                    assets.indexOf(image) % 2 === 0 ||
                    assets.indexOf(image) % 3 === 0
                      ? small
                      : large
                  }
                >
                  <img
                    src={image}
                    loading="lazy"
                    alt=""
                    data-trigger="image"
                    class="absolute cursor-pointer inset-0 h-full w-full object-cover object-center transition duration-200 group-hover:scale-110"
                  />
                </span>
              );
            })}
          </div>
        </div>
      </div>

      <div class="fixed transition-all cursor-pointer hidden inset-0 bg-slate-900/10 backdrop-blur-sm p-20" data-trigger="modal" aria-hidden="true">
        <div class="relative h-full w-full rounded-lg overflow-hidden">
          <img src="" alt="" class="h-full w-full object-contain drop-shadow-lg" />
          
          <button class="absolute right-0 top-0 bg-white rounded-bl-md p-4" data-trigger="close">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      <script is:inline>
        const images = document.querySelectorAll('[data-trigger="image"]');
        const close = document.querySelector('[data-trigger="close"]');
        const modal = document.querySelector('[data-trigger="modal"]');

        const load = (image) => {
          modal.classList.remove('hidden');
          modal.querySelector('img').src = image.src;
        }

        const closeEvent = () => {
          modal.classList.add('hidden');
          modal.querySelector('img').src = '';
        }

        images.forEach((image) => {
          image.addEventListener('click', () => load(image));
        });

        close.addEventListener('click', closeEvent);

        modal.addEventListener('click', closeEvent);
      </script>
    ) : null
  }

  {
    tags && tags.length > 0 ? (
      <div class="bg-indigo-100 dark:bg-indigo-700">
        
        <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:flex-col lg:items-center lg:justify-between lg:px-8">
        <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
            <div class="flex items-center gap-12">
              <h2 class="text-2xl font-bold text-gray-800 lg:text-3xl dark:text-white">
                Tags
              </h2>
            </div>
          </div>
          <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 lg:mt-0">
            {tags.map((item) => (
              <span class="inline-flex items-center rounded-md bg-gray-50 dark:bg-gray-50/75 px-2 py-1 text-xs font-medium text-indigo-700 dark:text-indigo-800 ring-1 ring-inset ring-indigo-700/10 dark:ring-indigo-400/30">
                {item}
              </span>
            ))}
          </div>
        </div>
      </div>
    ) : null
  }
</BaseLayout>
