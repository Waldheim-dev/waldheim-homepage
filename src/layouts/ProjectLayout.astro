---
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import SkillFlipCard from '../components/SkillFlipCard.astro';
import HeroBackground from '../components/HeroBackground.astro';
import PriceService from '../components/PriceService.astro';
import RelatedServices from '../components/RelatedServices.astro';
import PromoSuite from '../components/PromoSuite.astro';



const {
  title,
  description,
  heroImage,
  client,
  tags,
  techStack,
  general,
  frontend,
  backend,
  design,
  devops,
  features,
  products,
  security,
  testing,
  problem,
  solution,
  assets,
  shortDescription,
  overview,
  year,
  eventSeries,
  previousYear,
  nextYear,
  results,
  category
} = Astro.props;

const skills = await getCollection('skills');
const resolvedTechStack = techStack ? await Promise.all(
  techStack.map(async (id) => {
    const skillId = typeof id === 'string' ? id : id.id;
    return skills.find((s) => s.id.replace(/^_/, '') === skillId.replace(/^_/, ''));
  })
) : [];

// Lade Vorjahres- und Folgejahresprojekt, falls vorhanden
let previousYearProject = null;
let nextYearProject = null;

if (previousYear) {
  const allProjects = await getCollection('projects');
  previousYearProject = allProjects.find(p => p.id.replace(/^_/, '').replace(/\/_/, '/') === previousYear);
}

if (nextYear) {
  const allProjects = await getCollection('projects');
  nextYearProject = allProjects.find(p => p.id.replace(/^_/, '').replace(/\/_/, '/') === nextYear);
}
---

<style>
    h1 {
        font-size: 3rem !important;
        line-height: 4rem !important;
        font-weight: 900 !important;
        letter-spacing: -0.05em !important;
    }

    h2 {
        font-size: 1.5rem !important;
        line-height: 2.5rem !important;
        font-weight: 900 !important;
        letter-spacing: -0.025em !important;
    }

    p {
        margin: 1rem 0 !important;
    }

</style>

<!-- Hero -->
<!-- The Problem -->
<!-- Description -->
<!-- Project and Client infos -->
<!-- Techstack & tags -->
<!-- Process -->
<!-- Solution -->
<!-- BE, FE, Generel, Design -->
<!-- Assets -->



<HeroBackground title={title} subtitle={description} image={heroImage} class="">
  {results && results.length > 0 && (
    <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto">
      {results.map((res, i) => (
        <div class="gsap-fadein bg-meg-surface-dark/80 backdrop-blur-xl border border-meg-accent/30 rounded-2xl p-6 shadow-lg transform hover:scale-105 transition-transform" style={`animation-delay: ${0.5 + i * 0.1}s`}>
          <div class="text-3xl font-black text-meg-accent mb-1">{res.value}</div>
          <div class="text-[10px] uppercase tracking-widest font-bold text-slate-400 leading-tight">{res.label}</div>
        </div>
      ))}
    </div>
  )}
</HeroBackground>

  <!-- Jahres-Navigation für Event-Serien -->
  {
    (eventSeries && year && (previousYearProject || nextYearProject)) ? (
      <div class="py-8 border-b border-meg-border-dark gsap-fadein bg-meg-bg-dark">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 shadow-sm">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                {previousYearProject ? (
                  <a 
                    href={`/referenzen/${previousYear}/`} 
                    class="group inline-flex items-center gap-3 text-slate-400 hover:text-meg-accent transition-all"
                    aria-label={`Vorjahresprojekt: ${previousYearProject.data.title}`}
                  >
                    <div class="flex items-center justify-center size-10 rounded-full bg-meg-surface-dark border border-meg-border-dark group-hover:border-meg-accent/50 group-hover:bg-meg-accent/10 transition-all">
                      <i class="fa-solid fa-arrow-left text-meg-accent" aria-hidden="true"></i>
                    </div>
                    <div class="text-left">
                      <div class="text-[10px] uppercase tracking-wider opacity-60">Vorheriges Jahr</div>
                      <div class="font-semibold text-meg-text-primary-dark">{previousYearProject.data.year || previousYearProject.data.title}</div>
                    </div>
                  </a>
                ) : (
                  <div class="opacity-30 flex items-center gap-3">
                    <div class="size-10 rounded-full border border-meg-border-dark flex items-center justify-center">
                      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    </div>
                    <div class="text-xs uppercase tracking-wider">Erstes Jahr</div>
                  </div>
                )}
              </div>
              
              <div class="flex-shrink-0 text-center px-6 border-x border-meg-border-dark">
                <div class="flex items-center gap-3">
                  <div class="p-2 rounded-lg bg-meg-accent/10 text-meg-accent">
                    <i class="fa-solid fa-calendar-days text-xl" aria-hidden="true"></i>
                  </div>
                  <div>
                    <div class="text-[10px] text-slate-400 uppercase tracking-widest font-bold">Event-Serie</div>
                    <div class="text-2xl font-black text-meg-text-primary-dark tracking-tighter">{year}</div>
                  </div>
                </div>
              </div>
              
              <div class="flex-1 text-right">
                {nextYearProject ? (
                  <a 
                    href={`/referenzen/${nextYear}/`} 
                    class="group inline-flex items-center gap-3 text-slate-400 hover:text-meg-accent transition-all flex-row-reverse"
                    aria-label={`Folgejahresprojekt: ${nextYearProject.data.title}`}
                  >
                    <div class="flex items-center justify-center size-10 rounded-full bg-meg-surface-dark border border-meg-border-dark group-hover:border-meg-accent/50 group-hover:bg-meg-accent/10 transition-all">
                      <i class="fa-solid fa-arrow-right text-meg-accent" aria-hidden="true"></i>
                    </div>
                    <div class="text-right">
                      <div class="text-[10px] uppercase tracking-wider opacity-60">Nächstes Jahr</div>
                      <div class="font-semibold text-meg-text-primary-dark">{nextYearProject.data.year || nextYearProject.data.title}</div>
                    </div>
                  </a>
                ) : (
                  <div class="opacity-30 flex items-center gap-3 flex-row-reverse">
                    <div class="size-10 rounded-full border border-meg-border-dark flex items-center justify-center">
                      <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </div>
                    <div class="text-xs uppercase tracking-wider text-right">Aktuellstes</div>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    ) : null
  }

    {
    client && overview ? (
    <div class="py-24 sm:py-32 bg-meg-bg-dark">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div
          class="mx-auto grid max-w-2xl grid-cols-1 items-start gap-x-8 gap-y-16 sm:gap-y-24 lg:mx-0 lg:max-w-none lg:grid-cols-2">
          <div class="lg:pr-4">
            <div class="relative group overflow-hidden rounded-2xl bg-meg-surface-dark/50 border border-meg-border-dark hover:border-meg-accent/30 transition-all duration-300 shadow-sm">
              <div
                class="absolute -inset-2 bg-gradient-to-r from-meg-accent/10 via-sky-400/10 to-violet-500/10 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
              <div
                class="relative overflow-hidden rounded-2xl px-6 pb-9 pt-64 shadow-2xl sm:px-12 lg:px-8 lg:pb-8 xl:px-10 xl:pb-10">
                <img fetchpriority="high"
                  class="absolute inset-0 h-full w-full object-cover brightness-50 saturate-50 group-hover:scale-105 transition-transform duration-700"
                  src="https://images.unsplash.com/photo-1630569267625-157f8f9d1a7e?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=2669&q=80"
                  alt={client.name}
                />
                <div class="absolute inset-0 bg-gradient-to-br from-meg-surface-dark/80 via-meg-surface-dark/90 to-meg-bg-dark/95" />
                <figure class="relative isolate">
                  <h2 class="text-meg-text-primary-dark text-3xl font-bold tracking-tight">{client.name}</h2>
                  {client.web ? (
                    <a
                      href={client.web.url}
                      class="flex items-center gap-2 text-meg-accent hover:text-sky-400 transition-colors mt-2 font-medium"
                      rel="nofollow"
                    >
                      {client.web.name}
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="size-4"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                        />
                      </svg>
                    </a>
                  ) : null}
                </figure>
              </div>
            </div>
  
          </div>
          <div class="gsap-fadein">
            <div class="text-base leading-7 text-meg-text-primary-dark lg:max-w-lg">
              <p class="text-sm font-bold uppercase tracking-widest text-meg-accent">
                Klient & Firmenwerte
              </p>
              <div class="max-w-xl">
                {client.shortDescription ? (
                  <p class="mt-6 text-lg text-slate-400 leading-relaxed">{client.shortDescription}</p>
                ) : null}
                <p class="mt-6 text-slate-400 leading-relaxed">{client.description}</p>
              </div>
            </div>
            <dl class="mt-10 flex flex-wrap gap-8 border-t border-meg-border-dark pt-10">
              {overview.map((item) => (
                <div class="bg-meg-surface-dark/30 rounded-xl p-4 border border-meg-border-dark shadow-sm">
                  <dt class="text-xs font-bold uppercase tracking-wider text-slate-400 opacity-70">
                    {item.title}
                  </dt>
                  <dd class="mt-1 text-2xl font-black tracking-tight text-meg-accent">
                    {item.meta}
                  </dd>
                </div>
              ))}
            </dl>
            {client.web ? (
              <div class="mt-10 flex">
                <a
                  href={client.web?.url}
                  class="inline-flex items-center gap-2 text-base font-semibold leading-7 text-meg-text-primary-dark hover:text-meg-accent transition-colors group"
                  rel="nofollow"
                >
                  Mehr über diese Firma 
                  <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            ) : null}
          </div>
        </div>
      </div>
    </div>
    ) : null
    }
    <!-- Problem -->
  {
  problem ? (
  <div class="relative isolate overflow-hidden bg-meg-surface-dark/30 border-y border-meg-border-dark gsap-fadein">
    <div class="absolute inset-0 bg-gradient-to-r from-meg-accent/5 via-sky-400/5 to-meg-accent/5 opacity-50"></div>
    <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8 relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-500 text-[10px] font-black uppercase tracking-widest mb-6">
          <i class="fa-solid fa-triangle-exclamation"></i> Die Herausforderung
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-meg-text-primary-dark sm:text-4xl">
          Das Problem
        </h2>
        <p
          class="mx-auto mt-6 text-xl leading-8 text-slate-400 max-w-2xl italic border-l-4 border-rose-500/30 pl-6 text-left"
          set:text={problem}
        />
      </div>
    </div>
  </div>
    ) : null
  }

{
  techStack && techStack.length > 0 ? (
  <div class="py-24 sm:py-32 gsap-fadein bg-meg-bg-dark">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          Tech Stack
        </h2>
        <p class="text-3xl font-bold text-meg-text-primary-dark tracking-tight">
          Eingesetzte Technologien & Werkzeuge
        </p>
      </div>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
          {resolvedTechStack.map((skill) => (
            skill ? <SkillFlipCard entry={skill} /> : null
          ))}
        </div>
      </div>
    </div>
  </div>
    ) : null
  }

<!-- Solution -->

{
  solution ? (
  <div class="relative isolate overflow-hidden bg-meg-surface-dark/30 border-y border-meg-border-dark gsap-fadein">
    <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/5 via-meg-accent/5 to-sky-400/5 opacity-50"></div>
    <div class="px-6 py-24 sm:px-6 sm:py-32 lg:px-8 relative">
      <div class="mx-auto max-w-3xl text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 text-[10px] font-black uppercase tracking-widest mb-6">
          <i class="fa-solid fa-lightbulb"></i> Die Strategie
        </div>
        <h2 class="text-3xl font-bold tracking-tight text-meg-text-primary-dark sm:text-4xl">
          Unsere Lösung
        </h2>
        <p
          class="mx-auto mt-6 text-lg leading-8 text-slate-400 max-w-2xl"
          set:text={solution}
        />
      </div>
    </div>
  </div>
    ) : null
  }

<div class="py-24 sm:py-32 bg-meg-bg-dark">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div
      class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-3"
    >
      <div>
        <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          Fokus & Details
        </h2>
        <p class="text-3xl font-bold tracking-tight text-meg-text-primary-dark sm:text-4xl gsap-fadein">
          Worauf kam es an?
        </p>
      </div>
      <dl class="col-span-2 grid grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2">
        {
          design && design.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-rose-500/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-rose-500/10 text-rose-500 border border-rose-500/20">
                  <i class="fa-solid fa-palette" aria-hidden="true"></i>
                </div>
                Design & UX
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {design.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-rose-500 mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
        {
          frontend && frontend.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-sky-500/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-sky-500/10 text-sky-500 border border-sky-500/20">
                  <i class="fa-solid fa-code" aria-hidden="true"></i>
                </div>
                Frontend
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {frontend.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-sky-500 mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
        {
          backend && backend.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-meg-accent/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-meg-accent/10 text-meg-accent border border-meg-accent/20">
                  <i class="fa-solid fa-server" aria-hidden="true"></i>
                </div>
                Backend
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {backend.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-meg-accent mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
        {
          general && general.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-emerald-500/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                  <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                </div>
                Allgemein
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {general.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-emerald-500 mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
        {
          devops && devops.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-violet-500/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-500/10 text-violet-500 border border-violet-500/20">
                  <i class="fa-solid fa-infinity" aria-hidden="true"></i>
                </div>
                DevOps
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {devops.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-violet-500 mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
        {
          features && features.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-amber-500/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/10 text-amber-500 border border-amber-500/20">
                  <i class="fa-solid fa-star" aria-hidden="true"></i>
                </div>
                Key Features
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {features.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-amber-500 mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
        {
          security && security.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-emerald-500/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                  <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                </div>
                Security
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {security.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-emerald-500 mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
        {
          testing && testing.length > 0 ? (
            <div class="gsap-fadein bg-meg-surface-dark/50 p-8 rounded-2xl border border-meg-border-dark shadow-sm hover:border-indigo-500/30 transition-all duration-300">
              <dt class="text-lg font-bold leading-7 text-meg-text-primary-dark flex items-center gap-3">
                <div
                  class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-500/10 text-indigo-500 border border-indigo-500/20">
                  <i class="fa-solid fa-vial" aria-hidden="true"></i>
                </div>
                Qualitätssicherung
              </dt>
              <dd class="mt-4 text-base leading-7 text-slate-400">
                <ul class="space-y-3">
                  {testing.map((item) => (
                    <li class="flex gap-2">
                      <span class="text-indigo-500 mt-1.5 size-1.5 rounded-full bg-current shrink-0"></span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ) : null
        }
      </dl>
    </div>
  </div>
</div>
<div class=' px-6 py-6 lg:px-8 bg-meg-bg-dark'>
  <div class='mx-auto max-w-3xl text-base leading-7 text-meg-text-primary-dark'>
    <div class="mt-16 prose prose-invert prose-meg w-full max-w-none">
      <slot />
    </div>
  </div>
</div>

{
  assets && assets.length > 0 ? (
  <div class="py-24 sm:py-32 bg-meg-bg-dark">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-12">
        <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          Galerie
        </h2>
        <p class="text-3xl font-bold tracking-tight text-meg-text-primary-dark sm:text-4xl">
          Visuelle Eindrücke
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
        {assets.map((image) => {
          const small =
            'group relative flex h-48 items-end overflow-hidden rounded-2xl bg-meg-surface-dark border border-meg-border-dark shadow-sm md:h-80';
          const large =
            'group relative flex h-48 items-end overflow-hidden rounded-2xl bg-meg-surface-dark border border-meg-border-dark shadow-sm md:col-span-2 md:h-80';
          return (
            <span
              class={
                assets.indexOf(image) % 2 === 0 ||
                assets.indexOf(image) % 3 === 0
                  ? small
                  : large
              }
            >
                  <img
                    src={image}
                    loading="lazy"
                    alt="Projekt Asset"
                    data-trigger="image"
                    class="absolute cursor-pointer inset-0 h-full w-full object-cover object-center transition duration-500 group-hover:scale-110"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-meg-bg-dark/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
                </span>
          );
        })}
      </div>
    </div>
  </div>

  <div class="fixed transition-all cursor-pointer hidden inset-0 bg-meg-bg-dark/95 backdrop-blur-xl z-[100] p-4 sm:p-20"
       data-trigger="modal" aria-hidden="true">
    <div class="relative h-full w-full rounded-2xl overflow-hidden border border-meg-border-dark shadow-2xl">
      <img src="" alt="Vollbild Ansicht" loading="lazy" class="h-full w-full object-contain"
           data-trigger="image-placeholder" />

      <button class="absolute right-4 top-4 bg-meg-surface-dark/80 backdrop-blur-md hover:bg-meg-accent text-white cursor-pointer rounded-xl p-3 transition-all border border-meg-border-dark" data-trigger="close" aria-label="Bild schließen">
        <i class="fa-solid fa-xmark text-xl"></i>
      </button>

      <button class="absolute left-4 bottom-4 bg-meg-surface-dark/80 backdrop-blur-md hover:bg-meg-accent text-white cursor-pointer rounded-xl p-3 transition-all border border-meg-border-dark" data-trigger="previmage" aria-label="Vorheriges Bild">
        <i class="fa-solid fa-chevron-left text-xl"></i>
      </button>

      <button class="absolute right-4 bottom-4 bg-meg-surface-dark/80 backdrop-blur-md hover:bg-meg-accent text-white cursor-pointer rounded-xl p-3 transition-all border border-meg-border-dark" data-trigger="nextimage" aria-label="Nächstes Bild">
        <i class="fa-solid fa-chevron-right text-xl"></i>
      </button>
    </div>
  </div>
    ) : null
  }

{
  tags && tags.length > 0 ? (
    <div class='relative bg-meg-surface-dark/30 border-y border-meg-border-dark text-meg-text-primary-dark'>
    <div class='absolute inset-0 bg-gradient-to-r from-meg-accent/5 via-sky-400/5 to-violet-500/5 opacity-50'></div>
    <div class='relative mx-auto max-w-7xl px-6 py-24 sm:py-32 flex flex-col items-center justify-between lg:px-8'>
  <div class='mb-8 text-center'>
    <h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-2'>
      Kategorisierung
    </h2>
    <p class='text-2xl font-bold lg:text-3xl'>Projekt Tags</p>
  </div>
  <div class="mt-4 flex flex-wrap items-center justify-center gap-3 max-w-2xl">
  {tags.map((item) => (
  <span class='inline-flex items-center rounded-full bg-meg-surface-dark border border-meg-border-dark px-4 py-1.5 text-xs font-semibold text-slate-400 hover:border-meg-accent/50 hover:text-meg-accent transition-all cursor-default shadow-sm'>
    <span class="size-1.5 rounded-full bg-meg-accent/40 mr-2"></span>
    {item}
  </span>
  ))}
  </div>
  </div>
  </div>
  ) : null
  }

  <PriceService />
  
  <div class="bg-meg-bg-dark">
    <RelatedServices exclude={category?.id} />
  </div>

  <PromoSuite />

  <!-- Final CTA -->
  <section class="py-24 px-6 bg-meg-bg-dark text-center border-t border-meg-border-dark">
    <div class="mx-auto max-w-3xl gsap-fadein">
      <h2 class="text-3xl md:text-5xl font-black text-meg-text-primary-dark mb-8">
        Bereit für Ihre eigene <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Erfolgsgeschichte?</span>
      </h2>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="https://calendly.com/markus-waldheim/30min" target="_blank" class="px-8 py-4 bg-meg-accent text-white font-bold rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all">
          Beratungsgespräch buchen
        </a>
        <a href="/kontakt/" class="px-8 py-4 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold rounded-xl hover:bg-meg-surface-dark/80 transition-all">
          Projekt anfragen
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    const images = document.querySelectorAll('[data-trigger="image"]');
    const close = document.querySelector('[data-trigger="close"]');
    const modal = document.querySelector('[data-trigger="modal"]');
    const next = document.querySelector('[data-trigger="nextimage"]');
    const prev = document.querySelector('[data-trigger="previmage"]');
    const placeholder = document.querySelector('[data-trigger="image-placeholder"]');

    const load = (image) => {
      modal.classList.remove('hidden');
      modal.querySelector('img').src = image.src;
    };

    const closeEvent = (event) => {
      if (event.target === close || event.target === modal || event.target === placeholder) {
        modal.classList.add('hidden');
        modal.querySelector('img').src = '';
      }
    };

    const nextEvent = () => {
      const current = images[Array.from(images).findIndex((image) => image.src === modal.querySelector('img').src)];
      const next = images[Array.from(images).indexOf(current) + 1] ?? images[0];
      if (next) {
        load(next);
      }
    };

    const prevEvent = () => {
      const current = images[Array.from(images).findIndex((image) => image.src === modal.querySelector('img').src)];
      const prev = images[Array.from(images).indexOf(current) - 1] ?? images[images.length - 1];
      if (prev) {
        load(prev);
      }
    };

    images.forEach((image) => {
      image.addEventListener('click', () => load(image));
    });

    close.addEventListener('click', (event) => {
      closeEvent(event);
    });

    modal.addEventListener('click', (event) => {
      closeEvent(event);
    });

    next.addEventListener('click', () => {
      nextEvent();
    });

    prev.addEventListener('click', () => {
      prevEvent();
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        modal.classList.add('hidden');
        modal.querySelector('img').src = '';
      }
      if (event.key === 'ArrowRight') {
        nextEvent();
      }
      if (event.key === 'ArrowLeft') {
        prevEvent();
      }
    });
  </script>
