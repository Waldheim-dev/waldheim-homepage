---
const features = [
  {
    icon: 'fa-brain',
    title: 'AI-gestützte Lead-Qualifizierung',
    description: 'Unsere KI analysiert Leads in Echtzeit und priorisiert automatisch nach Conversion-Wahrscheinlichkeit.',
    status: 'available',
    color: 'purple'
  },
  {
    icon: 'fa-robot',
    title: 'Automatisierte Kampagnen',
    description: 'Erstellen Sie einmal, optimieren lassen. Die KI passt Kampagnen kontinuierlich an Performance-Daten an.',
    status: 'available',
    color: 'purple'
  },
  {
    icon: 'fa-shield-check',
    title: 'DSGVO-konform by Design',
    description: 'Made in Germany. Alle Daten werden auf deutschen Servern gespeichert und DSGVO-konform verarbeitet.',
    status: 'available',
    color: 'green'
  },
  {
    icon: 'fa-chart-network',
    title: 'Multi-Channel Integration',
    description: 'Facebook, Instagram, LinkedIn, Twitter/X – alle Kanäle zentral verwalten und automatisieren.',
    status: 'available',
    color: 'blue'
  },
  {
    icon: 'fa-sparkles',
    title: 'Content-Generierung mit GPT-4',
    description: 'Lassen Sie die KI E-Mails, Social Posts und Landingpage-Texte schreiben – perfekt auf Ihre Zielgruppe zugeschnitten.',
    status: 'beta',
    color: 'purple'
  },
  {
    icon: 'fa-chart-line',
    title: 'Predictive Analytics',
    description: 'Vorhersagen über Kampagnen-Performance, Churn-Risiko und optimale Kontaktzeiten.',
    status: 'planned',
    color: 'orange'
  },
  {
    icon: 'fa-code-branch',
    title: 'API & Integrationen',
    description: 'Zapier, Make, REST-API – verbinden Sie Socialverse mit Ihren bestehenden Tools.',
    status: 'planned',
    color: 'orange'
  },
  {
    icon: 'fa-users',
    title: 'Team-Collaboration',
    description: 'Gemeinsam an Kampagnen arbeiten, Aufgaben zuweisen und Performance tracken.',
    status: 'planned',
    color: 'orange'
  }
];

const useCases = [
  {
    title: 'B2B Lead-Generierung',
    description: 'Generieren und qualifizieren Sie B2B-Leads mit LinkedIn-Integration und AI-Scoring.',
    icon: 'fa-building',
    color: 'blue'
  },
  {
    title: 'E-Commerce Marketing',
    description: 'Personalisierte Kampagnen für Online-Shops mit automatischem Retargeting.',
    icon: 'fa-shopping-cart',
    color: 'green'
  },
  {
    title: 'Event-Promotion',
    description: 'Vermarkten Sie Events und Webinare mit Multi-Channel-Kampagnen und Reminder-Automation.',
    icon: 'fa-calendar-star',
    color: 'purple'
  },
  {
    title: 'SaaS Customer Acquisition',
    description: 'Lead-Nurturing-Flows speziell für SaaS mit Trial-Tracking und Onboarding-Automation.',
    icon: 'fa-rocket',
    color: 'pink'
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='max-w-7xl mx-auto'>
    <!-- Features Grid -->
    <div class='text-center mb-16 gsap-fadein'>
      <h2 class='text-sm font-bold uppercase tracking-widest text-violet-400 mb-4'>
        Core Capabilities
      </h2>
      <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
        Features & <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Roadmap</span>
      </p>
      <p class='text-xl text-meg-text-secondary max-w-3xl mx-auto'>
        Vollautomatisierte Workflows, die mit Ihren Anforderungen wachsen.
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-24'>
      {features.map((feature, index) => (
        <div 
          class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/30 transition-all duration-300 group shadow-sm'
          style={`animation-delay: ${index * 0.08}s`}
        >
          <div class='flex items-start justify-between mb-6'>
            <div class='size-12 rounded-xl bg-meg-bg-dark border border-meg-border-dark flex items-center justify-center group-hover:scale-110 transition-transform shadow-inner'>
              <i class={`fa-solid ${feature.icon} text-violet-400 text-xl`} aria-hidden='true'></i>
            </div>
            <span class={`px-2 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-tighter ${
              feature.status === 'available' ? 'bg-emerald-500/10 text-emerald-400' :
              feature.status === 'beta' ? 'bg-violet-500/10 text-violet-400' :
              'bg-meg-bg-dark border border-meg-border-dark text-meg-text-secondary'
            }`}>
              {feature.status === 'available' ? 'Available' :
               feature.status === 'beta' ? 'Beta' : 'Roadmap'}
            </span>
          </div>
          <h3 class='text-lg font-bold text-meg-text-primary-dark mb-3'>{feature.title}</h3>
          <p class='text-meg-text-secondary text-sm leading-relaxed'>{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Use Cases -->
    <div class='gsap-fadein mb-24' style='animation-delay: 0.6s'>
      <h3 class='text-3xl font-black text-meg-text-primary-dark text-center mb-12 tracking-tight'>
        Anwendungsbereiche
      </h3>
      <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-8'>
        {useCases.map((useCase) => (
          <div 
            class='bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/30 transition-all duration-300 text-center group'
          >
            <div class={`size-16 rounded-full mx-auto mb-6 bg-meg-bg-dark border border-meg-border-dark flex items-center justify-center shadow-inner group-hover:scale-110 transition-transform`}>
              <i class={`fa-solid ${useCase.icon} text-violet-400 text-2xl`} aria-hidden='true'></i>
            </div>
            <h4 class='text-xl font-bold text-meg-text-primary-dark mb-2'>{useCase.title}</h4>
            <p class='text-meg-text-secondary text-sm leading-relaxed'>{useCase.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Beta CTA -->
    <div class='gsap-fadein bg-meg-surface-dark/80 backdrop-blur-xl border-2 border-violet-500/20 rounded-2xl p-10 text-center shadow-2xl shadow-violet-500/5' style='animation-delay: 0.8s'>
      <h3 class='text-2xl font-black text-meg-text-primary-dark mb-4 tracking-tight'>
        <i class='fa-solid fa-flask text-violet-400 mr-2' aria-hidden='true'></i>
        Beta Access
      </h3>
      <p class='text-lg text-meg-text-secondary max-w-3xl mx-auto mb-10'>
        <strong class='text-meg-text-primary-dark'>Early Access für Q1 2026.</strong> 
        Profitieren Sie von exklusiven Vorteilen als Early Adopter.
      </p>
      
      <div class='grid md:grid-cols-3 gap-6 mb-10 max-w-4xl mx-auto'>
        {[
          { icon: 'fa-star', text: '50% Lifetime-Rabatt', color: 'yellow' },
          { icon: 'fa-wand-magic-sparkles', text: 'Custom AI Models', color: 'violet' },
          { icon: 'fa-comments', text: 'Direct Engineering Support', color: 'sky' }
        ].map(benefit => (
          <div class='bg-meg-bg-dark border border-meg-border-dark rounded-xl p-6 shadow-inner'>
            <i class={`fa-solid ${benefit.icon} text-${benefit.color}-400 text-2xl mb-3`}></i>
            <p class='text-meg-text-primary-dark font-bold text-sm'>{benefit.text}</p>
          </div>
        ))}
      </div>

      <a
        href='https://portal.waldheim.dev'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-2 px-8 py-4 bg-violet-600 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-violet-500/30 transition-all hover:scale-[1.02]'
      >
        <i class='fa-solid fa-user-plus' aria-hidden='true'></i>
        Beta-Zugang anfragen
      </a>
    </div>
  </div>
</section>
