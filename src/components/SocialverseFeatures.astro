---
const features = [
  {
    icon: 'fa-brain',
    title: 'AI-gestützte Lead-Qualifizierung',
    description: 'Unsere KI analysiert Leads in Echtzeit und priorisiert automatisch nach Conversion-Wahrscheinlichkeit.',
    status: 'available',
    color: 'purple'
  },
  {
    icon: 'fa-robot',
    title: 'Automatisierte Kampagnen',
    description: 'Erstellen Sie einmal, optimieren lassen. Die KI passt Kampagnen kontinuierlich an Performance-Daten an.',
    status: 'available',
    color: 'purple'
  },
  {
    icon: 'fa-shield-check',
    title: 'DSGVO-konform by Design',
    description: 'Made in Germany. Alle Daten werden auf deutschen Servern gespeichert und DSGVO-konform verarbeitet.',
    status: 'available',
    color: 'green'
  },
  {
    icon: 'fa-chart-network',
    title: 'Multi-Channel Integration',
    description: 'Facebook, Instagram, LinkedIn, Twitter/X – alle Kanäle zentral verwalten und automatisieren.',
    status: 'available',
    color: 'blue'
  },
  {
    icon: 'fa-sparkles',
    title: 'Content-Generierung mit GPT-4',
    description: 'Lassen Sie die KI E-Mails, Social Posts und Landingpage-Texte schreiben – perfekt auf Ihre Zielgruppe zugeschnitten.',
    status: 'beta',
    color: 'purple'
  },
  {
    icon: 'fa-chart-line',
    title: 'Predictive Analytics',
    description: 'Vorhersagen über Kampagnen-Performance, Churn-Risiko und optimale Kontaktzeiten.',
    status: 'planned',
    color: 'orange'
  },
  {
    icon: 'fa-code-branch',
    title: 'API & Integrationen',
    description: 'Zapier, Make, REST-API – verbinden Sie Socialverse mit Ihren bestehenden Tools.',
    status: 'planned',
    color: 'orange'
  },
  {
    icon: 'fa-users',
    title: 'Team-Collaboration',
    description: 'Gemeinsam an Kampagnen arbeiten, Aufgaben zuweisen und Performance tracken.',
    status: 'planned',
    color: 'orange'
  }
];

const useCases = [
  {
    title: 'B2B Lead-Generierung',
    description: 'Generieren und qualifizieren Sie B2B-Leads mit LinkedIn-Integration und AI-Scoring.',
    icon: 'fa-building',
    color: 'blue'
  },
  {
    title: 'E-Commerce Marketing',
    description: 'Personalisierte Kampagnen für Online-Shops mit automatischem Retargeting.',
    icon: 'fa-shopping-cart',
    color: 'green'
  },
  {
    title: 'Event-Promotion',
    description: 'Vermarkten Sie Events und Webinare mit Multi-Channel-Kampagnen und Reminder-Automation.',
    icon: 'fa-calendar-star',
    color: 'purple'
  },
  {
    title: 'SaaS Customer Acquisition',
    description: 'Lead-Nurturing-Flows speziell für SaaS mit Trial-Tracking und Onboarding-Automation.',
    icon: 'fa-rocket',
    color: 'pink'
  }
];
---

<section class='py-20 px-6 bg-gradient-to-b from-dark-900 via-dark-950 to-dark-900'>
  <div class='max-w-7xl mx-auto'>
    <!-- Features Grid -->
    <div class='text-center mb-16 gsap-fadein'>
      <h2 class='text-4xl md:text-5xl font-bold text-white mb-6'>
        Features & <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500'>Roadmap</span>
      </h2>
      <p class='text-xl text-light-300 max-w-3xl mx-auto'>
        Socialverse wächst mit Ihren Anforderungen. Aktuelle Features und geplante Erweiterungen im Überblick.
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-20'>
      {features.map((feature, index) => (
        <div 
          class='gsap-fadein bg-dark-900/50 border border-light-500/10 rounded-xl p-6 hover:border-purple-500/30 transition-all duration-300 group'
          style={`animation-delay: ${index * 0.08}s`}
        >
          <div class='flex items-start justify-between mb-4'>
            <div class={`w-12 h-12 rounded-lg bg-gradient-to-br ${
              feature.color === 'purple' ? 'from-purple-500 to-pink-500' :
              feature.color === 'green' ? 'from-green-400 to-emerald-500' :
              feature.color === 'blue' ? 'from-blue-400 to-cyan-500' :
              'from-orange-400 to-red-500'
            } flex items-center justify-center group-hover:scale-110 transition-transform`}>
              <i class={`fa-solid ${feature.icon} text-white text-xl`} aria-hidden='true'></i>
            </div>
            <span class={`px-3 py-1 rounded-full text-xs font-bold ${
              feature.status === 'available' ? 'bg-green-500/20 text-green-400' :
              feature.status === 'beta' ? 'bg-purple-500/20 text-purple-400' :
              'bg-orange-500/20 text-orange-400'
            }`}>
              {feature.status === 'available' ? '✓ Verfügbar' :
               feature.status === 'beta' ? 'Beta' : 'Q2 2026'}
            </span>
          </div>
          <h3 class='text-lg font-bold text-white mb-2'>{feature.title}</h3>
          <p class='text-sm text-light-400'>{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Use Cases -->
    <div class='gsap-fadein mb-16' style='animation-delay: 0.6s'>
      <h3 class='text-3xl font-bold text-white text-center mb-12'>
        Perfekt für diese Use Cases
      </h3>
      <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-6'>
        {useCases.map((useCase, index) => (
          <div 
            class='bg-gradient-to-br from-dark-900 to-dark-950 border border-light-500/10 rounded-xl p-6 hover:border-purple-500/30 transition-all duration-300 text-center'
          >
            <div class={`w-16 h-16 rounded-full mx-auto mb-4 bg-gradient-to-br ${
              useCase.color === 'blue' ? 'from-blue-400 to-cyan-500' :
              useCase.color === 'green' ? 'from-green-400 to-emerald-500' :
              useCase.color === 'purple' ? 'from-purple-500 to-pink-500' :
              'from-pink-400 to-rose-500'
            } flex items-center justify-center`}>
              <i class={`fa-solid ${useCase.icon} text-white text-2xl`} aria-hidden='true'></i>
            </div>
            <h4 class='text-xl font-bold text-white mb-2'>{useCase.title}</h4>
            <p class='text-sm text-light-400'>{useCase.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Beta CTA -->
    <div class='gsap-fadein bg-gradient-to-r from-purple-900/20 to-pink-900/20 border border-purple-500/30 rounded-2xl p-8 text-center' style='animation-delay: 0.8s'>
      <h3 class='text-2xl font-bold text-white mb-4'>
        <i class='fa-solid fa-flask text-purple-400 mr-2' aria-hidden='true'></i>
        Werden Sie Beta-Tester
      </h3>
      <p class='text-lg text-light-300 max-w-3xl mx-auto mb-6'>
        <strong class='text-white'>Closed Beta startet Q1 2026.</strong> 
        Registrieren Sie sich jetzt für Early Access und profitieren Sie von:
      </p>
      <div class='grid md:grid-cols-3 gap-4 mb-6 max-w-4xl mx-auto'>
        <div class='bg-dark-900/50 rounded-lg p-4'>
          <i class='fa-solid fa-star text-yellow-400 text-2xl mb-2' aria-hidden='true'></i>
          <p class='text-white font-semibold'>50% Lifetime-Rabatt</p>
        </div>
        <div class='bg-dark-900/50 rounded-lg p-4'>
          <i class='fa-solid fa-wand-magic-sparkles text-purple-400 text-2xl mb-2' aria-hidden='true'></i>
          <p class='text-white font-semibold'>Exklusive Features</p>
        </div>
        <div class='bg-dark-900/50 rounded-lg p-4'>
          <i class='fa-solid fa-comments text-blue-400 text-2xl mb-2' aria-hidden='true'></i>
          <p class='text-white font-semibold'>Direkter Support</p>
        </div>
      </div>
      <a
        href='/kontakt/'
        class='inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold text-lg rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition-all duration-300'
      >
        <i class='fa-solid fa-user-plus' aria-hidden='true'></i>
        Jetzt für Beta registrieren
      </a>
    </div>
  </div>
</section>
