---
const tools = [
  {
    title: "Astro AI llms.txt Generator",
    desc: "NPM-Package zur automatischen Erstellung von llms.txt Dateien für KI-optimierte SEO.",
    link: "/astro-ai-llms-txt/",
    icon: "fa-solid fa-sparkles",
    tag: "NPM Package"
  },
  {
    title: "Ausgabeschein Generator",
    desc: "Ein spezialisiertes Tool für die einfache Erstellung von Material-Ausgabescheinen.",
    link: "/ausgabeschein-generator/",
    icon: "fa-solid fa-clipboard-list",
    tag: "Web Tool"
  },
  {
    title: "WetterApp (Open Source)",
    desc: "Moderne Wettervorhersage mit Multi-Provider System als Referenz für Cloud-Architektur.",
    link: "/waetherapp/",
    icon: "fa-solid fa-cloud-sun",
    tag: "Open Source"
  },
  {
    title: "Obsidian Gemini AI Agent",
    desc: "Ein Obsidian-Plugin, das Gemini AI Agenten für intelligente Notizinteraktionen integriert.",
    link: "/obsidian-gemini-agent/",
    icon: "fa-solid fa-brain",
    tag: "Obsidian Plugin"
  }
];
---

<section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
          Open Source & Tools
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-normal text-meg-text-primary-dark">
          Kostenlose <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent">Werkzeuge</span> für Entwickler
        </p>
      </div>
      <a href="/referenzen/1/" class="gsap-fadein text-meg-accent font-bold flex items-center gap-2 hover:gap-4 transition-all">
        Alle Projekte ansehen <i class="fa-solid fa-arrow-right"></i>
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {tools.map((tool, i) => (
        <a href={tool.link} class="gsap-fadein group bg-meg-surface-dark/30 border border-meg-border-dark rounded-3xl p-8 hover:border-emerald-500/30 transition-all shadow-sm flex flex-col h-full" style={`animation-delay: ${i * 0.1}s`}>
          <div class="size-14 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            <i class={`${tool.icon} text-emerald-400 text-2xl`}></i>
          </div>
          <div class="mb-2">
            <span class="text-[10px] font-black uppercase tracking-widest text-emerald-500/70 border border-emerald-500/20 px-2 py-1 rounded-md">{tool.tag}</span>
          </div>
          <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4 group-hover:text-emerald-400 transition-colors">{tool.title}</h3>
          <p class="text-meg-text-secondary text-sm leading-relaxed flex-grow">
            {tool.desc}
          </p>
          <div class="mt-8 flex items-center gap-2 text-meg-text-primary-dark font-bold text-sm">
            Jetzt ausprobieren <i class="fa-solid fa-chevron-right text-xs group-hover:translate-x-1 transition-transform"></i>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
