---

<section id="opensource-stack" class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark" aria-labelledby="opensource-heading">
  <div class="mx-auto max-w-7xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
      <div class="max-w-2xl">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
          Open-Source Stack & Developer Tools
        </p>
        <h2 id="opensource-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-normal text-meg-text-primary-dark">
          Offene <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-sky-400 to-emerald-400">Engineering-Standards</span> für die Community
        </h2>
      </div>
      <a href="/referenzen/1/" class="gsap-fadein text-meg-accent font-bold flex items-center gap-2 hover:gap-4 transition-all">
        Alle Projekte ansehen <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <!-- Flagship Spotlight: semrel -->
    <article class="gsap-fadein relative group mb-12 rounded-3xl bg-gradient-to-br from-blue-500/10 via-meg-surface-dark/60 to-meg-bg-dark border border-blue-500/30 hover:border-blue-400/60 p-8 lg:p-12 transition-all duration-500 overflow-hidden shadow-xl">
      <div class="absolute -inset-1 bg-gradient-to-r from-blue-500/10 to-sky-400/10 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity -z-10" aria-hidden="true"></div>
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-2 mb-6">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/15 border border-blue-500/30 text-xs font-black uppercase tracking-widest text-blue-400">
              <i class="fa-brands fa-golang" aria-hidden="true"></i>
              Flagship Open Source
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-bold text-meg-text-primary-dark">
              <i class="fa-solid fa-code-branch text-sky-400" aria-hidden="true"></i>
              v{semrel.version} · Latest
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-bold text-emerald-400">
              <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
              Apache 2.0
            </span>
          </div>

          <h3 class="text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
            semrel — Zero-Dependency Semantic Release Automation
          </h3>
          <p class="text-meg-text-secondary text-base md:text-lg leading-relaxed mb-6">
            Die Go-native Alternative zu <code class="font-mono text-sky-400">semantic-release</code> für regulierte CI/CD-Pipelines und Monorepos: eine einzige statische Binärdatei ohne Node.js-Abhängigkeitsbaum, mit reproduzierbarem <code class="font-mono text-sky-400">.semrel.lock</code>, Air-Gap-Modus und integrierter Supply-Chain-Security.
          </p>

          <ul class="grid sm:grid-cols-2 gap-3 text-sm text-meg-text-secondary mb-8">
            <li class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-emerald-400" aria-hidden="true"></i>
              <span><strong>46 Plugins</strong> &amp; 8-Phasen-Pipeline</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-emerald-400" aria-hidden="true"></i>
              <span><strong>Cosign v3 (--bundle)</strong>, SBOM &amp; SLSA</span>
            </li>
            <li class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-emerald-400" aria-hidden="true"></i>
              <span><strong>Air-Gap Ready</strong> via <code class="font-mono text-xs">.semrel.lock</code></span>
            </li>
            <li class="flex items-center gap-2">
              <i class="fa-solid fa-circle-check text-emerald-400" aria-hidden="true"></i>
              <span><strong>Monorepo Workspace</strong> &amp; Env-Interpolation</span>
            </li>
          </ul>

          <div class="flex flex-wrap items-center gap-4">
            <a
              href="/semrel/"
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 text-white font-bold text-sm hover:shadow-lg hover:shadow-blue-500/25 hover:scale-[1.02] transition-all"
            >
              <i class="fa-solid fa-rocket" aria-hidden="true"></i>
              semrel v{semrel.version} entdecken
            </a>
            <a
              href="https://github.com/SemRels/semrel"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-sm hover:border-blue-500/50 transition-all"
              aria-label="semrel Repository auf GitHub öffnen"
            >
              <i class="fa-brands fa-github" aria-hidden="true"></i>
              GitHub
              <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
            </a>
            <a
              href="https://www.semrel.io/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-sm hover:border-sky-400/50 transition-all"
              aria-label="semrel Dokumentation auf semrel.io öffnen"
            >
              <i class="fa-solid fa-book" aria-hidden="true"></i>
              semrel.io Docs
            </a>
            <a
              href="/referenzen/waldheim-dev/semrel/"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-meg-surface-dark border border-blue-500/30 text-blue-400 font-bold text-sm hover:bg-blue-500/10 transition-all"
              aria-label="semrel Referenz und Case Study lesen"
            >
              <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
              Case Study
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl bg-meg-bg-dark/90 border border-meg-border-dark p-6 font-mono text-xs sm:text-sm shadow-2xl" role="region" aria-label="semrel Schnellstart im Terminal">
            <div class="flex items-center justify-between border-b border-meg-border-dark pb-3 mb-4 text-meg-text-secondary">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-terminal text-blue-400" aria-hidden="true"></i>
                <span class="uppercase tracking-widest text-[11px] font-bold">Quick Start · semrel v{semrel.version}</span>
              </div>
              <span class="text-[10px] text-emerald-400 font-bold">zero-deps</span>
            </div>
            <pre tabindex="0" aria-label="semrel Schnellstart Befehle" class="text-sky-300 overflow-x-auto leading-relaxed"><code># Binary installieren &amp; Config anlegen
go install github.com/SemRels/semrel/cmd/semrel@latest
semrel config init

# Plugins pinnen &amp; Pre-Flight Check
semrel plugin install @semrel/conventional
semrel plugin install @semrel/github
semrel doctor

# Dry-Run &amp; automatisiertes Release
semrel release --dry-run
semrel release</code></pre>
          </div>
        </div>
      </div>
    </article>

    <div class="grid md:grid-cols-3 gap-8">
      {tools.map((tool, i) => (
        <article class="gsap-fadein group bg-meg-surface-dark/30 border border-meg-border-dark rounded-3xl p-8 hover:border-emerald-500/30 transition-all shadow-sm flex flex-col h-full" style={`animation-delay: ${i * 0.1}s`}>
