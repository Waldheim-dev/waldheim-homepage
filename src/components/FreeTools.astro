            <i class={`${tool.icon} text-emerald-400 text-2xl`} aria-hidden="true"></i>
          </div>
          <div class="mb-2">
            <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400 border border-emerald-500/20 px-2 py-1 rounded-md">{tool.tag}</span>
          </div>
          <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4 group-hover:text-emerald-400 transition-colors">
            <a href={tool.link}>{tool.title}</a>
          </h3>
          <p class="text-meg-text-secondary text-sm leading-relaxed flex-grow">
            {tool.desc}
          </p>
          <div class="mt-8 pt-4 border-t border-meg-border-dark/60 flex items-center justify-between gap-4 text-sm">
            <a href={tool.link} class="flex items-center gap-2 text-meg-text-primary-dark font-bold hover:text-emerald-400 transition-colors">
              Produktseite <i class="fa-solid fa-chevron-right text-xs" aria-hidden="true"></i>
            </a>
            <a href={tool.refLink} class="flex items-center gap-1.5 text-xs font-bold text-meg-accent hover:underline" aria-label={`Case Study zu ${tool.title} lesen`}>
              <i class="fa-solid fa-diagram-project" aria-hidden="true"></i>
              Case Study
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
