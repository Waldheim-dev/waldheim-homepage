---
interface TechStack {
  category: string;
  items: Array<{
    name: string;
    icon: string;
    color: string;
  }>;
}

const techStack: TechStack[] = [
  {
    category: 'Backend',
    items: [
      { name: 'Go 1.25+', icon: 'fa-solid fa-server', color: 'text-blue-400' },
      { name: 'REST API', icon: 'fa-solid fa-plug', color: 'text-cyan-400' }
    ]
  },
  {
    category: 'Frontend',
    items: [
      { name: 'React', icon: 'fa-brands fa-react', color: 'text-cyan-400' },
      { name: 'TypeScript', icon: 'fa-solid fa-code', color: 'text-blue-400' }
    ]
  },
  {
    category: 'Styling & Animationen',
    items: [
      { name: 'TailwindCSS 4', icon: 'fa-solid fa-palette', color: 'text-blue-400' },
      { name: 'GSAP', icon: 'fa-solid fa-film', color: 'text-cyan-400' }
    ]
  },
  {
    category: 'Infrastruktur',
    items: [
      { name: 'Docker', icon: 'fa-brands fa-docker', color: 'text-blue-400' },
      { name: 'PostgreSQL', icon: 'fa-solid fa-database', color: 'text-cyan-400' },
      { name: 'Valkey', icon: 'fa-solid fa-bolt', color: 'text-yellow-400' }
    ]
  },
  {
    category: 'Testing',
    items: [
      { name: 'Playwright', icon: 'fa-solid fa-circle-check', color: 'text-green-400' },
      { name: 'Go Tests', icon: 'fa-solid fa-shield', color: 'text-blue-400' }
    ]
  }
];
---

<section class="py-24 sm:py-32 px-6 bg-dark-950">
  <div class="container mx-auto max-w-6xl">
    <!-- Header -->
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-4xl md:text-5xl font-bold text-white">
        Moderne Technologie
      </h2>
      <p class="text-xl text-light-300 max-w-2xl mx-auto">
        Gebaut mit bewährten Technologien und Best Practices
      </p>
    </div>
    
    <!-- Tech Stack Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-6">
      {techStack.map((group) => (
        <div class="relative group">
          <!-- Ambient Glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-blue-500/10 to-cyan-500/10 
                      blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10 rounded-xl"></div>
          
          <!-- Card -->
          <div class="relative bg-dark-900/50 border border-light-500/20 
                      hover:border-light-500/40 rounded-xl p-6 
                      transition-all duration-300 h-full">
            <!-- Category -->
            <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
              <span class="w-1 h-6 bg-gradient-to-b from-blue-400 to-cyan-400 rounded"></span>
              {group.category}
            </h3>
            
            <!-- Tech Items -->
            <div class="space-y-4">
              {group.items.map((item) => (
                <div class="flex items-center gap-3">
                  <i class={`${item.icon} text-xl ${item.color}`} aria-hidden="true"></i>
                  <span class="text-light-300 text-sm font-medium">{item.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
