---
interface TechStack {
  category: string;
  items: Array<{
    name: string;
    icon: string;
    color: string;
  }>;
}

const techStack: TechStack[] = [
  {
    category: 'Backend',
    items: [
      { name: 'Go 1.25+', icon: 'fa-solid fa-server', color: 'text-blue-400' },
      { name: 'REST API', icon: 'fa-solid fa-plug', color: 'text-cyan-400' }
    ]
  },
  {
    category: 'Frontend',
    items: [
      { name: 'React', icon: 'fa-brands fa-react', color: 'text-cyan-400' },
      { name: 'TypeScript', icon: 'fa-solid fa-code', color: 'text-blue-400' }
    ]
  },
  {
    category: 'Styling & Animationen',
    items: [
      { name: 'TailwindCSS 4', icon: 'fa-solid fa-palette', color: 'text-blue-400' },
      { name: 'GSAP', icon: 'fa-solid fa-film', color: 'text-cyan-400' }
    ]
  },
  {
    category: 'Infrastruktur',
    items: [
      { name: 'Docker', icon: 'fa-brands fa-docker', color: 'text-blue-400' },
      { name: 'PostgreSQL', icon: 'fa-solid fa-database', color: 'text-cyan-400' },
      { name: 'Valkey', icon: 'fa-solid fa-bolt', color: 'text-yellow-400' }
    ]
  },
  {
    category: 'Testing',
    items: [
      { name: 'Playwright', icon: 'fa-solid fa-circle-check', color: 'text-green-400' },
      { name: 'Go Tests', icon: 'fa-solid fa-shield', color: 'text-blue-400' }
    ]
  }
];
---

<section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="container mx-auto max-w-7xl">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
        Engineering
      </h2>
      <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark">
        Modern <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Stack</span>
      </p>
    </div>
    
    <!-- Tech Stack Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-6">
      {techStack.map((group) => (
        <div class="relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-br from-meg-accent/10 to-sky-400/10 blur opacity-0 group-hover:opacity-100 transition duration-500 rounded-2xl"></div>
          
          <!-- Card -->
          <div class="relative h-full bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group-hover:border-meg-accent/30 transition-all">
            <!-- Category -->
            <h3 class="text-base font-bold text-meg-text-primary-dark mb-8 flex items-center gap-2 tracking-tight">
              <span class="w-1 h-5 bg-meg-accent rounded-full"></span>
              {group.category}
            </h3>
            
            <!-- Tech Items -->
            <div class="space-y-6">
              {group.items.map((item) => (
                <div class="flex items-center gap-4">
                  <div class="size-8 bg-meg-bg-dark border border-meg-border-dark rounded-lg flex items-center justify-center shrink-0 shadow-inner group-hover:scale-110 transition-transform">
                    <i class={`${item.icon} text-sm text-meg-accent`} aria-hidden="true"></i>
                  </div>
                  <span class="text-meg-text-secondary text-sm font-bold tracking-tight">{item.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
