---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import KarriereProject from './KarriereProject.astro';
const karriere = (await getCollection('karriere')).sort(
  (a, b) => b.data.from.valueOf() - a.data.from.valueOf()
);
---

<section class="px-6 py-24 sm:py-32 lg:px-8 bg-meg-bg-dark border-y border-meg-border-dark">
  <div class="mx-auto max-w-2xl text-center mb-16">
    <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4" style="animation-delay: 0s">
      <i class="fa-solid fa-briefcase mr-2" aria-hidden="true"></i>
      Mein beruflicher Weg
    </p>
    <h2 class="gsap-fadein text-4xl sm:text-5xl font-bold tracking-tight text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
      Karriere-<span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Highlights</span>
    </h2>
    <p class="gsap-fadein text-xl text-meg-text-secondary" style="animation-delay: 0.3s">
      Überblick über meine bisherigen beruflichen Stationen und Projekte.
    </p>
  </div>
  
  <div class="mx-auto max-w-7xl px-6 space-y-12">
    { karriere.map((kar, index) => (
      <div class="gsap-fadein mx-auto max-w-4xl bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/30 hover:shadow-lg hover:shadow-meg-accent/5 transition-all duration-300" style={`animation-delay: ${0.45 + index * 0.1}s`}>
        <div class="mx-auto">
          <div class="flex items-center gap-2 text-base font-semibold text-meg-accent mb-3">
            <i class="fa-solid fa-calendar" aria-hidden="true"></i>
            <FormattedDate date={kar.data.from} /> - {kar.data.to ? (<FormattedDate date={kar.data.to} />) : ('heute')}
          </div>
          <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-2">{kar.data.company}</h3>
          <p class="text-lg text-meg-text-primary-dark font-medium mb-3">
            <i class="fa-solid fa-user-tie text-meg-accent mr-2" aria-hidden="true"></i>
            {kar.data.position}
          </p>
          <p class="text-base text-meg-text-secondary leading-relaxed">{kar.data.description}</p>
        </div>
        { (kar.data.projects || kar.data.projectReferences || kar.data.showAllReferences) && (
          <div class="mt-8 pt-8 border-t border-meg-border-dark">
            <KarriereProject 
              projects={kar.data.projects} 
              projectReferences={kar.data.projectReferences}
              showAllReferences={kar.data.showAllReferences}
              companyName={kar.data.company}
            />
          </div>
        )}
      </div>
    ))}
  </div>
</section>