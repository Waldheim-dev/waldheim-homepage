---
// This code has been partially generated by an AI.
const { isActive, fixedExperience, sinceLastRollup } = Astro.props;
const current = new Date();
const since = sinceLastRollup ? new Date(sinceLastRollup) : null;
const hasValidSince = since !== null && !Number.isNaN(since.getTime());
let dateDiff = 0;

if (hasValidSince) {
  dateDiff = current.getFullYear() - since.getFullYear();
  const months = current.getMonth() - since.getMonth();
  if (dateDiff <= 0) {
    switch (true) {
      case months < 4:
        dateDiff = 0.25;
        break;
      case months < 7:
        dateDiff = 0.5;
        break;
      case months < 10:
        dateDiff = 0.75;
        break;
      default:
        dateDiff = 1;
        break;
    }
  }
}

const dynamicExperience = isActive && hasValidSince ? dateDiff + fixedExperience : fixedExperience;
let year = 'Jahr';

if (dynamicExperience != 1) {
  year = 'Jahre';
}
---

<small class='w-full text-center text-xs text-dark-100'>{dynamicExperience.toString().replace('.', ',')} { year } Erfahrung</small>