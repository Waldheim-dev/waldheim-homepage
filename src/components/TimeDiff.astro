---
const { isActive, fixedExperience, sinceLastRollup } = Astro.props;
const current = new Date();
const since = new Date(sinceLastRollup);
let dateDiff = current.getFullYear() - since.getFullYear();
const months = current.getMonth() - since.getMonth();
if( dateDiff <= 0){
  switch (true) {
    case months < 4:
      dateDiff = 0.25;
      break;
    case months < 7:
      dateDiff = 0.5;
      break;
    case months < 10:
      dateDiff = 0.75;
      break;
    default:
      dateDiff = 1;
      break;
  }
}
const dynamicExperience = isActive ? dateDiff : fixedExperience;
---

<small class='w-full text-center text-gray-700 dark:text-gray-300'>{dynamicExperience.toString().replace('.', ',')} Jahr/e Exp.</small>