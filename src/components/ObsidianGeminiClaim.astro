---
// Obsidian Gemini Agent Claim Section für Homepage
import { getProductInfo } from '../consts/productColors';

const obsidianGeminiAgent = getProductInfo('obsidian-gemini-agent')!;
---

<section class='py-24 px-6 bg-meg-surface-dark/10 border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='grid lg:grid-cols-2 gap-16 items-center'>
      
      <!-- Visual Content -->
      <div class='relative gsap-fadein group order-2 lg:order-1'>
        <div class='relative'>
          <!-- Ambient Glow -->
          <div class='absolute -inset-4 bg-gradient-to-r from-indigo-500/10 via-violet-500/10 to-indigo-500/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000 -z-10'></div>
          
          <!-- Placeholder or Icon Visual -->
          <div class='relative rounded-3xl aspect-video bg-meg-surface-dark border border-meg-border-dark flex items-center justify-center overflow-hidden shadow-2xl transition-transform duration-700 group-hover:scale-[1.01]'>
            <div class='absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-indigo-500 via-transparent to-transparent'></div>
            <i class='fa-solid fa-brain-circuit text-8xl md:text-9xl text-indigo-400 group-hover:scale-110 transition-transform duration-500' aria-hidden='true'></i>
            
            <!-- Floating Elements -->
            <div class='absolute top-10 left-10 size-12 rounded-xl bg-meg-bg-dark/80 border border-meg-border-dark flex items-center justify-center animate-bounce shadow-lg' style='animation-duration: 3s'>
              <i class='fa-solid fa-hashtag text-indigo-400 text-xl'></i>
            </div>
            <div class='absolute bottom-10 right-10 size-14 rounded-xl bg-meg-bg-dark/80 border border-meg-border-dark flex items-center justify-center animate-bounce shadow-lg' style='animation-duration: 4s; animation-delay: 1s'>
              <i class='fa-solid fa-command text-violet-400 text-2xl'></i>
            </div>
          </div>
        </div>

        <!-- Floating Stats -->
        <div class='absolute -bottom-6 -right-6 bg-meg-surface-dark/90 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-4 shadow-2xl group-hover:border-indigo-500/30 transition-all'>
          <div class='flex items-center gap-4'>
            <div class='flex items-center gap-2'>
              <div class="size-2 rounded-full bg-indigo-400 animate-pulse"></div>
              <span class='text-meg-text-primary-dark font-black text-sm tracking-tighter'>v{obsidianGeminiAgent.version}</span>
            </div>
            <div class='w-px h-4 bg-meg-border-dark'></div>
            <div class='flex items-center gap-2'>
              <i class='fa-brands fa-github text-indigo-400 text-xs' aria-hidden='true'></i>
              <span class='text-meg-text-secondary text-[10px] font-bold uppercase tracking-widest'>Open Source</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Text Content -->
      <div class='gsap-fadein order-1 lg:order-2'>
        <div class='mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark shadow-sm'>
          <i class='fa-solid fa-brain-circuit text-indigo-400' aria-hidden='true'></i>
          <span class='text-meg-text-primary-dark font-bold text-sm tracking-tight'>AI Agent für Obsidian</span>
          <span
            class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-0.5 text-[10px] font-black uppercase tracking-tighter ml-2 ${obsidianGeminiAgent.colors.badgeBg} ${obsidianGeminiAgent.colors.badgeBorder} ${obsidianGeminiAgent.colors.badgeText}`}>
            <i class={`fa-solid fa-circle text-${obsidianGeminiAgent.colors.iconColor} text-[4px]`} aria-hidden='true'></i>
            {obsidianGeminiAgent.status !== 'stable' ? `${obsidianGeminiAgent.status}` : `v${obsidianGeminiAgent.version}`}
          </span>
        </div>

        <h2 class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-500'>Gemini AI Agent</span> – Denken neu gedacht.
        </h2>

        <p class='text-xl text-meg-text-secondary mb-8 leading-relaxed'>
          Verwandeln Sie Ihren Obsidian-Vault in ein interaktives Wissensnetzwerk. Ein autonomer Agent, der Ihre Notizen liest, schreibt und für Sie organisiert.
        </p>

        <div class='grid grid-cols-2 gap-6 mb-10'>
          {[
            { icon: 'fa-folder-tree', title: 'Autonom', desc: 'Navigiert Ihren Vault' },
            { icon: 'fa-hashtag', title: 'Smart', desc: 'Kontext-Mentions' },
            { icon: 'fa-bolt-lightning', title: 'Gemini Pro', desc: 'Multi-Modell Support' },
            { icon: 'fa-shield-halved', title: 'Privacy', desc: 'Secure Keychain' }
          ].map(item => (
            <div class='flex items-start gap-3'>
              <div class="size-10 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center shrink-0">
                <i class={`fa-solid ${item.icon} text-indigo-400`} aria-hidden='true'></i>
              </div>
              <div>
                <h3 class='text-meg-text-primary-dark font-bold text-sm'>{item.title}</h3>
                <p class='text-meg-text-secondary text-xs opacity-70'>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class='flex flex-col sm:flex-row gap-4'>
          <a 
            href='/obsidian-gemini-agent/' 
            class='gsap-btn inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-indigo-600 text-white font-bold hover:shadow-xl hover:shadow-indigo-500/20 transition-all hover:scale-[1.02]'
          >
            <i class='fa-solid fa-arrow-right' aria-hidden='true'></i>
            Plugin ansehen
          </a>
          <a 
            href='https://github.com/Waldheim-dev/obsidian-gemini-agent' 
            target='_blank'
            rel='noopener noreferrer'
            class='gsap-btn inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold hover:bg-meg-surface-dark hover:border-indigo-500/50 transition-all'
          >
            <i class='fa-brands fa-github' aria-hidden='true'></i>
            GitHub Repo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
