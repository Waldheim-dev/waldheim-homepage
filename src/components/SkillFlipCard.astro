---
const { entry } = Astro.props;
import TimeDiff from './TimeDiff.astro';
let progress = 0;
let color='';
switch (entry.data.knowledgebase) {
  case 'basic':
    progress = 33;
    color='bg-rose-500';
    break;
  case 'advanced':
    progress = 66;
    color='bg-primary-800';
    break;
  case 'expert':
    progress = 100;
    color='bg-primary-900';
    break;
  default:
    progress = 0;
}

const layer = JSON.stringify(entry.data.layer)
---
<div class='flip-card gsap-fadein' data-layer={layer}>
  <div class='flip-card-inner group bg-dark-900/50 border border-light-500/20 gap-1 rounded-xl hover:border-light-500/30 transition-all duration-300 h-36'>
  <div class='flip-front flex flex-col justify-center items-center gap-2 p-8 sm:p-10 relative'>
      <img
        class='max-h-12 w-full object-contain group-hover:brightness-110 transition-all duration-150'
        loading='lazy'
        src={entry.data.image} alt={entry.data.name} width='50'
        height='50'>
      <span class='w-full text-center text-light-100'>{entry.data.name}</span>
      { entry.data.isTechStack ? (
        <div class='text-blue-400 absolute right-1 top-1' title="Aktuell in Benutzung">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
            <path d="M5.507 4.048A3 3 0 0 1 7.785 3h8.43a3 3 0 0 1 2.278 1.048l1.722 2.008A4.533 4.533 0 0 0 19.5 6h-15c-.243 0-.482.02-.715.056l1.722-2.008Z" />
            <path fill-rule="evenodd" d="M1.5 10.5a3 3 0 0 1 3-3h15a3 3 0 1 1 0 6h-15a3 3 0 0 1-3-3Zm15 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm2.25.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM4.5 15a3 3 0 1 0 0 6h15a3 3 0 1 0 0-6h-15Zm11.25 3.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM19.5 18a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" clip-rule="evenodd" />
          </svg>
        </div>
      ) : null }
    </div>
    <div class='flip-back flex flex-col  justify-center items-center gap-2 p-4 sm:p-6'>
      { entry.data.isActive ? (
        <div class='text-green-400' title="Aktuell in Benutzung">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill='currentColor' class="w-6 h-6">
            <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549 4.49 4.49 0 0 1-3.498-1.306 4.491 4.491 0 0 1-1.307-3.498A4.49 4.49 0 0 1 2.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 0 1 1.307-3.497 4.49 4.49 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" />
          </svg>
        </div>
      ) : (
        <div class='text-rose-500' title="Derzeit pausiert">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM9 8.25a.75.75 0 0 0-.75.75v6c0 .414.336.75.75.75h.75a.75.75 0 0 0 .75-.75V9a.75.75 0 0 0-.75-.75H9Zm5.25 0a.75.75 0 0 0-.75.75v6c0 .414.336.75.75.75H15a.75.75 0 0 0 .75-.75V9a.75.75 0 0 0-.75-.75h-.75Z" clip-rule="evenodd" />
          </svg>
        </div>
      ) }
      
      <TimeDiff sinceLastRollup={entry.data.sinceLastRollup} isActive={entry.data.isActive}
                fixedExperience={entry.data.fixedExperience} />
      <div class='w-full bg-dark-950 rounded-md overflow-hidden'>
        <div style={`width: ${progress}%`} class={`${color} h-2 flex justify-center items-center`}>
          <span class='text-xs leading-none text-white sm-only hidden'>{entry.data.knowledgebase}</span>
        </div>

      </div>
    </div>
  </div>
</div>