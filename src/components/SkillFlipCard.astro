---
const { entry } = Astro.props;
import TimeDiff from './TimeDiff.astro';
let progress = 0;
let color='';
switch (entry.data.knowledgebase) {
  case 'basic':
    progress = 33;
    color='bg-rose-500/60';
    break;
  case 'advanced':
    progress = 66;
    color='bg-meg-accent/60';
    break;
  case 'expert':
    progress = 100;
    color='bg-meg-accent';
    break;
  default:
    progress = 0;
}

const layer = JSON.stringify(entry.data.layer)
---
<div class='flip-card gsap-fadein' data-layer={layer}>
  <div class='flip-card-inner relative w-full h-36 transition-transform duration-700 [transform-style:preserve-3d] group'>
    
    <!-- Front Face -->
    <div class='absolute inset-0 [backface-visibility:hidden] flex flex-col justify-center items-center gap-2 p-8 bg-meg-surface-dark border border-meg-border-dark rounded-2xl shadow-sm'>
      <img
        class={`max-h-12 w-full object-contain transition-all duration-300 ${entry.data.invertImage ? 'skill-logo-invert' : ''}`}
        loading='lazy'
        src={entry.data.image} alt={entry.data.name} width='50'
        height='50'>
      <span class='w-full text-center text-meg-text-primary-dark font-bold text-sm'>{entry.data.name}</span>
      { entry.data.isTechStack ? (
        <div class='text-meg-accent absolute right-2 top-2' title="Aktuell in Benutzung">
          <i class="fa-solid fa-server text-xs animate-pulse" aria-hidden="true"></i>
        </div>
      ) : null }
    </div>

    <!-- Back Face -->
    <div class='absolute inset-0 [backface-visibility:hidden] [transform:rotateY(180deg)] flex flex-col justify-center items-center gap-2 p-4 bg-meg-surface-dark border border-meg-accent/30 rounded-2xl shadow-lg'>
      { entry.data.isActive ? (
        <div class='text-emerald-400' title="Aktuell in Benutzung">
          <i class="fa-solid fa-circle-check text-xl" aria-hidden="true"></i>
        </div>
      ) : (
        <div class='text-rose-500' title="Derzeit pausiert">
          <i class="fa-solid fa-circle-pause text-xl" aria-hidden="true"></i>
        </div>
      ) }
      
      <TimeDiff sinceLastRollup={entry.data.sinceLastRollup} isActive={entry.data.isActive}
                fixedExperience={entry.data.fixedExperience} />
      <div class='w-full bg-meg-bg-dark rounded-full h-1.5 overflow-hidden mt-2'>
        <div style={`width: ${progress}%`} class={`${color} h-full transition-all duration-1000`}>
        </div>
      </div>
    </div>
  </div>
</div>