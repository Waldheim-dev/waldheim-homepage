---
const competitorsComparison = [
  { 
    name: 'Ecodrive', 
    price: 'Kostenlos', 
    proPriceYear: '29,99 €/Jahr',
    techno: 'Smartphone GPS',
    features: 'Unbegrenzt',
    fahrtenbuch: true, 
    multiVehicle: 'Pro',
    exportoption: true,
    datev: false,
    support: 'E-Mail + Community',
    highlight: true
  },
  { 
    name: 'Vimcar', 
    price: '0 € (Hardware)', 
    proPriceYear: '24,90 €/Monat (298,80 €/Jahr)',
    techno: 'OBD2-Stecker',
    features: 'Premium',
    fahrtenbuch: true, 
    multiVehicle: true,
    exportoption: true,
    datev: true,
    support: 'E-Mail + Telefon',
    highlight: false
  },
  { 
    name: 'FLEETIZE', 
    price: '0 € (Hardware)', 
    proPriceYear: '19,95 €/Monat (239,40 €/Jahr)',
    techno: 'OBD2-Stecker',
    features: 'Premium',
    fahrtenbuch: true, 
    multiVehicle: true,
    exportoption: true,
    datev: true,
    support: 'E-Mail + Chat',
    highlight: false
  },
  { 
    name: 'Driversnote', 
    price: 'Kostenlos (15 Fahrten)', 
    proPriceYear: '11 €/Monat (132 €/Jahr)',
    techno: 'Smartphone GPS + iBeacon',
    features: 'Basis',
    fahrtenbuch: true, 
    multiVehicle: 'Premium',
    exportoption: true,
    datev: false,
    support: 'E-Mail',
    highlight: false
  },
  { 
    name: 'KFZ Fahrtenbuch', 
    price: 'Kostenlos (manuell)', 
    proPriceYear: '4,19 €/Monat (50,28 €/Jahr)',
    techno: 'Smartphone GPS',
    features: 'Basis',
    fahrtenbuch: true, 
    multiVehicle: 'Pro Plus',
    exportoption: true,
    datev: false,
    support: 'FAQ',
    highlight: false
  },
  { 
    name: 'TRONITY (E-Autos)', 
    price: 'Kostenlos (Basis)', 
    proPriceYear: '7,99 €/Monat (95,88 €/Jahr)',
    techno: 'Fahrzeug-API (hardwarefrei)',
    features: 'EV-optimiert',
    fahrtenbuch: true, 
    multiVehicle: true,
    exportoption: true,
    datev: false,
    support: 'E-Mail',
    highlight: false
  }
];

const comparisonFeatures = [
  { feature: 'Tankbuch / Kostenerfassung', ecodrive: true, note: 'Mit Verbrauchsanalyse & Statistiken' },
  { feature: 'Fahrtenbuch (GoBD-konform)', ecodrive: true, note: 'GPS-gestützt & manipulationssicher nach §8 EStG' },
  { feature: 'Automatische Fahrterkennung', ecodrive: true, note: 'GPS-basiert, keine Hardware nötig' },
  { feature: 'Wartungsplaner', ecodrive: true, note: 'Automatische Erinnerungen inkl. TÜV/AU' },
  { feature: 'Kostenrechner (1%-Regelung)', ecodrive: true, note: 'Vergleich: 1%-Regelung vs. Fahrtenbuch' },
  { feature: 'Multi-Fahrzeug (Pro)', ecodrive: true, note: 'Unbegrenzte Anzahl Fahrzeuge' },
  { feature: 'E-Auto Ladekosten-Tracking', ecodrive: true, note: 'kWh-Erfassung & Ladestationen' },
  { feature: 'Dark Mode', ecodrive: true, note: 'Automatisch & manuell schaltbar' },
  { feature: 'PWA (Offline)', ecodrive: true, note: 'Funktioniert ohne Internet' },
  { feature: 'CSV/Excel Export', ecodrive: true, note: 'Für Buchhaltung & Steuerberater' },
  { feature: 'DATEV-Schnittstelle', ecodrive: false, note: 'Geplant für Q2 2026' },
  { feature: 'OBD2-Hardware erforderlich', ecodrive: false, note: 'Rein App-basiert (Vorteil!)' },
  { feature: 'API-Zugriff', ecodrive: false, note: 'Geplant für Q3 2026' },
  { feature: 'Team-/Flottenmanagement', ecodrive: false, note: 'In Entwicklung für 2026' }
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='max-w-7xl mx-auto'>
    <div class='text-center mb-16 gsap-fadein'>
      <h2 class='text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4'>
        Marktvergleich
      </h2>
      <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
        Warum <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Ecodrive</span>?
      </p>
      <p class='text-xl text-meg-text-secondary max-w-3xl mx-auto'>
        Mehr Features, modernere Technologie und ein unschlagbares Preismodell.
      </p>
    </div>

    <!-- Pricing Comparison Table -->
    <div tabindex="0" class='gsap-fadein mb-24 overflow-x-auto rounded-2xl border border-meg-border-dark bg-meg-surface-dark/30 shadow-sm' style='animation-delay: 0.15s'>
      <table class='w-full min-w-max border-collapse' role='table'>
        <thead>
          <tr class='border-b border-meg-border-dark'>
            <th scope='col' class='px-6 py-4 text-left text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Anbieter</th>
            <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Technologie</th>
            <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Basis</th>
            <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Pro/Jahr</th>
            <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>DATEV</th>
            <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Support</th>
          </tr>
        </thead>
        <tbody class='divide-y divide-meg-border-dark'>
          {competitorsComparison.map((comp, index) => (
            <tr 
              class={`hover:bg-meg-accent/5 transition-colors ${comp.highlight ? 'bg-meg-accent/5' : ''}`}
            >
              <td class='px-6 py-4 text-sm font-bold text-meg-text-primary-dark whitespace-nowrap'>
                {comp.highlight && <i class='fa-solid fa-star text-emerald-400 mr-2'></i>}
                {comp.name}
              </td>
              <td class='px-6 py-4 text-center text-xs text-meg-text-secondary'>{comp.techno}</td>
              <td class='px-6 py-4 text-center text-xs text-meg-text-secondary font-bold'>{comp.price}</td>
              <td class='px-6 py-4 text-center text-xs font-black text-emerald-400 whitespace-nowrap'>{comp.proPriceYear}</td>
              <td class='px-6 py-4 text-center'>
                <i class={`fa-solid ${comp.datev ? 'fa-check text-emerald-400' : 'fa-xmark text-rose-500 opacity-40'}`}></i>
              </td>
              <td class='px-6 py-4 text-center text-xs text-meg-text-secondary'>{comp.support}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Feature Comparison -->
    <div class='gsap-fadein mb-24' style='animation-delay: 0.45s'>
      <h3 class='text-3xl font-black text-meg-text-primary-dark text-center mb-12 tracking-tight'>
        Feature-Check
      </h3>
      
      <div class='grid md:grid-cols-2 gap-6'>
        {comparisonFeatures.map((item, index) => (
          <div 
            class='bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-xl p-6 group hover:border-emerald-500/30 transition-all shadow-sm'
          >
            <div class='flex items-start gap-4'>
              <div class='shrink-0 mt-1'>
                <i class={`fa-solid ${item.ecodrive ? 'fa-check-circle text-emerald-400' : 'fa-clock text-meg-accent'} text-xl`}></i>
              </div>
              <div class='flex-1'>
                <h4 class='text-sm font-bold text-meg-text-primary-dark mb-1'>{item.feature}</h4>
                <p class='text-[10px] font-black uppercase tracking-widest text-meg-text-secondary opacity-60'>{item.note}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- USP Section -->
    <div class='gsap-fadein' style='animation-delay: 0.7s'>
      <div class='grid md:grid-cols-3 gap-8 mb-12'>
        {[
          { title: 'Keine Hardware', desc: 'Rein App-basiert. Schont die Fahrzeugbatterie, kein OBD2-Stress.' },
          { title: '10x Günstiger', desc: 'Nur 29,99 €/Jahr für die Pro-Version. Unschlagbares Preis-Leistungs-Verhältnis.' },
          { title: 'GoBD-Konform', desc: 'Exportiert Daten nach §8 EStG für das Finanzamt und DATEV.' }
        ].map(usp => (
          <div class='bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark rounded-2xl p-8 text-center group hover:border-meg-accent/30 transition-all'>
            <h4 class='text-meg-text-primary-dark font-black text-lg mb-3 tracking-tight'>{usp.title}</h4>
            <p class='text-meg-text-secondary text-sm leading-relaxed'>{usp.desc}</p>
          </div>
        ))}
      </div>

      <div class='text-center bg-meg-surface-dark/80 backdrop-blur-xl border-2 border-emerald-500/20 rounded-2xl p-10 shadow-2xl shadow-emerald-500/5'>
        <p class='text-meg-text-primary-dark font-black text-2xl mb-4 tracking-tighter'>
          💰 Steuerersparnis: Bis zu <span class='text-emerald-400'>2.800€</span> pro Jahr
        </p>
        <p class='text-meg-text-secondary text-base max-w-2xl mx-auto leading-relaxed'>
          Werden Sie jetzt zum Ecodriver und holen Sie sich Ihre Fahrtkosten vom Finanzamt zurück.
        </p>
      </div>
    </div>
  </div>
</section>
