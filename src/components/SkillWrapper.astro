---
import { getCollection } from 'astro:content';
import SkillFlipCard from './SkillFlipCard.astro';
import SkillRow from './SkillRow.astro';
const allSkills = await getCollection('skills');
const topSkills = allSkills.filter((skill) => skill.data.isTopSkill === true);
const otherSkills = allSkills.filter((skill) => skill.data.isTopSkill === false);
const layer = [
  'frontend',
  'backend',
  'design',
  'infrastructure',
  'quality',
  'general',
  'system',
  'security',
  'database',
  'ai'
];
---

<section class="bg-meg-bg-dark py-24 sm:py-32 border-t border-meg-border-dark">
  <div class="px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4 gsap-fadein">
        Stack & Expertise
      </h2>
      <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-8 gsap-fadein">
        Technologien, die <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">bewegen</span>
      </p>

      <div class="gsap-fadein flex gap-2 justify-center flex-wrap" style="animation-delay: 0.15s">
        {
          layer.map((entry) => (
            <button
              data-trigger="filter"
              data-filter={entry}
              data-filtered="false"
              class="bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-secondary rounded-xl px-4 py-2 cursor-pointer hover:bg-meg-surface-dark hover:border-meg-accent/50 hover:text-meg-text-primary-dark transition-all duration-300 first-letter:uppercase font-bold text-xs uppercase tracking-widest"
            >
              {entry}
            </button>
          ))
        }
        <button
          data-trigger="filter"
          data-filter="all"
          data-filtered="false"
          class="bg-meg-surface-dark border border-rose-500/20 text-meg-text-secondary rounded-xl px-4 py-2 cursor-pointer hover:bg-rose-500/10 hover:border-rose-500/50 hover:text-rose-400 transition-all duration-300 flex items-center gap-2 text-xs font-bold uppercase tracking-widest"
        >
          <i class="fa-solid fa-rotate-left"></i>
          Reset
        </button>
      </div>
    </div>
  </div>

  <section class="card-view">
    <div class="py-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex items-center gap-4 mb-12 gsap-fadein">
          <h3 class="text-2xl font-black text-meg-text-primary-dark tracking-tight">Core Stack</h3>
          <div class="h-px flex-1 bg-meg-border-dark"></div>
          <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-500/10 px-2 py-1 rounded-lg">Top Skills</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 gsap-fadein">
          {topSkills.map((entry) => <SkillFlipCard entry={entry} />)}
        </div>
      </div>
    </div>

    <div class="py-12 mt-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="flex items-center gap-4 mb-12 gsap-fadein">
          <h3 class="text-2xl font-black text-meg-text-primary-dark tracking-tight">Ecosystem</h3>
          <div class="h-px flex-1 bg-meg-border-dark"></div>
          <span class="text-[10px] font-black uppercase tracking-widest text-meg-text-secondary bg-meg-surface-dark px-2 py-1 rounded-lg">Full List</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 gsap-fadein">
          {otherSkills.map((entry) => <SkillFlipCard entry={entry} />)}
        </div>
      </div>
    </div>
  </section>
</section>
      <script is:inline>
        document.addEventListener('astro:page-load', () => {
          const triggers = document.querySelectorAll(
            '[data-trigger="filter"]'
          );
          const cards = document.querySelectorAll('[data-layer]');
          triggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
              let filtered = trigger.getAttribute('data-filtered') === 'true';
              const filter = trigger.getAttribute('data-filter');
              filtered = !filtered;
              if (filter === 'all') {
                filtered = false;
              }
              for (const nextTrigger of triggers) {
                nextTrigger.classList.remove('bg-meg-accent', 'text-white', 'border-meg-accent');
                nextTrigger.classList.add('bg-meg-surface-dark/50', 'text-meg-text-secondary', 'border-meg-border-dark');
                nextTrigger.setAttribute('data-filtered', 'false');
              }
              if (filtered) {
                trigger.classList.remove('bg-meg-surface-dark/50', 'text-meg-text-secondary', 'border-meg-border-dark');
                trigger.classList.add('bg-meg-accent', 'text-white', 'border-meg-accent');
                trigger.setAttribute('data-filtered', 'true');
              }
              for (const card of cards) {
                if (!filtered) {
                  card.style.display = null;
                } else {
                  if (card.getAttribute('data-layer').includes(filter)) {
                    card.style.display = null;
                  } else {
                    card.style.display = 'none';
                  }
                }
              }
            });
          });
        });
      </script>