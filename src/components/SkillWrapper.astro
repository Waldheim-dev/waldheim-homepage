---
import { getCollection } from 'astro:content';
import SkillFlipCard from './SkillFlipCard.astro';
import SkillRow from './SkillRow.astro';
const allSkills = await getCollection('skills');
const topSkills = allSkills.filter((skill) => skill.data.isTopSkill === true);
const otherSkills = allSkills.filter((skill) => skill.data.isTopSkill === false);
const layer = [
  'frontend',
  'backend',
  'design',
  'infrastructure',
  'quality',
  'general',
  'system',
  'security',
  'database'
];
---

<section class="bg-gradient-to-b from-dark-950 to-dark-900 py-24 sm:py-32">
  <div class="gsap-fadein px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center mb-10">
      <p class="gsap-fadein text-base font-semibold text-blue-400 mb-4" style="animation-delay: 0s">
        <i class="fa-solid fa-filter text-blue-400 mr-2" aria-hidden="true"></i>
        Filtere die Skills, wie du es dir wünscht
      </p>

      <div class="gsap-fadein mt-6 flex gap-2 justify-center flex-wrap" style="animation-delay: 0.15s">
        {
          layer.map((entry) => (
            <button
              data-trigger="filter"
              data-filter={entry}
              data-filtered="false"
              class="bg-dark-900/50 border border-blue-500/30 text-white rounded-lg px-4 py-2 cursor-pointer hover:bg-blue-500/10 hover:border-blue-500/50 transition-all duration-300 first-letter:uppercase font-medium"
            >
              {entry}
            </button>
          ))
        }
        <button
          data-trigger="filter"
          data-filter="all"
          data-filtered="false"
          aria-label="Filter zurücksetzen"
          class="bg-dark-900/50 border border-red-500/30 text-white rounded-lg px-4 py-2 first-letter:uppercase cursor-pointer hover:bg-red-500/10 hover:border-red-500/50 transition-all duration-300 flex items-center gap-2"
        >
          <i class="fa-solid fa-rotate-left text-red-400" aria-hidden="true"></i>
          Zurücksetzen
        </button>
      </div>
      
      <p class="gsap-fadein mt-6 text-lg text-light-300" style="animation-delay: 0.3s">
        <i class="fa-solid fa-hand-pointer text-blue-400 mr-2" aria-hidden="true"></i>
        Klicke auf die Karte, um mehr zu erfahren.
      </p>
      
      <p class="gsap-fadein mt-4 text-lg text-light-300 flex gap-2 justify-center items-center" style="animation-delay: 0.45s">
        <i class="fa-solid fa-server text-green-400 text-xl" aria-hidden="true"></i>
        = Mein empfohlender Techstack
      </p>
    </div>
  </div>
  <section class="card-view">
    <div class="py-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center px-6 lg:px-8 py-6 gsap-fadein">
        <h2 class="text-4xl font-bold tracking-tight text-white sm:text-5xl mb-4">
          Top Skills <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500">(<span class="top-counter">{topSkills.length}</span>)</span>
        </h2>
        <p class="text-xl text-light-300">
          Aktuell im Trend oder Produktiv im Einsatz.
        </p>
      </div>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="-mx-2 lg:-mx-6 grid grid-cols-2 gap-2 sm:mx-0 md:grid-cols-6 gsap-fadein">
          {topSkills.map((entry) =>
            <SkillFlipCard entry={entry} />)}
        </div>
      </div>
    </div>
    <div class="py-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center px-6 lg:px-8 py-6 gsap-fadein">
        <h2 class="text-4xl font-bold tracking-tight text-white sm:text-5xl mb-4">
          Weitere Skills <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500">(<span class="counter">{otherSkills.length}</span>)</span>
        </h2>
        <p class="text-xl text-light-300">
          Fundierte Kenntnisse und ständige Weiterentwicklung.
        </p>
      </div>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="-mx-2 lg:-mx-6 grid grid-cols-2 gap-2 sm:mx-0 md:grid-cols-6 gsap-fadein">
          {otherSkills.map((entry) =>
            <SkillFlipCard entry={entry} />)}
        </div>
      </div>
    </div>
  </section>
</section>
      <script is:inline>
        document.addEventListener('astro:page-load', () => {
          const triggers = document.querySelectorAll(
            '[data-trigger="filter"]'
          );
          const cards = document.querySelectorAll('[data-layer]');
          triggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
              let filtered = trigger.getAttribute('data-filtered') === 'true';
              const filter = trigger.getAttribute('data-filter');
              filtered = !filtered;
              if (filter === 'all') {
                filtered = false;
              }
              for (const nextTrigger of triggers) {
                nextTrigger.classList.remove('bg-blue-600', 'text-white');
                nextTrigger.classList.add('bg-dark-900/50', 'text-light-300');
                nextTrigger.setAttribute('data-filtered', 'false');
              }
              if (filtered) {
                nextTrigger.classList.remove('bg-dark-900/50', 'text-light-300');
                nextTrigger.classList.add('bg-blue-600', 'text-white');
                trigger.setAttribute('data-filtered', 'true');
              }
              for (const card of cards) {
                if (!filtered) {
                  card.style.display = null;
                } else {
                  if (card.getAttribute('data-layer').includes(filter)) {
                    card.style.display = null;
                  } else {
                    card.style.display = 'none';
                  }
                }
              }
            });
          });
        });
      </script>