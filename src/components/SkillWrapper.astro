---
import { getCollection } from 'astro:content';
import SkillFlipCard from './SkillFlipCard.astro';
import SkillRow from './SkillRow.astro';
const allSkills = await getCollection('skills');
const topSkills = allSkills.filter((skill) => skill.data.isTopSkill === true);
const otherSkills = allSkills.filter((skill) => skill.data.isTopSkill === false);
const layer = [
  'frontend',
  'backend',
  'design',
  'infrastructure',
  'quality',
  'general',
  'system',
  'security',
  'database'
];
---

<section>
  <div class="gsap-fadein">
    <div class="mx-auto max-w-2xl text-center px-6 lg:px-8 py-6">
      <p class="mt-2 text-lg leading-8  pb-2">
        Filtere die Skills, wie du es dir wünscht
      </p>

      <div class="mt-4 flex gap-1 justify-center flex-wrap">
        {
          layer.map((entry) => (
            <button
              data-trigger="filter"
              data-filter={entry}
              data-filtered="false"
              class="bg-antique-brass-300 text-pancho-200 rounded-sm px-2 py-1 first-letter:uppercase"
            >
              {entry}
            </button>
          ))
        }
        <button
          data-trigger="filter"
          data-filter="all"
          data-filtered="false"
          aria-label="Filter zurücksetzen"
          class="bg-antique-brass-300 text-pancho-200 rounded-sm px-2 py-1 first-letter:uppercase"
        >
            <span class="text-rose-500" title="Filter zurücksetzen">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-4"
              >
                <path
                  fill-rule="evenodd"
                  d="M9.53 2.47a.75.75 0 0 1 0 1.06L4.81 8.25H15a6.75 6.75 0 0 1 0 13.5h-3a.75.75 0 0 1 0-1.5h3a5.25 5.25 0 1 0 0-10.5H4.81l4.72 4.72a.75.75 0 1 1-1.06 1.06l-6-6a.75.75 0 0 1 0-1.06l6-6a.75.75 0 0 1 1.06 0Z"
                  clip-rule="evenodd"></path>
              </svg>
            </span>
        </button>
      </div>
      <p class="mt-2 text-lg leading-8 ">
        Klicke auf die Karte, um mehr zu erfahren.
      </p>
      <p
        class="mt-2 text-lg justify-center items-center leading-8  flex gap-0.5"
      >
          <span class="text-sherpa-blue-900" title="Mein empfohlender Techstack">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-6"
            >
              <path
                d="M5.507 4.048A3 3 0 0 1 7.785 3h8.43a3 3 0 0 1 2.278 1.048l1.722 2.008A4.533 4.533 0 0 0 19.5 6h-15c-.243 0-.482.02-.715.056l1.722-2.008Z"
              ></path>
              <path
                fill-rule="evenodd"
                d="M1.5 10.5a3 3 0 0 1 3-3h15a3 3 0 1 1 0 6h-15a3 3 0 0 1-3-3Zm15 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm2.25.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM4.5 15a3 3 0 1 0 0 6h15a3 3 0 1 0 0-6h-15Zm11.25 3.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM19.5 18a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
        = Mein empfohlender Techstack
      </p>
    </div>
  </div>
  <section class="card-view">
    <div class="py-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center px-6 lg:px-8 py-6 gsap-fadein">
        <h2
          class="text-3xl font-bold tracking-tight text-sherpa-blue-900  sm:text-4xl"
        >
          Top Skills (<span class="top-counter">{topSkills.length}</span>)
        </h2>
        <p class="mt-2 text-lg leading-8 ">
          Aktuell im Trend oder Produktiv im Einsatz.
        </p>
      </div>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div
          class="-mx-6 grid grid-cols-2 gap-2 sm:mx-0 md:grid-cols-6 gsap-fadein"
        >
          {topSkills.map((entry) =>
            <SkillFlipCard entry={entry} />)}
        </div>
      </div>
    </div>
    <div class="py-12 sm:py-16">
      <div class="mx-auto max-w-2xl text-center px-6 lg:px-8 py-6 gsap-fadein">
        <h2
          class="text-3xl font-bold tracking-tight text-sherpa-blue-900  sm:text-4xl"
        >
          Weitere Skills (<span class="counter">{otherSkills.length}</span>)
        </h2>
        <p class="mt-2 text-lg leading-8 ">
          Learn how to grow your business with our expert advice.
        </p>
      </div>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div
          class="-mx-6 grid grid-cols-2 gap-2 sm:mx-0 md:grid-cols-6 gsap-fadein"
        >
          {otherSkills.map((entry) =>
            <SkillFlipCard entry={entry} />)}
        </div>
      </div>
    </div>
  </section>
</section>
      <script is:inline>
        document.addEventListener('astro:page-load', () => {
          const triggers = document.querySelectorAll(
            '[data-trigger="filter"]'
          );
          const cards = document.querySelectorAll('[data-layer]');
          triggers.forEach((trigger) => {
            trigger.addEventListener('click', () => {
              let filtered = trigger.getAttribute('data-filtered') === 'true';
              const filter = trigger.getAttribute('data-filter');
              filtered = !filtered;
              if (filter === 'all') {
                filtered = false;
              }
              for (const nextTrigger of triggers) {
                nextTrigger.classList.remove('bg-sherpa-blue-900');
                nextTrigger.classList.add('bg-antique-brass-300');
                nextTrigger.setAttribute('data-filtered', 'false');
              }
              if (filtered) {
                trigger.classList.remove('bg-antique-brass-300');
                trigger.classList.add('bg-sherpa-blue-900');
                trigger.setAttribute('data-filtered', 'true');
              }
              for (const card of cards) {
                if (!filtered) {
                  card.style.display = null;
                } else {
                  if (card.getAttribute('data-layer').includes(filter)) {
                    card.style.display = null;
                  } else {
                    card.style.display = 'none';
                  }
                }
              }
            });
          });
        });
      </script>