---
interface Provider {
  name: string;
  icon: string;
  calls: string;
  link: string;
  highlight: boolean;
}

const providers: Provider[] = [
  {
    name: 'Tomorrow.io',
    icon: 'fa-solid fa-globe',
    calls: '500 Calls/Tag',
    link: 'https://www.tomorrow.io/',
    highlight: false
  },
  {
    name: 'OpenWeatherMap',
    icon: 'fa-solid fa-earth-americas',
    calls: '1.000 Calls/Tag',
    link: 'https://openweathermap.org/',
    highlight: false
  },
  {
    name: 'WeatherAPI.com',
    icon: 'fa-solid fa-globe',
    calls: '1M Calls/Monat',
    link: 'https://www.weatherapi.com/',
    highlight: false
  },
  {
    name: 'Open-Meteo',
    icon: 'fa-solid fa-sun',
    calls: 'Kostenlos, unbegrenzt',
    link: 'https://open-meteo.com/',
    highlight: true
  }
];
---

<section class="py-24 sm:py-32 px-6 bg-dark-900">
  <div class="container mx-auto max-w-6xl">
    <!-- Header -->
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-4xl md:text-5xl font-bold text-white">
        Unterstützte Wetter-Provider
      </h2>
      <p class="text-xl text-light-300 max-w-2xl mx-auto">
        Intelligentes System mit automatischem Fallback zwischen 4 verschiedenen APIs
      </p>
    </div>
    
    <!-- Providers Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {providers.map((provider) => (
        <a 
          href={provider.link}
          target="_blank"
          rel="noopener noreferrer"
          class={`relative group rounded-xl transition-all duration-300 ${
            provider.highlight 
              ? 'ring-2 ring-blue-500/50 md:col-span-2 lg:col-span-1 md:row-span-2 lg:row-span-1'
              : ''
          }`}
          aria-label={`${provider.name} - ${provider.calls}`}
        >
          <!-- Ambient Glow -->
          <div class={`absolute -inset-1 bg-gradient-to-r ${
            provider.highlight 
              ? 'from-green-500/20 to-emerald-500/20'
              : 'from-blue-500/10 to-cyan-500/10'
          } blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10 rounded-xl`}></div>
          
          <!-- Card -->
          <div class={`relative bg-dark-900/50 border ${
            provider.highlight
              ? 'border-green-500/30 hover:border-green-500/60'
              : 'border-light-500/20 hover:border-light-500/40'
          } rounded-xl p-8 
                      hover:shadow-lg transition-all duration-300 h-full
                      flex flex-col items-center justify-center text-center gap-4`}>
            
            <!-- Icon -->
            <div class={`text-5xl ${provider.highlight ? 'text-green-400' : 'text-blue-400'}`}>
              <i class={provider.icon} aria-hidden="true"></i>
            </div>
            
            <!-- Provider Name -->
            <h3 class="text-xl font-bold text-white">
              {provider.name}
            </h3>
            
            <!-- Free Badge -->
            {provider.highlight && (
              <div class="inline-flex items-center gap-2 bg-green-500/15 border border-green-500/30 rounded-full px-3 py-1 mb-2">
                <i class="fa-solid fa-star text-green-400 text-sm" aria-hidden="true"></i>
                <span class="text-green-300 text-sm font-semibold">Empfohlen</span>
              </div>
            )}
            
            <!-- Calls Info -->
            <p class={`text-sm font-medium ${provider.highlight ? 'text-green-300' : 'text-light-300'}`}>
              {provider.calls}
            </p>
            
            {provider.highlight && (
              <p class="text-xs text-light-400 pt-2 border-t border-green-500/20 mt-2">
                Kein API-Key erforderlich
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
    
    <!-- Info Box -->
    <div class="mt-12 bg-blue-500/5 border border-blue-500/20 rounded-xl p-6 text-center">
      <p class="text-light-300">
        <i class="fa-solid fa-info-circle text-blue-400 mr-2" aria-hidden="true"></i>
        <strong>Tipp:</strong> Konfiguriere mindestens 2 Provider für maximale Zuverlässigkeit. Mit Open-Meteo hast du immer einen kostenlosen Fallback!
      </p>
    </div>
  </div>
</section>
