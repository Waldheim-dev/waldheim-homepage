---
interface Provider {
  name: string;
  icon: string;
  calls: string;
  link: string;
  highlight: boolean;
}

const providers: Provider[] = [
  {
    name: 'Tomorrow.io',
    icon: 'fa-solid fa-globe',
    calls: '500 Calls/Tag',
    link: 'https://www.tomorrow.io/',
    highlight: false
  },
  {
    name: 'OpenWeatherMap',
    icon: 'fa-solid fa-earth-americas',
    calls: '1.000 Calls/Tag',
    link: 'https://openweathermap.org/',
    highlight: false
  },
  {
    name: 'WeatherAPI.com',
    icon: 'fa-solid fa-globe',
    calls: '1M Calls/Monat',
    link: 'https://www.weatherapi.com/',
    highlight: false
  },
  {
    name: 'Open-Meteo',
    icon: 'fa-solid fa-sun',
    calls: 'Kostenlos, unbegrenzt',
    link: 'https://open-meteo.com/',
    highlight: true
  }
];
---

<section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="container mx-auto max-w-7xl">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
        Data Sources
      </h2>
      <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark">
        Unterstützte <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Provider</span>
      </p>
    </div>
    
    <!-- Providers Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {providers.map((provider) => (
        <a 
          href={provider.link}
          target="_blank"
          rel="noopener noreferrer"
          class={`relative group rounded-2xl transition-all duration-300 ${
            provider.highlight 
              ? 'lg:scale-105 z-10'
              : ''
          }`}
          aria-label={`${provider.name} - ${provider.calls}`}
        >
          <div class={`absolute -inset-0.5 bg-gradient-to-br ${
            provider.highlight 
              ? 'from-emerald-500/20 to-meg-accent/20 opacity-40'
              : 'from-meg-accent/10 to-sky-400/10 opacity-0 group-hover:opacity-100'
          } blur transition duration-500 rounded-2xl`}></div>
          
          <!-- Card -->
          <div class={`relative bg-meg-surface-dark/50 backdrop-blur-xl border ${
            provider.highlight
              ? 'border-emerald-500/30'
              : 'border-meg-border-dark hover:border-meg-accent/30'
          } rounded-2xl p-10 shadow-sm transition-all h-full
                      flex flex-col items-center justify-center text-center gap-6`}>
            
            <!-- Icon -->
            <div class={`text-5xl ${provider.highlight ? 'text-emerald-400' : 'text-meg-accent'} group-hover:scale-110 transition-transform`}>
              <i class={provider.icon} aria-hidden="true"></i>
            </div>
            
            <div class="space-y-2">
              <h3 class="text-xl font-bold text-meg-text-primary-dark tracking-tight">
                {provider.name}
              </h3>
              
              {provider.highlight && (
                <div class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 rounded-lg px-2 py-0.5">
                  <span class="text-emerald-400 text-[10px] font-black uppercase tracking-widest">Recommended</span>
                </div>
              )}
            </div>
            
            <p class={`text-xs font-black uppercase tracking-widest ${provider.highlight ? 'text-emerald-400' : 'text-meg-text-secondary'}`}>
              {provider.calls}
            </p>
            
            {provider.highlight && (
              <p class="text-[10px] text-meg-text-secondary font-bold pt-4 border-t border-meg-border-dark mt-2">
                Keyless Access available
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
    
    <!-- Info Box -->
    <div class="mt-16 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark rounded-2xl p-8 text-center shadow-sm">
      <div class="flex items-center justify-center gap-3 text-meg-text-secondary">
        <i class="fa-solid fa-circle-info text-meg-accent"></i>
        <p class="text-sm font-medium leading-relaxed">
          <strong class="text-meg-text-primary-dark">Tech-Tipp:</strong> Konfigurieren Sie mindestens zwei Provider. Mit <span class="text-meg-text-primary-dark underline decoration-meg-accent/30 font-bold">Open-Meteo</span> verfügen Sie über ein unbegrenztes Fallback-System.
        </p>
      </div>
    </div>
  </div>
</section>
