---
// Aether Claim Section für Homepage
import { getProductInfo } from '../consts/productColors';

const aether = getProductInfo('aether')!;
---

<section class='py-16 px-6 bg-gradient-to-b from-dark-900 via-red-950/10 to-dark-900'>
  <div class='mx-auto max-w-7xl'>
    <div class='grid md:grid-cols-2 gap-12 items-center'>
      <!-- Text Content -->
      <div class='gsap-fadein'>
        <div class='mb-4 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/10 border border-red-500/30'>
          <i class='fa-solid fa-atom text-red-400' aria-hidden='true'></i>
          <span class='text-red-400 font-semibold'>Neu</span>
          <span
            class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${aether.colors.badgeBg} ${aether.colors.badgeBorder} ${aether.colors.badgeText}`}>
            <i class={`fa-solid fa-circle text-${aether.colors.iconColor} text-[6px]`} aria-hidden='true'></i>
            {aether.status !== 'stable' ? `${aether.status}` : `v${aether.version}`}
          </span>
        </div>

        <h2 class='text-4xl md:text-5xl font-bold text-white mb-6'>
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-500'>Aether</span> – Dateitransfer ohne Spuren
        </h2>

        <p class='text-xl text-light-300 mb-6 leading-relaxed'>
          Schneller, sicherer Dateitransfer für Developer, Kreative und Teams. Von 100 MB (kostenlos) bis 50 GB (Pro). 
          Auto-Burn löscht Dateien nach Ablauf – keine Spuren, keine Altlasten.
        </p>

        <div class='grid grid-cols-2 gap-4 mb-8'>
          <div class='flex items-start gap-3'>
            <i class='fa-solid fa-shield-check text-red-400 text-xl mt-1' aria-hidden='true'></i>
            <div>
              <h3 class='text-white font-semibold mb-1'>TLS 1.3</h3>
              <p class='text-light-400 text-sm'>Ende-zu-Ende verschlüsselt</p>
            </div>
          </div>
          <div class='flex items-start gap-3'>
            <i class='fa-solid fa-bolt text-red-400 text-xl mt-1' aria-hidden='true'></i>
            <div>
              <h3 class='text-white font-semibold mb-1'>CDN</h3>
              <p class='text-light-400 text-sm'>Weltweit beschleunigt</p>
            </div>
          </div>
          <div class='flex items-start gap-3'>
            <i class='fa-solid fa-map-location-dot text-red-400 text-xl mt-1' aria-hidden='true'></i>
            <div>
              <h3 class='text-white font-semibold mb-1'>Deutschland</h3>
              <p class='text-light-400 text-sm'>DSGVO-konform</p>
            </div>
          </div>
          <div class='flex items-start gap-3'>
            <i class='fa-solid fa-fire text-red-400 text-xl mt-1' aria-hidden='true'></i>
            <div>
              <h3 class='text-white font-semibold mb-1'>Auto-Burn</h3>
              <p class='text-light-400 text-sm'>Automatische Löschung</p>
            </div>
          </div>
        </div>

        <div class='flex flex-col sm:flex-row gap-4'>
          <a 
            href='/aether/' 
            class='gsap-btn inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-gradient-to-r from-red-500 to-rose-600 text-white font-semibold hover:shadow-lg hover:shadow-red-500/50 transition-all'
            aria-label='Mehr über Aether erfahren'
          >
            <i class='fa-solid fa-arrow-right' aria-hidden='true'></i>
            Mehr erfahren
          </a>
          <a 
            href='https://aether.waldheim.dev' 
            class='gsap-btn inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-dark-800 border border-red-500/30 text-white font-semibold hover:border-red-500/50 hover:shadow-lg hover:shadow-red-500/30 transition-all'
            aria-label='Aether kostenlos ausprobieren'
          >
            <i class='fa-solid fa-rocket' aria-hidden='true'></i>
            Kostenlos testen
          </a>
        </div>
      </div>

      <!-- Visual: Tier Cards Preview -->
      <div class='gsap-fadein grid grid-cols-3 gap-4' style='animation-delay: 0.15s'>
        <!-- Particle -->
        <div class='bg-dark-900/50 border border-red-500/20 rounded-xl p-4 hover:border-red-500/40 transition-all relative'>
          <div class='absolute top-3 right-3 w-2 h-2 bg-red-400 rounded-full animate-pulse' aria-hidden='true'></div>
          <h3 class='text-lg font-bold text-white mb-2'>Particle</h3>
          <p class='text-sm text-light-400 mb-3'>100 MB</p>
          <p class='text-2xl font-bold text-white'>€0</p>
          <p class='text-xs text-light-500'>kostenlos</p>
        </div>

        <!-- Wave -->
        <div class='bg-gradient-to-br from-red-900/20 to-rose-900/20 border-2 border-red-500/50 rounded-xl p-4 shadow-lg shadow-red-500/20 relative transform scale-105'>
          <div class='absolute -top-2 left-1/2 -translate-x-1/2 px-2 py-0.5 bg-gradient-to-r from-red-500 to-rose-600 rounded-full'>
            <span class='text-white text-[10px] font-bold'>Beliebt</span>
          </div>
          <h3 class='text-lg font-bold text-white mb-2'>Wave</h3>
          <p class='text-sm text-light-300 mb-3'>5 GB</p>
          <p class='text-2xl font-bold text-white'>€8</p>
          <p class='text-xs text-light-400'>/Monat</p>
        </div>

        <!-- Matter -->
        <div class='bg-dark-900/50 border border-red-500/20 rounded-xl p-4 hover:border-red-500/40 transition-all relative'>
          <div class='absolute top-3 right-3 w-6 h-6 border border-red-500/50 rotate-45 animate-pulse' style='animation-duration: 3s' aria-hidden='true'></div>
          <h3 class='text-lg font-bold text-white mb-2'>Matter</h3>
          <p class='text-sm text-light-400 mb-3'>50 GB</p>
          <p class='text-2xl font-bold text-white'>€24</p>
          <p class='text-xs text-light-500'>/Monat</p>
        </div>
      </div>
    </div>
  </div>
</section>
