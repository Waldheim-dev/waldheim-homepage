---
// Aether Claim Section für Homepage
import { getProductInfo } from '../consts/productColors';

const aether = getProductInfo('aether')!;
---

<section class='py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='grid lg:grid-cols-2 gap-16 items-center'>
      <!-- Text Content -->
      <div class='gsap-fadein'>
        <div class='mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark shadow-sm'>
          <i class='fa-solid fa-atom text-rose-400' aria-hidden='true'></i>
          <span class='text-meg-text-primary-dark font-bold text-sm tracking-tight'>Dateitransfer</span>
          <span
            class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-0.5 text-[10px] font-black uppercase tracking-tighter ml-2 ${aether.colors.badgeBg} ${aether.colors.badgeBorder} ${aether.colors.badgeText}`}>
            <i class={`fa-solid fa-circle text-${aether.colors.iconColor} text-[4px]`} aria-hidden='true'></i>
            {aether.status !== 'stable' ? `${aether.status}` : `v${aether.version}`}
          </span>
        </div>

        <h2 class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-red-500'>Aether</span> – Sicher teilen.
        </h2>

        <p class='text-xl text-meg-text-secondary mb-8 leading-relaxed'>
          High-Performance Data Transmission für Developer und Kreative. Schneller Transfer ohne Spuren. 
          Auto-Burn löscht Dateien nach Ablauf – keine Altlasten.
        </p>

        <div class='grid grid-cols-2 gap-6 mb-10'>
          {[
            { icon: 'fa-shield-halved', title: 'TLS 1.3', desc: 'Verschlüsselt' },
            { icon: 'fa-bolt', title: 'CDN', desc: 'Beschleunigt' },
            { icon: 'fa-map-location-dot', title: 'DE-Cloud', desc: 'DSGVO-safe' },
            { icon: 'fa-fire', title: 'Auto-Burn', desc: 'Selbstlöschend' }
          ].map(item => (
            <div class='flex items-start gap-3'>
              <div class="size-10 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center shrink-0">
                <i class={`fa-solid ${item.icon} text-rose-400`} aria-hidden='true'></i>
              </div>
              <div>
                <h3 class='text-meg-text-primary-dark font-bold text-sm'>{item.title}</h3>
                <p class='text-meg-text-secondary text-xs opacity-70'>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class='flex flex-col sm:flex-row gap-4'>
          <a 
            href='/aether/' 
            class='gsap-btn inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-rose-600 text-white font-bold hover:shadow-xl hover:shadow-rose-500/20 transition-all hover:scale-[1.02]'
          >
            <i class='fa-solid fa-arrow-right' aria-hidden='true'></i>
            Mehr erfahren
          </a>
          <a 
            href='https://aether.waldheim.dev' 
            class='gsap-btn inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold hover:bg-meg-surface-dark hover:border-rose-500/50 transition-all'
          >
            <i class='fa-solid fa-rocket' aria-hidden='true'></i>
            Kostenlos testen
          </a>
        </div>
      </div>

      <!-- Visual: Tier Cards Preview -->
      <div class='gsap-fadein grid grid-cols-3 gap-4 items-center' style='animation-delay: 0.15s'>
        <!-- Particle -->
        <div class='bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 shadow-sm hover:border-rose-500/20 transition-all relative'>
          <h3 class='text-lg font-black text-meg-text-primary-dark mb-1'>Particle</h3>
          <p class='text-[10px] uppercase font-bold text-meg-text-secondary mb-4'>100 MB</p>
          <p class='text-2xl font-black text-meg-text-primary-dark tracking-tighter'>Free</p>
        </div>

        <!-- Wave -->
        <div class='bg-meg-surface-dark backdrop-blur-xl border-2 border-rose-500/30 rounded-2xl p-6 shadow-2xl shadow-rose-500/10 relative transform scale-110 z-10'>
          <div class='absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-rose-600 rounded-full shadow-lg'>
            <span class='text-white text-[8px] font-black uppercase tracking-widest'>Beliebt</span>
          </div>
          <h3 class='text-lg font-black text-meg-text-primary-dark mb-1'>Wave</h3>
          <p class='text-[10px] uppercase font-bold text-meg-text-secondary mb-4 text-rose-400'>5 GB</p>
          <p class='text-2xl font-black text-meg-text-primary-dark tracking-tighter'>€8</p>
        </div>

        <!-- Matter -->
        <div class='bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 shadow-sm hover:border-rose-500/20 transition-all'>
          <h3 class='text-lg font-black text-meg-text-primary-dark mb-1'>Matter</h3>
          <p class='text-[10px] uppercase font-bold text-meg-text-secondary mb-4'>50 GB</p>
          <p class='text-2xl font-black text-meg-text-primary-dark tracking-tighter'>€24</p>
        </div>
      </div>
    </div>
  </div>
</section>
