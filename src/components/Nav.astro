---
import fs from 'node:fs';
import Contact from './Contact.astro';
import { PRODUCTS, SERVICE_COLORS, getProductInfo, getServiceColors } from '../consts/productColors';

const version = JSON.parse(fs.readFileSync('./package.json').toString()).version;

// Get product info (with versions)
const ecodrive = getProductInfo('ecodrive')!;
const socialverse = getProductInfo('socialverse')!;
const silvacore = getProductInfo('silvacore')!;
const ausgabeschein = getProductInfo('ausgabeschein-generator')!;
const astroAi = getProductInfo('astro-ai-llms-txt')!;

// Get service colors (individual for each service)
const devsecopsColors = getServiceColors('devsecops');
const entwicklungColors = getServiceColors('entwicklung');
const designColors = getServiceColors('design');
const itServiceColors = getServiceColors('it-service');
const smarthomeColors = getServiceColors('smarthome');
---

<nav class="sticky top-0 z-50 flex justify-between space-x-4 items-center py-4 pl-8 lg:px-8 pr-8 transition-all duration-300 ease-in-out rounded-full text-light-100 bg-dark-900/90 backdrop-blur-lg border-b border-light-500/20 shadow-lg" aria-label="Hauptnavigation">
    <div class="flex items-center gap-4">
        <a href="/" class="-m-1.5 flex items-center gap-2 text-light-100 rounded-xl px-2 py-1 hover:bg-dark-800/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 transition-all" aria-label="Zur Startseite">
          <img class="h-8 w-auto block logo" src="/waldheim.dev.png" alt="Waldheim.dev Logo" loading="lazy" width="32" height="32">
          <span class="font-semibold">Waldheim.dev</span>
        </a>
        <span
          class="inline-flex items-center gap-x-1.5 rounded-lg bg-primary-500/10 border border-primary-500/30 px-2 py-1 text-xs font-medium text-primary-400"
          aria-label={`Version ${version}`}>
        <i class="fa-solid fa-circle text-primary-400 text-[6px]" aria-hidden="true"></i>
        v{version}
      </span>
    </div>
    
    <!-- Mobile menu, show/hide based on menu open state. -->
    <div class="lg:hidden" role="dialog" aria-modal="false" style="display: none;" aria-label="Mobile Navigation">
      <!-- Background backdrop, show/hide based on slide-over state. -->
      <div
        class="nav-sidebar absolute bg-dark-900/95 backdrop-blur-lg border border-light-500/20 mt-24 left-1/2 top-0 translate-x-[-50%] rounded-3xl z-10 w-full max-w-96 mx-auto overflow-y-auto max-h-[calc(75vh)] px-6 py-6 shadow-2xl shadow-primary-500/10">
      
        <div class="flow-root">
          <div class="-my-6 divide-y divide-light-500/10">
            <div class="space-y-2 py-6">

                <div class="block">
                <button type="button"
                        class="mobile-subnav flex w-full items-center justify-between rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-dark-800/50 hover:bg-dark-800 hover:shadow-lg hover:shadow-primary-500/20 text-light-100 transition-all"
                        aria-controls="mobile-products" aria-expanded="false" aria-label="Produkte Menü öffnen">
                  Produkte
                  <i class="fa-solid fa-chevron-down text-lg transition-transform" aria-hidden="true"></i>
                </button>
                <!-- 'Product' sub-menu, show/hide based on menu state. -->
                <div class="mt-2 space-y-2 border-l-2 border-primary-500/30 ml-1 px-2" id="mobile-products" hidden>
                  <a href="/ecodrive/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 hover:shadow-md hover:shadow-${ecodrive.colors.glowColor}/20 text-light-100 transition-all`}>
                    <span>Ecodrive</span>
                    <span
                        class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${ecodrive.colors.badgeBg} ${ecodrive.colors.badgeBorder} ${ecodrive.colors.badgeText}`}>
                      <i class={`fa-solid fa-circle text-${ecodrive.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                      {ecodrive.status !== 'stable' ? `${ecodrive.status}` : `v${ecodrive.version}`}
                    </span>
                  </a>
                  <a href="/socialverse/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 hover:shadow-md hover:shadow-${socialverse.colors.glowColor}/20 text-light-100 transition-all`}>
                    <span>Socialverse</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${socialverse.colors.badgeBg} ${socialverse.colors.badgeBorder} ${socialverse.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${socialverse.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {socialverse.status !== 'stable' ? `${socialverse.status}` : `v${socialverse.version}`}
                </span>
                  </a>
                  <a href="/silvacore/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 hover:shadow-md hover:shadow-${silvacore.colors.glowColor}/20 text-light-100 transition-all`}>
                    <span>Silvacore</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${silvacore.colors.badgeBg} ${silvacore.colors.badgeBorder} ${silvacore.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${silvacore.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {silvacore.status !== 'stable' ? `${silvacore.status}` : `v${silvacore.version}`}
                </span>
                  </a>
                  <a href="/ausgabeschein-generator/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 hover:shadow-md hover:shadow-${ausgabeschein.colors.glowColor}/20 text-light-100 transition-all`}>
                    <span>Ausgabeschein Generator</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${ausgabeschein.colors.badgeBg} ${ausgabeschein.colors.badgeBorder} ${ausgabeschein.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${ausgabeschein.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {ausgabeschein.status !== 'stable' ? `${ausgabeschein.status}` : `v${ausgabeschein.version}`}
                </span>
                  </a>
                  <a href="/astro-ai-llms-txt/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 hover:shadow-md hover:shadow-${astroAi.colors.glowColor}/20 text-light-100 transition-all`}>
                    <span>Astro AI llms.txt Generator</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${astroAi.colors.badgeBg} ${astroAi.colors.badgeBorder} ${astroAi.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${astroAi.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {astroAi.status !== 'stable' ? `${astroAi.status}` : `v${astroAi.version}`}
                </span>
                  </a>
                </div>
              </div>
              <div class="block">
                <button type="button"
                        class="mobile-subnav flex w-full items-center justify-between rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-dark-800/50 hover:bg-dark-800 hover:shadow-lg hover:shadow-primary-500/20 text-light-100 transition-all"
                        aria-controls="mobile-services" aria-expanded="false" aria-label="Services Menü öffnen">
                  Services
                  <i class="fa-solid fa-chevron-down text-lg transition-transform" aria-hidden="true"></i>
                </button>
                <!-- 'Services' sub-menu, show/hide based on menu state. -->
                <div class="mt-2 space-y-2 border-l-2 border-primary-500/30 ml-1 px-2" id="mobile-services" hidden>
                  <a href="/services/devsecops/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 ${devsecopsColors.hoverShadow} text-light-100 transition-all`}>
                    <span>Effiziente Entwicklung / DevSecOps</span>
                  </a>
                  <a href="/services/entwicklung/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 ${entwicklungColors.hoverShadow} text-light-100 transition-all`}>
                    <span>Softwareentwicklung</span>
                  </a>
                  <a href="/services/design/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 ${designColors.hoverShadow} text-light-100 transition-all`}>
                    <span>Design / UX</span>
                  </a>
                  <a href="/services/it-service/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 ${itServiceColors.hoverShadow} text-light-100 transition-all`}>
                    <span>IT-Service</span>
                  </a>
                  <a href="/services/smarthome/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-dark-800/70 ${smarthomeColors.hoverShadow} text-light-100 transition-all`}>
                    <span>Smarthome</span>
                  </a>
                </div>
              </div>
              <a href="/referenzen/1/"
                 class="block rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-dark-800/50 hover:bg-dark-800 hover:shadow-lg hover:shadow-primary-500/20 text-light-100 transition-all">Referenzen</a>
              <a href="/ueber-mich/"
                 class="block rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-dark-800/50 hover:bg-dark-800 hover:shadow-lg hover:shadow-primary-500/20 text-light-100 transition-all">Über mich</a>
              <a href="/blog/1/"
                 class="block rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-dark-800/50 hover:bg-dark-800 hover:shadow-lg hover:shadow-primary-500/20 text-light-100 transition-all">Blog</a>
            </div>
            <div class="py-6">
              <a href="/kontakt"
                 class="flex justify-between gap-2 items-center rounded-xl bg-gradient-to-r from-primary-500/90 to-primary-600/90 px-3.5 py-2.5 text-sm font-semibold text-white shadow-lg hover:shadow-lg hover:shadow-primary-500/50 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                Kontakt
                <i class="fa-solid fa-comments text-lg" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="flex justify-center space-x-4 items-center">
      <div class="block lg:hidden">
        <button type="button"
                class="inline-flex cursor-pointer items-center justify-center rounded-lg p-2.5 button-toggle bg-dark-800/50 text-light-300 hover:bg-dark-800 hover:text-light-100 hover:shadow-lg hover:shadow-primary-500/20 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
                aria-label="Menü öffnen"
                aria-expanded="false">
          <i class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
        </button>
      </div>
      <div class="hidden lg:flex lg:gap-x-2">
        <div class="relative dropdown">
          <button type="button"
                  class="cursor-pointer dropdown-trigger inline-flex items-center gap-x-1 text-sm font-semibold leading-6 text-light-300 hover:bg-dark-800/70 hover:text-light-100 px-3 py-2 rounded-lg transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
                  aria-expanded="false"
                  aria-label="Produkte Menü">
            <span>Produkte</span>
            <i class="fa-solid fa-chevron-down text-sm transition-transform" aria-hidden="true"></i>
          </button>

          <div class="dropdown-menu hidden absolute left-1/2 z-30 mt-4 w-screen max-w-max -translate-x-1/2 px-4 transition ease-out duration-200 opacity-0 translate-y-1">
            <div class="w-screen max-w-md flex-auto overflow-hidden rounded-2xl bg-dark-900/95 backdrop-blur-lg border border-light-500/20 text-sm/6 shadow-2xl shadow-primary-500/10 lg:max-w-3xl">
              <div class="grid grid-cols-1 gap-x-6 gap-y-1 p-4 lg:grid-cols-2">
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${ecodrive.colors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 border ${ecodrive.colors.badgeBorder} group-hover:bg-dark-800 group-hover:shadow-lg group-hover:shadow-${ecodrive.colors.glowColor}/30 transition-all`}>
                    <i class={`fa-solid fa-chart-line text-xl text-${ecodrive.colors.iconColor}`} aria-hidden="true"></i>
                  </div>
                  <div>
                    <a href="/ecodrive/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Ecodrive
                      <span class="absolute inset-0"></span>

                      <span
                        class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${ecodrive.colors.badgeBg} ${ecodrive.colors.badgeBorder} ${ecodrive.colors.badgeText}`}>
                      <i class={`fa-solid fa-circle text-${ecodrive.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                      {ecodrive.status !== 'stable' ? `${ecodrive.status}` : `v${ecodrive.version}`}
                    </span>
                    </a>
                    <p class="mt-1 text-light-300">Ist dein Fahrverhalten Eco?</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${socialverse.colors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 border ${socialverse.colors.badgeBorder} group-hover:bg-dark-800 group-hover:shadow-lg group-hover:shadow-${socialverse.colors.glowColor}/30 transition-all`}>
                    <i class={`fa-solid fa-globe text-xl text-${socialverse.colors.iconColor}`} aria-hidden="true"></i>

                  </div>
                  <div>
                    <a href="/socialverse/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Socialverse
                      <span class="absolute inset-0"></span>

                      <span
                        class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${socialverse.colors.badgeBg} ${socialverse.colors.badgeBorder} ${socialverse.colors.badgeText}`}>
                      <i class={`fa-solid fa-circle text-${socialverse.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                      {socialverse.status !== 'stable' ? `${socialverse.status}` : `v${socialverse.version}`}
                    </span>
                    </a>
                    <p class="mt-1 text-light-300">Mikro AI CRM/CMS</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${silvacore.colors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 border ${silvacore.colors.badgeBorder} group-hover:bg-dark-800 group-hover:shadow-lg group-hover:shadow-${silvacore.colors.glowColor}/30 transition-all`}>
                    <i class={`fa-solid fa-house text-xl text-${silvacore.colors.iconColor}`} aria-hidden="true"></i>

                  </div>
                  <div>
                    <a href="/silvacore/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Silvacore
                      <span class="absolute inset-0"></span>

                      <span
                        class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${silvacore.colors.badgeBg} ${silvacore.colors.badgeBorder} ${silvacore.colors.badgeText}`}>
                      <i class={`fa-solid fa-circle text-${silvacore.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                      {silvacore.status !== 'stable' ? `${silvacore.status}` : `v${silvacore.version}`}
                    </span>
                    </a>
                    <p class="mt-1 text-light-300">Hausverwaltungssoftware</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${ausgabeschein.colors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 border ${ausgabeschein.colors.badgeBorder} group-hover:bg-dark-800 group-hover:shadow-lg group-hover:shadow-${ausgabeschein.colors.glowColor}/30 transition-all`}>
                    <i class={`fa-solid fa-clipboard-list text-xl text-${ausgabeschein.colors.iconColor}`} aria-hidden="true"></i>

                  </div>
                  <div>
                    <a href="/ausgabeschein-generator/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Ausgabeschein Generator
                      <span class="absolute inset-0"></span>

                      <span
                        class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${ausgabeschein.colors.badgeBg} ${ausgabeschein.colors.badgeBorder} ${ausgabeschein.colors.badgeText}`}>
                      <i class={`fa-solid fa-circle text-${ausgabeschein.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                      {ausgabeschein.status !== 'stable' ? `${ausgabeschein.status}` : `v${ausgabeschein.version}`}
                    </span>
                    </a>
                    <p class="mt-1 text-light-300">Netbox Plugin</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${astroAi.colors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 border ${astroAi.colors.badgeBorder} group-hover:bg-dark-800 group-hover:shadow-lg group-hover:shadow-${astroAi.colors.glowColor}/30 transition-all`}>
                    <i class={`fa-solid fa-sparkles text-xl text-${astroAi.colors.iconColor}`} aria-hidden="true"></i>


                  </div>
                <div>
                    <a href="/astro-ai-llms-txt/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Astro AI llms.txt Generator
                      <span class="absolute inset-0"></span>

                      <span
                        class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${astroAi.colors.badgeBg} ${astroAi.colors.badgeBorder} ${astroAi.colors.badgeText}`}>
                      <i class={`fa-solid fa-circle text-${astroAi.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                      {astroAi.status !== 'stable' ? `${astroAi.status}` : `v${astroAi.version}`}
                    </span>
