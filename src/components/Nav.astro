---
import fs from 'node:fs';
import Contact from './Contact.astro';
import { PRODUCTS, SERVICE_COLORS, getProductInfo, getServiceColors } from '../consts/productColors';

const version = JSON.parse(fs.readFileSync('./package.json').toString()).version;

// Get product info (with versions)
const suite = getProductInfo('suite')!;
const waetherapp = getProductInfo('waetherapp')!;
const obsidianGeminiAgent = getProductInfo('obsidian-gemini-agent')!;
const ausgabeschein = getProductInfo('ausgabeschein-generator')!;
const astroAi = getProductInfo('astro-ai-llms-txt')!;

// Get service colors (individual for each service)
const devsecopsColors = getServiceColors('devsecops');
const entwicklungColors = getServiceColors('entwicklung');
const designColors = getServiceColors('design');
const itServiceColors = getServiceColors('it-service');
const smarthomeColors = getServiceColors('smarthome');
---

<nav class="sticky top-0 z-50 flex justify-between space-x-4 items-center py-4 pl-8 lg:px-8 pr-8 transition-all duration-300 ease-in-out rounded-2xl text-meg-text-primary-dark bg-meg-surface-dark/70 backdrop-blur-xl border border-meg-border-dark shadow-sm hover:border-meg-accent/30" aria-label="Hauptnavigation">
    <div class="flex items-center gap-4">
        <a href="/" class="-m-1.5 flex items-center gap-2 text-meg-text-primary-dark rounded-xl px-2 py-1 hover:bg-meg-surface-dark/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent transition-all group" aria-label="Zur Startseite">
          <img class="h-8 w-auto block logo transition-transform group-hover:scale-105" src="/waldheim.dev.png" alt="Waldheim.dev Logo" loading="lazy" width="32" height="32">
          <span class="font-semibold tracking-tight">Waldheim.dev</span>
        </a>
        <span
          class="inline-flex items-center gap-x-1.5 rounded-lg bg-meg-accent/10 border border-meg-accent/30 px-2 py-1 text-xs font-medium text-meg-accent"
          aria-label={`Version ${version}`}>
        <i class="fa-solid fa-circle text-meg-accent text-[6px] animate-pulse" aria-hidden="true"></i>
        v{version}
      </span>
    </div>
    
    <!-- Mobile menu, show/hide based on menu open state. -->
    <div class="lg:hidden" role="dialog" aria-modal="false" style="display: none;" aria-label="Mobile Navigation">
      <!-- Background backdrop, show/hide based on slide-over state. -->
      <div
        class="nav-sidebar absolute bg-meg-surface-dark/95 backdrop-blur-xl border border-meg-border-dark mt-24 left-1/2 top-0 translate-x-[-50%] rounded-2xl z-10 w-[95%] max-w-96 mx-auto overflow-y-auto max-h-[calc(75vh)] px-6 py-6 shadow-2xl shadow-meg-accent/5">
      
        <div class="flow-root">
          <div class="-my-6 divide-y divide-meg-border-dark/50">
            <div class="space-y-2 py-6">

                <div class="block">
                <button type="button"
                        class="mobile-subnav flex w-full items-center justify-between rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-meg-surface-dark/50 hover:bg-meg-surface-dark hover:shadow-lg hover:shadow-meg-accent/10 text-meg-text-primary-dark transition-all border border-transparent hover:border-meg-border-dark"
                        aria-controls="mobile-products" aria-expanded="false" aria-label="Suite Menü öffnen">
                  Suite
                  <i class="fa-solid fa-chevron-down text-lg transition-transform" aria-hidden="true"></i>
                </button>
                <!-- 'Suite' sub-menu -->
                <div class="mt-2 space-y-2 border-l-2 border-meg-accent/30 ml-1 px-2" id="mobile-products" hidden>
                  <a href="/suite/"
                     class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-meg-accent/20 text-meg-text-primary-dark transition-all`}>
                    <span>Übersicht</span>
                    <span class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${suite.colors.badgeBg} ${suite.colors.badgeBorder} ${suite.colors.badgeText}`}>
                      <i class={`fa-solid fa-circle text-${suite.colors.iconColor} text-[6px] animate-pulse`} aria-hidden="true"></i>
                      {suite.status}
                    </span>
                  </a>
                  <a href="/suite/socialverse/"
                     class="mobile-subnav-item flex items-center gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-violet-400/20 text-meg-text-primary-dark transition-all">
                    <i class="fa-solid fa-users-gear text-violet-400 text-sm" aria-hidden="true"></i>
                    <span>Socialverse CRM</span>
                  </a>
                  <a href="/suite/forge/"
                     class="mobile-subnav-item flex items-center gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-amber-400/20 text-meg-text-primary-dark transition-all">
                    <i class="fa-solid fa-hammer text-amber-400 text-sm" aria-hidden="true"></i>
                    <span>Forge ERP</span>
                  </a>
                  <a href="/suite/aether/"
                     class="mobile-subnav-item flex items-center gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-rose-400/20 text-meg-text-primary-dark transition-all">
                    <i class="fa-solid fa-folder-open text-rose-400 text-sm" aria-hidden="true"></i>
                    <span>Aether</span>
                  </a>
                  <a href="/suite/ecodrive/"
                     class="mobile-subnav-item flex items-center gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-teal-400/20 text-meg-text-primary-dark transition-all">
                    <i class="fa-solid fa-car-side text-teal-400 text-sm" aria-hidden="true"></i>
                    <span>Ecodrive</span>
                  </a>
                  <a href="/suite/portal/"
                     class="mobile-subnav-item flex items-center gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-emerald-400/20 text-meg-text-primary-dark transition-all">
                    <i class="fa-solid fa-headset text-emerald-400 text-sm" aria-hidden="true"></i>
                    <span>Customer Portal</span>
                  </a>
                  <a href="/suite/preise/"
                     class="mobile-subnav-item flex items-center gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-meg-accent/20 text-meg-text-primary-dark transition-all">
                    <i class="fa-solid fa-tag text-meg-accent text-sm" aria-hidden="true"></i>
                    <span>Preise</span>
                  </a>
                </div>
              </div>
              <div class="block">
                <button type="button"
                        class="mobile-subnav flex w-full items-center justify-between rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-meg-surface-dark/50 hover:bg-meg-surface-dark hover:shadow-lg hover:shadow-meg-accent/10 text-meg-text-primary-dark transition-all border border-transparent hover:border-meg-border-dark"
                        aria-controls="mobile-opensource" aria-expanded="false" aria-label="Open Source Menü öffnen">
                  Open Source
                  <i class="fa-solid fa-chevron-down text-lg transition-transform" aria-hidden="true"></i>
                </button>
                <!-- 'Open Source' sub-menu -->
                <div class="mt-2 space-y-2 border-l-2 border-emerald-500/30 ml-1 px-2" id="mobile-opensource" hidden>
                  <a href="/ausgabeschein-generator/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-${ausgabeschein.colors.glowColor}/20 text-meg-text-primary-dark transition-all`}>
                    <span>Ausgabeschein Generator</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${ausgabeschein.colors.badgeBg} ${ausgabeschein.colors.badgeBorder} ${ausgabeschein.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${ausgabeschein.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {ausgabeschein.status !== 'stable' ? `${ausgabeschein.status}` : `v${ausgabeschein.version}`}
                </span>
                  </a>
                  <a href="/waetherapp/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-${waetherapp.colors.glowColor}/20 text-meg-text-primary-dark transition-all`}>
                    <span>WetterApp</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${waetherapp.colors.badgeBg} ${waetherapp.colors.badgeBorder} ${waetherapp.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${waetherapp.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {waetherapp.status !== 'stable' ? `${waetherapp.status}` : `v${waetherapp.version}`}
                </span>
                  </a>
                  <a href="/obsidian-gemini-agent/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-${obsidianGeminiAgent.colors.glowColor}/20 text-meg-text-primary-dark transition-all`}>
                    <span>Obsidian Gemini Agent</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${obsidianGeminiAgent.colors.badgeBg} ${obsidianGeminiAgent.colors.badgeBorder} ${obsidianGeminiAgent.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${obsidianGeminiAgent.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {obsidianGeminiAgent.status !== 'stable' ? `${obsidianGeminiAgent.status}` : `v${obsidianGeminiAgent.version}`}
                </span>
                  </a>
                  <a href="/astro-ai-llms-txt/"
                      class={`mobile-subnav-item flex items-center justify-between gap-2 rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 hover:shadow-md hover:shadow-${astroAi.colors.glowColor}/20 text-meg-text-primary-dark transition-all`}>
                    <span>Astro AI llms.txt Generator</span>
                    <span
                    class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ${astroAi.colors.badgeBg} ${astroAi.colors.badgeBorder} ${astroAi.colors.badgeText}`}>
                  <i class={`fa-solid fa-circle text-${astroAi.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                  {astroAi.status !== 'stable' ? `${astroAi.status}` : `v${astroAi.version}`}
                </span>
                  </a>
                </div>
              </div>
              <div class="block">
                <button type="button"
                        class="mobile-subnav flex w-full items-center justify-between rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-meg-surface-dark/50 hover:bg-meg-surface-dark hover:shadow-lg hover:shadow-meg-accent/10 text-meg-text-primary-dark transition-all border border-transparent hover:border-meg-border-dark"
                        aria-controls="mobile-services" aria-expanded="false" aria-label="Services Menü öffnen">
                  Services
                  <i class="fa-solid fa-chevron-down text-lg transition-transform" aria-hidden="true"></i>
                </button>
                <!-- 'Services' sub-menu, show/hide based on menu state. -->
                <div class="mt-2 space-y-2 border-l-2 border-meg-accent/30 ml-1 px-2" id="mobile-services" hidden>
                  <a href="/services/devsecops/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 ${devsecopsColors.hoverShadow} text-meg-text-primary-dark transition-all`}>
                    <span>Effiziente Entwicklung / DevSecOps</span>
                  </a>
                  <a href="/services/entwicklung/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 ${entwicklungColors.hoverShadow} text-meg-text-primary-dark transition-all`}>
                    <span>Softwareentwicklung</span>
                  </a>
                  <a href="/services/design/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 ${designColors.hoverShadow} text-meg-text-primary-dark transition-all`}>
                    <span>Design / UX</span>
                  </a>
                  <a href="/services/it-service/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 ${itServiceColors.hoverShadow} text-meg-text-primary-dark transition-all`}>
                    <span>IT-Service</span>
                  </a>
                  <a href="/services/smarthome/"
                     class={`mobile-subnav-item flex items-center rounded-lg px-3 py-2 text-base font-semibold leading-7 hover:bg-meg-surface-dark/70 ${smarthomeColors.hoverShadow} text-meg-text-primary-dark transition-all`}>
                    <span>Smarthome</span>
                  </a>
                </div>
              </div>
              <a href="/referenzen/1/"
                 class="block rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-meg-surface-dark/50 hover:bg-meg-surface-dark hover:shadow-lg hover:shadow-meg-accent/10 text-meg-text-primary-dark transition-all border border-transparent hover:border-meg-border-dark">Referenzen</a>
              <a href="/ueber-mich/"
                 class="block rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-meg-surface-dark/50 hover:bg-meg-surface-dark hover:shadow-lg hover:shadow-meg-accent/10 text-meg-text-primary-dark transition-all border border-transparent hover:border-meg-border-dark">Über mich</a>
              <a href="/blog/1/"
                 class="block rounded-lg px-3 py-2 text-base font-semibold leading-7 bg-meg-surface-dark/50 hover:bg-meg-surface-dark hover:shadow-lg hover:shadow-meg-accent/10 text-meg-text-primary-dark transition-all border border-transparent hover:border-meg-border-dark">Blog</a>
            </div>
            <div class="py-6">
              <a href="https://portal.waldheim.dev"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="flex justify-between gap-2 items-center rounded-xl bg-gradient-to-r from-meg-accent to-sky-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-lg hover:shadow-meg-accent/30 hover:shadow-xl transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">
                Kundenportal
                <i class="fa-solid fa-arrow-up-right-from-square text-lg" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="flex justify-center space-x-4 items-center">
      <div class="block lg:hidden">
        <button type="button"
                class="inline-flex cursor-pointer items-center justify-center rounded-lg p-2.5 button-toggle bg-meg-surface-dark/50 text-meg-text-secondary hover:bg-meg-surface-dark hover:text-meg-text-primary-dark hover:shadow-lg hover:shadow-meg-accent/10 transition-all border border-transparent hover:border-meg-border-dark"
                aria-label="Menü öffnen"
                aria-expanded="false">
          <i class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
        </button>
      </div>
      <div class="hidden lg:flex lg:gap-x-2">
        <div class="relative dropdown">
          <button type="button"
                  class="cursor-pointer dropdown-trigger inline-flex items-center gap-x-1 text-sm font-semibold leading-6 text-meg-text-secondary hover:bg-meg-surface-dark/70 hover:text-meg-text-primary-dark px-3 py-2 rounded-lg transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent"
                  aria-expanded="false"
                  aria-label="Suite Menü">
            <span>Suite</span>
            <i class="fa-solid fa-chevron-down text-sm transition-transform" aria-hidden="true"></i>
          </button>

          <div class="dropdown-menu hidden absolute left-1/2 z-30 mt-4 w-screen max-w-max -translate-x-1/2 px-4 transition ease-out duration-300 opacity-0 translate-y-2">
            <div class="w-screen max-w-md flex-auto overflow-hidden rounded-2xl bg-meg-surface-dark/95 backdrop-blur-xl border border-meg-border-dark text-sm/6 shadow-2xl shadow-meg-accent/5">
              <div class="grid grid-cols-1 gap-y-1 p-4">
                <!-- Suite main entry -->
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-meg-surface-dark/70 transition-all border border-transparent hover:border-meg-accent/20`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-meg-accent/10 border border-meg-accent/30 group-hover:bg-meg-accent/20 group-hover:shadow-lg group-hover:shadow-meg-accent/20 transition-all`}>
                    <i class="fa-solid fa-grid-2 text-xl text-meg-accent" aria-hidden="true"></i>
                  </div>
                  <div>
                    <a href="/suite/" class="font-semibold text-meg-text-primary-dark outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">
                      Waldheim Suite
                      <span class="absolute inset-0"></span>
                      <span class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${suite.colors.badgeBg} ${suite.colors.badgeBorder} ${suite.colors.badgeText}`}>
                        <i class={`fa-solid fa-circle text-${suite.colors.iconColor} text-[6px] animate-pulse`} aria-hidden="true"></i>
                        {suite.status}
                      </span>
                    </a>
                    <p class="mt-1 text-meg-text-secondary">CRM · ERP · Dokumente · Flotten · Portal – alles verbunden</p>
                  </div>
                </div>
                <!-- Module links -->
                <div class="px-4 pt-1 pb-2 grid grid-cols-2 gap-2">
                  {[
                    { icon: 'fa-users-gear', label: 'Socialverse CRM', color: 'text-violet-400', href: '/suite/socialverse/' },
                    { icon: 'fa-hammer', label: 'Forge ERP', color: 'text-amber-400', href: '/suite/forge/' },
                    { icon: 'fa-folder-open', label: 'Aether', color: 'text-rose-400', href: '/suite/aether/' },
                    { icon: 'fa-car-side', label: 'Ecodrive', color: 'text-teal-400', href: '/suite/ecodrive/' },
                    { icon: 'fa-headset', label: 'Customer Portal', color: 'text-emerald-400', href: '/suite/portal/' },
                  ].map(mod => (
                    <a href={mod.href} class="flex items-center gap-2 text-xs text-meg-text-secondary hover:text-meg-text-primary-dark transition-colors rounded-lg px-2 py-1.5 hover:bg-meg-surface-dark/70">
                      <i class={`fa-solid ${mod.icon} ${mod.color} text-xs`} aria-hidden="true"></i>
                      {mod.label}
                    </a>
                  ))}
                </div>
                <!-- Pricing link -->
                <div class="px-4 pb-3 border-t border-meg-border-dark/50 mt-1 pt-2">
                  <a href="/suite/preise/" class="flex items-center gap-2 text-xs text-meg-accent hover:text-meg-accent/80 transition-colors font-semibold rounded-lg px-2 py-1.5 hover:bg-meg-accent/5">
                    <i class="fa-solid fa-tag text-xs" aria-hidden="true"></i>
                    Preise & Übersicht
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="relative dropdown">
          <button type="button"
                  class="cursor-pointer dropdown-trigger inline-flex items-center gap-x-1 text-sm font-semibold leading-6 text-meg-text-secondary hover:bg-meg-surface-dark/70 hover:text-meg-text-primary-dark px-3 py-2 rounded-lg transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent"
                  aria-expanded="false"
                  aria-label="Open Source Menü">
            <span>Open Source</span>
            <i class="fa-solid fa-chevron-down text-sm transition-transform" aria-hidden="true"></i>
          </button>

          <div class="dropdown-menu hidden absolute left-1/2 z-30 mt-4 w-screen max-w-max -translate-x-1/2 px-4 transition ease-out duration-300 opacity-0 translate-y-2">
            <div class="w-screen max-w-md flex-auto overflow-hidden rounded-2xl bg-meg-surface-dark/95 backdrop-blur-xl border border-meg-border-dark text-sm/6 shadow-2xl shadow-meg-accent/5 lg:max-w-2xl">
              <div class="grid grid-cols-1 gap-x-6 gap-y-1 p-4 lg:grid-cols-2">
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-meg-surface-dark/70 transition-all border border-transparent hover:border-meg-border-dark`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-meg-surface-dark/70 border border-meg-border-dark group-hover:bg-meg-surface-dark group-hover:shadow-lg group-hover:shadow-emerald-400/20 transition-all`}>
                    <i class={`fa-solid fa-clipboard-list text-xl text-${ausgabeschein.colors.iconColor}`} aria-hidden="true"></i>
                  </div>
                  <div>
                    <a href="/ausgabeschein-generator/" class="font-semibold text-meg-text-primary-dark outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">
                      Ausgabeschein Generator
                      <span class="absolute inset-0"></span>
                      <span class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${ausgabeschein.colors.badgeBg} ${ausgabeschein.colors.badgeBorder} ${ausgabeschein.colors.badgeText}`}>
                        <i class={`fa-solid fa-circle text-${ausgabeschein.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                        {ausgabeschein.status !== 'stable' ? `${ausgabeschein.status}` : `v${ausgabeschein.version}`}
                      </span>
                    </a>
                    <p class="mt-1 text-meg-text-secondary">Web Tool für Vereine</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-meg-surface-dark/70 transition-all border border-transparent hover:border-meg-border-dark`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-meg-surface-dark/70 border border-meg-border-dark group-hover:bg-meg-surface-dark group-hover:shadow-lg group-hover:shadow-blue-400/20 transition-all`}>
                    <i class={`fa-solid fa-cloud-sun text-xl text-${waetherapp.colors.iconColor}`} aria-hidden="true"></i>
                  </div>
                  <div>
                    <a href="/waetherapp/" class="font-semibold text-meg-text-primary-dark outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">
                      WetterApp
                      <span class="absolute inset-0"></span>
                      <span class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-1 text-xs font-medium ml-2 ${waetherapp.colors.badgeBg} ${waetherapp.colors.badgeBorder} ${waetherapp.colors.badgeText}`}>
                        <i class={`fa-solid fa-circle text-${waetherapp.colors.iconColor} text-[6px]`} aria-hidden="true"></i>
                        {waetherapp.status !== 'stable' ? `${waetherapp.status}` : `v${waetherapp.version}`}
                      </span>
                    </a>
                    <p class="mt-1 text-meg-text-secondary">Wetter & Vorhersage</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-meg-surface-dark/70 transition-all border border-transparent hover:border-meg-border-dark`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-meg-surface-dark/70 border border-meg-border-dark group-hover:bg-meg-surface-dark group-hover:shadow-lg group-hover:shadow-indigo-400/20 transition-all`}>
                    <i class={`fa-solid fa-brain-circuit text-xl text-${obsidianGeminiAgent.colors.iconColor}`} aria-hidden="true"></i>
