          <div class="dropdown-menu hidden absolute left-1/2 z-30 mt-4 w-screen max-w-max -translate-x-1/2 px-4 transition ease-out duration-200 opacity-0 translate-y-1">
            <div class="w-screen max-w-md flex-auto overflow-hidden rounded-2xl bg-dark-900/95 backdrop-blur-lg border border-light-500/20 text-sm/6 shadow-2xl shadow-primary-500/10 lg:max-w-3xl">
              <div class="grid grid-cols-1 gap-x-6 gap-y-1 p-4 lg:grid-cols-2">
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${devsecopsColors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 ${devsecopsColors.badgeBorder} group-hover:bg-dark-800 transition-all`}>
                    <i class={`fa-solid fa-rotate text-xl text-${devsecopsColors.iconColor}`} aria-hidden="true"></i>
                  </div>
                  <div>
                    <a href="/services/devsecops/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Effiziente Entwicklung / DevSecOps
                      <span class="absolute inset-0"></span>
                    </a>
                    <p class="mt-1 text-light-300">Optimierung der Entwicklung</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${entwicklungColors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 ${entwicklungColors.badgeBorder} group-hover:bg-dark-800 transition-all`}>
                    <i class={`fa-solid fa-code text-xl text-${entwicklungColors.iconColor}`} aria-hidden="true"></i>
                  </div>
                  <div>
                    <a href="/services/entwicklung/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Softwareentwicklung
                      <span class="absolute inset-0"></span>
                    </a>
                    <p class="mt-1 text-light-300">Webseiten, Plugins & Software</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${designColors.hoverShadow} transition-all`}>
                  <div class={`mt-1 flex size-11 flex-none items-center justify-center rounded-lg bg-dark-800/70 ${designColors.badgeBorder} group-hover:bg-dark-800 transition-all`}>
                    <i class={`fa-solid fa-palette text-xl text-${designColors.iconColor}`} aria-hidden="true"></i>
                  </div>
                  <div>
                    <a href="/services/design/" class="font-semibold text-light-100 outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">
                      Design / UX
                      <span class="absolute inset-0"></span>
                    </a>
                    <p class="mt-1 text-light-300">Print & digitales Design</p>
                  </div>
                </div>
                <div class={`group relative flex gap-x-6 rounded-xl p-4 hover:bg-dark-800/70 ${itServiceColors.hoverShadow} transition-all`}>
