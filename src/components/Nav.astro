---
import fs from 'node:fs';
import { getProductInfo, getServiceColors } from '../consts/productColors';

const version = JSON.parse(fs.readFileSync('./package.json').toString()).version;

// Get info for all items
const suite = getProductInfo('suite')!;
const waetherapp = getProductInfo('waetherapp')!;
const obsidianGeminiAgent = getProductInfo('obsidian-gemini-agent')!;
const ausgabeschein = getProductInfo('ausgabeschein-generator')!;
const astroAi = getProductInfo('astro-ai-llms-txt')!;

const devsecopsColors = getServiceColors('devsecops');
const entwicklungColors = getServiceColors('entwicklung');
const itServiceColors = getServiceColors('it-service');
---

<nav class="sticky top-0 z-50 flex justify-between space-x-4 items-center py-4 pl-8 lg:px-8 pr-8 transition-all duration-300 ease-in-out rounded-2xl text-meg-text-primary-dark bg-meg-surface-dark/90 backdrop-blur-xl border border-meg-border-dark shadow-xl hover:border-meg-accent/30" aria-label="Hauptnavigation">
    <div class="flex items-center gap-4">
        <a href="/" class="-m-1.5 flex items-center gap-2 text-meg-text-primary-dark rounded-xl px-2 py-1 hover:bg-meg-surface-dark/50 transition-all group" aria-label="Waldheim.dev">
          <img class="h-8 w-auto block logo-theme-aware transition-transform group-hover:scale-105" src="/waldheim.dev.png" alt="Waldheim.dev Logo" loading="lazy" width="32" height="32">
          <span class="font-bold tracking-tight">Waldheim.dev</span>
        </a>
        <span class="inline-flex items-center gap-x-1.5 rounded-lg bg-meg-accent/10 border border-meg-accent/30 px-2 py-1 text-[10px] font-black text-meg-accent">
          <i class="fa-solid fa-circle text-[4px] animate-pulse"></i>
          v{version}
        </span>
    </div>
    
    <!-- Desktop Navigation (Full) -->
    <div class="hidden lg:flex lg:gap-x-1 items-center">
      
      <!-- Suite Dropdown -->
      <div class="relative dropdown">
        <button type="button" class="dropdown-trigger cursor-pointer inline-flex items-center gap-x-1 text-sm font-semibold leading-6 text-slate-400 hover:text-meg-text-primary-dark px-3 py-2 rounded-lg transition-all">
          <span>Suite</span>
          <i class="fa-solid fa-chevron-down text-[10px] transition-transform"></i>
        </button>
        <div class="dropdown-menu hidden absolute left-1/2 z-30 mt-4 w-screen max-w-5xl -translate-x-1/2 px-4 opacity-0 translate-y-2 transition-all duration-300">
          <div class="flex-auto overflow-hidden rounded-3xl bg-meg-surface-dark/98 backdrop-blur-xl border border-meg-border-dark shadow-2xl p-4">
            <div class="flex gap-4">

              <!-- Waldheim Suite – prominente Hero-Card links -->
              <a href="/suite/" class="group relative flex flex-col justify-between flex-shrink-0 w-56 rounded-2xl p-5 bg-gradient-to-b from-meg-accent/10 to-meg-bg-dark border border-meg-accent/20 hover:border-meg-accent/50 transition-all duration-300 overflow-hidden">
                <div class="absolute -inset-1 bg-meg-accent/5 blur-xl opacity-0 group-hover:opacity-100 transition-opacity -z-10" aria-hidden="true"></div>
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <div class="size-11 flex items-center justify-center rounded-xl bg-meg-accent/15 border border-meg-accent/30 text-meg-accent group-hover:scale-110 transition-transform">
                      <i class="fa-solid fa-table-cells-large text-xl" aria-hidden="true"></i>
                    </div>
                    <span class="text-[9px] font-black uppercase tracking-widest text-meg-accent bg-meg-accent/10 border border-meg-accent/20 px-2 py-1 rounded-full">SaaS Suite</span>
                  </div>
                  <p class="text-xl font-black text-meg-text-primary-dark tracking-tight mb-1">Waldheim Suite</p>
                  <p class="text-[11px] font-bold text-meg-accent mb-3">Business-Plattform.<br/>Alles integriert.</p>
                  <p class="text-[11px] text-slate-400 leading-relaxed">CRM, ERP, Portal, Finanzen, Properties – eine Suite, vollständig vernetzt für Ihr Unternehmen.</p>
                </div>
                <div class="mt-5 flex flex-wrap gap-1">
                  {['CRM', 'ERP', 'Portal', 'Finance'].map(tag => (
                    <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-meg-surface-dark border border-meg-border-dark text-slate-400">{tag}</span>
                  ))}
                </div>
                <div class="mt-4 flex items-center gap-1 text-[11px] font-bold text-meg-accent group-hover:gap-2 transition-all">
                  Zur Suite <i class="fa-solid fa-arrow-right text-[9px]" aria-hidden="true"></i>
                </div>
              </a>

              <!-- Module rechts: 3-Spalten-Grid mit Icon + Titel + Beschreibung -->
              <div class="flex-1 grid grid-cols-3 gap-1.5 content-start">
                {[
                  { icon: 'fa-id-card',          color: 'text-sky-400',     bg: 'bg-sky-500/10',     href: '/suite/portal/',      label: 'CustomerPortal',  desc: 'Ihr digitales Kundenportal' },
                  { icon: 'fa-users-gear',        color: 'text-violet-400',  bg: 'bg-violet-500/10',  href: '/suite/socialverse/', label: 'Socialverse CRM', desc: 'Kontakte, Sales & Kommunikation' },
                  { icon: 'fa-building-columns',  color: 'text-green-400',   bg: 'bg-green-500/10',   href: '/suite/forge/',       label: 'Silvacore ERP',   desc: 'WEG-Verwaltung & Immobilien' },
                  { icon: 'fa-atom',              color: 'text-rose-400',    bg: 'bg-rose-500/10',    href: '/suite/aether/',      label: 'Aether',          desc: 'KI-gestützte Automatisierung' },
                  { icon: 'fa-leaf',              color: 'text-emerald-400', bg: 'bg-emerald-500/10', href: '/suite/ecodrive/',    label: 'Ecodrive',        desc: 'Nachhaltige Flottensteuerung' },
                  { icon: 'fa-coins',             color: 'text-yellow-400',  bg: 'bg-yellow-500/10',  href: '/suite/treasury/',    label: 'Treasury',        desc: 'Finanzen & Buchhaltung' },
                  { icon: 'fa-building',          color: 'text-orange-400',  bg: 'bg-orange-500/10',  href: '/suite/properties/',  label: 'Properties',      desc: 'Immobilien & Objektverwaltung' },
                  { icon: 'fa-tower-broadcast',   color: 'text-cyan-400',    bg: 'bg-cyan-500/10',    href: '/suite/relay/',       label: 'Relay',           desc: 'Messaging & Benachrichtigungen' },
                  { icon: 'fa-gears',             color: 'text-indigo-400',  bg: 'bg-indigo-500/10',  href: '/suite/conductor/',   label: 'Conductor',       desc: 'Workflow-Orchestrierung' },
                ].map(mod => (
                  <a href={mod.href} class="group flex gap-x-3 rounded-xl p-3 hover:bg-meg-bg-dark transition-all border border-transparent hover:border-meg-border-dark">
                    <div class={`size-10 flex-none flex items-center justify-center rounded-lg ${mod.bg} border border-current/10 ${mod.color} group-hover:scale-110 transition-transform`}>
                      <i class={`fa-solid ${mod.icon}`} aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0">
                      <span class="block font-bold text-sm text-meg-text-primary-dark truncate">{mod.label}</span>
                      <p class="text-[10px] text-slate-400 mt-0.5 leading-tight">{mod.desc}</p>
                    </div>
                  </a>
                ))}
                <a href="/suite/preise/" class="group col-span-3 flex items-center justify-center gap-2 rounded-xl p-2 mt-1 border border-meg-border-dark/50 hover:border-meg-accent/30 hover:bg-meg-bg-dark transition-all text-[11px] font-bold text-slate-400 hover:text-meg-accent">
                  <i class="fa-solid fa-tag text-xs" aria-hidden="true"></i> Suite-Preise ansehen
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Consulting Dropdown -->
      <div class="relative dropdown">
        <button type="button" class="dropdown-trigger cursor-pointer inline-flex items-center gap-x-1 text-sm font-semibold leading-6 text-slate-400 hover:text-meg-text-primary-dark px-3 py-2 rounded-lg transition-all">
          <span>Consulting</span>
          <i class="fa-solid fa-chevron-down text-[10px] transition-transform"></i>
        </button>
        <div class="dropdown-menu hidden absolute left-1/2 z-30 mt-4 w-screen max-w-xl -translate-x-1/2 px-4 opacity-0 translate-y-2 transition-all duration-300">
          <div class="flex-auto overflow-hidden rounded-3xl bg-meg-surface-dark/98 backdrop-blur-xl border border-meg-border-dark shadow-2xl p-4">
            <div class="grid grid-cols-2 gap-2">
              {[
                { href: '/services/entwicklung/', icon: 'fa-code', color: 'text-meg-accent', bg: 'bg-meg-accent/10', hover: 'hover:border-meg-accent/20', title: 'Custom Software', desc: 'Individualsoftware & SaaS' },
                { href: '/services/devsecops/', icon: 'fa-shield-halved', color: 'text-violet-400', bg: 'bg-violet-500/10', hover: 'hover:border-violet-500/20', title: 'DevSecOps & Cloud', desc: 'Pipelines & Infrastruktur' },
                { href: '/services/it-service/', icon: 'fa-desktop', color: 'text-emerald-400', bg: 'bg-emerald-500/10', hover: 'hover:border-emerald-500/20', title: 'IT-Service & Infrastruktur', desc: 'PC, Netzwerk, NAS, M365' },
                { href: '/services/smarthome/', icon: 'fa-house', color: 'text-orange-400', bg: 'bg-orange-500/10', hover: 'hover:border-orange-500/20', title: 'Smart Home & KNX', desc: 'Gebäudeautomation & Sicherheit' }
              ].map(s => (
                <a href={s.href} class="group flex gap-x-4 rounded-2xl p-4 hover:bg-meg-bg-dark transition-all border border-transparent hover:border-meg-border-dark shadow-sm hover:shadow-md">
                  <div class={`size-10 flex-none flex items-center justify-center rounded-lg ${s.bg} ${s.color} group-hover:scale-110 transition-transform`}>
                    <i class={`fa-solid ${s.icon}`}></i>
                  </div>
                  <div>
                    <span class="block font-bold text-sm">{s.title}</span>
                    <p class="text-[10px] text-slate-400 leading-tight mt-1">{s.desc}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Open Source Dropdown -->
      <div class="relative dropdown">
        <button type="button" class="dropdown-trigger cursor-pointer inline-flex items-center gap-x-1 text-sm font-semibold leading-6 text-slate-400 hover:text-meg-text-primary-dark px-3 py-2 rounded-lg transition-all">
          <span>Open Source</span>
          <i class="fa-solid fa-chevron-down text-[10px] transition-transform"></i>
        </button>
        <div class="dropdown-menu hidden absolute left-1/2 z-30 mt-4 w-screen max-w-3xl -translate-x-1/2 px-4 opacity-0 translate-y-2 transition-all duration-300">
          <div class="flex-auto overflow-hidden rounded-3xl bg-meg-surface-dark/98 backdrop-blur-xl border border-meg-border-dark shadow-2xl p-4">
            <div class="flex gap-4">

              <!-- semrel – prominente Hero-Card links -->
              <a href="/semrel/" class="group relative flex flex-col justify-between flex-shrink-0 w-56 rounded-2xl p-5 bg-gradient-to-b from-blue-500/10 to-meg-bg-dark border border-blue-500/20 hover:border-blue-400/50 transition-all duration-300 overflow-hidden">
                <!-- Ambient glow -->
                <div class="absolute -inset-1 bg-blue-500/5 blur-xl opacity-0 group-hover:opacity-100 transition-opacity -z-10" aria-hidden="true"></div>
                <div>
                  <div class="flex items-center justify-between mb-4">
                    <div class="size-11 flex items-center justify-center rounded-xl bg-blue-500/15 border border-blue-500/30 text-blue-400 group-hover:scale-110 transition-transform">
                      <i class="fa-solid fa-code-branch text-xl" aria-hidden="true"></i>
                    </div>
                    <span class="text-[9px] font-black uppercase tracking-widest text-blue-400 bg-blue-500/10 border border-blue-500/20 px-2 py-1 rounded-full">Apache 2.0</span>
                  </div>
                  <p class="text-xl font-black text-meg-text-primary-dark tracking-tight mb-1">semrel</p>
                  <p class="text-[11px] font-bold text-blue-400 mb-3">Semantic Releases.<br/>Fully Automated.</p>
                  <p class="text-[11px] text-slate-400 leading-relaxed">Go-basiertes Release-System mit Plugin-Architektur. Conventional Commits, Monorepo-Support, 30+ Plugins.</p>
                </div>
                <div class="mt-5 flex flex-wrap gap-1">
                  {['Go', 'CI/CD', 'Plugins', 'GitHub'].map(tag => (
                    <span class="text-[9px] font-bold px-2 py-0.5 rounded-full bg-meg-surface-dark border border-meg-border-dark text-slate-400">{tag}</span>
                  ))}
                </div>
                <div class="mt-4 flex items-center gap-1 text-[11px] font-bold text-blue-400 group-hover:gap-2 transition-all">
                  Mehr erfahren <i class="fa-solid fa-arrow-right text-[9px]" aria-hidden="true"></i>
                </div>
              </a>

              <!-- Restliche Projekte rechts im Grid -->
              <div class="flex-1 grid grid-cols-2 gap-1.5 content-start">
                {[
                  { href: '/ausgabeschein-generator/', icon: 'fa-clipboard-list', color: 'text-emerald-400', title: 'Ausgabeschein', desc: 'Vereins-Tooling' },
                  { href: '/waetherapp/', icon: 'fa-cloud-sun', color: 'text-blue-400', title: 'WetterApp', desc: 'Multi-Source Daten' },
                  { href: '/amigo/', icon: 'fa-robot', color: 'text-amber-400', title: 'Amigo', desc: 'Agentic Framework' },
                  { href: '/obsidian-gemini-agent/', icon: 'fa-brain', color: 'text-indigo-400', title: 'Obsidian Agent', desc: 'AI Knowledge' },
                  { href: '/astro-ai-llms-txt/', icon: 'fa-wand-magic-sparkles', color: 'text-meg-accent', title: 'llms.txt', desc: 'Astro AI Plugin' },
                  { href: '/tailwind-cv/', icon: 'fa-file-lines', color: 'text-cyan-400', title: 'CV Generator', desc: 'CV Builder' },
                ].map(p => (
                  <a href={p.href} class="group flex gap-x-3 rounded-xl p-3 hover:bg-meg-bg-dark transition-all border border-transparent hover:border-meg-border-dark">
                    <div class={`size-9 flex-none flex items-center justify-center rounded-lg bg-meg-surface-dark border border-meg-border-dark ${p.color} group-hover:scale-110 transition-transform`}>
                      <i class={`fa-solid ${p.icon} text-sm`} aria-hidden="true"></i>
                    </div>
                    <div>
                      <span class="block font-bold text-sm">{p.title}</span>
                      <p class="text-[10px] text-slate-400 mt-0.5">{p.desc}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <a href="/referenzen/" class="text-sm font-semibold text-slate-400 hover:text-meg-text-primary-dark px-3 py-2 rounded-lg transition-all">Referenzen</a>
      <a href="/blog/" class="text-sm font-semibold text-slate-400 hover:text-meg-text-primary-dark px-3 py-2 rounded-lg transition-all">Blog</a>

      <a href="https://portal.waldheim.dev" target="_blank" class="ml-4 flex items-center gap-2 rounded-xl bg-meg-accent px-4 py-2.5 text-sm font-black text-slate-900 shadow-lg shadow-meg-accent/20 hover:scale-[1.05] transition-all">
        <span>Kundenportal</span>
        <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
      </a>

      <div class="relative dropdown ml-2">
        <button
          type="button"
          class="dropdown-trigger cursor-pointer inline-flex items-center justify-center size-10 rounded-xl border border-meg-border-dark bg-meg-surface-dark/60 text-slate-400 hover:text-meg-text-primary-dark hover:border-meg-accent/40 transition-all"
          aria-label="Anzeige-Einstellungen öffnen"
          title="Anzeige-Einstellungen"
        >
          <i class="fa-solid fa-sliders text-sm" aria-hidden="true"></i>
        </button>
        <div class="dropdown-menu hidden absolute right-0 z-30 mt-4 w-[280px] opacity-0 translate-y-2 transition-all duration-300">
          <div class="overflow-hidden rounded-2xl bg-meg-surface-dark/98 backdrop-blur-xl border border-meg-border-dark shadow-2xl p-3 space-y-3">
            <p class="text-xs font-black uppercase tracking-wide text-slate-400">Anzeige</p>
            <div class="grid grid-cols-3 gap-1.5">
              <button
                type="button"
                data-appearance-theme="system"
                class="appearance-theme-btn appearance-mode-btn rounded-lg border border-meg-border-dark bg-meg-bg-dark/50 px-2.5 py-2 text-xs font-bold text-meg-text-primary-dark"
              >
                <i class="fa-solid fa-laptop mr-1" aria-hidden="true"></i>Auto
              </button>
              <button
                type="button"
                data-appearance-theme="dark"
                class="appearance-theme-btn appearance-mode-btn rounded-lg border border-meg-border-dark bg-meg-bg-dark/50 px-2.5 py-2 text-xs font-bold text-meg-text-primary-dark"
              >
                <i class="fa-solid fa-moon mr-1" aria-hidden="true"></i>Dark
              </button>
              <button
                type="button"
                data-appearance-theme="light"
                class="appearance-theme-btn appearance-mode-btn rounded-lg border border-meg-border-dark bg-meg-surface-light/10 px-2.5 py-2 text-xs font-bold text-meg-text-primary-dark"
              >
                <i class="fa-solid fa-sun mr-1" aria-hidden="true"></i>Light
              </button>
            </div>
            <button
              type="button"
              data-appearance-toggle-contrast
              class="appearance-contrast-btn w-full flex items-center justify-between rounded-lg border border-meg-border-dark bg-meg-bg-dark/50 px-3 py-2 transition-all hover:border-meg-accent/40"
              aria-pressed="false"
            >
              <div class="text-left">
                <p class="text-xs font-bold text-meg-text-primary-dark">Kontrastmodus</p>
              </div>
              <span class="appearance-switch" aria-hidden="true">
                <span class="appearance-switch-knob"></span>
              </span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Mobile Menu Trigger -->
    <div class="lg:hidden flex items-center">
      <button type="button" class="button-toggle cursor-pointer rounded-lg p-2.5 bg-meg-surface-dark/50 text-slate-400 hover:text-meg-text-primary-dark border border-meg-border-dark transition-all">
        <i class="fa-solid fa-bars-staggered text-xl"></i>
      </button>
    </div>

    <!-- Mobile Navigation (Complete Hierarchy) -->
    <div class="lg:hidden absolute inset-0" role="dialog" id="mobile-menu" style="display: none;">
      <div class="nav-sidebar fixed inset-x-4 top-24 z-50 overflow-y-auto rounded-3xl bg-meg-surface-dark/98 backdrop-blur-2xl border border-meg-border-dark p-6 shadow-2xl max-h-[80vh]">
        <div class="space-y-4">
          
          <!-- Category: Suite -->
          <div class="accordion-item">
            <button type="button" class="mobile-accordion-trigger flex w-full items-center justify-between p-3 rounded-2xl bg-meg-bg-dark/50 border border-meg-border-dark/50 font-bold text-meg-text-primary-dark">
              <span>Waldheim Suite</span>
              <i class="fa-solid fa-chevron-down transition-transform"></i>
            </button>
            <div class="accordion-content hidden mt-2 space-y-1 pl-4 border-l-2 border-meg-accent/20">
              <a href="/suite/" class="block p-2 text-sm font-bold text-meg-accent">Übersicht</a>
              <a href="/suite/portal/" class="block p-2 text-sm text-slate-400">CustomerPortal</a>
              <a href="/suite/socialverse/" class="block p-2 text-sm text-slate-400">Socialverse CRM</a>
              <a href="/suite/forge/" class="block p-2 text-sm text-slate-400">Silvacore ERP</a>
              <a href="/suite/aether/" class="block p-2 text-sm text-slate-400">Aether</a>
              <a href="/suite/ecodrive/" class="block p-2 text-sm text-slate-400">Ecodrive</a>
              <a href="/suite/treasury/" class="block p-2 text-sm text-slate-400">Treasury</a>
              <a href="/suite/properties/" class="block p-2 text-sm text-slate-400">Properties</a>
              <a href="/suite/relay/" class="block p-2 text-sm text-slate-400">Relay</a>
              <a href="/suite/conductor/" class="block p-2 text-sm text-slate-400">Conductor</a>
              <a href="/suite/preise/" class="block p-2 text-sm font-bold text-meg-text-primary-dark">Preise</a>
            </div>
          </div>

          <!-- Category: Consulting -->
          <div class="accordion-item">
            <button type="button" class="mobile-accordion-trigger flex w-full items-center justify-between p-3 rounded-2xl bg-meg-bg-dark/50 border border-meg-border-dark/50 font-bold text-meg-text-primary-dark">
              <span>IT-Consulting</span>
              <i class="fa-solid fa-chevron-down transition-transform"></i>
            </button>
            <div class="accordion-content hidden mt-2 space-y-1 pl-4 border-l-2 border-violet-500/20">
              <a href="/services/entwicklung/" class="block p-2 text-sm text-slate-400">Custom Software</a>
              <a href="/services/devsecops/" class="block p-2 text-sm text-slate-400">DevSecOps & Cloud</a>
              <a href="/services/it-service/" class="block p-2 text-sm text-slate-400">IT-Service & Infrastruktur</a>
              <a href="/services/smarthome/" class="block p-2 text-sm text-slate-400">Smart Home & KNX</a>
            </div>
          </div>

          <!-- Category: Open Source -->
          <div class="accordion-item">
            <button type="button" class="mobile-accordion-trigger flex w-full items-center justify-between p-3 rounded-2xl bg-meg-bg-dark/50 border border-meg-border-dark/50 font-bold text-meg-text-primary-dark">
              <span>Open Source</span>
              <i class="fa-solid fa-chevron-down transition-transform"></i>
            </button>
            <div class="accordion-content hidden mt-2 space-y-1 pl-4 border-l-2 border-blue-500/30">
              <a href="/semrel/" class="flex items-center gap-2 p-2 text-sm font-bold text-blue-400">
                <i class="fa-solid fa-code-branch text-xs" aria-hidden="true"></i>
                semrel <span class="text-[9px] font-black px-1.5 py-0.5 rounded-full bg-blue-500/10 border border-blue-500/20">Featured</span>
              </a>
              <a href="/ausgabeschein-generator/" class="block p-2 text-sm text-slate-400">Ausgabeschein</a>
              <a href="/waetherapp/" class="block p-2 text-sm text-slate-400">WetterApp</a>
              <a href="/amigo/" class="block p-2 text-sm text-slate-400">Amigo Framework</a>
              <a href="/obsidian-gemini-agent/" class="block p-2 text-sm text-slate-400">Obsidian Agent</a>
              <a href="/astro-ai-llms-txt/" class="block p-2 text-sm text-slate-400">llms.txt Plugin</a>
              <a href="/tailwind-cv/" class="block p-2 text-sm text-slate-400">CV Generator</a>
            </div>
          </div>

          <hr class="border-meg-border-dark/50" />
          
          <!-- Static Links -->
          <a href="/referenzen/" class="block p-3 font-bold text-meg-text-primary-dark">Referenzen</a>
          <a href="/blog/" class="block p-3 font-bold text-meg-text-primary-dark">IT-Blog</a>
          <a href="/ueber-mich/" class="block p-3 font-bold text-meg-text-primary-dark">Über mich</a>

          <div class="rounded-2xl border border-meg-border-dark bg-meg-bg-dark/40 p-3">
            <p class="text-xs font-black uppercase tracking-wide text-slate-400 mb-3">Anzeige</p>
            <div class="grid grid-cols-3 gap-2 mb-2">
              <button
                type="button"
                data-appearance-theme="system"
                class="appearance-theme-btn appearance-mode-btn rounded-xl border border-meg-border-dark bg-meg-bg-dark/50 px-3 py-2 text-left"
              >
                <span class="block text-sm font-bold text-meg-text-primary-dark"><i class="fa-solid fa-laptop mr-1.5" aria-hidden="true"></i>Auto</span>
              </button>
              <button
                type="button"
                data-appearance-theme="dark"
                class="appearance-theme-btn appearance-mode-btn rounded-xl border border-meg-border-dark bg-meg-bg-dark/50 px-3 py-2 text-left"
              >
                <span class="block text-sm font-bold text-meg-text-primary-dark"><i class="fa-solid fa-moon mr-1.5" aria-hidden="true"></i>Dark</span>
              </button>
              <button
                type="button"
                data-appearance-theme="light"
                class="appearance-theme-btn appearance-mode-btn rounded-xl border border-meg-border-dark bg-meg-surface-light/10 px-3 py-2 text-left"
              >
                <span class="block text-sm font-bold text-meg-text-primary-dark"><i class="fa-solid fa-sun mr-1.5" aria-hidden="true"></i>Light</span>
              </button>
            </div>
            <button
              type="button"
              data-appearance-toggle-contrast
              class="appearance-contrast-btn w-full flex items-center justify-between rounded-xl border border-meg-border-dark bg-meg-bg-dark/50 px-3 py-2"
              aria-pressed="false"
            >
              <span class="text-sm font-bold text-meg-text-primary-dark">Kontrastmodus</span>
              <span class="appearance-switch" aria-hidden="true">
                <span class="appearance-switch-knob"></span>
              </span>
            </button>
          </div>

          <a href="https://portal.waldheim.dev" target="_blank" class="flex items-center justify-center gap-2 rounded-2xl bg-meg-accent py-4 font-black text-white shadow-xl shadow-meg-accent/20">
            Kundenportal <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
</nav>

<script is:inline>
    document.addEventListener('astro:page-load', () => {
      const dropdowns = document.querySelectorAll('.dropdown');
      const toggle = document.querySelector('.button-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const accordionTriggers = document.querySelectorAll('.mobile-accordion-trigger');

      // Desktop Dropdowns
      dropdowns.forEach(dd => {
        const trigger = dd.querySelector('.dropdown-trigger');
        const menu = dd.querySelector('.dropdown-menu');
        const icon = dd.querySelector('.fa-chevron-down');

        if (!trigger || !menu) return;
        menu.addEventListener('click', (e) => e.stopPropagation());

        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = !menu.classList.contains('hidden');
          
          // Close others
          document.querySelectorAll('.dropdown-menu').forEach(m => {
            m.classList.add('hidden', 'opacity-0', 'translate-y-2');
          });
          document.querySelectorAll('.dropdown .fa-chevron-down').forEach(i => i.classList.remove('rotate-180'));

          if (!isOpen) {
            menu.classList.remove('hidden');
            requestAnimationFrame(() => {
              menu.classList.remove('opacity-0', 'translate-y-2');
              menu.classList.add('opacity-100', 'translate-y-0');
              if (icon) icon.classList.add('rotate-180');
            });
          }
        });
      });

      // Mobile Menu Toggle
      if (toggle) {
        toggle.addEventListener('click', () => {
          const isHidden = mobileMenu.style.display === 'none';
          mobileMenu.style.display = isHidden ? 'block' : 'none';
        });
      }

      // Mobile Accordion Logic
      accordionTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
          const content = trigger.nextElementSibling;
          const icon = trigger.querySelector('.fa-chevron-down');
          if (!content || !icon) return;
          const isHidden = content.classList.contains('hidden');
          
          content.classList.toggle('hidden');
          icon.classList.toggle('rotate-180');
        });
      });

      const appearanceApi = window.waldheimAppearance;
      const themeButtons = document.querySelectorAll('[data-appearance-theme]');
      const contrastButtons = document.querySelectorAll('[data-appearance-toggle-contrast]');

      const renderAppearance = () => {
        if (!appearanceApi) return;
        const { theme, themeSource, contrast } = appearanceApi.getState();
        const activeTheme = themeSource || theme;

        themeButtons.forEach((btn) => {
          const isActive = btn.dataset.appearanceTheme === activeTheme;
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        contrastButtons.forEach((btn) => {
          const isActive = contrast === 'high';
          btn.classList.toggle('is-active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      };

      themeButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          appearanceApi?.setTheme(btn.dataset.appearanceTheme);
        });
      });

      contrastButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          appearanceApi?.toggleContrast();
        });
      });

      window.addEventListener('waldheim:appearance-change', renderAppearance);
      renderAppearance();

      // Global Close
      document.addEventListener('click', () => {
        document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.add('hidden', 'opacity-0', 'translate-y-2'));
        document.querySelectorAll('.dropdown .fa-chevron-down').forEach(i => i.classList.remove('rotate-180'));
      });
    });
</script>