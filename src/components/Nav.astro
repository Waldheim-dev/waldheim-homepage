                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="relative dropdown">
          <button type="button"
                  class="cursor-pointer dropdown-trigger inline-flex items-center gap-x-1 text-sm font-semibold leading-6 text-light-300 hover:bg-dark-800/70 hover:text-light-100 px-3 py-2 rounded-lg transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
                  aria-expanded="false"
                  aria-label="Services Menü">
            <span>Services</span>
            <i class="fa-solid fa-chevron-down text-sm transition-transform" aria-hidden="true"></i>
