<script is:inline>
    window.addEventListener("scroll", function () {
        const nav = document.querySelector("nav");
        
        if (window.scrollY > 0) {
            nav?.classList.add("shadow-xl", "shadow-meg-accent/5", "border-meg-accent/20");
            nav?.classList.remove("shadow-sm");
        } else {
            nav?.classList.remove("shadow-xl", "shadow-meg-accent/5", "border-meg-accent/20");
            nav?.classList.add("shadow-sm");
        }
    });
</script>

<script is:inline>
    document.addEventListener('astro:page-load', async () => {
      const toggles = document.querySelectorAll('.button-toggle');
      const dropdowns = document.querySelectorAll('.dropdown');
      const menuTriggerSubnav = document.querySelectorAll('.mobile-subnav');

      const toggleEvent = (e) => {
        const nav = document.querySelector('.nav-sidebar');
        const dialog = document.querySelector('[role="dialog"]');
        const toggle = e.currentTarget;
        const isOpen = dialog?.style.display === 'block';
        
        if (isOpen) {
          dialog.style.display = 'none';
          nav?.classList.add('top--100');
          toggle?.setAttribute('aria-expanded', 'false');
        } else {
          dialog.style.display = 'block';
          nav?.classList.remove('top--100');
          toggle?.setAttribute('aria-expanded', 'true');
        }
      };

      const toggleDropdowns = (e) => {
        e.stopPropagation();
        const dropdown = e.currentTarget;
        const menu = dropdown.querySelector('.dropdown-menu');
        const trigger = dropdown.querySelector('.dropdown-trigger');
        const icon = dropdown.querySelector('.fa-chevron-down');
        const isOpen = menu?.classList.contains('opacity-100');
        
        // Close all other dropdowns
        dropdowns.forEach(d => {
          if (d !== dropdown) {
            const m = d.querySelector('.dropdown-menu');
            const t = d.querySelector('.dropdown-trigger');
            const i = d.querySelector('.fa-chevron-down');
            m?.classList.remove('opacity-100', 'translate-y-0', 'flex');
            m?.classList.add('opacity-0', 'translate-y-1', 'hidden');
            t?.setAttribute('aria-expanded', 'false');
            i?.classList.remove('rotate-180');
          }
        });

        if (isOpen) {
          menu?.classList.remove('opacity-100', 'translate-y-0', 'flex');
          menu?.classList.add('opacity-0', 'translate-y-1', 'hidden');
          trigger?.setAttribute('aria-expanded', 'false');
          icon?.classList.remove('rotate-180');
        } else {
          menu?.classList.remove('opacity-0', 'translate-y-1', 'hidden');
          menu?.classList.add('opacity-100', 'translate-y-0', 'flex');
          trigger?.setAttribute('aria-expanded', 'true');
          icon?.classList.add('rotate-180');
        }
      };

      // Close dropdowns when clicking outside
      document.addEventListener('click', () => {
        dropdowns.forEach(d => {
          const m = d.querySelector('.dropdown-menu');
          const t = d.querySelector('.dropdown-trigger');
          const i = d.querySelector('.fa-chevron-down');
          m?.classList.remove('opacity-100', 'translate-y-0', 'flex');
          m?.classList.add('opacity-0', 'translate-y-1', 'hidden');
          t?.setAttribute('aria-expanded', 'false');
          i?.classList.remove('rotate-180');
        });
      });

      const mobileToggleDropdowns = (e) => {
        const dropdown = e.currentTarget;
        const icon = dropdown.querySelector('.fa-chevron-down');
        dropdown.classList.toggle('active');
        const isActive = dropdown.classList.contains('active');
        dropdown.setAttribute('aria-expanded', isActive.toString());
        dropdown.nextElementSibling?.toggleAttribute('hidden');
        icon?.classList.toggle('rotate-180');
      };

      toggles.forEach(toggle => toggle.addEventListener('click', toggleEvent));
      dropdowns.forEach(toggle => toggle.addEventListener('click', toggleDropdowns));
      menuTriggerSubnav.forEach(toggle => toggle.addEventListener('click', mobileToggleDropdowns));
    });
</script>