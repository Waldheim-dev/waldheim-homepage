---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='max-w-7xl mx-auto'>
    <!-- Section Header -->
    <div class='text-center mb-16 gsap-fadein'>
      <h2 class='text-sm font-bold uppercase tracking-widest text-violet-400 mb-4'>
        Marktvergleich
      </h2>
      <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
        Warum <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Socialverse</span>?
      </p>
      <p class='text-xl text-meg-text-secondary max-w-3xl mx-auto'>
        Enterprise-Features zum Startup-Tarif. Made in Germany, 100% DSGVO-konform.
      </p>
    </div>

    <!-- Competitors Comparison Cards -->
    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-24'>
      {competitorsComparison.map((competitor, index) => (
        <div 
          class={`gsap-fadein rounded-2xl p-8 border transition-all duration-300 ${
            competitor.highlight 
              ? 'bg-meg-surface-dark/80 backdrop-blur-xl border-violet-500/30 shadow-2xl shadow-violet-500/10 scale-105 z-10' 
              : 'bg-meg-surface-dark/50 backdrop-blur-md border-meg-border-dark hover:border-violet-500/30'
          }`}
          style={`animation-delay: ${index * 0.1}s`}
        >
          {competitor.highlight && (
            <div class='bg-violet-600 text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full inline-block mb-6 shadow-lg'>
              Empfehlung
            </div>
          )}
          <div class='text-5xl mb-6'>{competitor.logo}</div>
          <h3 class='text-2xl font-black text-meg-text-primary-dark mb-2 tracking-tight'>{competitor.name}</h3>
          <div class='mb-6'>
            <p class='text-lg font-bold text-violet-400'>{competitor.pricing}</p>
            <p class='text-[10px] uppercase font-black tracking-widest text-meg-text-secondary opacity-60'>{competitor.regularPrice}</p>
          </div>
          <div class='space-y-3 text-sm'>
            <div class='flex items-center gap-3 text-meg-text-secondary'>
              <i class={`fa-solid ${competitor.aiFeatures ? 'fa-check text-emerald-400' : 'fa-xmark text-rose-500'}`}></i>
              <span class='text-xs font-bold'>{typeof competitor.aiFeatures === 'string' ? competitor.aiFeatures : 'KI-Features'}</span>
            </div>
            <div class='flex items-center gap-3 text-meg-text-secondary'>
              <i class={`fa-solid ${competitor.gdpr ? 'fa-check text-emerald-400' : 'fa-xmark text-rose-500'}`}></i>
              <span class='text-xs font-bold'>DSGVO: {competitor.gdpr ? 'Vollständig' : 'Eingeschränkt'}</span>
            </div>
            <div class='flex items-center gap-3 text-meg-text-secondary'>
              <i class={`fa-solid ${competitor.germanHost ? 'fa-check text-emerald-400' : 'fa-xmark text-rose-500'}`}></i>
              <span class='text-xs font-bold'>DE-Hosting {competitor.germanHost ? '🇩🇪' : '🌍'}</span>
            </div>
            <div class='mt-6 pt-6 border-t border-meg-border-dark'>
              <p class='text-[10px] uppercase font-black tracking-widest text-meg-text-secondary mb-2'>Support</p>
              <p class='text-xs font-bold text-meg-text-primary-dark'>{competitor.support}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Detailed Feature Comparison Table -->
    <div class='gsap-fadein bg-meg-surface-dark/30 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 mb-24 shadow-sm' style='animation-delay: 0.5s'>
      <h3 class='text-2xl font-black text-meg-text-primary-dark mb-12 text-center tracking-tight'>
        Feature Matrix
      </h3>
      
      <div tabindex="0" class='overflow-x-auto'>
        <table class='w-full min-w-max text-left border-collapse'>
          <thead>
            <tr class='border-b border-meg-border-dark'>
              <th class='py-4 px-4 text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Feature</th>
              <th class='py-4 px-4 text-center bg-violet-500/10 text-[10px] font-black uppercase tracking-widest text-violet-400 rounded-t-xl'>Socialverse</th>
              {['HubSpot', 'Salesforce', 'Zoho', 'Pipedrive', 'ActiveCampaign', 'Mailchimp', 'Brevo', 'CleverReach'].map(h => (
                <th class='py-4 px-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody class='divide-y divide-meg-border-dark'>
            {comparisonFeatures.map((feature) => (
              <tr class='hover:bg-meg-accent/5 transition-colors'>
                <td class='py-4 px-4'>
                  <div class='text-sm font-bold text-meg-text-primary-dark'>{feature.name}</div>
                  <div class='text-[10px] text-meg-text-secondary mt-1 opacity-60 uppercase font-black tracking-tighter'>{feature.note}</div>
                </td>
                <td class='py-4 px-4 text-center bg-violet-500/5 font-black text-xs text-violet-400'>
                  {typeof feature.socialverse === 'string' ? feature.socialverse : (feature.socialverse ? '✓' : '✗')}
                </td>
                {[feature.hubspot, feature.salesforce, feature.zoho, feature.pipedrive, feature.activecampaign, feature.mailchimp, feature.brevo, feature.cleverreach].map(val => (
                  <td class='py-4 px-4 text-center text-xs text-meg-text-secondary'>
                    {typeof val === 'string' ? val : (val ? '✓' : '✗')}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- USP Section -->
    <div class='gsap-fadein' style='animation-delay: 0.7s'>
      <div class='grid md:grid-cols-3 gap-8 mb-12'>
        {[
          { icon: 'fa-shield-halved', color: 'emerald', title: 'Made in Germany', desc: '100% DSGVO-konform ohne US-Datentransfer.' },
          { icon: 'fa-robot', color: 'violet', title: 'GPT-4 Nativ', desc: 'Content-Generierung ohne teure Add-ons.' },
          { icon: 'fa-piggy-bank', color: 'sky', title: 'Fair Price', desc: 'Bis zu 90% Ersparnis gegenüber Enterprise CRM.' }
        ].map(usp => (
          <div class='bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 text-center group hover:border-meg-accent/30 transition-all'>
            <div class={`size-16 bg-meg-bg-dark border border-meg-border-dark rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-inner group-hover:scale-110 transition-transform`}>
              <i class={`fa-solid ${usp.icon} text-3xl text-${usp.color}-400`}></i>
            </div>
            <h4 class='text-meg-text-primary-dark font-black text-lg mb-2 tracking-tight'>{usp.title}</h4>
            <p class='text-meg-text-secondary text-sm leading-relaxed'>{usp.desc}</p>
          </div>
        ))}
      </div>

      <div class='text-center bg-meg-surface-dark/80 backdrop-blur-xl border-2 border-violet-500/20 rounded-2xl p-10 shadow-2xl shadow-violet-500/5'>
        <p class='text-meg-text-primary-dark font-black text-2xl mb-4 tracking-tighter'>
          💰 Sparpotenzial: Bis zu <span class='text-violet-400'>15.000€</span> (3 Jahre)
        </p>
        <p class='text-meg-text-secondary text-base max-w-2xl mx-auto leading-relaxed'>
          Mit Socialverse erhalten KMU Enterprise-Power zum Startup-Tarif – ohne Kompromisse bei KI oder Datenschutz.
        </p>
      </div>
    </div>
  </div>
</section>
