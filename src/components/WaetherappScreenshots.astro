---
interface Screenshot {
  src: string;
  alt: string;
  title: string;
}

const screenshots: Screenshot[] = [
  {
    src: '/waetherapp/01-main-view-tokyo.png',
    alt: 'WetterApp Hauptansicht mit aktuellen Wetterdaten für Tokyo',
    title: 'Hauptansicht'
  },
  {
    src: '/waetherapp/05-main-view-dark-mode.png',
    alt: 'WetterApp Dark Mode mit Echtzeit-Wetterdaten',
    title: 'Dark Mode'
  },
  {
    src: '/waetherapp/02-comparison-cards.png',
    alt: 'Vergleich mehrerer Standorte in der WetterApp',
    title: 'Mehrere Standorte'
  },
  {
    src: '/waetherapp/03-alerts-settings.png',
    alt: 'Wetteralarme und Einstellungen',
    title: 'Wetteralarme'
  },
  {
    src: '/waetherapp/07-comparison-table.png',
    alt: 'Detaillierte Vergleichstabelle',
    title: 'Detailvergleich'
  },
  {
    src: '/waetherapp/06-comparison-dark-mode.png',
    alt: 'Vergleichsansicht im Dark Mode',
    title: 'Vergleich Dark'
  }
];
---

<section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="container mx-auto max-w-7xl">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
        UI Showcase
      </h2>
      <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark">
        Einblicke in die <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">App</span>
      </p>
    </div>
    
    <!-- Screenshots Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {screenshots.map((screenshot) => (
        <div class="relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-br from-meg-accent/10 to-sky-400/10 blur opacity-0 group-hover:opacity-100 transition duration-500 rounded-2xl"></div>
          
          <!-- Screenshot Card -->
          <div class="relative bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl overflow-hidden shadow-sm group-hover:border-meg-accent/30 transition-all aspect-[4/3]">
            <img 
              src={screenshot.src}
              alt={screenshot.alt}
              loading="lazy"
              class="w-full h-full object-cover object-top opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-700"
              width="800"
              height="600"
            />
            
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-meg-bg-dark/80 to-transparent p-6">
              <h3 class="text-meg-text-primary-dark font-bold text-sm tracking-tight">{screenshot.title}</h3>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <!-- Info -->
    <div class="mt-16 text-center">
      <div class="inline-flex items-center gap-3 px-4 py-2 bg-meg-surface-dark/50 border border-meg-border-dark rounded-full shadow-sm">
        <i class="fa-solid fa-mobile-screen text-meg-accent text-xs"></i>
        <p class="text-meg-text-secondary text-[10px] font-black uppercase tracking-widest">
          Fully Responsive & Optimized
        </p>
      </div>
    </div>
  </div>
</section>
