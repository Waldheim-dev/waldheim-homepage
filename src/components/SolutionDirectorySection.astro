---
// This code has been fully generated by an AI.
import type { SolutionPageData } from '../consts/seoTypes';

export interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  items: SolutionPageData[];
}

const {
  eyebrow = 'Antwort zuerst · Alle Kosten, Zeiten & Lösungen transparent',
  heading = 'Konkrete Antworten auf Ihre wichtigsten Fragen',
  subheading = 'Jede Detailseite nennt sofort im ersten Absatz Einstiegspreis, Projektdauer und Lieferumfang – optimiert für schnelle Entscheidungen, Google-Suche und KI-Assistenten.',
  items,
} = Astro.props;
---

<section class="py-20 px-6 bg-meg-bg-dark border-t border-meg-border-dark/60" aria-labelledby="solution-directory-heading">
  <div class="mx-auto max-w-7xl">
    <header class="mx-auto max-w-3xl text-center mb-14 gsap-fadein">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-meg-accent mb-3">
        {eyebrow}
      </p>
      <h2 id="solution-directory-heading" class="text-3xl sm:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
        {heading}
      </h2>
      <p class="text-base sm:text-lg text-meg-text-secondary leading-relaxed">
        {subheading}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => {
        const basePath = item.section === 'suite' ? '/suite' : '/services';
        return (
          <a
            href={`${basePath}/${item.slug}/`}
            class="group rounded-2xl bg-meg-surface-dark/50 border border-meg-border-dark p-6 hover:border-meg-accent/50 hover:shadow-xl transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <span class="inline-flex items-center gap-1.5 text-xs font-black text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full">
                  <i class="fa-solid fa-tag text-[10px]" aria-hidden="true"></i>
                  {item.priceLabel}
                </span>
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-meg-text-secondary">
                  <i class="fa-solid fa-stopwatch text-meg-accent" aria-hidden="true"></i>
                  {item.durationLabel}
                </span>
              </div>

              <h3 class="text-lg font-bold text-meg-text-primary-dark group-hover:text-meg-accent transition-colors mb-2">
                {item.question}
              </h3>

              <p class="text-xs text-meg-text-secondary leading-relaxed line-clamp-3">
                {item.directAnswer}
              </p>
            </div>

            <div class="mt-5 pt-4 border-t border-meg-border-dark/60 flex items-center justify-between text-xs font-bold text-meg-accent">
              <span>{item.breadcrumbLabel}</span>
              <span class="inline-flex items-center gap-1.5 group-hover:translate-x-1 transition-transform">
                Antwort &amp; Pakete <i class="fa-solid fa-arrow-right text-[10px]" aria-hidden="true"></i>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
