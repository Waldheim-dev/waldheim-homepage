---
import { getCollection } from 'astro:content';
const features = (await getCollection('features'));
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0s'>
        Leistungsumfang
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Maximale <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Effizienz</span>
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto' style='animation-delay: 0.3s'>
        Umfassende Kontrolle über Ihre Fahrzeugkosten und CO2-Bilanz.
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8'>
      {features.map((feature, index) => (
        <div 
          class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl overflow-hidden hover:border-emerald-500/30 transition-all duration-300 group shadow-sm flex flex-col'
          style={`animation-delay: ${0.45 + index * 0.08}s`}
        >
          <div class='relative h-52 overflow-hidden bg-meg-bg-dark'>
            <img 
              class='w-full h-full object-cover object-left opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700' 
              src={feature.data.image} 
              alt={feature.data.name}
              loading='lazy'
              width='640'
              height='480'
            />
            <div class='absolute inset-0 bg-gradient-to-t from-meg-surface-dark via-transparent to-transparent'></div>
          </div>
          
          <div class='p-8 flex-1 flex flex-col'>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-3 tracking-tight'>{feature.data.name}</h3>
            <p class='text-meg-text-secondary text-sm leading-relaxed mb-6 flex-1'>{feature.data.description}</p>
            
            <div class={`flex items-start gap-3 rounded-xl p-4 border shadow-inner ${
              feature.data.planned 
                ? 'bg-meg-bg-dark/50 border-meg-border-dark text-meg-text-secondary' 
                : 'bg-emerald-500/5 border-emerald-500/20 text-meg-text-primary-dark'
            }`}>
              <i class={`fa-solid ${feature.data.planned ? 'fa-clock text-meg-accent' : 'fa-check-circle text-emerald-400'} mt-1`}></i>
              <div class='text-xs'>
                <p class='font-black uppercase tracking-widest mb-1'>{feature.data.planned ? 'Roadmap' : `v${feature.data.since.id}`}</p>
                <p class='opacity-70'>{feature.data.tier.charAt(0).toUpperCase() + feature.data.tier.slice(1)}-Plan erforderlich</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>