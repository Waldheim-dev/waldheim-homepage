---
import { getCollection } from 'astro:content';
const features = (await getCollection('features'));
let count = 0;
---


<div class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
      <h2 class="text-base/7 font-semibold text-primary-600 dark:text-emerald-600">Steigern Sie jetzt Ihre Effizienz</h2>
      <p class="mt-2 max-w-lg text-pretty text-4xl font-semibold tracking-tight text-gray-950 dark:text-white sm:text-5xl">Entdecken Sie die vielfältigen Funktionen von Ecodrive – für mehr Transparenz und Kontrolle!</p>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">

        { features.map((feature) => (
        <div class={`relative lg:col-span-${count % 5 === 0 || count % 5 === 1 ? '3' : '2'}`}>
            <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900"></div>
            <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)]">
            <img class="h-80 object-cover object-left" src={feature.data.image} alt={feature.data.name} loading="lazy">
            <div class="p-10 pt-4">
              <h3 class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">{feature.data.name}</h3>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">{feature.data.description}</p>
              {feature.data.planned ? (
              <div class="rounded-md bg-blue-50 p-4 dark:bg-blue-900/20">
  <div class="flex">
    <div class="shrink-0">
      <svg class="size-5 text-blue-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
        <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9 9a.75.75 0 0 0 0 1.5h.253a.25.25 0 0 1 .244.304l-.459 2.066A1.75 1.75 0 0 0 10.747 15H11a.75.75 0 0 0 0-1.5h-.253a.25.25 0 0 1-.244-.304l.459-2.066A1.75 1.75 0 0 0 9.253 9H9Z" clip-rule="evenodd" />
      </svg>
    </div>
    <div class="ml-3 flex-1 md:flex md:justify-between">
      <p class="text-sm text-blue-700 dark:text-blue-500">Funktion geplant für v{feature.data.since.id}.<br>Es wird ein {feature.data.tier.charAt(0).toUpperCase() + feature.data.tier.slice(1)}-Abo erfordert.</p>
    </div>
  </div>
</div>
) : (
            <div class="rounded-md bg-emerald-50 dark:bg-emerald-900/20 p-4">
  <div class="flex">
    <div class="shrink-0">
      <svg class="size-5 text-emerald-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
      </svg>
    </div>
    <div class="ml-3 flex-1 md:flex md:justify-between">
      <p class="text-sm font-medium text-emerald-800 dark:text-emerald-500">Funktion verfügbar seit v{feature.data.since.id}.<br>Es wird ein {feature.data.tier.charAt(0).toUpperCase() + feature.data.tier.slice(1)}-Abo erfordert.</p>
    </div>
  </div>
</div>
            )}
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
        <span class="hidden" aria-hidden="true">{count++}</span>
        </div>))}
      </div>
    </div>
  </div>