---
import { getCollection } from 'astro:content';
const features = (await getCollection('features'));
---

<section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-base font-semibold text-green-400 mb-4' style='animation-delay: 0s'>
        <i class='fa-solid fa-star text-green-400 mr-2' aria-hidden='true'></i>
        Steigern Sie jetzt Ihre Effizienz
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
        Entdecken Sie die vielfältigen <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>Funktionen</span> von Ecodrive
      </p>
      <p class='gsap-fadein text-xl text-light-300' style='animation-delay: 0.3s'>
        Für mehr Transparenz und Kontrolle über Ihre Fahrzeugkosten
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-6'>
      {features.map((feature, index) => (
        <div 
          class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl overflow-hidden hover:border-green-500/40 transition-all duration-300 group'
          style={`animation-delay: ${0.45 + index * 0.08}s`}
        >
          <div class='relative h-56 overflow-hidden'>
            <img 
              class='w-full h-full object-cover object-left group-hover:scale-105 transition-transform duration-500' 
              src={feature.data.image} 
              alt={feature.data.name}
              loading='lazy'
              width='640'
              height='480'
            />
            <div class='absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/50 to-transparent'></div>
          </div>
          
          <div class='p-6'>
            <h3 class='text-xl font-bold text-white mb-3'>{feature.data.name}</h3>
            <p class='text-light-300 mb-4 text-sm'>{feature.data.description}</p>
            
            {feature.data.planned ? (
              <div class='flex items-start gap-3 bg-blue-500/10 border border-blue-500/30 rounded-lg p-3'>
                <i class='fa-solid fa-info-circle text-blue-400 mt-0.5' aria-label='Information' role='img'></i>
                <div class='text-sm text-light-300'>
                  <p class='font-semibold text-blue-400'>Geplant für v{feature.data.since.id}</p>
                  <p>Erfordert {feature.data.tier.charAt(0).toUpperCase() + feature.data.tier.slice(1)}-Abo</p>
                </div>
              </div>
            ) : (
              <div class='flex items-start gap-3 bg-green-500/10 border border-green-500/30 rounded-lg p-3'>
                <i class='fa-solid fa-check-circle text-green-400 mt-0.5' aria-label='Verfügbar' role='img'></i>
                <div class='text-sm text-light-300'>
                  <p class='font-semibold text-green-400'>Verfügbar seit v{feature.data.since.id}</p>
                  <p>Erfordert {feature.data.tier.charAt(0).toUpperCase() + feature.data.tier.slice(1)}-Abo</p>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>