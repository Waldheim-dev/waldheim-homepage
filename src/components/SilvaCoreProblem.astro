---
// Problem-Section
const problems = [
  {
    icon: 'fa-table',
    title: 'Excel-Chaos',
    description: 'Nebenkostenabrechnungen mit unzähligen Tabellen, fehleranfällig und zeitaufwendig'
  },
  {
    icon: 'fa-scale-balanced',
    title: 'Rechtsunsicherheit',
    description: 'WEG-Gesetz § 28 Vermögensberichte? HKVO § 6a monatliche Verbrauchsberichte?'
  },
  {
    icon: 'fa-eye-slash',
    title: 'Intransparenz',
    description: 'Eigentümer fordern Einblick, Sie verlieren den Überblick'
  },
  {
    icon: 'fa-sack-dollar',
    title: 'Teure Softwarelösungen',
    description: '50+ € pro WEG/Monat bei etablierten Anbietern'
  }
];

const solutions = [
  {
    icon: 'fa-chart-line',
    title: 'Professionell',
    items: ['Alle Funktionen inklusive', 'Automatisierte Abrechnungen', 'Echtzeit-Übersichten']
  },
  {
    icon: 'fa-hand-holding-dollar',
    title: 'Fair & Transparent',
    items: ['1. WEG kostenlos', 'Ab 5 € pro WEG/Monat', 'Keine versteckten Kosten']
  },
  {
    icon: 'fa-shield-halved',
    title: 'Sicher & Compliant',
    items: ['DSGVO-konform (EU-Server)', 'WEG-Gesetz & HKVO-ready', 'Rollenbasierte Zugriffe']
  }
];
---

<!-- Problem & Solution Section -->
<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <!-- Problem Section -->
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-orange-400 mb-4' style='animation-delay: 0s'>
        <i class='fa-solid fa-triangle-exclamation mr-2' aria-hidden='true'></i>
        Problemstellung
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        WEG-Verwaltung ist <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500'>komplex</span>
      </p>
    </div>
    
    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-32'>
      {problems.map((problem, index) => (
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 hover:border-orange-500/30 transition-all duration-300 shadow-sm' style={`animation-delay: ${0.3 + index * 0.1}s`}>
          <div class='size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-4 shadow-inner'>
            <i class={`fa-solid ${problem.icon} text-orange-400 text-xl`}></i>
          </div>
          <h3 class='text-lg font-bold text-meg-text-primary-dark mb-2'>{problem.title}</h3>
          <p class='text-meg-text-secondary text-sm leading-relaxed'>{problem.description}</p>
        </div>
      ))}
    </div>

    <!-- Solution Section -->
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0.7s'>
        <i class='fa-solid fa-lightbulb mr-2' aria-hidden='true'></i>
        Der Silvacore-Ansatz
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.85s'>
        Alles an einem Ort. Zum <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>fairen Preis</span>.
      </p>
    </div>

    <div class='grid md:grid-cols-3 gap-8'>
      {solutions.map((solution, index) => (
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 transition-all duration-300 shadow-sm group' style={`animation-delay: ${1.15 + index * 0.15}s`}>
          <div class='flex items-center gap-4 mb-6'>
            <div class='size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform shadow-inner'>
              <i class={`fa-solid ${solution.icon} text-emerald-400 text-xl`}></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark'>{solution.title}</h3>
          </div>
          <ul class='space-y-3'>
            {solution.items.map((item) => (
              <li class='flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed'>
                <i class='fa-solid fa-check text-emerald-400 mt-1' aria-label='Enthalten' role='img'></i>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
