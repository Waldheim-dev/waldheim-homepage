---
import { getProductInfo } from '../consts/productColors';

const suite = getProductInfo('suite')!;

const modules = [
  {
    icon: 'fa-leaf',
    name: 'Ecodrive',
    desc: 'Mobilitäts- & Flottenmanagement',
    color: 'text-emerald-400',
    bg: 'bg-emerald-500/10',
    border: 'border-emerald-500/20',
  },
  {
    icon: 'fa-network-wired',
    name: 'Socialverse CRM',
    desc: 'Kundenkontakte & Pipelines',
    color: 'text-purple-400',
    bg: 'bg-purple-500/10',
    border: 'border-purple-500/20',
  },
  {
    icon: 'fa-building-columns',
    name: 'Silvacore',
    desc: 'ERP & Ressourcenplanung',
    color: 'text-green-400',
    bg: 'bg-green-500/10',
    border: 'border-green-500/20',
  },
  {
    icon: 'fa-atom',
    name: 'Aether',
    desc: 'Cloud-Speicher & Dateitransfer',
    color: 'text-rose-400',
    bg: 'bg-rose-500/10',
    border: 'border-rose-500/20',
  },
];
---

<section class='py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>

    <!-- Header -->
    <div class='text-center max-w-3xl mx-auto mb-20 gsap-fadein'>
      <div class='mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark shadow-sm'>
        <i class='fa-solid fa-table-cells-large text-meg-accent' aria-hidden='true'></i>
        <span class='text-meg-text-primary-dark font-bold text-sm tracking-tight'>Waldheim Suite</span>
        <span
          class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-0.5 text-[10px] font-black uppercase tracking-tighter ml-2 ${suite.colors.badgeBg} ${suite.colors.badgeBorder} ${suite.colors.badgeText}`}
          aria-label={`Status: ${suite.status}`}>
          <i class={`fa-solid fa-circle text-${suite.colors.iconColor} text-[4px] animate-pulse`} aria-hidden='true'></i>
          {suite.status}
        </span>
      </div>

      <h2 class='text-4xl md:text-5xl lg:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
        Eine Suite.<br />
        <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Alles verbunden.</span>
      </h2>

      <p class='text-xl text-meg-text-secondary leading-relaxed'>
        Die Waldheim Suite vereint alle Business-Module unter einem Dach – mit Single Sign-On, 
        zentralem Kundenportal und einem nahtlosen Enterprise-Erlebnis.
      </p>
    </div>

    <!-- Module Grid -->
    <div class='grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16'>
      {modules.map((mod, i) => (
        <div
          class={`gsap-fadein group relative bg-meg-surface-dark/50 backdrop-blur-xl border ${mod.border} rounded-2xl p-6 shadow-sm hover:scale-[1.02] transition-all duration-300`}
          style={`animation-delay: ${i * 0.08}s`}
        >
          <div class={`size-12 ${mod.bg} border ${mod.border} rounded-xl flex items-center justify-center mb-5`}>
            <i class={`fa-solid ${mod.icon} ${mod.color} text-xl`} aria-hidden='true'></i>
          </div>
          <h3 class='text-meg-text-primary-dark font-black text-base mb-1'>{mod.name}</h3>
          <p class='text-meg-text-secondary text-sm'>{mod.desc}</p>
        </div>
      ))}
    </div>

    <!-- CTA Banner -->
    <div class='gsap-fadein relative group'>
      <div class='absolute -inset-0.5 bg-gradient-to-r from-meg-accent/20 to-sky-500/20 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-700' aria-hidden='true'></div>
      <div class='relative isolate overflow-hidden bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl px-8 py-12 lg:px-16 lg:py-14 flex flex-col lg:flex-row gap-8 items-center justify-between'>
        <div class='max-w-xl text-center lg:text-left'>
          <p class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-3'>
            <i class='fa-solid fa-rocket mr-2' aria-hidden='true'></i>
            In Entwicklung
          </p>
          <h3 class='text-3xl font-black text-meg-text-primary-dark tracking-tighter mb-3'>
            Bereit für die nächste Generation?
          </h3>
          <p class='text-meg-text-secondary leading-relaxed'>
            Die Suite wird derzeit aktiv entwickelt. Jetzt vormerken und als einer der ersten Zugang erhalten.
          </p>
        </div>
        <div class='flex flex-col sm:flex-row gap-4 shrink-0'>
          <a
            href='https://portal.waldheim.dev'
            target='_blank'
            rel='noopener noreferrer'
            class='inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-gradient-to-r from-meg-accent to-sky-600 text-white font-bold shadow-xl shadow-meg-accent/20 hover:scale-[1.02] hover:shadow-meg-accent/30 transition-all'
          >
            <i class='fa-solid fa-arrow-up-right-from-square' aria-hidden='true'></i>
            Zum Kundenportal
          </a>
          <a
            href='/kontakt/'
            class='inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold hover:border-meg-accent/40 transition-all'
          >
            <i class='fa-solid fa-envelope' aria-hidden='true'></i>
            Frühen Zugang anfragen
          </a>
        </div>
      </div>
    </div>

  </div>
</section>
