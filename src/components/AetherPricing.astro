---
// Aether Product Tiers: Particle, Wave, Matter
---

<section id='pricing' class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4'>
        Preisgestaltung
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Von flüchtig bis <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-red-500'>manifestiert</span>
      </p>
    </div>

    <div class='grid md:grid-cols-3 gap-8'>
      <!-- Particle (Free) -->
      <div class='gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/30 transition-all group shadow-sm' style='animation-delay: 0.45s'>
        <div class='absolute top-6 right-6 size-3 bg-rose-400 rounded-full animate-pulse' aria-hidden='true'></div>
        
        <div class='mb-8'>
          <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>Particle</h3>
          <p class='text-meg-text-secondary text-sm mb-6'>Für den Moment.</p>
          <div class='flex items-baseline gap-2'>
            <span class='text-4xl font-black text-meg-text-primary-dark tracking-tighter'>Free</span>
          </div>
          <p class='text-[10px] uppercase font-black tracking-widest text-rose-400 mt-2'>Keine Anmeldung</p>
        </div>

        <ul class='space-y-4 mb-10' role='list'>
          {[
            { icon: 'fa-sparkles', text: 'Bis zu 100 MB pro Upload' },
            { icon: 'fa-clock', text: '24 Stunden Auto-Burn' },
            { icon: 'fa-link', text: '1 Einweg-Link' },
            { icon: 'fa-shield-halved', text: 'TLS Verschlüsselung' }
          ].map(item => (
            <li class='flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed'>
              <i class={`fa-solid ${item.icon} text-rose-400 mt-1`} aria-hidden='true'></i>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>

        <a 
          href='https://aether.waldheim.dev' 
          class='block w-full text-center px-6 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold hover:border-rose-500/50 transition-all'
        >
          Kostenlos starten
        </a>
      </div>

      <!-- Wave (Standard) -->
      <div class='gsap-fadein relative bg-meg-surface-dark backdrop-blur-xl border-2 border-rose-500/30 rounded-2xl p-8 shadow-2xl shadow-rose-500/10 z-10 transform scale-105 group' style='animation-delay: 0.6s'>
        <div class='absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 bg-rose-600 rounded-full shadow-lg'>
          <span class='text-white text-[8px] font-black uppercase tracking-widest'>Beliebt</span>
        </div>

        <div class='mb-8 relative z-10'>
          <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>Wave</h3>
          <p class='text-meg-text-secondary text-sm mb-6'>Fließend & anpassbar.</p>
          <div class='flex items-baseline gap-2'>
            <span class='text-5xl font-black text-meg-text-primary-dark tracking-tighter'>€8</span>
            <span class='text-meg-text-secondary font-bold'>/mo</span>
          </div>
          <p class='text-[10px] uppercase font-black tracking-widest text-rose-400 mt-2'>Monatlich kündbar</p>
        </div>

        <ul class='space-y-4 mb-10 relative z-10' role='list'>
          {[
            { icon: 'fa-database', text: 'Bis zu 5 GB pro Datei' },
            { icon: 'fa-calendar-days', text: '30 Tage Speicherzeit' },
            { icon: 'fa-shuffle', text: '10 Links pro Datei' },
            { icon: 'fa-lock', text: 'Passwortschutz' },
            { icon: 'fa-chart-line', text: 'Link-Management' }
          ].map(item => (
            <li class='flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed'>
              <i class={`fa-solid ${item.icon} text-rose-400 mt-1`} aria-hidden='true'></i>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>

        <a 
          href='https://portal.waldheim.dev' 
          target='_blank'
          rel='noopener noreferrer'
          class='block w-full text-center px-6 py-3 rounded-xl bg-meg-accent text-white font-bold shadow-xl shadow-meg-accent/20 hover:scale-[1.02] transition-all'
        >
          Wave wählen
        </a>
      </div>

      <!-- Matter (Pro) -->
      <div class='gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/30 transition-all group shadow-sm' style='animation-delay: 0.75s'>
        <div class='mb-8'>
          <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>Matter</h3>
          <p class='text-meg-text-secondary text-sm mb-6'>Daten werden Realität.</p>
          <div class='flex items-baseline gap-2'>
            <span class='text-4xl font-black text-meg-text-primary-dark tracking-tighter'>€24</span>
            <span class='text-meg-text-secondary font-bold'>/mo</span>
          </div>
          <p class='text-[10px] uppercase font-black tracking-widest text-rose-400 mt-2'>Für Power-User</p>
        </div>

        <ul class='space-y-4 mb-10' role='list'>
          {[
            { icon: 'fa-building', text: 'Bis zu 50 GB pro Datei' },
            { icon: 'fa-shield-check', text: '1 Jahr Retention' },
            { icon: 'fa-diagram-project', text: '50 Links pro Datei' },
            { icon: 'fa-fingerprint', text: 'Integritätsschutz' },
            { icon: 'fa-code', text: 'API-Zugriff (Soon)' }
          ].map(item => (
            <li class='flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed'>
              <i class={`fa-solid ${item.icon} text-rose-400 mt-1`} aria-hidden='true'></i>
              <span>{item.text}</span>
            </li>
          ))}
        </ul>

        <a 
          href='https://portal.waldheim.dev' 
          target='_blank'
          rel='noopener noreferrer'
          class='block w-full text-center px-6 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold hover:border-rose-500/50 transition-all'
        >
          Matter wählen
        </a>
      </div>
    </div>
  </div>
</section>

    <!-- Pricing Comparison Note -->
    <div class='gsap-fadein mt-12 text-center text-meg-text-secondary opacity-60' style='animation-delay: 0.9s'>
      <p class='text-sm'>
        Alle Preise verstehen sich zzgl. MwSt. • Monatlich kündbar • Kein Vendor Lock-in
      </p>
    </div>
  </div>
</section>
