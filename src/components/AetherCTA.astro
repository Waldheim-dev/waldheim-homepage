---
// Aether Final CTA Section
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark relative overflow-hidden'>
  <div class='absolute inset-0 bg-gradient-to-r from-rose-500/5 via-red-500/5 to-rose-500/5 blur-3xl opacity-50' aria-hidden='true'></div>

  <div class='mx-auto max-w-4xl text-center relative z-10'>
    <h2 class='gsap-fadein text-4xl md:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-8'>
      Bereit für <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-red-500'>Aether</span>?
    </h2>
    <p class='gsap-fadein text-xl md:text-2xl text-meg-text-secondary mb-12 max-w-2xl mx-auto leading-relaxed' style='animation-delay: 0.15s'>
      Sicherer Dateitransfer für Profis. Starten Sie kostenlos oder wählen Sie einen Business-Plan.
    </p>

    <div class='gsap-fadein flex flex-col sm:flex-row gap-4 justify-center items-center' style='animation-delay: 0.3s'>
      <a 
        href='https://aether.waldheim.dev' 
        class='gsap-btn w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-rose-600 text-white font-bold text-lg hover:shadow-xl hover:shadow-rose-500/20 transition-all hover:scale-[1.02]'
      >
        <i class='fa-solid fa-rocket' aria-hidden='true'></i>
        Kostenlos starten
      </a>
      <a 
        href='/aether/#pricing' 
        class='gsap-btn w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg hover:bg-meg-surface-dark hover:border-rose-500/50 transition-all'
      >
        <i class='fa-solid fa-crown' aria-hidden='true'></i>
        Pläne vergleichen
      </a>
    </div>

    <!-- Trust Badges -->
    <div class='gsap-fadein mt-16 flex flex-wrap justify-center gap-x-10 gap-y-4' style='animation-delay: 0.45s'>
      {[
        { icon: 'fa-check-circle', text: 'No Credit Card' },
        { icon: 'fa-check-circle', text: 'Cancel Anytime' },
        { icon: 'fa-check-circle', text: 'GDPR Compliant' }
      ].map(badge => (
        <div class='flex items-center gap-2 text-meg-text-secondary opacity-60'>
          <i class={`fa-solid ${badge.icon} text-rose-400`} aria-hidden='true'></i>
          <span class="text-[10px] font-black uppercase tracking-widest">{badge.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>

