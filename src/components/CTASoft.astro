---
const {title} = Astro.props;
---
<div class="bg-gradient-to-b from-dark-900 to-dark-950 border-y border-light-500/10">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
    <h2 class="max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl gsap-fadein">{title}</h2>
    <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:shrink-0 gsap-fadein">
      <slot />
    </div>
  </div>
</div>
