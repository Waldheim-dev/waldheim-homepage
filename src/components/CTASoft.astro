---
const {title} = Astro.props;
---
<div class="bg-meg-bg-dark border-y border-meg-border-dark">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
    <h2 class="max-w-2xl text-4xl font-black tracking-tighter text-meg-text-primary-dark sm:text-5xl gsap-fadein">{title}</h2>
    <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:shrink-0 gsap-fadein">
      <slot />
    </div>
  </div>
</div>
