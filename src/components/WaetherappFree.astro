---
---

<section class="py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900">
  <div class="container mx-auto max-w-4xl">
    <!-- Main Card -->
    <div class="relative group">
      <!-- Animated Glow -->
      <div class="absolute -inset-1 bg-gradient-to-r from-green-500/20 via-blue-500/10 to-cyan-500/20 
                  blur-2xl opacity-75 group-hover:opacity-100 transition-opacity duration-300 -z-10 rounded-2xl
                  animate-pulse"></div>
      
      <!-- Card Content -->
      <div class="relative bg-dark-900/80 border border-green-500/30 rounded-2xl p-12 backdrop-blur-sm
                  hover:border-green-500/50 transition-all duration-300">
        
        <!-- Header -->
        <div class="text-center mb-8 space-y-4">
          <div class="inline-flex items-center gap-2 bg-green-500/15 border border-green-500/40 rounded-full px-4 py-2">
            <i class="fa-solid fa-heart text-green-400" aria-hidden="true"></i>
            <span class="text-green-300 font-semibold text-sm">Kostenlos für immer</span>
          </div>
          
          <h2 class="text-4xl md:text-5xl font-bold text-white">
            Komplett kostenlos
          </h2>
          
          <p class="text-lg text-light-300 max-w-2xl mx-auto">
            WetherApp ist eine <strong>vollständig kostenlose Open-Source-Anwendung</strong>. Keine versteckten Kosten, keine Premiumfunktionen, keine Ablenkung.
          </p>
        </div>
        
        <!-- Features List -->
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <i class="fa-solid fa-circle-check text-green-400 text-xl" aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="font-bold text-white mb-1">Alle Funktionen</h3>
              <p class="text-light-400 text-sm">Keine limitierten Features oder Paywall</p>
            </div>
          </div>
          
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <i class="fa-solid fa-circle-check text-green-400 text-xl" aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="font-bold text-white mb-1">Open Source</h3>
              <p class="text-light-400 text-sm">MIT-Lizenz, Quellcode verfügbar</p>
            </div>
          </div>
          
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <i class="fa-solid fa-circle-check text-green-400 text-xl" aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="font-bold text-white mb-1">Keine Anmeldung nötig</h3>
              <p class="text-light-400 text-sm">Starte sofort ohne Registrierung</p>
            </div>
          </div>
          
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <i class="fa-solid fa-circle-check text-green-400 text-xl" aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="font-bold text-white mb-1">Self-Hosting</h3>
              <p class="text-light-400 text-sm">Docker-Support für private Instanzen</p>
            </div>
          </div>
        </div>
        
        <!-- Coming Soon -->
        <div class="bg-blue-500/10 border border-blue-500/30 rounded-xl p-6 text-center">
          <p class="text-light-200 mb-3">
            <i class="fa-solid fa-box text-blue-400 mr-2" aria-hidden="true"></i>
            <strong>Demnächst verfügbar:</strong>
          </p>
          <p class="text-light-400 text-sm">
            Docker-Image zum Selbst-Hosten + private Wetter-Instanz für Unternehmen
          </p>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 justify-center mt-8">
          <a 
            href="https://wetter.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-gradient-to-r from-green-400 to-emerald-500 text-dark-950 px-8 py-4 rounded-lg font-semibold 
                   hover:shadow-lg hover:shadow-green-400/50 transition-all duration-300"
            aria-label="Zur kostenlosen WetterApp"
          >
            <i class="fa-solid fa-arrow-up-right mr-2" aria-hidden="true"></i>
            Jetzt kostenlos nutzen
          </a>
          
          <a 
            href="https://gitlab.com/waldheim.dev-services/waetherapp"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-dark-800 border border-light-500/20 text-white px-8 py-4 rounded-lg font-semibold 
                   hover:border-light-500/40 transition-all duration-300"
            aria-label="GitLab Repository öffnen"
          >
            <i class="fa-brands fa-gitlab mr-2" aria-hidden="true"></i>
            GitLab
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
