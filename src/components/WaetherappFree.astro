---
---

<section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="container mx-auto max-w-4xl">
    <!-- Main Card -->
    <div class="relative group">
      <div class="absolute -inset-1 bg-gradient-to-r from-emerald-500/20 via-sky-500/10 to-emerald-500/20 
                  blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000 -z-10 rounded-2xl"></div>
      
      <!-- Card Content -->
      <div class="relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-12 shadow-sm
                  hover:border-emerald-500/30 transition-all duration-300">
        
        <!-- Header -->
        <div class="text-center mb-12 space-y-4">
          <div class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full px-4 py-2">
            <i class="fa-solid fa-heart text-emerald-400" aria-hidden="true"></i>
            <span class="text-emerald-400 font-black text-[10px] uppercase tracking-widest">Open Source Spirit</span>
          </div>
          
          <h2 class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark">
            Komplett kostenlos
          </h2>
          
          <p class="text-lg text-meg-text-secondary max-w-2xl mx-auto leading-relaxed">
            WetherApp ist eine <strong class="text-meg-text-primary-dark">vollständig kostenlose Anwendung</strong>. Keine versteckten Kosten, keine Paywall, keine Tracker.
          </p>
        </div>
        
        <!-- Features List -->
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          {[
            { title: 'Full Access', desc: 'Sämtliche Features uneingeschränkt nutzbar.' },
            { title: 'MIT Licensed', desc: 'Quellcode auf GitLab frei verfügbar.' },
            { title: 'Zero Signup', desc: 'Sofort starten ohne Registrierung.' },
            { title: 'Self-Hostable', desc: 'Optimiert für eigene Docker-Instanzen.' }
          ].map(item => (
            <div class="flex gap-4">
              <div class="shrink-0 mt-1">
                <i class="fa-solid fa-circle-check text-emerald-400"></i>
              </div>
              <div>
                <h3 class="font-bold text-meg-text-primary-dark mb-1">{item.title}</h3>
                <p class="text-meg-text-secondary text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Coming Soon -->
        <div class="bg-meg-bg-dark border border-meg-border-dark rounded-xl p-6 text-center shadow-inner group-hover:border-meg-accent/30 transition-colors">
          <p class="text-meg-text-primary-dark font-bold mb-2 flex items-center justify-center gap-2">
            <i class="fa-solid fa-box text-meg-accent"></i>
            Business Instanz
          </p>
          <p class="text-meg-text-secondary text-xs opacity-70">
            Dediziertes Docker-Image für Unternehmen mit privater Wetter-Infrastruktur geplant.
          </p>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-12">
          <a 
            href="https://wetter.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-emerald-600 text-white px-8 py-4 rounded-xl font-bold shadow-xl shadow-emerald-500/20 hover:scale-[1.02] transition-all text-center"
          >
            <i class="fa-solid fa-arrow-up-right mr-2"></i>
            Jetzt nutzen
          </a>
          
          <a 
            href="https://gitlab.com/waldheim.dev-services/waetherapp"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark px-8 py-4 rounded-xl font-bold hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all text-center"
          >
            <i class="fa-brands fa-gitlab mr-2"></i>
            GitLab Repo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
