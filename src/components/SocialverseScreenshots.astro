---
const screenshots = [
  {
    title: 'AI-gestütztes CRM Dashboard',
    description: 'Ihr intelligentes Kommandozentrum für modernes Marketing. KI-Analysen, Lead-Scoring und automatisierte Kampagnen – alles an einem Ort.',
    image: '/socialverse/socialverse_dashboard.webp',
    alt: 'Socialverse Dashboard mit AI-gestützten Marketing-Analytics',
    features: [
      'Echtzeit Lead-Analytics',
      'AI-Kampagnen-Empfehlungen',
      'Performance-Metriken',
      'DSGVO-konforme Speicherung'
    ],
    side: 'left'
  },
  {
    title: 'Lead-Management mit KI',
    description: 'Erfassen und qualifizieren Sie Leads automatisch. Unsere KI bewertet Leads nach Conversion-Wahrscheinlichkeit und schlägt optimale Aktionen vor.',
    image: '/socialverse/socialverse_leads.webp',
    alt: 'Socialverse Lead-Management mit KI-Scoring',
    features: [
      'Automatisches Lead-Scoring',
      'Smart Segmentierung',
      'Lead-Nurturing-Workflows',
      'Duplikaterkennung mit KI'
    ],
    side: 'right'
  },
  {
    title: 'Kampagnen-Automation',
    description: 'Erstellen Sie Multi-Channel-Kampagnen mit wenigen Klicks. Die KI optimiert Timing, Inhalte und Zielgruppen für maximale Conversion.',
    image: '/socialverse/socialverse_campaigns.webp',
    alt: 'Socialverse Kampagnen-Management mit Automation',
    features: [
      'Multi-Channel Kampagnen',
      'A/B-Testing automatisch',
      'Personalisierte Inhalte',
      'Performance-Tracking'
    ],
    side: 'left'
  },
  {
    title: 'Social Media Integration',
    description: 'Verbinden Sie alle Ihre Social-Media-Kanäle und steuern Sie sie zentral. Von Lead-Generierung bis Engagement-Tracking.',
    image: '/socialverse/socialverse_socials.webp',
    alt: 'Socialverse Social-Media-Integration für Lead-Generierung',
    features: [
      'Facebook & Instagram Ads',
      'LinkedIn Lead Gen Forms',
      'Twitter/X Engagement',
      'Automatisches Posting'
    ],
    side: 'right'
  },
  {
    title: 'AI-Assistent für Marketing',
    description: 'Ihr persönlicher Marketing-Assistent powered by AI. Generiert Texte, optimiert Kampagnen und gibt datenbasierte Empfehlungen.',
    image: '/socialverse/socialverse_ai.webp',
    alt: 'Socialverse AI-Assistent für Marketing-Automation',
    features: [
      'Content-Generierung (GPT-4)',
      'Automatische Optimierung',
      'Trend-Analyse',
      'Konkurrenz-Monitoring'
    ],
    side: 'left'
  },
  {
    title: 'Detaillierte Lead-Profile',
    description: 'Vollständige 360°-Sicht auf jeden Lead. Interaktionshistorie, Engagement-Score und automatisch erstellte Next-Best-Actions.',
    image: '/socialverse/socialverse_lead.webp',
    alt: 'Socialverse detailliertes Lead-Profil mit Interaktionshistorie',
    features: [
      '360°-Kontaktansicht',
      'Interaktionshistorie',
      'Engagement-Timeline',
      'Automatische Anreicherung'
    ],
    side: 'right'
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='max-w-7xl mx-auto'>
    <div class='text-center mb-24 gsap-fadein'>
      <h2 class='text-sm font-bold uppercase tracking-widest text-violet-400 mb-4'>
        Product Tour
      </h2>
      <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
        KI-Power für Ihr <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Marketing</span>
      </p>
      <p class='text-xl text-meg-text-secondary max-w-3xl mx-auto'>
        Ein intelligentes Kommandozentrum für datengetriebenes Wachstum.
      </p>
    </div>

    <div class='space-y-32'>
      {screenshots.map((screenshot, index) => (
        <div class={`gsap-fadein flex flex-col ${screenshot.side === 'right' ? 'lg:flex-row-reverse' : 'lg:flex-row'} gap-16 items-center`} style={`animation-delay: ${index * 0.15}s`}>
          <div class='flex-1'>
            <h3 class='text-3xl font-black text-meg-text-primary-dark mb-6 tracking-tight'>
              {screenshot.title}
            </h3>
            <p class='text-lg text-meg-text-secondary mb-10 leading-relaxed'>
              {screenshot.description}
            </p>
            <ul class='grid sm:grid-cols-2 gap-4'>
              {screenshot.features.map((feature) => (
                <li class='flex items-center gap-3 bg-meg-surface-dark/50 border border-meg-border-dark rounded-xl p-3 shadow-inner'>
                  <i class='fa-solid fa-wand-magic-sparkles text-violet-400 text-xs'></i>
                  <span class='text-[10px] font-black uppercase tracking-widest text-meg-text-primary-dark'>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class='flex-1'>
            <div class='relative group'>
              <div class='absolute -inset-4 bg-gradient-to-r from-violet-400/10 to-fuchsia-500/10 rounded-2xl blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000'></div>
              <img
                src={screenshot.image}
                alt={screenshot.alt}
                loading='lazy'
                class='relative rounded-2xl shadow-2xl border border-meg-border-dark group-hover:scale-[1.02] transition-all duration-700 bg-meg-surface-dark opacity-90 group-hover:opacity-100'
              />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class='mt-32 text-center gsap-fadein bg-meg-surface-dark/80 backdrop-blur-xl border-2 border-violet-500/20 rounded-2xl p-12 shadow-2xl shadow-violet-500/5 group' style='animation-delay: 0.9s'>
      <h3 class='text-3xl font-black text-meg-text-primary-dark mb-4 tracking-tighter'>
        <i class='fa-solid fa-lock text-violet-400 mr-2' aria-hidden='true'></i>
        Closed Beta Access
      </h3>
      <p class='text-lg text-meg-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed'>
        Socialverse befindet sich aktuell in der <strong class='text-meg-text-primary-dark'>Closed Beta</strong>. 
        Sichern Sie sich jetzt Ihren Platz als Early Adopter.
      </p>
      <a
        href='https://suite.waldheim.dev'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-2 px-8 py-4 bg-violet-600 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-violet-500/30 transition-all hover:scale-[1.02]'
      >
        <i class='fa-solid fa-envelope' aria-hidden='true'></i>
        Anfrage im Portal
      </a>
    </div>
  </div>
</section>
