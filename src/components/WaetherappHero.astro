---
import WaetherappHeroBackground from './WaetherappHeroBackground.astro';

interface Props {
  variant?: 'default' | 'gradient';
}

const { variant = 'default' } = Astro.props;
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-meg-bg-dark border-b border-meg-border-dark">
  <WaetherappHeroBackground />
  
  <div class="container mx-auto px-6 sm:px-8 relative z-10">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Left: Content -->
      <div class="space-y-8">
        <div class="inline-flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark rounded-full px-4 py-2 shadow-sm backdrop-blur-md">
          <i class="fa-solid fa-cloud text-meg-accent" aria-hidden="true"></i>
          <span class="text-meg-text-primary-dark text-sm font-bold tracking-tight">Open Source Wetter-App</span>
        </div>
        
        <h1 class="text-5xl md:text-6xl lg:text-8xl font-black text-meg-text-primary-dark leading-tight tracking-tighter">
          Moderne <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Wetter-</span><br/>vorhersage
        </h1>
        
        <p class="text-xl text-meg-text-secondary max-w-xl leading-relaxed">
          Echtzeit-Wetterdaten mit intelligentem Multi-Provider-System. Genaue Vorhersagen, automatisches Fallback, kostenlos und open-source.
        </p>
        
        <div class="flex flex-wrap gap-4 pt-4">
          <a 
            href="/waetherapp/#features"
            class="bg-meg-accent text-white px-8 py-4 rounded-xl font-bold text-lg
                   hover:shadow-xl hover:shadow-meg-accent/30 transition-all duration-300 hover:scale-[1.02]"
            aria-label="Zu den Features scrollen"
          >
            <i class="fa-solid fa-arrow-down mr-2" aria-hidden="true"></i>
            Features entdecken
          </a>
          
          <a 
            href="https://wetter.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark px-8 py-4 rounded-xl font-bold text-lg
                   hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all duration-300"
            aria-label="Zur WetterApp öffnen (neues Fenster)"
          >
            <i class="fa-solid fa-arrow-up-right-from-square mr-2" aria-hidden="true"></i>
            Zur App
          </a>
        </div>
      </div>
      
      <!-- Right: Visual -->
      <div class="relative hidden md:block">
        <div class="absolute inset-0 bg-gradient-to-r from-meg-accent/10 via-sky-400/10 to-violet-500/10 blur-3xl -z-10"></div>
        
        <div class="relative bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 backdrop-blur-xl
                    group hover:border-meg-accent/30 transition-all duration-500 shadow-2xl">
          <div class="absolute -inset-2 bg-gradient-to-r from-meg-accent/5 to-sky-400/5 
                      blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>
          
          <div class="space-y-4">
            <!-- Weather Widget Preview -->
            <div class="bg-meg-bg-dark/80 rounded-xl p-6 space-y-4 border border-meg-border-dark shadow-inner">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-meg-text-primary-dark font-black tracking-tight">Dein Standort</h3>
                  <p class="text-meg-text-secondary text-sm">Berlin, Deutschland</p>
                </div>
                <i class="fa-solid fa-cloud-sun text-5xl text-yellow-400 drop-shadow-lg" aria-hidden="true"></i>
              </div>
              
              <div class="grid grid-cols-3 gap-3 pt-4 border-t border-meg-border-dark">
                <div class="text-center">
                  <p class="text-2xl font-black text-meg-accent">22°C</p>
                  <p class="text-meg-text-secondary text-[10px] uppercase font-bold">Temp</p>
                </div>
                <div class="text-center">
                  <p class="text-2xl font-black text-sky-400">65%</p>
                  <p class="text-meg-text-secondary text-[10px] uppercase font-bold">Feuchte</p>
                </div>
                <div class="text-center">
                  <p class="text-2xl font-black text-meg-accent">12 km/h</p>
                  <p class="text-meg-text-secondary text-[10px] uppercase font-bold">Wind</p>
                </div>
              </div>
            </div>
            
            <!-- Multi-Provider Badge -->
            <div class="bg-meg-bg-dark/80 rounded-xl p-4 flex items-center gap-3 border border-meg-border-dark shadow-inner">
              <div class="size-10 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-400 border border-emerald-500/20">
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
              </div>
              <div>
                <p class="text-meg-text-primary-dark text-sm font-bold">Intelligenter Fallback</p>
                <p class="text-meg-text-secondary text-[10px] uppercase font-bold">4 Wetter-Provider</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
