---
const comparisonFeatures = [
  { feature: 'Preis (20 WEGs/Monat)', silvacore: '29 €', competitors: '29-449 €', note: 'Silvacore günstiger als Haufe, casavi, Domus' },
  { feature: 'Starter WEG gratis', silvacore: true, competitors: false },
  { feature: 'HKVO §6a Compliance', silvacore: 'Inklusive', competitors: 'Nur bei 3/8 Anbietern', note: 'Haufe, Immoware24, casavi (Add-on)' },
  { feature: 'Verbrauchsabrechnung', silvacore: 'Inklusive', competitors: 'Oft Aufpreis' },
  { feature: 'Dokumentenmanagement', silvacore: '10 GB/WEG', competitors: '5-10 GB', note: 'Unbegrenzter Speicher nur bei Premium-Tarifen' },
  { feature: 'Monatlich kündbar', silvacore: true, competitors: 'Oft 12-24 Monate', note: 'Enterprise-Lösungen meist jährliche Verträge' },
  { feature: 'Offene API', silvacore: true, competitors: 'Nur Enterprise', note: 'Haufe, Domus, casavi haben APIs' },
  { feature: 'Made in Germany', silvacore: true, competitors: true },
  { feature: 'Support', silvacore: 'Deutsch, KI-Bot, GitHub & Ticket', competitors: 'E-Mail oder KI-Bot', note: 'Domus Support wird kritisiert' },
  { feature: 'Einrichtungsgebühren', silvacore: '0 €', competitors: '0-5.000 €', note: 'Enterprise: 2.000-5.000 € Einrichtung' },
  { feature: 'Schulungskosten', silvacore: '0 € (Self-Service)', competitors: '0-2.000 €', note: 'Enterprise oft 1.000-2.000 € Schulung' },
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0s'>
        Marktvergleich
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Der <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Unterschied</span>
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto' style='animation-delay: 0.3s'>
        Feature-Vergleich mit etablierten WEG-Verwaltungslösungen.
      </p>
    </div>

    <div tabindex="0" class='gsap-fadein overflow-x-auto rounded-2xl border border-meg-border-dark bg-meg-surface-dark/30 backdrop-blur-md shadow-sm' style='animation-delay: 0.45s'>
      <table class='w-full min-w-[640px] border-collapse' role='table'>
        <thead>
          <tr class='border-b border-meg-border-dark'>
            <th scope='col' class='px-6 py-4 text-left text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Feature</th>
            <th scope='col' class='px-6 py-4 text-center bg-emerald-500/5 text-[10px] font-black uppercase tracking-widest text-emerald-400'>
              <i class='fa-solid fa-star mr-1' aria-hidden='true'></i>Silvacore
            </th>
            <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>
              Wettbewerber
            </th>
          </tr>
        </thead>
        <tbody class='divide-y divide-meg-border-dark'>
          {comparisonFeatures.map((item, index) => (
            <tr class='gsap-fadein hover:bg-meg-accent/5 transition-colors' style={`animation-delay: ${0.6 + index * 0.05}s`}>
              <td class='px-6 py-4'>
                <div class='text-sm font-bold text-meg-text-primary-dark'>{item.feature}</div>
                {item.note && (
                  <div class='text-[10px] text-meg-text-secondary mt-1 opacity-60 uppercase font-black tracking-tighter'>
                    {item.note}
                  </div>
                )}
              </td>
              <td class='px-6 py-4 text-center bg-emerald-500/5'>
                {typeof item.silvacore === 'boolean' ? (
                  item.silvacore ? (
                    <i class='fa-solid fa-check-circle text-emerald-400 text-xl'></i>
                  ) : (
                    <i class='fa-solid fa-times-circle text-rose-500/40 text-xl'></i>
                  )
                ) : (
                  <span class='text-sm font-black text-emerald-400 tracking-tight'>
                    {item.silvacore}
                  </span>
                )}
              </td>
              <td class='px-6 py-4 text-center text-sm text-meg-text-secondary'>
                {typeof item.competitors === 'boolean' ? (
                  item.competitors ? (
                    <i class='fa-solid fa-check-circle text-meg-text-secondary text-xl opacity-40'></i>
                  ) : (
                    <i class='fa-solid fa-times-circle text-rose-500/40 text-xl'></i>
                  )
                ) : (
                  <span class='font-medium'>{item.competitors}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    
    <div class='mt-12 text-center gsap-fadein' style='animation-delay: 1.2s'>
      <div class="inline-flex items-center gap-3 px-4 py-2 bg-meg-surface-dark/50 border border-meg-border-dark rounded-full shadow-sm">
        <i class="fa-solid fa-info-circle text-meg-accent text-xs"></i>
        <p class="text-meg-text-secondary text-[10px] font-black uppercase tracking-widest">
          Datenstand: Oktober 2025 – Basierend auf öffentlichen Preislisten
        </p>
      </div>
    </div>
  </div>
</section>
