---
// This code has been partially generated by an AI.

interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Was meine Kunden sagen",
  subtitle = "Vertrauen durch Qualität und Transparenz"
} = Astro.props;

// Versuche die Testimonials aus der Content Collection zu laden (optional)
const testimonials: any[] = [];

// Falls keine Testimonials vorhanden sind, rendern wir gar nichts
if (testimonials.length === 0) {
  return null;
}
---

<section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark overflow-hidden">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
        Social Proof
      </h2>
      <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-normal text-meg-text-primary-dark mb-6">
        {title}
      </p>
      <p class="gsap-fadein text-xl text-meg-text-secondary">
        {subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((t, i) => (
        <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 flex flex-col justify-between shadow-sm hover:border-meg-accent/20 transition-all duration-300" style={`animation-delay: ${i * 0.1}s`}>
          <div>
            <div class="flex gap-1 text-meg-accent mb-6">
              {[...Array(t.data.stars || 5)].map(() => (
                <i class="fa-solid fa-star text-xs"></i>
              ))}
            </div>
            <blockquote class="text-meg-text-primary-dark text-lg leading-relaxed italic mb-8">
              "{t.data.quote}"
            </blockquote>
          </div>
          <div class="flex items-center gap-4 border-t border-meg-border-dark pt-6">
            {t.data.image ? (
              <img src={t.data.image} alt={t.data.author} class="w-12 h-12 rounded-full object-cover border border-meg-border-dark" />
            ) : (
              <div class="w-12 h-12 rounded-full bg-meg-accent/10 border border-meg-accent/20 flex items-center justify-center text-meg-accent font-bold">
                {t.data.author.charAt(0)}
              </div>
            )}
            <div>
              <div class="font-bold text-meg-text-primary-dark">{t.data.author}</div>
              <div class="text-sm text-meg-text-secondary">{t.data.role} {t.data.company && `at ${t.data.company}`}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
