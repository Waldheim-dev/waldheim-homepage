---
---

<section id="pricing" class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center mb-16 gsap-fadein">
      <h2 class="text-4xl md:text-5xl font-bold text-meg-text-primary-dark mb-6">
        Einfache, transparente <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent">Preise</span>
      </h2>
      <p class="text-xl text-meg-text-secondary max-w-3xl mx-auto">
        Ecodrive bietet flexible Preispläne, die auf die Bedürfnisse von Einzelpersonen und Unternehmen zugeschnitten sind. Wählen Sie den Plan, der am besten zu Ihnen passt.
      </p>
    </div>

      <script is:inline data-id="script" data-plan="monthly">
        document.addEventListener('astro:page-load', () => {
          const script = document.querySelector('*[data-id="script"]');
          const monthly = document.querySelector('#monthly');
          const annual = document.querySelector('#annual');

          const free = document.querySelector('#free');
          const basic = document.querySelector('#basic');
          const pro = document.querySelector('#pro');
          const premium = document.querySelector('#premium');

          monthly?.addEventListener('click', () => {
            script.dataset.plan = 'monthly';
            monthly.classList.add('bg-meg-accent', 'text-white');
            monthly.classList.remove('text-meg-text-secondary');
            annual.classList.remove('bg-meg-accent', 'text-white');
            annual.classList.add('text-meg-text-secondary');

            free.querySelector('.price').innerHTML = '0,00€';
            basic.querySelector('.price').innerHTML = '5,00€';
            pro.querySelector('.price').innerHTML = '15,00€';
            premium.querySelector('.price').innerHTML = '250,00€';

            free.querySelector('.frequency').innerHTML = '/Monat';
            basic.querySelector('.frequency').innerHTML = '/Monat';
            pro.querySelector('.frequency').innerHTML = '/Monat';
            premium.querySelector('.frequency').innerHTML = '/Monat';
          });

          annual?.addEventListener('click', () => {
            script.dataset.plan = 'annual';
            annual.classList.add('bg-meg-accent', 'text-white');
            annual.classList.remove('text-meg-text-secondary');
            monthly.classList.remove('bg-meg-accent', 'text-white');
            monthly.classList.add('text-meg-text-secondary');

            free.querySelector('.price').innerHTML = '0,00€';
            basic.querySelector('.price').innerHTML = '57,00€';
            pro.querySelector('.price').innerHTML = '171,00€';
            premium.querySelector('.price').innerHTML = '2850,00€';

            free.querySelector('.frequency').innerHTML = '/Jahr';
            basic.querySelector('.frequency').innerHTML = '/Jahr';
            pro.querySelector('.frequency').innerHTML = '/Jahr';
            premium.querySelector('.frequency').innerHTML = '/Jahr';
          });
        });
      </script>
      <div class="mt-16 flex justify-center gsap-fadein">
        <fieldset
          class="grid grid-cols-2 gap-x-1 rounded-full bg-meg-surface-dark border border-meg-border-dark p-1 text-center text-xs font-semibold leading-5 text-meg-text-secondary shadow-sm"
        >
          <legend class="sr-only">Zahlungsrythmus</legend>
          <label
            class="cursor-pointer rounded-full px-4 py-1.5 bg-meg-accent text-white transition-all"
            id="monthly"
            for="frequency-monthly"
          >
            <input
              type="radio"
              name="frequency"
              id="frequency-monthly"
              value="monthly"
              class="sr-only"
            />
            <span>Monatlich</span>
          </label>
          <label
            class="cursor-pointer rounded-full px-4 py-1.5 transition-all text-meg-text-secondary"
            id="annual"
            for="frequency-annualy"
          >
            <input
              type="radio"
              name="frequency"
              id="frequency-annualy"
              value="annually"
              class="sr-only"
            />
            <span>Jährlich
              <span
                class="inline-flex items-center rounded-md bg-emerald-500/10 px-2 py-0.5 text-[10px] font-bold text-emerald-500 border border-emerald-500/20 ml-1">-5%</span></span>
          </label>
        </fieldset>
      </div>
      <div
        class="isolate mx-auto mt-10 grid max-w-lg grid-cols-1 gap-8 lg:mx-0 md:max-w-none md:grid-cols-2 lg:grid-cols-4"
      >
        <!-- Free Tier -->
        <div
          class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 xl:p-10 hover:border-meg-accent/30 transition-all duration-300 group shadow-sm"
          id="free" style="animation-delay: 0.3s"
        >
          <div class="flex items-center justify-between gap-x-4">
            <h3
              id="tier-free"
              class="text-lg font-bold leading-8 text-meg-text-primary-dark flex items-center gap-2"
            >
              <i class="fa-solid fa-seedling text-emerald-400"></i> Free
              </h3>
              </div>
              <p class="mt-4 text-sm leading-6 text-meg-text-secondary">
              Lerne die Software kennen und probiere sie aus.
              <br> <span class="inline-flex items-center gap-1.5 mt-2 text-emerald-400 font-semibold"><i class="fa-solid fa-check-circle text-[10px]"></i> Verfügbar</span>
              </p>
              <p class="mt-6 flex items-baseline gap-x-1">
              <span class="price text-4xl font-black tracking-tight text-meg-text-primary-dark">0,00€</span>
              <span class="frequency text-sm font-semibold leading-6 text-meg-text-secondary opacity-60">/Monat</span>
              </p>
              <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-meg-text-secondary xl:mt-10">
              {['1 Fahrzeug', 'Tank Protokollierung', 'Fahrzeugkalkulation'].map((feature) => (
              <li class="flex gap-x-3 items-center">
                <i class="fa-solid fa-check text-emerald-400 text-xs" aria-hidden="true"></i>
                <span set:html={feature.replace('1', '<strong>1</strong>')} />
              </li>
              ))}
              </ul>
              </div>

              <!-- Basic Tier -->
              <div
              class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 xl:p-10 hover:border-meg-accent/30 transition-all duration-300 group shadow-sm"
              id="basic" style="animation-delay: 0.45s"
              >
              <div class="flex items-center justify-between gap-x-4">
              <h3
              id="tier-basic"
              class="text-lg font-bold leading-8 text-meg-text-primary-dark flex items-center gap-2"
              >
              <i class="fa-solid fa-car-side text-sky-400"></i> Basic
              </h3>
              </div>
              <p class="mt-4 text-sm leading-6 text-meg-text-secondary">
              Ideal für Familien, kleine Firmen, Teams und Dich!
              <br> <span class="inline-flex items-center gap-1.5 mt-2 text-emerald-400 font-semibold"><i class="fa-solid fa-check-circle text-[10px]"></i> Verfügbar</span>
              </p>
              <p class="mt-6 flex items-baseline gap-x-1">
              <span class="price text-4xl font-black tracking-tight text-meg-text-primary-dark">5,00€</span>
              <span class="frequency text-sm font-semibold leading-6 text-meg-text-secondary opacity-60">/Monat</span>
              </p>
              <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-meg-text-secondary xl:mt-10">
              {['3 Fahrzeuge', 'Tank Protokollierung', 'Fahrzeugkalkulation', 'Service Protokollierung', 'Fahrten Protokollierung'].map((feature) => (
              <li class="flex gap-x-3 items-center">
                <i class="fa-solid fa-check text-sky-400 text-xs" aria-hidden="true"></i>
                <span set:html={feature.replace('3', '<strong>3</strong>')} />
              </li>
              ))}
              </ul>
              </div>

              <!-- Pro Tier -->
              <div
              class="gsap-fadein bg-meg-surface-dark/80 backdrop-blur-xl border-2 border-emerald-500/30 rounded-2xl p-8 xl:p-10 shadow-2xl shadow-emerald-500/10 scale-105 hover:scale-[1.07] transition-all duration-300 z-10 relative overflow-hidden"
              id="pro" style="animation-delay: 0.6s"
              >
              <div class="absolute top-0 right-0 bg-emerald-500 text-white text-[10px] font-black px-3 py-1 rounded-bl-lg uppercase tracking-tighter">
              Empfehlung
              </div>
              <div class="flex items-center justify-between gap-x-4">
              <h3
              id="tier-pro"
              class="text-lg font-bold leading-8 text-meg-text-primary-dark flex items-center gap-2"
              >
              <i class="fa-solid fa-rocket text-emerald-400"></i> Pro
              </h3>
              </div>
              <p class="mt-4 text-sm leading-6 text-meg-text-secondary">
              Optimal für Firmen mit einer gesetzlichen Verpflichtung.
              <br> <span class="inline-flex items-center gap-1.5 mt-2 text-emerald-400 font-semibold"><i class="fa-solid fa-check-circle text-[10px]"></i> Verfügbar</span>
              </p>
              <p class="mt-6 flex items-baseline gap-x-1">
              <span class="price text-4xl font-black tracking-tight text-meg-text-primary-dark">15,00€</span>
              <span class="frequency text-sm font-semibold leading-6 text-meg-text-secondary opacity-60">/Monat</span>
              </p>
              <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-meg-text-secondary xl:mt-10">
              {[
              '10 Fahrzeuge',
              'Tank Protokollierung',
              'Fahrzeugkalkulation',
              'Service Protokollierung',
              'Fahrten Protokollierung',
              'Exportiertes Fahrtenbuch',
              '10 Benutzereinladung',
              'Statistiken',
              'Logbuch'
              ].map((feature) => (
              <li class="flex gap-x-3 items-center">
                <i class="fa-solid fa-check text-emerald-400 text-xs" aria-hidden="true"></i>
                <span set:html={feature.replace('10', '<strong>10</strong>')} />
              </li>
              ))}
              </ul>
              </div>

              <!-- Premium Tier -->
              <div
              class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 xl:p-10 hover:border-meg-accent/30 transition-all duration-300 group shadow-sm"
              id="premium" style="animation-delay: 0.75s"
              >
              <div class="flex items-center justify-between gap-x-4">
              <h3
              id="tier-premium"
              class="text-lg font-bold leading-8 text-meg-text-primary-dark flex items-center gap-2"
              >
              <i class="fa-solid fa-earth-europe text-purple-400"></i> Premium
              </h3>
              </div>          <p class="mt-4 text-sm leading-6 text-meg-text-secondary">
            Optimal für große Firmen und großen Fuhrparks.
            <br> <em class="text-xs opacity-60 italic">Ab Version 1.3</em>
          </p>
          <p class="mt-6 flex items-baseline gap-x-1">
            <span class="price text-4xl font-black tracking-tight text-meg-text-primary-dark">250,00€</span>
            <span class="frequency text-sm font-semibold leading-6 text-meg-text-secondary opacity-60">/Monat</span>
          </p>
          <ul role="list" class="mt-8 space-y-3 text-sm leading-6 text-meg-text-secondary xl:mt-10">
            {[
              'Unbegrenzte Fahrzeuge',
              'Tank Protokollierung',
              'Fahrzeugkalkulation',
              'Service Protokollierung',
              'Fahrten Protokollierung',
              'Exportiertes Fahrtenbuch',
              'Unbegrenzte Benutzereinladung',
              'Statistiken',
              'Logbuch'
            ].map((feature) => (
              <li class="flex gap-x-3 items-center">
                <i class="fa-solid fa-check text-purple-400 text-xs" aria-hidden="true"></i>
                <span set:html={feature.replace('Unbegrenzte', '<strong>Unbegrenzte</strong>')} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
</section>