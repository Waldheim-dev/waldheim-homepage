                class="inline-flex items-center rounded-md bg-light-100 px-2 py-1 text-xs font-medium text-primary-900 ring-1 ring-inset ring-primary-600/20">-5%</span></span>
          </label>
        </fieldset>
      </div>
      <div
        class="isolate mx-auto mt-10 grid max-w-lg grid-cols-1 gap-8 lg:mx-0 md:max-w-none md:grid-cols-2 lg:grid-cols-4"
