<div class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto px-6 lg:px-8 pt-16">
      <div class="mx-auto max-w-4xl text-center">
        <h2
          class="text-base font-semibold leading-7 text-sherpa-blue-900 "
        >
          Ecodrive: Preise & Verfügbarkeit
        </h2>
        <p
          class="mt-2 text-4xl font-bold tracking-tight text-sherpa-blue-900  sm:text-5xl"
        >
          Transparente Preise für Ecodrive
        </p>
      </div>
      <p
        class="mx-auto mt-6 max-w-2xl text-center text-lg leading-8"
      >
        Ecodrive befindet sich derzeit in der Entwicklung. Die Version 1.0 ist für 2025 geplant. Die finalen Preise
        stehen noch nicht fest. Bei Interesse können Sie sich gerne für Neuigkeiten vormerken lassen.
      </p>

      <script is:inline data-id="script" data-plan="monthly">
        document.addEventListener('astro:page-load', () => {
          const script = document.querySelector('*[data-id="script"]');
          const monthly = document.querySelector('#monthly');
          const annual = document.querySelector('#annual');

          const free = document.querySelector('#free');
          const basic = document.querySelector('#basic');
          const pro = document.querySelector('#pro');
          const premium = document.querySelector('#premium');

          monthly?.addEventListener('click', () => {
            script.dataset.plan = 'monthly';
            monthly.classList.add('bg-sherpa-blue-900', 'text-white');
            annual.classList.remove('bg-sherpa-blue-900', 'text-white');

            free.querySelector('.price').innerHTML = '0,00€';
            basic.querySelector('.price').innerHTML = '5,00€';
            pro.querySelector('.price').innerHTML = '15,00€';
            premium.querySelector('.price').innerHTML = '250,00€';

            free.querySelector('.frequency').innerHTML = '/Monat';
            basic.querySelector('.frequency').innerHTML = '/Monat';
            pro.querySelector('.frequency').innerHTML = '/Monat';
            premium.querySelector('.frequency').innerHTML = '/Monat';
          });

          annual?.addEventListener('click', () => {
            script.dataset.plan = 'annual';
            annual.classList.add('bg-sherpa-blue-900', 'text-white');
            monthly.classList.remove('bg-sherpa-blue-900', 'text-white');

            free.querySelector('.price').innerHTML = '0,00€';
            basic.querySelector('.price').innerHTML = '57,00€';
            pro.querySelector('.price').innerHTML = '171,00€';
            premium.querySelector('.price').innerHTML = '2850,00€';

            free.querySelector('.frequency').innerHTML = '/Jahr';
            basic.querySelector('.frequency').innerHTML = '/Jahr';
            pro.querySelector('.frequency').innerHTML = '/Jahr';
            premium.querySelector('.frequency').innerHTML = '/Jahr';
          });
        });
      </script>
      <div class="mt-16 flex justify-center">
        <fieldset
          class="grid grid-cols-2 gap-x-1 rounded-full bg-black/5 p-1 text-center text-xs font-semibold leading-5 text-sherpa-blue-900 "
        >
          <legend class="sr-only">Zahlungsrythmus</legend>
          <!-- Checked: "bg-sherpa-blue-900 text-white" -->
          <label
            class="cursor-pointer rounded-full px-2.5 py-1 bg-sherpa-blue-900  text-white"
            id="monthly"
            for="frequency-monthly"
          >
            <input
              type="radio"
              name="frequency"
              id="frequency-monthly"
              value="monthly"
              class="sr-only"
            />
            <span>Monatlich</span>
          </label>
          <!-- Checked: "bg-sherpa-blue-900 text-white" -->
          <label
            class="cursor-pointer rounded-full px-2.5 py-1"
            id="annual"
            for="frequency-annualy"
