---
// Obsidian Gemini Agent Features
const features = [
  {
    icon: 'fa-folder-tree',
    title: 'Vault-Navigation',
    description: 'Lassen Sie die KI neue Notizen erstellen, bestehende bearbeiten oder Ordnerstrukturen organisieren – direkt per Sprachbefehl oder Chat.',
    color: 'from-indigo-500 to-violet-500'
  },
  {
    icon: 'fa-hashtag',
    title: 'Kontext-Mentions',
    description: 'Verknüpfen Sie Dateien mit dem einfachen #-Symbol mitten im Chat. Die KI liest den Inhalt sofort als Kontext mit.',
    color: 'from-blue-500 to-indigo-500'
  },
  {
    icon: 'fa-command',
    title: 'Systemsteuerung',
    description: 'Gemini kann Obsidian-Befehle ausführen, die globale Suche bedienen und sogar komplexe Canvas-Mindmaps für Sie erstellen.',
    color: 'from-violet-500 to-purple-500'
  },
  {
    icon: 'fa-sparkles',
    title: 'Smart Fallback',
    description: 'Dank Auto-Modus wählt das Plugin stets das effizienteste Modell und wechselt bei Quoten-Engpässen nahtlos zum nächsten Fallback.',
    color: 'from-indigo-500 to-cyan-500'
  },
  {
    icon: 'fa-database',
    title: 'Conversation Caching',
    description: 'Alle Ihre Chats werden sicher lokal gespeichert und können jederzeit fortgesetzt werden – volle Kontrolle über Ihren Dialog-Verlauf.',
    color: 'from-cyan-500 to-blue-500'
  },
  {
    icon: 'fa-markdown',
    title: 'Markdown-Native',
    description: 'Tabellen, Code-Blöcke und mathematische Formeln werden perfekt gerendert, genau wie Sie es von Obsidian erwarten.',
    color: 'from-emerald-500 to-teal-500'
  },
  {
    icon: 'fa-brain-circuit',
    title: 'Interaktive Denkphase',
    description: 'Sehen Sie live, was die KI gerade tut (z.B. "Searching vault..."), während Sie nützliche Tipps und Zitate erhalten.',
    color: 'from-orange-500 to-red-500'
  },
  {
    icon: 'fa-key',
    title: 'Secure Keychain',
    description: 'API-Keys werden niemals im Klartext gespeichert, sondern sicher im nativen Schlüsselbund Ihres Betriebssystems abgelegt.',
    color: 'from-red-500 to-rose-500'
  }
];

const targetGroups = [
  {
    icon: 'fa-pen-nib',
    title: 'Wissensarbeiter',
    description: 'Strukturieren Sie komplexe Recherchen und lassen Sie die KI Zusammenhänge in Ihrem Zettelkasten finden.',
    tags: ['Zettelkasten', 'PKM', 'Research']
  },
  {
    icon: 'fa-graduation-cap',
    title: 'Studierende',
    description: 'Fassen Sie Vorlesungen zusammen, erstellen Sie Lernkarten und organisieren Sie Ihre Semester-Notizen effizienter.',
    tags: ['Learning', 'Flashcards', 'Examen']
  },
  {
    icon: 'fa-code',
    title: 'Entwickler',
    description: 'Dokumentieren Sie Code-Snippets, planen Sie Architekturen und nutzen Sie Gemini als Sparringspartner für Logik-Fragen.',
    tags: ['Docs', 'Architecture', 'Snippets']
  },
  {
    icon: 'fa-book-open',
    title: 'Autoren',
    description: 'Überwinden Sie Schreibblockaden, entwickeln Sie Charaktere und behalten Sie den Überblick über Ihre gesamte Story-Welt.',
    tags: ['Writing', 'Worldbuilding', 'Plot']
  }
];
---

<section id='features' class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <!-- Features Section -->
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-indigo-400 mb-4'>
        <i class='fa-solid fa-star-excalibur mr-2' aria-hidden='true'></i>
        Plugin Power
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Ein Agent, <span class='text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-500'>kein Chatbot</span>
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto' style='animation-delay: 0.3s'>
        Während herkömmliche KI-Plugins lediglich Texte generieren, kann der Gemini AI Agent Ihren Vault aktiv verstehen und steuern.
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-24'>
      {features.map((feature, index) => (
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 hover:border-indigo-500/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${0.45 + index * 0.05}s`}>
          <div class='flex items-center gap-4 mb-4'>
            <div class={`size-10 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:border-indigo-500/50 transition-all shadow-inner`}>
              <i class={`fa-solid ${feature.icon} text-indigo-400 text-lg`} aria-hidden='true'></i>
            </div>
            <h3 class='text-base font-bold text-meg-text-primary-dark'>{feature.title}</h3>
          </div>
          <p class='text-meg-text-secondary text-xs leading-relaxed'>{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Use Cases Section -->
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-indigo-400 mb-4'>
        Anwendungsbereiche
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Maximale <span class='text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-500'>Produktivität</span>
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-8'>
      {targetGroups.map((group, index) => (
        <div class='gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-indigo-500/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${0.6 + index * 0.1}s`}>
          <!-- Ambient Glow on Hover -->
          <div class='absolute inset-0 bg-gradient-to-r from-indigo-500/5 via-violet-500/5 to-indigo-500/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity -z-10'></div>

          <div class='mb-6'>
            <div class='size-14 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:border-indigo-500/50 transition-all shadow-inner'>
              <i class={`fa-solid ${group.icon} text-indigo-400 text-2xl`} aria-hidden='true'></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-2'>{group.title}</h3>
            <p class='text-meg-text-secondary text-sm leading-relaxed mb-4'>{group.description}</p>
          </div>

          <div class='flex flex-wrap gap-2 mt-auto'>
            {group.tags.map((tag) => (
              <span class='px-3 py-1 text-[10px] font-black uppercase tracking-tighter bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 rounded-lg'>
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
