---
// This code has been fully generated by an AI.
export interface Props {
  lang?: 'de' | 'en';
  question: string;
  directAnswer: string;
  price: string;
  priceSubtext?: string;
  duration: string;
  durationSubtext?: string;
  deliverable: string;
  location?: string;
  accentColor?: 'blue' | 'purple' | 'green' | 'orange' | 'rose' | 'yellow' | 'cyan' | 'indigo';
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  question,
  directAnswer,
  price,
  priceSubtext = 'Transparent · § 19 UStG (Netto = Brutto)',
  duration,
  durationSubtext = 'Durch 10x AI-Engineering beschleunigt',
  deliverable,
  location = 'Augsburg, München & DACH Remote',
  accentColor = 'blue',
  primaryCtaText,
  primaryCtaHref,
  secondaryCtaText,
  secondaryCtaHref,
} = Astro.props;

const colorMap = {
  blue: {
    border: 'border-meg-accent/30',
    badgeBg: 'bg-meg-accent/10 border-meg-accent/30 text-meg-accent',
    iconText: 'text-meg-accent',
    iconBg: 'bg-meg-accent/10 border-meg-accent/20',
    glow: 'from-meg-accent/10 to-sky-500/5',
  },
  purple: {
    border: 'border-violet-500/30',
    badgeBg: 'bg-violet-500/10 border-violet-500/30 text-violet-400',
    iconText: 'text-violet-400',
    iconBg: 'bg-violet-500/10 border-violet-500/20',
    glow: 'from-violet-500/10 to-fuchsia-500/5',
  },
  green: {
    border: 'border-emerald-500/30',
    badgeBg: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400',
    iconText: 'text-emerald-400',
    iconBg: 'bg-emerald-500/10 border-emerald-500/20',
    glow: 'from-emerald-500/10 to-teal-500/5',
  },
  orange: {
    border: 'border-orange-500/30',
    badgeBg: 'bg-orange-500/10 border-orange-500/30 text-orange-400',
    iconText: 'text-orange-400',
    iconBg: 'bg-orange-500/10 border-orange-500/20',
    glow: 'from-orange-500/10 to-amber-500/5',
  },
  rose: {
    border: 'border-rose-500/30',
    badgeBg: 'bg-rose-500/10 border-rose-500/30 text-rose-400',
    iconText: 'text-rose-400',
    iconBg: 'bg-rose-500/10 border-rose-500/20',
    glow: 'from-rose-500/10 to-pink-500/5',
  },
  yellow: {
    border: 'border-yellow-500/30',
    badgeBg: 'bg-yellow-500/10 border-yellow-500/30 text-yellow-400',
    iconText: 'text-yellow-400',
    iconBg: 'bg-yellow-500/10 border-yellow-500/20',
    glow: 'from-yellow-500/10 to-amber-500/5',
  },
  cyan: {
    border: 'border-cyan-500/30',
    badgeBg: 'bg-cyan-500/10 border-cyan-500/30 text-cyan-400',
    iconText: 'text-cyan-400',
    iconBg: 'bg-cyan-500/10 border-cyan-500/20',
    glow: 'from-cyan-500/10 to-sky-500/5',
  },
  indigo: {
    border: 'border-indigo-500/30',
    badgeBg: 'bg-indigo-500/10 border-indigo-500/30 text-indigo-400',
    iconText: 'text-indigo-400',
    iconBg: 'bg-indigo-500/10 border-indigo-500/20',
    glow: 'from-indigo-500/10 to-violet-500/5',
  },
};

const theme = colorMap[accentColor] || colorMap.blue;
const labels = {
  badge: 'Antwort zuerst · Preis, Dauer & Fakten auf einen Blick',
  price: 'Einstiegspreis / Kosten',
  duration: 'Typische Projektdauer',
  deliverable: 'Ergebnis & Lieferumfang',
  location: 'Einsatzgebiet & Modell',
  regionSub: 'Vor Ort & 100% Remote',
};
---

<section
  class="py-10 px-6 bg-meg-bg-dark border-b border-meg-border-dark/60"
  aria-label="Direktantwort zu Preis und Dauer"
  data-answer-first="true"
>
  <div class="mx-auto max-w-6xl">
    <div class={`relative overflow-hidden rounded-3xl bg-gradient-to-br ${theme.glow} bg-meg-surface-dark/70 backdrop-blur-xl border ${theme.border} p-6 sm:p-10 shadow-2xl`}>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
        <span class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border text-xs font-black uppercase tracking-wider ${theme.badgeBg}`}>
          <i class="fa-solid fa-bolt" aria-hidden="true"></i>
          {labels.badge}
        </span>
        <span class="text-xs font-semibold text-meg-text-secondary">
          <i class="fa-solid fa-circle-check text-emerald-400 mr-1.5" aria-hidden="true"></i>
          Direkt zitierfähig (SEO &amp; KI-Antworten) · Stand 2026
        </span>
      </div>

      <h2 class="text-xl sm:text-2xl font-black tracking-tight text-meg-text-primary-dark mb-3">
        {question}
      </h2>

      <!-- First paragraph explicitly answers query with Price & Duration for Google & AI Assistants -->
      <p class="text-base sm:text-lg text-meg-text-primary-dark/95 leading-relaxed mb-8 font-medium">
        {directAnswer}
      </p>

      <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="rounded-2xl bg-meg-bg-dark/80 border border-meg-border-dark p-4 flex flex-col justify-between">
          <dt class="flex items-center gap-2.5 mb-2 text-xs font-bold uppercase tracking-wider text-meg-text-secondary">
            <span class={`size-8 rounded-lg border flex items-center justify-center shrink-0 ${theme.iconBg} ${theme.iconText}`}>
              <i class="fa-solid fa-tag text-sm" aria-hidden="true"></i>
            </span>
            <span>{labels.price}</span>
          </dt>
          <dd>
            <span class="block text-xl font-black text-meg-text-primary-dark">{price}</span>
            <span class="block text-xs text-meg-text-secondary mt-1">{priceSubtext}</span>
          </dd>
        </div>

        <div class="rounded-2xl bg-meg-bg-dark/80 border border-meg-border-dark p-4 flex flex-col justify-between">
          <dt class="flex items-center gap-2.5 mb-2 text-xs font-bold uppercase tracking-wider text-meg-text-secondary">
            <span class={`size-8 rounded-lg border flex items-center justify-center shrink-0 ${theme.iconBg} ${theme.iconText}`}>
              <i class="fa-solid fa-stopwatch text-sm" aria-hidden="true"></i>
            </span>
            <span>{labels.duration}</span>
          </dt>
          <dd>
            <span class="block text-xl font-black text-meg-text-primary-dark">{duration}</span>
            <span class="block text-xs text-meg-text-secondary mt-1">{durationSubtext}</span>
          </dd>
        </div>

        <div class="rounded-2xl bg-meg-bg-dark/80 border border-meg-border-dark p-4 flex flex-col justify-between">
          <dt class="flex items-center gap-2.5 mb-2 text-xs font-bold uppercase tracking-wider text-meg-text-secondary">
            <span class={`size-8 rounded-lg border flex items-center justify-center shrink-0 ${theme.iconBg} ${theme.iconText}`}>
              <i class="fa-solid fa-boxes-stacked text-sm" aria-hidden="true"></i>
            </span>
            <span>{labels.deliverable}</span>
          </dt>
          <dd>
            <span class="block text-sm font-bold text-meg-text-primary-dark leading-snug">{deliverable}</span>
          </dd>
        </div>

        <div class="rounded-2xl bg-meg-bg-dark/80 border border-meg-border-dark p-4 flex flex-col justify-between">
          <dt class="flex items-center gap-2.5 mb-2 text-xs font-bold uppercase tracking-wider text-meg-text-secondary">
            <span class={`size-8 rounded-lg border flex items-center justify-center shrink-0 ${theme.iconBg} ${theme.iconText}`}>
              <i class="fa-solid fa-location-dot text-sm" aria-hidden="true"></i>
            </span>
            <span>{labels.location}</span>
          </dt>
          <dd>
            <span class="block text-sm font-bold text-meg-text-primary-dark">{location}</span>
            <span class="block text-xs text-meg-text-secondary mt-1">{labels.regionSub}</span>
          </dd>
        </div>
      </dl>

      {(primaryCtaText || secondaryCtaText) && (
        <div class="mt-6 pt-5 border-t border-meg-border-dark/60 flex flex-wrap items-center justify-between gap-4">
          <p class="text-xs text-meg-text-secondary">
            <i class="fa-solid fa-bolt text-emerald-400 mr-1.5" aria-hidden="true"></i>
            Kostenlose Ersteinschätzung mit konkretem Festpreis- oder Sprint-Angebot innerhalb von 24 Stunden.
          </p>
          <div class="flex flex-wrap gap-3">
            {primaryCtaText && primaryCtaHref && (
              <a
                href={primaryCtaHref}
                target={primaryCtaHref.startsWith('http') ? '_blank' : undefined}
                rel={primaryCtaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-meg-accent text-slate-950 font-black text-xs sm:text-sm hover:scale-[1.02] transition-all shadow-lg shadow-meg-accent/20"
              >
                <span>{primaryCtaText}</span>
                <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
              </a>
            )}
            {secondaryCtaText && secondaryCtaHref && (
              <a
                href={secondaryCtaHref}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-xs sm:text-sm hover:border-meg-accent/40 transition-all"
              >
                <span>{secondaryCtaText}</span>
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
