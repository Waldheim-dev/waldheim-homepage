---
// This code has been partially generated by an AI.
import type { Lang } from '../i18n/utils';
import { getProductInfo } from '../consts/productColors';

export interface Props {
  lang?: Lang;
}

const semrelInfo = getProductInfo('semrel')!;
const { lang = 'de' } = Astro.props;
const t = {
  de: {
    description:
      'semrel ist die zero-dependency Alternative zu semantic-release: eine statische Go-Binärdatei, die Conventional Commits auswertet, SemVer berechnet und Releases automatisiert, reproduzierbar und supply-chain-gesichert ausliefert.',
    releaseHeadline: `Kernversprechen & Neuerungen in v${semrelInfo.version}`,
    releaseHighlights: [
      'Kein Node.js, keine node_modules, kein Runtime-Overhead — eine einzige statische Go-Binärdatei.',
      'Reproduzierbar & Air-Gap ready: .semrel.lock mit SHA256-Prüfsummen und semrel plugin restore ohne ausgehende Netzwerkzugriffe.',
      'Supply-Chain Security by Default: Sigstore Cosign v3 (--bundle), CycloneDX/SPDX SBOM und SLSA Level 1 Provenance.',
      '8-stufige Pipeline (Condition, Analyzer, Generator, Updater, Packager, Publisher, Provider, Hook) inkl. Env-Var-Interpolation & Monorepo-Workspace.',
    ],
    btnGithub: 'GitHub öffnen',
    btnGithubLabel: 'semrel auf GitHub ansehen',
    btnDocs: 'Dokumentation',
    btnDocsLabel: 'semrel.io Dokumentation öffnen',
    btnContribute: 'Mitmachen',
    btnContributeLabel: 'Zum Mitmachen-Bereich springen',
    btnCaseStudy: 'Case Study',
    btnCaseStudyLabel: 'semrel Referenz & Case Study ansehen',
  },
  en: {
    description:
      'semrel is the zero-dependency alternative to semantic-release: one static Go binary that reads Conventional Commits, calculates SemVer and ships releases automatically, reproducibly and supply-chain secured.',
    releaseHeadline: `Core promises & What's new in v${semrelInfo.version}`,
    releaseHighlights: [
      'No Node.js, no node_modules, no runtime overhead — one single static Go binary.',
      'Reproducible & Air-gap ready: .semrel.lock with SHA256 verification and semrel plugin restore with zero outbound network calls.',
      'Supply-chain secure by default: Sigstore Cosign v3 (--bundle), CycloneDX/SPDX SBOMs and SLSA Level 1 provenance.',
      '8-stage pipeline (condition, analyzer, generator, updater, packager, publisher, provider, hook) with env-var interpolation & monorepo workspace.',
    ],
    btnGithub: 'Open on GitHub',
    btnGithubLabel: 'View semrel on GitHub',
    btnDocs: 'Documentation',
    btnDocsLabel: 'Open semrel.io Documentation',
    btnContribute: 'Contribute',
    btnContributeLabel: 'Jump to Contribute section',
    btnCaseStudy: 'Case Study',
    btnCaseStudyLabel: 'View semrel Case Study & Reference',
  },
}[lang];
const contributeHref = lang === 'en' ? '/en/semrel/#contribute' : '/semrel/#contribute';
---

<section class='relative isolate pt-14 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden'>
  <!-- Background ambient glow -->
  <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
    <div
      class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-blue-500/20 to-sky-400/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
      style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
  </div>

  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-4xl text-center'>

      <!-- Badges -->
      <div class='gsap-fadein mt-24 sm:mt-32 lg:mt-16 flex flex-wrap justify-center gap-3 mb-8'>
        <span class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-500/10 border border-blue-500/20 text-sm font-bold text-blue-400'>
          <i class="fa-brands fa-golang" aria-hidden="true"></i>
          Go-native
        </span>
        <span class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-blue-500/30 text-sm font-bold text-meg-text-primary-dark'>
          <i class="fa-solid fa-code-branch text-blue-400" aria-hidden="true"></i>
          v{semrelInfo.version} · Latest
        </span>
        <span class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-sm font-bold text-meg-text-secondary'>
          <i class="fa-solid fa-scale-balanced text-sky-400" aria-hidden="true"></i>
          Apache 2.0
        </span>
        <span class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-sm font-bold text-emerald-400'>
          <i class="fa-solid fa-people-group" aria-hidden="true"></i>
          Open for Contributors
        </span>
      </div>

      <!-- Headline -->
      <h1 class='gsap-fadein text-5xl md:text-8xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        semrel
      </h1>

      <p class='gsap-fadein text-2xl md:text-3xl font-bold mb-8' style='animation-delay: 0.3s'>
        <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-sky-400'>
          Semantic Releases. Fully Automated. Fully Open.
        </span>
      </p>

      <p class='gsap-fadein text-xl text-meg-text-secondary mb-12 max-w-3xl mx-auto leading-relaxed' style='animation-delay: 0.45s'>
        {t.description}
      </p>

      <div class='gsap-fadein mb-12 max-w-3xl mx-auto text-left bg-meg-surface-dark/50 border border-blue-500/20 rounded-2xl p-5' style='animation-delay: 0.52s'>
        <p class='text-sm font-black uppercase tracking-widest text-blue-400 mb-3'>{t.releaseHeadline}</p>
        <ul class='space-y-2 text-meg-text-secondary text-sm md:text-base'>
          {t.releaseHighlights.map((item) => (
            <li class='flex items-start gap-2'>
              <i class='fa-solid fa-circle-check text-emerald-400 mt-1' aria-hidden='true'></i>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTAs -->
      <div class='gsap-fadein flex flex-col sm:flex-row gap-4 justify-center items-center mb-16' style='animation-delay: 0.6s'>
        <a
          href='https://github.com/SemRels/semrel'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-blue-600 text-white font-bold text-lg hover:shadow-xl hover:shadow-blue-500/20 hover:scale-[1.02] transition-all'
          aria-label={t.btnGithubLabel}
        >
          <i class='fa-brands fa-github' aria-hidden='true'></i>
          {t.btnGithub}
        </a>
        <a
          href='https://www.semrel.io/'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg hover:border-blue-500/50 transition-all'
          aria-label={t.btnDocsLabel}
        >
          <i class='fa-solid fa-book' aria-hidden='true'></i>
          {t.btnDocs}
        </a>
        <a
          href={contributeHref}
          class='w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-bold text-lg hover:bg-emerald-500/20 transition-all'
          aria-label={t.btnContributeLabel}
        >
          <i class='fa-solid fa-hand-holding-heart' aria-hidden='true'></i>
          {t.btnContribute}
        </a>
        <a
          href='/referenzen/waldheim-dev/semrel/'
          class='w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-meg-surface-dark/80 border border-blue-500/30 text-blue-400 font-bold text-lg hover:bg-blue-500/10 transition-all'
          aria-label={t.btnCaseStudyLabel}
        >
          <i class='fa-solid fa-diagram-project' aria-hidden='true'></i>
          {t.btnCaseStudy}
        </a>
      </div>

      <!-- Trust indicators -->
      <div class='gsap-fadein flex flex-wrap justify-center gap-4 text-sm text-meg-text-secondary' style='animation-delay: 0.75s'>
        {[
          { icon: 'fa-shield-halved', text: 'Cosign v3 · SBOM · SLSA', color: 'text-blue-400' },
          { icon: 'fa-puzzle-piece', text: '30+ Plugins (.semrel.lock)', color: 'text-sky-400' },
          { icon: 'fa-diagram-project', text: 'Monorepo Workspace', color: 'text-blue-400' },
          { icon: 'fa-plane-slash', text: 'Air-Gap Ready', color: 'text-sky-400' },
          { icon: 'fa-certificate', text: 'OpenSSF Scorecard', color: 'text-blue-400' },
          { icon: 'fa-building-shield', text: 'Enterprise Adopters', color: 'text-emerald-400' },
        ].map(item => (
          <div class='flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl'>
            <i class={`fa-solid ${item.icon} ${item.color}`} aria-hidden='true'></i>
            <span class='font-semibold'>{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
