---
import Nav from './Nav.astro';

const date = new Date();

import fs from 'node:fs';
const version = JSON.parse(fs.readFileSync('./package.json')).version;

---

<footer class="bg-white dark:bg-slate-900" aria-labelledby="footer-heading">
	<h2 id="footer-heading" class="sr-only">Footer</h2>
	<div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
		<div class="xl:grid xl:grid-cols-3 xl:gap-8">
			<div class="space-y-8">

				<a href='/' class='-m-1.5 p-1.5 flex items-center gap-1'>
					<img class='h-8 w-auto hidden dark:block' src='/waldheim.dev.png' alt='Waldheim.dev' loading='lazy'>
					<img class='h-8 w-auto block dark:hidden' src='/waldheim.dev.dark.png' alt='Waldheim.dev' loading='lazy'>
					<span class='text-gray-800 dark:text-white'>Waldheim.dev</span>
				</a>
				<p class="text-sm leading-6 text-gray-700 dark:text-gray-300">Let`s build a better tomorrow, together</p>
				<div class="flex space-x-6">
					<a href='https://www.linkedin.com/in/markus-waldheim-03827a312/' target='_blank' title='LinkedIn' aria-label='LinkedIn' class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-200">
						<i class='fa-brands fa-linkedin'></i>
					</a>
					<a href='https://www.xing.com/profile/Markus_Waldheim/cv' target='_blank' title='Xing' aria-label='Xing' class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-200">
						<i class='fa-brands fa-xing'></i>
					</a>
					<a href='https://gitlab.com/mwaldheim' target='_blank' title='Gitlab' aria-label='Gitlab'  class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-200">
						<i class='fa-brands fa-gitlab'></i>
					</a>
					<a href='https://www.twitch.tv/blackbird995' target='_blank' title='Twitch' aria-label='Twitch' class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-200">
						<i class='fa-brands fa-twitch'></i>
					</a>
					<a href='https://twitter.com/my_codec' target='_blank' title='Twitter' aria-label='Twitter' class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-200">
						<i class='fa-brands fa-twitter'></i>
					</a>
					<a href='https://www.designenlassen.de/profil/622353' target='_blank' title='Designenlassen.de' aria-label='Designenlassen.de' class="text-gray-400 hover:text-gray-500 dark:text-gray-500 dark:hover:text-gray-200">
						<i class='fa-solid fa-pen-ruler'></i>
					</a>
				</div>
			</div>
			<div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
				<div class="md:grid md:grid-cols-2 md:gap-8">
					<div>
						<h3 class="text-sm font-semibold leading-6 text-slate-800 dark:text-white">Services</h3>
						<ul role="list" class="mt-6 space-y-4">
							<li>
								<a href="/services/entwicklung" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Entwicklung</a>
							</li>
							<li>
								<a href="/services/design" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Design / UX</a>
							</li>
							<li>
								<a href="/services/it-service" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">IT-Service</a>
							</li>
							<li>
								<a href="/services/devops" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Entwicklungsoptimierung</a>
							</li>
							<li>
								<a href="/services/verbandssoftware" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Verbandssoftware</a>
							</li>
						</ul>
					</div>
					<div class="mt-10 md:mt-0">
						<h3 class="text-sm font-semibold leading-6 text-slate-800 dark:text-white">Support</h3>
						<ul role="list" class="mt-6 space-y-4">
							<li>
								<a href="https://forestdesign.atlassian.net/servicedesk/customer/portals" class="text-sm flex gap-2 items-center leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Help Center <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
									<path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
									<path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
								</svg>
								</a>
							</li>
						</ul>
					</div>
				</div>
				<div class="md:grid md:grid-cols-2 md:gap-8">
					<div>
						<h3 class="text-sm font-semibold leading-6 text-slate-800 dark:text-white">Company</h3>
						<ul role="list" class="mt-6 space-y-4">
							<li>
								<a href="/ecodrive" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Ecodrive</a>
							</li>
							<li>
								<a href="/blog" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Blog</a>
							</li>
							<li>
								<a href="mailto:kontakt@waldheim.dev" class="text-sm flex gap-2 items-center leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Bug melden <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
									<path d="M2.5 3A1.5 1.5 0 0 0 1 4.5v.793c.026.009.051.02.076.032L7.674 8.51c.206.1.446.1.652 0l6.598-3.185A.755.755 0 0 1 15 5.293V4.5A1.5 1.5 0 0 0 13.5 3h-11Z" />
									<path d="M15 6.954 8.978 9.86a2.25 2.25 0 0 1-1.956 0L1 6.954V11.5A1.5 1.5 0 0 0 2.5 13h11a1.5 1.5 0 0 0 1.5-1.5V6.954Z" />
								</svg>
								</a>
							</li>
							<li>
								<a href="https://www.waldheim-it.de/" target='_blank' class="text-sm flex gap-2 items-center leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Waldheim IT-Beratung <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
									<path d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
									<path d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
								</svg>
								</a>
							</li>
						</ul>
					</div>
					<div class="mt-10 md:mt-0">
						<h3 class="text-sm font-semibold leading-6 text-slate-800 dark:text-white">Rechtliches</h3>
						<ul role="list" class="mt-6 space-y-4">
							<li>
								<a href="/privacy" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Datenschutz</a>
							</li>
							<li>
								<a href="/imprint" class="text-sm leading-6 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Impressum</a>
							</li>
							<li>
								<button type="button" data-cc="show-preferencesModal" class="text-sm leading-6 inline-flex gap-1 items-center text-left justify-start text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white">Manage Cookie Einstellungen <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
									<path d="M6.5 2.25a.75.75 0 0 0-1.5 0v3a.75.75 0 0 0 1.5 0V4.5h6.75a.75.75 0 0 0 0-1.5H6.5v-.75ZM11 6.5a.75.75 0 0 0-1.5 0v3a.75.75 0 0 0 1.5 0v-.75h2.25a.75.75 0 0 0 0-1.5H11V6.5ZM5.75 10a.75.75 0 0 1 .75.75v.75h6.75a.75.75 0 0 1 0 1.5H6.5v.75a.75.75 0 0 1-1.5 0v-3a.75.75 0 0 1 .75-.75ZM2.75 7.25H8.5v1.5H2.75a.75.75 0 0 1 0-1.5ZM4 3H2.75a.75.75 0 0 0 0 1.5H4V3ZM2.75 11.5H4V13H2.75a.75.75 0 0 1 0-1.5Z" />
								</svg>
								</button>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<div class="mt-16 border-t border-gray-900/10 dark:border-white/10 pt-8 sm:mt-20 lg:mt-24 flex justify-between items-center">
			<p class="text-xs leading-5 text-gray-600 dark:text-gray-400">&copy; {date.getFullYear()} Waldheim.dev. Alle Rechte vorbehalten.</p>

			<span
				class='inline-flex items-center gap-x-1.5 rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-100/60 dark:text-emerald-800'>
        <svg class="animate-pulse h-1.5 w-1.5 fill-emerald-500 dark:fill-emerald-700/95" viewBox="0 0 6 6" aria-hidden="true">
          <circle cx="3" cy="3" r="3" />
        </svg>
        v{version}
      </span>
		</div>
	</div>
</footer>
