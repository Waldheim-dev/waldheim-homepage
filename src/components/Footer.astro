---
const date = new Date();

import fs from 'node:fs';
const version = JSON.parse(fs.readFileSync('./package.json')).version;
---

<footer class="bg-primary-800 text-light-100" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">

        <a href="/" class="-m-1.5 p-1.5 flex items-center gap-1 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
          <img class="h-8 w-auto" src="/waldheim.dev.png" alt="Waldheim.dev Footer Logo" loading="lazy">
          <span class="">Waldheim.dev</span>
        </a>
        <p class="text-sm leading-4">Let`s build a better tomorrow, together</p>
        <div class="flex space-x-6">
          <a href="https://www.linkedin.com/in/markus-waldheim-03827a312/" target="_blank" title="LinkedIn"
             aria-label="LinkedIn"
             class="hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            <i class="fa-brands fa-linkedin"></i>
          </a>
          <a href="https://www.xing.com/profile/Markus_Waldheim/cv" target="_blank" title="Xing" aria-label="Xing"
             class="hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            <i class="fa-brands fa-xing"></i>
          </a>
          <a href="https://gitlab.com/mwaldheim" target="_blank" title="Gitlab" aria-label="Gitlab"
             class="hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            <i class="fa-brands fa-gitlab"></i>
          </a>
          <a href="https://github.com/Waldheim-dev" target="_blank" title="GitHub" aria-label="GitHub"
             class="hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            <i class="fa-brands fa-github"></i>
          </a>
          <a href="https://www.twitch.tv/blackbird995" target="_blank" title="Twitch" aria-label="Twitch"
             class="hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            <i class="fa-brands fa-twitch"></i>
          </a>
          <a href="https://twitter.com/my_codec" target="_blank" title="Twitter" aria-label="Twitter"
             class="hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            <i class="fa-brands fa-twitter"></i>
          </a>
          <a href="https://www.designenlassen.de/profil/622353" target="_blank" title="Designenlassen.de"
             aria-label="Designenlassen.de"
             class="hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
            <i class="fa-solid fa-pen-ruler"></i>
          </a>
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-bold leading-4">Service & Produkte</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/ecodrive/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Ecodrive</a>
              </li>
              <li>
                <a href="/services/entwicklung/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Entwicklung</a>
              </li>
              <li>
                <a href="/services/design/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Design
                  / UX</a>
              </li>
              <li>
                <a href="/services/it-service/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">IT-Service</a>
              </li>
              <li>
                <a href="/services/devops/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Entwicklungsoptimierung</a>
              </li>
              <li>
                <a href="/services/smarthome/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Smarthome</a>
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-bold leading-4">Ecodrive</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="https://www.eco-drive.app"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Zu Ecodrive
                  <i class="fa-solid fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i>
                </a>
              </li>
            </ul>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/ecodrive/"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Über Ecodrive
                </a>
              </li>
              <li>
                <a href="https://billing.stripe.com/p/login/9AQ6s7gS4aC981ifYY"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Ecodrive
                  Kundenportal
                  <i class="fa-solid fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i>
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-bold leading-4">Firma</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="https://climate.stripe.com/1QAkEH" target="_blank"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Climate-Programm
                  <i class="fa-solid fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i>
                </a>
              </li>
              <li>
                <a href="/blog/1/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start focus-visible:outline-2 rounded focus-visible:outline-offset-2 focus-visible:outline-blue-500">Blog</a>
              </li>
              <li>
                <a href="mailto:kontakt@waldheim.dev"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Bug
                  melden
                  <i class="fa-solid fa-envelope text-sm" aria-hidden="true"></i>
                </a>
              </li>
              <li>
                <a href="https://www.waldheim-it.de/" target="_blank"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Waldheim
                  IT-Beratung
                  <i class="fa-solid fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i>
                </a>
              </li>
            </ul>
            <h3 class="text-sm font-bold leading-4 mt-4">Support</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="https://forestdesign.atlassian.net/servicedesk/customer/portals"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Help
                  Center
                  <i class="fa-solid fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i>
                </a>
              </li>
              <li>
                <a href="https://billing.stripe.com/p/login/9AQ6s7gS4aC981ifYY"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Ecodrive
                  Kundenportal
                  <i class="fa-solid fa-arrow-up-right-from-square text-sm" aria-hidden="true"></i>
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-bold leading-4">Rechtliches</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/datenschutz/"
                   class="text-sm leading-4 focus-visible:outline-2 rounded focus-visible:outline-offset-2 focus-visible:outline-blue-500">Datenschutz</a>
              </li>
              <li>
                <a href="/impressum/"
                   class="text-sm leading-4 focus-visible:outline-2 rounded focus-visible:outline-offset-2 focus-visible:outline-blue-500">Impressum</a>
              </li>
              <li>
                <button type="button" data-cc="show-preferencesModal"
                        class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">
                  Manage Cookie Einstellungen
                  <i class="fa-solid fa-sliders text-sm" aria-hidden="true"></i>
                </button>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div
      class="mt-16 border-t border-gray-900/10 pt-8 sm:mt-20 lg:mt-24 flex flex-col md:flex-row md:justify-between md:items-center">
      <p class="text-xs leading-5">&copy; {date.getFullYear()} Waldheim.dev. Alle
        Rechte vorbehalten.</p>

      <span class="text-xs flex flex-row items-center gap-2">
      <span
        class="inline-flex items-center gap-x-1.5 rounded-md bg-primary-800 px-2 py-1 text-xs font-medium text-light-100">
        <i class="fa-solid fa-circle text-light-100 text-[6px]" aria-hidden="true"></i>
        v{version}
      </span>
        <span></span>Design und Entwicklung sponsored by <a href="https://www.waldheim.dev" class="text-underline hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500">Waldheim.dev</a></span>
        </span>
    </div>
  </div>
</footer>
