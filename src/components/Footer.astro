---
const date = new Date();
import fs from 'node:fs';

let version = '0.0.0';
try {
  version = JSON.parse(fs.readFileSync('./package.json').toString()).version;
} catch (e) {}
---

<footer class="bg-meg-surface-dark/80 backdrop-blur-xl border-t border-meg-border-dark text-meg-text-primary-dark" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 lg:px-8">
    
    <!-- Trust Area: Autoritäts-Signale -->
    <div class="mb-16 flex flex-wrap justify-center md:justify-between items-center gap-8 border-b border-meg-border-dark/50 pb-12">
      <div class="flex items-center gap-4 group">
        <div class="size-12 bg-meg-accent/10 border border-meg-accent/20 rounded-xl flex items-center justify-center text-meg-accent group-hover:bg-meg-accent/20 transition-all">
          <i class="fa-solid fa-award text-xl"></i>
        </div>
        <div>
          <span class="block text-[10px] font-black uppercase tracking-widest text-meg-accent">Professional</span>
          <span class="block text-sm font-bold">Scrum Master II</span>
        </div>
      </div>
      <div class="flex items-center gap-4 group">
        <div class="size-12 bg-meg-accent/10 border border-meg-accent/20 rounded-xl flex items-center justify-center text-meg-accent group-hover:bg-meg-accent/20 transition-all">
          <i class="fa-solid fa-graduation-cap text-xl"></i>
        </div>
        <div>
          <span class="block text-[10px] font-black uppercase tracking-widest text-meg-accent">Zertifizierter</span>
          <span class="block text-sm font-bold">IHK Ausbilder</span>
        </div>
      </div>
      <div class="flex items-center gap-4 group">
        <div class="size-12 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center text-emerald-400 group-hover:bg-emerald-500/20 transition-all">
          <i class="fa-solid fa-shield-halved text-xl"></i>
        </div>
        <div>
          <span class="block text-[10px] font-black uppercase tracking-widest text-emerald-400">100% DSGVO</span>
          <span class="block text-sm font-bold">Safe & Secure</span>
        </div>
      </div>
      <div class="hidden lg:flex items-center gap-4 group">
        <div class="size-12 bg-meg-accent/10 border border-meg-accent/20 rounded-xl flex items-center justify-center text-meg-accent">
          <i class="fa-solid fa-code text-xl"></i>
        </div>
        <div>
          <span class="block text-[10px] font-black uppercase tracking-widest text-meg-accent">10+ Jahre</span>
          <span class="block text-sm font-bold">IT-Expertise</span>
        </div>
      </div>
    </div>

    <div class="space-y-12">
      <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
        <div class="space-y-4">
          <a href="/" class="-m-1.5 inline-flex items-center gap-2 rounded-lg p-1.5 hover:bg-meg-surface-dark/50 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">
            <img class="h-8 w-auto transition-transform hover:scale-105" src="/waldheim.dev.png" alt="Waldheim.dev Footer Logo" loading="lazy" width="32" height="32">
            <span class="font-bold tracking-tight">Waldheim.dev</span>
          </a>
          <p class="text-sm leading-5 text-meg-text-secondary">Let&apos;s build a better tomorrow, together</p>
        </div>

        <!-- Social Media Links (Komplette Liste wiederhergestellt) -->
        <div class="flex flex-wrap gap-x-4 gap-y-4 sm:justify-end">
          {[
            { href: 'https://www.linkedin.com/in/markus-waldheim-03827a312/', icon: 'fa-brands fa-linkedin', color: 'hover:text-[#0a66c2]', label: 'LinkedIn' },
            { href: 'https://www.xing.com/profile/Markus_Waldheim/cv', icon: 'fa-brands fa-xing', color: 'hover:text-[#006567]', label: 'Xing' },
            { href: 'https://github.com/Waldheim-dev', icon: 'fa-brands fa-github', color: 'hover:text-white', label: 'GitHub' },
            { href: 'https://gitlab.com/mwaldheim', icon: 'fa-brands fa-gitlab', color: 'hover:text-[#fc6d26]', label: 'GitLab' },
            { href: 'https://www.twitch.tv/blackbird995', icon: 'fa-brands fa-twitch', color: 'hover:text-[#9146ff]', label: 'Twitch' },
            { href: 'https://www.designenlassen.de/profil/622353', icon: 'fa-solid fa-pen-ruler', color: 'hover:text-meg-accent', label: 'Designenlassen' },
            { href: 'mailto:kontakt@waldheim.dev', icon: 'fa-solid fa-envelope', color: 'hover:text-meg-accent', label: 'E-Mail' }
          ].map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
               class={`inline-flex h-12 w-12 items-center justify-center rounded-xl border border-meg-border-dark/70 bg-meg-surface-dark/60 p-2 text-meg-text-secondary transition-all hover:scale-110 hover:border-meg-accent/50 ${s.color}`}>
              <i class={`${s.icon} text-2xl`} aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>

      <!-- Footer Nav Grid -->
      <div class="grid grid-cols-2 gap-12 md:grid-cols-3 lg:grid-cols-5 border-t border-meg-border-dark/50 pt-12">
        <div>
          <h3 class="text-xs font-black uppercase tracking-[0.2em] text-meg-text-primary-dark mb-6">IT-Consulting</h3>
          <ul class="space-y-4">
            <li><a href="/services/devsecops/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">DevSecOps</a></li>
            <li><a href="/services/entwicklung/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Entwicklung</a></li>
            <li><a href="/services/design/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">UI/UX Design</a></li>
            <li><a href="/services/it-service/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">IT-Service</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-black uppercase tracking-[0.2em] text-meg-text-primary-dark mb-6">SaaS Suite</h3>
          <ul class="space-y-4">
            <li><a href="/suite/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Übersicht</a></li>
            <li><a href="/suite/socialverse/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Socialverse CRM</a></li>
            <li><a href="/suite/forge/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Forge ERP</a></li>
            <li><a href="/suite/preise/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Preise</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-black uppercase tracking-[0.2em] text-meg-text-primary-dark mb-6">Open Source</h3>
          <ul class="space-y-4">
            <li><a href="/waetherapp/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">WetterApp</a></li>
            <li><a href="/amigo/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Amigo Framework</a></li>
            <li><a href="/obsidian-gemini-agent/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Obsidian Plugin</a></li>
            <li><a href="/ausgabeschein-generator/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Ausgabeschein</a></li>
            <li><a href="/astro-ai-llms-txt/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">llms.txt Plugin</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-black uppercase tracking-[0.2em] text-meg-text-primary-dark mb-6">Firma</h3>
          <ul class="space-y-4">
            <li><a href="/ueber-mich/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Über mich</a></li>
            <li><a href="/blog/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">IT-Blog</a></li>
            <li><a href="/referenzen/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Referenzen</a></li>
            <li><a href="/kontakt/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors font-bold">Kontakt</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-black uppercase tracking-[0.2em] text-meg-text-primary-dark mb-6">Rechtliches</h3>
          <ul class="space-y-4">
            <li><a href="/impressum/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Impressum</a></li>
            <li><a href="/datenschutz/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Datenschutz</a></li>
            <li><a href="/agb/" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">AGB</a></li>
            <li><button type="button" data-cc="show-preferencesModal" class="text-sm text-meg-text-secondary hover:text-meg-accent transition-colors">Cookies</button></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-meg-border-dark/50 flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-4">
        <img class="h-6 w-auto opacity-50 grayscale" src="/waldheim.dev.png" alt="Logo" loading="lazy">
        <p class="text-[10px] font-bold text-meg-text-secondary uppercase tracking-widest">
          &copy; {date.getFullYear()} Waldheim.dev &middot; Augsburg &middot; v{version}
        </p>
      </div>
      <p class="text-[10px] text-meg-text-secondary font-medium">Design & Entwicklung by <a href="https://waldheim.dev" class="underline hover:text-meg-accent">Waldheim.dev</a></p>
    </div>
  </div>
</footer>