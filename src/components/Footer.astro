    <div
      class="mt-16 border-t border-meg-border-dark pt-8 sm:mt-20 lg:mt-24 flex flex-col md:flex-row md:justify-between md:items-center">
      <p class="text-xs leading-5 text-meg-text-secondary">&copy; {date.getFullYear()} Waldheim.dev. Alle
        Rechte vorbehalten.</p>

      <span class="text-xs flex flex-row items-center gap-2 mt-4 md:mt-0">
      <span
