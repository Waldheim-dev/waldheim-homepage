---
const date = new Date();

import fs from 'node:fs';
let version = '0.0.0';
try {
  const pkg = JSON.parse(fs.readFileSync('./package.json').toString());
  version = pkg.version;
} catch (e) {
  console.error('Could not read package.json version');
}
---

<footer class="bg-meg-surface-dark/80 backdrop-blur-xl border-t border-meg-border-dark text-meg-text-primary-dark" aria-labelledby="footer-heading">
