---
const date = new Date();

import fs from 'node:fs';
const version = JSON.parse(fs.readFileSync('./package.json')).version;
---

<footer class="bg-primary-900 text-light-100" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="mx-auto max-w-7xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-32">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">
      <div class="space-y-8">

        <a href="/" class="-m-1.5 p-1.5 flex items-center gap-1 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
          <img class="h-8 w-auto" src="/waldheim.dev.png" alt="Waldheim.dev Footer Logo" loading="lazy">
          <span class="">Waldheim.dev</span>
        </a>
        <p class="text-sm leading-4">Let`s build a better tomorrow, together</p>
        <div class="flex space-x-6">
          <a href="https://www.linkedin.com/in/markus-waldheim-03827a312/" target="_blank" title="LinkedIn"
             aria-label="LinkedIn"
             class="hover:text-pancho-100 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            <i class="fa-brands fa-linkedin"></i>
          </a>
          <a href="https://www.xing.com/profile/Markus_Waldheim/cv" target="_blank" title="Xing" aria-label="Xing"
             class="hover:text-pancho-100 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            <i class="fa-brands fa-xing"></i>
          </a>
          <a href="https://gitlab.com/mwaldheim" target="_blank" title="Gitlab" aria-label="Gitlab"
             class="hover:text-pancho-100 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            <i class="fa-brands fa-gitlab"></i>
          </a>
          <a href="https://www.twitch.tv/blackbird995" target="_blank" title="Twitch" aria-label="Twitch"
             class="hover:text-pancho-100 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            <i class="fa-brands fa-twitch"></i>
          </a>
          <a href="https://twitter.com/my_codec" target="_blank" title="Twitter" aria-label="Twitter"
             class="hover:text-pancho-100 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            <i class="fa-brands fa-twitter"></i>
          </a>
          <a href="https://www.designenlassen.de/profil/622353" target="_blank" title="Designenlassen.de"
             aria-label="Designenlassen.de"
             class="hover:text-pancho-100 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
            <i class="fa-solid fa-pen-ruler"></i>
          </a>
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-bold leading-4">Service & Produkte</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/ecodrive/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Ecodrive</a>
              </li>
              <li>
                <a href="/services/entwicklung/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Entwicklung</a>
              </li>
              <li>
                <a href="/services/design/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Design
                  / UX</a>
              </li>
              <li>
                <a href="/services/it-service/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">IT-Service</a>
              </li>
              <li>
                <a href="/services/devops/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Entwicklungsoptimierung</a>
              </li>
              <li>
                <a href="/services/smarthome/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Smarthome</a>
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-bold leading-4">Ecodrive</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="https://www.eco-drive.app"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Zu Ecodrive
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                    <path
                      d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                  </svg>
                </a>
              </li>
            </ul>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/ecodrive/"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Über Ecodrive
                </a>
              </li>
              <li>
                <a href="https://billing.stripe.com/p/login/9AQ6s7gS4aC981ifYY"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Ecodrive
                  Kundenportal
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                    <path
                      d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                  </svg>
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-bold leading-4">Firma</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="https://climate.stripe.com/1QAkEH" target="_blank"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Climate-Programm
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                    <path
                      d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                  </svg>
                </a>
              </li>
              <li>
                <a href="/blog/1/"
                   class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start focus-visible:outline-2 rounded focus-visible:outline-offset-2 focus-visible:outline-primary-600">Blog</a>
              </li>
              <li>
                <a href="mailto:kontakt@waldheim.dev"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Bug
                  melden
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M2.5 3A1.5 1.5 0 0 0 1 4.5v.793c.026.009.051.02.076.032L7.674 8.51c.206.1.446.1.652 0l6.598-3.185A.755.755 0 0 1 15 5.293V4.5A1.5 1.5 0 0 0 13.5 3h-11Z" />
                    <path
                      d="M15 6.954 8.978 9.86a2.25 2.25 0 0 1-1.956 0L1 6.954V11.5A1.5 1.5 0 0 0 2.5 13h11a1.5 1.5 0 0 0 1.5-1.5V6.954Z" />
                  </svg>
                </a>
              </li>
              <li>
                <a href="https://www.waldheim-it.de/" target="_blank"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Waldheim
                  IT-Beratung
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                    <path
                      d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                  </svg>
                </a>
              </li>
            </ul>
            <h3 class="text-sm font-bold leading-4 mt-4">Support</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="https://forestdesign.atlassian.net/servicedesk/customer/portals"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Help
                  Center
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                    <path
                      d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                  </svg>
                </a>
              </li>
              <li>
                <a href="https://billing.stripe.com/p/login/9AQ6s7gS4aC981ifYY"
                   class="text-sm inline-flex gap-2 items-center text-left justify-start leading-4 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Ecodrive
                  Kundenportal
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M6.22 8.72a.75.75 0 0 0 1.06 1.06l5.22-5.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5a.75.75 0 0 0 0 1.5h1.69L6.22 8.72Z" />
                    <path
                      d="M3.5 6.75c0-.69.56-1.25 1.25-1.25H7A.75.75 0 0 0 7 4H4.75A2.75 2.75 0 0 0 2 6.75v4.5A2.75 2.75 0 0 0 4.75 14h4.5A2.75 2.75 0 0 0 12 11.25V9a.75.75 0 0 0-1.5 0v2.25c0 .69-.56 1.25-1.25 1.25h-4.5c-.69 0-1.25-.56-1.25-1.25v-4.5Z" />
                  </svg>
                </a>
              </li>
            </ul>
          </div>
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-bold leading-4">Rechtliches</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li>
                <a href="/datenschutz/"
                   class="text-sm leading-4 focus-visible:outline-2 rounded focus-visible:outline-offset-2 focus-visible:outline-primary-600">Datenschutz</a>
              </li>
              <li>
                <a href="/impressum/"
                   class="text-sm leading-4 focus-visible:outline-2 rounded focus-visible:outline-offset-2 focus-visible:outline-primary-600">Impressum</a>
              </li>
              <li>
                <button type="button" data-cc="show-preferencesModal"
                        class="text-sm leading-4 inline-flex gap-2 items-center text-left justify-start rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">
                  Manage Cookie Einstellungen
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-4 h-4">
                    <path
                      d="M6.5 2.25a.75.75 0 0 0-1.5 0v3a.75.75 0 0 0 1.5 0V4.5h6.75a.75.75 0 0 0 0-1.5H6.5v-.75ZM11 6.5a.75.75 0 0 0-1.5 0v3a.75.75 0 0 0 1.5 0v-.75h2.25a.75.75 0 0 0 0-1.5H11V6.5ZM5.75 10a.75.75 0 0 1 .75.75v.75h6.75a.75.75 0 0 1 0 1.5H6.5v.75a.75.75 0 0 1-1.5 0v-3a.75.75 0 0 1 .75-.75ZM2.75 7.25H8.5v1.5H2.75a.75.75 0 0 1 0-1.5ZM4 3H2.75a.75.75 0 0 0 0 1.5H4V3ZM2.75 11.5H4V13H2.75a.75.75 0 0 1 0-1.5Z" />
                  </svg>
                </button>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
    <div
      class="mt-16 border-t border-gray-900/10 pt-8 sm:mt-20 lg:mt-24 flex flex-col md:flex-row md:justify-between md:items-center">
      <p class="text-xs leading-5">&copy; {date.getFullYear()} Waldheim.dev. Alle
        Rechte vorbehalten.</p>

      <span class="text-xs flex flex-row items-center gap-2">
      <span
        class="inline-flex items-center gap-x-1.5 rounded-md bg-primary-700 px-2 py-1 text-xs font-medium text-light-100">
        <svg class="h-1.5 w-1.5 fill-light-100" viewBox="0 0 6 6" aria-hidden="true">
          <circle cx="3" cy="3" r="3" />
        </svg>
        v{version}
      </span>
        <span></span>Design und Entwicklung sponsored by <a href="https://www.waldheim.dev" class="text-underline hover:text-light-300 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">Waldheim.dev</a></span>
        </span>
    </div>
  </div>
</footer>
