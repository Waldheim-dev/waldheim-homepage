
---
const { className, label, placeholder = null, name, isRequired = false, autocomplete=null } = Astro.props;
---
<div class={ className }>
    <label
        for={ name }
        class="block text-sm font-semibold text-white"
        >{ label }
        { isRequired ? (<span class="text-rose-400">*</span>) : null }</label
    >
    <div class="mt-2.5">
            <input
                type="text"
                name={ name }
                id={ name }
                autocomplete={ autocomplete }
                required={ isRequired }
                class="block w-full rounded-xl bg-dark-800 border border-light-500/20 px-4 py-3 text-base text-white placeholder:text-light-500/40 focus:border-blue-500/40 focus:bg-dark-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 transition-all duration-300"
                placeholder={placeholder}
            />
    </div>
</div>