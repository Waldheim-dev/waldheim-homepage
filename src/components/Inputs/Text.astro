
---
const { className, label, placeholder = null, name, isRequired = false, autocomplete=null } = Astro.props;
---
<div class={ className }>
    <label
        for={ name }
        class="block text-sm/6 font-semibold text-gray-100 "
        >{ label }
        { isRequired ? (<span class="text-rose-600"
        >*</span
    >) : null }</label
    >
    <div class="mt-2.5">
            <input
                type="text"
                name={ name }
                id={ name }
                autocomplete={ autocomplete }
                required={ isRequired }
                class="block w-full rounded-md  px-3.5 py-2 text-base text-gray-100 placeholder:text-primary-600/40 outline-1 -outline-offset-1 outline-gray-300  invalide:outline-rose-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
                placeholder={placeholder}
            />
    </div>
</div>