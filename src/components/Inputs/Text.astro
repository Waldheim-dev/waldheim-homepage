
---
const { className, label, placeholder = null, name, isRequired = false, autocomplete=null } = Astro.props;
---
<div class={ className }>
    <label
        for={ name }
        class="block text-sm/6 font-semibold text-gray-900 dark:text-white"
        >{ label }
        { isRequired ? (<span class="text-rose-600"
        >*</span
    >) : null }</label
    >
    <div class="mt-2.5">
        <div
            class="flex bg-white dark:bg-slate-900 rounded-md bg-transparent outline outline-1 -outline-offset-1 outline-gray-300 dark:outline-slate-600 has-[input:focus-within]:outline has-[input:focus-within]:outline-2 has-[input:focus-within]:-outline-offset-2 has-[input:focus-within]:outline-emerald-600"
        >
            <input
                type="text"
                name={ name }
                id={ name }
                autocomplete={ autocomplete }
                required={ isRequired }
                class="block min-w-0 grow py-1.5 pl-1 pr-3 text-base text-gray-900 dark:text-white placeholder:text-gray-400 focus:outline focus:outline-0 sm:text-sm/6"
                placeholder={placeholder}
            />
        </div>
    </div>
</div>