---
const {
    className,
    label,
    placeholder = null,
    name,
    isRequired = false,
    autocomplete = null,
    rows = 4,
} = Astro.props;
---

<div class={className}>
    <label
        for={name}
        class="block text-sm font-bold text-meg-text-primary-dark uppercase tracking-widest opacity-70"
        >{label}
        {isRequired ? <span class="text-rose-400 font-black ml-1">*</span> : null}</label
    >
    <div class="mt-2">
        <textarea
            name={name}
            id={name}
            autocomplete={autocomplete}
            required={isRequired}
            placeholder={placeholder}
            rows={rows}
            class="block w-full rounded-xl bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-3 text-base text-meg-text-primary-dark placeholder:text-meg-text-secondary placeholder:opacity-40 focus:border-meg-accent/50 focus:bg-meg-surface-dark focus:ring-4 focus:ring-meg-accent/10 focus:outline-none transition-all duration-300"
        ></textarea>
    </div>
</div>
