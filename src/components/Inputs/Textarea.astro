---
const {
    className,
    label,
    placeholder = null,
    name,
    isRequired = false,
    autocomplete = null,
    rows = 4,
} = Astro.props;
---

<div class={className}>
    <label
        for={name}
        class="block text-sm/6 font-semibold text-gray-900 dark:text-white"
        >{label}
        {isRequired ? <span class="text-rose-600">*</span> : null}</label
    >
    <div class="mt-2.5">
        <textarea
            name={name}
            id={name}
            autocomplete={autocomplete}
            required={isRequired}
            placeholder={placeholder}
            rows={rows}
            class="block w-full rounded-md bg-white bg-white dark:bg-slate-900 px-3.5 py-2 text-base text-gray-900 dark:text-white outline outline-1 -outline-offset-1 outline-gray-300 dark:outline-slate-600 invalide:outline-rose-600 dark:invalide:outline-rose-600 placeholder:text-gray-400 focus:outline focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600"
        ></textarea>
    </div>
</div>
