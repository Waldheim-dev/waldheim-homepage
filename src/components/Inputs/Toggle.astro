---
// This code has been partially generated by an AI.
const {
    className,
    label,
    name,
    isRequired = false,
    autocomplete = null,
} = Astro.props;
---

<label
    class={'flex gap-x-4 cursor-pointer group ' + (className ?? '')}
    for={name}
>
    <div class="flex h-6 items-center">
        <input
            type="checkbox"
            name={name}
            id={name}
            autocomplete={autocomplete}
            required={isRequired}
            role="switch"
            aria-label={label}
            class="peer sr-only"
        />
        <span
            aria-hidden="true"
            class="relative h-6 w-10 flex-none rounded-full border border-meg-border-dark bg-meg-surface-dark shadow-inner transition-colors duration-300 peer-checked:bg-meg-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-meg-accent after:absolute after:left-1 after:top-1/2 after:size-4 after:-translate-y-1/2 after:rounded-full after:bg-white after:shadow-md after:ring-1 after:ring-meg-border-dark after:transition-transform after:duration-300 after:ease-in-out peer-checked:after:translate-x-4"
        ></span>
    </div>
    <span class="text-sm font-medium text-meg-text-secondary group-hover:text-meg-text-primary-dark transition-colors leading-6">
        <slot />
    </span>
</label>