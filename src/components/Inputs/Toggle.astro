---
const {
    className,
    label,
    name,
    isRequired = false,
    autocomplete = null,
} = Astro.props;
---

<label
    class={'flex gap-x-4 cursor-pointer group ' + className}
    for={name}
>
    <div class="flex h-6 items-center">
        <button
            type="button"
            class="flex w-10 flex-none rounded-full cursor-pointer bg-meg-surface-dark border border-meg-border-dark p-1 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent peer-checked:bg-meg-accent shadow-inner"
            role="switch"
            aria-checked="false"
            onclick="toggleButton(this)"
        >
            <input
                type="checkbox"
                name={name}
                id={name}
                autocomplete={autocomplete}
                required={isRequired}
                class="hidden peer"
                aria-hidden="true"
            />
            <span class="sr-only">{label}</span>
            <span
                aria-hidden="true"
                class="size-4 peer-checked:translate-x-4 translate-x-0 transform rounded-full bg-white shadow-md ring-1 ring-meg-border-dark transition-transform duration-300 ease-in-out"
            ></span>
        </button>
    </div>
    <span class="text-sm font-medium text-meg-text-secondary group-hover:text-meg-text-primary-dark transition-colors leading-6">
        <slot />
    </span>
</label>

<script is:inline>
  const toggleButton = (context) => {
    const wrapper = context;
    if (wrapper) {
      const input = wrapper.querySelector('input');
      if (input) {
        input.click()
      }
    }
  }
</script>