---
const {
    className,
    label,
    name,
    isRequired = false,
    autocomplete = null,
} = Astro.props;
---

<label
    class={'flex gap-x-4 cursor-pointer ' + className}
    for={name}
    (click)={(e: MouseEvent) => {
        console.log(e);
    }}
>
    <div class="flex h-6 items-center group">
        <!-- Enabled: "bg-blue-500", Not Enabled: "bg-dark-800" -->
        <button
            type="button"
            class="flex w-8 flex-none rounded-full cursor-pointer bg-dark-800 border border-light-500/20 has-checked:bg-gradient-to-r has-checked:from-blue-500 has-checked:to-purple-600 p-px transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
            role="switch"
            aria-checked="false"
            onclick="toggleButton(this)"
        >
            <input
                type="checkbox"
                name={name}
                id={name}
                autocomplete={autocomplete}
                required={isRequired}
                class="hidden peer"
                aria-hidden="true"
            />
            <span class="sr-only">{label}</span>
            <!-- Enabled: "translate-x-3.5", Not Enabled: "translate-x-0" -->
            <span
                aria-hidden="true"
                class="size-4 peer-checked:translate-x-3.5 transform rounded-full bg-white shadow-lg transition duration-300 ease-in-out"
            ></span>
        </button>
    </div><span class="text-sm text-light-300">
        <slot />
    </span>
</label>

<script is:inline>
  const toggleButton = (context) => {
    const wrapper = context;
    if (wrapper) {
      const input = wrapper.querySelector('input');
      if (input) {
        input.click()
      }
    }
  }
</script>