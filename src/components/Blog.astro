---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
const { blog, limits } = Astro.props;
const blogPosts = blog ?? await getCollection('blog');

// sort by date
blogPosts.sort((a: any, b: any) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
if (limits) {
  blogPosts.length = Math.min(blogPosts.length, limits);
}

---

<div class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center gsap-fadein">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl mb-4">
        IT-Wissen, Trends & Insights – <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-500">Mein Blog</span>
      </h2>
      <p class="mt-2 text-lg leading-8 text-light-300">
        Bleiben Sie auf dem Laufenden mit aktuellen Beiträgen zu DevSecOps, Webentwicklung, Smart Home und mehr.
      </p>
      <a 
        href="/blog/1/" 
        class="mt-6 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary-500/90 to-primary-600/90 px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-xl hover:shadow-primary-500/50 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      >
        <span>Zum Blog</span>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
    <div
      class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-2">
      {
        blogPosts.map(async (post: any) => {

          return (
            <a 
              href={`/blog/${post.id.replace(/^_/, '')}/`} 
              class="group gsap-fadein rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 transition-all"
            >
              <article
                class="relative isolate flex flex-col h-full justify-end overflow-hidden rounded-2xl bg-dark-900/50 border border-light-500/20 hover:border-primary-500/40 pt-80 sm:pt-48 lg:pt-80 transition-all duration-300 hover:shadow-xl hover:shadow-primary-500/20">
                
                {/* Ambient Glow on Hover */}
                <div class="absolute -inset-1 bg-gradient-to-r from-primary-500/0 via-cyan-500/0 to-primary-500/0 group-hover:from-primary-500/10 group-hover:via-cyan-500/10 group-hover:to-primary-500/10 rounded-2xl blur-xl transition-all duration-300 -z-20"></div>
                
                <Image
                  src={post.data.heroImage}
                  width="1024"
                  height="1024"
                  alt={post.data.title}
                  class="absolute inset-0 -z-10 h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                  inferSize
                />
                <div class="absolute inset-0 -z-10 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"></div>

                <div class="relative isolate flex flex-col bg-dark-900/80 backdrop-blur-md border-t border-light-500/10 justify-end p-8 pt-4 group-hover:bg-dark-900/90 transition-all duration-300">
                  <div class="flex flex-wrap items-center gap-2 text-sm leading-6 text-light-400 mb-2">
                    <i class="fa-solid fa-calendar text-primary-400 text-xs" aria-hidden="true"></i>
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  <h3 class="mt-2 text-lg font-semibold leading-6 text-white group-hover:text-primary-300 transition-colors">
                    <span class="absolute inset-0"></span>
                    {post.data.title}
                  </h3>
                  <p
                    class="mt-3 flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-light-300 line-clamp-2">
                    {post.data.description}
                  </p>
                  <div class="mt-4 flex items-center gap-2 text-sm font-medium text-primary-400 group-hover:gap-3 transition-all">
                    <span>Mehr lesen</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                  </div>
                </div>
              </article>
            </a>
          );
        })
      }
    </div>
  </div>
</div>