---
const { entry } = Astro.props;
import TimeDiff from './TimeDiff.astro';
let progress = 0;
let color = '';
switch (entry.data.knowledgebase) {
  case 'basic':
    progress = 33;
    color = 'bg-rose-500';
    break;
  case 'advanced':
    progress = 66;
    color = 'bg-wd-300';
    break;
  case 'expert':
    progress = 100;
    color = 'bg-wd-500';
    break;
  default:
    progress = 0;
}

const layer = JSON.stringify(entry.data.layer);
---

<tr class="odd:bg-wd-200 even:bg-wd-100 dark:odd:bg-slate-600 dark:even:bg-slate-700" data-layer={layer} data-entry={JSON.stringify(entry.data)}>
  <td class="px-2 py-3">
      <img
      class="max-h-6 w-full object-contain group-hover:grayscale-0 duration-150 ease-out hover:ease-in"
      loading="lazy"
      src={entry.data.image}
      alt={entry.data.name}
      width="50"
      height="50"
      />
    </td>
    <td class="px-2 py-3">
    <span class="w-full text-center text-gray-700 dark:text-gray-300"
      >{entry.data.name}</span>
  </td>
  <td class="px-2 py-3">
      {
        entry.data.isActive ? (
          <div class="text-wd-500" title="Aktuell in Benutzung">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-6 h-6"
            >
              <path
                fill-rule="evenodd"
                d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549 4.49 4.49 0 0 1-3.498-1.306 4.491 4.491 0 0 1-1.307-3.498A4.49 4.49 0 0 1 2.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 0 1 1.307-3.497 4.49 4.49 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
        ) : (
          <div class="text-rose-500" title="Derzeit pausiert">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="w-6 h-6"
            >
              <path
                fill-rule="evenodd"
                d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12ZM9 8.25a.75.75 0 0 0-.75.75v6c0 .414.336.75.75.75h.75a.75.75 0 0 0 .75-.75V9a.75.75 0 0 0-.75-.75H9Zm5.25 0a.75.75 0 0 0-.75.75v6c0 .414.336.75.75.75H15a.75.75 0 0 0 .75-.75V9a.75.75 0 0 0-.75-.75h-.75Z"
                clip-rule="evenodd"
              />
            </svg>
          </div>
        )
      }
    </td>
    <td class="px-2 py-3">
      <TimeDiff
        sinceLastRollup={entry.data.sinceLastRollup}
        isActive={entry.data.isActive}
        fixedExperience={entry.data.fixedExperience}
      />
  </td>
  <td class="px-2 py-3">
    <div class="w-full bg-wd-50 dark:bg-slate-500 rounded-md overflow-hidden">
        <div
          style={`width: ${progress}%`}
          class={`${color} h-2 flex justify-center items-center`}
        >
          <span class="text-xs leading-none text-white sm-only hidden"
            >{entry.data.knowledgebase}</span
          >
        </div>
      </div>
  </td>
</tr>