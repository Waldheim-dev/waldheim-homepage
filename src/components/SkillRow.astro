---
const { entry } = Astro.props;
import TimeDiff from './TimeDiff.astro';
let progress = 0;
let color = '';
switch (entry.data.knowledgebase) {
  case 'basic':
    progress = 33;
    color = 'bg-rose-500';
    break;
  case 'advanced':
    progress = 66;
    color = 'bg-blue-600';
    break;
  case 'expert':
    progress = 100;
    color = 'bg-blue-700';
    break;
  default:
    progress = 0;
}

const layer = JSON.stringify(entry.data.layer);
---

<tr class="odd:bg-dark-900/30 even:bg-dark-900/50" data-layer={layer} data-entry={JSON.stringify(entry.data)}>
  <td class="px-2 py-3">
      <img
      class="max-h-6 w-full object-contain group-hover:grayscale-0 duration-150 ease-out hover:ease-in"
      loading="lazy"
      src={entry.data.image}
      alt={entry.data.name}
      width="50"
      height="50"
      />
    </td>
    <td class="px-2 py-3">
    <span class="w-full text-center text-light-100 "
      >{entry.data.name}</span>
  </td>
  <td class="px-2 py-3">
      {
        entry.data.isActive ? (
          <div class="text-blue-400" title="Aktuell in Benutzung">
            <i class="fa-solid fa-circle-check text-xl"></i>
          </div>
        ) : (
          <div class="text-rose-500" title="Derzeit pausiert">
            <i class="fa-solid fa-circle-pause text-xl"></i>
          </div>
        )
      }
    </td>
    <td class="px-2 py-3">
      <TimeDiff
        sinceLastRollup={entry.data.sinceLastRollup}
        isActive={entry.data.isActive}
        fixedExperience={entry.data.fixedExperience}
      />
  </td>
  <td class="px-2 py-3">
    <div class="w-full bg-dark-900 rounded-md overflow-hidden">
        <div
          style={`width: ${progress}%`}
          class={`${color} h-2 flex justify-center items-center`}
        >
          <span class="text-xs leading-none text-white sm-only hidden"
            >{entry.data.knowledgebase}</span
          >
        </div>
      </div>
  </td>
</tr>