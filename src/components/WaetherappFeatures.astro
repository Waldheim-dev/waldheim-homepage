---
interface Feature {
  icon: string;
  title: string;
  description: string;
  badge?: string;
}

const features: Feature[] = [
  {
    icon: 'fa-solid fa-cloud-bolt',
    title: 'Echtzeit-Wetterdaten',
    description: 'Aktuelle Bedingungen mit Temperatur, Luftfeuchtigkeit, Wind und UV-Index'
  },
  {
    icon: 'fa-solid fa-calendar-days',
    title: '7-Tage-Vorhersage',
    description: 'Detaillierte Stundenauflösung mit präzisen Vorhersagen für die nächsten 7 Tage'
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: 'Multi-Provider-System',
    description: 'Automatischer Fallback zwischen 4 Wetter-APIs für maximale Zuverlässigkeit',
    badge: 'Intelligenter Fallback'
  },
  {
    icon: 'fa-solid fa-location-dot',
    title: 'Mehrere Standorte',
    description: 'Speichere und verwalte unbegrenzte Standorte für schnelle Übersicht'
  },
  {
    icon: 'fa-solid fa-bell',
    title: 'Wetteralarme',
    description: 'Automatische Benachrichtigungen bei Unwetterwarnungen und Extremwetter'
  },
  {
    icon: 'fa-solid fa-chart-line',
    title: 'Historische Daten',
    description: 'Zugriff auf vergangene Wetterdaten für Vergleiche und Analysen'
  },
  {
    icon: 'fa-solid fa-bolt',
    title: 'Blitzschnell',
    description: 'Optimiert für Core Web Vitals mit intelligentem Caching (Valkey)'
  },
  {
    icon: 'fa-solid fa-lock',
    title: 'Datenschutz First',
    description: 'Gehärteter Docker Container mit höchster Sicherheit und GDPR-konform'
  }
];
---

<section id="features" class="py-24 sm:py-32 px-6 bg-dark-950">
  <div class="container mx-auto max-w-6xl">
    <!-- Header -->
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-4xl md:text-5xl font-bold text-white">
        Alles, was du brauchst
      </h2>
      <p class="text-xl text-light-300 max-w-2xl mx-auto">
        Professionelle Wetterfunktionen in einer modernen, benutzerfreundlichen App
      </p>
    </div>
    
    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <div class="relative group">
          <!-- Ambient Glow -->
          <div class="absolute -inset-1 bg-gradient-to-r from-blue-500/10 to-cyan-500/10 
                      blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10 rounded-xl"></div>
          
          <!-- Card -->
          <div class="relative bg-dark-900/50 border border-light-500/20 
                      hover:border-light-500/40 rounded-xl p-6 
                      hover:shadow-lg hover:shadow-blue-500/20 transition-all duration-300 h-full">
            <!-- Icon -->
            <div class="mb-4">
              <i class={`${feature.icon} text-4xl text-blue-400`} aria-hidden="true"></i>
            </div>
            
            <!-- Content -->
            <h3 class="text-xl font-bold text-white mb-3">{feature.title}</h3>
            <p class="text-light-300 text-sm leading-relaxed mb-4">
              {feature.description}
            </p>
            
            <!-- Badge -->
            {feature.badge && (
              <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/30 rounded-full px-3 py-1">
                <i class="fa-solid fa-star text-blue-400 text-xs" aria-hidden="true"></i>
                <span class="text-blue-300 text-xs font-medium">{feature.badge}</span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
