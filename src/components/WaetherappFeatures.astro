---
interface Feature {
  icon: string;
  title: string;
  description: string;
  badge?: string;
}

const features: Feature[] = [
  {
    icon: 'fa-solid fa-cloud-bolt',
    title: 'Echtzeit-Wetterdaten',
    description: 'Aktuelle Bedingungen mit Temperatur, Luftfeuchtigkeit, Wind und UV-Index'
  },
  {
    icon: 'fa-solid fa-calendar-days',
    title: '7-Tage-Vorhersage',
    description: 'Detaillierte Stundenauflösung mit präzisen Vorhersagen für die nächsten 7 Tage'
  },
  {
    icon: 'fa-solid fa-shield-halved',
    title: 'Multi-Provider-System',
    description: 'Automatischer Fallback zwischen 4 Wetter-APIs für maximale Zuverlässigkeit',
    badge: 'Intelligenter Fallback'
  },
  {
    icon: 'fa-solid fa-location-dot',
    title: 'Mehrere Standorte',
    description: 'Speichere und verwalte unbegrenzte Standorte für schnelle Übersicht'
  },
  {
    icon: 'fa-solid fa-bell',
    title: 'Wetteralarme',
    description: 'Automatische Benachrichtigungen bei Unwetterwarnungen und Extremwetter'
  },
  {
    icon: 'fa-solid fa-chart-line',
    title: 'Historische Daten',
    description: 'Zugriff auf vergangene Wetterdaten für Vergleiche und Analysen'
  },
  {
    icon: 'fa-solid fa-bolt',
    title: 'Blitzschnell',
    description: 'Optimiert für Core Web Vitals mit intelligentem Caching (Valkey)'
  },
  {
    icon: 'fa-solid fa-lock',
    title: 'Datenschutz First',
    description: 'Gehärteter Docker Container mit höchster Sicherheit und GDPR-konform'
  }
];
---

<section id="features" class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="container mx-auto max-w-7xl">
    <!-- Header -->
    <div class="text-center mb-16">
      <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
        Funktionen
      </h2>
      <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark">
        Präzise. <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Professionell.</span>
      </p>
    </div>
    
    <!-- Features Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature) => (
        <div class="relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-br from-meg-accent/10 to-sky-400/10 blur opacity-0 group-hover:opacity-100 transition duration-500 rounded-2xl"></div>
          
          <!-- Card -->
          <div class="relative h-full bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group-hover:border-meg-accent/30 transition-all flex flex-col">
            <!-- Icon -->
            <div class="size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-6 shadow-inner group-hover:scale-110 transition-transform">
              <i class={`${feature.icon} text-2xl text-meg-accent`} aria-hidden="true"></i>
            </div>
            
            <!-- Content -->
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-3 tracking-tight">{feature.title}</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed mb-6 flex-1">
              {feature.description}
            </p>
            
            <!-- Badge -->
            {feature.badge && (
              <div class="w-fit inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 rounded-lg px-2 py-1">
                <span class="text-meg-accent text-[10px] font-black uppercase tracking-widest">{feature.badge}</span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
