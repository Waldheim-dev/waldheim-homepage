---
const securityFeatures = [
  {
    icon: 'fa-lock',
    title: 'Verschlüsselung',
    description: 'TLS 1.3, AES-256'
  },
  {
    icon: 'fa-key',
    title: 'Passwörter',
    description: 'Bcrypt-Hashing'
  },
  {
    icon: 'fa-id-card',
    title: 'Authentifizierung',
    description: 'JWT-Token'
  },
  {
    icon: 'fa-user-shield',
    title: 'Zugriffskontrolle',
    description: 'Rollenbasiert (RBAC)'
  },
  {
    icon: 'fa-database',
    title: 'Backups',
    description: 'Täglich, verschlüsselt, redundant'
  },
  {
    icon: 'fa-server',
    title: 'Hosting',
    description: 'Deutsche Rechenzentren'
  }
];

const compliance = [
  {
    requirement: 'DSGVO',
    solution: 'EU-Server (Deutschland), Ende-zu-Ende-Verschlüsselung',
    status: 'konform'
  },
  {
    requirement: 'WEG-Gesetz § 28 Abs. 4',
    solution: 'Vermögensberichte-Templates',
    status: 'vorbereitet'
  },
  {
    requirement: 'HKVO § 6a',
    solution: 'Monatliche Verbrauchsberichte automatisch',
    status: 'konform'
  },
  {
    requirement: 'Backup & Archivierung',
    solution: 'Tägliche Backups, 7 Jahre Aufbewahrung',
    status: 'konform'
  }
];

const techStack = [
  { name: 'Backend', tech: 'Go (hochperformant)', color: 'text-cyan-400' },
  { name: 'Frontend', tech: 'Angular 20 (modern)', color: 'text-red-400' },
  { name: 'Datenbank', tech: 'PostgreSQL 17', color: 'text-blue-400' },
  { name: 'Caching', tech: 'Redis 8', color: 'text-red-500' },
  { name: 'Deployment', tech: 'Docker & Kubernetes', color: 'text-blue-500' }
];
---

<div class="py-24 sm:py-32 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Technologie Überschrift -->
    <div class="mx-auto max-w-2xl lg:text-center">
      <h2 class="text-sm font-bold uppercase tracking-widest text-emerald-400 gsap-fadein">
        Architektur
      </h2>
      <p class="mt-2 text-3xl font-black tracking-tighter text-meg-text-primary-dark sm:text-4xl gsap-fadein">
        Enterprise-Grade Technologie
      </p>
      <p class="mt-6 text-lg leading-8 text-meg-text-secondary gsap-fadein">
        Hochperformantes Backend, skalierbare Cloud-Infrastruktur und maximale Sicherheit.
      </p>
    </div>

    <!-- Sicherheitsfeatures -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <h3 class="text-xl font-bold text-meg-text-primary-dark mb-10 gsap-fadein tracking-tight flex items-center gap-3">
        <i class="fa-solid fa-shield-halved text-emerald-400"></i> Cyber Security
      </h3>
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3">
        {securityFeatures.map((feature, index) => (
          <div class="flex flex-col gsap-fadein bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark rounded-2xl p-6 shadow-sm group hover:border-meg-accent/30 transition-all" style={`animation-delay: ${index * 0.05}s`}>
            <dt class="flex items-center gap-x-4 text-base font-bold leading-7 text-meg-text-primary-dark">
              <div class="flex size-10 items-center justify-center rounded-xl bg-meg-bg-dark border border-meg-border-dark shadow-inner group-hover:scale-110 transition-transform">
                <i class={`fa-solid ${feature.icon} text-emerald-400`}></i>
              </div>
              {feature.title}
            </dt>
            <dd class="mt-4 text-sm leading-relaxed text-meg-text-secondary">
              {feature.description}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Performance & Scale -->
    <div class="mx-auto mt-24 max-w-2xl lg:max-w-none">
      <h3 class="text-xl font-bold text-meg-text-primary-dark mb-10 gsap-fadein tracking-tight flex items-center gap-3">
        <i class="fa-solid fa-bolt text-meg-accent"></i> Performance & Scale
      </h3>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        {[
          { label: 'Antwortzeiten (p95)', value: '< 200ms', color: 'emerald' },
          { label: 'Uptime SLA', value: '99,9%', color: 'meg-accent' },
          { label: 'Horizontal skalierbar', value: 'Kubernetes', color: 'violet' }
        ].map(stat => (
          <div class="rounded-2xl bg-meg-surface-dark/50 backdrop-blur-md p-8 border border-meg-border-dark shadow-sm group hover:border-meg-accent/30 transition-all text-center">
            <div class={`text-4xl font-black text-${stat.color === 'emerald' ? 'emerald-400' : stat.color === 'violet' ? 'violet-400' : 'meg-accent'} tracking-tighter mb-2 group-hover:scale-105 transition-transform`}>{stat.value}</div>
            <div class="text-[10px] uppercase font-black tracking-widest text-meg-text-secondary opacity-60">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tech Stack -->
    <div class="mx-auto mt-24 max-w-2xl lg:max-w-none">
      <h3 class="text-xl font-bold text-meg-text-primary-dark mb-10 gsap-fadein tracking-tight flex items-center gap-3">
        <i class="fa-solid fa-layer-group text-violet-400"></i> Modern Stack
      </h3>
      <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
        {techStack.map((item, index) => (
          <div class="rounded-xl bg-meg-bg-dark border border-meg-border-dark p-4 shadow-inner group hover:border-meg-accent/20 transition-all" style={`animation-delay: ${index * 0.05}s`}>
            <div class="text-[10px] uppercase font-black tracking-widest text-meg-text-secondary opacity-60 mb-1">{item.name}</div>
            <div class={`text-sm font-bold text-meg-text-primary-dark`}>{item.tech}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Compliance -->
    <div class="mx-auto mt-24 max-w-4xl">
      <h3 class="text-xl font-bold text-meg-text-primary-dark mb-10 gsap-fadein tracking-tight flex items-center gap-3">
        <i class="fa-solid fa-file-contract text-emerald-400"></i> Compliance
      </h3>
      <div class="overflow-hidden rounded-2xl border border-meg-border-dark bg-meg-surface-dark/30 shadow-sm">
        <table class="w-full border-collapse">
          <thead>
            <tr class="border-b border-meg-border-dark">
              <th class="px-6 py-4 text-left text-[10px] font-black uppercase tracking-widest text-meg-text-secondary">Anforderung</th>
              <th class="px-6 py-4 text-left text-[10px] font-black uppercase tracking-widest text-meg-text-secondary">Implementierung</th>
              <th class="px-6 py-4 text-left text-[10px] font-black uppercase tracking-widest text-meg-text-secondary">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-meg-border-dark">
            {compliance.map((item) => (
              <tr class="hover:bg-meg-accent/5 transition-colors">
                <td class="px-6 py-4 text-sm font-bold text-meg-text-primary-dark">{item.requirement}</td>
                <td class="px-6 py-4 text-sm text-meg-text-secondary">{item.solution}</td>
                <td class="px-6 py-4">
                  <span class={`inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-[10px] font-black uppercase tracking-tighter ${
                    item.status === 'konform' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-meg-accent/10 text-meg-accent'
                  }`}>
                    {item.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
