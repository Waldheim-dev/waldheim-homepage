---
const securityFeatures = [
  {
    icon: 'fa-lock',
    title: 'Verschlüsselung',
    description: 'TLS 1.3, AES-256'
  },
  {
    icon: 'fa-key',
    title: 'Passwörter',
    description: 'Bcrypt-Hashing'
  },
  {
    icon: 'fa-id-card',
    title: 'Authentifizierung',
    description: 'JWT-Token'
  },
  {
    icon: 'fa-user-shield',
    title: 'Zugriffskontrolle',
    description: 'Rollenbasiert (RBAC)'
  },
  {
    icon: 'fa-database',
    title: 'Backups',
    description: 'Täglich, verschlüsselt, redundant'
  },
  {
    icon: 'fa-server',
    title: 'Hosting',
    description: 'Deutsche Rechenzentren'
  }
];

const compliance = [
  {
    requirement: 'DSGVO',
    solution: 'EU-Server (Deutschland), Ende-zu-Ende-Verschlüsselung',
    status: 'konform'
  },
  {
    requirement: 'WEG-Gesetz § 28 Abs. 4',
    solution: 'Vermögensberichte-Templates',
    status: 'vorbereitet'
  },
  {
    requirement: 'HKVO § 6a',
    solution: 'Monatliche Verbrauchsberichte automatisch',
    status: 'konform'
  },
  {
    requirement: 'Backup & Archivierung',
    solution: 'Tägliche Backups, 7 Jahre Aufbewahrung',
    status: 'konform'
  }
];

const techStack = [
  { name: 'Backend', tech: 'Go (hochperformant)', color: 'text-cyan-400' },
  { name: 'Frontend', tech: 'Angular 20 (modern)', color: 'text-red-400' },
  { name: 'Datenbank', tech: 'PostgreSQL 17', color: 'text-blue-400' },
  { name: 'Caching', tech: 'Redis 8', color: 'text-red-500' },
  { name: 'Deployment', tech: 'Docker & Kubernetes', color: 'text-blue-500' }
];
---

<div class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Technologie Überschrift -->
    <div class="mx-auto max-w-2xl lg:text-center">
      <h2 class="text-base font-semibold leading-7 text-green-400 gsap-fadein">
        Technologie & Sicherheit
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-light-100 sm:text-4xl gsap-fadein">
        Enterprise-Grade Technologie
      </p>
      <p class="mt-6 text-lg leading-8 text-light-400 gsap-fadein">
        Self-Hosted per Docker Compose oder Kubernetes - volle Kontrolle über Ihre Daten
      </p>
    </div>

    <!-- Sicherheitsfeatures -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <h3 class="text-xl font-bold text-light-100 mb-8 gsap-fadein">🔒 Sicherheit</h3>
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-3">
        {securityFeatures.map((feature, index) => (
          <div class="flex flex-col gsap-fadein" style={`animation-delay: ${index * 0.05}s`}>
            <dt class="flex items-center gap-x-3 text-base font-semibold leading-7 text-light-100">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-900">
                <i class={`fa-solid ${feature.icon} text-white`}></i>
              </div>
              {feature.title}
            </dt>
            <dd class="mt-4 flex flex-auto flex-col text-sm leading-7 text-light-400">
              <p class="flex-auto">{feature.description}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Performance -->
    <div class="mx-auto mt-16 max-w-2xl lg:max-w-none">
      <h3 class="text-xl font-bold text-light-100 mb-8 gsap-fadein">⚡ Performance</h3>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        <div class="rounded-2xl bg-dark-900/50 p-6 border border-green-500/20 gsap-fadein">
          <div class="text-3xl font-bold text-green-400">{"< 200ms"}</div>
          <div class="mt-2 text-sm text-light-400">Antwortzeiten (p95)</div>
        </div>
        <div class="rounded-2xl bg-dark-900/50 p-6 border border-green-500/20 gsap-fadein">
          <div class="text-3xl font-bold text-green-400">99,9%</div>
          <div class="mt-2 text-sm text-light-400">Uptime SLA</div>
        </div>
        <div class="rounded-2xl bg-dark-900/50 p-6 border border-green-500/20 gsap-fadein">
          <div class="text-3xl font-bold text-green-400">Kubernetes</div>
          <div class="mt-2 text-sm text-light-400">Horizontal skalierbar</div>
        </div>
      </div>
    </div>

    <!-- Tech Stack -->
    <div class="mx-auto mt-16 max-w-2xl lg:max-w-none">
      <h3 class="text-xl font-bold text-light-100 mb-8 gsap-fadein">🛠️ Technologie-Stack</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {techStack.map((item, index) => (
          <div class="rounded-lg bg-dark-900/50 p-4 border border-green-500/20 gsap-fadein" style={`animation-delay: ${index * 0.05}s`}>
            <div class="text-sm font-semibold text-light-100">{item.name}</div>
            <div class={`mt-1 text-xs ${item.color}`}>{item.tech}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Compliance Tabelle -->
    <div class="mx-auto mt-16 max-w-4xl">
      <h3 class="text-xl font-bold text-light-100 mb-8 gsap-fadein">📜 Rechtssicherheit & Compliance</h3>
      <div class="overflow-hidden rounded-lg bg-dark-900/50 border border-green-500/20">
        <table class="min-w-full divide-y divide-light-500">
          <thead>
            <tr>
              <th class="px-6 py-3 text-left text-sm font-semibold text-light-100">Anforderung</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-light-100">Silvacore-Lösung</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-light-100">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-light-500">
            {compliance.map((item) => (
              <tr class="gsap-fadein">
                <td class="px-6 py-4 text-sm font-medium text-light-100">{item.requirement}</td>
                <td class="px-6 py-4 text-sm text-light-300">{item.solution}</td>
                <td class="px-6 py-4 text-sm">
                  {item.status === 'konform' ? (
                    <span class="inline-flex items-center gap-x-1.5 rounded-md bg-green-900/50 px-2 py-1 text-xs font-medium text-green-400">
                      <svg class="h-1.5 w-1.5 fill-green-400" viewBox="0 0 6 6"><circle cx="3" cy="3" r="3" /></svg>
                      Konform
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-x-1.5 rounded-md bg-blue-900/50 px-2 py-1 text-xs font-medium text-blue-400">
                      <svg class="h-1.5 w-1.5 fill-blue-400" viewBox="0 0 6 6"><circle cx="3" cy="3" r="3" /></svg>
                      Vorbereitet
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-sm text-light-400 italic gsap-fadein">
        <strong>Hinweis:</strong> Silvacore bietet technische Werkzeuge. Rechtliche Beratung ersetzen wir nicht. Konsultieren Sie bei Fragen einen Fachanwalt.
      </p>
    </div>
  </div>
</div>
