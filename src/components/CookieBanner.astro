---

<div
  id="waldheim-cookie-banner"
  role="dialog"
  aria-modal="false"
  aria-labelledby="waldheim-cookie-title"
  class="hidden fixed bottom-4 right-4 left-4 sm:left-auto sm:w-[420px] z-50 rounded-2xl bg-meg-surface-dark/95 backdrop-blur-xl border border-meg-border-dark p-5 shadow-2xl text-meg-text-primary-dark"
>
  <div class="flex items-start justify-between gap-3 mb-2">
    <p id="waldheim-cookie-title" class="text-sm font-black tracking-tight flex items-center gap-2">
      <i class="fa-solid fa-shield-halved text-meg-accent" aria-hidden="true"></i>
      <span>Datenschutz &amp; Cookie-Einwilligung</span>
    </p>
    <div class="flex items-center gap-2 text-[11px] font-semibold shrink-0">
      <a href="/datenschutz/" class="text-meg-accent hover:underline">Datenschutz</a>
      <span class="text-meg-text-secondary" aria-hidden="true">·</span>
      <a href="/impressum/" class="text-meg-accent hover:underline">Impressum</a>
    </div>
  </div>

  <p class="text-xs text-meg-text-secondary leading-relaxed mb-4">
    Wir nutzen technisch notwendige Speicherung (§ 25 Abs. 2 TDDDG) sowie – nur mit Ihrer freiwilligen Einwilligung (§ 25 Abs. 1 TDDDG, Art. 6 Abs. 1 lit. a DSGVO) – Google Analytics 4 (Google Ireland Ltd. / USA) zur Reichweitenmessung. Widerruf jederzeit im Footer unter „Cookies“.
  </p>

  <!-- Aufklappbare Detail-Einstellungen (2. Ebene mit Anbieter, Zweck, Rechtsgrundlage & Speicherdauer) -->
  <div id="waldheim-cookie-details" class="hidden mb-4 space-y-2.5 border-t border-meg-border-dark pt-3 text-xs">
    <label class="flex items-start justify-between gap-3 p-2.5 rounded-xl bg-meg-bg-dark/70 border border-meg-border-dark">
      <span>
        <strong class="block text-meg-text-primary-dark">Technisch notwendig (immer aktiv)</strong>
        <span class="block text-[11px] text-meg-text-secondary mt-0.5">
          Speichert Ihre Einwilligungs-Auswahl (<code>waldheim-cookie-consent-v1</code>, 12 Monate) sowie Darstellungspräferenzen (Theme/Kontrast). Rechtsgrundlage: § 25 Abs. 2 Nr. 2 TDDDG, Art. 6 Abs. 1 lit. f DSGVO.
        </span>
      </span>
      <input
        type="checkbox"
        checked
        disabled
        aria-label="Technisch notwendige Speicherung (immer aktiv)"
        class="size-4 mt-1 accent-sky-500 rounded shrink-0"
      />
    </label>

    <label class="flex items-start justify-between gap-3 p-2.5 rounded-xl bg-meg-bg-dark/70 border border-meg-border-dark cursor-pointer">
      <span>
        <strong class="block text-meg-text-primary-dark">Statistik &amp; Analyse (Google Analytics 4)</strong>
        <span class="block text-[11px] text-meg-text-secondary mt-0.5">
          Anbieter: Google Ireland Ltd. / Google LLC (USA, DPF-zertifiziert). Cookies: <code>_ga</code>, <code>_ga_*</code> (Speicherdauer: bis zu 14 Monate). Rechtsgrundlage: § 25 Abs. 1 TDDDG, Art. 6 Abs. 1 lit. a DSGVO.
        </span>
      </span>
      <input
        id="waldheim-cookie-analytics"
        type="checkbox"
        aria-label="Statistik und Analyse (Google Analytics 4) aktivieren"
        class="size-4 mt-1 accent-sky-500 rounded cursor-pointer shrink-0"
      />
    </label>
  </div>

  <!-- Gleichwertig gestaltete Buttons ohne visuelles Nudging (DSK-konform) -->
  <div class="grid grid-cols-2 gap-2">
    <button
      type="button"
      id="waldheim-cookie-reject"
      class="cursor-pointer rounded-xl bg-meg-bg-dark border border-meg-border-dark px-3.5 py-2.5 text-xs font-black text-meg-text-primary-dark hover:border-meg-accent transition-all"
    >
      Nur notwendige
    </button>
    <button
      type="button"
      id="waldheim-cookie-accept-all"
      class="cursor-pointer rounded-xl bg-meg-bg-dark border border-meg-border-dark px-3.5 py-2.5 text-xs font-black text-meg-text-primary-dark hover:border-meg-accent transition-all"
    >
      Alle akzeptieren
    </button>
  </div>

  <div class="mt-2 flex items-center justify-between">
    <button
      type="button"
      id="waldheim-cookie-toggle-details"
      aria-expanded="false"
      aria-controls="waldheim-cookie-details"
      class="cursor-pointer text-[11px] font-semibold text-meg-text-secondary hover:text-meg-text-primary-dark underline underline-offset-2 py-1"
    >
      Einstellungen anpassen
    </button>
    <button
      type="button"
      id="waldheim-cookie-save-selection"
      class="hidden cursor-pointer text-[11px] font-black text-meg-accent hover:underline py-1"
    >
      Auswahl speichern →
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'waldheim-cookie-consent-v1';
    const GA_ID = 'G-F6PFMBR146';

    window.dataLayer = window.dataLayer || [];
    window.gtag =
      window.gtag ||
      function () {
        window.dataLayer.push(arguments);
      };

    window.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
    });

    const clearAnalyticsCookies = () => {
      const names = document.cookie
        .split(';')
        .map((c) => c.trim().split('=')[0])
        .filter((n) => n === '_gid' || n.startsWith('_ga'));
      const hostParts = location.hostname.split('.');
      const rootDomain =
        hostParts.length >= 2 ? '.' + hostParts.slice(-2).join('.') : location.hostname;
      for (const name of names) {
        document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
        document.cookie = `${name}=; Max-Age=0; path=/; domain=${rootDomain}; SameSite=Lax`;
      }
    };

    const loadGoogleAnalytics = () => {
      if (document.getElementById('waldheim-ga4-script')) return;
      const script = document.createElement('script');
      script.id = 'waldheim-ga4-script';
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
      document.head.appendChild(script);
      window.gtag('js', new Date());
      window.gtag('config', GA_ID, { anonymize_ip: true });

      // Native Web Vitals Tracking an Google Analytics (ohne externes unpkg-CDN)
      try {
        if ('PerformanceObserver' in window) {
          const sendVital = (name, val) => {
            window.gtag('event', name, {
              event_category: 'Web Vitals',
              value: Math.round(name === 'CLS' ? val * 1000 : val),
              non_interaction: true,
            });
          };
          const nav = performance.getEntriesByType('navigation')[0];
          if (nav && nav.responseStart > 0) {
            sendVital('TTFB', nav.responseStart - nav.requestStart);
          }
          new PerformanceObserver((list) => {
            const entries = list.getEntries();
            const last = entries[entries.length - 1];
            if (last) sendVital('LCP', last.startTime);
          }).observe({ type: 'largest-contentful-paint', buffered: true });

          let clsVal = 0;
          new PerformanceObserver((list) => {
            for (const entry of list.getEntries()) {
              if (!entry.hadRecentInput) clsVal += entry.value;
            }
            sendVital('CLS', clsVal);
          }).observe({ type: 'layout-shift', buffered: true });
        }
      } catch (_) {}
    };

    const applyConsent = (state) => {
      const analyticsGranted = Boolean(state && state.analytics);
      window.gtag('consent', 'update', {
        analytics_storage: analyticsGranted ? 'granted' : 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });
      if (analyticsGranted) {
        loadGoogleAnalytics();
      } else {
        clearAnalyticsCookies();
      }
    };

    const readStoredConsent = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : null;
      } catch (_) {
        return null;
      }
    };

    const saveConsent = (analytics) => {
      const state = {
        necessary: true,
        analytics: Boolean(analytics),
        updatedAt: new Date().toISOString(),
      };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (_) {}
      applyConsent(state);
    };

    const bindBanner = () => {
      const banner = document.getElementById('waldheim-cookie-banner');
      if (!banner) return;

      const details = document.getElementById('waldheim-cookie-details');
      const analyticsCheckbox = document.getElementById('waldheim-cookie-analytics');
      const acceptAllBtn = document.getElementById('waldheim-cookie-accept-all');
      const rejectBtn = document.getElementById('waldheim-cookie-reject');
      const toggleDetailsBtn = document.getElementById('waldheim-cookie-toggle-details');
      const saveSelectionBtn = document.getElementById('waldheim-cookie-save-selection');

      const hideBanner = () => {
        banner.classList.add('hidden');
      };

      const openBanner = (expandDetails) => {
        const current = readStoredConsent();
        if (analyticsCheckbox instanceof HTMLInputElement) {
          analyticsCheckbox.checked = Boolean(current && current.analytics);
        }
        if (expandDetails && details && saveSelectionBtn && toggleDetailsBtn) {
          details.classList.remove('hidden');
          saveSelectionBtn.classList.remove('hidden');
          toggleDetailsBtn.setAttribute('aria-expanded', 'true');
        }
        banner.classList.remove('hidden');
      };

      acceptAllBtn?.addEventListener('click', () => {
        saveConsent(true);
        hideBanner();
      });

      rejectBtn?.addEventListener('click', () => {
        saveConsent(false);
        hideBanner();
      });

      toggleDetailsBtn?.addEventListener('click', () => {
        if (!details || !saveSelectionBtn) return;
        const isHidden = details.classList.toggle('hidden');
        saveSelectionBtn.classList.toggle('hidden', isHidden);
        toggleDetailsBtn.setAttribute('aria-expanded', String(!isHidden));
      });

      saveSelectionBtn?.addEventListener('click', () => {
        const checked =
          analyticsCheckbox instanceof HTMLInputElement ? analyticsCheckbox.checked : false;
        saveConsent(checked);
        hideBanner();
      });

      document.querySelectorAll('[data-cc="show-preferencesModal"]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          openBanner(true);
        });
      });

      const stored = readStoredConsent();
      if (stored) {
        applyConsent(stored);
      } else {
        openBanner(false);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindBanner, { once: true });
    } else {
      bindBanner();
    }
  })();
</script>
