---
// This code has been partially generated by an AI.
import InteractiveHeroCanvas from './InteractiveHeroCanvas.astro';
import AiImageBadge from './AiImageBadge.astro';

const { title, subtitle, image, video, posterImage, aiGenerated } = Astro.props;

// Video-Poster: Ersetze .mp4 mit -poster.jpg
const defaultPoster = video ? video.replace('.mp4', '-poster.webp') : '';
const poster = posterImage || defaultPoster;
---

<div
  class="relative isolate min-h-[90vh] flex items-center justify-center py-20 overflow-hidden"
>
  <!-- Three.js Interactive WebGL Background -->
  <InteractiveHeroCanvas />

  <!-- Static Background Video/Image Fallback Overlay (if props provided) -->
  {
    (video || image) && (
      <div
        aria-hidden="true"
        class="hero-bg-overlay absolute inset-0 flex justify-center items-center opacity-30 pointer-events-none"
      >
        <figure class="w-full h-full">
          {image ? (
            <img
              src={image}
              class="object-cover w-full h-full"
              alt={title}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1920"
              height="1080"
            />
          ) : null}
          {video ? (
            <video
              class="deferred-hero-video hidden object-cover w-full h-full absolute inset-0"
              width="1920"
              height="1080"
              preload="none"
              loop
              muted
              playsinline
              data-src={video}
            >
              <source data-src={video} type="video/mp4" />
            </video>
          ) : null}
        </figure>
      </div>
    )
  }

  {
    (video || image) && aiGenerated && (
      <AiImageBadge class="absolute bottom-3 right-3 z-10" />
    )
  }

  <!-- Content Card -->
  <div class="relative z-10 w-full max-w-7xl px-6 lg:px-8">
    <div
      class="mx-auto max-w-3xl text-center bg-meg-surface-dark/45 border border-meg-border-dark p-8 sm:p-14 rounded-3xl shadow-2xl backdrop-blur-xl meg-glass"
    >
      <h1
        id="hero-heading"
        class="text-balance text-4xl font-black tracking-tight text-meg-text-primary-dark sm:text-6xl md:text-7xl leading-[1.1] mb-6 break-words hyphens-auto"
      >
        {
          title
            .split(' ')
            .map((word: string, i: number) => (
              <span
                class="inline-block max-w-full break-words hyphens-auto hero-word"
                style={`--index: ${i}`}
                set:html={
                  (word === 'Software&shy;entwicklung'
                    ? 'Software&shy;entwicklung'
                    : word) + '&nbsp;'
                }
              />
            ))
        }
      </h1>

      <p
        id="hero-desc"
        class="hero-subtitle mt-6 text-pretty text-base font-medium text-meg-text-secondary sm:text-xl/8 max-w-2xl mx-auto leading-relaxed"
      >
        {subtitle}
      </p>

      <div
        id="hero-actions"
        class="hero-ctas-container mt-10 flex items-center justify-center flex-wrap gap-4"
      >
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  /* color-dodge glows against the dark backdrop; on light theme it just washes out to white */
  .hero-bg-overlay {
    mix-blend-mode: color-dodge;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  }

  html[data-theme='light'] .hero-bg-overlay {
    mix-blend-mode: multiply;
  }
</style>

<script is:inline>
  (() => {
    function activateHeroVideoOnInteraction() {
      const triggerHeroVideo = () => {
        document.querySelectorAll('video.deferred-hero-video').forEach((video) => {
          if (!(video instanceof HTMLVideoElement) || video.src) return;
          video.querySelectorAll('source').forEach((s) => {
            if (s.dataset.src) s.src = s.dataset.src;
          });
          if (video.dataset.src) video.src = video.dataset.src;
          video.classList.remove('hidden');
          video.load();
          video.play().catch(() => {});
        });
      };

      ['scroll', 'pointermove', 'touchstart'].forEach((evt) => {
        window.addEventListener(evt, triggerHeroVideo, { once: true, passive: true });
      });
    }

    function initLazyVideos() {
      const videos = document.querySelectorAll('video.lazy-video');
      if (!videos.length) return;

      const videoObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const video = entry.target;
              if (!(video instanceof HTMLVideoElement)) return;
              if (video.dataset.poster) video.poster = video.dataset.poster;
              video.querySelectorAll('source').forEach((source) => {
                if (source.dataset.src) source.src = source.dataset.src;
              });
              if (video.dataset.src) video.src = video.dataset.src;
              video.load();
              video.play().catch(() => {});
              video.classList.remove('lazy-video');
              videoObserver.unobserve(video);
            }
          });
        },
        { rootMargin: '0px' },
      );

      videos.forEach((video) => videoObserver.observe(video));
    }

    activateHeroVideoOnInteraction();
    initLazyVideos();
    document.addEventListener('astro:page-load', () => {
      activateHeroVideoOnInteraction();
      initLazyVideos();
    });
  })();
</script>
