---
// This code has been fully generated by an AI.
import AiImageBadge from './AiImageBadge.astro';

const { title, subtitle, image, aiGenerated = false } = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-meg-bg-dark px-6 py-20 sm:py-24 lg:px-8 lg:py-32"
  aria-labelledby="hero-heading"
>
  <div
    class="pointer-events-none absolute -right-40 -top-32 -z-10 size-[34rem] rounded-full bg-meg-brand blur-3xl opacity-70"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-48 -left-40 -z-10 size-[30rem] rounded-full bg-meg-accent/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div
    class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20"
  >
    <div class="max-w-3xl">
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-meg-accent/20 bg-white/80 px-4 py-2 text-sm font-bold text-meg-accent shadow-sm"
      >
        <span class="size-2 rounded-full bg-meg-accent" aria-hidden="true"></span>
        Waldheim.dev · Augsburg und DACH
      </p>
      <h1
        id="hero-heading"
        class="text-balance text-4xl font-black leading-[1.08] tracking-tight text-meg-text-primary-dark sm:text-6xl lg:text-7xl"
      >
        {title}
      </h1>
      <p
        id="hero-desc"
        class="mt-7 max-w-2xl text-pretty text-lg leading-8 text-meg-text-secondary sm:text-xl"
      >
        {subtitle}
      </p>
      <div
        id="hero-actions"
        class="mt-9 flex flex-wrap items-center gap-3"
      >
        <slot />
      </div>
    </div>

    {image ? (
      <figure class="relative mx-auto w-full max-w-2xl overflow-hidden rounded-[2rem] border border-meg-accent/15 bg-white p-2 shadow-[0_28px_90px_-40px_rgba(54,101,68,0.38)]">
        <img
          src={image}
          alt={title}
          width="1200"
          height="800"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="aspect-[3/2] w-full rounded-[1.5rem] object-cover"
        />
        {aiGenerated && <AiImageBadge class="absolute bottom-5 right-5" />}
      </figure>
    ) : (
    <aside
      class="relative mx-auto w-full max-w-xl rounded-[2rem] border border-meg-accent/15 bg-white/85 p-6 shadow-[0_28px_90px_-40px_rgba(54,101,68,0.38)] backdrop-blur-sm sm:p-8"
      aria-label="So wird aus einer Herausforderung ein nächster Schritt"
    >
      <div class="mb-7 flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.18em] text-meg-accent">
            Vom Anliegen zur Lösung
          </p>
          <h2 class="mt-2 text-2xl font-black tracking-tight text-meg-text-primary-dark">
            Ein klarer nächster Schritt.
          </h2>
        </div>
        <span
          class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-meg-brand text-meg-accent"
          aria-hidden="true"
        >
          <i class="fa-solid fa-compass text-xl"></i>
        </span>
      </div>

      <ol class="space-y-3">
        <li class="flex gap-4 rounded-2xl border border-meg-border-dark bg-meg-bg-dark p-4">
          <span
            class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-meg-brand text-sm font-black text-meg-accent"
            aria-hidden="true"
            >01</span
          >
          <div>
            <h3 class="font-bold text-meg-text-primary-dark">Erst verstehen</h3>
            <p class="mt-1 text-sm leading-6 text-meg-text-secondary">
              Wo verlieren Menschen Zeit, Überblick oder Sicherheit?
            </p>
          </div>
        </li>
        <li class="flex gap-4 rounded-2xl border border-meg-border-dark bg-meg-bg-dark p-4">
          <span
            class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-meg-brand text-sm font-black text-meg-accent"
            aria-hidden="true"
            >02</span
          >
          <div>
            <h3 class="font-bold text-meg-text-primary-dark">Passend entscheiden</h3>
            <p class="mt-1 text-sm leading-6 text-meg-text-secondary">
              Beratung, Waldheim Suite oder ein offenes Werkzeug wie semrel.
            </p>
          </div>
        </li>
        <li class="flex gap-4 rounded-2xl border border-meg-accent/20 bg-meg-brand/70 p-4">
          <span
            class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-meg-accent text-sm font-black text-white"
            aria-hidden="true"
            >03</span
          >
          <div>
            <h3 class="font-bold text-meg-text-primary-dark">Schrittweise umsetzen</h3>
            <p class="mt-1 text-sm leading-6 text-meg-text-secondary">
              Mit transparentem Umfang, verständlichen Entscheidungen und Raum für Feedback.
            </p>
          </div>
        </li>
      </ol>
      <div
        class="mt-6 flex items-center gap-2 border-t border-meg-border-dark pt-5 text-xs font-semibold text-meg-text-secondary"
      >
        <i class="fa-solid fa-location-dot text-meg-accent" aria-hidden="true"></i>
        Persönlich aus Augsburg · Zusammenarbeit auch remote
      </div>
    </aside>
    )}
  </div>
</section>
