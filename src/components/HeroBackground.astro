---
const { title, subtitle, image, video, posterImage } = Astro.props;

// Video-Poster: Ersetze .mp4 mit -poster.jpg
const defaultPoster = video ? video.replace('.mp4', '-poster.webp') : '';
const poster = posterImage || defaultPoster;
---

<div class="relative isolate">
    <div aria-hidden="true" class="absolute max-sm:w-full sm:inset-0 flex justify-center items-center py-12 px-3 md:px-12">
      <figure class="rounded-3xl overflow-hidden relative w-full h-full">
          { image ? <img src={image} class="object-contains w-full brightness-50" alt={title}  loading="eager" width="1920" height="1080"/> : null }
          { video ?
            <video
              class="object-contains max-sm:max-w-none sm:w-full brightness-50"
              width="1920"
              height="1080"
              style="aspect-ratio: 16/9;"
              preload="metadata"
              poster={poster}
              autoplay
              loop
              muted
              playsinline
              src={video}
            >
              <source
                src={video} type="video/mp4" />
            </video> : null }

        </figure>
    </div>
    <div class="py-24 sm:py-32 lg:pb-40 z-10 relative">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
            <div class="mx-auto max-w-2xl text-center bg-dark-900/50 p-12 rounded-2xl border border-blue-500/30 shadow-2xl backdrop-blur-md">
                <h1 class="text-balance text-5xl font-bold tracking-tight text-white sm:text-7xl gsap-fadein">{title}</h1>
                <p class="mt-8 text-pretty text-lg font-medium text-light-300 sm:text-xl/8 gsap-fadein">{subtitle}</p>
                <slot />
            </div>
        </div>
    </div>
</div>