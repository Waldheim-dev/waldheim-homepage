---
import InteractiveHeroCanvas from './InteractiveHeroCanvas.astro';
import AiImageBadge from './AiImageBadge.astro';

const { title, subtitle, image, video, posterImage, aiGenerated } = Astro.props;

// Video-Poster: Ersetze .mp4 mit -poster.jpg
const defaultPoster = video ? video.replace('.mp4', '-poster.webp') : '';
const poster = posterImage || defaultPoster;
---

<div
  class="relative isolate min-h-[90vh] flex items-center justify-center py-20 overflow-hidden"
>
  <!-- Three.js Interactive WebGL Background -->
  <InteractiveHeroCanvas />

  <!-- Static Background Video/Image Fallback Overlay (if props provided) -->
  {
    (video || image) && (
      <div
        aria-hidden="true"
        class="hero-bg-overlay absolute inset-0 flex justify-center items-center opacity-30 pointer-events-none"
      >
        <figure class="w-full h-full">
          {image ? (
            <img
              src={image}
              class="object-cover w-full h-full "
              alt={title}
              loading="eager"
              width="1920"
              height="1080"
            />
          ) : null}
          {video ? (
            <video
              class="lazy-video object-cover w-full h-full"
              width="1920"
              height="1080"
              preload="none"
              poster={poster}
              autoplay
              loop
              muted
              playsinline
              data-src={video}
            >
              <source data-src={video} type="video/mp4" />
            </video>
          ) : null}
        </figure>
      </div>
    )
  }

  {
    (video || image) && aiGenerated && (
      <AiImageBadge class="absolute top-4 right-4 z-10" />
    )
  }

  <!-- Content Card -->
  <div class="relative z-10 w-full max-w-7xl px-6 lg:px-8">
    <div
      class="mx-auto max-w-3xl text-center bg-meg-surface-dark/45 border border-meg-border-dark p-8 sm:p-14 rounded-3xl shadow-2xl backdrop-blur-xl meg-glass"
    >
      <h1
        id="hero-heading"
        class="text-balance text-4xl font-black tracking-tight text-meg-text-primary-dark sm:text-6xl md:text-7xl leading-[1.1] mb-6 break-words hyphens-auto"
      >
        {
          title
            .split(' ')
            .map((word: string, i: number) => (
              <span
                class="inline-block max-w-full break-words hyphens-auto hero-word opacity-0 translate-y-4 filter blur-[2px]"
                style={`--index: ${i}`}
                set:html={
                  (word === 'Software&shy;entwicklung'
                    ? 'Software&shy;entwicklung'
                    : word) + '&nbsp;'
                }
              />
            ))
        }
      </h1>

      <p
        id="hero-desc"
        class="hero-subtitle mt-6 text-pretty text-base font-medium text-meg-text-secondary sm:text-xl/8 opacity-0 translate-y-3 max-w-2xl mx-auto leading-relaxed"
      >
        {subtitle}
      </p>

      <div
        id="hero-actions"
        class="hero-ctas-container mt-10 flex items-center justify-center flex-wrap gap-4 opacity-0 translate-y-3"
      >
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  /* color-dodge glows against the dark backdrop; on light theme it just washes out to white */
  .hero-bg-overlay {
    mix-blend-mode: color-dodge;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  }

  html[data-theme='light'] .hero-bg-overlay {
    mix-blend-mode: multiply;
  }

  /* Base Reveal styles */
  .hero-word {
    will-change: transform, opacity, filter;
  }

  /* Fallback in case JS fails or user prefers reduced motion */
  .no-js .hero-word,
  .no-js .hero-subtitle,
  .no-js .hero-ctas-container {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word,
    .hero-subtitle,
    .hero-ctas-container {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function initHeroAnimations() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }
    // Split heading animation
    const words = document.querySelectorAll('.hero-word');
    if (words.length > 0) {
      gsap.to(words, {
        opacity: 1,
        y: 0,
        filter: 'blur(0px)',
        stagger: 0.04,
        duration: 0.8,
        ease: 'back.out(1.2)',
        delay: 0.2,
      });
    }

    // Subtitle
    const sub = document.getElementById('hero-desc');
    if (sub) {
      gsap.to(sub, {
        opacity: 1,
        y: 0,
        duration: 1.0,
        ease: 'power3.out',
        delay: 0.6,
      });
    }

    // CTAs
    const actions = document.getElementById('hero-actions');
    if (actions) {
      gsap.to(actions, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power2.out',
        delay: 0.9,
      });
    }
  }

  // Run on page load and swaps
  initHeroAnimations();
  document.addEventListener('astro:page-load', initHeroAnimations);

  // Lazy video fallback helper
  function initLazyVideos() {
    const videoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const video = entry.target as HTMLVideoElement;
            const sources = video.querySelectorAll('source');

            sources.forEach((source) => {
              if (source.dataset.src) {
                source.src = source.dataset.src;
              }
            });

            if (video.dataset.src) {
              video.src = video.dataset.src;
            }

            video.load();
            video.classList.remove('lazy-video');
            videoObserver.unobserve(video);
          }
        });
      },
      { rootMargin: '200px' },
    );

    document.querySelectorAll('video.lazy-video').forEach((video) => {
      videoObserver.observe(video);
    });
  }

  initLazyVideos();
  document.addEventListener('astro:page-load', initLazyVideos);
</script>
