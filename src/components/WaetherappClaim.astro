---
// WetterApp Claim Section für Homepage
import { getProductInfo } from '../consts/productColors';

const waetherapp = getProductInfo('waetherapp')!;
---

<section class='py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='grid lg:grid-cols-2 gap-16 items-center'>
      <!-- Text Content -->
      <div class='gsap-fadein'>
        <div class='mb-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark shadow-sm'>
          <i class='fa-solid fa-cloud-sun text-meg-accent' aria-hidden='true'></i>
          <span class='text-meg-text-primary-dark font-bold text-sm tracking-tight'>Open Source</span>
          <span
            class={`capitalize inline-flex items-center gap-x-1.5 rounded-lg px-2 py-0.5 text-[10px] font-black uppercase tracking-tighter ml-2 ${waetherapp.colors.badgeBg} ${waetherapp.colors.badgeBorder} ${waetherapp.colors.badgeText}`}>
            <i class={`fa-solid fa-circle text-${waetherapp.colors.iconColor} text-[4px]`} aria-hidden='true'></i>
            {waetherapp.status !== 'stable' ? `${waetherapp.status}` : `v${waetherapp.version}`}
          </span>
        </div>

        <h2 class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>WetterApp</span> – Präzise Prognosen.
        </h2>

        <p class='text-xl text-meg-text-secondary mb-8 leading-relaxed'>
          Elegante Wetter-App mit Multi-Provider-Support. Echtzeit-Daten, Unwetterwarnungen und interaktives Radar – alles kostenlos und werbefrei.
        </p>

        <div class='grid grid-cols-2 gap-6 mb-10'>
          {[
            { icon: 'fa-cloud', title: 'Multi-Provider', desc: '4 Wetter-APIs integriert' },
            { icon: 'fa-bell', title: 'Warnungen', desc: 'Push-Alerts' },
            { icon: 'fa-clock-rotate-left', title: 'Historisch', desc: 'Vergangenheitsdaten' },
            { icon: 'fa-brands fa-gitlab', title: 'Libre', desc: '100% Open Source' }
          ].map(item => (
            <div class='flex items-start gap-3'>
              <div class="size-10 rounded-xl bg-meg-accent/10 border border-meg-accent/20 flex items-center justify-center shrink-0">
                <i class={`fa-solid ${item.icon} text-meg-accent`} aria-hidden='true'></i>
              </div>
              <div>
                <h3 class='text-meg-text-primary-dark font-bold text-sm'>{item.title}</h3>
                <p class='text-meg-text-secondary text-xs opacity-70'>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class='flex flex-col sm:flex-row gap-4'>
          <a 
            href='/waetherapp/' 
            class='gsap-btn inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-meg-accent text-white font-bold hover:shadow-xl hover:shadow-meg-accent/20 transition-all hover:scale-[1.02]'
          >
            <i class='fa-solid fa-arrow-right' aria-hidden='true'></i>
            Mehr erfahren
          </a>
          <a 
            href='https://wetter.waldheim.dev' 
            target='_blank'
            rel='noopener noreferrer'
            class='gsap-btn inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all'
          >
            <i class='fa-solid fa-rocket' aria-hidden='true'></i>
            Kostenlos nutzen
          </a>
        </div>
      </div>

      <!-- Visual Content -->
      <div class='relative gsap-fadein group'>
        <div class='relative'>
          <!-- Ambient Glow -->
          <div class='absolute -inset-4 bg-gradient-to-r from-meg-accent/10 via-sky-400/10 to-meg-accent/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000 -z-10'></div>
          
          <!-- Screenshot -->
          <img 
            src='/waetherapp/screenshot.png' 
            alt='WetterApp Dashboard' 
            class='relative rounded-2xl shadow-2xl border border-meg-border-dark w-full transition-transform duration-700 group-hover:scale-[1.01] bg-meg-surface-dark'
            loading='lazy'
          />
        </div>

        <!-- Floating Stats -->
        <div class='absolute -bottom-6 -left-6 bg-meg-surface-dark/90 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-4 shadow-2xl group-hover:border-meg-accent/30 transition-all'>
          <div class='flex items-center gap-4'>
            <div class='flex items-center gap-2'>
              <div class="size-2 rounded-full bg-emerald-400 animate-pulse"></div>
              <span class='text-meg-text-primary-dark font-black text-sm tracking-tighter'>v{waetherapp.version}</span>
            </div>
            <div class='w-px h-4 bg-meg-border-dark'></div>
            <div class='flex items-center gap-2'>
              <i class='fa-solid fa-download text-meg-accent text-xs' aria-hidden='true'></i>
              <span class='text-meg-text-secondary text-[10px] font-bold uppercase tracking-widest'>Open Source</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
