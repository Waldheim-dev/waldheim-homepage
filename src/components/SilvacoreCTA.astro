---
const steps = [
  {
    number: '1',
    title: 'Repository klonen',
    time: '2 Minuten',
    description: 'Silvacore herunterladen',
    details: ['git clone https://github.com/...', 'In Projektverzeichnis wechseln']
  },
  {
    number: '2',
    title: 'Deployment wählen',
    time: '5-15 Minuten',
    description: 'Docker Compose oder Kubernetes',
    details: ['docker-compose up -d (empfohlen)', 'oder: helm install silvacore', 'Umgebungsvariablen konfigurieren']
  },
  {
    number: '3',
    title: "Los geht's!",
    time: 'Sofort',
    description: 'Erste WEG anlegen',
    details: ['https://localhost:8080 aufrufen', 'Admin-Account erstellen', 'Erste WEG konfigurieren']
  }
];
---

<div class="bg-meg-bg-dark py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Überschrift -->
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-sm font-bold uppercase tracking-widest text-emerald-400 gsap-fadein">
        Deployment
      </h2>
      <p class="mt-2 text-3xl font-black tracking-tighter text-meg-text-primary-dark sm:text-4xl gsap-fadein" id="installation">
        In 3 Schritten zur WEG-Verwaltung
      </p>
      <p class="mt-6 text-lg leading-8 text-meg-text-secondary gsap-fadein">
        Self-Hosted auf Ihrer eigenen Infrastruktur – volle Datenkontrolle.
      </p>
    </div>

    <!-- Steps -->
    <div class="mx-auto mt-16 max-w-5xl">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        {steps.map((step, index) => (
          <div class="relative flex flex-col rounded-2xl bg-meg-surface-dark/50 backdrop-blur-xl p-8 border border-meg-border-dark gsap-fadein shadow-sm group hover:border-emerald-500/30 transition-all" style={`animation-delay: ${index * 0.15}s`}>
            <div class="flex items-center gap-x-4 mb-6">
              <div class="size-12 flex items-center justify-center rounded-xl bg-meg-bg-dark border border-meg-border-dark text-xl font-black text-emerald-400 shadow-inner group-hover:border-emerald-500/50 transition-all">
                {step.number}
              </div>
              <div>
                <h3 class="text-lg font-bold text-meg-text-primary-dark">{step.title}</h3>
                <p class="text-[10px] uppercase font-black tracking-widest text-emerald-400">{step.time}</p>
              </div>
            </div>
            <p class="text-base text-meg-text-primary-dark font-medium mb-4">{step.description}</p>
            <ul class="space-y-3">
              {step.details.map((detail) => (
                <li class="flex gap-x-2 text-sm text-meg-text-secondary leading-relaxed">
                  <span class="text-emerald-400">→</span>
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mx-auto mt-16 max-w-2xl text-center">
      <div class="rounded-2xl bg-meg-surface-dark/80 backdrop-blur-xl p-8 sm:p-10 border-2 border-emerald-500/20 shadow-2xl shadow-emerald-500/5 gsap-fadein group">
        <h3 class="text-xl sm:text-2xl font-black tracking-tight text-meg-text-primary-dark mb-4">
          Bereit für die Installation?
        </h3>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <a
            href="https://github.com/waldheim-dev/silvacore"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-x-2 rounded-xl bg-meg-accent px-6 py-3 text-base font-bold text-white shadow-xl shadow-meg-accent/20 hover:scale-[1.02] transition-all"
          >
            <i class="fa-brands fa-github"></i>
            Zu GitHub
          </a>
          <a
            href="/silvacore/#features"
            class="w-full sm:w-auto px-8 py-3 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark rounded-xl font-bold hover:bg-meg-surface-dark hover:border-emerald-500/50 transition-all"
          >
            Mehr erfahren <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[10px] font-black uppercase tracking-widest text-meg-text-secondary opacity-60">
          <div class="flex items-center gap-x-2">
            <i class="fa-solid fa-check text-emerald-400"></i>
            <span>Open Source</span>
          </div>
          <div class="flex items-center gap-x-2">
            <i class="fa-solid fa-check text-emerald-400"></i>
            <span>Self-Hosted</span>
          </div>
          <div class="flex items-center gap-x-2">
            <i class="fa-solid fa-check text-emerald-400"></i>
            <span>Privacy</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
