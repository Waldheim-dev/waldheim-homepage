---
// Aether Features & Use Cases
const features = [
  {
    icon: 'fa-shield-check',
    title: 'Ende-zu-Ende-Verschlüsselung',
    description: 'TLS 1.3 für maximale Sicherheit beim Transport. Optional: Passwortschutz für zusätzliche Authentifizierung.',
    color: 'from-red-500 to-rose-500'
  },
  {
    icon: 'fa-bolt',
    title: 'CDN-Beschleunigung',
    description: 'Weltweite Edge-Nodes für minimale Latenz. Dateien werden dort ausgeliefert, wo sie gebraucht werden.',
    color: 'from-orange-500 to-red-500'
  },
  {
    icon: 'fa-location-dot',
    title: 'DSGVO-konform',
    description: 'Hosting in deutschen Rechenzentren. Kein Tracking, keine Cookies, keine unnötigen Metadaten.',
    color: 'from-purple-500 to-pink-500'
  },
  {
    icon: 'fa-chart-line',
    title: 'Echtzeit-Tracking',
    description: 'Sehe in Echtzeit, wer deine Links aufruft. Verfügbar ab Wave-Tier.',
    color: 'from-blue-500 to-cyan-500'
  },
  {
    icon: 'fa-shuffle',
    title: 'Multi-Link-System',
    description: 'Generiere mehrere Links für eine Datei. Jeder Link individuell widerrufbar und mit eigenem Passwort.',
    color: 'from-green-500 to-emerald-500'
  },
  {
    icon: 'fa-fire',
    title: 'Auto-Burn',
    description: 'Dateien werden nach Ablauf automatisch gelöscht. Keine Spuren, keine Redundanzen, keine Altlasten.',
    color: 'from-red-500 to-rose-600'
  }
];

const useCases = [
  {
    icon: 'fa-code',
    title: 'Developer',
    description: 'Code-Pakete, Releases, Build-Artifacts, Container-Images',
    tags: ['CI/CD', 'GitHub Actions', 'GitLab']
  },
  {
    icon: 'fa-palette',
    title: 'Kreative',
    description: '4K-Videos, Rohmaterial, Design-Assets, PSD/AI-Dateien',
    tags: ['Adobe CC', 'DaVinci', 'Blender']
  },
  {
    icon: 'fa-briefcase',
    title: 'Freelancer',
    description: 'Kundenpräsentationen, Projektlieferungen, Angebote',
    tags: ['PDF', 'ZIP', 'Multi-Links']
  },
  {
    icon: 'fa-users',
    title: 'Teams',
    description: 'Projektarchive, Shared Resources, Vertrauliche Daten',
    tags: ['Passwortschutz', 'Tracking', 'API']
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <!-- Tech Stack Section -->
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4'>
        <i class='fa-solid fa-microchip mr-2' aria-hidden='true'></i>
        Infrastruktur
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Gebaut für <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-red-500'>Performance</span>
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto' style='animation-delay: 0.3s'>
        Aether nutzt modernste Cloud-Infrastruktur für maximale Geschwindigkeit.
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24'>
      {features.map((feature, index) => (
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${0.45 + index * 0.1}s`}>
          <div class='flex items-center gap-4 mb-6'>
            <div class={`size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:border-rose-500/50 transition-all shadow-inner`}>
              <i class={`fa-solid ${feature.icon} text-rose-400 text-xl`} aria-hidden='true'></i>
            </div>
            <h3 class='text-lg font-bold text-meg-text-primary-dark'>{feature.title}</h3>
          </div>
          <p class='text-meg-text-secondary text-sm leading-relaxed'>{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- Use Cases Section -->
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4'>
        Zielgruppen
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Wer nutzt <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-red-500'>Aether</span>?
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-8'>
      {useCases.map((useCase, index) => (
        <div class='gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${0.6 + index * 0.1}s`}>
          <!-- Ambient Glow on Hover -->
          <div class='absolute inset-0 bg-gradient-to-r from-rose-500/5 via-red-500/5 to-rose-500/5 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity -z-10'></div>

          <div class='mb-6'>
            <div class='size-14 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 group-hover:border-rose-500/50 transition-all shadow-inner'>
              <i class={`fa-solid ${useCase.icon} text-rose-400 text-2xl`} aria-hidden='true'></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-2'>{useCase.title}</h3>
            <p class='text-meg-text-secondary text-sm leading-relaxed mb-4'>{useCase.description}</p>
          </div>

          <div class='flex flex-wrap gap-2 mt-auto'>
            {useCase.tags.map((tag) => (
              <span class='px-3 py-1 text-[10px] font-black uppercase tracking-tighter bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg'>
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
