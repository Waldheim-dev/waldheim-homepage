---

const {title} = Astro.props;
---
<div class="bg-meg-bg-dark">
  <div class="mx-auto max-w-7xl py-24 sm:px-6 sm:py-32 lg:px-8">
    <div class="relative isolate overflow-hidden bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark px-6 py-24 text-center shadow-sm hover:border-meg-accent/30 sm:rounded-2xl sm:px-16 transition-all duration-300 group">
      
      <!-- Ambient Glow on Hover -->
      <div class="absolute -inset-2 bg-gradient-to-r from-meg-accent/5 via-sky-400/5 to-meg-accent/5 blur-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10"></div>
      
      <h2 class="text-balance text-4xl font-black tracking-tighter text-meg-text-primary-dark sm:text-5xl gsap-fadein">{title || 'Bereit für den nächsten Schritt?'}</h2>
      <p class="mx-auto mt-6 max-w-xl text-pretty text-lg/8 text-meg-text-secondary gsap-fadein">Lassen Sie uns gemeinsam Ihre digitale Zukunft gestalten. Mit modernen Technologien und klaren Strategien.</p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a href="/kontakt/" class="rounded-xl bg-meg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-meg-accent/30 hover:scale-[1.02] transition-all duration-300 gsap-fadein focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">Get started</a>
        <a href="/referenzen/1/" class="text-sm/6 font-semibold text-meg-text-primary-dark hover:text-meg-accent transition-colors gsap-fadein focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">Learn more <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</div>
