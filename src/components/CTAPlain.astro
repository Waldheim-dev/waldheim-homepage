---

const {title} = Astro.props;
---
<div class="bg-gradient-to-b from-dark-900 to-dark-950">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
    <h2 class="max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl gsap-fadein">Ready to dive in? <br>Start your free trial today.</h2>
    <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:shrink-0">
      <a href="#" class="rounded-xl bg-primary-800 px-6 py-3 gsap-fadein text-sm font-semibold text-white shadow-lg hover:shadow-lg hover:shadow-primary-500/50 hover:bg-primary-800 transition-all duration-300">Get started</a>
      <a href="#" class="text-sm/6 font-semibold text-blue-400 hover:text-blue-300 transition-colors gsap-fadein">Learn more <span aria-hidden="true">→</span></a>
    </div>
  </div>
</div>
