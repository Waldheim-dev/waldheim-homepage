---
interface Props {
  title?: string;
  description?: string;
  primaryCTA?: {
    label: string;
    href: string;
    target?: string;
  };
  secondaryCTA?: {
    label: string;
    href: string;
    target?: string;
  };
}

const {
  title = "Ready to dive in?",
  description = "Start your free trial today.",
  primaryCTA = { label: "Get started", href: "#" },
  secondaryCTA = { label: "Learn more", href: "#" }
} = Astro.props;
---
<div class="bg-gradient-to-b from-dark-950 via-dark-900 to-dark-950">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
    <div class="max-w-2xl">
      <h2 class="text-4xl font-bold tracking-tight text-white sm:text-5xl gsap-fadein">
        {title}
      </h2>
      {description && (
        <p class="mt-4 text-lg text-light-300 gsap-fadein">{description}</p>
      )}
    </div>
    <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:shrink-0">
      <a 
        href={primaryCTA.href}
        target={primaryCTA.target}
        rel={primaryCTA.target === '_blank' ? 'noopener noreferrer' : undefined}
        class="rounded-xl bg-gradient-to-r from-primary-500/90 to-primary-600/90 px-6 py-3 gsap-fadein text-sm font-semibold text-white shadow-lg hover:shadow-xl hover:shadow-primary-500/50 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      >
        {primaryCTA.label}
      </a>
      {secondaryCTA && (
        <a 
          href={secondaryCTA.href}
          target={secondaryCTA.target}
          rel={secondaryCTA.target === '_blank' ? 'noopener noreferrer' : undefined}
          class="text-sm/6 font-semibold text-primary-400 hover:text-primary-300 transition-colors gsap-fadein focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
        >
          {secondaryCTA.label} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</div>
