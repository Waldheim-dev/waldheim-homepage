---

const {title} = Astro.props;
---
<div class="bg-gradient-to-b from-dark-950 via-dark-900 to-dark-950">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:flex lg:items-center lg:justify-between lg:px-8">
    <h2 class="max-w-2xl text-4xl font-bold tracking-tight text-white sm:text-5xl gsap-fadein">Ready to dive in? <br>Start your <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-400 to-cyan-500">free trial</span> today.</h2>
    <div class="mt-10 flex items-center gap-x-6 lg:mt-0 lg:shrink-0">
      <a href="#" class="rounded-xl bg-gradient-to-r from-primary-500/90 to-primary-600/90 px-6 py-3 gsap-fadein text-sm font-semibold text-white shadow-lg hover:shadow-xl hover:shadow-primary-500/50 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Get started</a>
      <a href="#" class="text-sm/6 font-semibold text-primary-400 hover:text-primary-300 transition-colors gsap-fadein focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Learn more <span aria-hidden="true">→</span></a>
    </div>
  </div>
</div>
