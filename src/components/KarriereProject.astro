---
// This code has been partially generated by an AI.
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import SkillCards from './SkillCards.astro';

interface Props {
  projects?: any[];
  projectReferences?: any[];
  showAllReferences?: boolean;
  companyName?: string;
}

const { projects, projectReferences, showAllReferences, companyName } = Astro.props;

const projectsCollection = projects 
  ? await getCollection('karriere_projects', (project) => {
      return projects.some((pr) => pr.id === project.id.replace(/^_/, ''));
    })
  : [];

projectsCollection.sort((a, b) => {
  return b.data.from.valueOf() - a.data.from.valueOf();
});

const referencedProjects = showAllReferences
  ? await getCollection('projects')  // Zeige ALLE Projekte
  : projectReferences 
    ? await getCollection('projects', (project) => {
        // Manuelle References: Projekt-IDs haben Format: "_waldheim-dev/_homepage"
        // References haben Format: "waldheim-dev/homepage"
        const projectIdClean = project.id.replace(/^_/, '').replace(/\/_/g, '/');
        return projectReferences.some((ref) => {
          const refIdClean = ref.id.replace(/^_/, '').replace(/\/_/g, '/');
          return refIdClean === projectIdClean;
        });
      })
    : [];

referencedProjects.sort((a, b) => {
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});

---

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll('button[aria-controls]');

    const toggle = (button) => {
      const expanded = button.getAttribute('aria-expanded') === 'true' || false;
      button.setAttribute('aria-expanded', !expanded);
      const target = document.getElementById(
        button.getAttribute('aria-controls')
      );
      target.style.height = expanded ? '0' : `${target.scrollHeight}px`;
      const icons = button.querySelectorAll('svg');
      icons.forEach((icon) => icon.classList.toggle('hidden'));
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => toggle(button));
    });
  });
</script>
<div>
  {
    projectsCollection.length > 0 ? (
      <div class="mb-10">
        <h4 class="text-sm font-bold uppercase tracking-widest text-meg-text-secondary mb-6">
          Projekte bei {companyName}
        </h4>
        <dl class="space-y-4">
          {projectsCollection.map((project) => (
            <div class="border border-meg-border-dark rounded-xl overflow-hidden bg-meg-bg-dark/30 shadow-sm">
              <dt>
                <button
                  type="button"
                  class="flex w-full items-center justify-between text-left text-meg-text-primary-dark hover:bg-meg-accent/5 p-4 transition-all group"
                  aria-controls={project.id}
                  aria-expanded="false"
                >
                  <span class="text-base font-bold tracking-tight">
                    {project.data.name}
                    <span class="ml-2 text-xs font-medium text-meg-text-secondary">
                      <FormattedDate date={project.data.from} /> -{' '}
                      {project.data.to ? (<FormattedDate date={project.data.to} />) : ('heute')}
                    </span>
                  </span>
                  <span class="ml-6 flex h-7 items-center text-meg-accent group-hover:scale-110 transition-transform">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m6-6H6" />
                    </svg>
                    <svg class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M18 12H6" />
                    </svg>
                  </span>
                </button>
              </dt>
              <dd
                class="h-0 overflow-hidden transition-all duration-300"
                id={project.id}
              >
                <div class="p-6 pt-0">
                  <p class="text-sm leading-relaxed text-meg-text-secondary mb-6">
                    {project.data.description}
                  </p>

                  {project.data.techstack && (
                    <div class="bg-meg-surface-dark/50 rounded-xl p-4 border border-meg-border-dark shadow-inner">
                      <SkillCards skills={project.data.techstack} />
                    </div>
                  )}
                </div>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ) : null
  }
  
  {referencedProjects.length > 0 && (
    <div class="mt-12">
      <h4 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-6 flex items-center gap-2">
        <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
        Portfolio-Referenzen
      </h4>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {referencedProjects.map((project) => (
          <a 
            href={`/referenzen/${project.id.replace(/^_/, '').replace(/\/_/g, '/')}/`}
            class="group relative bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark hover:border-meg-accent/30 rounded-xl p-4 transition-all shadow-sm"
          >
            <div class="flex items-center gap-4">
              {project.data.heroImage && (
                <img 
                  src={`${project.data.heroImage}`} 
                  alt="" 
                  loading="lazy"
                  class="size-14 rounded-lg object-cover border border-meg-border-dark group-hover:border-meg-accent/20 transition-colors"
                />
              )}
              <div class="flex-1 min-w-0">
                <h5 class="text-sm font-bold text-meg-text-primary-dark group-hover:text-meg-accent transition-colors truncate">
                  {project.data.title}
                </h5>
                <p class="text-[10px] uppercase font-black tracking-widest text-meg-text-secondary mt-1">
                  {project.data.category.id}
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  )}
</div>
