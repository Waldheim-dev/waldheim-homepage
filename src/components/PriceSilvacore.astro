---
// SaaS Pricing Tiers
const pricingTiers = [
  {
    id: 'starter',
    name: 'Starter',
    price: '0',
    period: 'kostenlos',
    description: 'Perfekt zum Testen und für kleine Verwaltungen',
    features: [
      'Bis zu 1 WEG',
      'Unbegrenzte Eigentümer & Einheiten',
      '5 GB Dokumentenspeicher',
      'Alle Kern-Features inklusive',
      'Basis-Support',
      'HKVO §6a konform'
    ],
    cta: 'Kostenlos starten',
    href: 'https://suite.waldheim.dev',
    highlighted: false
  },
  {
    id: 'professional',
    name: 'Professional',
    price: '25',
    period: 'pro Monat',
    description: 'Für professionelle Hausverwaltungen',
    features: [
      'Bis zu 6 WEGs',
      'Unbegrenzte Nutzer',
      '30 GB Dokumentenspeicher',
      'Prioritäts-Support',
      'API-Zugriff',
      'Backup & Recovery',
      'SLA: 99.9% Uptime-Garantie',
      'HKVO §6a konform',
      'Alle Kern-Features inklusive',
      'Unbegrenzte Eigentümer & Einheiten'
    ],
    cta: 'Professional wählen',
    href: 'https://suite.waldheim.dev',
    highlighted: true,
    badge: 'Beliebteste Wahl'
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    price: '4',
    period: 'pro WEG',
    description: 'Für große Verwaltungen mit individuellen Anforderungen',
    features: [
      'Unbegrenzte WEGs',
      'Dedizierter Account Manager',
      'Unbegrenzter Speicher',
      'On-Premise Option verfügbar',
      'SLA: 99.95% Uptime-Garantie',
      'Unbegrenzte Eigentümer & Einheiten',
      'Alle Kern-Features inklusive',
      'HKVO §6a konform',
      'Unbegrenzte Nutzer',
      'API-Zugriff',
      'Prioritäts-Support',
      'Ab 50 Stück nutzbar',
    ],
    cta: 'Enterprise wählen',
    href: 'https://suite.waldheim.dev',
    highlighted: false
  }
];

const competitorsComparison = [
  { name: 'Silvacore SaaS', price20: '25 €', price50: '~75 €', total3Years: '900 € - 2.700 €', hkvo: true },
  // { name: 'Silvacore Self-Hosted', price20: '0 €*', price50: '0 €*', total3Years: '~500 € (Server)', hkvo: true },
  { name: 'immocloud', price20: '26 €', price50: '40 €', total3Years: '936 € - 1.440 €', hkvo: false },
  { name: 'Immoware24', price20: '44-54 €', price50: '~80 €', total3Years: '1.584 € - 2.880 €', hkvo: true },
  { name: 'Win-CASA', price20: '29 €', price50: '~49 €', total3Years: '1.044 € - 1.764 €', hkvo: false },
  { name: 'etg24', price20: '75 €', price50: '~125 €', total3Years: '2.700 € - 4.500 €', hkvo: false },
  { name: 'casavi', price20: '199 €', price50: '~349 €', total3Years: '7.164 € - 12.564 €', hkvo: 'Add-on' },
  { name: 'Domus', price20: '150-250 €', price50: '~400 €', total3Years: '8.400 € - 16.000 €', hkvo: false },
  { name: 'Haufe axera', price20: '449+ €', price50: '~649+ €', total3Years: '19.164 € - 28.000 €', hkvo: true }
];

const competitorsSavings = [
  { name: 'Silvacore SaaS', monthly: 25, threeYears: 900, savings: 0 },
  { name: 'Haufe axera', monthly: 449, threeYears: 16164, savings: 15264 },
  { name: 'Domus', monthly: 200, threeYears: 7200, savings: 6300 },
  { name: 'casavi', monthly: 199, threeYears: 7164, savings: 6264 }
];
---

<section id='pricing' class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='max-w-7xl mx-auto'>
    <div class='text-center mb-16 gsap-fadein'>
      <h2 class='text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4'>
        Software-as-a-Service
      </h2>
      <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
        Einfache, transparente <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Preise</span>
      </p>
      <p class='text-xl text-meg-text-secondary max-w-3xl mx-auto'>
        Managed SaaS mit 99.9% Uptime oder <span class="text-meg-text-primary-dark font-bold underline decoration-meg-accent/30">self-hosted</span> Open Source.
      </p>
    </div>

    <div class='grid md:grid-cols-3 gap-8 mb-24'>
      {pricingTiers.map((tier, index) => (
        <div
          class={`gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border ${tier.highlighted ? 'border-emerald-500/30' : 'border-meg-border-dark'} rounded-2xl p-8 ${tier.highlighted ? 'shadow-2xl shadow-emerald-500/10 scale-105 z-10' : 'shadow-sm'} transition-all duration-300 hover:border-emerald-500/40 group`}
          style={`animation-delay: ${index * 0.15}s`}
        >
          {tier.badge && (
            <div class='absolute -top-3 left-1/2 -translate-x-1/2 bg-emerald-600 border border-emerald-500/30 text-white px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg'>
              {tier.badge}
            </div>
          )}
          
          <div class='mb-8'>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>{tier.name}</h3>
            <div class='flex items-baseline mb-2'>
              {tier.price === 'Custom' ? (
                <span class='text-4xl font-black text-meg-text-primary-dark tracking-tighter'>
                  Individuell
                </span>
              ) : (
                <>
                  <span class='text-5xl font-black text-meg-text-primary-dark tracking-tighter'>{tier.price}</span>
                  <span class='text-2xl text-meg-text-secondary ml-2 font-bold'>€</span>
                </>
              )}
            </div>
            <p class='text-[10px] uppercase font-black tracking-widest text-emerald-400'>{tier.period}</p>
            <p class='text-meg-text-secondary text-sm mt-4 leading-relaxed'>{tier.description}</p>
          </div>

          <ul class='space-y-4 mb-10'>
            {tier.features.map((feature) => (
              <li class='flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed'>
                <i class='fa-solid fa-check text-emerald-400 mt-1' aria-label='Enthalten' role='img'></i>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={tier.href}
            class={`block w-full text-center py-3 px-6 rounded-xl font-bold transition-all duration-300 ${
              tier.highlighted
                ? 'bg-meg-accent text-white shadow-xl shadow-meg-accent/20 hover:scale-[1.02]'
                : 'bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark hover:border-emerald-500/50'
            }`}
          >
            {tier.cta}
          </a>
        </div>
      ))}
    </div>

    <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 mb-24 shadow-sm group hover:border-meg-accent/30 transition-all' style='animation-delay: 0.45s'>
      <div class='flex flex-col md:flex-row items-center gap-8'>
        <div class='size-20 bg-meg-bg-dark border border-meg-border-dark rounded-2xl flex items-center justify-center shrink-0 shadow-inner group-hover:scale-110 transition-transform'>
          <i class='fa-brands fa-docker text-4xl text-meg-accent' aria-label='Docker' role='img'></i>
        </div>
        <div class='flex-1'>
          <h3 class='text-2xl font-black text-meg-text-primary-dark mb-2 tracking-tight'>
            Self-Hosted / On-Premise
          </h3>
          <p class='text-meg-text-secondary mb-6 leading-relaxed'>
            Nutzen Sie Silvacore <strong class='text-meg-text-primary-dark'>kostenlos</strong> auf Ihrer eigenen Infrastruktur. Open Source unter AGPL-3.0. Perfekt für volle Datenkontrolle.
          </p>
          <ul class='grid sm:grid-cols-2 gap-3 text-meg-text-secondary text-sm'>
            <li class='flex items-center gap-2'><i class='fa-solid fa-check text-emerald-400'></i>Keine Lizenzkosten</li>
            <li class='flex items-center gap-2'><i class='fa-solid fa-check text-emerald-400'></i>100% Datenkontrolle</li>
            <li class='flex items-center gap-2'><i class='fa-solid fa-check text-emerald-400'></i>Unbegrenzte WEGs</li>
            <li class='flex items-center gap-2'><i class='fa-solid fa-check text-emerald-400'></i>Community Support</li>
          </ul>
        </div>
        <a
          href='https://suite.waldheim.dev'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full md:w-auto px-8 py-4 bg-meg-accent text-white rounded-xl font-bold shadow-xl shadow-meg-accent/20 hover:scale-[1.02] transition-all whitespace-nowrap'
        >
          Setup anfragen
        </a>
      </div>
    </div>

    <div class='gsap-fadein mb-24' style='animation-delay: 0.6s'>
      <h3 class='text-3xl font-black text-meg-text-primary-dark text-center mb-4 tracking-tighter'>
        Marktvergleich
      </h3>
      <p class='text-meg-text-secondary text-center mb-12 max-w-3xl mx-auto'>
        Silvacore vs. Wettbewerb. Preise beziehen sich auf den Professional-Plan (bis 6 WEGs).
      </p>

      <div tabindex="0" class='overflow-x-auto rounded-2xl border border-meg-border-dark bg-meg-surface-dark/30 shadow-sm'>
        <table class='w-full border-collapse' role='table'>
          <thead>
            <tr class='border-b border-meg-border-dark'>
              <th scope='col' class='px-6 py-4 text-left text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>Anbieter</th>
              <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>20 WEGs</th>
              <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>50 WEGs</th>
              <th scope='col' class='px-6 py-4 text-center text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>HKVO §6a</th>
              <th scope='col' class='px-6 py-4 text-right text-[10px] font-black uppercase tracking-widest text-meg-text-secondary'>3 Jahre Total</th>
            </tr>
          </thead>
          <tbody class='divide-y divide-meg-border-dark'>
            {competitorsComparison.map((comp, index) => (
              <tr 
                class={`hover:bg-meg-accent/5 transition-colors ${comp.name.includes('Silvacore') ? 'bg-meg-accent/5' : ''}`}
              >
                <td class='px-6 py-4 text-sm font-bold text-meg-text-primary-dark'>
                  {comp.name.includes('Silvacore') && <i class='fa-solid fa-star text-emerald-400 mr-2'></i>}
                  {comp.name}
                </td>
                <td class='px-6 py-4 text-center text-sm text-meg-text-secondary'>{comp.price20}</td>
                <td class='px-6 py-4 text-center text-sm text-meg-text-secondary'>{comp.price50}</td>
                <td class='px-6 py-4 text-center'>
                  {comp.hkvo === true && <i class='fa-solid fa-check text-emerald-400'></i>}
                  {comp.hkvo === false && <i class='fa-solid fa-xmark text-rose-500 opacity-40'></i>}
                  {comp.hkvo === 'Add-on' && <span class='text-[10px] font-black text-orange-400'>Add-on</span>}
                </td>
                <td class='px-6 py-4 text-right text-sm font-black text-meg-text-primary-dark'>{comp.total3Years}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-10 shadow-sm' style='animation-delay: 0.9s'>
      <h3 class='text-2xl font-black text-meg-text-primary-dark text-center mb-8 tracking-tight'>
        Ihr Sparpotenzial
      </h3>
      
      <div class='grid md:grid-cols-3 gap-8'>
        {competitorsSavings.filter(comp => comp.savings > 0).map((comp, index) => (
          <div class='bg-meg-bg-dark border border-meg-border-dark rounded-2xl p-8 text-center shadow-inner group hover:border-emerald-500/30 transition-all'>
            <p class='text-[10px] uppercase font-black tracking-widest text-meg-text-secondary mb-4'>vs. {comp.name}</p>
            <p class='text-4xl font-black text-emerald-400 mb-2 tracking-tighter'>
              {comp.savings.toLocaleString('de-DE')} €
            </p>
            <p class='text-xs text-meg-text-secondary font-bold opacity-60'>Ersparnis (3 Jahre)</p>
          </div>
        ))}
      </div>

      <p class='text-center text-emerald-400 font-black text-lg mt-12 uppercase tracking-widest animate-pulse'>
        Sparen Sie bis zu 15.264 € gegenüber Legacy-Lösungen
      </p>
    </div>
  </div>
</section>
