---
const audiences = [
  {
    icon: 'fa-user-tie',
    title: 'Property Manager & Verwalter',
    quote: 'Endlich kann ich 10+ WEGs effizient verwalten, ohne den Überblick zu verlieren.',
    benefits: [
      '70% weniger Zeit für Abrechnungen',
      'Alle WEGs auf einem Dashboard',
      'Weniger Anrufe durch Self-Service-Portal'
    ],
    color: 'from-blue-500 to-cyan-500'
  },
  {
    icon: 'fa-users',
    title: 'WEG-Beiräte & Verwaltungsbeiräte',
    quote: 'Ich kann die Arbeit unseres Property Managers endlich nachvollziehen.',
    benefits: [
      'Transparenz bei Finanzen & Verbrauch',
      'Datengestützte Vorbereitung von Versammlungen',
      'WEG-Gesetz-konforme Berichte'
    ],
    color: 'from-green-500 to-emerald-500'
  },
  {
    icon: 'fa-house-user',
    title: 'Eigentümer',
    quote: 'Ich weiß jetzt endlich, wofür meine Nebenkosten draufgehen.',
    benefits: [
      'Monatliche Verbrauchsberichte - keine Überraschungen',
      'Nachvollziehbare Kostenaufstellung',
      'Jederzeit Zugriff auf Dokumente & Beschlüsse'
    ],
    color: 'from-purple-500 to-pink-500'
  },
  {
    icon: 'fa-building',
    title: 'Kleine Hausverwaltungen (1-20 WEGs)',
    quote: 'SaaS-Lösungen waren zu teuer. Silvacore ist perfekt für uns.',
    benefits: [
      'Bis zu 85% günstiger als Mitbewerber',
      'Wächst mit Ihrem Portfolio',
      'Keine unnötigen Enterprise-Features'
    ],
    color: 'from-orange-500 to-red-500'
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-900 to-dark-950'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-base font-semibold text-green-400 mb-4' style='animation-delay: 0s'>
        <i class='fa-solid fa-users text-green-400 mr-2' aria-hidden='true'></i>
        Für wen ist Silvacore?
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
        Die richtige Lösung für <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>jeden</span>
      </p>
    </div>
    
    <div class='grid md:grid-cols-2 gap-8'>
      {audiences.map((audience, index) => (
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style={`animation-delay: ${0.3 + index * 0.1}s`}>
          <div class='flex items-center gap-4 mb-6'>
            <div class={`w-14 h-14 bg-gradient-to-br ${audience.color} rounded-xl flex items-center justify-center flex-shrink-0`}>
              <i class={`fa-solid ${audience.icon} text-white text-xl`} aria-hidden='true'></i>
            </div>
            <h3 class='text-xl font-bold text-white'>{audience.title}</h3>
          </div>
          
          <blockquote class='mb-6 text-base italic text-light-300 border-l-4 border-green-500/30 pl-4'>
            "{audience.quote}"
          </blockquote>
          
          <div>
            <p class='text-sm font-semibold text-white mb-3'>Ihr Nutzen:</p>
            <ul class='space-y-3'>
              {audience.benefits.map((benefit) => (
                <li class='flex items-start gap-3 text-light-300'>
                  <i class='fa-solid fa-check text-green-400 mt-1' aria-hidden='true'></i>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
