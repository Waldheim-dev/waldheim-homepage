---
const audiences = [
  {
    icon: 'fa-user-tie',
    title: 'Property Manager & Verwalter',
    quote: 'Endlich kann ich 10+ WEGs effizient verwalten, ohne den Überblick zu verlieren.',
    benefits: [
      '70% weniger Zeit für Abrechnungen',
      'Alle WEGs auf einem Dashboard',
      'Weniger Anrufe durch Self-Service-Portal'
    ],
    color: 'from-blue-500 to-cyan-500'
  },
  {
    icon: 'fa-users',
    title: 'WEG-Beiräte & Verwaltungsbeiräte',
    quote: 'Ich kann die Arbeit unseres Property Managers endlich nachvollziehen.',
    benefits: [
      'Transparenz bei Finanzen & Verbrauch',
      'Datengestützte Vorbereitung von Versammlungen',
      'WEG-Gesetz-konforme Berichte'
    ],
    color: 'from-green-500 to-emerald-500'
  },
  {
    icon: 'fa-house-user',
    title: 'Eigentümer',
    quote: 'Ich weiß jetzt endlich, wofür meine Nebenkosten draufgehen.',
    benefits: [
      'Monatliche Verbrauchsberichte - keine Überraschungen',
      'Nachvollziehbare Kostenaufstellung',
      'Jederzeit Zugriff auf Dokumente & Beschlüsse'
    ],
    color: 'from-purple-500 to-pink-500'
  },
  {
    icon: 'fa-building',
    title: 'Kleine Hausverwaltungen (1-20 WEGs)',
    quote: 'SaaS-Lösungen waren zu teuer. Silvacore ist perfekt für uns.',
    benefits: [
      'Bis zu 85% günstiger als Mitbewerber',
      'Wächst mit Ihrem Portfolio',
      'Keine unnötigen Enterprise-Features'
    ],
    color: 'from-orange-500 to-red-500'
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0s'>
        Zielgruppen
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Die richtige Lösung für <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>jeden</span>
      </p>
    </div>
    
    <div class='grid md:grid-cols-2 gap-8'>
      {audiences.map((audience, index) => (
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-10 hover:border-emerald-500/30 transition-all duration-300 group shadow-sm flex flex-col' style={`animation-delay: ${0.3 + index * 0.1}s`}>
          <div class='flex items-center gap-6 mb-8'>
            <div class={`size-16 bg-meg-bg-dark border border-meg-border-dark rounded-2xl flex items-center justify-center shrink-0 shadow-inner group-hover:scale-110 transition-transform`}>
              <i class={`fa-solid ${audience.icon} text-emerald-400 text-2xl`} aria-hidden='true'></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark tracking-tight'>{audience.title}</h3>
          </div>
          
          <blockquote class='mb-8 text-base italic text-meg-text-secondary border-l-2 border-emerald-500/30 pl-6 leading-relaxed'>
            "{audience.quote}"
          </blockquote>
          
          <div class="mt-auto">
            <p class='text-[10px] uppercase font-black tracking-widest text-emerald-400 mb-4 opacity-80'>Ihre Vorteile</p>
            <ul class='space-y-4'>
              {audience.benefits.map((benefit) => (
                <li class='flex items-start gap-3 text-sm text-meg-text-secondary leading-relaxed'>
                  <i class='fa-solid fa-check text-emerald-400 mt-1' aria-hidden='true'></i>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
