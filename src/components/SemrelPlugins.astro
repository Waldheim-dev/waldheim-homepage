---
import type { Lang } from '../i18n/utils';

export interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = {
  de: {
    sectionLabel: 'Plugin Ecosystem',
    headlinePrefix: '30+ Plugins',
    headlineAccent: 'für jeden Stack',
    subtitleBefore: 'Installiert per ',
    subtitleAfter:
      ' — jedes Plugin lebt in eigenem Repository und released unabhängig.',
    cta: 'Plugin-Registry erkunden',
    ctaLabel: 'Zum semrel Plugin-Registry',
  },
  en: {
    sectionLabel: 'Plugin Ecosystem',
    headlinePrefix: '30+ Plugins',
    headlineAccent: 'for every stack',
    subtitleBefore: 'Install via ',
    subtitleAfter:
      ' — each plugin lives in its own repository and releases independently.',
    cta: 'Explore Plugin Registry',
    ctaLabel: 'Explore semrel Plugin Registry',
  },
}[lang];
const categories = [
  {
    name: 'Conditions',
    icon: 'fa-circle-check',
    color: 'text-sky-400',
    bg: 'bg-sky-500/10',
    border: 'border-sky-500/20',
    plugins: [
      { name: 'github-actions', desc: { de: 'Nur auf GitHub Actions CI', en: 'Only on GitHub Actions CI' } },
      { name: 'gitlab-ci', desc: { de: 'Nur auf GitLab CI', en: 'Only on GitLab CI' } },
      { name: 'gitea-actions', desc: { de: 'Nur auf Gitea Actions', en: 'Only on Gitea Actions' } },
      { name: 'generic', desc: { de: 'Generische CI-Umgebung', en: 'Generic CI environment' } },
    ],
  },
  {
    name: 'Analyzers',
    icon: 'fa-magnifying-glass-chart',
    color: 'text-blue-400',
    bg: 'bg-blue-500/10',
    border: 'border-blue-500/20',
    plugins: [
      { name: 'conventional', desc: { de: 'Conventional Commits Parser', en: 'Conventional Commits Parser' } },
      { name: 'default', desc: { de: 'Standard Commit Analyzer', en: 'Standard Commit Analyzer' } },
    ],
  },
  {
    name: 'Generators',
    icon: 'fa-file-code',
    color: 'text-indigo-400',
    bg: 'bg-indigo-500/10',
    border: 'border-indigo-500/20',
    plugins: [
      { name: 'changelog-md', desc: { de: 'Markdown (Keep a Changelog)', en: 'Markdown (Keep a Changelog)' } },
      { name: 'changelog-html', desc: { de: 'HTML Changelog', en: 'HTML Changelog' } },
      { name: 'release-notes', desc: { de: 'Release Notes Generator', en: 'Release Notes Generator' } },
    ],
  },
  {
    name: 'Providers',
    icon: 'fa-cloud-arrow-up',
    color: 'text-violet-400',
    bg: 'bg-violet-500/10',
    border: 'border-violet-500/20',
    plugins: [
      { name: 'github', desc: { de: 'GitHub Releases & Tags', en: 'GitHub Releases & Tags' } },
      { name: 'gitlab', desc: { de: 'GitLab Releases & Tags', en: 'GitLab Releases & Tags' } },
      { name: 'gitea', desc: { de: 'Gitea / Forgejo', en: 'Gitea Releases & Tags' } },
      { name: 'bitbucket', desc: { de: 'Bitbucket', en: 'Bitbucket Releases & Tags' } },
      { name: 'git', desc: { de: 'Nur lokale Git-Tags', en: 'Local git tag only' } },
    ],
  },
  {
    name: 'Updaters',
    icon: 'fa-arrow-up-right-dots',
    color: 'text-emerald-400',
    bg: 'bg-emerald-500/10',
    border: 'border-emerald-500/20',
    plugins: [
      { name: 'npm', desc: { de: 'package.json Version', en: 'package.json version' } },
      { name: 'docker', desc: { de: 'Docker Images bauen & pushen', en: 'Build & push Docker images' } },
      { name: 'helm', desc: { de: 'Helm Chart Version', en: 'Helm chart version' } },
      { name: 'cargo', desc: { de: 'Rust / Cargo Crate', en: 'Rust / Cargo crate' } },
      { name: 'python', desc: { de: 'PyPI Package', en: 'PyPI package' } },
      { name: 'gradle', desc: { de: 'Gradle Version', en: 'Gradle version' } },
      { name: 'maven', desc: { de: 'Maven Artifact', en: 'Maven artifact' } },
      { name: 'nuget', desc: { de: 'NuGet Package', en: 'NuGet package' } },
      { name: 'gobinary', desc: { de: 'Go Version Variable', en: 'Go version variable' } },
      { name: 'homebrew', desc: { de: 'Homebrew Formula', en: 'Homebrew formula' } },
      { name: 'terraform', desc: { de: 'Terraform Module Version', en: 'Terraform module version' } },
    ],
  },
  {
    name: 'Packagers',
    icon: 'fa-box-open',
    color: 'text-fuchsia-400',
    bg: 'bg-fuchsia-500/10',
    border: 'border-fuchsia-500/20',
    plugins: [
      { name: 'nfpm', desc: { de: '.deb / .rpm Paketierung', en: '.deb / .rpm packaging' } },
    ],
  },
  {
    name: 'Publishers',
    icon: 'fa-share-nodes',
    color: 'text-cyan-400',
    bg: 'bg-cyan-500/10',
    border: 'border-cyan-500/20',
    plugins: [
      { name: 'oci', desc: { de: 'OCI Registry Publishing', en: 'OCI registry publishing' } },
      { name: 'generic-http', desc: { de: 'HTTP Upload Targets', en: 'HTTP upload targets' } },
    ],
  },
  {
    name: 'Hooks',
    icon: 'fa-bell',
    color: 'text-amber-400',
    bg: 'bg-amber-500/10',
    border: 'border-amber-500/20',
    plugins: [
      { name: 'slack', desc: { de: 'Slack Notifications', en: 'Slack Notifications' } },
      { name: 'teams', desc: { de: 'Microsoft Teams', en: 'Microsoft Teams' } },
      { name: 'matrix', desc: { de: 'Matrix / Element', en: 'Matrix / Element' } },
      { name: 'email', desc: { de: 'E-Mail Benachrichtigungen', en: 'Email notifications' } },
      { name: 'jira', desc: { de: 'Jira Issues schließen', en: 'Close Jira issues' } },
      { name: 'gitplugin', desc: { de: 'Git-Operationen post-release', en: 'Git operations post-release' } },
    ],
  },
];
---

<section class='py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark' id='plugins' aria-labelledby='semrel-plugins-heading'>
  <div class='mx-auto max-w-7xl'>
    <header class='mx-auto max-w-2xl text-center mb-16'>
      <h2 id='semrel-plugins-heading' class='gsap-fadein text-sm font-bold uppercase tracking-widest text-blue-400 mb-4'>
        {t.sectionLabel}
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        {t.headlinePrefix} <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-sky-400'>{t.headlineAccent}</span>
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary' style='animation-delay: 0.3s'>
        {t.subtitleBefore}<code class='bg-meg-surface-dark border border-meg-border-dark rounded px-2 py-0.5 text-sky-400 font-mono text-base'>semrel plugin install &lt;name&gt;</code>{t.subtitleAfter}
      </p>
    </header>

    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12'>
      {categories.map((cat, i) => (
        <div
          class={`gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-6 hover:border-blue-500/20 transition-all`}
          style={`animation-delay: ${0.45 + i * 0.1}s`}
        >
          <div class={`size-12 ${cat.bg} border ${cat.border} rounded-xl flex items-center justify-center mb-4`}>
            <i class={`fa-solid ${cat.icon} ${cat.color} text-xl`} aria-hidden='true'></i>
          </div>
          <h3 class={`text-lg font-bold ${cat.color} mb-3`}>{cat.name}</h3>
          <ul class='space-y-1.5' role='list'>
            {cat.plugins.map(p => (
              <li class='flex items-center gap-2 text-sm'>
                <code class='font-mono text-meg-text-primary-dark bg-meg-bg-dark border border-meg-border-dark rounded px-2 py-0.5 text-xs whitespace-nowrap'>{p.name}</code>
                <span class='text-meg-text-secondary text-xs'>{p.desc[lang]}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class='text-center'>
      <a
        href='https://registry.semrel.io/'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-400 font-bold hover:bg-blue-500/20 hover:shadow-lg hover:shadow-blue-500/10 transition-all'
        aria-label={t.ctaLabel}
      >
        <i class='fa-solid fa-store' aria-hidden='true'></i>
        {t.cta}
        <i class='fa-solid fa-arrow-up-right-from-square text-xs' aria-hidden='true'></i>
      </a>
    </div>
  </div>
</section>
