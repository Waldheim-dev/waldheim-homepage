---
const categories = [
  {
    name: 'Conditions',
    icon: 'fa-circle-check',
    color: 'text-sky-400',
    bg: 'bg-sky-500/10',
    border: 'border-sky-500/20',
    plugins: [
      { name: 'github-actions', desc: 'Nur auf GitHub Actions CI' },
      { name: 'gitlab-ci', desc: 'Nur auf GitLab CI' },
      { name: 'gitea-actions', desc: 'Nur auf Gitea Actions' },
      { name: 'generic', desc: 'Generische CI-Umgebung' },
    ],
  },
  {
    name: 'Analyzers',
    icon: 'fa-magnifying-glass-chart',
    color: 'text-blue-400',
    bg: 'bg-blue-500/10',
    border: 'border-blue-500/20',
    plugins: [
      { name: 'conventional', desc: 'Conventional Commits Parser' },
      { name: 'default', desc: 'Standard Commit Analyzer' },
    ],
  },
  {
    name: 'Generators',
    icon: 'fa-file-code',
    color: 'text-indigo-400',
    bg: 'bg-indigo-500/10',
    border: 'border-indigo-500/20',
    plugins: [
      { name: 'changelog-md', desc: 'Markdown (Keep a Changelog)' },
      { name: 'changelog-html', desc: 'HTML Changelog' },
      { name: 'release-notes', desc: 'Release Notes Generator' },
    ],
  },
  {
    name: 'Providers',
    icon: 'fa-cloud-arrow-up',
    color: 'text-violet-400',
    bg: 'bg-violet-500/10',
    border: 'border-violet-500/20',
    plugins: [
      { name: 'github', desc: 'GitHub Releases & Tags' },
      { name: 'gitlab', desc: 'GitLab Releases & Tags' },
      { name: 'gitea', desc: 'Gitea / Forgejo' },
      { name: 'bitbucket', desc: 'Bitbucket' },
      { name: 'git', desc: 'Nur lokale Git-Tags' },
    ],
  },
  {
    name: 'Updaters',
    icon: 'fa-arrow-up-right-dots',
    color: 'text-emerald-400',
    bg: 'bg-emerald-500/10',
    border: 'border-emerald-500/20',
    plugins: [
      { name: 'npm', desc: 'package.json Version' },
      { name: 'docker', desc: 'Docker Images bauen & pushen' },
      { name: 'helm', desc: 'Helm Chart Version' },
      { name: 'cargo', desc: 'Rust / Cargo Crate' },
      { name: 'python', desc: 'PyPI Package' },
      { name: 'gradle', desc: 'Gradle Version' },
      { name: 'maven', desc: 'Maven Artifact' },
      { name: 'nuget', desc: 'NuGet Package' },
      { name: 'gobinary', desc: 'Go Version Variable' },
      { name: 'homebrew', desc: 'Homebrew Formula' },
      { name: 'terraform', desc: 'Terraform Module Version' },
    ],
  },
  {
    name: 'Hooks',
    icon: 'fa-bell',
    color: 'text-amber-400',
    bg: 'bg-amber-500/10',
    border: 'border-amber-500/20',
    plugins: [
      { name: 'slack', desc: 'Slack Notifications' },
      { name: 'teams', desc: 'Microsoft Teams' },
      { name: 'matrix', desc: 'Matrix / Element' },
      { name: 'email', desc: 'E-Mail Benachrichtigungen' },
      { name: 'jira', desc: 'Jira Issues schließen' },
      { name: 'gitplugin', desc: 'Git-Operationen post-release' },
    ],
  },
];
---

<section class='py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark' id='plugins' aria-labelledby='semrel-plugins-heading'>
  <div class='mx-auto max-w-7xl'>
    <header class='mx-auto max-w-2xl text-center mb-16'>
      <h2 id='semrel-plugins-heading' class='gsap-fadein text-sm font-bold uppercase tracking-widest text-blue-400 mb-4'>
        Plugin Ecosystem
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        30+ Plugins <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-sky-400'>für jeden Stack</span>
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary' style='animation-delay: 0.3s'>
        Installiert per <code class='bg-meg-surface-dark border border-meg-border-dark rounded px-2 py-0.5 text-sky-400 font-mono text-base'>semrel plugin install &lt;name&gt;</code> — jedes Plugin lebt in eigenem Repository und released unabhängig.
      </p>
    </header>

    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12'>
      {categories.map((cat, i) => (
        <div
          class={`gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-6 hover:border-blue-500/20 transition-all`}
          style={`animation-delay: ${0.45 + i * 0.1}s`}
        >
          <div class={`size-12 ${cat.bg} border ${cat.border} rounded-xl flex items-center justify-center mb-4`}>
            <i class={`fa-solid ${cat.icon} ${cat.color} text-xl`} aria-hidden='true'></i>
          </div>
          <h3 class={`text-lg font-bold ${cat.color} mb-3`}>{cat.name}</h3>
          <ul class='space-y-1.5' role='list'>
            {cat.plugins.map(p => (
              <li class='flex items-center gap-2 text-sm'>
                <code class='font-mono text-meg-text-primary-dark bg-meg-bg-dark border border-meg-border-dark rounded px-2 py-0.5 text-xs whitespace-nowrap'>{p.name}</code>
                <span class='text-meg-text-secondary text-xs'>{p.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class='text-center'>
      <a
        href='https://registry.semrel.io/'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-400 font-bold hover:bg-blue-500/20 hover:shadow-lg hover:shadow-blue-500/10 transition-all'
        aria-label='Zum semrel Plugin-Registry'
      >
        <i class='fa-solid fa-store' aria-hidden='true'></i>
        Plugin-Registry erkunden
        <i class='fa-solid fa-arrow-up-right-from-square text-xs' aria-hidden='true'></i>
      </a>
    </div>
  </div>
</section>
