---
/**
 * TrackedButton Component
 * 
 * A reusable button/link component with built-in Google Analytics tracking.
 * 
 * Usage:
 * <TrackedButton 
 *   href="/kontakt/" 
 *   trackEvent="service_inquiry"
 *   trackCategory="contact"
 *   trackLabel="Hero CTA"
 *   variant="primary"
 * >
 *   Jetzt beraten lassen
 * </TrackedButton>
 */

interface Props {
  href: string;
  trackEvent: string;
  trackCategory?: string;
  trackLabel?: string;
  trackValue?: number;
  variant?: 'primary' | 'secondary' | 'gradient-green' | 'gradient-purple' | 'ghost';
  icon?: string;
  iconPosition?: 'left' | 'right';
  class?: string;
}

const {
  href,
  trackEvent,
  trackCategory = 'button',
  trackLabel,
  trackValue,
  variant = 'primary',
  icon,
  iconPosition = 'right',
  class: className = ''
} = Astro.props;

// Variant-spezifische Klassen
const variantClasses = {
  primary: 'bg-meg-accent text-white hover:shadow-[0_0_20px_rgba(14,165,233,0.3)] border border-white/10',
  secondary: 'bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark hover:bg-meg-surface-dark hover:border-meg-accent/50 hover:shadow-lg hover:shadow-meg-accent/5',
  'gradient-green': 'bg-gradient-to-r from-emerald-400 to-meg-accent text-white hover:shadow-lg hover:shadow-emerald-400/30',
  'gradient-purple': 'bg-gradient-to-r from-violet-500 to-fuchsia-500 text-white hover:shadow-lg hover:shadow-violet-500/30',
  ghost: 'bg-transparent border border-meg-border-dark text-meg-text-secondary hover:text-meg-text-primary-dark hover:bg-meg-surface-dark/50 hover:border-meg-accent/30'
};

const baseClasses = 'inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold transition-all duration-300 ease-in-out gsap-fadein gsap-btn';
const finalClasses = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

<a
  href={href}
  class={finalClasses}
  data-track-event={trackEvent}
  data-track-category={trackCategory}
  data-track-label={trackLabel}
  data-track-value={trackValue}
>
  {icon && iconPosition === 'left' && (
    <i class={icon} aria-hidden="true"></i>
  )}
  <slot />
  {icon && iconPosition === 'right' && (
    <i class={icon} aria-hidden="true"></i>
  )}
</a>

<style>
  /* Smooth hover scale effect */
  a:hover {
    transform: scale(1.02);
  }
  
  a:active {
    transform: scale(0.98);
  }
</style>
