---
const { title, subtitle } = Astro.props;
---
<div class="relative isolate overflow-hidden bg-meg-bg-dark border-b border-meg-border-dark">
  <div class="mx-auto max-w-7xl pb-24 pt-10 sm:pb-32 lg:grid lg:grid-cols-2 lg:gap-x-8 lg:px-8 lg:py-40">
    <div class="px-6 lg:px-0 lg:pt-4">
      <div class="mx-auto max-w-2xl">
        <div class="max-w-lg">
          <h1 class="mt-10 text-4xl font-black tracking-tighter text-meg-text-primary-dark sm:text-6xl gsap-fadein">
            {title}
          </h1>
          <p class="mt-6 text-lg leading-8 text-meg-text-secondary gsap-fadein">
            {subtitle}
          </p>
          <div class="mt-10">
            <slot name="cta" />
          </div>
        </div>
      </div>
    </div>
    <div class="mt-20 sm:mt-24 md:mx-auto md:max-w-2xl lg:mx-0 lg:mt-0 lg:w-screen">
      <div
        class="absolute inset-y-0 right-1/2 -z-10 -mr-10 w-[200%] skew-x-[-30deg] bg-meg-surface-dark shadow-xl shadow-meg-accent/5 ring-1 ring-meg-border-dark md:-mr-20 lg:-mr-36"
        aria-hidden="true"></div>
      <div class="shadow-2xl md:rounded-2xl overflow-hidden ring-1 ring-meg-border-dark">
        <div
          class="bg-meg-surface-dark [clip-path:inset(0)] md:[clip-path:inset(0_round_var(--radius-2xl))] relative">
          <div
            class="absolute -inset-y-px left-1/2 -z-10 ml-10 w-[200%] skew-x-[-30deg] bg-meg-accent opacity-5 ring-1 ring-inset ring-meg-accent md:ml-20 lg:ml-36"
            aria-hidden="true"></div>
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>
