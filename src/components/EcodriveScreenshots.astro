---
const screenshots = [
  {
    title: 'Dashboard: Vollständiger Überblick',
    description: 'Ihr persönliches Cockpit mit allen wichtigen Informationen auf einen Blick. Verbrauch, Kosten, letzte Fahrten und anstehende Wartungen – alles übersichtlich dargestellt.',
    image: '/ecodrive/ecodrive_dashboard.png',
    alt: 'Ecodrive Dashboard mit Verbrauchsübersicht, Kostenanalyse und Fahrzeugstatistiken',
    features: [
      'Live-Verbrauchsanalyse',
      'Kostenübersicht auf Monatsbasis',
      'Wartungserinnerungen',
      'Tankstatistiken mit Trends'
    ],
    side: 'left'
  },
  {
    title: 'Tankbuch: Jeden Cent im Blick',
    description: 'Erfassen Sie Tankungen in Sekunden und analysieren Sie Ihren Verbrauch detailliert. Mit automatischer Berechnung von Durchschnittsverbrauch und Kosten pro Kilometer.',
    image: '/ecodrive/ecodrive_fuel_log.png',
    alt: 'Ecodrive Tankbuch mit Tankprotokoll und Verbrauchsanalyse',
    features: [
      'Schnelle Tankerfassung per App',
      'Automatische Verbrauchsberechnung',
      'Preisentwicklung pro Liter',
      'Export für Steuererklärung'
    ],
    side: 'right'
  },
  {
    title: 'Fahrtenbuch: Finanzamt-konform',
    description: 'Das digitale Fahrtenbuch erfüllt alle gesetzlichen Anforderungen. GPS-gestützt, manipulationssicher und mit einem Klick exportierbar.',
    image: '/ecodrive/ecodrive_mileage_log.png',
    alt: 'Ecodrive Fahrtenbuch mit GPS-Tracking und Routenaufzeichnung',
    features: [
      'GPS-Tracking automatisch',
      'Geschäftlich/Privat-Trennung',
      'Finanzamt-konforme Exporte',
      '1%-Regelung Kalkulator'
    ],
    side: 'left'
  },
  {
    title: 'Wartungsplaner: Nie mehr vergessen',
    description: 'Behalten Sie alle Service-Intervalle im Blick. Ecodrive erinnert Sie automatisch an anstehende Inspektionen, TÜV und Ölwechsel.',
    image: '/ecodrive/ecodrive_service_log.png',
    alt: 'Ecodrive Service-Log mit Wartungshistorie und Erinnerungen',
    features: [
      'Automatische Erinnerungen',
      'Servicehistorie komplett',
      'Kostenübersicht Werkstatt',
      'Garantie-Tracking'
    ],
    side: 'right'
  },
  {
    title: 'Multi-Fahrzeug-Verwaltung',
    description: 'Verwalten Sie beliebig viele Fahrzeuge mit der Pro-Version. Perfekt für Familien mit mehreren Autos oder kleine Fuhrparks.',
    image: '/ecodrive/ecodrive_vehicle_switch.png',
    alt: 'Ecodrive Fahrzeugwechsel für Fuhrparkverwaltung',
    features: [
      'Unbegrenzte Fahrzeuge (Pro)',
      'Schneller Fahrzeugwechsel',
      'Vergleichsstatistiken',
      'Gesamt-Kostenübersicht'
    ],
    side: 'left'
  },
  {
    title: 'Reports & Analytics',
    description: 'Professionelle Auswertungen und Berichte für Ihre Buchhaltung. Filtern Sie nach Zeiträumen, exportieren Sie als PDF oder Excel.',
    image: '/ecodrive/ecodrive_fuel_reports.png',
    alt: 'Ecodrive Reports mit detaillierten Statistiken und Diagrammen',
    features: [
      'Monatliche/Jährliche Reports',
      'PDF & Excel Export',
      'Diagramme & Grafiken',
      'Steuer-Kategorisierung'
    ],
    side: 'right'
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='max-w-7xl mx-auto'>
    <div class='text-center mb-24 gsap-fadein'>
      <h2 class='text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4'>
        Product Tour
      </h2>
      <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
        Alle Features im <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Detail</span>
      </p>
      <p class='text-xl text-meg-text-secondary max-w-3xl mx-auto'>
        Das smarte Fahrtenbuch für maximale Kontrolle und Steuerersparnis.
      </p>
    </div>

    <div class='space-y-32'>
      {screenshots.map((screenshot, index) => (
        <div class={`gsap-fadein flex flex-col ${screenshot.side === 'right' ? 'lg:flex-row-reverse' : 'lg:flex-row'} gap-16 items-center`} style={`animation-delay: ${index * 0.15}s`}>
          <div class='flex-1'>
            <h3 class='text-3xl font-black text-meg-text-primary-dark mb-6 tracking-tight'>
              {screenshot.title}
            </h3>
            <p class='text-lg text-meg-text-secondary mb-10 leading-relaxed'>
              {screenshot.description}
            </p>
            <ul class='grid sm:grid-cols-2 gap-4'>
              {screenshot.features.map((feature) => (
                <li class='flex items-center gap-3 bg-meg-surface-dark/50 border border-meg-border-dark rounded-xl p-3 shadow-inner'>
                  <i class='fa-solid fa-check text-emerald-400 text-xs'></i>
                  <span class='text-[10px] font-black uppercase tracking-widest text-meg-text-primary-dark'>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class='flex-1'>
            <div class='relative group'>
              <div class='absolute -inset-4 bg-gradient-to-r from-emerald-400/10 to-meg-accent/10 rounded-2xl blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000'></div>
              <img
                src={screenshot.image}
                alt={screenshot.alt}
                loading='lazy'
                class='relative rounded-2xl shadow-2xl border border-meg-border-dark group-hover:scale-[1.02] transition-all duration-700 bg-meg-surface-dark opacity-90 group-hover:opacity-100'
              />
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class='mt-32 text-center gsap-fadein' style='animation-delay: 0.9s'>
      <a
        href='https://www.eco-drive.app'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-2 px-10 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all hover:scale-[1.02]'
      >
        <i class='fa-solid fa-rocket' aria-hidden='true'></i>
        Jetzt kostenlos starten
      </a>
    </div>
  </div>
</section>
