---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  gradient: 'blue' | 'purple' | 'green' | 'orange' | 'pink';
  icon: string;
  badge?: string;
}

const { title, subtitle, description, gradient, icon, badge } = Astro.props;

const gradientClasses = {
  blue: 'from-meg-accent to-sky-400',
  purple: 'from-violet-400 to-fuchsia-500',
  green: 'from-emerald-400 to-meg-accent',
  orange: 'from-orange-400 to-amber-500',
  pink: 'from-rose-400 to-pink-500'
};

const gradientBg = {
  blue: 'from-meg-accent to-sky-600',
  purple: 'from-violet-600 to-fuchsia-600',
  green: 'from-emerald-600 to-meg-accent',
  orange: 'from-orange-600 to-amber-600',
  pink: 'from-rose-600 to-pink-600'
};
---

<section class='relative isolate pt-14 overflow-hidden bg-meg-bg-dark border-b border-meg-border-dark'>
  <!-- Background Gradient -->
  <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
    <div
      class={`relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr ${gradientBg[gradient]} opacity-10 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]`}
      style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
  </div>

  <div class='py-24 sm:py-32 lg:pb-40'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-3xl text-center'>
        <!-- Badge (optional) -->
        {badge && (
          <div class='mt-24 sm:mt-32 lg:mt-16 gsap-fadein'>
            <span class={`inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-sm font-bold text-meg-text-primary-dark shadow-sm`}>
              <i class={`fa-solid ${icon} text-meg-accent`} aria-hidden='true'></i>
              {badge}
            </span>
          </div>
        )}

        <!-- Icon Circle -->
        <div class='gsap-fadein mt-8' style='animation-delay: 0.1s'>
          <div class={`w-20 h-20 mx-auto rounded-2xl bg-meg-surface-dark border border-meg-border-dark flex items-center justify-center shadow-xl shadow-meg-accent/5`}>
            <i class={`fa-solid ${icon} text-meg-accent text-3xl`} aria-hidden='true'></i>
          </div>
        </div>

        <!-- Title with Gradient -->
        <h1 class='text-5xl md:text-7xl font-black tracking-normal text-meg-text-primary-dark mt-6 gsap-fadein' style='animation-delay: 0.2s'>
          <span class="opacity-60 block text-2xl md:text-3xl mb-2">{subtitle}</span>
          <span class={`text-transparent bg-clip-text bg-gradient-to-r ${gradientClasses[gradient]}`}>{title}</span>
        </h1>

        <!-- Description -->
        <p class='mt-6 text-xl leading-8 text-meg-text-secondary gsap-fadein max-w-2xl mx-auto' style='animation-delay: 0.3s'>
          {description}
        </p>

        <!-- CTAs -->
        <div class='mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 gsap-fadein' style='animation-delay: 0.4s'>
          <a
            href='https://portal.waldheim.dev'
            target='_blank'
            rel='noopener noreferrer'
            class={`group px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 hover:scale-[1.02] transition-all duration-300 inline-flex items-center gap-2`}
          >
            <i class='fa-solid fa-calendar-check' aria-hidden='true'></i>
            Jetzt im Portal anfragen
            <i class='fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform' aria-hidden='true'></i>
          </a>
          <a
            href={`${Astro.url.pathname}#leistungen`}
            class={`px-8 py-4 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark font-semibold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all duration-300 inline-flex items-center gap-2`}
          >
            Leistungen ansehen
            <i class='fa-solid fa-arrow-down animate-bounce' aria-hidden='true'></i>
          </a>
        </div>

        <!-- Pricing Badge -->
        <div class='mt-12 gsap-fadein' style='animation-delay: 0.5s'>
          <div class={`inline-flex items-center gap-3 bg-meg-surface-dark/80 backdrop-blur-xl border border-meg-border-dark rounded-2xl px-6 py-3 shadow-sm`}>
            <div class="size-10 rounded-full bg-emerald-500/10 flex items-center justify-center text-emerald-500">
              <i class='fa-solid fa-tag text-lg' aria-hidden='true'></i>
            </div>
            <div class='text-left'>
              <p class='text-meg-text-primary-dark font-black text-lg leading-none'>Ab 70€ / Std.</p>
              <p class='text-meg-text-secondary text-[10px] uppercase tracking-widest font-bold mt-1'>Transparent & fair</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Gradient -->
  <div class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]' aria-hidden='true'>
    <div
      class={`relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr ${gradientBg[gradient]} opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]`}
      style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'>
    </div>
  </div>
</section>
