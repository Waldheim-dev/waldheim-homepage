---
import Text from './Inputs/Text.astro';
import Textarea from './Inputs/Textarea.astro';
import Toggle from './Inputs/Toggle.astro';

if (Astro.request.method === 'POST') {
    try {
        const data = await Astro.request.formData();

        console.log('Form data:', data);
    } catch (error) {
        if (error instanceof Error) {
            console.error(error.message);
        }
    }
}
const { title, image, video } = Astro.props;
---
<div
    class="relative isolate"
>
  <div aria-hidden="true" class="absolute w-full flex justify-center items-center py-12 px-3 md:px-12">
    <figure class="rounded-3xl overflow-hidden relative w-full h-full">
      { image ? <img src={image} class="object-contains w-full brightness-50" alt={title}  loading="lazy"/> : null }
      { video ?
        <video
          class="object-contain w-full brightness-75"
          autoplay
          loop
          muted
        >
          <source
            src={video} type="video/mp4" />
        </video> : null }

    </figure>
  </div>
    <div class="py-24 sm:py-32 lg:pb-40 z-10 relative"><div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center bg-slate-900/30 p-12 rounded-3xl border-1 border-white/30 shadow-md shadow-white/30 backdrop-blur-md  ">
            <form
                method="POST"
                onsubmit="callSubmit()"
                id="contact-form"
                class="relative transform overflow-hidden rounded-3xl px-4 pb-4 pt-5 text-left shadow-lx transition-all sm:my-8 sm:p-6"
            >
                <div>
                    <div
                        class="mx-auto flex size-12 items-center justify-center rounded-full bg-sherpa-blue-100"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="size-6 text-sherpa-blue-600"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 1 0-2.636 6.364M16.5 12V8.25"
                            ></path>
                        </svg>
                    </div>
                    <div class="mt-3 text-center sm:mt-5">
                        <h3
                            class="text-base font-semibold text-gray-100 gsap-fadein"
                            id="modal-title"
                        >
                            Kontaktformular
                        </h3>
                        <div class="mt-2">
                            <p
                                class="text-sm text-gray-100 gsap-fadein"
                            >
                                Ich beantworte deine Fragen - schnell und
                                unkompliziert. Du hast Fragen zu meinen Service
                                oder willst ein Angebot anfordern? Dann fülle
                                einfach das Kontaktformular aus und ich melde
                                mich schnellstmöglich bei dir. Gib mir am besten
                                so viele Details in der Anfrage wie nur möglich,
                                damit ich mich bestmöglich auf deine Anfrage
                                vorbereiten kann.
                            </p>
                        </div>
                    </div>
                    <div class="mt-3 sm:mt-5">
                        <div
                            class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2"
                        >
                            <Text
                                label="Vorname"
                                autocomplete="give-name"
                                name="first_name"
                                className="sm:col-span-1"
                                isRequired="true"
                            />
                            <Text
                                label="Nachname"
                                autocomplete="family-name"
                                name="last_name"
                                className="sm:col-span-1"
                                isRequired="true"
                            />
                            <Text
                                label="Firma"
                                autocomplete="organization"
                                name="company"
                                className="sm:col-span-2"
                            />
                            <Text
                                label="E-Mail"
                                autocomplete="email"
                                name="email"
                                className="sm:col-span-2"
                                isRequired="true"
                            />
                            <Text
                                label="Telefon"
                                name="phone"
                                placeholder="+49 123 4567890"
                                className="sm:col-span-2"
                            />
                            <Textarea
                                label="Deine Anfrage"
                                name="message"
                                rows="4"
                                className="sm:col-span-2"
                                isRequired="true"
                            />
                            <Toggle
                                label="Datenschutzbestimmung"
                                name="privacy"
                                isRequired="true"
                                className="sm:col-span-2"
                                >Ich akzeptiere die <a
                                    href="/datenschutz"
                                    class="font-semibold text-indigo-600  no-underline hover:underline"
                                    >Datenschutz&shy;bestimmungen</a
                                > und willige in die Verarbeitung meiner personenbezogenen
                                Daten ein. Ich bin mir bewusst, dass ich meine Einwilligung
                                jederzeit widerrufen kann unter
                                <a
                                    href="mailto:kontakt@waldheim.dev"
                                    class="font-semibold text-indigo-600  no-underline hover:underline"
                                    >kontakt@waldheim.dev</a
                                >.</Toggle
                            >
                        </div>
                    </div>
                </div>
                <div
                    class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3"
                >
                    <button
                        type="submit"
                        class="gsap-fadein inline-flex w-full justify-center rounded-md bg-sherpa-blue-900 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-sherpa-blue-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 sm:col-start-2"
                        >Absenden</button
                    >
                    <button
                        type="button" onclick="closeContact()"
                        class="gsap-fadein mt-3 inline-flex w-full justify-center rounded-md bg-pancho-200  px-3 py-2 text-sm font-semibold text-gray-900  shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-antique-brass-300  sm:col-start-1 sm:mt-0"
                        >Abbrechen</button
                    >
                </div>
            </form>
        </div>
    </div>
    <script is:inline>
        function callSubmit() {
            const form = document.getElementById('contact-form');
            console.log('Form:', form);
            if (!form) return;
            const formData = new FormData(form);
            for (const [key, value] of formData.entries()) {
                console.log(`${key}: ${value}`);
            }
            const datenObjekt = Object.fromEntries(formData.entries());
            console.log('\nDaten als Objekt:', datenObjekt);

            fetch('https://api-sv.eco-drive.app/api/contact/anonym', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(datenObjekt),
            })
                .then((response) => {
                    if (response.ok) {
                        console.log('Formular erfolgreich gesendet!');
                        window.location.href = window.location.origin + '/danke/';
                    } else {
                        console.error(
                            'Fehler beim Senden des Formulars:',
                            response.statusText,
                        );
                    }
                })
                .catch((error) => {
                    window.location.href = window.location.origin + '/danke/';
                    console.error('Fehler:', error);
                });
        }
    </script>
    </div>
</div>
