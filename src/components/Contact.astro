---
import Text from './Inputs/Text.astro';
import Textarea from './Inputs/Textarea.astro';
import Toggle from './Inputs/Toggle.astro';

if (Astro.request.method === 'POST') {
    try {
        const data = await Astro.request.formData();

        console.log('Form data:', data);
    } catch (error) {
        if (error instanceof Error) {
            console.error(error.message);
        }
    }
}
---

<script is:inline>
    const closeContact = () => {
        const modal = document.getElementById('modal');
        const modalBackdrop = document.getElementById('modal-backdrop');
        const form = document.getElementById('contact-form');
        if (!modal || !modalBackdrop || !form) {
            console.error(
                'Modal or backdrop or form not found!',
                modal,
                modalBackdrop,
                form,
            );
            return;
        }
        modal.classList.add('hidden');
        modalBackdrop.classList.add('ease-out', 'duration-200');
        modalBackdrop.classList.remove('duration-300');
        modalBackdrop.removeAttribute('aria-hidden');
        modalBackdrop.setAttribute('aria-hidden', 'true');
        modalBackdrop.classList.remove('opacity-100');
        modalBackdrop.classList.add('opacity-0', 'hidden');
        form.classList.add(
            'duration-200',
            'translate-y-4',
            'sm:translate-y-0',
            'sm:scale-95',
        );
        form.classList.remove('opacity-100');
        form.classList.remove('ease-out', 'duration-300');
        form.classList.add('opacity-0');
        form.classList.remove('translate-y-0', 'sm:scale-100');
    };
    const openContact = () => {
        const modal = document.getElementById('modal');
        const modalBackdrop = document.getElementById('modal-backdrop');
        const form = document.getElementById('contact-form');
        if (!modal || !modalBackdrop || !form) {
            console.error(
                'Modal or backdrop or form not found!',
                modal,
                modalBackdrop,
                form,
            );
            return;
        }
        modal.classList.remove('hidden');
        modalBackdrop.classList.remove('duration-200', 'hidden');
        modalBackdrop.classList.add('ease-out', 'duration-300');
        modalBackdrop.removeAttribute('aria-hidden');
        modalBackdrop.setAttribute('aria-hidden', 'false');
        modalBackdrop.classList.remove('opacity-0');
        modalBackdrop.classList.add('opacity-100');
        form.classList.add('ease-out', 'duration-300');
        form.classList.remove(
            'duration-200',
            'translate-y-4',
            'sm:translate-y-0',
            'sm:scale-95',
        );
        form.classList.remove('opacity-0');
        form.classList.add('translate-y-0', 'sm:scale-100');
        form.classList.add('opacity-100');
    };
</script>
<div
    class="relative z-10"
    aria-labelledby="modal-title"
    role="dialog"
    aria-modal="true"
>
    <div
        class="fixed inset-0 bg-gray-500/75 dark:bg-slate-900/75 backdrop-blur-xs transition-opacity hidden"
        aria-hidden="true"
        id="modal-backdrop"
        onclick="closeContact()"
    >
    </div>

    <div class="fixed inset-0 z-10 w-screen overflow-y-auto hidden" id="modal">
        <div
            class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0"
        >
            <form
                method="POST"
                onsubmit="callSubmit()"
                id="contact-form"
                class="relative transform overflow-hidden rounded-3xl bg-white dark:bg-slate-900 px-4 pb-4 pt-5 text-left shadow-lx transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6"
            >
                <div>
                    <div
                        class="mx-auto flex size-12 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/20"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="size-6 text-emerald-600"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 1 0-2.636 6.364M16.5 12V8.25"
                            ></path>
                        </svg>
                    </div>
                    <div class="mt-3 text-center sm:mt-5">
                        <h3
                            class="text-base font-semibold text-gray-900 dark:text-white"
                            id="modal-title"
                        >
                            Kontaktformular
                        </h3>
                        <div class="mt-2">
                            <p
                                class="text-sm text-gray-500 dark:text-slate-400"
                            >
                                Ich beantworte deine Fragen - schnell und
                                unkompliziert. Du hast Fragen zu meinen Service
                                oder willst ein Angebot anfordern? Dann fülle
                                einfach das Kontaktformular aus und ich melde
                                mich schnellstmöglich bei dir. Gib mir am besten
                                so viele Details in der Anfrage wie nur möglich,
                                damit ich mich bestmöglich auf deine Anfrage
                                vorbereiten kann.
                            </p>
                        </div>
                    </div>
                    <div class="mt-3 sm:mt-5">
                        <div
                            class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2"
                        >
                            <Text
                                label="Vorname"
                                autocomplete="give-name"
                                name="first_name"
                                className="sm:col-span-1"
                                isRequired="true"
                            />
                            <Text
                                label="Nachname"
                                autocomplete="family-name"
                                name="last_name"
                                className="sm:col-span-1"
                                isRequired="true"
                            />
                            <Text
                                label="Firma"
                                autocomplete="organization"
                                name="company"
                                className="sm:col-span-2"
                            />
                            <Text
                                label="E-Mail"
                                autocomplete="email"
                                name="email"
                                className="sm:col-span-2"
                                isRequired="true"
                            />
                            <Text
                                label="Telefon"
                                name="phone"
                                placeholder="+49 123 4567890"
                                className="sm:col-span-2"
                            />
                            <Textarea
                                label="Deine Anfrage"
                                name="message"
                                rows="4"
                                className="sm:col-span-2"
                                isRequired="true"
                            />
                            <Toggle
                                label="Datenschutzbestimmung"
                                name="privacy"
                                isRequired="true"
                                className="sm:col-span-2"
                                >Ich akzeptiere die <a
                                    href="/datenschutz"
                                    class="font-semibold text-indigo-600 dark:text-blue-500 no-underline hover:underline"
                                    >Datenschutz&shy;bestimmungen</a
                                > und willige in die Verarbeitung meiner personenbezogenen
                                Daten ein. Ich bin mir bewusst, dass ich meine Einwilligung
                                jederzeit widerrufen kann unter
                                <a
                                    href="mailto:kontakt@waldheim.dev"
                                    class="font-semibold text-indigo-600 dark:text-blue-500 no-underline hover:underline"
                                    >kontakt@waldheim.dev</a
                                >.</Toggle
                            >
                        </div>
                    </div>
                </div>
                <div
                    class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3"
                >
                    <button
                        type="submit"
                        class="inline-flex w-full justify-center rounded-md bg-emerald-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 sm:col-start-2"
                        >Absenden</button
                    >
                    <button
                        type="button" onclick="closeContact()"
                        class="mt-3 inline-flex w-full justify-center rounded-md bg-white dark:bg-slate-900 px-3 py-2 text-sm font-semibold text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 dark:hover:bg-slate-800 sm:col-start-1 sm:mt-0"
                        >Abbrechen</button
                    >
                </div>
            </form>
        </div>
    </div>
    <script is:inline>
        function callSubmit() {
            const form = document.getElementById('contact-form');
            console.log('Form:', form);
            if (!form) return;
            const formData = new FormData(form);
            for (const [key, value] of formData.entries()) {
                console.log(`${key}: ${value}`);
            }
            const datenObjekt = Object.fromEntries(formData.entries());
            console.log('\nDaten als Objekt:', datenObjekt);

            fetch('https://api-sv.eco-drive.app/api/contact/anonym', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(datenObjekt),
            })
                .then((response) => {
                    if (response.ok) {
                        console.log('Formular erfolgreich gesendet!');
                        window.location.href = window.location.origin + '/danke/';
                    } else {
                        console.error(
                            'Fehler beim Senden des Formulars:',
                            response.statusText,
                        );
                    }
                })
                .catch((error) => {
                    window.location.href = window.location.origin + '/danke/';
                    console.error('Fehler:', error);
                });
        }
    </script>
</div>
