---
import Text from './Inputs/Text.astro';
import Textarea from './Inputs/Textarea.astro';
import Toggle from './Inputs/Toggle.astro';

const { title, image, video, isEmbedded = false } = Astro.props;
const contactApiUrl = import.meta.env.PUBLIC_CONTACT_API_URL ?? 'https://suite.waldheim.dev/api/v1/management/contact-intake';
const contactIntakeToken = import.meta.env.PUBLIC_CONTACT_INTAKE_TOKEN ?? '';
---
<div class={`relative isolate ${!isEmbedded ? 'py-24 sm:py-32 lg:pb-40' : ''}`}>
  {!isEmbedded && (
    <div aria-hidden="true" class="absolute w-full flex justify-center items-center py-12 px-3 md:px-12">
      <figure class="rounded-3xl overflow-hidden relative w-full h-full">
        { image ? <img src={image} class="object-contains w-full brightness-50" alt={title}  loading="lazy"/> : null }
        { video ?
          <video
            class="object-contain w-full brightness-75"
            autoplay
            loop
            muted
            src={video}
          >
            <source
              src={video} type="video/mp4" />
          </video> : null }
      </figure>
    </div>
  )}
  
  <div class={`${!isEmbedded ? 'mx-auto max-w-7xl px-6 lg:px-8 z-10 relative' : ''}`}>
    <div class={`${!isEmbedded ? 'mx-auto max-w-2xl bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl shadow-sm' : ''}`}>
      <form
          method="POST"
          id="contact-form"
          class="relative transform overflow-hidden transition-all p-6 sm:p-10"
      >
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="absolute -left-[9999px] top-auto h-px w-px opacity-0 pointer-events-none" aria-hidden="true" />
          <input type="hidden" name="submitted_at" id="contact-submitted-at" value="" />
          <div>
              {!isEmbedded && (
                <>
                  <div class="mx-auto flex size-12 items-center justify-center rounded-xl bg-meg-accent/10 border border-meg-accent/30">
                      <i class="fa-solid fa-envelope text-meg-accent text-xl" aria-hidden="true"></i>
                  </div>
                  <div class="mt-6 text-center">
                      <h3 class="text-2xl font-black tracking-tighter text-meg-text-primary-dark gsap-fadein">
                          Kontaktformular
                      </h3>
                      <div class="mt-4">
                          <p class="text-sm text-meg-text-secondary leading-relaxed gsap-fadein">
                              Ich beantworte Ihre Fragen schnell und unkompliziert. Nutze dieses Formular für Projektanfragen oder Support. Ich melde mich zeitnah bei Ihnen zurück.
                          </p>
                      </div>
                  </div>
                </>
              )}
              
              <div class={`${!isEmbedded ? 'mt-10' : ''}`}>
                  <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2">
                      <Text
                          label="Vorname"
                          autocomplete="given-name"
                          name="first_name"
                          className="sm:col-span-1"
                          isRequired="true"
                      />
                      <Text
                          label="Nachname"
                          autocomplete="family-name"
                          name="last_name"
                          className="sm:col-span-1"
                          isRequired="true"
                      />
                      <Text
                          label="Firma"
                          autocomplete="organization"
                          name="company"
                          className="sm:col-span-2"
                      />
                      <Text
                          label="E-Mail"
                          autocomplete="email"
                          name="email"
                          className="sm:col-span-2"
                          isRequired="true"
                      />
                      <Text
                          label="Telefon"
                          name="phone"
                          placeholder="+49 123 4567890"
                          className="sm:col-span-2"
                      />
                      <div class="sm:col-span-2">
                        <label for="inquiry_topic" class="block text-xs font-bold uppercase tracking-wider text-meg-text-secondary mb-2">
                          Gewünschter Bereich / Paket
                        </label>
                        <select
                          id="inquiry_topic"
                          name="inquiry_topic"
                          class="w-full rounded-xl bg-meg-bg-dark/80 border border-meg-border-dark px-4 py-3 text-sm text-meg-text-primary-dark focus:border-meg-accent focus:outline-none"
                        >
                          <option value="Webentwicklung / Website (ab 1.400 €)">Webentwicklung / Website (ab 1.400 €)</option>
                          <option value="Individualsoftware / Kundenportal (ab 4.900 €)">Individualsoftware / Kundenportal (ab 4.900 €)</option>
                          <option value="Waldheim Suite (ERP, CRM, E-Rechnung, WEG, Fuhrpark)">Waldheim Suite (ERP, CRM, E-Rechnung, WEG, Fuhrpark)</option>
                          <option value="KI-Coaching für Entwicklerteams (ab 1.400 €)">KI-Coaching für Entwicklerteams (ab 1.400 €)</option>
                          <option value="DevSecOps, Kubernetes & FinOps (ab 980 €)">DevSecOps, Kubernetes &amp; FinOps (ab 980 €)</option>
                          <option value="IT-Service, Unifi, NAS, M365 & PC-Bau (ab 280 €)">IT-Service, Unifi, NAS, M365 &amp; PC-Bau (ab 280 €)</option>
                          <option value="Smart Home, KNX & Lokale KI (ab 630 €)">Smart Home, KNX &amp; Lokale KI (ab 630 €)</option>
                          <option value="UI/UX-Design & Barrierefreiheit BFSG (ab 490 €)">UI/UX-Design &amp; Barrierefreiheit BFSG (ab 490 €)</option>
                          <option value="Allgemeine Anfrage">Allgemeine Anfrage</option>
                        </select>
                      </div>
                      <Textarea
                          label="Ihre Nachricht (mind. 10 Zeichen)"
                          name="message"
                          rows="4"
                          className="sm:col-span-2"
                          isRequired="true"
                      />
                      <Toggle
                          label="Datenschutzbestimmung"
                          name="privacy"
                          isRequired="true"
                          className="sm:col-span-2 text-xs"
                          >Ich akzeptiere die <a
                              href="/datenschutz/"
                              class="font-bold text-meg-accent hover:underline transition-colors"
                              >Datenschutz&shy;bestimmungen</a
                          > und willige in die Verarbeitung meiner Daten ein.</Toggle
                      >
                  </div>
              </div>
          </div>
          <div class="mt-10">
              <button
                  type="submit"
                  id="submit-btn"
                  class="w-full flex justify-center items-center gap-2 rounded-xl px-6 py-4 text-base font-black text-white bg-meg-accent shadow-xl shadow-meg-accent/20 hover:scale-[1.02] transition-all"
              >
                Anfrage senden
                <i class="fa-solid fa-paper-plane text-xs"></i>
              </button>
              <p id="form-status" class="mt-4 text-center text-sm font-bold hidden"></p>
          </div>
      </form>
    </div>
  </div>

  <script is:inline define:vars={{ contactApiUrl, contactIntakeToken }}>
    (function() {
      const form = document.getElementById('contact-form');
      const status = document.getElementById('form-status');
      const btn = document.getElementById('submit-btn');
      const submittedAtField = document.getElementById('contact-submitted-at');

      if (!form) return;
      if (submittedAtField instanceof HTMLInputElement) {
        submittedAtField.value = String(Date.now() - 3000);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        status.classList.add('hidden');

        const formData = new FormData(form);
        const rawMessage = String(formData.get('message') || '').trim();
        const topic = String(formData.get('inquiry_topic') || '').trim();
        if (rawMessage.length < 10) {
          status.textContent = 'Bitte geben Sie eine Nachricht mit mindestens 10 Zeichen ein.';
          status.classList.remove('hidden');
          status.classList.add('text-amber-400');
          return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i> Ticket &amp; CRM-Kontakt werden angelegt...';
        
        if (submittedAtField instanceof HTMLInputElement && !submittedAtField.value) {
          submittedAtField.value = String(Date.now() - 3000);
          formData.set('submitted_at', submittedAtField.value);
        }
        const data = Object.fromEntries(formData.entries());
        if (topic) {
          data.message = `[Bereich: ${topic}]\n${rawMessage}`;
        }
        if (contactIntakeToken) {
          data.intake_token = contactIntakeToken;
        }

        try {
          const headers = { 'Content-Type': 'application/json' };
          if (contactIntakeToken) {
            headers['X-Intake-Token'] = contactIntakeToken;
          }
          const response = await fetch(contactApiUrl, {
            method: 'POST',
            headers,
            body: JSON.stringify(data),
          });

          if (response.ok) {
            try {
              const resJson = await response.json();
              if (resJson && resJson.ticket_id) {
                sessionStorage.setItem('waldheim_last_ticket_id', String(resJson.ticket_id));
              }
            } catch (_) {}
            window.location.href = '/danke/';
          } else {
            throw new Error('Server-Fehler');
          }
        } catch (error) {
          console.error('Fehler:', error);
          status.innerHTML = 'Die Direktübermittlung zur Suite ist fehlgeschlagen. Sie können Ihre Anfrage direkt per E-Mail an <a href="mailto:kontakt@waldheim.dev" class="underline text-meg-accent">kontakt@waldheim.dev</a> senden.';
          status.classList.remove('hidden');
          status.classList.add('text-rose-400');
          btn.disabled = false;
          btn.innerHTML = 'Anfrage senden <i class="fa-solid fa-paper-plane text-xs"></i>';
        }
      });
    })();
  </script>
</div>