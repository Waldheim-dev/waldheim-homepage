---
import Text from './Inputs/Text.astro';
import Textarea from './Inputs/Textarea.astro';
import Toggle from './Inputs/Toggle.astro';

if (Astro.request.method === 'POST') {
    try {
        const data = await Astro.request.formData();

        console.log('Form data:', data);
    } catch (error) {
        if (error instanceof Error) {
            console.error(error.message);
        }
    }
}
const { title, image, video } = Astro.props;
---
<div
    class="relative isolate"
>
  <div aria-hidden="true" class="absolute w-full flex justify-center items-center py-12 px-3 md:px-12">
    <figure class="rounded-3xl overflow-hidden relative w-full h-full">
      { image ? <img src={image} class="object-contains w-full brightness-50" alt={title}  loading="lazy"/> : null }
      { video ?
        <video
          class="object-contain w-full brightness-75"
          autoplay
          loop
          muted
          src={video}
        >
          <source
            src={video} type="video/mp4" />
        </video> : null }

    </figure>
  </div>
    <div class="py-24 sm:py-32 lg:pb-40 z-10 relative"><div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center bg-dark-900/50 p-12 rounded-2xl border border-blue-500/30 shadow-2xl backdrop-blur-md">
            <form
                method="POST"
                onsubmit="callSubmit()"
                id="contact-form"
                class="relative transform overflow-hidden rounded-2xl px-4 pb-4 pt-5 text-left transition-all sm:my-8 sm:p-6"
            >
                <div>
                    <div
                        class="mx-auto flex size-12 items-center justify-center rounded-xl bg-blue-500/10 border border-blue-500/30"
                    >
                        <i class="fa-solid fa-envelope text-blue-400 text-xl" aria-hidden="true"></i>
                    </div>
                    <div class="mt-3 text-center sm:mt-5">
                        <h3
                            class="text-xl font-bold text-white gsap-fadein"
                            id="modal-title"
                        >
                            Kontaktformular
                        </h3>
                        <div class="mt-2">
                            <p
                                class="text-sm text-light-300 gsap-fadein"
                            >
                                Ich beantworte deine Fragen - schnell und
                                unkompliziert. Du hast Fragen zu meinen Service
                                oder willst ein Angebot anfordern? Dann fülle
                                einfach das Kontaktformular aus und ich melde
                                mich schnellstmöglich bei dir. Gib mir am besten
                                so viele Details in der Anfrage wie nur möglich,
                                damit ich mich bestmöglich auf deine Anfrage
                                vorbereiten kann.
                            </p>
                        </div>
                    </div>
                    <div class="mt-3 sm:mt-5">
                        <div
                            class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2"
                        >
                            <Text
                                label="Vorname"
                                autocomplete="give-name"
                                name="first_name"
                                className="sm:col-span-1"
                                isRequired="true"
                            />
                            <Text
                                label="Nachname"
                                autocomplete="family-name"
                                name="last_name"
                                className="sm:col-span-1"
                                isRequired="true"
                            />
                            <Text
                                label="Firma"
                                autocomplete="organization"
                                name="company"
                                className="sm:col-span-2"
                            />
                            <Text
                                label="E-Mail"
                                autocomplete="email"
                                name="email"
                                className="sm:col-span-2"
                                isRequired="true"
                            />
                            <Text
                                label="Telefon"
                                name="phone"
                                placeholder="+49 123 4567890"
                                className="sm:col-span-2"
                            />
                            <Textarea
                                label="Deine Anfrage"
                                name="message"
                                rows="4"
                                className="sm:col-span-2"
                                isRequired="true"
                            />
                            <Toggle
                                label="Datenschutzbestimmung"
                                name="privacy"
                                isRequired="true"
                                className="sm:col-span-2"
                                >Ich akzeptiere die <a
                                    href="/datenschutz"
                                    class="font-semibold text-blue-400 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 no-underline hover:underline hover:text-blue-300 transition-colors"
                                    >Datenschutz&shy;bestimmungen</a
                                > und willige in die Verarbeitung meiner personenbezogenen
                                Daten ein. Ich bin mir bewusst, dass ich meine Einwilligung
                                jederzeit widerrufen kann unter
                                <a
                                    href="mailto:kontakt@waldheim.dev"
                                    class="font-semibold text-blue-400 rounded focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 no-underline hover:underline hover:text-blue-300 transition-colors"
                                    >kontakt@waldheim.dev</a
                                >.</Toggle
                            >
                        </div>
                    </div>
                </div>
                <div
                    class="mt-5 sm:mt-6 sm:grid sm:grid-flow-row-dense sm:grid-cols-2 sm:gap-3"
                >
                    <button
                        type="submit"
                        class="gsap-fadein inline-flex w-full justify-center rounded-xl px-6 py-3 text-sm font-semibold text-white bg-primary-800 hover:bg-primary-800 shadow-lg hover:shadow-lg hover:shadow-primary-500/50 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500 sm:col-start-2"
                        >Absenden</button
                    >
                    <button
                        type="button" onclick="closeContact()"
                        class="gsap-fadein mt-3 inline-flex w-full justify-center rounded-xl bg-dark-800 border border-light-500/20 px-3 py-2 text-sm font-semibold text-light-200 hover:bg-dark-700 hover:border-light-500/30 transition-all duration-300 sm:col-start-1 sm:mt-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
                        >Abbrechen</button
                    >
                </div>
            </form>
        </div>
    </div>
    <script is:inline>
        function callSubmit() {
            const form = document.getElementById('contact-form');
            console.log('Form:', form);
            if (!form) return;
            const formData = new FormData(form);
            for (const [key, value] of formData.entries()) {
                console.log(`${key}: ${value}`);
            }
            const datenObjekt = Object.fromEntries(formData.entries());
            console.log('\nDaten als Objekt:', datenObjekt);

            fetch('https://api-sv.eco-drive.app/api/contact/anonym', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(datenObjekt),
            })
                .then((response) => {
                    if (response.ok) {
                        console.log('Formular erfolgreich gesendet!');
                        window.location.href = window.location.origin + '/danke/';
                    } else {
                        console.error(
                            'Fehler beim Senden des Formulars:',
                            response.statusText,
                        );
                    }
                })
                .catch((error) => {
                    window.location.href = window.location.origin + '/danke/';
                    console.error('Fehler:', error);
                });
        }
    </script>
    </div>
</div>
