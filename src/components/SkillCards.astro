---
import { getCollection } from 'astro:content';
import SkillFlipCard from './SkillFlipCard.astro';
const { skills } = Astro.props;

const skillsCollection = await getCollection('skills', ({ data }) =>
  (skills as string[]).find((sk) => {
    return sk.id.toLowerCase() === data.name.toLowerCase();
  })
);
---

<div class="grid grid-cols-2 gap-2 mt-4 sm:mx-0 md:grid-cols-5">
  {skillsCollection.map((skill) => <SkillFlipCard entry={skill} />)}
</div>
