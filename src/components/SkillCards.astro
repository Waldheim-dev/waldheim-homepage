---
// This code has been partially generated by an AI.
import { getCollection } from 'astro:content';
import SkillFlipCard from './SkillFlipCard.astro';
const { skills } = Astro.props;

const skillsCollection = await getCollection('skills', ({ id, data }) =>
  (skills as any[]).find((sk) => {
    const rawId = typeof sk === 'string' ? sk : sk.id;
    const cleanTarget = rawId.replace(/^_/, '').toLowerCase();
    const cleanEntryId = id.replace(/^_/, '').toLowerCase();
    return cleanTarget === cleanEntryId || cleanTarget === data.name.toLowerCase();
  })
);
---

<div class="grid grid-cols-2 gap-2 mt-4 sm:mx-0 md:grid-cols-5">
  {skillsCollection.map((skill) => <SkillFlipCard entry={skill} />)}
</div>
