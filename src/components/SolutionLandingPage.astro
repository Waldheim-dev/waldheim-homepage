---
// This code has been fully generated by an AI.
import Layout from '../layouts/Layout.astro';
import ServiceHero from './ServiceHero.astro';
import AnswerFirstBox from './AnswerFirstBox.astro';
import ServicePackagesGrid from './ServicePackagesGrid.astro';
import PromoSuite from './PromoSuite.astro';
import PromoServices from './PromoServices.astro';
import { SchemaUtils } from '../utils/schema';
import type { SolutionPageData } from '../consts/seoTypes';

export interface Props {
  page: SolutionPageData;
  relatedPages?: SolutionPageData[];
}

const { page, relatedPages = [] } = Astro.props;

const basePath = page.section === 'suite' ? '/suite' : '/services';
const pageUrl = `https://www.waldheim.dev${basePath}/${page.slug}/`;
const parentName = page.section === 'suite' ? 'Waldheim Suite' : 'Services';
const parentUrl = `https://www.waldheim.dev${basePath}/`;

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://www.waldheim.dev/' },
  { name: parentName, link: parentUrl },
  { name: page.breadcrumbLabel, link: pageUrl },
]);

const faqSchema = SchemaUtils.getFAQSchema(page.faqs);

const mainEntitySchema =
  page.section === 'suite'
    ? {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: page.schemaName,
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web',
        description: page.description,
        url: pageUrl,
        author: {
          '@type': 'Organization',
          name: 'Waldheim.dev',
          url: 'https://www.waldheim.dev/',
        },
        offers: {
          '@type': 'Offer',
          price: String(page.startingPriceEur),
          priceCurrency: 'EUR',
          availability: 'https://schema.org/OnlineOnly',
          description: `${page.priceLabel} – ${page.durationLabel}`,
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: page.schemaName,
        serviceType: page.schemaName,
        description: page.description,
        url: pageUrl,
        provider: {
          '@type': 'ProfessionalService',
          name: 'Waldheim.dev - Markus Waldheim',
          url: 'https://www.waldheim.dev/',
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Augsburg',
            addressRegion: 'Bayern',
            addressCountry: 'DE',
          },
        },
        areaServed: [
          { '@type': 'City', name: 'Augsburg' },
          { '@type': 'City', name: 'München' },
          { '@type': 'AdministrativeArea', name: 'Bayern' },
          { '@type': 'Country', name: 'Deutschland' },
        ],
        offers: {
          '@type': 'Offer',
          price: String(page.startingPriceEur),
          priceCurrency: 'EUR',
          description: `${page.priceLabel} · Projektdauer: ${page.durationLabel}`,
        },
      };

const heroGradientMap: Record<string, 'blue' | 'purple' | 'green' | 'orange' | 'rose'> = {
  blue: 'blue',
  purple: 'purple',
  green: 'green',
  orange: 'orange',
  rose: 'rose',
  yellow: 'orange',
  cyan: 'blue',
  indigo: 'purple',
};

const heroGradient = heroGradientMap[page.accentColor] || 'blue';
---

<Layout
  title={page.title}
  description={page.description}
  keywords={page.keywords}
  schema={[mainEntitySchema, breadCrumbSchema, faqSchema]}
>
  <nav class="py-4 px-6 bg-meg-bg-dark border-b border-meg-border-dark/40" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-meg-text-secondary">
        <li>
          <a href="/" class="hover:text-meg-accent transition-colors font-semibold">Startseite</a>
        </li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li>
          <a href={`${basePath}/`} class="hover:text-meg-accent transition-colors font-semibold">{parentName}</a>
        </li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li class="text-meg-accent font-bold">{page.breadcrumbLabel}</li>
      </ol>
    </div>
  </nav>

  <main id="main-content">
    <ServiceHero
      title={page.h1Title}
      subtitle={page.h1Subtitle}
      description={page.heroDesc}
      gradient={heroGradient}
      icon={page.icon}
      badge={page.badge}
    />

    <!-- Antwort zuerst: Direkt zitierbarer Block für Google & KI-Assistenten (GEO) -->
    <AnswerFirstBox
      question={page.question}
      directAnswer={page.directAnswer}
      price={page.priceLabel}
      priceSubtext={page.priceSubtext}
      duration={page.durationLabel}
      durationSubtext={page.durationSubtext}
      deliverable={page.deliverableLabel}
      location={page.locationLabel}
      accentColor={page.accentColor}
      primaryCtaText={page.section === 'suite' ? 'Suite 14 Tage kostenlos testen' : 'Kostenloses Erstgespräch buchen'}
      primaryCtaHref={page.section === 'suite' ? 'https://suite.waldheim.dev' : 'https://calendly.com/markus-waldheim/30min'}
      secondaryCtaText="Pakete & Preise ansehen"
      secondaryCtaHref="#pakete"
    />

    <!-- Konkrete Festpreis- & Einstiegspakete -->
    <ServicePackagesGrid
      heading={page.packagesHeading}
      subheading={page.packagesSubheading}
      packages={page.packages}
      accentColor={page.accentColor}
      footnote={
        page.section === 'suite'
          ? 'Alle Suite-Tarife sind monatlich kündbar, DSGVO-konform auf deutschen Servern gehostet und starten mit einer 14-tägigen Testphase. KI-Funktionen nutzen Bring Your Own AI (eigener API-Key oder lokales Ollama) – volle Kostenkontrolle ohne versteckte Token-Aufschläge.'
          : 'Alle Preise sind transparente Festpreis-Pakete inkl. unserer internen KI-Engineering- & Review-Beschleunigung (Basis: 70 € / Std., gemäß § 19 UStG umsatzsteuerbefreit – Netto = Brutto). Laufende Drittanbieter-/KI-API-Kosten im Kundenbetrieb erfolgen über eigene Kunden-Keys (BYO-AI).'
      }
    />

    <!-- Leistungen & Mehrwert im Detail -->
    <section class="py-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark/60" aria-labelledby="deliverables-heading">
      <div class="mx-auto max-w-7xl">
        <header class="mx-auto max-w-3xl text-center mb-14 gsap-fadein">
          <p class="text-xs font-black uppercase tracking-[0.2em] text-meg-accent mb-3">
            Was Sie konkret erhalten
          </p>
          <h2 id="deliverables-heading" class="text-3xl sm:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
            {page.valuePropsHeading}
          </h2>
          <p class="text-lg text-meg-text-secondary">
            Keine vagen Versprechen: Jedes Ergebnis ist technisch messbar, dokumentiert und auf schnellen Return on Investment ausgelegt.
          </p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {page.valueProps.map((vp) => (
            <article class="gsap-fadein rounded-2xl bg-meg-surface-dark/50 border border-meg-border-dark p-7 hover:border-meg-accent/40 transition-all">
              <div class="size-12 rounded-xl bg-meg-accent/10 border border-meg-accent/20 flex items-center justify-center text-meg-accent mb-5">
                <i class={`fa-solid ${vp.icon} text-xl`} aria-hidden="true"></i>
              </div>
              <h3 class="text-lg font-bold text-meg-text-primary-dark mb-2.5">{vp.title}</h3>
              <p class="text-sm text-meg-text-secondary leading-relaxed">{vp.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Ablauf & Zeitplan + Vergleichstabelle -->
    <section class="py-20 px-6 bg-meg-surface-dark/20 border-b border-meg-border-dark/60" aria-labelledby="process-comparison-heading">
      <div class="mx-auto max-w-7xl grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Ablauf in 4 klaren Schritten -->
        <div>
          <p class="text-xs font-black uppercase tracking-[0.2em] text-emerald-400 mb-3">
            Planbarer Projektablauf
          </p>
          <h2 id="process-comparison-heading" class="text-3xl font-black tracking-tight text-meg-text-primary-dark mb-6">
            Von der Anfrage bis zum Go-Live in 4 Schritten
          </h2>
          <ol class="space-y-4">
            {page.processSteps.map((step, idx) => (
              <li class="rounded-2xl bg-meg-surface-dark/60 border border-meg-border-dark p-5 flex gap-4">
                <div class="size-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-black flex items-center justify-center shrink-0">
                  {idx + 1}
                </div>
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <h3 class="font-bold text-meg-text-primary-dark">{step.title}</h3>
                    <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-meg-bg-dark border border-meg-border-dark text-meg-accent">
                      {step.duration}
                    </span>
                  </div>
                  <p class="text-sm text-meg-text-secondary leading-relaxed">{step.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!--Direkter Vergleich: Waldheim vs. Status Quo -->
        <div class="rounded-3xl bg-meg-surface-dark/70 border border-meg-border-dark p-6 sm:p-8">
          <p class="text-xs font-black uppercase tracking-[0.2em] text-meg-accent mb-2">
            Entscheidungshilfe
          </p>
          <h3 class="text-2xl font-black text-meg-text-primary-dark mb-6">
            Warum {page.section === 'suite' ? 'die Waldheim Suite' : 'Waldheim.dev'} statt klassischer Alternativen?
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="border-b border-meg-border-dark text-xs uppercase tracking-wider text-meg-text-secondary">
                  <th class="py-3 pr-3">Kriterium</th>
                  <th class="py-3 px-3 text-emerald-400 font-black">Waldheim.dev</th>
                  <th class="py-3 pl-3 text-meg-text-secondary">Klassischer Markt</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-meg-border-dark/60">
                {page.comparisonRows.map((row) => (
                  <tr>
                    <td class="py-3.5 pr-3 font-bold text-meg-text-primary-dark">{row.criteria}</td>
                    <td class="py-3.5 px-3 text-emerald-400 font-semibold">{row.waldheim}</td>
                    <td class="py-3.5 pl-3 text-meg-text-secondary">{row.statusQuo}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Häufige Kundenfragen (FAQ für Featured Snippets & GEO) -->
    <section class="py-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark/60" id="faq" aria-labelledby="faq-heading">
      <div class="mx-auto max-w-4xl">
        <header class="text-center mb-12">
          <p class="text-xs font-black uppercase tracking-[0.2em] text-meg-accent mb-3">
            Direkte Antworten auf häufige Fragen
          </p>
          <h2 id="faq-heading" class="text-3xl sm:text-4xl font-black tracking-tight text-meg-text-primary-dark">
            Häufig gestellte Fragen zu {page.breadcrumbLabel}
          </h2>
        </header>
        <div class="space-y-4">
          {page.faqs.map((faq) => (
            <article class="rounded-2xl bg-meg-surface-dark/50 border border-meg-border-dark p-6">
              <h3 class="text-lg font-bold text-meg-text-primary-dark mb-2 flex items-start gap-3">
                <i class="fa-solid fa-circle-question text-meg-accent mt-1 shrink-0" aria-hidden="true"></i>
                <span>{faq.question}</span>
              </h3>
              <p class="text-sm text-meg-text-secondary leading-relaxed pl-7">
                {faq.answer}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Verwandte Fragen & Lösungen (Interne Verlinkung / Themencluster) -->
    {relatedPages.length > 0 && (
      <section class="py-16 px-6 bg-meg-bg-dark border-b border-meg-border-dark/60" aria-labelledby="related-solutions-heading">
        <div class="mx-auto max-w-7xl">
          <h2 id="related-solutions-heading" class="text-2xl font-black text-meg-text-primary-dark mb-8">
            Weitere Antworten, Kostenübersichten &amp; Lösungen
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPages.map((rel) => {
              const relBase = rel.section === 'suite' ? '/suite' : '/services';
              return (
                <a
                  href={`${relBase}/${rel.slug}/`}
                  class="group rounded-2xl bg-meg-surface-dark/45 border border-meg-border-dark p-6 hover:border-meg-accent/50 transition-all flex flex-col justify-between"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class="text-xs font-black text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full">
                        {rel.priceLabel}
                      </span>
                      <span class="text-xs text-meg-text-secondary font-semibold">
                        <i class="fa-solid fa-clock mr-1" aria-hidden="true"></i>{rel.durationLabel}
                      </span>
                    </div>
                    <h3 class="text-lg font-bold text-meg-text-primary-dark group-hover:text-meg-accent transition-colors mb-2">
                      {rel.h1Title}
                    </h3>
                    <p class="text-xs text-meg-text-secondary leading-relaxed line-clamp-3">
                      {rel.directAnswer}
                    </p>
                  </div>
                  <span class="mt-4 inline-flex items-center gap-2 text-xs font-bold text-meg-accent">
                    <span>Preis &amp; Details ansehen</span>
                    <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    {page.section === 'suite' ? <PromoServices /> : <PromoSuite />}
  </main>
</Layout>
