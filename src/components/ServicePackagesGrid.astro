---
// This code has been fully generated by an AI.
export interface PackageItem {
  name: string;
  badge?: string;
  price: string;
  priceUnit?: string;
  duration: string;
  idealFor: string;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
  highlighted?: boolean;
}

export interface Props {
  lang?: 'de' | 'en';
  eyebrow?: string;
  heading: string;
  subheading: string;
  packages: PackageItem[];
  accentColor?: 'blue' | 'purple' | 'green' | 'orange' | 'rose' | 'yellow' | 'cyan' | 'indigo';
  footnote?: string;
}

const {
  eyebrow = 'Preise, Pakete & Projektdauer',
  heading,
  subheading,
  packages,
  accentColor = 'blue',
  footnote = 'Alle Paketpreise kalkulieren unsere eigene KI-Engineering- & Review-Infrastruktur bereits gewinnbringend ein (Basis: 70 € / Std., gemäß § 19 UStG ohne Umsatzsteuer – Netto = Brutto). Laufende KI-API-/Token-Kosten im späteren Kundenbetrieb laufen kostensicher über Ihre eigenen API-Keys (BYO-AI) oder lokale Hardware.',
} = Astro.props;

const accentStyles = {
  blue: {
    text: 'text-meg-accent',
    border: 'border-meg-accent/50',
    badge: 'bg-meg-accent/15 text-meg-accent border-meg-accent/30',
    btn: 'bg-meg-accent text-slate-950 hover:shadow-meg-accent/30',
  },
  purple: {
    text: 'text-violet-400',
    border: 'border-violet-500/50',
    badge: 'bg-violet-500/15 text-violet-400 border-violet-500/30',
    btn: 'bg-violet-500 text-white hover:shadow-violet-500/30',
  },
  green: {
    text: 'text-emerald-400',
    border: 'border-emerald-500/50',
    badge: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30',
    btn: 'bg-emerald-500 text-slate-950 hover:shadow-emerald-500/30',
  },
  orange: {
    text: 'text-orange-400',
    border: 'border-orange-500/50',
    badge: 'bg-orange-500/15 text-orange-400 border-orange-500/30',
    btn: 'bg-orange-500 text-slate-950 hover:shadow-orange-500/30',
  },
  rose: {
    text: 'text-rose-400',
    border: 'border-rose-500/50',
    badge: 'bg-rose-500/15 text-rose-400 border-rose-500/30',
    btn: 'bg-rose-500 text-white hover:shadow-rose-500/30',
  },
  yellow: {
    text: 'text-yellow-400',
    border: 'border-yellow-500/50',
    badge: 'bg-yellow-500/15 text-yellow-400 border-yellow-500/30',
    btn: 'bg-yellow-500 text-slate-950 hover:shadow-yellow-500/30',
  },
  cyan: {
    text: 'text-cyan-400',
    border: 'border-cyan-500/50',
    badge: 'bg-cyan-500/15 text-cyan-400 border-cyan-500/30',
    btn: 'bg-cyan-500 text-slate-950 hover:shadow-cyan-500/30',
  },
  indigo: {
    text: 'text-indigo-400',
    border: 'border-indigo-500/50',
    badge: 'bg-indigo-500/15 text-indigo-400 border-indigo-500/30',
    btn: 'bg-indigo-500 text-white hover:shadow-indigo-500/30',
  },
};

const theme = accentStyles[accentColor] || accentStyles.blue;
---

<section class="py-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark/60" id="pakete" aria-labelledby="packages-heading">
  <div class="mx-auto max-w-7xl">
    <header class="mx-auto max-w-3xl text-center mb-14 gsap-fadein">
      <p class={`text-xs font-black uppercase tracking-[0.2em] ${theme.text} mb-3`}>
        {eyebrow}
      </p>
      <h2 id="packages-heading" class="text-3xl sm:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
        {heading}
      </h2>
      <p class="text-lg text-meg-text-secondary leading-relaxed">
        {subheading}
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg, idx) => (
        <article
          class={`gsap-fadein rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 ${
            pkg.highlighted
              ? `bg-meg-surface-dark/80 border-2 ${theme.border} shadow-2xl relative`
              : 'bg-meg-surface-dark/45 border border-meg-border-dark hover:border-meg-accent/30'
          }`}
          style={`animation-delay: ${0.08 * (idx + 1)}s`}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <h3 class="text-2xl font-black text-meg-text-primary-dark">{pkg.name}</h3>
              {pkg.badge && (
                <span class={`text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full border ${theme.badge}`}>
                  {pkg.badge}
                </span>
              )}
            </div>

            <p class="text-sm text-meg-text-secondary mb-6 min-h-[2.5rem]">
              {pkg.idealFor}
            </p>

            <div class="p-4 rounded-2xl bg-meg-bg-dark/80 border border-meg-border-dark mb-6">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl sm:text-4xl font-black tracking-tight text-meg-text-primary-dark">
                  {pkg.price}
                </span>
                {pkg.priceUnit && (
                  <span class="text-xs font-bold text-meg-text-secondary">
                    {pkg.priceUnit}
                  </span>
                )}
              </div>
              <div class="mt-2 flex items-center gap-2 text-xs font-bold text-emerald-400">
                <i class="fa-solid fa-clock" aria-hidden="true"></i>
                <span>Dauer / Go-Live: {pkg.duration}</span>
              </div>
            </div>

            <ul class="space-y-3 mb-8 text-sm text-meg-text-secondary">
              {pkg.features.map((feat) => (
                <li class="flex items-start gap-2.5">
                  <i class={`fa-solid fa-circle-check ${theme.text} mt-1 shrink-0`} aria-hidden="true"></i>
                  <span class="text-meg-text-primary-dark/90">{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={pkg.ctaHref || '/kontakt/'}
            target={pkg.ctaHref?.startsWith('http') ? '_blank' : undefined}
            rel={pkg.ctaHref?.startsWith('http') ? 'noopener noreferrer' : undefined}
            class={`w-full py-3.5 px-6 rounded-xl font-black text-sm text-center inline-flex items-center justify-center gap-2 transition-all duration-300 ${
              pkg.highlighted
                ? `${theme.btn} shadow-lg hover:scale-[1.02]`
                : 'bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark hover:border-meg-accent/50'
            }`}
          >
            <span>{pkg.ctaText || 'Paket unverbindlich anfragen'}</span>
            <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
          </a>
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-xs text-meg-text-secondary max-w-3xl mx-auto italic">
      {footnote}
    </p>
  </div>
</section>
