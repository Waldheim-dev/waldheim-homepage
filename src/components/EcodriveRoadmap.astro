---
import { getCollection } from 'astro:content';
const versions = (await getCollection('roadmap'))
.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0s'>
        Entwicklungszyklus
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Die <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Zukunft</span> von Ecodrive
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto' style='animation-delay: 0.3s'>
        Geplante Meilensteine und Updates – transparent für unsere User.
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-8'>
      {versions.map(({data}, index) => {
        const date = new Date(data.date);
        const dateString = date.toISOString().split('T')[0];
        return (
          <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 transition-all duration-300 group shadow-sm flex flex-col' style={`animation-delay: ${0.45 + index * 0.1}s`}>
            <time datetime={dateString} class='flex items-center text-[10px] font-black uppercase tracking-widest text-emerald-400 mb-6'>
              <i class='fa-solid fa-calendar mr-2' aria-hidden='true'></i>
              {date.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' })}
            </time>
            
            <div class={`flex items-center gap-2 rounded-lg px-3 py-1.5 border mb-6 shadow-inner w-fit ${
              data.planned 
                ? 'bg-meg-bg-dark/50 border-meg-border-dark text-meg-text-secondary' 
                : 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400'
            }`}>
              <i class={`fa-solid ${data.planned ? 'fa-clock text-meg-accent' : 'fa-check-circle'} text-[10px]`}></i>
              <span class='text-[10px] font-black uppercase tracking-widest'>{data.planned ? 'Planned' : 'Live'}</span>
            </div>
            
            <p class='text-lg font-bold text-meg-text-primary-dark mb-3'>Release v{data.version}</p>
            <p class='text-meg-text-secondary text-sm leading-relaxed flex-1'>{data.description}</p>
          </div>
        );
      })}
    </div>

    <div class='mt-16 text-center gsap-fadein bg-meg-surface-dark/80 backdrop-blur-xl border-2 border-emerald-500/20 rounded-2xl p-10 shadow-2xl shadow-emerald-500/5' style='animation-delay: 0.9s'>
      <i class='fa-solid fa-lightbulb text-emerald-400 text-4xl mb-6' aria-hidden='true'></i>
      <h3 class='text-2xl font-black text-meg-text-primary-dark mb-4 tracking-tight'>Feature-Wünsche?</h3>
      <p class='text-meg-text-secondary mb-10 max-w-2xl mx-auto'>
        Ihre Meinung zählt! Teilen Sie uns Ihre Ideen mit – wir setzen die besten Vorschläge um.
      </p>
      <a
        href='https://portal.waldheim.dev'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-2 px-8 py-3 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold rounded-xl hover:border-emerald-500/50 transition-all'
      >
        <i class='fa-solid fa-comment' aria-hidden='true'></i>
        Feedback im Portal geben
      </a>
    </div>
  </div>
</section>