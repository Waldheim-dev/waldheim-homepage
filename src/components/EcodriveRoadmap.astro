---
import { getCollection } from 'astro:content';
const versions = (await getCollection('roadmap'))
.sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());
---

<section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-900 to-dark-950'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-base font-semibold text-green-400 mb-4' style='animation-delay: 0s'>
        <i class='fa-solid fa-map text-green-400 mr-2' aria-hidden='true'></i>
        Product Roadmap
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
        Die <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>Zukunft</span> von Ecodrive
      </p>
      <p class='gsap-fadein text-xl text-light-300' style='animation-delay: 0.3s'>
        Geplante Features und Updates – transparent und nachvollziehbar
      </p>
    </div>

    <div class='grid md:grid-cols-2 lg:grid-cols-4 gap-8'>
      {versions.map(({data}, index) => {
        const date = new Date(data.date);
        const dateString = date.toISOString().split('T')[0]; // Convert to ISO date string YYYY-MM-DD
        return (
          <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-6 hover:border-green-500/40 transition-all duration-300' style={`animation-delay: ${0.45 + index * 0.1}s`}>
            <time datetime={dateString} class='flex items-center text-sm font-semibold text-green-400 mb-4'>
              <i class='fa-solid fa-calendar mr-2' aria-hidden='true'></i>
              {date.toLocaleDateString('de-DE', { month: 'long', year: 'numeric' })}
            </time>
            
            {data.planned ? (
              <div class='flex items-start gap-3 bg-blue-500/10 border border-blue-500/30 rounded-lg p-3 mb-4'>
                <i class='fa-solid fa-clock text-blue-400 mt-0.5' aria-label='Geplant' role='img'></i>
                <p class='text-sm font-medium text-blue-400'>Version geplant</p>
              </div>
            ) : (
              <div class='flex items-start gap-3 bg-green-500/10 border border-green-500/30 rounded-lg p-3 mb-4'>
                <i class='fa-solid fa-check-circle text-green-400 mt-0.5' aria-label='Verfügbar' role='img'></i>
                <p class='text-sm font-medium text-green-400'>Version verfügbar</p>
              </div>
            )}
            
            <p class='text-xl font-bold text-white mb-2'>Release v{data.version}</p>
            <p class='text-sm text-light-300'>{data.description}</p>
          </div>
        );
      })}
    </div>

    <div class='mt-16 text-center gsap-fadein bg-gradient-to-r from-green-900/20 to-emerald-900/20 border border-green-500/30 rounded-2xl p-8' style='animation-delay: 0.9s'>
      <i class='fa-solid fa-lightbulb text-green-400 text-4xl mb-4' aria-hidden='true'></i>
      <h3 class='text-2xl font-bold text-white mb-3'>Feature-Wünsche?</h3>
      <p class='text-lg text-light-300 max-w-2xl mx-auto mb-6'>
        Ihre Meinung zählt! Teilen Sie uns Ihre Ideen und Feature-Wünsche mit – wir setzen die besten Vorschläge in die Tat um.
      </p>
      <a
        href='/kontakt'
        class='inline-flex items-center gap-2 px-6 py-3 bg-green-500/10 border border-green-500/30 text-green-300 font-bold rounded-lg hover:shadow-lg hover:shadow-green-400/50 transition-all duration-300'
      >
        <i class='fa-solid fa-comment' aria-hidden='true'></i>
        Feedback geben
      </a>
    </div>
  </div>
</section>