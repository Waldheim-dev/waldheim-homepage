---

<div class="bg-meg-bg-dark">
  <div class="mx-auto max-w-7xl py-24 px-2 sm:px-6 sm:py-32 lg:px-8">
    <div class="relative gsap-fadein isolate group">
      <div
        class="absolute -inset-0.5 bg-gradient-to-r from-emerald-500/20 to-meg-accent/20 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-1000" />
      <div
        class="relative isolate overflow-hidden bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark px-6 pt-16 shadow-sm rounded-2xl sm:px-16 md:pt-24 lg:flex lg:gap-x-20 lg:px-24 lg:pt-0"
      >
        <div
          class="mx-auto max-w-md text-center lg:mx-0 lg:flex-auto lg:py-32 lg:text-left"
        >
          <h2
            class="text-3xl font-black tracking-tighter text-meg-text-primary-dark sm:text-4xl"
          >
            Bewusster fahren, Umwelt schonen – mit Ecodrive
          </h2>
          <p class="mt-6 text-lg leading-8 text-meg-text-secondary">
            Erhalten Sie wertvolle Einblicke in Ihr Fahrverhalten und entdecken Sie, wie Sie nachhaltiger und effizienter unterwegs sein können.
          </p>
          <div
            class="mt-10 flex items-center justify-center gap-x-6 lg:justify-start"
          >
            <a
              href="https://www.eco-drive.app"
              class="rounded-xl bg-emerald-600 px-6 py-3 gsap-wiggle text-sm font-bold text-white shadow-xl shadow-emerald-500/20 hover:scale-[1.02] transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500"
            >Kostenlos starten</a>
            <a
              href="/ecodrive/"
              class="text-sm font-bold leading-6 text-meg-text-primary-dark hover:text-meg-accent transition-colors"
            >Details ansehen <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="relative mt-16 h-80 lg:mt-8">
          <img
            class="absolute left-0 top-0 w-[57rem] max-w-none rounded-xl bg-meg-bg-dark shadow-2xl ring-1 ring-meg-border-dark opacity-90 group-hover:opacity-100 transition-opacity duration-500"
            src="/referenzen/waldheim-dev/ecodrive/ecodrive_dashboard_light.png"
            alt="Ecodrive Dashboard Preview"
            loading="lazy"
            width="1824"
            height="1080"
          />
        </div>
      </div>
    </div>
  </div>
</div>