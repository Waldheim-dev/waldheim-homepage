---
const testimonials = [
  {
    quote: 'Silvacore hat unsere WEG-Verwaltung revolutioniert. Die Nebenkostenabrechnung ist jetzt in 30 Minuten erledigt – früher brauchten wir einen ganzen Arbeitstag!',
    author: 'Maria Schmidt',
    role: 'Property Managerin, 12 WEGs',
    image: '/markus/portrait.webp'
  },
  {
    quote: 'Endlich verstehe ich, wohin meine Nebenkosten fließen. Die monatlichen Verbrauchsberichte sind Gold wert.',
    author: 'Thomas Müller',
    role: 'Eigentümer in München',
    image: '/markus/portrait.webp'
  },
  {
    quote: 'Der Preis ist unschlagbar. Für 45 € manage ich 10 WEGs – früher zahlte ich 300 € bei meinem alten Anbieter.',
    author: 'Petra Klein',
    role: 'Kleine Hausverwaltung',
    image: '/markus/portrait.webp'
  }
];
---

<div class="py-24 sm:py-32 bg-meg-bg-dark">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-sm font-bold uppercase tracking-widest text-emerald-400 gsap-fadein">
        Kundenstimmen
      </h2>
      <p class="mt-2 text-3xl font-black tracking-tighter text-meg-text-primary-dark sm:text-4xl gsap-fadein">
        Das sagen unsere Kunden
      </p>
    </div>
    
    <div class="mx-auto mt-16 flow-root max-w-2xl sm:mt-20 lg:mx-0 lg:max-w-none">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((testimonial, index) => (
          <div class="flex flex-col justify-between rounded-2xl bg-meg-surface-dark/50 backdrop-blur-xl p-10 border border-meg-border-dark gsap-fadein shadow-sm group hover:border-emerald-500/30 transition-all" style={`animation-delay: ${index * 0.1}s`}>
            <div>
              <div class="flex gap-x-1 text-emerald-400 mb-6">
                {[...Array(5)].map(() => <i class="fa-solid fa-star text-[10px]"></i>)}
              </div>
              <div class="text-base italic leading-relaxed text-meg-text-secondary">
                <p>"{testimonial.quote}"</p>
              </div>
            </div>
            <div class="mt-10 flex items-center gap-x-4 pt-6 border-t border-meg-border-dark">
              <img class="size-12 rounded-full bg-meg-bg-dark border border-meg-border-dark shadow-inner" src={testimonial.image} alt={testimonial.author} loading="lazy" />
              <div>
                <div class="text-sm font-bold text-meg-text-primary-dark">{testimonial.author}</div>
                <div class="text-[10px] font-black uppercase tracking-widest text-emerald-400 mt-0.5">{testimonial.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
