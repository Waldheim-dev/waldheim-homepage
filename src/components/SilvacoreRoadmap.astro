---
const roadmapFeatures = [
  {
    quarter: 'Q2 2026',
    title: 'Digitale Eigentümerversammlung',
    icon: 'fa-video',
    status: 'in-development',
    priority: 'killer',
    description: 'Integrierte Video-Konferenz mit Live-Abstimmungssystem und KI-gestützter Protokollerstellung – weltweit erste WEG-Software mit dieser Funktion.',
    features: [
      'Jitsi Meet Integration (DSGVO-konform)',
      'Live-Voting mit Quoren-Berechnung',
      'Automatische Protokollerstellung via KI',
      'Rechtssichere Beschlussdokumentation',
      'Hybrid-Modus (Präsenz + Online)'
    ],
    impact: 'Alleinstellungsmerkmal',
    savings: '70% weniger Aufwand bei Protokollerstellung'
  },
  {
    quarter: 'Q3 2026',
    title: 'KI-Dokumentenanalyse',
    icon: 'fa-brain',
    status: 'planned',
    priority: 'killer',
    description: 'Automatische OCR, intelligente Klassifizierung und semantische Suche über alle Dokumente – 5+ Jahre Technologie-Vorsprung.',
    features: [
      'OCR für gescannte Dokumente (Tesseract & Google Vision)',
      'KI-basierte Auto-Klassifizierung (Rechnung, Vertrag, Protokoll)',
      'Metadaten-Extraktion (Datum, Betrag, Vertragspartner)',
      'Semantische Suche mit Vector Database (Qdrant)',
      'Automatische Verschlagwortung & Tagging'
    ],
    impact: 'Innovation',
    savings: '80% schnellere Dokumentensuche'
  },
  {
    quarter: 'Q4 2026',
    title: 'Advanced Analytics & Reporting',
    icon: 'fa-chart-line',
    status: 'planned',
    priority: 'competitive',
    description: 'Interaktive Dashboards mit Finanz-Trends, Verbrauchsanalysen und WEG-Benchmarking – weit überlegen gegenüber der Konkurrenz.',
    features: [
      'Interaktive Finanz-Dashboards (ApexCharts)',
      'Verbrauchstrend-Analysen mit Anomalie-Erkennung',
      'WEG-Performance-Vergleiche (Benchmarking)',
      'Automatisierte monatliche/jährliche Reports',
      'DATEV-Export für Steuerberater'
    ],
    impact: 'Competitive Advantage',
    savings: '60% weniger Zeit für Reporting'
  }
];

const additionalFeatures = [
  { 
    title: 'Progressive Web App (PWA)', 
    quarter: 'Q4 2026',
    description: 'Installierbare App mit Offline-Funktionalität und Push-Benachrichtigungen'
  },
  { 
    title: 'Erweiterte Aufgabenverwaltung', 
    quarter: 'Q4 2026',
    description: 'Kanban-Boards, Delegation und automatisierte Workflows'
  },
  { 
    title: 'Multi-Provider E-Mail-System', 
    quarter: 'Q1 2026',
    description: 'Zentrale E-Mail-Kommunikation mit SMTP, SendGrid, AWS SES & OAuth2'
  }
];
---

<div class="py-24 sm:py-32 bg-gradient-to-b from-dark-950 to-dark-900">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-green-400 gsap-fadein">
        Product Roadmap
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-light-100 sm:text-4xl gsap-fadein">
        Die Zukunft der WEG-Verwaltung
      </p>
      <p class="mt-6 text-lg leading-8 text-light-400 gsap-fadein">
        Wir entwickeln Features, die es noch nirgendwo gibt. Seien Sie dabei, wenn wir die WEG-Verwaltung revolutionieren.
      </p>
    </div>

    <!-- Killer Features Timeline -->
    <div class="mx-auto mt-16 max-w-5xl">
      <div class="relative">
        <!-- Timeline Line -->
        <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary-900 via-primary-700 to-primary-500" aria-hidden="true"></div>

        <!-- Feature Cards -->
        <div class="space-y-12">
          {roadmapFeatures.map((feature, index) => (
            <div class="relative pl-20 gsap-fadein" style={`animation-delay: ${index * 0.15}s`}>
              <!-- Timeline Dot -->
              <div class={`absolute left-0 flex h-16 w-16 items-center justify-center rounded-full ${
                feature.priority === 'killer' ? 'bg-gradient-to-br from-primary-900 to-primary-700 ring-4 ring-primary-900/20' : 
                'bg-gradient-to-br from-blue-600 to-blue-800 ring-4 ring-blue-600/20'
              }`}>
                <i class={`fa-solid ${feature.icon} text-white text-xl`} aria-hidden="true"></i>
              </div>

              <!-- Card -->
              <div class="rounded-2xl bg-dark-900/80 backdrop-blur-sm p-6 sm:p-8 border border-green-500/20/10 hover:ring-primary-900/30 transition-all duration-300">
                <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                  <div>
                    <div class="flex items-center gap-3 mb-2">
                      <h3 class="text-xl sm:text-2xl font-bold text-light-100">
                        {feature.title}
                      </h3>
                      {feature.priority === 'killer' && (
                        <span class="inline-flex items-center gap-1 rounded-full bg-red-500/10 px-3 py-1 text-xs font-semibold text-red-400 ring-1 ring-red-500/20">
                          <i class="fa-solid fa-fire" aria-hidden="true"></i> Killer-Feature
                        </span>
                      )}
                    </div>
                    <p class="text-sm text-light-500">{feature.quarter}</p>
                  </div>
                  
                  <div class="flex flex-col gap-2 text-right">
                    <span class={`inline-flex items-center gap-2 text-xs font-semibold ${
                      feature.status === 'in-development' ? 'text-yellow-400' : 'text-blue-400'
                    }`}>
                      <i class={`fa-solid ${feature.status === 'in-development' ? 'fa-code' : 'fa-calendar-clock'}`} aria-hidden="true"></i>
                      {feature.status === 'in-development' ? 'In Entwicklung' : 'Geplant'}
                    </span>
                  </div>
                </div>

                <p class="text-base text-light-400 mb-6">
                  {feature.description}
                </p>

                <!-- Features List -->
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6" role="list">
                  {feature.features.map((item) => (
                    <li class="flex items-start gap-2 text-sm text-light-300">
                      <i class="fa-solid fa-check text-green-400 mt-0.5 flex-shrink-0" aria-hidden="true"></i>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <!-- Impact Badges -->
                <div class="flex flex-wrap gap-3">
                  <div class="inline-flex items-center gap-2 rounded-lg bg-primary-900/10 px-4 py-2 text-sm">
                    <i class="fa-solid fa-trophy text-green-400" aria-hidden="true"></i>
                    <span class="text-light-400"><strong class="text-light-100">{feature.impact}</strong></span>
                  </div>
                  <div class="inline-flex items-center gap-2 rounded-lg bg-green-500/10 px-4 py-2 text-sm">
                    <i class="fa-solid fa-chart-line text-green-400" aria-hidden="true"></i>
                    <span class="text-light-400">{feature.savings}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Additional Features Grid -->
    <div class="mx-auto mt-20 max-w-5xl">
      <h3 class="text-xl sm:text-2xl font-bold text-center text-light-100 mb-10 gsap-fadein">
        Und noch viele weitere Features...
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {additionalFeatures.map((feature, index) => (
          <div class="rounded-xl bg-dark-900/50 p-6 border border-green-500/20/10 hover:ring-primary-900/30 transition-all duration-300 gsap-fadein" style={`animation-delay: ${index * 0.1 + 0.5}s`}>
            <div class="flex items-start justify-between mb-3">
              <h4 class="text-base font-semibold text-light-100">{feature.title}</h4>
              <span class="text-xs text-light-500 whitespace-nowrap ml-2">{feature.quarter}</span>
            </div>
            <p class="text-sm text-light-400">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mx-auto mt-16 max-w-2xl text-center gsap-fadein">
      <div class="rounded-2xl bg-gradient-to-r from-primary-900/20 via-primary-800/20 to-primary-900/20 p-8 ring-1 ring-primary-900/30">
        <i class="fa-solid fa-rocket text-green-400 text-4xl mb-4" aria-hidden="true"></i>
        <h3 class="text-xl sm:text-2xl font-bold text-light-100 mb-3">Seien Sie Teil der Zukunft</h3>
        <p class="text-sm sm:text-base text-light-400 mb-6">
          Als Early Adopter erhalten Sie Zugriff auf alle neuen Features – kostenlos während der Beta-Phase.
          Beeinflussen Sie die Entwicklung mit Ihrem Feedback!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/silvacore/#installation" 
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-primary-800 text-white font-semibold hover:bg-primary-800 transition-colors"
            aria-label="Zur Installation und Beta-Zugang"
          >
            <i class="fa-solid fa-download" aria-hidden="true"></i>
            Beta-Zugang sichern
          </a>
          <a 
            href="https://github.com/Waldheim-dev/silvacore" 
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-dark-900 text-light-100 font-semibold border border-green-500/20/30 hover:ring-primary-900/50 transition-all"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Roadmap auf GitHub verfolgen"
          >
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            Roadmap auf GitHub
          </a>
        </div>
      </div>
    </div>

    <!-- Transparenz-Hinweis -->
    <div class="mx-auto mt-12 max-w-3xl text-center">
      <p class="text-xs sm:text-sm text-light-500 leading-relaxed">
        <i class="fa-solid fa-circle-info text-green-400 mr-1" aria-hidden="true"></i>
        <strong>Transparenz:</strong> Alle geplanten Features sind als Open Source verfügbar. 
        Die Roadmap wird kontinuierlich aktualisiert und ist auf GitHub einsehbar. 
        Änderungen vorbehalten – Ihre Rückmeldungen beeinflussen die Priorisierung.
      </p>
    </div>
  </div>
</div>
```