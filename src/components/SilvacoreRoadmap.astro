---
const roadmapFeatures = [
  {
    quarter: 'Q2 2026',
    title: 'Digitale Eigentümerversammlung',
    icon: 'fa-video',
    status: 'in-development',
    priority: 'killer',
    description: 'Integrierte Video-Konferenz mit Live-Abstimmungssystem und KI-gestützter Protokollerstellung – weltweit erste WEG-Software mit dieser Funktion.',
    features: [
      'Jitsi Meet Integration (DSGVO-konform)',
      'Live-Voting mit Quoren-Berechnung',
      'Automatische Protokollerstellung via KI',
      'Rechtssichere Beschlussdokumentation',
      'Hybrid-Modus (Präsenz + Online)'
    ],
    impact: 'Alleinstellungsmerkmal',
    savings: '70% weniger Aufwand bei Protokollerstellung'
  },
  {
    quarter: 'Q3 2026',
    title: 'KI-Dokumentenanalyse',
    icon: 'fa-brain',
    status: 'planned',
    priority: 'killer',
    description: 'Automatische OCR, intelligente Klassifizierung und semantische Suche über alle Dokumente – 5+ Jahre Technologie-Vorsprung.',
    features: [
      'OCR für gescannte Dokumente (Tesseract & Google Vision)',
      'KI-basierte Auto-Klassifizierung (Rechnung, Vertrag, Protokoll)',
      'Metadaten-Extraktion (Datum, Betrag, Vertragspartner)',
      'Semantische Suche mit Vector Database (Qdrant)',
      'Automatische Verschlagwortung & Tagging'
    ],
    impact: 'Innovation',
    savings: '80% schnellere Dokumentensuche'
  },
  {
    quarter: 'Q4 2026',
    title: 'Advanced Analytics & Reporting',
    icon: 'fa-chart-line',
    status: 'planned',
    priority: 'competitive',
    description: 'Interaktive Dashboards mit Finanz-Trends, Verbrauchsanalysen und WEG-Benchmarking – weit überlegen gegenüber der Konkurrenz.',
    features: [
      'Interaktive Finanz-Dashboards (ApexCharts)',
      'Verbrauchstrend-Analysen mit Anomalie-Erkennung',
      'WEG-Performance-Vergleiche (Benchmarking)',
      'Automatisierte monatliche/jährliche Reports',
      'DATEV-Export für Steuerberater'
    ],
    impact: 'Competitive Advantage',
    savings: '60% weniger Zeit für Reporting'
  }
];

const additionalFeatures = [
  { 
    title: 'Progressive Web App (PWA)', 
    quarter: 'Q4 2026',
    description: 'Installierbare App mit Offline-Funktionalität und Push-Benachrichtigungen'
  },
  { 
    title: 'Erweiterte Aufgabenverwaltung', 
    quarter: 'Q4 2026',
    description: 'Kanban-Boards, Delegation und automatisierte Workflows'
  },
  { 
    title: 'Multi-Provider E-Mail-System', 
    quarter: 'Q1 2026',
    description: 'Zentrale E-Mail-Kommunikation mit SMTP, SendGrid, AWS SES & OAuth2'
  }
];
---

<div class="py-24 sm:py-32 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-sm font-bold uppercase tracking-widest text-emerald-400 gsap-fadein">
        Produktentwicklung
      </h2>
      <p class="mt-2 text-3xl font-black tracking-tighter text-meg-text-primary-dark sm:text-4xl gsap-fadein">
        Die Zukunft der WEG-Verwaltung
      </p>
      <p class="mt-6 text-lg leading-8 text-meg-text-secondary gsap-fadein">
        Wir entwickeln Features, die neue Standards setzen. Seien Sie Teil der digitalen Transformation.
      </p>
    </div>

    <!-- Killer Features Timeline -->
    <div class="mx-auto mt-16 max-w-5xl">
      <div class="relative">
        <!-- Timeline Line -->
        <div class="absolute left-8 top-0 bottom-0 w-px bg-meg-border-dark" aria-hidden="true"></div>

        <!-- Feature Cards -->
        <div class="space-y-12">
          {roadmapFeatures.map((feature, index) => (
            <div class="relative pl-20 gsap-fadein" style={`animation-delay: ${index * 0.15}s`}>
              <!-- Timeline Dot -->
              <div class={`absolute left-0 flex size-16 items-center justify-center rounded-2xl ${
                feature.priority === 'killer' ? 'bg-meg-accent text-white shadow-xl shadow-meg-accent/20' : 
                'bg-meg-bg-dark border border-meg-border-dark text-meg-text-secondary shadow-inner'
              }`}>
                <i class={`fa-solid ${feature.icon} text-xl`} aria-hidden='true'></i>
              </div>

              <!-- Card -->
              <div class="rounded-2xl bg-meg-surface-dark/50 backdrop-blur-xl p-8 border border-meg-border-dark hover:border-meg-accent/30 transition-all duration-300 shadow-sm group">
                <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
                  <div>
                    <div class="flex items-center gap-3 mb-2">
                      <h3 class="text-xl sm:text-2xl font-bold text-meg-text-primary-dark tracking-tight">
                        {feature.title}
                      </h3>
                      {feature.priority === 'killer' && (
                        <span class="inline-flex items-center gap-1 rounded-lg bg-rose-500/10 px-2 py-0.5 text-[10px] font-black uppercase tracking-tighter text-rose-400 border border-rose-500/20">
                          <i class="fa-solid fa-fire" aria-hidden="true"></i> Killer
                        </span>
                      )}
                    </div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-emerald-400">{feature.quarter}</p>
                  </div>
                  
                  <div class="flex flex-col gap-2 text-right">
                    <span class={`inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest ${
                      feature.status === 'in-development' ? 'text-meg-accent' : 'text-meg-text-secondary opacity-60'
                    }`}>
                      <i class={`fa-solid ${feature.status === 'in-development' ? 'fa-code' : 'fa-calendar-clock'}`} aria-hidden="true"></i>
                      {feature.status === 'in-development' ? 'In Development' : 'Planned'}
                    </span>
                  </div>
                </div>

                <p class="text-base text-meg-text-secondary mb-8 leading-relaxed">
                  {feature.description}
                </p>

                <!-- Features List -->
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8" role="list">
                  {feature.features.map((item) => (
                    <li class="flex items-start gap-3 text-sm text-meg-text-secondary leading-relaxed">
                      <i class="fa-solid fa-check text-emerald-400 mt-1 flex-shrink-0" aria-hidden="true"></i>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <!-- Impact Badges -->
                <div class="flex flex-wrap gap-3">
                  <div class="inline-flex items-center gap-2 rounded-xl bg-meg-bg-dark border border-meg-border-dark px-4 py-2 text-xs shadow-inner">
                    <i class="fa-solid fa-trophy text-emerald-400" aria-hidden="true"></i>
                    <span class="text-meg-text-primary-dark font-bold">{feature.impact}</span>
                  </div>
                  <div class="inline-flex items-center gap-2 rounded-xl bg-meg-bg-dark border border-meg-border-dark px-4 py-2 text-xs shadow-inner">
                    <i class="fa-solid fa-chart-line text-meg-accent" aria-hidden="true"></i>
                    <span class="text-meg-text-secondary">{feature.savings}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Additional Features Grid -->
    <div class="mx-auto mt-24 max-w-5xl">
      <h3 class="text-2xl font-black text-center text-meg-text-primary-dark mb-12 gsap-fadein tracking-tight">
        Weitere Meilensteine
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {additionalFeatures.map((feature, index) => (
          <div class="rounded-2xl bg-meg-surface-dark/50 backdrop-blur-md p-8 border border-meg-border-dark hover:border-emerald-500/30 transition-all duration-300 gsap-fadein shadow-sm flex flex-col" style={`animation-delay: ${index * 0.1 + 0.5}s`}>
            <div class="flex items-start justify-between mb-4">
              <h4 class="text-lg font-bold text-meg-text-primary-dark leading-tight">{feature.title}</h4>
              <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400 ml-4">{feature.quarter}</span>
            </div>
            <p class="text-sm text-meg-text-secondary leading-relaxed flex-1">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="mx-auto mt-24 max-w-2xl text-center gsap-fadein">
      <div class="rounded-2xl bg-meg-surface-dark/80 backdrop-blur-xl p-10 border-2 border-emerald-500/20 shadow-2xl shadow-emerald-500/5 group">
        <i class="fa-solid fa-rocket text-emerald-400 text-4xl mb-6" aria-hidden="true"></i>
        <h3 class="text-2xl font-black text-meg-text-primary-dark mb-4 tracking-tight">Seien Sie Teil der Zukunft</h3>
        <p class="text-meg-text-secondary mb-10 leading-relaxed">
          Als Early Adopter erhalten Sie Zugriff auf alle neuen Features – kostenlos während der Beta-Phase.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a 
            href="/silvacore/#installation" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-meg-accent text-white font-bold shadow-xl shadow-meg-accent/20 hover:scale-[1.02] transition-all"
          >
            <i class="fa-solid fa-download" aria-hidden="true"></i>
            Beta Access
          </a>
          <a 
            href="https://github.com/Waldheim-dev/silvacore" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold hover:bg-meg-surface-dark hover:border-emerald-500/50 transition-all"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fa-brands fa-github" aria-hidden="true"></i>
            GitHub
          </a>
        </div>
      </div>
    </div>

    <!-- Transparenz-Hinweis -->
    <div class="mx-auto mt-16 max-w-3xl text-center">
      <div class="inline-flex items-start gap-3 rounded-xl bg-meg-accent/5 border border-meg-accent/20 p-6 text-left">
        <i class="fa-solid fa-circle-info text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
        <p class="text-xs text-meg-text-secondary leading-relaxed">
          <strong class="text-meg-text-primary-dark">Transparenz:</strong> Alle geplanten Features sind als Open Source verfügbar. Die Roadmap wird kontinuierlich aktualisiert und ist auf GitHub einsehbar. Änderungen vorbehalten.
        </p>
      </div>
    </div>
  </div>
</div>
