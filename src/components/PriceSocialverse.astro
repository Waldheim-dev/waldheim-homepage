---
---

<section id="pricing" class="py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 via-dark-900 to-dark-950">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center mb-16 gsap-fadein">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Einfache, transparente <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500">Preise</span>
      </h2>
      <p class="text-xl text-light-300 max-w-3xl mx-auto">
        Socialverse bietet flexible Preispläne für effiziente Marketing- und CRM-Lösungen. Wählen Sie den Plan, der am besten zu Ihnen passt.
      </p>
    </div>
    
    <div class="isolate mx-auto mt-10 grid max-w-lg grid-cols-1 gap-8 lg:mx-0 md:max-w-none md:grid-cols-2 lg:grid-cols-4">
      <!-- Free Tier -->
      <div class="gsap-fadein relative bg-gradient-to-br from-dark-900 to-dark-950 border border-light-500/10 rounded-2xl p-8 xl:p-10 shadow-xl hover:border-purple-500/30 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300" style="animation-delay: 0.1s">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-white mb-2">
            <i class="fa-regular fa-seedling text-purple-400"></i> Free
          </h3>
          <p class="text-light-400 mb-4">Lerne die Software kennen und probiere sie aus.</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-bold text-white">0</span>
            <span class="text-2xl text-light-300 ml-2">€</span>
          </div>
          <p class="text-light-300 text-sm">pro Monat</p>
        </div>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3 text-light-300">
            <i class="fa-solid fa-check text-purple-400 mt-1"></i>
            <span><strong>5</strong> AI Prompts</span>
          </li>
        </ul>
      </div>

      <!-- PayPerUse Tier -->
      <div class="gsap-fadein relative bg-gradient-to-br from-dark-900 to-dark-950 border border-light-500/10 rounded-2xl p-8 xl:p-10 shadow-xl hover:border-purple-500/30 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300" style="animation-delay: 0.2s">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-white mb-2">
            <i class="fa-regular fa-car-side text-purple-400"></i> PayPerUse
          </h3>
          <p class="text-light-400 mb-4">Zahle was du verbrauchst.</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-bold text-white">0,33</span>
            <span class="text-2xl text-light-300 ml-2">€</span>
          </div>
          <p class="text-light-300 text-sm">pro Prompt</p>
        </div>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3 text-light-300">
            <i class="fa-solid fa-check text-purple-400 mt-1"></i>
            <span><strong>1</strong> AI Prompt pro Kauf</span>
          </li>
        </ul>
      </div>

      <!-- Pro Tier (Highlighted) -->
      <div class="gsap-fadein relative bg-gradient-to-br from-purple-900/20 to-dark-900 border-2 border-purple-500/50 rounded-2xl p-8 xl:p-10 shadow-2xl shadow-purple-500/20 scale-105 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300" style="animation-delay: 0.3s">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-purple-500/10 border border-purple-500/30 text-purple-300 px-4 py-1 rounded-full text-sm font-bold">
          Beliebteste Wahl
        </div>
        
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-white mb-2">
            <i class="fa-regular fa-rocket-launch text-purple-400"></i> Pro
          </h3>
          <p class="text-light-400 mb-4">Optimal für mittlere Unternehmen</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-bold text-white">31,35</span>
            <span class="text-2xl text-light-300 ml-2">€</span>
          </div>
          <p class="text-light-300 text-sm">pro Monat</p>
        </div>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3 text-light-300">
            <i class="fa-solid fa-check text-purple-400 mt-1"></i>
            <span><strong>100</strong> AI Prompts pro Monat</span>
          </li>
          <li class="flex items-start gap-3 text-light-300">
            <i class="fa-solid fa-check text-purple-400 mt-1"></i>
            <span>Prioritäts-Support</span>
          </li>
        </ul>
      </div>

      <!-- Premium Tier -->
      <div class="gsap-fadein relative bg-gradient-to-br from-dark-900 to-dark-950 border border-light-500/10 rounded-2xl p-8 xl:p-10 shadow-xl hover:border-purple-500/30 hover:shadow-2xl hover:-translate-y-1 transition-all duration-300" style="animation-delay: 0.4s">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-white mb-2">
            <i class="fa-regular fa-planet-ringed text-purple-400"></i> Premium
          </h3>
          <p class="text-light-400 mb-4">Optimal für große Firmen</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-bold text-white">313,50</span>
            <span class="text-2xl text-light-300 ml-2">€</span>
          </div>
          <p class="text-light-300 text-sm">pro Monat</p>
        </div>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3 text-light-300">
            <i class="fa-solid fa-check text-purple-400 mt-1"></i>
            <span><strong>1000</strong> AI Prompts pro Monat</span>
          </li>
          <li class="flex items-start gap-3 text-light-300">
            <i class="fa-solid fa-check text-purple-400 mt-1"></i>
            <span>Alle AI-Funktionen</span>
          </li>
          <li class="flex items-start gap-3 text-light-300">
            <i class="fa-solid fa-check text-purple-400 mt-1"></i>
            <span>24/7 Premium-Support</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
