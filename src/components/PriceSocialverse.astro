---
---

<section id="pricing" class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-4xl text-center mb-16 gsap-fadein">
      <h2 class="text-sm font-bold uppercase tracking-widest text-violet-400 mb-4">
        Beta-Pricing
      </h2>
      <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
        Einfache, transparente <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500">Preise</span>
      </p>
      <p class="text-xl text-meg-text-secondary max-w-3xl mx-auto">
        Socialverse bietet flexible Preispläne für effiziente Marketing- und CRM-Lösungen.
      </p>
    </div>
    
    <div class="isolate mx-auto mt-10 grid max-w-lg grid-cols-1 gap-8 lg:mx-0 md:max-w-none md:grid-cols-2 lg:grid-cols-4">
      <!-- Free Tier -->
      <div class="gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 xl:p-10 shadow-sm hover:border-violet-500/30 transition-all duration-300 group" style="animation-delay: 0.1s">
        <div class="mb-8">
          <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4 flex items-center gap-2">
            <i class="fa-regular fa-seedling text-violet-400"></i> Free
          </h3>
          <p class="text-meg-text-secondary text-sm mb-6">Testen ohne Risiko.</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-black text-meg-text-primary-dark tracking-tighter">0</span>
            <span class="text-2xl text-meg-text-secondary ml-2 font-bold">€</span>
          </div>
          <p class="text-[10px] uppercase font-black tracking-widest text-violet-400">pro Monat</p>
        </div>
        <ul class="space-y-4 mb-10">
          <li class="flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed">
            <i class="fa-solid fa-check text-violet-400 mt-1"></i>
            <span><strong>5</strong> AI Prompts</span>
          </li>
        </ul>
      </div>

      <!-- PayPerUse Tier -->
      <div class="gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 xl:p-10 shadow-sm hover:border-violet-500/30 transition-all duration-300 group" style="animation-delay: 0.2s">
        <div class="mb-8">
          <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4 flex items-center gap-2">
            <i class="fa-regular fa-coins text-violet-400"></i> Elastic
          </h3>
          <p class="text-meg-text-secondary text-sm mb-6">Zahle was du verbrauchst.</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-black text-meg-text-primary-dark tracking-tighter">0,33</span>
            <span class="text-2xl text-meg-text-secondary ml-2 font-bold">€</span>
          </div>
          <p class="text-[10px] uppercase font-black tracking-widest text-violet-400">pro Prompt</p>
        </div>
        <ul class="space-y-4 mb-10">
          <li class="flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed">
            <i class="fa-solid fa-check text-violet-400 mt-1"></i>
            <span><strong>Pay-as-you-go</strong></span>
          </li>
        </ul>
      </div>

      <!-- Pro Tier (Highlighted) -->
      <div class="gsap-fadein relative bg-meg-surface-dark/80 backdrop-blur-xl border-2 border-violet-500/30 rounded-2xl p-8 xl:p-10 shadow-2xl shadow-violet-500/10 scale-105 z-10 transition-all duration-300" style="animation-delay: 0.3s">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-violet-600 border border-violet-500/30 text-white px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg">
          Beta-Choice
        </div>
        
        <div class="mb-8">
          <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4 flex items-center gap-2">
            <i class="fa-regular fa-rocket-launch text-violet-400"></i> Pro
          </h3>
          <p class="text-meg-text-secondary text-sm mb-6">Für KMUs & Agenturen.</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-black text-meg-text-primary-dark tracking-tighter">31,35</span>
            <span class="text-2xl text-meg-text-secondary ml-2 font-bold">€</span>
          </div>
          <p class="text-[10px] uppercase font-black tracking-widest text-violet-400">pro Monat</p>
        </div>
        <ul class="space-y-4 mb-10">
          <li class="flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed">
            <i class="fa-solid fa-check text-violet-400 mt-1"></i>
            <span><strong>100</strong> AI Prompts</span>
          </li>
          <li class="flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed">
            <i class="fa-solid fa-check text-violet-400 mt-1"></i>
            <span>Prioritäts-Support</span>
          </li>
        </ul>
      </div>

      <!-- Premium Tier -->
      <div class="gsap-fadein relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 xl:p-10 shadow-sm hover:border-violet-500/30 transition-all duration-300 group" style="animation-delay: 0.4s">
        <div class="mb-8">
          <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4 flex items-center gap-2">
            <i class="fa-regular fa-planet-ringed text-violet-400"></i> Enterprise
          </h3>
          <p class="text-meg-text-secondary text-sm mb-6">Full Automation.</p>
          <div class="flex items-baseline mb-2">
            <span class="text-5xl font-black text-meg-text-primary-dark tracking-tighter">313</span>
            <span class="text-2xl text-meg-text-secondary ml-2 font-bold">€</span>
          </div>
          <p class="text-[10px] uppercase font-black tracking-widest text-violet-400">pro Monat</p>
        </div>
        <ul class="space-y-4 mb-10">
          <li class="flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed">
            <i class="fa-solid fa-check text-violet-400 mt-1"></i>
            <span><strong>1000</strong> AI Prompts</span>
          </li>
          <li class="flex items-start gap-3 text-meg-text-secondary text-sm leading-relaxed">
            <i class="fa-solid fa-check text-violet-400 mt-1"></i>
            <span>Full AI Integration</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
