---
import { getCollection } from 'astro:content';
const { Blogs } = Astro.props;
const blogPosts = Blogs ?? await getCollection('blog', ({ id }) => {
  return id !== Blogs?.id;
});
// add only latest 3
blogPosts.sort((a, b) => {
  return new Date(b.data.pubDate) - new Date(a.data.pubDate);
});
blogPosts.splice(1, blogPosts.length - 1);
const blog = blogPosts[0];
---
{blog ? (
<div class="relative">
  <a class="text-white text-center block gsap-fadein focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent rounded-2xl" href={`/blog/${blog.id.replace(/^_/, '')}/`}>
    <article
      class="flex justify-center items-center gap-x-6 bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark px-10 sm:px-6 py-3 relative rounded-2xl shadow-sm hover:shadow-lg hover:shadow-meg-accent/10 hover:border-meg-accent/30 transition-all duration-300">
      <p class="text-xs leading-6 text-meg-text-primary-dark">
        <strong class="font-semibold text-sm">{blog.data.title}</strong>
        <br />
        <span class="text-meg-text-secondary">{blog.data.description}</span>&nbsp;<span class="text-meg-accent" aria-hidden="true">&rarr;</span>
      </p>
    </article>
  </a>
</div>) : null}

