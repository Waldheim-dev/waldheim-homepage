---
import { getCollection } from 'astro:content';
const { Blogs } = Astro.props;
const blogPosts = Blogs ?? await getCollection('blog', ({ id }) => {
  return id !== Blogs?.id;
});
// add only latest 3
blogPosts.sort((a, b) => {
  return new Date(b.data.pubDate) - new Date(a.data.pubDate);
});
blogPosts.splice(1, blogPosts.length - 1);
const blog = blogPosts[0];
---
{blog ? (
<div class="relative">
  <a class="text-white text-center block" href={`/blog/${blog.id.replace(/^_/, '')}/`}>
    <article
      class="flex justify-center items-center gap-x-6 bg-primary-400 dark:bg-emerald-800 px-10 sm:px-6 py-3 relative rounded-full shadow-md">
      <p class="text-xs leading-6">
        <strong class="font-semibold text-sm">{blog.data.title}</strong>
        <br />
        {blog.data.description}&nbsp;<span aria-hidden="true">&rarr;</span>
      </p>
    </article>
  </a>
</div>) : null}

