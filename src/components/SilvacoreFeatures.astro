---
// Silvacore Features - Alle 7 Hauptfunktionen
const features = [
  {
    icon: 'fa-building',
    title: 'WEG- & Eigentümerverwaltung',
    description: 'Stammdaten digital verwalten: WEG-Daten, Eigentümer mit Eigentumsanteilen, Mieter, Einheiten. Mit granularen Zugriffsrechten.',
    color: 'from-blue-500 to-cyan-500'
  },
  {
    icon: 'fa-euro-sign',
    title: 'Finanzen & Baufinanzierung',
    description: 'Kredite, Raten, Tilgungspläne, Kostenstellen und automatische Kostenverteilung nach Eigentumsanteilen. Export als PDF/Excel.',
    color: 'from-green-500 to-emerald-500'
  },
  {
    icon: 'fa-bolt',
    title: 'Verbrauchsdaten & Abrechnung',
    description: 'Zählerverwaltung (Strom, Wasser, Gas, Heizung), HKVO-konforme monatliche Berichte und automatisierte Nebenkostenabrechnungen.',
    color: 'from-purple-500 to-pink-500'
  },
  {
    icon: 'fa-folder',
    title: 'Dokumentenmanagement',
    description: 'Zentrale Ablage mit Ordnerstruktur pro WEG, Versionierung, granularen Zugriffsrechten und Volltextsuche.',
    color: 'from-orange-500 to-red-500'
  },
  {
    icon: 'fa-bell',
    title: 'Benachrichtigungen',
    description: 'Automatische E-Mail- und In-App-Benachrichtigungen bei Abrechnungen, neuen Dokumenten und wichtigen Ereignissen.',
    color: 'from-indigo-500 to-blue-500'
  },
  {
    icon: 'fa-wrench',
    title: 'Lieferanten & Handwerker',
    description: 'Strukturierte Kontaktdatenbank mit Kategorisierung nach Gewerk, Bewertungssystem und Service-Historie.',
    color: 'from-teal-500 to-green-500'
  },
  {
    icon: 'fa-shield-check',
    title: 'Nutzer- & Rechteverwaltung',
    description: '4-Rollen-System (Admin, Property Manager, Owner, Tenant), granulare Rechte, DSGVO-konform mit Audit-Log.',
    color: 'from-red-500 to-pink-500'
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-base font-semibold text-green-400 mb-4' style='animation-delay: 0s'>
        <i class='fa-solid fa-star text-green-400 mr-2' aria-hidden='true'></i>
        Vollständige WEG-Verwaltung
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
        Alles inklusive – <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>ohne Aufpreis</span>
      </p>
      <p class='gsap-fadein text-xl text-light-300 max-w-3xl mx-auto' style='animation-delay: 0.3s'>
        Silvacore bietet alle Funktionen, die Sie für eine professionelle WEG-Verwaltung benötigen. Von Stammdaten über Finanzen bis zur HKVO-konformen Abrechnung.
      </p>
    </div>
    
    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8'>
      {features.map((feature, index) => (
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style={`animation-delay: ${0.45 + index * 0.1}s`}>
          <div class='flex items-center gap-4 mb-4'>
            <div class={`w-12 h-12 bg-gradient-to-br ${feature.color} rounded-xl flex items-center justify-center flex-shrink-0`}>
              <i class={`fa-solid ${feature.icon} text-white text-xl`} aria-hidden='true'></i>
            </div>
            <h3 class='text-lg font-bold text-white'>{feature.title}</h3>
          </div>
          <p class='text-light-300'>{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
