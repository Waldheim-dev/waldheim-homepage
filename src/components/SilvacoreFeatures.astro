---
// Silvacore Features - Alle 7 Hauptfunktionen
const features = [
  {
    icon: 'fa-building',
    title: 'WEG- & Eigentümerverwaltung',
    description: 'Stammdaten digital verwalten: WEG-Daten, Eigentümer mit Eigentumsanteilen, Mieter, Einheiten. Mit granularen Zugriffsrechten.',
    color: 'from-blue-500 to-cyan-500'
  },
  {
    icon: 'fa-euro-sign',
    title: 'Finanzen & Baufinanzierung',
    description: 'Kredite, Raten, Tilgungspläne, Kostenstellen und automatische Kostenverteilung nach Eigentumsanteilen. Export als PDF/Excel.',
    color: 'from-green-500 to-emerald-500'
  },
  {
    icon: 'fa-bolt',
    title: 'Verbrauchsdaten & Abrechnung',
    description: 'Zählerverwaltung (Strom, Wasser, Gas, Heizung), HKVO-konforme monatliche Berichte und automatisierte Nebenkostenabrechnungen.',
    color: 'from-purple-500 to-pink-500'
  },
  {
    icon: 'fa-folder',
    title: 'Dokumentenmanagement',
    description: 'Zentrale Ablage mit Ordnerstruktur pro WEG, Versionierung, granularen Zugriffsrechten und Volltextsuche.',
    color: 'from-orange-500 to-red-500'
  },
  {
    icon: 'fa-bell',
    title: 'Benachrichtigungen',
    description: 'Automatische E-Mail- und In-App-Benachrichtigungen bei Abrechnungen, neuen Dokumenten und wichtigen Ereignissen.',
    color: 'from-indigo-500 to-blue-500'
  },
  {
    icon: 'fa-wrench',
    title: 'Lieferanten & Handwerker',
    description: 'Strukturierte Kontaktdatenbank mit Kategorisierung nach Gewerk, Bewertungssystem und Service-Historie.',
    color: 'from-teal-500 to-green-500'
  },
  {
    icon: 'fa-shield-halved',
    title: 'Nutzer- & Rechteverwaltung',
    description: '4-Rollen-System (Admin, Property Manager, Owner, Tenant), granulare Rechte, DSGVO-konform mit Audit-Log.',
    color: 'from-red-500 to-pink-500'
  }
];
---

<section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'>
  <div class='mx-auto max-w-7xl'>
    <div class='mx-auto max-w-2xl text-center mb-16'>
      <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0s'>
        Funktionsumfang
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        Vollständige <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Plattform</span>
      </p>
      <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto' style='animation-delay: 0.3s'>
        Silvacore vereint alle operativen Prozesse der WEG-Verwaltung in einer modernen Cloud-Oberfläche.
      </p>
    </div>
    
    <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8'>
      {features.map((feature, index) => (
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${0.45 + index * 0.1}s`}>
          <div class='flex items-center gap-4 mb-6'>
            <div class='size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform shadow-inner'>
              <i class={`fa-solid ${feature.icon} text-emerald-400 text-xl`} aria-hidden='true'></i>
            </div>
            <h3 class='text-lg font-bold text-meg-text-primary-dark tracking-tight'>{feature.title}</h3>
          </div>
          <p class='text-meg-text-secondary text-sm leading-relaxed'>{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
