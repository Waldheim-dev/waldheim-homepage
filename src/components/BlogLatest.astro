---
import FormattedDate from './FormattedDate.astro';
import { getCollection } from 'astro:content';

const { Blogs } = Astro.props;
const blogPosts = Blogs ?? await getCollection('blog', ({ id }) => {
  return id !== Blogs?.id;
});
// add only latest 3
blogPosts.sort((a, b) => {
  return new Date(b.data.pubDate) - new Date(a.data.pubDate);
});
blogPosts.splice(3, blogPosts.length - 3);
---

<div class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900  sm:text-4xl">Ihr Wissensvorsprung:
        Weitere Artikel</h2>
      <p class="mt-2 text-lg leading-8 text-gray-600 ">Vertiefen Sie Ihr Wissen mit weiteren Beiträgen
        zu aktuellen IT-Themen.</p>
    </div>
    <div
      class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3">
      {
        blogPosts.map(async (post) => {

          return (
            <a href={`/blog/${post.id.replace(/^_/, '')}/`}>
              <article
                class="relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 pt-80 sm:pt-48 lg:pt-80">
                <img
                  src={post.data.heroImage} loading="lazy"
                  alt={post.data.title} class="absolute inset-0 -z-10 h-full w-full object-cover">
                <div class="absolute inset-0 -z-10 rounded-2xl ring-1 ring-inset ring-gray-900/10"></div>

                <div class="relative isolate flex flex-col bg-slate-900/40  backdrop-blur-xs justify-end p-8 pt-4">
                  <div class="flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  <h3 class="mt-3 text-lg font-semibold leading-6 text-white">
                    <span class="absolute inset-0"></span>
                    {post.data.title}
                  </h3>
                  <p
                    class="flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300 line-clamp-2">{post.data.description}</p>
                </div>
              </article>
            </a>
          );
        })
      }
    </div>
  </div>
</div>