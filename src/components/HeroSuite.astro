---
---
<section id="hero-suite" class="relative min-h-screen flex items-center justify-center overflow-hidden bg-meg-bg-dark border-b border-meg-border-dark">
  <canvas id="hero-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- Radial gradient overlay -->
  <div class="pointer-events-none absolute inset-0 bg-radial-[ellipse_at_center] from-transparent via-meg-bg-dark/20 to-meg-bg-dark/70"></div>
  <!-- Bottom fade -->
  <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-meg-bg-dark to-transparent"></div>

  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto pt-24 pb-32">
    <!-- Announcement badge -->
    <div id="hs-badge" class="mb-8 inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-4 py-2 text-sm font-semibold text-sky-400 opacity-0 translate-y-6">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-sky-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-sky-500"></span>
      </span>
      Waldheim Suite — Jetzt in der Beta
    </div>

    <!-- Headline -->
    <h1 id="hs-title" class="mb-6 text-6xl font-black tracking-tighter text-meg-text-primary-dark leading-[0.9] opacity-0 translate-y-8 sm:text-7xl lg:text-8xl">
      Die All-in-One<br>
      <span class="inline-block bg-gradient-to-r from-sky-400 via-violet-400 to-sky-400 bg-[length:200%_auto] bg-clip-text text-transparent [animation:hs-gradient_4s_linear_infinite]">
        Business Suite
      </span><br>
      für DACH-KMU
    </h1>

    <!-- Sub-headline -->
    <p id="hs-sub" class="mb-12 max-w-3xl mx-auto text-xl text-meg-text-secondary leading-relaxed opacity-0 translate-y-6 sm:text-2xl">
      ERP &middot; Treasury &middot; E-Rechnung &middot; BYO-AI &mdash; alles in einer Plattform.<br>
      <span class="font-semibold text-meg-text-primary-dark">14 Tage kostenlos &mdash; ohne Kreditkarte.</span>
    </p>

    <!-- CTAs -->
    <div id="hs-ctas" class="mb-20 flex flex-col items-center justify-center gap-4 opacity-0 translate-y-6 sm:flex-row">
      <a
        href="/suite/preise/"
        class="group inline-flex items-center justify-center gap-3 rounded-2xl bg-sky-500 px-8 py-4 text-lg font-bold text-white transition-all duration-300 hover:scale-105 hover:bg-sky-400 hover:shadow-[0_0_40px_rgba(14,165,233,0.45)]"
      >
        <i class="fa-solid fa-rocket" aria-hidden="true"></i>
        Kostenlos starten
        <i class="fa-solid fa-arrow-right transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
      </a>
      <a
        href="/suite/"
        class="inline-flex items-center justify-center gap-3 rounded-2xl border border-meg-border-dark bg-meg-surface-dark/70 px-8 py-4 text-lg font-semibold text-meg-text-primary-dark backdrop-blur transition-all duration-300 hover:border-sky-500/50 hover:bg-meg-surface-dark"
      >
        Module entdecken
      </a>
    </div>

    <!-- Trust bar -->
    <div id="hs-trust" class="grid grid-cols-2 gap-3 opacity-0 translate-y-6 md:grid-cols-4">
      <div class="flex flex-col items-center gap-1 rounded-xl border border-meg-border-dark bg-meg-surface-dark/70 px-4 py-3 backdrop-blur">
        <i class="fa-solid fa-file-invoice text-xl text-sky-400" aria-hidden="true"></i>
        <span class="text-sm font-bold text-meg-text-primary-dark">XRechnung-konform</span>
        <span class="text-xs text-meg-text-secondary">&amp; ZUGFeRD 2.x</span>
      </div>
      <div class="flex flex-col items-center gap-1 rounded-xl border border-meg-border-dark bg-meg-surface-dark/70 px-4 py-3 backdrop-blur">
        <i class="fa-solid fa-shield-halved text-xl text-emerald-400" aria-hidden="true"></i>
        <span class="text-sm font-bold text-meg-text-primary-dark">DSGVO-ready</span>
        <span class="text-xs text-meg-text-secondary">EU-Hosting, Made in DE</span>
      </div>
      <div class="flex flex-col items-center gap-1 rounded-xl border border-meg-border-dark bg-meg-surface-dark/70 px-4 py-3 backdrop-blur">
        <i class="fa-solid fa-brain text-xl text-violet-400" aria-hidden="true"></i>
        <span class="text-sm font-bold text-meg-text-primary-dark">BYO-AI</span>
        <span class="text-xs text-meg-text-secondary">140+ KI-Anbieter</span>
      </div>
      <div class="flex flex-col items-center gap-1 rounded-xl border border-meg-border-dark bg-meg-surface-dark/70 px-4 py-3 backdrop-blur">
        <i class="fa-solid fa-clock text-xl text-amber-400" aria-hidden="true"></i>
        <span class="text-sm font-bold text-meg-text-primary-dark">14-Tage-Trial</span>
        <span class="text-xs text-meg-text-secondary">Keine Kreditkarte</span>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-xs text-meg-text-secondary">
    <span>Entdecke die Suite</span>
    <div class="h-12 w-px animate-pulse bg-gradient-to-b from-meg-text-secondary to-transparent"></div>
  </div>
</section>

<style>
  @keyframes hs-gradient {
    from { background-position: 0% center; }
    to   { background-position: 200% center; }
  }
</style>

<script>
import * as THREE from 'three';
import gsap from 'gsap';

let _cleanup: (() => void) | null = null;

function initHeroSuite() {
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  const section = document.getElementById('hero-suite');
  if (!canvas || !section) return;

  const W = section.clientWidth;
  const H = section.clientHeight || window.innerHeight;

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: false, alpha: true });
  renderer.setSize(W, H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, W / H, 0.1, 2000);
  camera.position.z = 400;

  // --- Particles ---
  const isMobile = window.innerWidth < 768;
  const COUNT = isMobile ? 60 : 130;
  const spreadX = Math.max(W, 900);
  const spreadY = H * 1.3;

  const positions = new Float32Array(COUNT * 3);
  const velocities: { vx: number; vy: number }[] = [];

  for (let i = 0; i < COUNT; i++) {
    positions[i * 3]     = (Math.random() - 0.5) * spreadX;
    positions[i * 3 + 1] = (Math.random() - 0.5) * spreadY;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 80;
    velocities.push({
      vx: (Math.random() - 0.5) * 0.45,
      vy: (Math.random() - 0.5) * 0.35,
    });
  }

  const ptGeo = new THREE.BufferGeometry();
  ptGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

  const ptMat = new THREE.PointsMaterial({ color: 0x0ea5e9, size: 2.8, transparent: true, opacity: 0.85, sizeAttenuation: true });
  scene.add(new THREE.Points(ptGeo, ptMat));

  // --- Lines ---
  const MAX_LINES = COUNT * 8;
  const lineBuf = new Float32Array(MAX_LINES * 6);
  const lineGeo = new THREE.BufferGeometry();
  lineGeo.setAttribute('position', new THREE.BufferAttribute(lineBuf, 3));
  lineGeo.setDrawRange(0, 0);
  const lineMat = new THREE.LineBasicMaterial({ color: 0x0ea5e9, transparent: true, opacity: 0.1 });
  scene.add(new THREE.LineSegments(lineGeo, lineMat));

  const THRESH = 150;
  const mouse = { x: 0, y: 0 };
  let frameId = 0;

  function animate() {
    frameId = requestAnimationFrame(animate);

    let lc = 0;
    const pos = ptGeo.attributes.position.array as Float32Array;

    for (let i = 0; i < COUNT; i++) {
      pos[i * 3]     += velocities[i].vx;
      pos[i * 3 + 1] += velocities[i].vy;
      if (pos[i * 3]     >  spreadX / 2) pos[i * 3]     = -spreadX / 2;
      if (pos[i * 3]     < -spreadX / 2) pos[i * 3]     =  spreadX / 2;
      if (pos[i * 3 + 1] >  spreadY / 2) pos[i * 3 + 1] = -spreadY / 2;
      if (pos[i * 3 + 1] < -spreadY / 2) pos[i * 3 + 1] =  spreadY / 2;
    }

    for (let i = 0; i < COUNT && lc < MAX_LINES; i++) {
      for (let j = i + 1; j < COUNT && lc < MAX_LINES; j++) {
        const dx = pos[i * 3] - pos[j * 3];
        const dy = pos[i * 3 + 1] - pos[j * 3 + 1];
        if (dx * dx + dy * dy < THRESH * THRESH) {
          const b = lc * 6;
          lineBuf[b]   = pos[i * 3]; lineBuf[b+1] = pos[i * 3 + 1]; lineBuf[b+2] = pos[i * 3 + 2];
          lineBuf[b+3] = pos[j * 3]; lineBuf[b+4] = pos[j * 3 + 1]; lineBuf[b+5] = pos[j * 3 + 2];
          lc++;
        }
      }
    }

    ptGeo.attributes.position.needsUpdate = true;
    lineGeo.attributes.position.needsUpdate = true;
    lineGeo.setDrawRange(0, lc * 2);

    camera.position.x += (mouse.x * 40 - camera.position.x) * 0.03;
    camera.position.y += (-mouse.y * 25 - camera.position.y) * 0.03;
    camera.lookAt(scene.position);

    renderer.render(scene, camera);
  }

  animate();

  // GSAP entrance
  gsap.to('#hs-badge',  { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 0.15 });
  gsap.to('#hs-title',  { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', delay: 0.3 });
  gsap.to('#hs-sub',    { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.5 });
  gsap.to('#hs-ctas',   { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 0.7 });
  gsap.to('#hs-trust',  { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 0.9 });

  const onMouse = (e: MouseEvent) => {
    mouse.x = (e.clientX / window.innerWidth  - 0.5) * 2;
    mouse.y = (e.clientY / window.innerHeight - 0.5) * 2;
  };
  const onResize = () => {
    const w = section.clientWidth;
    const h = section.clientHeight || window.innerHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  };

  window.addEventListener('mousemove', onMouse);
  window.addEventListener('resize', onResize);

  _cleanup = () => {
    cancelAnimationFrame(frameId);
    window.removeEventListener('mousemove', onMouse);
    window.removeEventListener('resize', onResize);
    renderer.dispose();
    ptGeo.dispose();
    lineGeo.dispose();
    ptMat.dispose();
    lineMat.dispose();
  };
}

document.addEventListener('astro:page-load', initHeroSuite);
document.addEventListener('astro:before-swap', () => _cleanup?.());
</script>
