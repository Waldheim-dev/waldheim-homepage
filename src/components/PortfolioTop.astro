---
import { getCollection } from 'astro:content';
import AiImageBadge from './AiImageBadge.astro';

const projects = (await getCollection('projects', ({data}) => data.isTopProject === true)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = await getCollection('projects_kategorie');
---

<style>
  @keyframes bounce-scale {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }
  
  .slide-indicator {
    animation: bounce-scale 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }
</style>

<section class="py-24 sm:py-32 overflow-hidden bg-meg-bg-dark">
  <!-- Header Section - zentriert mit Padding -->
  <div class="mx-auto px-6 lg:px-8 max-w-7xl">
    <div class="mx-auto max-w-2xl sm:text-center gsap-fadein">
      <h2 class="text-3xl font-bold tracking-tight text-meg-text-primary-dark sm:text-4xl">
        Vielfalt in Projekten: Meine Referenzen
      </h2>
      <p class="my-6 text-lg leading-8 text-meg-text-secondary">
        Von Webentwicklung über DevSecOps bis zur Verbandssoftware – hier finden Sie eine Auswahl meiner Projekte.
      </p>
      <a
        href="/referenzen/1/"
        class="mt-6 rounded-xl px-6 py-3 bg-meg-accent text-white hover:shadow-lg hover:shadow-meg-accent/30 hover:scale-[1.02] transition-all duration-300 inline-block font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">
        Gesamtes Portfolio entdecken
      </a>
    </div>
  </div>
  
  <!-- Slider Section - volle Breite -->
  <div class="relative isolate pt-16">
    <div class="flex gap-4 sm:gap-8 md:gap-16 slide overflow-x-auto snap-x snap-mandatory scrollbar-hide pb-8 px-6 lg:px-8">
      {projects.map((project) => (
        <div class="group relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark hover:border-meg-accent/40 gsap-fadein rounded-2xl transition-all duration-300 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-meg-accent hover:shadow-xl hover:shadow-meg-accent/10 min-w-[320px] sm:min-w-[400px] md:min-w-[500px] snap-center shrink-0">
          {/* Ambient Glow on Hover */}
          <div class="absolute -inset-1 bg-gradient-to-r from-meg-accent/0 via-sky-400/0 to-meg-accent/0 group-hover:from-meg-accent/5 group-hover:via-sky-400/5 group-hover:to-meg-accent/5 rounded-2xl blur-xl transition-all duration-300 -z-20"></div>
          <div class="mx-auto flex w-full max-w-2xl flex-col items-center gap-x-8 gap-y-8 px-6 lg:px-8">
            <div class="-mt-8 w-full">
              <div class="relative aspect-video w-full max-w-2xl mx-auto overflow-hidden rounded-2xl ring-1 ring-meg-border-dark group-hover:ring-meg-accent/30 transition-all duration-300">
                {/* Subtle static gradient background */}
                <div class="absolute inset-0 bg-gradient-to-br from-meg-accent/10 via-sky-400/10 to-violet-500/10 blur-md opacity-50 group-hover:opacity-70 transition-opacity duration-300 -z-10" />
                <img
                  class="relative z-10 h-full w-full bg-meg-bg-dark object-cover shadow-2xl group-hover:scale-105 transition-transform duration-500"
                  src={project.data.heroImage}
                  alt={`${project.data.title} – Referenzprojekt Webentwicklung und Design von waldheim.dev`}
                  loading="lazy"
                />
                {project.data.aiGenerated && <AiImageBadge class="absolute top-3 right-3 z-20" />}
              </div>
            </div>
            <div class="w-full max-w-2xl pb-8">
              <figure class="relative isolate pt-6">
                <blockquote class="text-xl font-semibold leading-8 text-meg-text-primary-dark sm:text-2xl sm:leading-9">
                  <p class="gsap-fadein">{project.data.title}</p>
                </blockquote>
                <div class="font-medium text-meg-text-secondary mt-2">
                  {categories.find(category => category.id === project.data?.category.id)?.data.name}
                </div>
                <figcaption class="mt-8 text-base">
                  <a
                    href={`/referenzen/${project.id.replace(/^_/, '').replace(/\/_/, '/')}/`}
                    class="rounded-lg px-4 py-2 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark hover:border-meg-accent/50 hover:shadow-lg hover:shadow-meg-accent/10 hover:scale-105 transition-all duration-300 inline-flex items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent">
                    Projekt ansehen
                    <i class='fa-solid fa-arrow-right' aria-hidden='true'></i>
                  </a>
                </figcaption>
              </figure>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    {/* Slide Indicators - Active Pill + Dots */}
    <div class="flex justify-center items-center gap-2 mt-8" role="group" aria-label="Projekt-Indikator">
      {projects.map((_, index) => (
        <button
          class="slide-indicator relative rounded-full transition-all duration-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent overflow-hidden"
          data-index={index}
          aria-label={`Zu Projekt ${index + 1} springen`}
        >
          <div class="indicator-bg absolute inset-0 bg-meg-surface-dark/80 rounded-full"></div>
          <div class="indicator-progress absolute inset-0 bg-meg-accent rounded-full origin-left scale-x-0 z-10"></div>
        </button>
      ))}
    </div>
  </div>
</section>
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const slide = document.querySelector('.slide');
    const indicators = document.querySelectorAll('.slide-indicator');
    const indicatorBgs = document.querySelectorAll('.indicator-bg');
    const progressBars = document.querySelectorAll('.indicator-progress');
    if (!slide || !indicators.length) return;
    
    const getGap = () => {
      if (window.innerWidth < 640) return 16;
      if (window.innerWidth < 768) return 32;
      return 64;
    };
    
    let gap = getGap();
    window.addEventListener('resize', () => { gap = getGap(); });
    
    const innerTime = 2500;
    const outerTime = innerTime * 2;
    let currentIndex = 0;
    
    // Set initial dot/pill sizes
    const setIndicatorSize = (indicator, bg, index, isActive) => {
      if (isActive) {
        // Active: Pill (wide) - dark background so progress is visible
        indicator.style.width = '80px';
        indicator.style.height = '12px';
        bg.style.backgroundColor = 'rgb(26 72 95 / 0.8)'; // dark-800/80
      } else if (index < currentIndex) {
        // Completed: Small dot (filled with primary color)
        indicator.style.width = '24px';
        indicator.style.height = '12px';
        bg.style.backgroundColor = 'rgb(0 212 208)'; // primary-500 solid
      } else {
        // Upcoming: Small dot (gray/empty)
        indicator.style.width = '24px';
        indicator.style.height = '12px';
        bg.style.backgroundColor = 'rgb(138 190 171 / 0.4)'; // light-500/40
      }
    };
    
    // Update active indicator and start progress animation
    const updateIndicators = (animated = true) => {
      const scrollLeft = slide.scrollLeft;
      const cardWidth = slide.firstElementChild?.offsetWidth || 0;
      const activeIndex = Math.round(scrollLeft / (cardWidth + gap));
      
      if (activeIndex !== currentIndex) {
        currentIndex = activeIndex;
      }
      
      indicators.forEach((indicator, index) => {
        setIndicatorSize(indicator, indicatorBgs[index], index, index === currentIndex);
      });
      
      progressBars.forEach((bar, index) => {
        if (index < currentIndex) {
          // Completed slides - dots are already colored via backgroundColor
          bar.style.transform = 'scaleX(0)';
          bar.style.transition = 'none';
          bar.style.opacity = '0';
        } else if (index === currentIndex) {
          // Active slide - show and animate progress
          bar.style.opacity = '1';
          bar.style.transition = 'none';
          bar.style.transform = 'scaleX(0)';
          
          if (animated) {
            // Start animation after a tiny delay
            setTimeout(() => {
              bar.style.transition = `transform ${outerTime}ms linear`;
              bar.style.transform = 'scaleX(1)';
            }, 50);
          }
        } else {
          // Future slides - empty
          bar.style.transform = 'scaleX(0)';
          bar.style.transition = 'none';
          bar.style.opacity = '0';
        }
      });
      
      // Update aria-current
      indicators.forEach((indicator, index) => {
        if (index === currentIndex) {
          indicator.setAttribute('aria-current', 'true');
        } else {
          indicator.removeAttribute('aria-current');
        }
      });
    };
    
    // Click indicator to jump to slide
    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        const cardWidth = slide.firstElementChild?.offsetWidth || 0;
        slide.style.scrollBehavior = 'smooth';
        slide.scrollLeft = index * (cardWidth + gap);
        clearInterval(slideInterval);
        currentIndex = index;
        updateIndicators(true);
        slideInterval = setInterval(changeSlide, outerTime);
      });
    });
    
    // Listen to scroll events
    slide.addEventListener('scroll', () => {
      const scrollLeft = slide.scrollLeft;
      const cardWidth = slide.firstElementChild?.offsetWidth || 0;
      const newIndex = Math.round(scrollLeft / (cardWidth + gap));
      
      if (newIndex !== currentIndex) {
        currentIndex = newIndex;
        updateIndicators(false); // Don't animate on manual scroll
      }
    });
    
    // Initial update - delayed to ensure DOM is ready
    setTimeout(() => {
      updateIndicators(true);
    }, 100);
    
    const changeSlide = () => {
      const first = slide.firstElementChild;
      if (!first) return;
      slide.style.scrollBehavior = 'smooth';
      slide.scrollLeft += first.offsetWidth + gap;
      
      setTimeout(() => {
        if (slide.scrollLeft >= slide.scrollWidth - slide.clientWidth - 10) {
          slide.style.scrollBehavior = 'auto';
          slide.scrollLeft = 0;
          currentIndex = 0;
        }
        updateIndicators(true);
      }, innerTime);
    };
    
    let slideInterval = setInterval(changeSlide, outerTime);
    
    const pauseSlider = () => {
      clearInterval(slideInterval);
      // Pause the current progress bar
      const currentBar = progressBars[currentIndex];
      if (currentBar) {
        const computedStyle = window.getComputedStyle(currentBar);
        const matrix = computedStyle.transform;
        currentBar.style.transform = matrix;
        currentBar.style.transition = 'none';
      }
    };
    
    const resumeSlider = () => {
      slideInterval = setInterval(changeSlide, outerTime);
      updateIndicators(true); // Restart animation
    };
    
    slide.addEventListener('mouseenter', pauseSlider);
    slide.addEventListener('mouseleave', resumeSlider);
    slide.addEventListener('focusin', pauseSlider);
    slide.addEventListener('focusout', resumeSlider);
    
    let touchStartX = 0;
    slide.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      pauseSlider();
    });
    
    slide.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > 50) {
        slide.style.scrollBehavior = 'smooth';
        if (diff > 0) {
          slide.scrollLeft += slide.firstElementChild.offsetWidth + gap;
        } else {
          slide.scrollLeft -= slide.firstElementChild.offsetWidth + gap;
        }
      }
      
      resumeSlider();
    });
  });
</script>
