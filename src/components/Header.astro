---
import { getCollection } from 'astro:content';
const blogPosts = (await getCollection('blog')).sort((a, b) => {
  return new Date(b.data.pubDate) - new Date(a.data.pubDate);
}).slice(0,1)

import fs from 'node:fs';
const version = JSON.parse(fs.readFileSync('./package.json')).version;
---

<style>
    .right--100 {
        right: -100% !important;
        transition: right 0.3s ease-in-out;
    }
</style>
<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {

    const toggles = document.querySelectorAll('.button-toggle');

    const toggleEvent = (e) => {
      const nav = document.querySelector('.nav-sidebar');
      const dialog = document.querySelector('[role="dialog"]');
      if (nav.classList.contains('right--100')) {
        dialog.style.display = 'block';
        nav.classList.remove('right--100');
      }else {
        dialog.style.display = 'none';
        nav.classList.add('right--100');
      }
    }

    toggles.forEach(toggle => toggle.addEventListener('click', toggleEvent));
  });
</script>

<header class='bg-white dark:bg-slate-800'>
  <nav class='mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8' aria-label='Global'>
    <div class='flex lg:flex-1 gap-1 items-center'>
      <a href='/' class='-m-1.5 p-1.5 flex items-center gap-1'>
        <img class='h-8 w-auto hidden dark:block' src='/waldheim.dev.png' alt='Waldheim.dev' loading='lazy'>
        <img class='h-8 w-auto block dark:hidden' src='/waldheim.dev.dark.png' alt='Waldheim.dev' loading='lazy'>
        <span class='text-gray-800 dark:text-white'>Waldheim.dev</span>
      </a>
      <span
        class='inline-flex items-center gap-x-1.5 rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700 dark:bg-green-100/55 dark:text-green-700'>
        <svg class="h-1.5 w-1.5 fill-green-500 dark:fill-green-500/75" viewBox="0 0 6 6" aria-hidden="true">
          <circle cx="3" cy="3" r="3" />
        </svg>
        v{version}
      </span>

    </div>
    <div class='flex lg:hidden'>
      <button type='button' class='-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-700 dark:text-white button-toggle'>
        <span class='sr-only'>Öffne Menu</span>
        <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'
             aria-hidden='true'>
          <path stroke-linecap='round' stroke-linejoin='round' d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5' />
        </svg>
      </button>
    </div>
    <div class='hidden lg:flex lg:gap-x-12'>
      <a href='/services/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Mein Service</a>
      <a href='/projects/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Projekte</a>
      <a href='/blog/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Blog</a>
      <a href='/ecodrive/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Ecodrive</a>
    </div>
    <div class='hidden lg:flex lg:flex-1 lg:justify-end'>
      <a href='https://forestdesign.atlassian.net/servicedesk/customer/portals' target='_blank'
         class='flex gap-1 rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'>
        Help Center <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5">
        <path fill-rule="evenodd" d="M10 2c-2.236 0-4.43.18-6.57.524C1.993 2.755 1 4.014 1 5.426v5.148c0 1.413.993 2.67 2.43 2.902.848.137 1.705.248 2.57.331v3.443a.75.75 0 001.28.53l3.58-3.579a.78.78 0 01.527-.224 41.202 41.202 0 005.183-.5c1.437-.232 2.43-1.49 2.43-2.903V5.426c0-1.413-.993-2.67-2.43-2.902A41.289 41.289 0 0010 2zm0 7a1 1 0 100-2 1 1 0 000 2zM8 8a1 1 0 11-2 0 1 1 0 012 0zm5 1a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
      </svg>

      </a>
    </div>
  </nav>
  <!-- Mobile menu, show/hide based on menu open state. -->
  <div class='lg:hidden' role='dialog' aria-modal='false' style='display: none;'>
    <!-- Background backdrop, show/hide based on slide-over state. -->
    <div class='fixed inset-0 z-10'></div>
    <div
      class='nav-sidebar right--100 fixed inset-y-0 right-0 z-10 w-full overflow-y-auto bg-white dark:bg-slate-800 px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10'>
      <div class='flex items-center justify-between'>
        <a href='#' class='-m-1.5 p-1.5'>
          <span class='sr-only text-slate-800 dark:text-white'>Waldheim.dev</span>
          <img class='h-8 w-auto hidden dark:block' src='/waldheim.dev.png' alt='waldheim.dev' loading='lazy'>
          <img class='h-8 w-auto block dark:hidden' src='/waldheim.dev.dark.png' alt='waldheim.dev' loading='lazy'>
        </a>
        <button type='button' class='-m-2.5 rounded-md p-2.5 text-gray-700 dark:text-white button-toggle'>
          <span class='sr-only'>Schließe Menu</span>
          <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'
               aria-hidden='true'>
            <path stroke-linecap='round' stroke-linejoin='round' d='M6 18L18 6M6 6l12 12' />
          </svg>
        </button>
      </div>
      <div class='mt-6 flow-root'>
        <div class='-my-6 divide-y divide-gray-500/10'>
          <div class='space-y-2 py-6'>
            <a href='/services/'
               class='-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white dark:hover:bg-gray-900'>Services</a>
            <a href='/projects/'
               class='-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white dark:hover:bg-gray-900'>Projekte</a>
            <a href='/blog/'
               class='-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white dark:hover:bg-gray-900'>Blog</a>
            <a href='/ecodrive/' target='_blank'
               class='-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white dark:hover:bg-gray-900'>Ecodrive</a>
          </div>
          <div class='py-6'>
            <a href='https://forestdesign.atlassian.net/servicedesk/customer/portals' target='_blank'
               class='-mx-3 block rounded-lg px-3 py-2.5 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white dark:hover:bg-gray-900'>Help
              Center</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
{

  blogPosts.map(async (post) => {
    return (
    <div class='flex justify-center items-center gap-x-6 bg-indigo-600 px-6 py-2.5 sm:px-3.5  '>
      <p class='text-sm leading-6 text-white'>
        <a href={`/blog/${post.slug}/`}>
          <strong class='font-semibold'>{post.data.title}</strong>
          <svg viewBox='0 0 2 2' class='mx-2 inline h-0.5 w-0.5 fill-current' aria-hidden='true'>
            <circle cx='1' cy='1' r='1' />
          </svg>
          {post.data.description}&nbsp;<span
          aria-hidden='true'>&rarr;</span>
        </a>
      </p>
    </div>
      );
    })
  }
