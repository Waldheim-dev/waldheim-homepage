---
---

<header class='bg-white dark:bg-slate-800'>
  <nav class='mx-auto flex max-w-7xl items-center justify-between p-6 lg:px-8' aria-label='Global'>
    <div class='flex lg:flex-1 gap-1 items-center'>
      <a href='/' class='-m-1.5 p-1.5 flex items-center gap-1'>
        <img class='h-8 w-auto' src='forestdesign_icon.png' alt='Waldheim.dev'>
        <span class='text-gray-800 dark:text-white'>Waldheim.dev</span>
      </a>
      <span
        class='inline-flex items-center gap-x-1.5 rounded-md bg-green-100 px-2 py-1 text-xs font-medium text-green-700 dark:bg-green-100/55 dark:text-green-700'>
        <svg class="h-1.5 w-1.5 fill-green-500 dark:fill-green-500/75" viewBox="0 0 6 6" aria-hidden="true">
          <circle cx="3" cy="3" r="3" />
        </svg>
				v24.0.0-pre.1
      </span>

    </div>
    <div class='flex lg:hidden'>
      <button type='button' class='-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-700 dark:text-white'>
        <span class='sr-only'>Öffne Menu</span>
        <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'
             aria-hidden='true'>
          <path stroke-linecap='round' stroke-linejoin='round' d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5' />
        </svg>
      </button>
    </div>
    <div class='hidden lg:flex lg:gap-x-12'>
      <a href='/services/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Mein Service</a>
      <a href='/blog/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Blog</a>
      <a href='/ecodrive/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Ecodrive</a>
    </div>
    <div class='hidden lg:flex lg:flex-1 lg:justify-end'>
      <a href='https://forestdesign.atlassian.net/servicedesk/customer/portals' target='_blank'
         class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Help Center <span aria-hidden='true'>&rarr;</span></a>
    </div>
  </nav>
  <!-- Mobile menu, show/hide based on menu open state. -->
  <div class='lg:hidden' role='dialog' aria-modal='true'>
    <!-- Background backdrop, show/hide based on slide-over state. -->
    <div class='fixed inset-0 z-10'></div>
    <div
      class='fixed inset-y-0 right-0 z-10 w-full overflow-y-auto bg-white dark:bg-slate-800 px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10'>
      <div class='flex items-center justify-between'>
        <a href='#' class='-m-1.5 p-1.5'>
          <span class='sr-only text-slate-800 dark:text-white'>Waldheim.dev</span>
          <img class='h-8 w-auto' src='forestdesign_icon.png' alt='waldheim.dev'>
        </a>
        <button type='button' class='-m-2.5 rounded-md p-2.5 text-gray-700 dark:text-white'>
          <span class='sr-only'>Schließe Menu</span>
          <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke-width='1.5' stroke='currentColor'
               aria-hidden='true'>
            <path stroke-linecap='round' stroke-linejoin='round' d='M6 18L18 6M6 6l12 12' />
          </svg>
        </button>
      </div>
      <div class='mt-6 flow-root'>
        <div class='-my-6 divide-y divide-gray-500/10'>
          <div class='space-y-2 py-6'>
            <a href='services'
               class='-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white'>Services</a>
            <a href='https://www.eco-drive.app' target='_blank'
               class='-mx-3 block rounded-lg px-3 py-2 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white'>Ecodrive</a>
          </div>
          <div class='py-6'>
            <a href='https://forestdesign.atlassian.net/servicedesk/customer/portals' target='_blank'
               class='-mx-3 block rounded-lg px-3 py-2.5 text-base font-semibold leading-7 text-gray-900 hover:bg-gray-50 dark:text-white'>Help
              Center</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<div class='flex items-center justify-between gap-x-6 bg-indigo-600 px-6 py-2.5 sm:pr-3.5 lg:pl-8'>
  <p class='text-sm leading-6 text-white'>
    <a href='#'>
      <strong class='font-semibold'>EnterJS 2023</strong>
      <svg viewBox='0 0 2 2' class='mx-2 inline h-0.5 w-0.5 fill-current' aria-hidden='true'>
        <circle cx='1' cy='1' r='1' />
      </svg>
      Frontend-Entwicklung mit den neusten Frameworks. Was gibts alles neues?&nbsp;<span
      aria-hidden='true'>&rarr;</span>
    </a>
  </p>
  <div class='flex flex-1 justify-end'>
    <button type='button' class='-m-3 p-3 focus-visible:outline-offset-[-4px]'>
      <span class='sr-only'>Dismiss</span>
      <svg class='h-5 w-5 text-white' viewBox='0 0 20 20' fill='currentColor' aria-hidden='true'>
        <path
          d='M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z' />
      </svg>
    </button>
  </div>
</div>
