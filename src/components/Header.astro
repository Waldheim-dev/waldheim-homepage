<style>
    .right--100 {
        right: -100% !important;
        transition: right 0.3s ease-in-out;
    }
</style>
<script is:inline>
  document.addEventListener('DOMContentLoaded', async () => {

    const toggles = document.querySelectorAll('.button-toggle');
    const dropdowns  = document.querySelectorAll('.dropdown');
    const menuTriggerSubnav = document.querySelectorAll('.mobile-subnav');

    const toggleEvent = (e) => {
      const nav = document.querySelector('.nav-sidebar');
      const dialog = document.querySelector('[role="dialog"]');
      if (nav.classList.contains('right--100')) {
        dialog.style.display = 'block';
        nav.classList.remove('right--100');
      }else {
        dialog.style.display = 'none';
        nav.classList.add('right--100');
      }
    }

    const toggleDropdowns = (e) => {
      const dropdown = e.currentTarget;
      const menu = dropdown.querySelector('.dropdown-menu');
      const trigger = dropdown.querySelector('.dropdown-trigger');
      const isOpen = menu.classList.contains('opacity-100');
      if (isOpen) {
        menu.classList.remove('opacity-100');
        menu.classList.remove('translate-y-0');
        menu.classList.remove('flex');
        menu.classList.add('opacity-0');
        menu.classList.add('translate-y-1');
        menu.classList.add('hidden');
        trigger.setAttribute('aria-expanded', 'false');
      }else {
        menu.classList.remove('opacity-0');
        menu.classList.remove('translate-y-1');
        menu.classList.remove('hidden');
        menu.classList.add('opacity-100');
        menu.classList.add('translate-y-0');
        menu.classList.add('flex');
        trigger.setAttribute('aria-expanded', 'true');
      }
    }

    const mobileToggleDropdowns = (e) => {
      const dropdown = e.currentTarget;
      dropdown.classList.toggle('active');
      dropdown.setAttribute('aria-expanded', dropdown.classList.contains('active'));
      dropdown.nextElementSibling.toggleAttribute('hidden');
      dropdown.querySelector('svg').classList.toggle('rotate-180');
    }



    toggles.forEach(toggle => toggle.addEventListener('click', toggleEvent));
    dropdowns.forEach(toggle => toggle.addEventListener('click', toggleDropdowns));
    menuTriggerSubnav.forEach(toggle => toggle.addEventListener('click', mobileToggleDropdowns));
  });
</script>

