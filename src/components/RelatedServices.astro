---
/**
 * RelatedServices Component
 * Zeigt verwandte Service-Links am Ende einer Service-Seite
 * Verbessert Internal Linking für SEO
 */

import { SERVICES, type Service } from '../consts/services';

interface Props {
  services?: Service[];
  headline?: string;
  exclude?: string;
}

const { 
  services: manualServices, 
  headline = 'Weitere Services für Ihre digitale Transformation',
  exclude
} = Astro.props;

const currentPath = Astro.url.pathname;
const services = manualServices || SERVICES.filter(s => {
    if (exclude && s.key === exclude) return false;
    const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
    const normalizedHref = s.href.endsWith('/') ? s.href : `${s.href}/`;
    return normalizedPath !== normalizedHref;
});

const colorClasses = {
  purple: 'border-violet-500/20 hover:border-violet-500/40 text-violet-400',
  blue: 'border-meg-accent/20 hover:border-meg-accent/40 text-meg-accent',
  green: 'border-emerald-500/20 hover:border-emerald-500/40 text-emerald-400',
  orange: 'border-orange-500/20 hover:border-orange-500/40 text-orange-400',
  pink: 'border-rose-500/20 hover:border-rose-500/40 text-rose-400',
};
---

<section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto max-w-2xl text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-black tracking-normal text-meg-text-primary-dark mb-4">
        {headline}
      </h2>
      <p class="text-lg text-meg-text-secondary">
        Entdecken Sie, wie unsere Services sich perfekt ergänzen.
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {services.map((service) => (
        <a 
          href={service.href}
          class={`group bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 transition-all duration-300 hover:shadow-xl hover:shadow-meg-accent/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent`}
        >
          <div class={`w-14 h-14 bg-meg-surface-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 group-hover:border-meg-accent/30 transition-all duration-300 shadow-sm`}>
            <i class={`${service.icon} text-meg-accent text-2xl`} aria-hidden="true"></i>
          </div>
          <h3 class={`text-xl font-bold text-meg-text-primary-dark mb-3 transition-all duration-300 group-hover:text-meg-accent`}>
            {service.title}
          </h3>
          <p class="text-meg-text-secondary mb-6 line-clamp-3">
            {service.description}
          </p>
          <span class={`inline-flex items-center gap-2 text-meg-accent font-bold text-sm group-hover:gap-4 transition-all duration-300`}>
            Mehr erfahren
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
