---
import type { Lang } from '../i18n/utils';

export interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const t = {
  de: {
    sectionLabel: 'Roadmap',
    headlinePrefix: 'Der Weg zu',
    headlineAccent: 'v1.0.0',
    subtitle:
      'semrel entwickelt sich kontinuierlich weiter. Fokus: Stabilität, Ecosystem-Ausbau und Enterprise-Readiness.',
    ariaLabel: 'Entwicklungs-Roadmap',
    linkText: 'Vollständige Roadmap auf GitHub',
    linkLabel: 'Vollständige Roadmap auf GitHub',
  },
  en: {
    sectionLabel: 'Roadmap',
    headlinePrefix: 'The road to',
    headlineAccent: 'v1.0.0',
    subtitle:
      'semrel evolves continuously. Focus: stability, ecosystem growth and enterprise readiness.',
    ariaLabel: 'Development roadmap',
    linkText: 'Full Roadmap on GitHub',
    linkLabel: 'Open full roadmap on GitHub',
  },
}[lang];
const roadmilestones = [
  {
    version: 'v0.1 – v0.10',
    label: 'Zero-Dependency Core & Plugin Runtime',
    status: 'done',
    desc: {
      de: 'Statische Go-Binärdatei ohne Node.js-Abhängigkeiten, Subprocess-Plugin-Runtime und semrel doctor Empfehlungen.',
      en: 'Static Go binary with zero Node.js dependencies, subprocess plugin runtime and semrel doctor recommendations.',
    },
  },
  {
    version: 'v0.11 – v0.13',
    label: 'Lockfile (.semrel.lock), Air-Gap & Monorepo Workspace',
    status: 'done',
    desc: {
      de: 'Reproduzierbare Plugin-Installationen mit SHA256-Prüfsummen, Air-Gap-Restore und Monorepo-Orchestrierung via semrel workspace.',
      en: 'Reproducible plugin installs with SHA256 checksums, air-gap restore and monorepo orchestration via semrel workspace.',
    },
  },
  {
    version: 'v0.14 – v0.18',
    label: '8-Phase Pluggable Pipeline',
    status: 'done',
    desc: {
      de: 'Neue Generator-, Packager- und Publisher-Phasen plus semrel plugin update & restore Commands.',
      en: 'New Generator, Packager and Publisher pipeline phases plus semrel plugin update & restore commands.',
    },
  },
  {
    version: 'v0.19 – v0.24',
    label: 'Scope-Versioning, Registry Analytics & Contributor Metadata',
    status: 'done',
    desc: {
      de: 'Scope-basierte Release-Regeln, Download-Tracking in der Registry, optimierte GitHub Actions Defaults und Contributor-Metadaten für Plugins.',
      en: 'Scope-based release rules, registry download tracking, enhanced GitHub Actions defaults and contributor metadata for plugins.',
    },
  },
  {
    version: 'v0.25 – v0.26.3',
    label: 'Cosign v3 Bundle, Env-Interpolation & Tagless CI',
    status: 'done',
    desc: {
      de: 'Sigstore Cosign v3 (--bundle) Signierung, Env-Var-Interpolation in .semrel.yaml, --commit-msg-file für commitlint, taglose Release-Auflösung und idempotente Docker-Retries.',
      en: 'Sigstore Cosign v3 (--bundle) signing, env-var interpolation in .semrel.yaml, --commit-msg-file for commitlint, tagless release resolution and idempotent Docker retries.',
    },
  },
  {
    version: 'v0.27+',
    label: 'Ecosystem & Enterprise Adopter Expansion',
    status: 'current',
    desc: {
      de: 'Ausbau des 30+ Plugin-Ökosystems, tiefere Enterprise-CI/CD-Integrationen und Onboarding weiterer Production Adopters.',
      en: 'Expansion of the 30+ plugin ecosystem, deeper enterprise CI/CD integrations and onboarding additional production adopters.',
    },
  },
  {
    version: 'v1.0.0',
    label: 'v1.0 Stabilization & Long-Term Guarantees',
    status: 'planned',
    desc: {
      de: 'Langfristige API-, Plugin-Protokoll- und JSON-Schema-v1-Stabilitätsgarantien für kritische Enterprise-Infrastrukturen.',
      en: 'Long-term API, plugin protocol and JSON Schema v1 stability guarantees for critical enterprise infrastructure.',
    },
  },
];
---

<section class='py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark' id='roadmap' aria-labelledby='semrel-roadmap-heading'>
  <div class='mx-auto max-w-4xl'>
    <header class='text-center mb-16'>
      <h2 id='semrel-roadmap-heading' class='gsap-fadein text-sm font-bold uppercase tracking-widest text-blue-400 mb-4'>
        {t.sectionLabel}
      </h2>
      <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
        {t.headlinePrefix} <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-sky-400'>{t.headlineAccent}</span>
      </p>
      <p class='gsap-fadein text-meg-text-secondary' style='animation-delay: 0.3s'>
        {t.subtitle}
      </p>
    </header>

    <ol class='relative' aria-label={t.ariaLabel}>
      {roadmilestones.map((m, i) => (
        <li
          class={`gsap-fadein relative pl-10 pb-10 last:pb-0 ${i < roadmilestones.length - 1 ? 'before:absolute before:left-[15px] before:top-6 before:bottom-0 before:w-px before:bg-meg-border-dark' : ''}`}
          style={`animation-delay: ${0.45 + i * 0.1}s`}
        >
          <div class={`absolute left-0 top-1 size-8 rounded-full border-2 flex items-center justify-center ${
            m.status === 'done'
              ? 'bg-blue-500/20 border-blue-500 text-blue-400'
              : m.status === 'current'
                ? 'bg-sky-400/20 border-sky-400 text-sky-400 animate-pulse'
                : 'bg-meg-surface-dark border-meg-border-dark text-meg-text-secondary'
          }`} aria-hidden='true'>
            <i class={`fa-solid text-xs ${
              m.status === 'done' ? 'fa-check' : m.status === 'current' ? 'fa-circle-dot' : 'fa-clock'
            }`}></i>
          </div>
          <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-5 hover:border-blue-500/20 transition-all'>
            <div class='flex items-center gap-3 mb-2'>
              <code class='font-mono font-black text-blue-400 text-sm'>{m.version}</code>
              <span class='font-bold text-meg-text-primary-dark'>{m.label}</span>
              {m.status === 'done' && (
                <span class='ml-auto text-[10px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded'>shipped</span>
              )}
              {m.status === 'current' && (
                <span class='ml-auto text-[10px] font-black uppercase tracking-widest text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2 py-0.5 rounded'>in progress</span>
              )}
              {m.status === 'planned' && (
                <span class='ml-auto text-[10px] font-black uppercase tracking-widest text-meg-text-secondary bg-meg-bg-dark border border-meg-border-dark px-2 py-0.5 rounded'>planned</span>
              )}
            </div>
            <p class='text-meg-text-secondary text-sm'>{m.desc[lang]}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class='mt-8 text-center'>
      <a
        href='https://github.com/SemRels/semrel/blob/main/ROADMAP.md'
        target='_blank'
        rel='noopener noreferrer'
        class='inline-flex items-center gap-2 text-blue-400 font-bold hover:underline'
        aria-label={t.linkLabel}
      >
        {t.linkText}
        <i class='fa-solid fa-arrow-up-right-from-square text-xs' aria-hidden='true'></i>
      </a>
    </div>
  </div>
</section>
