---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import SemrelHero from '../../../components/SemrelHero.astro';
import SemrelFeatures from '../../../components/SemrelFeatures.astro';
import SemrelPlugins from '../../../components/SemrelPlugins.astro';
import SemrelQuickStart from '../../../components/SemrelQuickStart.astro';
import SemrelRoadmap from '../../../components/SemrelRoadmap.astro';
import SemrelContribute from '../../../components/SemrelContribute.astro';

const titel = 'semrel v0.28.2 — Semantic Releases. Fully Automated. Open Source.';
const description = 'semrel v0.28.2: Go-native, zero-dependency semantic release automation. One static binary, Conventional Commits, 30+ plugins, monorepo & air-gap ready.';
const keywords = 'semrel, semantic release alternative, go semver automation, conventional commits, monorepo release, air gapped release automation, supply chain secure release, ci cd release automation';
const ogImage = 'https://waldheim.dev/semrel/og-image.jpg';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'semrel',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/OnlineOnly',
  },
  softwareVersion: '0.28.2',
  description:
    'Go-native, zero-dependency semantic release automation. Automates SemVer, changelog and publishing via Conventional Commits and a fully pluggable pipeline.',
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  author: [
    { '@type': 'Person', name: 'Markus Waldheim', url: 'https://waldheim.dev' },
    { '@type': 'Person', name: 'Thomas Boerger' },
  ],
  url: 'https://www.semrel.io/',
  codeRepository: 'https://github.com/SemRels/semrel',
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'semrel', link: 'https://waldheim.dev/en/semrel' },
]);
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <main id='main-content'>
    <SemrelHero lang='en' />
    <SemrelFeatures lang='en' />
    <SemrelPlugins lang='en' />
    <SemrelQuickStart lang='en' />
    <SemrelRoadmap lang='en' />
    <SemrelContribute lang='en' />
  </main>
</Layout>
