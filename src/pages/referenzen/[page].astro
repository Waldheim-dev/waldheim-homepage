---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SchemaUtils } from '../../utils/schema';

export async function getStaticPaths({ paginate }) {
  const projects = (await getCollection('projects'))
    .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate));

  // Generate pages from our array of astronauts, with 2 to a page
  return paginate(projects, { pageSize: 4 });
}
const { page } = Astro.props;
const categories = (await getCollection('projects_kategorie'));
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
}, {
  name: 'Referenzen',
  link: Astro.url.href
}]);

const titel = 'Projekte & Referenzen - waldheim.dev';
const description = 'Entdecken Sie unsere Referenzprojekte: Webentwicklung, Softwarelösungen, Design und mehr. Überzeugen Sie sich von unserer Expertise und Qualität.';
const keywords = 'Softwareprojekte, Webentwicklungsprojekte, IT-Projekte, Referenzen, Portfolio, Webdesign';
---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center gsap-fadein">
        <h1 class="text-3xl font-bold tracking-tight text-light-100 sm:text-4xl">Referenzen: Meine
          Projekte im Überblick</h1>
        <p class="mt-2 text-lg leading-8 text-light-300">Hier finden Sie eine Auswahl meiner
          erfolgreich abgeschlossenen Projekte. Die Liste wird fortlaufend aktualisiert und ist chronologisch geordnet
          (neueste Projekte zuerst).</p>
      </div>

      <div
        class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-x-8 gap-y-16 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-2">


        {
          page.data.map((project) => {
            return (
              <div class="relative bg-dark-900/50 border border-primary-500/20 pb-28 sm:pb-36 xl:pb-16 rounded-2xl sm:min-w-96 max-w-full gsap-fadein hover:border-primary-500/40 transition-all duration-300"
                   data-trigger="entry" data-type={project.data?.category}>
                <div
                  class="mx-auto flex flex-col items-center gap-x-8 gap-y-10 px-6">
                  <div class="-mt-8 w-full max-w-1xl xl:-mb-8">
                    <div class="relative aspect-16/9 w-full md:-mx-8 xl:mx-0 group">
                      <div
                        class="absolute -inset-2 bg-gradient-to-r from-primary-500/20 via-cyan-500/20 to-purple-500/20 blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-3xl" />

                      <img class="relative z-10 h-full w-full rounded-2xl bg-gray-800 object-cover shadow-2xl border border-light-500/20"
                           src={project.data.heroImage} alt={project.data.title} loading="lazy">
                    </div>
                  </div>
                  <div class="md:min-w-96 xl:flex-auto">
                    <figure class="relative isolate pt-6 sm:pt-12 text-white">
                      <FormattedDate date={project.data.pubDate} />
                      <blockquote class="text-xl font-semibold leading-8 text-white sm:text-2xl sm:leading-9">
                        <p>{project.data.title}</p>
                      </blockquote>
                      <div
                        class="font-medium text-slate-300">
                        {categories.find(category => category.id === project.data?.category.id)?.data.name
                        }</div>

                      <p
                        class="flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300">{project.data.shortDescription}</p>
                      <figcaption class="mt-8 text-base">
                        <a href={`/referenzen/${project.id.replace(/^_/, '').replace(/\/_/, '/')}/`} aria-label={`Projekt ${project.data.title} ansehen`}
                           class="rounded-md px-3 py-2 bg-primary-800 text-white hover:shadow-lg hover:shadow-primary-500/50 transition-all outline-none">Projekt
                          ansehen</a>
                      </figcaption>
                    </figure>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <script is:inline>
        const buttons = document.querySelectorAll('button[data-trigger="filter"]');
        const projects = document.querySelectorAll('*[data-trigger="entry"]');

        buttons.forEach(button => {
          button.addEventListener('click', () => {
            buttons.forEach(btn => {
              btn.classList.remove('bg-blue-600', 'text-white');
              btn.classList.add('bg-dark-900/50', 'text-light-300', 'border-light-500/30');
            });
            button.classList.add('bg-blue-600', 'text-white');
            button.classList.remove('bg-dark-900/50', 'text-light-300', 'border-light-500/30');

            const filter = button.getAttribute('data-filter');

            projects.forEach(project => {
              const type = project.getAttribute('data-type');
              if (filter === 'all' || filter === type) {
                project.style.removeProperty('display');
              } else {
                project.style.display = 'none';
              }
            });
          });
        });
      </script>

        
  <div class="py-24 sm:py-32 gsap-fadein ">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
  <nav class="flex items-center justify-between border-t border-light-200  px-4 py-3 sm:px-6 mt-4"
  aria-label="Pagination">
<div class="hidden sm:block">
 <p class="text-sm text-light-100 ">
   Zeige
   <span class="font-medium">{ page.start + 1}</span>
   bis
   <span class="font-medium">{ page.end + 1}</span>
   von
   <span class="font-medium">{page.total}</span>
   Ergebnissen
 </p>
</div>
<div class="flex flex-1 justify-between sm:justify-end gap-2">


 {page.url.first ? <a href={page.url.first}
                      class="relative hidden sm:inline-flex cursor-pointer items-center rounded-md bg-primary-800 border border-primary-500/30 px-3 py-2 text-sm font-semibold text-light-100 hover:shadow-lg hover:shadow-primary-500/50 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Erste Seite</a> : null}
 {page.url.prev ? <a href={page.url.prev}
                     class="relative inline-flex cursor-pointer items-center rounded-md bg-primary-800 border border-primary-500/30 px-3 py-2 text-sm font-semibold text-light-100 hover:shadow-lg hover:shadow-primary-500/50 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Vorherige Seite</a> : null}
 {page.url.next ? <a href={page.url.next}
                     class="relative inline-flex cursor-pointer items-center rounded-md bg-primary-800 border border-primary-500/30 px-3 py-2 text-sm font-semibold text-light-100 hover:shadow-lg hover:shadow-primary-500/50 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Nächste Seite</a> : null}
 {page.url.last ? <a href={page.url.last}
                     class="relative hidden sm:inline-flex cursor-pointer items-center rounded-md bg-primary-800 border border-primary-500/30 px-3 py-2 text-sm font-semibold text-light-100 hover:shadow-lg hover:shadow-primary-500/50 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500">Letzte Seite</a> : null}
</div>
</nav></div></div>


    </div>
  </div>
</Layout>
