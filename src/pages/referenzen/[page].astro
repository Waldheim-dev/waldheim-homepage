---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SchemaUtils } from '../../utils/schema';

export async function getStaticPaths({ paginate }) {
  const projects = (await getCollection('projects'))
    .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate));

  // Generate pages from our array of astronauts, with 2 to a page
  return paginate(projects, { pageSize: 4 });
}
const { page } = Astro.props;
const categories = (await getCollection('projects_kategorie'));
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home'
}, {
  name: 'Referenzen',
  link: Astro.url.href
}]);

const titel = 'Projekte & Referenzen - waldheim.dev';
const description = 'Entdecken Sie unsere Referenzprojekte: Webentwicklung, Softwarelösungen, Design und mehr. Überzeugen Sie sich von unserer Expertise und Qualität.';
const keywords = 'Softwareprojekte, Webentwicklungsprojekte, IT-Projekte, Referenzen, Portfolio, Webdesign';
---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900  sm:text-4xl">Referenzen: Meine
          Projekte im Überblick</h1>
        <p class="mt-2 text-lg leading-8 text-gray-600 ">Hier finden Sie eine Auswahl meiner
          erfolgreich abgeschlossenen Projekte. Die Liste wird fortlaufend aktualisiert und ist chronologisch geordnet
          (neueste Projekte zuerst).</p>
      </div>

      <div
        class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-x-8 gap-y-16 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-2">


        {
          page.data.map((project) => {
            return (
              <div class="bg-antique-brass-400 pb-28 sm:pb-36 xl:pb-16 rounded-2xl sm:min-w-96 max-w-full"
                   data-trigger="entry" data-type={project.data?.category}>
                <div
                  class="mx-auto flex flex-col items-center gap-x-8 gap-y-10 px-6">
                  <div class="-mt-8 w-full max-w-1xl xl:-mb-8">
                    <div class="relative aspect-16/9 w-full md:-mx-8 xl:mx-0">
                      <div
                        class="blur-sm absolute inset-0 rounded-3xl transition-all -translate-x-0 translate-y-0 bg-conic-180 from-pink-500 via-cyan-500 to-violet-500 animate-rotate_gradient" />

                      <img class="absolute inset-0 h-full w-full rounded-2xl bg-gray-800 object-cover shadow-2xl"
                           src={project.data.heroImage} alt={project.data.title} loading="lazy">
                    </div>
                  </div>
                  <div class="md:min-w-96 xl:flex-auto">
                    <figure class="relative isolate pt-6 sm:pt-12 text-white">
                      <FormattedDate date={project.data.pubDate} />
                      <blockquote class="text-xl font-semibold leading-8 text-white sm:text-2xl sm:leading-9">
                        <p>{project.data.title}</p>
                      </blockquote>
                      <div
                        class="font-medium text-slate-300">
                        {categories.find(category => category.id === project.data?.category.id)?.data.name
                        }</div>

                      <p
                        class="flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300">{project.data.shortDescription}</p>
                      <figcaption class="mt-8 text-base">
                        <a href={`/referenzen/${project.id.replace(/^_/, '').replace(/\/_/, '/')}/`} aria-description=""
                           class="rounded-md px-3 py-2 bg-sherpa-blue-900  text-white hover:bg-wd">Projekt
                          ansehen</a>
                      </figcaption>
                    </figure>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>

      <script is:inline>
        const buttons = document.querySelectorAll('button[data-trigger="filter"]');
        const projects = document.querySelectorAll('*[data-trigger="entry"]');

        buttons.forEach(button => {
          button.addEventListener('click', () => {
            buttons.forEach(btn => {
              btn.classList.remove('bg-sherpa-blue-200');
              btn.classList.add('bg-gray-200');
            });
            button.classList.add('bg-sherpa-blue-200');
            button.classList.remove('bg-gray-200');

            const filter = button.getAttribute('data-filter');

            projects.forEach(project => {
              const type = project.getAttribute('data-type');
              if (filter === 'all' || filter === type) {
                project.style.removeProperty('display');
              } else {
                project.style.display = 'none';
              }
            });
          });
        });
      </script>

      <nav class="flex items-center justify-between border-t border-gray-200  px-4 py-3 sm:px-6 mt-4"
           aria-label="Pagination">
        <div class="hidden sm:block">
          <p class="text-sm text-gray-700 ">
            Zeige
            <span class="font-medium">{ page.start + 1}</span>
            bis
            <span class="font-medium">{ page.end + 1}</span>
            von
            <span class="font-medium">{page.total}</span>
            Ergebnissen
          </p>
        </div>
        <div class="flex flex-1 justify-between sm:justify-end gap-2">


          {page.url.first ? <a href={page.url.first}
                               class="relative inline-flex cursor-pointer items-center rounded-md bg-pancho-200 px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-antique-brass-400 focus-visible:outline-offset-0    ">Erste Seite</a> : null}
          {page.url.prev ? <a href={page.url.prev}
                              class="relative inline-flex cursor-pointer items-center rounded-md bg-pancho-200 px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-antique-brass-400 focus-visible:outline-offset-0    ">Vorherige Seite</a> : null}
          {page.url.next ? <a href={page.url.next}
                              class="relative inline-flex cursor-pointer items-center rounded-md bg-pancho-200 px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-antique-brass-400 focus-visible:outline-offset-0    ">Nächste Seite</a> : null}
          {page.url.last ? <a href={page.url.last}
                              class="relative inline-flex cursor-pointer items-center rounded-md bg-pancho-200 px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-antique-brass-400 focus-visible:outline-offset-0    ">Letzte Seite</a> : null}
        </div>
      </nav>


    </div>
  </div>
</Layout>
