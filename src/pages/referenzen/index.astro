---
// This code has been partially generated by an AI.
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SchemaUtils } from '../../utils/schema';
import AiImageBadge from '../../components/AiImageBadge.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const pageSize = 6;
const paginatedProjects = projects.slice(0, pageSize);

// Alle Waldheim.dev SaaS-Produkte & Open-Source-Projekte gezielt hervorheben
const productAndOssProjects = projects.filter((p) =>
  p.id.replace(/^_/, '').startsWith('waldheim-dev/') &&
  !p.id.includes('_homepage')
);

const categories = await getCollection('projects_kategorie');
const getCategoryName = (catId?: string) =>
  categories.find((c) => c.id.replace(/^_/, '') === catId?.replace(/^_/, ''))?.data.name || catId;

// SEO & Meta
const titel = 'Case Studies & IT-Referenzen Augsburg | Waldheim.dev';
const description = 'Erfolgreiche IT-Projekte, SaaS-Produkte (Waldheim Suite) & Open-Source-Lösungen (semrel, Amigo). Entdecken Sie Case Studies aus DevSecOps, Software & Design.';
const keywords = 'IT Referenzen Augsburg, Software Portfolio München, Case Studies Webentwicklung, semrel Case Study, Waldheim Suite Referenzen, Open Source Projekte';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Referenzen',
  link: 'https://waldheim.dev/referenzen'
}]);
---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <main id="main-content" class="bg-meg-bg-dark min-h-screen">
    <section class="py-24 sm:py-32" aria-labelledby="portfolio-heading">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <header class="mx-auto max-w-3xl text-center mb-16">
          <h1 id="portfolio-heading" class="text-4xl md:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Projekte, Produkte &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Open Source</span>
          </h1>
          <p class="text-xl text-meg-text-secondary">
            Ein Auszug meiner Arbeit: Von Kundenprojekten und DevSecOps-Architekturen über die SaaS-Module der <strong>Waldheim Suite</strong> bis zum Open-Source-Stack rund um <strong>semrel</strong>.
          </p>
        </header>

        <!-- Direktübersicht: Alle SaaS-Produkt- & Open-Source-Referenzen -->
        <section class="mb-24" aria-labelledby="product-oss-refs-heading">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-meg-border-dark pb-6">
            <div>
              <p class="text-xs font-black uppercase tracking-widest text-meg-accent mb-2">
                SaaS &amp; Open-Source Case Studies
              </p>
              <h2 id="product-oss-refs-heading" class="text-2xl sm:text-3xl font-black tracking-tight text-meg-text-primary-dark">
                Referenzen zu unseren Produkten &amp; Open-Source-Projekten
              </h2>
            </div>
            <span class="text-xs font-bold text-meg-text-secondary bg-meg-surface-dark border border-meg-border-dark px-3 py-1.5 rounded-full">
              {productAndOssProjects.length} Case Studies verfügbar
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {productAndOssProjects.map((project) => {
              const slug = project.id.replace(/^_/, '').replace(/\/_/, '/');
              const isOss = project.data.tags?.some((t) => t.toLowerCase().includes('open source')) || slug.includes('semrel');
              const categoryName = getCategoryName(project.data?.category?.id);
              return (
                <a
                  href={`/referenzen/${slug}/`}
                  class="group bg-meg-surface-dark/50 border border-meg-border-dark hover:border-meg-accent/50 rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl"
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-4">
                      <span class={`text-[10px] font-black uppercase tracking-widest px-2.5 py-1 rounded-full border ${
                        isOss
                          ? 'text-blue-400 bg-blue-500/10 border-blue-500/30'
                          : 'text-meg-accent bg-meg-accent/10 border-meg-accent/30'
                      }`}>
                        {isOss ? 'Open Source' : 'SaaS / Suite'}
                      </span>
                      <span class="text-[10px] font-bold text-meg-text-secondary">
                        {categoryName}
                      </span>
                    </div>
                    <h3 class="text-lg font-bold text-meg-text-primary-dark mb-2 group-hover:text-meg-accent transition-colors">
                      {project.data.title}
                    </h3>
                    <p class="text-meg-text-secondary text-xs leading-relaxed line-clamp-3 mb-4">
                      {project.data.shortDescription || project.data.description}
                    </p>
                  </div>
                  <div class="flex items-center justify-between pt-4 border-t border-meg-border-dark/60 text-xs font-bold text-meg-accent">
                    <span>Case Study lesen</span>
                    <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
                  </div>
                </a>
              );
            })}
          </div>
        </section>

        <div class="mb-10">
          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-meg-text-primary-dark">
            Neueste Case Studies (Chronologisch)
          </h2>
        </div>

        <div class="mx-auto grid max-w-2xl auto-rows-fr grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-2">
          {
            paginatedProjects.map((project, index) => {
              const categoryName = getCategoryName(project.data?.category?.id);
              return (
                <article class="relative bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl overflow-hidden hover:border-meg-accent/50 transition-all duration-500 group shadow-lg flex flex-col">
                  <div class="relative aspect-video overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-meg-bg-dark to-transparent opacity-60 z-10"></div>
                    <img 
                      class="relative h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
                      src={project.data.heroImage} 
                      alt={`Referenzprojekt: ${project.data.title}`} 
                      loading={index < 2 ? "eager" : "lazy"}
                      fetchpriority={index < 2 ? "high" : "auto"}
                    >
                    {project.data.aiGenerated && <AiImageBadge class="absolute bottom-3 right-3 z-20" />}
                    <div class="absolute top-4 left-4 z-20">
                      <span class="px-3 py-1 bg-meg-accent text-white text-[10px] font-black uppercase tracking-widest rounded-lg backdrop-blur-md">
                        {categoryName}
                      </span>
                    </div>
                  </div>
                  
                  <div class="p-8 flex flex-col flex-1">
                    <div class="flex items-center gap-2 text-meg-text-secondary text-xs font-bold mb-4">
                      <i class="fa-solid fa-calendar-check text-meg-accent" aria-hidden="true"></i>
                      <FormattedDate date={project.data.pubDate} />
                    </div>
                    
                    <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-4 group-hover:text-meg-accent transition-colors">
                      {project.data.title}
                    </h3>
                    
                    <p class="text-meg-text-secondary text-sm leading-relaxed mb-8 line-clamp-3">
                      {project.data.shortDescription}
                    </p>
                    
                    <div class="mt-auto">
                      <a 
                        href={`/referenzen/${project.id.replace(/^_/, '').replace(/\/_/, '/')}/`} 
                        class="inline-flex items-center gap-2 px-6 py-3 bg-meg-surface-dark border border-meg-border-dark rounded-xl font-bold text-sm hover:border-meg-accent/50 hover:bg-meg-accent/5 transition-all"
                      >
                        Case Study ansehen
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>

        {projects.length > pageSize && (
          <div class="mt-20 text-center">
            <a 
              href="/referenzen/1/" 
              class="inline-flex items-center gap-3 px-8 py-4 bg-meg-accent text-white font-bold rounded-2xl shadow-xl shadow-meg-accent/20 hover:scale-[1.05] transition-all"
            >
              Alle {projects.length} Fallstudien entdecken
              <i class="fa-solid fa-table-cells" aria-hidden="true"></i>
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- Social Proof Trust-Section -->
    <section class="py-24 bg-meg-surface-dark/20 border-t border-meg-border-dark">
      <div class="mx-auto max-w-7xl px-6 text-center">
        <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-12">Technologien im Einsatz</h2>
        <div class="flex flex-wrap justify-center gap-8 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-1000">
          <i class="fa-brands fa-angular text-4xl" aria-hidden="true"></i>
          <i class="fa-brands fa-node-js text-4xl" aria-hidden="true"></i>
          <i class="fa-brands fa-golang text-4xl" aria-hidden="true"></i>
          <i class="fa-brands fa-docker text-4xl" aria-hidden="true"></i>
          <i class="fa-brands fa-aws text-4xl" aria-hidden="true"></i>
          <i class="fa-brands fa-react text-4xl" aria-hidden="true"></i>
        </div>
      </div>
    </section>
  </main>
</Layout>