---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SchemaUtils } from '../../utils/schema';
import AiImageBadge from '../../components/AiImageBadge.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const pageSize = 4;
const paginatedProjects = projects.slice(0, pageSize);

const categories = (await getCollection('projects_kategorie'));

// SEO & Meta
const titel = 'Case Studies & IT-Referenzen Augsburg | Waldheim.dev';
const description = 'Erfolgreiche IT-Projekte aus den Bereichen DevSecOps, Softwareentwicklung & UX Design. Entdecken Sie, wie ich Unternehmen in Augsburg & München voranbringe.';
const keywords = 'IT Referenzen Augsburg, Software Portfolio München, Case Studies Webentwicklung, Markus Waldheim Projekte, IT Projekterfolge Bayern';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Referenzen',
  link: 'https://waldheim.dev/referenzen'
}]);
---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <main id="main-content" class="bg-meg-bg-dark min-h-screen">
    <section class="py-24 sm:py-32" aria-labelledby="portfolio-heading">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <header class="mx-auto max-w-2xl text-center mb-16">
          <h1 id="portfolio-heading" class="text-4xl md:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Projekte & <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Erfolge</span>
          </h1>
          <p class="text-xl text-slate-400">
            Ein Auszug meiner Arbeit: Von der strategischen Beratung bis zur fertigen Applikation. Messbare Ergebnisse für anspruchsvolle Kunden.
          </p>
        </header>

        <div class="mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-2">
          {
            paginatedProjects.map((project, index) => {
              const categoryName = categories.find(category => category.id === project.data?.category.id)?.data.name;
              return (
                <article class="relative bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl overflow-hidden hover:border-meg-accent/50 transition-all duration-500 group shadow-lg flex flex-col">
                  <div class="relative aspect-video overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-meg-bg-dark to-transparent opacity-60 z-10"></div>
                    <img 
                      class="relative h-full w-full object-cover group-hover:scale-105 transition-transform duration-700"
                      src={project.data.heroImage} 
                      alt={`Referenzprojekt: ${project.data.title}`} 
                      loading={index < 2 ? "eager" : "lazy"}
                      fetchpriority={index < 2 ? "high" : "auto"}
                    >
                    {project.data.aiGenerated && <AiImageBadge class="absolute top-4 right-4 z-20" />}
                    <div class="absolute top-4 left-4 z-20">
                      <span class="px-3 py-1 bg-meg-accent/90 text-slate-900 text-[10px] font-black uppercase tracking-widest rounded-lg backdrop-blur-md">
                        {categoryName}
                      </span>
                    </div>
                  </div>
                  
                  <div class="p-8 flex flex-col flex-1">
                    <div class="flex items-center gap-2 text-slate-400 text-xs font-bold mb-4">
                      <i class="fa-solid fa-calendar-check text-meg-accent"></i>
                      <FormattedDate date={project.data.pubDate} />
                    </div>
                    
                    <h2 class="text-2xl font-bold text-meg-text-primary-dark mb-4 group-hover:text-meg-accent transition-colors">
                      {project.data.title}
                    </h2>
                    
                    <p class="text-slate-400 text-sm leading-relaxed mb-8 line-clamp-3">
                      {project.data.shortDescription}
                    </p>
                    
                    <div class="mt-auto">
                      <a 
                        href={`/referenzen/${project.id.replace(/^_/, '').replace(/\/_/, '/')}/`} 
                        class="inline-flex items-center gap-2 px-6 py-3 bg-meg-surface-dark border border-meg-border-dark rounded-xl font-bold text-sm hover:border-meg-accent/50 hover:bg-meg-accent/5 transition-all"
                      >
                        Case Study ansehen
                        <i class="fa-solid fa-arrow-right"></i>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })
          }
        </div>

        {projects.length > pageSize && (
          <div class="mt-20 text-center">
            <a 
              href="/referenzen/1/" 
              class="inline-flex items-center gap-3 px-8 py-4 bg-meg-accent text-slate-900 font-bold rounded-2xl shadow-xl shadow-meg-accent/20 hover:scale-[1.05] transition-all"
            >
              Alle Fallstudien entdecken
              <i class="fa-solid fa-table-cells"></i>
            </a>
          </div>
        )}
      </div>
    </section>

    <!-- Social Proof Trust-Section -->
    <section class="py-24 bg-meg-surface-dark/20 border-t border-meg-border-dark">
      <div class="mx-auto max-w-7xl px-6 text-center">
        <h2 class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-12">Technologien im Einsatz</h2>
        <div class="flex flex-wrap justify-center gap-8 opacity-50 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-1000">
          <i class="fa-brands fa-angular text-4xl"></i>
          <i class="fa-brands fa-node-js text-4xl"></i>
          <i class="fa-brands fa-golang text-4xl"></i>
          <i class="fa-brands fa-docker text-4xl"></i>
          <i class="fa-brands fa-aws text-4xl"></i>
          <i class="fa-brands fa-react text-4xl"></i>
        </div>
      </div>
    </section>
  </main>
</Layout>