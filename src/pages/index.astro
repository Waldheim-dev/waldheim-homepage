---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[professionalServiceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <HeroBackground
    title="High-End IT-Consulting & Software­entwicklung"
    subtitle="Ich transformiere Ihre IT-Prozesse mit DevSecOps, FinOps, AIOps und eigenen KI-Automationen (AI Reviews & Skills) für über 1.000% (10x) mehr Produktivität – in der Umsetzung wie im Team-Coaching."
    video="/videos/video_chip.mp4"
    aiGenerated={true}
  >
    <div class="mt-10 flex items-center justify-center flex-wrap gap-4">
      <TrackedButton
        href="https://calendly.com/markus-waldheim/30min"
        target="_blank"
        trackEvent="cta_homepage_calendly"
        trackCategory="hero"
        trackLabel="Strategiegespräch buchen"
        variant="primary"
        icon="fa-solid fa-calendar-check animate-pulse"
        iconPosition="left"
      >
        Kostenloses Strategiegespräch
      </TrackedButton>
      <TrackedButton
        href="/referenzen/"
        trackEvent="cta_homepage_references"
        trackCategory="hero"
        trackLabel="Referenzen"
        variant="secondary"
        icon="fa-solid fa-arrow-right"
      >
        Case Studies ansehen
      </TrackedButton>
    </div>

    <!-- Trust-Bar: Direkte Sichtbarkeit der USPs -->
    <div
      class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 text-meg-text-secondary text-sm border-t border-meg-border-dark/30 pt-8"
    >
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">10+ Jahre</span>
        <span>IT-Expertise</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">&gt;1.000% (10x)</span>
        <span>Produktivität durch KI</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">PSM I/II & PSPO</span>
        <span>Zertifiziert</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">90+ Score</span>
        <span>Lighthouse-Performance</span>
      </div>
    </div>
  </HeroBackground>

  <main id="main-content">
    <AnswerFirstBox
      question="Was kosten IT-Consulting, Web-/Softwareentwicklung und die Waldheim Suite bei Waldheim.dev?"
      directAnswer="IT-Consulting, DevSecOps, IT-Support und individuelle Softwareentwicklung kosten bei Waldheim.dev 70 € pro Stunde im fairen 15-Minuten-Takt (gemäß § 19 UStG umsatzsteuerbefreit – Netto = Brutto) oder als Festpreis-Paket: Unternehmenswebsites starten ab 1.400 € (Dauer: 2–4 Wochen), Kundenportale und Web-Apps ab 4.900 € (Dauer: 4–8 Wochen). Unsere schlüsselfertige ERP- & CRM-Plattform Waldheim Suite (9 Module inkl. E-Rechnung, Kundenportal, DMS, Treasury, Fuhrpark & WEG) ist ab 29 € pro Nutzer/Monat in unter 15 Minuten einsatzbereit."
      price="Ab 70 €/h · Suite ab 29 €"
      priceSubtext="Festpreise ab 280 € · § 19 UStG (Netto = Brutto)"
      duration="Sofort bis 4 Wochen"
      durationSubtext="Suite < 15 Min. · Websites 2–4 Wochen"
      deliverable="Web, Software, DevSecOps, IT/KNX & 9-Modul-Suite"
      location="Augsburg, München & DACH Remote"
      accentColor="blue"
      primaryCtaText="Kostenloses 30-Min.-Erstgespräch"
      primaryCtaHref="https://calendly.com/markus-waldheim/30min"
      secondaryCtaText="Alle Preise & Fragen ansehen"
      secondaryCtaHref="#alle-loesungen"
    />

    <!-- Strategische 3-Anker-Architektur: Services · Waldheim Suite · Open Source (semrel) -->
    <section
      class="py-20 border-b border-meg-border-dark/30"
      aria-labelledby="strategic-anchors-heading"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <p class="text-meg-accent font-bold uppercase tracking-[0.2em] text-xs mb-4">
            Drei Kernbereiche · Ein Qualitätsanspruch
          </p>
          <h2
            id="strategic-anchors-heading"
            class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6"
          >
            Consulting, SaaS-Plattform &amp; Open-Source Engineering
          </h2>
          <p class="text-lg text-meg-text-secondary">
            Ob maßgeschneiderte Enterprise-Beratung, schlüsselfertige Business-Suite für den Mittelstand oder supply-chain-sichere Open-Source-Automatisierung – wählen Sie den passenden Hebel für Ihr Vorhaben.
          </p>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-3">
          <!-- Anker 1: Dienstleistungen (Services) -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-violet-500/40 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400">
                  <i class="fa-solid fa-shield-halved text-xl" aria-hidden="true"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-violet-400 bg-violet-500/10 border border-violet-500/20 px-3 py-1 rounded-full">
                  1 · IT-Services &amp; Consulting
                </span>
              </div>
              <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-3">
                DevSecOps, FinOps, AIOps &amp; Software
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-6">
                Zertifizierte Senior-Expertise (PSM II, PSPO I) für DevSecOps, FinOps &amp; AIOps, klassische Webseiten-Entwicklung &amp; Gestaltung, Custom Software sowie AI-Team-Coaching (&gt;1.000% / 10x Produktivität).
              </p>
              <ul class="space-y-2 text-xs text-meg-text-secondary mb-8">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>DevSecOps, FinOps, AIOps, Kubernetes &amp; GitOps</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Webseiten, Custom Software &amp; 10x AI-Coaching (&gt;1.000%)</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Eigene AI Reviews, Skills-Automationen &amp; IT/KNX-Service</span></li>
              </ul>
            </div>
            <div class="flex flex-wrap gap-3 pt-4 border-t border-meg-border-dark/60">
              <TrackedButton
                href="/services/"
                trackEvent="cta_homepage_anchor_services"
                trackCategory="strategic_anchors"
                trackLabel="Services Overview"
                variant="primary"
                icon="fa-solid fa-arrow-right"
              >
                Services entdecken
              </TrackedButton>
              <TrackedButton
                href="#roi-rechner"
                trackEvent="cta_homepage_anchor_roi"
                trackCategory="strategic_anchors"
                trackLabel="ROI Calculator"
                variant="secondary"
              >
                ROI berechnen
              </TrackedButton>
            </div>
          </article>

          <!-- Anker 2: SaaS Waldheim Suite -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-meg-accent/50 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-meg-accent/10 border border-meg-accent/20 flex items-center justify-center text-meg-accent">
