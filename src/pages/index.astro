// SEO & Meta (High-CTR: Suchbegriff vorne + Einstiegspreis im Titel, < 68 Zeichen)
const titel =
  'IT-Consulting & Software Augsburg – ab 70 €/h | Waldheim.dev';
const description =
  'Webentwicklung ab 1.400 €, Individualsoftware & DevSecOps in Augsburg/München (70 €/h, § 19 UStG) sowie Waldheim Suite (ERP & CRM) ab 29 €/Monat.';
const keywords =
  'IT-Consulting Augsburg, Softwareentwicklung München, Webentwicklung Augsburg Kosten, DevSecOps FinOps AIOps, Waldheim Suite ERP CRM, KI Coaching Entwickler';
const ogImage = 'https://waldheim.dev/waldheim-dev-og.jpg';

// Structured Data: ProfessionalService & Breadcrumbs
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Waldheim.dev - Markus Waldheim',
  image: 'https://waldheim.dev/waldheim.dev.svg',
  url: 'https://waldheim.dev',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Augsburg',
    addressRegion: 'Bayern',
    addressCountry: 'DE',
  },
  geo: {
