---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Pricing from '../components/content/Pricing.astro';
import FlipCard from '../components/FlipCard.astro';
import TopPortfolio from '../components/content/TopPortfolio.astro';
import SkillRow from '../components/SkillRow.astro';

const blogPosts = (await getCollection('blog')).sort((a, b) => {
  return new Date(b.data.pubDate) - new Date(a.data.pubDate);
});
const skills = (await getCollection('skills')).filter(
  (entry) => entry.data.isTopSkill === false
);
const topSkills = (await getCollection('skills')).filter(
  (entry) => entry.data.isTopSkill === true
);
const allSkills = await getCollection('skills');

const layer = [
  'frontend',
  'backend',
  'design',
  'infrastructure',
  'quality',
  'general',
  'system',
  'security',
  'database',
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="bg-white dark:bg-slate-800">
    <main>
      <div class="relative isolate">
        <svg
          class="absolute inset-x-0 top-0 -z-10 h-[64rem] w-full stroke-gray-200 dark:stroke-slate-900 [mask-image:radial-gradient(32rem_32rem_at_center,white,transparent)]"
          aria-hidden="true"
        >
          <defs>
            <pattern
              id="1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84"
              width="200"
              height="200"
              x="50%"
              y="-1"
              patternUnits="userSpaceOnUse"
            >
              <path d="M.5 200V.5H200" fill="none"></path>
            </pattern>
          </defs>
          <svg
            x="50%"
            y="-1"
            class="overflow-visible fill-gray-50 dark:fill-slate-900"
          >
            <path
              d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z"
              stroke-width="0"></path>
          </svg>
          <rect
            width="100%"
            height="100%"
            stroke-width="0"
            fill="url(#1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84)"></rect>
        </svg>
        <div
          class="absolute left-1/2 right-0 top-0 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48"
