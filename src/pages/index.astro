---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SchemaUtils } from '../utils/schema';
import HeroBackground from '../components/HeroBackground.astro';
import PortfolioTop from '../components/PortfolioTop.astro';
import PriceService from '../components/PriceService.astro';
import Blog from '../components/Blog.astro';
import EcodriveClaim from '../components/EcodriveClaim.astro';
import PriceEcodrive from '../components/PriceEcodrive.astro';
import SkillWrapper from '../components/SkillWrapper.astro';
import type { Fragment } from 'astro/runtime/server/index.js';
import PriceSilvacore from '../components/PriceSilvacore.astro';
import PriceSocialverse from '../components/PriceSocialverse.astro';
import SilvacoreClaim from '../components/SilvacoreClaim.astro';
import SocialverseClaim from '../components/SocialverseClaim.astro';
import AetherClaim from '../components/AetherClaim.astro';
import WaetherappClaim from '../components/WaetherappClaim.astro';
import TrackedButton from '../components/TrackedButton.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}]);

// Organization Schema
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'waldheim.dev',
  url: 'https://waldheim.dev',
  logo: 'https://waldheim.dev/waldheim.dev.svg',
  description: 'IT-Dienstleistungen für KMU, Vereine & Startups: DevSecOps, Webentwicklung, Design, IT-Service, Smart Home',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Werner-Haas-Str. 8',
    addressLocality: 'Augsburg',
    postalCode: '86153',
    addressCountry: 'DE',
    addressRegion: 'Bayern'
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Kundenservice',
    email: 'kontakt@waldheim.dev'
  },
  areaServed: ['Augsburg', 'München', 'Bayern', 'DE', 'AT', 'CH']
};

// WebSite Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'waldheim.dev',
  url: 'https://waldheim.dev',
  description: 'Professionelle IT-Dienstleistungen: DevSecOps, Webentwicklung, Design, IT-Service',
  publisher: {
    '@type': 'Organization',
    name: 'waldheim.dev'
  }
};

const titel = 'waldheim.dev: IT-Lösungen für KMU, Vereine & Startups | Augsburg';
const description = 'waldheim.dev: Ihr Partner für hochwertige IT-Dienstleistungen (DevSecOps, Entwicklung, Design, IT-Service). Qualität zum fairen Preis (70€/Std.). Kontaktieren Sie uns! (Augsburg, München, DACH)';
const keywords = 'IT-Dienstleistungen, Augsburg, München, DevSecOps, Webentwicklung, IT-Service, Verbandssoftware, Softwareentwicklung, IT Beratung, KMU, Vereine, Startups, Cloud, Smart Home';

const ogImage = 'https://waldheim.dev/waldheim-dev-og.jpg';
---

<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[organizationSchema, websiteSchema, breadCrumbSchema]}
  image={ogImage}
>
  <HeroBackground title="Nachhaltige IT-Lösungen aus einer Hand"
                  subtitle="Von DevSecOps über Webentwicklung bis zum Smart Home – ich begleite Sie digital. Für Unternehmen & Verbände im Raum Augsburg/München."

                  video="/videos/video_chip.mp4">
    <div class="mt-10 flex items-center justify-center flex-wrap gap-x-6">
      <TrackedButton
        href="/kontakt/"
        trackEvent="cta_homepage_contact"
        trackCategory="hero"
        trackLabel="Jetzt beraten lassen"
        variant="primary"
        icon="fa-solid fa-envelope animate-pulse"
        iconPosition="left"
      >
        Jetzt beraten lassen
      </TrackedButton>
      <TrackedButton
        href="/referenzen/1/"
        trackEvent="cta_homepage_references"
        trackCategory="hero"
        trackLabel="Referenzen"
        variant="secondary"
        icon="fa-solid fa-arrow-right"
      >
        Referenzen
      </TrackedButton>
    </div>
  </HeroBackground>

  <div>
    <main>

      <section class="bento-service relative isolate">
        <div class="mx-auto max-w-7xl px-6 pb-32 pt-36 sm:pt-60 lg:px-8 lg:pt-32 bento-grid grid lg:grid-cols-6 sm:grid-cols-6 grid-cols-1 gap-4 grid-flow-row">
          <!-- Main Principles Card -->
          <div class="relative lg:row-span-2 sm:row-span-2 lg:col-span-3 sm:col-span-3 col-span-1">
            <div class="bento-card gsap-fadein relative lg:row-span-3 lg:col-span-2 md:col-span-6 sm:col-span-6 col-span-1 h-full">
              <div class="blur-sm absolute inset-0 rounded-3xl transition-all -translate-x-0 translate-y-0 bg-conic-180 from-pink-500 via-cyan-500 to-violet-500 animate-rotate_gradient" />
              <div class="flex flex-col gap-4 justify-between h-full z-10 relative bg-gradient-to-r from-primary-800 to-primary-900 text-light-100 p-12 shadow-lg rounded-3xl border-1 border-gray-300/30">
                <div class="flex flex-col gap-4">
                  <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">
                    So arbeite ich: Meine <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Prinzipien</span> für Ihren Erfolg
                  </h2>
                  <p class="relative mt-4 text-lg leading-8 sm:max-w-md lg:max-w-none text-light-300">
                    Von der ersten Beratung bis zur finalen Umsetzung – ich stehe für Qualität, Transparenz und Kundenorientierung.
                  </p>
                  <ul role="list" class="mt-6 space-y-4">
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-white">Qualität:</strong> Ich liefere ausschließlich Ergebnisse, die meinen hohen Ansprüchen genügen.</span>
                    </li>
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-white">Zuverlässigkeit:</strong> Auf meine IT-Lösungen und meinen Support können Sie zählen.</span>
                    </li>
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-white">Nachvollziehbarkeit:</strong> Alle Schritte werden detailliert dokumentiert.</span>
                    </li>
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-white">Passgenauigkeit:</strong> Ich entwickle Lösungen, die perfekt zu Ihren Anforderungen passen.</span>
                    </li>
                  </ul>
                </div>
                <Image 
                  src="/bento/cert.webp" 
                  alt="Qualität bei Waldheim.dev" 
                  class="rounded-lg" 
                  width={600} 
                  height={546}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </div>
          <!-- DevSecOps Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 sm:col-span-3 col-span-1 bg-gradient-to-br from-purple-900/30 to-dark-900 text-white border border-purple-500/20 rounded-3xl overflow-hidden p-12 shadow-lg hover:border-purple-500/40 transition-all duration-300">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500'>DevSecOps</span> für schnellere & sichere Entwicklung
                </h3>
                <p class="relative mb-6 text-lg text-light-300 sm:max-w-md lg:max-w-none">
                  Ich automatisiere Ihre Entwicklungspipeline, integriere Sicherheit von Anfang an und verkürze Ihre Release-Zyklen.
                </p>
                <TrackedButton
                  href="/services/devsecops/"
                  trackEvent="cta_service_devsecops"
                  trackCategory="service_card"
                  trackLabel="DevSecOps Services"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full border-purple-500/50 hover:bg-purple-500/20"
                >
                  Zu meinen DevSecOps-Services
                </TrackedButton>
              </div>
              <figure class="w-full rounded-2xl overflow-hidden">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1920"
                  height="1080"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_devsecops-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  src="/videos/video_devsecops.mp4"
                >
                  <source src="/videos/video_devsecops.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>

          <!-- Entwicklung Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 sm:col-span-3 col-span-1 bg-gradient-to-br from-blue-900/30 to-dark-900 text-white border border-blue-500/20 rounded-3xl overflow-hidden p-12 shadow-lg hover:border-blue-500/40 transition-all duration-300">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  Individuelle <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Softwarelösungen</span> für Ihren Bedarf
                </h3>
                <p class="relative mb-6 text-lg text-light-300 sm:max-w-md lg:max-w-none">
                  Ich entwickle Webanwendungen, Tools und maßgeschneiderte Software, die perfekt zu Ihren Prozessen passt.
                </p>
                <TrackedButton
                  href="/services/entwicklung/"
                  trackEvent="cta_service_development"
                  trackCategory="service_card"
                  trackLabel="Projekt anfragen"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full border-blue-500/50 hover:bg-blue-500/20"
                >
                  Jetzt Projekt anfragen
                </TrackedButton>
              </div>
              <figure class="w-full rounded-2xl overflow-hidden">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1920"
                  height="1080"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_software-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  src="/videos/video_software.mp4"
                >
                  <source src="/videos/video_software.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>

          <!-- Design Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 md:col-span-3 sm:col-span-3 col-span-1 bg-gradient-to-br from-pink-900/30 to-dark-900 text-white border border-pink-500/20 rounded-3xl overflow-hidden p-12 shadow-lg hover:border-pink-500/40 transition-all duration-300">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  <span class='text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-rose-500'>Branding, Webdesign & UX</span> – aus einem Guss
                </h3>
                <p class="relative mb-6 text-lg text-light-300 sm:max-w-md lg:max-w-none">
                  Ich entwickle ganzheitliche Designlösungen, die Ihre Marke stärken und Ihre Zielgruppe überzeugen.
                </p>
                <TrackedButton
                  href="/services/design/"
                  trackEvent="cta_service_design"
                  trackCategory="service_card"
                  trackLabel="Design-Philosophie"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full border-pink-500/50 hover:bg-pink-500/20"
                >
                  Design-Philosophie entdecken
                </TrackedButton>
              </div>
              <figure class="w-full rounded-2xl overflow-hidden">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1280"
                  height="720"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_design-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  aria-label="Moderne Webdesign-Prozesse und UI-Komponenten"
                  src="/videos/video_design.mp4"
                >
                  <source src="/videos/video_design.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>
          <!-- IT-Service / Cloud Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 md:col-span-3 sm:col-span-3 col-span-1 bg-gradient-to-br from-green-900/30 to-dark-900 text-white border border-green-500/20 rounded-3xl overflow-hidden p-12 shadow-lg hover:border-green-500/40 transition-all duration-300">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  Sichere <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>Cloud-Lösungen</span> & IT-Service
                </h3>
                <p class="relative mb-6 text-lg text-light-300">
                  Ich migriere Ihre IT in die Cloud, sorge für maximale Sicherheit und ermögliche ortsunabhängiges Arbeiten.
                </p>
                <TrackedButton
                  href="/services/it-service/"
                  trackEvent="cta_service_it"
                  trackCategory="service_card"
                  trackLabel="Cloud-Services"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full border-green-500/50 hover:bg-green-500/20"
                >
                  Mehr über Cloud-Services
                </TrackedButton>
              </div>
              <figure class="w-full rounded-2xl overflow-hidden">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1280"
                  height="720"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_cloud-security-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  aria-label="Sichere Cloud-Infrastruktur mit Sicherheits-Shields und Datenströmen"
                  src="/videos/video_cloud-security.mp4"
                >
                  <source src="/videos/video_cloud-security.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>
          
          <!-- Certifications Card -->
          <div class="bento-card gsap-fadein lg:col-span-6 sm:col-span-6 col-span-1 bg-gradient-to-br from-blue-900/20 to-dark-900 text-white border border-blue-500/20 rounded-3xl overflow-hidden p-12 shadow-lg">
            <div class="flex md:flex-row flex-col gap-8 justify-between items-start">
              <div class="flex flex-col flex-1 gap-4">
                <p class="text-base font-semibold text-blue-400">
                  <i class='fa-solid fa-award text-blue-400 mr-2' aria-hidden='true'></i>
                  Ihr Vorteil: Zertifiziertes Know-how
                </p>
                <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">
                  Profitieren Sie von meiner <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Expertise</span> in agilen Methoden
                </h3>
                <ul role="list" class="mt-4 space-y-4 text-light-300">
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Professional <strong class="font-semibold text-white">Scrum Master I.</strong> (PSM I) - Scrum.org</span>
                  </li>
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Professional <strong class="font-semibold text-white">Scrum Master II.</strong> (PSM II) - Scrum.org</span>
                  </li>
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Professional <strong class="font-semibold text-white">Scrum Product Owner I.</strong> (PSPO I.) - Scrum.org</span>
                  </li>
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-blue-400 text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Ausbilder (IHK) <strong class="font-semibold text-white">Ausbilder für Fachinformatik.</strong></span>
                  </li>
                </ul>
              </div>
              <figure class="w-full md:w-auto rounded-2xl overflow-hidden m-[auto]">
                <video 
                  class="object-contain w-full md:w-[400px]" 
                  width="1920"
                  height="1080"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_certification-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  src="/videos/video_certification.mp4"
                >
                  <source src="/videos/video_certification.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>
        </div>
      </section>
      <PortfolioTop />
      <PriceService />

      <Blog limits={6} />
      <SkillWrapper />

      <EcodriveClaim />
      <PriceEcodrive />

      <SocialverseClaim />
      <PriceSocialverse />

      <SilvacoreClaim />
      <PriceSilvacore />

      <AetherClaim />

      <WaetherappClaim />
    </main>
  </div>
</Layout>
