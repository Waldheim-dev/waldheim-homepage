---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getEntry } from 'astro/dist/content/template/virtual-mod';
import FormattedDate from '../components/FormattedDate.astro';


const blogPosts = await getCollection('blog');
const topSkills = (await getCollection('topskills'));
const skills = await getCollection('skills');
---

<BaseLayout>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

  <div class='bg-white dark:bg-slate-800'>
    <main>
      <div class='relative isolate'>
        <svg
          class='absolute inset-x-0 top-0 -z-10 h-[64rem] w-full stroke-gray-200 dark:stroke-slate-900 [mask-image:radial-gradient(32rem_32rem_at_center,white,transparent)]'
          aria-hidden='true'>
          <defs>
            <pattern id='1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84' width='200' height='200' x='50%' y='-1'
                     patternUnits='userSpaceOnUse'>
              <path d='M.5 200V.5H200' fill='none' />
            </pattern>
          </defs>
          <svg x='50%' y='-1' class='overflow-visible fill-gray-50 dark:fill-slate-900'>
            <path d='M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z'
                  stroke-width='0' />
          </svg>
          <rect width='100%' height='100%' stroke-width='0' fill='url(#1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84)' />
        </svg>
        <div
          class='absolute left-1/2 right-0 top-0 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48'
          aria-hidden='true'>
          <div class='aspect-[801/1036] w-[50.0625rem] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30'
               style='clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)'></div>
        </div>
        <div class='overflow-hidden'>
          <div class='mx-auto max-w-7xl px-6 pb-32 pt-36 sm:pt-60 lg:px-8 lg:pt-32'>
            <div class='mx-auto max-w-2xl gap-x-14 lg:mx-0 lg:flex lg:max-w-none lg:items-center'>
              <div class='w-full max-w-xl lg:shrink-0 xl:max-w-2xl'>
                <h1 class='text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-6xl'>Let`s build a
                  better tomorrow, together</h1>
                <p class='relative mt-6 text-lg leading-8 text-gray-600 dark:text-gray-200 sm:max-w-md lg:max-w-none'>
                  Durch nachhaltige und optimierte Entwicklungen und Design. Durch einsparen von Zeit und
                  Ressourcen zu optimierten Prozessen. Ich helfe Ihnen dabei.</p>
                <div class='mt-10 flex items-center gap-x-6'>
                  <a href='mailto:kontakt@waldheim.dev'
                     class='rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'>Kontaktiere
                    mich <i class='fa-regular fa-envelope'></i></a>
                  <a href='/projects/' class='text-sm font-semibold leading-6 text-gray-900 dark:text-white'>Mein
                    Portfolio <span
                      aria-hidden='true'>→</span></a>
                </div>
              </div>
              <div class='mt-14 flex justify-end gap-8 sm:-mt-44 sm:justify-start sm:pl-20 lg:mt-0 lg:pl-0'>
                <div
                  class='ml-auto w-44 flex-none space-y-8 pt-32 sm:ml-0 sm:pt-80 lg:order-last lg:pt-36 xl:order-none xl:pt-80'>
                  <div class='relative'>
                    <img
                      src='https://images.unsplash.com/photo-1537884944318-390069bb8665?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=360&q=80'
                      alt='' class='aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg'>
                    <div
                      class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10'></div>
                  </div>
                </div>
                <div class='mr-auto w-44 flex-none space-y-8 sm:mr-0 sm:pt-52 lg:pt-36'>
                  <div class='relative'>
                    <img
                      src='https://images.unsplash.com/photo-1558655146-d09347e92766?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80'
                      alt='' class='aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg'>
                    <div
                      class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10'></div>
                  </div>
                  <div class='relative'>
                    <img
                      src='https://images.unsplash.com/photo-1560732488-6b0df240254a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80'
                      alt='' class='aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg'>
                    <div
                      class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10'></div>
                  </div>
                </div>
                <div class='w-44 flex-none space-y-8 pt-32 sm:pt-0'>
                  <div class='relative'>
                    <img
                      src='https://images.unsplash.com/photo-1529310399831-ed472b81d589?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80'
                      alt='' class='aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg'>
                    <div
                      class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10'></div>
                  </div>
                  <div class='relative'>
                    <img
                      src='https://images.unsplash.com/photo-1581287053822-fd7bf4f4bfec?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80'
                      alt='' class='aspect-[2/3] w-full rounded-xl bg-gray-900/5 object-cover shadow-lg'>
                    <div
                      class='pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-gray-900/10'></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>


  <div class='bg-white dark:bg-slate-800 py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl sm:text-center'>
        <h2 class='text-3xl font-bold tracking-tight text-gray-900 dark:text-slate-50 sm:text-4xl'>Qualität zu einem
          guten Preis</h2>
        <p class='mt-6 text-lg leading-8 text-gray-600 dark:text-slate-300'>IT- & Design-Projekte. Beratung für den
          besten Weg. Qualität ist
          mir wichtig.</p>
      </div>
      <div
        class='mx-auto mt-16 max-w-2xl rounded-3xl ring-1 ring-gray-200 dark:ring-slate-700/70 sm:mt-20 lg:mx-0 lg:flex lg:max-w-none'>
        <div class='p-8 sm:p-10 lg:flex-auto'>
          <h3 class='text-2xl font-bold tracking-tight text-gray-900 dark:text-slate-50'>IT zum Tiefpreis</h3>
          <p class='mt-6 text-base leading-7 text-gray-600 dark:text-slate-300'>Für kleine & mittelständige Unternehmen.
            Verbände und
            Vereine.</p>
          <div class='mt-10 flex items-center gap-x-4'>
            <h4 class='flex-none text-sm font-semibold leading-6 text-indigo-600 dark:text-indigo-400'>Was ist
              dabei?</h4>
            <div class='h-px flex-auto bg-gray-100 dark:bg-gray-500'></div>
          </div>
          <ul role='list'
              class='mt-8 grid grid-cols-1 gap-4 text-sm leading-6 text-gray-600 dark:text-gray-300 sm:grid-cols-2 sm:gap-6'>
            <li class='flex gap-x-3'>
              <svg class='h-6 w-5 flex-none text-indigo-600 dark:text-indigo-400' viewBox='0 0 20 20'
                   fill='currentColor' aria-hidden='true'>
                <path fill-rule='evenodd'
                      d='M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z'
                      clip-rule='evenodd' />
              </svg>
              Print & Webdesign
            </li>
            <li class='flex gap-x-3'>
              <svg class='h-6 w-5 flex-none text-indigo-600 dark:text-indigo-400' viewBox='0 0 20 20'
                   fill='currentColor' aria-hidden='true'>
                <path fill-rule='evenodd'
                      d='M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z'
                      clip-rule='evenodd' />
              </svg>
              IT-Administration
            </li>
            <li class='flex gap-x-3'>
              <svg class='h-6 w-5 flex-none text-indigo-600 dark:text-indigo-400' viewBox='0 0 20 20'
                   fill='currentColor' aria-hidden='true'>
                <path fill-rule='evenodd'
                      d='M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z'
                      clip-rule='evenodd' />
              </svg>
              OpenSource Software
            </li>
            <li class='flex gap-x-3'>
              <svg class='h-6 w-5 flex-none text-indigo-600 dark:text-indigo-400' viewBox='0 0 20 20'
                   fill='currentColor' aria-hidden='true'>
                <path fill-rule='evenodd'
                      d='M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z'
                      clip-rule='evenodd' />
              </svg>
              Webseiten
            </li>
            <li class='flex gap-x-3'>
              <svg class='h-6 w-5 flex-none text-indigo-600 dark:text-indigo-400' viewBox='0 0 20 20'
                   fill='currentColor' aria-hidden='true'>
                <path fill-rule='evenodd'
                      d='M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z'
                      clip-rule='evenodd' />
              </svg>
              Prozessoptimierung
            </li>
            <li class='flex gap-x-3'>
              <svg class='h-6 w-5 flex-none text-indigo-600 dark:text-indigo-400' viewBox='0 0 20 20'
                   fill='currentColor' aria-hidden='true'>
                <path fill-rule='evenodd'
                      d='M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z'
                      clip-rule='evenodd' />
              </svg>
              Beratung
            </li>
          </ul>
        </div>
        <div class='-mt-2 p-2 lg:mt-0 lg:w-full lg:max-w-md lg:flex-shrink-0'>
          <div
            class='rounded-2xl bg-gray-50 dark:bg-slate-700/60 py-10 text-center ring-1 ring-inset ring-gray-900/5 dark:ring-slate-700:60 lg:flex lg:flex-col lg:justify-center lg:py-16'>
            <div class='mx-auto max-w-xs px-8'>
              <p class='text-base font-semibold text-gray-600 dark:text-gray-300'>Je Stunde</p>
              <p class='mt-6 flex items-baseline justify-center gap-x-2'>
                <span class='text-5xl font-bold tracking-tight text-gray-900 dark:text-gray-50'>60€</span>
                <span class='text-sm font-semibold leading-6 tracking-wide text-gray-600 dark:text-gray-300'>EUR</span>
              </p>
              <a href='mailto:kontakt@waldheim.dev'
                 class='mt-10 block w-full rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600'>Kontaktieren
                <i class='fa-regular fa-envelope'></i></a>
              <p class='mt-6 text-xs leading-5 text-gray-600 dark:text-gray-300'>Je angefangene 15 Minuten werden 15€
                berechnet. Gemäß §19
                UStG enthält der Rechnungsbetrag keine
                Umsatzsteuer.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class='bg-white dark:bg-slate-800 py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl text-center'>
        <h2 class='text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl'>From the blog</h2>
        <p class='mt-2 text-lg leading-8 text-gray-600 dark:text-gray-300'>Learn how to grow your business with our
          expert advice.</p>
      </div>
      <div
        class='mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-8 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-3'>


        {
          blogPosts.map(async (post) => {

            return (
              <a href={`/blog/${post.slug}/`}>
                <article
                  class='relative isolate flex flex-col justify-end overflow-hidden rounded-2xl bg-gray-900 px-8 pb-8 pt-80 sm:pt-48 lg:pt-80'>
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title} class='absolute inset-0 -z-10 h-full w-full object-cover'>
                  <div class='absolute inset-0 -z-10 bg-gradient-to-t from-gray-900 via-gray-900/40'></div>
                  <div class='absolute inset-0 -z-10 rounded-2xl ring-1 ring-inset ring-gray-900/10'></div>

                  <div class='flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300'>
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  <h3 class='mt-3 text-lg font-semibold leading-6 text-white'>
                    <span class='absolute inset-0'></span>
                    {post.data.title}
                  </h3>
                  <p class='flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300'>{post.data.description}</p>
                </article>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>


  <div class='bg-gray-900 py-24 sm:py-32'>
    <div class='mx-auto max-w-2xl text-center px-6 lg:px-8 py-6'>
      <h2 class='text-3xl font-bold tracking-tight text-gray-300 sm:text-4xl'>Top Skills</h2>
      <p class='mt-2 text-lg leading-8 text-gray-400'>Aktuell im Trend oder Produktiv im Einsatz.</p>
    </div>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='-mx-6 grid grid-cols-2 gap-0.5 overflow-hidden sm:mx-0 sm:rounded-2xl md:grid-cols-6'>


        {
          topSkills.map((entry) => (
            <div class='bg-slate-700 p-8 sm:p-10 flex flex-col justify-center items-center gap-1'>
              <img class='max-h-12 w-full object-contain'
                   src={entry.data.image} alt={entry.data.name} width='50'
                   height='50'>
              <span class='w-full text-center text-gray-300'>{entry.data.name}</span>
              <span class='text-amber-500 flex gap-0.5'>
            {entry.data.knowledgebase === 'basic' ?
              <i class='fa-solid fa-star'></i> : entry.data.knowledgebase === 'advanced' ?
                <i class='fa-solid fa-star'></i><i class='fa-solid fa-star'></i> : <i class='fa-solid fa-star'></i>
                <i class='fa-solid fa-star'></i>
                <i class='fa-solid fa-star'></i>}
          </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class='bg-gray-900 py-24 sm:py-32'>
    <div class='mx-auto max-w-2xl text-center px-6 lg:px-8 py-6'>
      <h2 class='text-3xl font-bold tracking-tight text-gray-300 sm:text-4xl'>Weitere Skills</h2>
      <p class='mt-2 text-lg leading-8 text-gray-400'>Learn how to grow your business with our expert advice.</p>
    </div>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='-mx-6 grid grid-cols-2 gap-0.5 overflow-hidden sm:mx-0 sm:rounded-2xl md:grid-cols-6'>

        {
          skills.map((entry) => (
            <div class='bg-slate-700 p-8 sm:p-10 flex flex-col justify-center items-center gap-1'>
              <img class='max-h-12 w-full object-contain'
                   src={entry.data.image} alt={entry.data.name} width='50'
                   height='50'>
              <span class='w-full text-center text-gray-300'>{entry.data.name}</span>
              <span class='text-amber-500 flex gap-0.5'>
            {entry.data.knowledgebase === 'basic' ?
              <i class='fa-solid fa-star'></i> : entry.data.knowledgebase === 'advanced' ?
                <i class='fa-solid fa-star'></i><i class='fa-solid fa-star'></i> : <i class='fa-solid fa-star'></i>
                <i class='fa-solid fa-star'></i>
                <i class='fa-solid fa-star'></i>}
          </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>


  <!--# Projects-->

  <div class='bg-white dark:bg-slate-800'>
    <div class='mx-auto max-w-7xl py-24 sm:px-6 sm:py-32 lg:px-8'>
      <div
        class='relative isolate overflow-hidden bg-gray-900 px-6 pt-16 shadow-2xl sm:rounded-3xl sm:px-16 md:pt-24 lg:flex lg:gap-x-20 lg:px-24 lg:pt-0'>
        <svg viewBox='0 0 1024 1024'
             class='absolute left-1/2 top-1/2 -z-10 h-[64rem] w-[64rem] -translate-y-1/2 [mask-image:radial-gradient(closest-side,white,transparent)] sm:left-full sm:-ml-80 lg:left-1/2 lg:ml-0 lg:-translate-x-1/2 lg:translate-y-0'
             aria-hidden='true'>
          <circle cx='512' cy='512' r='512' fill='url(#759c1415-0410-454c-8f7c-9a820de03641)' fill-opacity='0.7' />
          <defs>
            <radialGradient id='759c1415-0410-454c-8f7c-9a820de03641'>
              <stop stop-color='#7775D6' />
              <stop offset='1' stop-color='#E935C1' />
            </radialGradient>
          </defs>
        </svg>
        <div class='mx-auto max-w-md text-center lg:mx-0 lg:flex-auto lg:py-32 lg:text-left'>
          <h2 class='text-3xl font-bold tracking-tight text-white sm:text-4xl'>Booste deine Nachhaltigkeite.<br>Nutze es
            schon heute.</h2>
          <p class='mt-6 text-lg leading-8 text-gray-300'>Mit Ecodrive mehr Infos über den Fahrverhalten ermitteln.
            Nicht mehr vermuten! </p>
          <div class='mt-10 flex items-center justify-center gap-x-6 lg:justify-start'>
            <a href='https://www.eco-drive.app'
               class='rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'>Demo
              testen</a>
            <a href='/ecodrive/' class='text-sm font-semibold leading-6 text-white'>Erfahre mehr <span
              aria-hidden='true'>→</span></a>
          </div>
        </div>
        <div class='relative mt-16 h-80 lg:mt-8'>
          <img class='absolute left-0 top-0 w-[57rem] max-w-none rounded-md bg-white/5 ring-1 ring-white/10'
               src='/projects/waldheim-dev/ecodrive/ecodrive_dashboard.png' alt='Ecodrive screenshot'
               width='1824' height='1080'>
        </div>
      </div>
    </div>
  </div>


</BaseLayout>