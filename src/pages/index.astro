---
// This code has been partially generated by an AI.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SchemaUtils } from '../utils/schema';
import HeroBackground from '../components/HeroBackground.astro';
import AiImageBadge from '../components/AiImageBadge.astro';
import PortfolioTop from '../components/PortfolioTop.astro';
import PriceService from '../components/PriceService.astro';
import Blog from '../components/Blog.astro';
import SkillWrapper from '../components/SkillWrapper.astro';
import TrackedButton from '../components/TrackedButton.astro';
import FreeTools from '../components/FreeTools.astro';
import SolutionDirectorySection from '../components/SolutionDirectorySection.astro';
import { ALL_SERVICE_SOLUTIONS, ALL_SUITE_SOLUTIONS } from '../consts/seoCatalog';

// SEO & Meta (High-CTR: Suchbegriff vorne + Einstiegspreis im Titel, < 68 Zeichen)
const titel = 'Beratung, Software & Waldheim Suite | Waldheim.dev';
const description =
  'Persönliche IT-Beratung und Softwareentwicklung aus Augsburg. Entdecken Sie die Waldheim Suite für vernetzte Unternehmensprozesse und semrel, unsere Open-Source-Release-Automation.';
const keywords =
  'IT-Consulting Augsburg, Softwareentwicklung München, Webentwicklung Augsburg Kosten, DevSecOps FinOps AIOps, Waldheim Suite ERP CRM, KI Coaching Entwickler';
const ogImage = 'https://waldheim.dev/waldheim-dev-og.jpg';

// Structured Data: ProfessionalService & Breadcrumbs
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Waldheim.dev - Markus Waldheim',
  image: 'https://waldheim.dev/waldheim.dev.svg',
  url: 'https://waldheim.dev',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Augsburg',
    addressRegion: 'Bayern',
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoShape',
    region: 'DE-BY',
  },
  areaServed: [
    { '@type': 'City', name: 'Augsburg' },
    { '@type': 'City', name: 'München' },
    { '@type': 'City', name: 'Landsberg am Lech' },
  ],
  description:
    'Senior IT-Beratung, Softwareentwicklung, DevSecOps und Produktentwicklung mit transparenten Entscheidungen und schrittweiser Umsetzung.',
  memberOf: [
    {
      '@type': 'Organization',
      name: 'Scrum.org',
      description: 'PSM I, PSM II, PSPO I',
    },
    {
      '@type': 'Organization',
      name: 'IHK',
      description: 'Zertifizierter Ausbilder',
    },
  ],
  priceRange: '€€€',
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  {
    name: 'Home',
    link: 'https://waldheim.dev',
  },
]);
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[professionalServiceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <div>
    <HeroBackground
      title="Weniger Reibung. Mehr Wirkung aus Ihrer IT."
      subtitle="Beratung, Software und Automatisierung aus Augsburg: Wir klären zuerst, was Sie wirklich brauchen, und setzen dann den passenden nächsten Schritt um – als Dienstleistung, mit der Waldheim Suite oder mit Open Source wie semrel."
    >
    <div class="flex flex-wrap items-center gap-3">
      <TrackedButton
        href="https://calendly.com/markus-waldheim/30min"
        target="_blank"
        trackEvent="cta_homepage_calendly"
        trackCategory="hero"
        trackLabel="Strategiegespräch buchen"
        variant="primary"
        icon="fa-solid fa-calendar-check"
        iconPosition="left"
      >
        30 Minuten sprechen
      </TrackedButton>
      <TrackedButton
        href="#kernbereiche"
        trackEvent="cta_homepage_explore"
        trackCategory="hero"
        trackLabel="Drei Kernbereiche"
        variant="secondary"
        icon="fa-solid fa-arrow-right"
      >
        Wege entdecken
      </TrackedButton>
    </div>
    </HeroBackground>

    <section
      class="border-b border-meg-border-dark bg-white/70 px-6 py-7"
      aria-label="Erfahrung und Zusammenarbeit"
    >
      <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 text-center sm:grid-cols-4">
        <div>
          <p class="font-black text-meg-text-primary-dark">10+ Jahre</p>
          <p class="mt-1 text-sm text-meg-text-secondary">IT-Erfahrung</p>
        </div>
        <div>
          <p class="font-black text-meg-text-primary-dark">PSM II · PSPO I</p>
          <p class="mt-1 text-sm text-meg-text-secondary">Scrum-Zertifizierungen</p>
        </div>
        <div>
          <p class="font-black text-meg-text-primary-dark">Augsburg</p>
          <p class="mt-1 text-sm text-meg-text-secondary">und Zusammenarbeit remote</p>
        </div>
        <div>
          <p class="font-black text-meg-text-primary-dark">Open Source</p>
          <p class="mt-1 text-sm text-meg-text-secondary">Nachvollziehbar und offen</p>
        </div>
      </div>
    </section>

    <!-- Strategische 3-Anker-Architektur: Services · Waldheim Suite · Open Source (semrel) -->
    <section
      id="kernbereiche"
      class="bg-meg-bg-dark px-6 py-24"
      aria-labelledby="strategic-anchors-heading"
    >
      <div class="mx-auto max-w-7xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="text-meg-accent font-bold uppercase tracking-[0.2em] text-xs mb-4">
            Drei Wege · Ein persönlicher Ansprechpartner
          </p>
          <h2
            id="strategic-anchors-heading"
            class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6"
          >
            Was möchten Sie als Nächstes möglich machen?
          </h2>
          <p class="text-lg text-meg-text-secondary">
            Wählen Sie den Einstieg, der zu Ihrem Vorhaben passt. Wir machen Umfang und nächste Schritte verständlich, bevor Arbeit beginnt.
          </p>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-3">
          <!-- Weg 1: Dienstleistungen -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-meg-accent/40 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-meg-brand border border-meg-accent/20 flex items-center justify-center text-meg-accent">
                  <i class="fa-solid fa-shield-halved text-xl" aria-hidden="true"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-meg-accent bg-meg-brand border border-meg-accent/20 px-3 py-1 rounded-full">
                  01 · Beratung und Umsetzung
                </span>
              </div>
              <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-3">
                Wenn Ihr Vorhaben einen erfahrenen Umsetzungspartner braucht
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-6">
                Von IT-Beratung und sicheren Lieferprozessen bis zu Web- und Individualsoftware: Wir klären Ziel, Umfang und Risiken gemeinsam.
              </p>
              <ul class="space-y-2 text-xs text-meg-text-secondary mb-8">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>DevSecOps, FinOps, AIOps, Kubernetes &amp; GitOps</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Webseiten, individuelle Software &amp; Team-Coaching</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>IT-Service, KNX und Automatisierung</span></li>
              </ul>
            </div>
            <div class="flex flex-wrap gap-3 pt-4 border-t border-meg-border-dark/60">
              <TrackedButton
                href="/services/"
                trackEvent="cta_homepage_anchor_services"
                trackCategory="strategic_anchors"
                trackLabel="Services Overview"
                variant="primary"
                icon="fa-solid fa-arrow-right"
              >
                Services entdecken
              </TrackedButton>
              <TrackedButton
                href="#so-arbeiten-wir"
                trackEvent="cta_homepage_anchor_roi"
                trackCategory="strategic_anchors"
                trackLabel="How we work"
                variant="secondary"
              >
                Arbeitsweise ansehen
              </TrackedButton>
            </div>
          </article>

          <!-- Weg 2: Waldheim Suite -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-meg-accent/50 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-meg-accent/10 border border-meg-accent/20 flex items-center justify-center text-meg-accent">
                  <i class="fa-solid fa-table-cells-large text-xl" aria-hidden="true"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-3 py-1 rounded-full">
                  02 · Waldheim Suite
                </span>
              </div>
              <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-3">
                Wenn Prozesse und Informationen zusammengehören
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-6">
                Die modulare Plattform verbindet CRM, ERP, Finanzen, Dokumente und weitere Abläufe in einem gemeinsamen Workspace. Starten Sie mit dem, was Sie heute benötigen.
              </p>
              <ul class="space-y-2 text-xs text-meg-text-secondary mb-8">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>XRechnung 3.0 &amp; ZUGFeRD PDF/A-3b, DATEV EXTF 700 &amp; CAMT.053</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Ein Login, App-Switch und mandantenbezogene Arbeitsbereiche</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Tarife und optionale Einheitspreise vor dem Abschluss einsehen</span></li>
              </ul>
            </div>
            <div class="flex flex-wrap gap-3 pt-4 border-t border-meg-border-dark/60">
              <TrackedButton
                href="/suite/"
                trackEvent="cta_homepage_suite_overview"
                trackCategory="suite_launch"
                trackLabel="Suite Overview"
                variant="primary"
                icon="fa-solid fa-layer-group"
                iconPosition="left"
              >
                Suite entdecken
              </TrackedButton>
              <TrackedButton
                href="https://suite.waldheim.dev"
                trackEvent="cta_homepage_suite_live"
                trackCategory="suite_launch"
                trackLabel="Suite test access"
                variant="secondary"
                icon="fa-solid fa-arrow-up-right-from-square"
              >
                Testphase ansehen
              </TrackedButton>
            </div>
          </article>

          <!-- Weg 3: Open Source -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-meg-accent/40 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-meg-brand border border-meg-accent/20 flex items-center justify-center text-meg-accent">
                  <i class="fa-solid fa-code-branch text-xl" aria-hidden="true"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-meg-accent bg-meg-brand border border-meg-accent/20 px-3 py-1 rounded-full">
                  03 · Open Source · Apache 2.0
                </span>
              </div>
              <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-3">
                Wenn Releases wiederholbar statt Handarbeit sein sollen
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-6">
                semrel ist ein offenes, Go-natives Werkzeug für semantische Versionierung und automatisierte Releases – mit Plugin-Architektur und Unterstützung für Monorepos.
              </p>
              <ul class="space-y-2 text-xs text-meg-text-secondary mb-8">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Statisches Go-Binary ohne Node.js-Abhängigkeiten</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Conventional Commits, Changelog und SemVer</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Dokumentation, Roadmap und Beiträge offen auf GitHub</span></li>
              </ul>
            </div>
            <div class="flex flex-wrap gap-3 pt-4 border-t border-meg-border-dark/60">
              <TrackedButton
                href="/semrel/"
                trackEvent="cta_homepage_anchor_semrel"
                trackCategory="strategic_anchors"
                trackLabel="semrel Overview"
                variant="primary"
                icon="fa-solid fa-code-branch"
                iconPosition="left"
              >
                semrel entdecken
              </TrackedButton>
              <TrackedButton
                href="#opensource-stack"
                trackEvent="cta_homepage_anchor_oss"
                trackCategory="strategic_anchors"
                trackLabel="Open Source Stack"
                variant="secondary"
                icon="fa-solid fa-arrow-right"
              >
                Alle OSS-Tools
              </TrackedButton>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section
      class="bento-service relative isolate py-24"
      aria-labelledby="services-heading"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <h2 id="services-heading" class="sr-only">
          Meine IT-Services und Prinzipien
        </h2>
        <div class="grid lg:grid-cols-6 grid-cols-1 gap-6">
          <!-- Core Principles Card (Engineering Excellence) -->
          <article
            class="bento-card lg:col-span-3 lg:row-span-2 bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-10 flex flex-col justify-between group hover:border-meg-accent/50 transition-all duration-500"
          >
            <div>
              <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">
                Maximale Qualität durch <span
                  class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400"
                  >Engineering Excellence</span
                >
              </h2>
              <p class="text-lg text-meg-text-secondary mb-8">
                IT soll konkrete Arbeit erleichtern. Wir verstehen zuerst den
                Engpass und wählen dann eine passende, wartbare Lösung.
              </p>
              <dl class="space-y-6">
                <div>
                  <dt
                    class="flex items-center gap-3 text-meg-text-primary-dark font-bold"
                  >
                    <i
                      class="fa-solid fa-shield-halved text-meg-accent"
                      aria-hidden="true"></i> Sicherheit (By Design)
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">
                    Sicherheitsanforderungen früh klären und in Architektur und
                    Lieferprozess berücksichtigen.
                  </dd>
                </div>
                <div>
                  <dt
                    class="flex items-center gap-3 text-meg-text-primary-dark font-bold"
                  >
                    <i
                      class="fa-solid fa-gauge-high text-meg-accent"
                      aria-hidden="true"></i> High Performance
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">
                    Performance messen, Engpässe sichtbar machen und
                    Verbesserungen nachvollziehbar priorisieren.
                  </dd>
                </div>
                <div>
                  <dt
                    class="flex items-center gap-3 text-meg-text-primary-dark font-bold"
                  >
                    <i
                      class="fa-solid fa-code-branch text-meg-accent"
                      aria-hidden="true"></i> Saubere Dokumentation
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">
                    Entscheidungen, Schnittstellen und Übergaben verständlich
                    dokumentieren.
                  </dd>
                </div>
              </dl>
            </div>
            <div class="mt-12">
              <Image
                src="/bento/cert.webp"
                alt="Zertifizierte IT-Qualität durch Markus Waldheim"
                class="rounded-2xl shadow-2xl group-hover:scale-[1.02] transition-transform duration-500"
                width={600}
                height={546}
                loading="eager"
              />
            </div>
          </article>

          <!-- Service Card: DevSecOps -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-violet-500/50 transition-all group"
          >
            <header>
              <h3
                class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500"
              >
                DevSecOps, FinOps &amp; AIOps
              </h3>
            </header>
            <p class="text-meg-text-secondary mb-6">
              Sichere CI/CD-Pipelines, GitOps, Cloud-Kostenoptimierung (FinOps),
              KI-gestützte Observability (AIOps) und Team-Coaching für
              Entwicklungsabläufe.
            </p>
            <TrackedButton
              href="/services/devsecops/"
              variant="ghost"
              icon="fa-solid fa-arrow-right"
              class="group-hover:text-violet-400"
              trackEvent="cta_service_devsecops"
              trackCategory="service_card"
              trackLabel="DevSecOps Details"
            >
              Operations skalieren
            </TrackedButton>
            <figure
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                data-src="/videos/video_devsecops.mp4"
                data-poster="/videos/video_devsecops-poster.webp"
                preload="none"
                loop
                muted
                playsinline
                class="lazy-video w-full aspect-video object-cover"
                aria-label="Visualisierung einer automatisierten DevSecOps Pipeline"
              ></video>
              <AiImageBadge class="absolute bottom-2.5 right-2.5 z-10" />
            </figure>
          </article>

          <!-- Service Card: Custom Software -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all group"
          >
            <header>
              <h3
                class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400"
              >
                Web, Software &amp; AI-Coaching
              </h3>
            </header>
            <p class="text-meg-text-secondary mb-6">
              Moderne Webseiten-Entwicklung &amp; Gestaltung, maßgeschneiderte
              SaaS-/Enterprise-Software und praxisnahes Team-Coaching.
            </p>
            <TrackedButton
              href="/services/entwicklung/"
              variant="ghost"
              icon="fa-solid fa-arrow-right"
              class="group-hover:text-meg-accent"
              trackEvent="cta_service_development"
              trackCategory="service_card"
              trackLabel="Custom Software anfragen"
            >
              Projekt anfragen
            </TrackedButton>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                data-src="/videos/video_software.mp4"
                data-poster="/videos/video_software-poster.webp"
                preload="none"
                loop
                muted
                playsinline
                class="lazy-video w-full aspect-video object-cover"
                aria-label="Code-Visualisierung moderner Softwareentwicklung"
              ></video>
              <AiImageBadge class="absolute bottom-2.5 right-2.5 z-10" />
            </div>
          </article>

          <!-- Service Card: Smart Home & KNX -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-orange-500/50 transition-all group flex flex-col justify-between"
          >
            <div>
              <header>
                <h3
                  class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-500"
                >
                  Smart Home, KNX &amp; Local AI
                </h3>
              </header>
              <p class="text-meg-text-secondary mb-6">
                KNX-Gebäudeautomation und Optimierung mittels lokaler KI:
                Energiekosten-Senkung, maximale Effizienz, adaptive Routinen,
                Heizungs-/Rollladensteuerung und AI-Kamerasicherheit.
              </p>
              <TrackedButton
                href="/services/smarthome/"
                variant="ghost"
                icon="fa-solid fa-arrow-right"
                class="group-hover:text-orange-400"
                trackEvent="cta_service_smarthome"
                trackCategory="service_card"
                trackLabel="Smart Home Details"
              >
                Gebäude automatisieren
              </TrackedButton>
            </div>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                data-src="/videos/video_smarthome.mp4"
                data-poster="/videos/video_smarthome-poster.webp"
                preload="none"
                loop
                muted
                playsinline
                class="lazy-video w-full aspect-video object-cover"
                aria-label="Smart Home Automation und Gebäudesicherheit"
              ></video>
              <AiImageBadge class="absolute bottom-2.5 right-2.5 z-10" />
            </div>
          </article>

          <!-- Service Card: IT-Service & Cloud -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-emerald-500/50 transition-all group flex flex-col justify-between"
          >
            <div>
              <header>
                <h3
                  class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-500"
                >
                  Cloud & IT-Support
                </h3>
              </header>
              <p class="text-meg-text-secondary mb-6">
                Sichere Cloud-Infrastruktur und proaktive Wartung Ihrer
                IT-Systeme – lokal in Augsburg & München.
              </p>
              <TrackedButton
                href="/services/it-service/"
                variant="ghost"
                icon="fa-solid fa-arrow-right"
                class="group-hover:text-emerald-400"
                trackEvent="cta_service_it"
                trackCategory="service_card"
                trackLabel="IT-Service Details"
              >
                Infrastruktur härten
              </TrackedButton>
            </div>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                data-src="/videos/video_cloud-security.mp4"
                data-poster="/videos/video_cloud-security-poster.webp"
                preload="none"
                loop
                muted
                playsinline
                class="lazy-video w-full aspect-video object-cover"
                aria-label="Sichere Cloud-Infrastruktur"></video>
              <AiImageBadge class="absolute top-3 right-3 z-10" />
            </div>
          </article>

          <!-- Zertifizierungen Card (Wiederhergestellt in vollem Umfang) -->
          <article
            class="bento-card lg:col-span-6 bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-10 hover:border-meg-accent/30 transition-all duration-500 group shadow-lg"
          >
            <div class="flex flex-col md:flex-row gap-12 items-center">
              <div class="flex-1">
                <span
                  class="text-meg-accent font-bold uppercase tracking-[0.2em] text-xs mb-4 block"
                  >Arbeitsweise &amp; Erfahrung</span
                >
                <h3
                  class="text-3xl font-black tracking-tighter text-meg-text-primary-dark mb-6"
                >
                  Arbeiten Sie mit <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400"
                    >zertifizierter</span
                  > Expertise
                </h3>
                <ul
                  class="grid grid-cols-1 md:grid-cols-2 gap-6 text-meg-text-secondary"
                >
