---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SchemaUtils } from '../utils/schema';
import HeroBackground from '../components/HeroBackground.astro';
import AiImageBadge from '../components/AiImageBadge.astro';
import PortfolioTop from '../components/PortfolioTop.astro';
import PriceService from '../components/PriceService.astro';
import Blog from '../components/Blog.astro';
import SkillWrapper from '../components/SkillWrapper.astro';
import TrackedButton from '../components/TrackedButton.astro';
import Testimonials from '../components/Testimonials.astro';
import FreeTools from '../components/FreeTools.astro';
import SuiteClaim from '../components/SuiteClaim.astro';
import ROICalculator from '../components/ROICalculator.astro';

// SEO & Meta
const titel =
  'IT-Consulting & Softwareentwicklung Augsburg/München | Waldheim.dev';
const description =
  'Experte für DevSecOps, Webentwicklung & IT-Strategie. +150% Produktivität durch KI-Workflows. Zertifizierte Qualität für KMU & Startups in Bayern.';
const keywords =
  'IT-Consulting Augsburg, Softwareentwicklung München, DevSecOps Experte, B2B Webentwicklung, Scrum Master Augsburg, IT-Sicherheit KMU, Waldheim IT';
const ogImage = 'https://waldheim.dev/waldheim-dev-og.jpg';

// Structured Data: ProfessionalService & Breadcrumbs
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Waldheim.dev - Markus Waldheim',
  image: 'https://waldheim.dev/waldheim.dev.svg',
  url: 'https://waldheim.dev',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Augsburg',
    addressRegion: 'Bayern',
    addressCountry: 'DE',
  },
  geo: {
    '@type': 'GeoShape',
    region: 'DE-BY',
  },
  areaServed: [
    { '@type': 'City', name: 'Augsburg' },
    { '@type': 'City', name: 'München' },
    { '@type': 'City', name: 'Landsberg am Lech' },
  ],
  description:
    'Senior IT-Consulting, DevSecOps und Individualsoftware. Spezialisiert auf KI-gestützte Effizienzsteigerung (+150%) und agile Transformation.',
  memberOf: [
    {
      '@type': 'Organization',
      name: 'Scrum.org',
      description: 'PSM I, PSM II, PSPO I',
    },
    {
      '@type': 'Organization',
      name: 'IHK',
      description: 'Zertifizierter Ausbilder',
    },
  ],
  priceRange: '€€€',
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  {
    name: 'Home',
    link: 'https://waldheim.dev',
  },
]);
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[professionalServiceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <HeroBackground
    title="High-End IT-Consulting & Software­entwicklung"
    subtitle="Ich transformiere Ihre IT-Prozesse mit DevSecOps und KI-gestützten Workflows für bis zu 150% mehr Produktivität. Ihr lokaler Partner für messbare Ergebnisse im Raum Augsburg und München."
    video="/videos/video_chip.mp4"
    aiGenerated={true}
  >
    <div class="mt-10 flex items-center justify-center flex-wrap gap-4">
      <TrackedButton
        href="https://calendly.com/markus-waldheim/30min"
        target="_blank"
        trackEvent="cta_homepage_calendly"
        trackCategory="hero"
        trackLabel="Strategiegespräch buchen"
        variant="primary"
        icon="fa-solid fa-calendar-check animate-pulse"
        iconPosition="left"
      >
        Kostenloses Strategiegespräch
      </TrackedButton>
      <TrackedButton
        href="/referenzen/1/"
        trackEvent="cta_homepage_references"
        trackCategory="hero"
        trackLabel="Referenzen"
        variant="secondary"
        icon="fa-solid fa-arrow-right"
      >
        Case Studies ansehen
      </TrackedButton>
    </div>

    <!-- Trust-Bar: Direkte Sichtbarkeit der USPs -->
    <div
      class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 text-meg-text-secondary text-sm border-t border-meg-border-dark/30 pt-8"
    >
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">10+ Jahre</span>
        <span>IT-Expertise</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">+150%</span>
        <span>Produktivität durch KI</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">PSM I/II & PSPO</span>
        <span>Zertifiziert</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">90+ Score</span>
        <span>Lighthouse-Performance</span>
      </div>
    </div>
  </HeroBackground>

  <main id="main-content">
    <!-- Strategische 3-Anker-Architektur: Services · Waldheim Suite · Open Source (semrel) -->
    <section
      class="py-20 border-b border-meg-border-dark/30"
      aria-labelledby="strategic-anchors-heading"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <p class="text-meg-accent font-bold uppercase tracking-[0.2em] text-xs mb-4">
            Drei Kernbereiche · Ein Qualitätsanspruch
          </p>
          <h2
            id="strategic-anchors-heading"
            class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6"
          >
            Consulting, SaaS-Plattform &amp; Open-Source Engineering
          </h2>
          <p class="text-lg text-meg-text-secondary">
            Ob maßgeschneiderte Enterprise-Beratung, schlüsselfertige Business-Suite für den Mittelstand oder supply-chain-sichere Open-Source-Automatisierung – wählen Sie den passenden Hebel für Ihr Vorhaben.
          </p>
        </div>

        <div class="mt-12 grid gap-8 lg:grid-cols-3">
          <!-- Anker 1: Dienstleistungen (Services) -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-violet-500/40 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400">
                  <i class="fa-solid fa-shield-halved text-xl" aria-hidden="true"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-violet-400 bg-violet-500/10 border border-violet-500/20 px-3 py-1 rounded-full">
                  1 · IT-Services &amp; Consulting
                </span>
              </div>
              <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-3">
                DevSecOps, Custom Software &amp; Cloud
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-6">
                Zertifizierte Senior-Expertise (PSM II, PSPO I) für automatisierte CI/CD-Pipelines, maßgeschneiderte Web- &amp; Enterprise-Software, sichere IT-Infrastruktur und KNX Smart Home in Augsburg &amp; München.
              </p>
              <ul class="space-y-2 text-xs text-meg-text-secondary mb-8">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>DevSecOps, Kubernetes, GitOps &amp; Cloud-Härtung</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Individualsoftware &amp; KI-gestützte Workflows (+150%)</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>IT-Service, Unifi-Netzwerke &amp; KNX-Automation</span></li>
              </ul>
            </div>
            <div class="flex flex-wrap gap-3 pt-4 border-t border-meg-border-dark/60">
              <TrackedButton
                href="/services/"
                trackEvent="cta_homepage_anchor_services"
                trackCategory="strategic_anchors"
                trackLabel="Services Overview"
                variant="primary"
                icon="fa-solid fa-arrow-right"
              >
                Services entdecken
              </TrackedButton>
              <TrackedButton
                href="#roi-rechner"
                trackEvent="cta_homepage_anchor_roi"
                trackCategory="strategic_anchors"
                trackLabel="ROI Calculator"
                variant="secondary"
              >
                ROI berechnen
              </TrackedButton>
            </div>
          </article>

          <!-- Anker 2: SaaS Waldheim Suite -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-meg-accent/50 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-meg-accent/10 border border-meg-accent/20 flex items-center justify-center text-meg-accent">
                  <i class="fa-solid fa-table-cells-large text-xl" aria-hidden="true"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-meg-accent bg-meg-accent/10 border border-meg-accent/20 px-3 py-1 rounded-full">
                  2 · SaaS Business-Plattform
                </span>
              </div>
              <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-3">
                Waldheim Suite – 9 Module, 1 Login
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-6">
                Schluss mit dem Tool-Flickenteppich: Steuern Sie Kundenportal, CRM (Socialverse), ERP (Silvacore), Dokumentenmanagement (Aether), Fuhrpark (Ecodrive), Finanzen und Workflows aus einer mandantenisolierten App-Shell.
              </p>
              <ul class="space-y-2 text-xs text-meg-text-secondary mb-8">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Zentrale Tenant-Defaults, SSO &amp; nahtloser App-Switch</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>E-Rechnungspflicht ready (XRechnung &amp; ZUGFeRD)</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>100% DSGVO-konform · Gehostet in Deutschland</span></li>
              </ul>
            </div>
            <div class="flex flex-wrap gap-3 pt-4 border-t border-meg-border-dark/60">
              <TrackedButton
                href="/suite/"
                trackEvent="cta_homepage_suite_overview"
                trackCategory="suite_launch"
                trackLabel="Suite Overview"
                variant="primary"
                icon="fa-solid fa-layer-group"
                iconPosition="left"
              >
                Suite entdecken
              </TrackedButton>
              <TrackedButton
                href="/suite/preise/"
                trackEvent="cta_homepage_suite_pricing"
                trackCategory="suite_launch"
                trackLabel="Suite Pricing"
                variant="secondary"
                icon="fa-solid fa-arrow-right"
              >
                Preise ansehen
              </TrackedButton>
            </div>
          </article>

          <!-- Anker 3: Open Source Stack & semrel -->
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark hover:border-blue-500/50 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 shadow-sm hover:shadow-xl">
            <div>
              <div class="flex items-center justify-between mb-6">
                <div class="size-12 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
                  <i class="fa-solid fa-code-branch text-xl" aria-hidden="true"></i>
                </div>
                <span class="text-[10px] font-black uppercase tracking-widest text-blue-400 bg-blue-500/10 border border-blue-500/20 px-3 py-1 rounded-full">
                  3 · Open Source · semrel v0.26.3
                </span>
              </div>
              <h3 class="text-2xl font-bold text-meg-text-primary-dark mb-3">
                semrel &amp; Open-Source Ökosystem
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-6">
                Produktionsreife Open-Source-Software als gelebter Beweis für Engineering-Exzellenz: allen voran <strong>semrel v0.26.3</strong> – die Go-native, zero-dependency Semantic-Release-Engine für Enterprise-CI/CD und Air-Gap-Umgebungen.
              </p>
              <ul class="space-y-2 text-xs text-meg-text-secondary mb-8">
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Statisches Go-Binary ohne Node.js-Abhängigkeiten</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>Cosign v3 Bundle, CycloneDX/SPDX SBOM &amp; SLSA</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i><span>30+ Plugins, <code class="font-mono">.semrel.lock</code> &amp; Monorepo Workspace</span></li>
              </ul>
            </div>
            <div class="flex flex-wrap gap-3 pt-4 border-t border-meg-border-dark/60">
              <TrackedButton
                href="/semrel/"
                trackEvent="cta_homepage_anchor_semrel"
                trackCategory="strategic_anchors"
                trackLabel="semrel Overview"
                variant="primary"
                icon="fa-solid fa-code-branch"
                iconPosition="left"
              >
                semrel v0.26.3
              </TrackedButton>
              <TrackedButton
                href="#opensource-stack"
                trackEvent="cta_homepage_anchor_oss"
                trackCategory="strategic_anchors"
                trackLabel="Open Source Stack"
                variant="secondary"
                icon="fa-solid fa-arrow-right"
              >
                Alle OSS-Tools
              </TrackedButton>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section
      class="bento-service relative isolate py-24"
      aria-labelledby="services-heading"
    >
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <h2 id="services-heading" class="sr-only">
          Meine IT-Services und Prinzipien
        </h2>
        <div class="grid lg:grid-cols-6 grid-cols-1 gap-6">
          <!-- Core Principles Card (Engineering Excellence) -->
          <article
            class="bento-card lg:col-span-3 lg:row-span-2 bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-10 flex flex-col justify-between group hover:border-meg-accent/50 transition-all duration-500"
          >
            <div>
              <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">
                Maximale Qualität durch <span
                  class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400"
                  >Engineering Excellence</span
                >
              </h2>
              <p class="text-lg text-meg-text-secondary mb-8">
                IT ist kein Selbstzweck, sondern Ihr stärkster Hebel. Ich
                garantiere Lösungen, die nicht nur funktionieren, sondern Ihr
                Business skalierbar machen.
              </p>
              <dl class="space-y-6">
                <div>
                  <dt
                    class="flex items-center gap-3 text-meg-text-primary-dark font-bold"
                  >
                    <i
                      class="fa-solid fa-shield-halved text-meg-accent"
                      aria-hidden="true"></i> Sicherheit (By Design)
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">
                    Präventive Absicherung Ihrer Infrastruktur ab der ersten
                    Codezeile.
                  </dd>
                </div>
                <div>
                  <dt
                    class="flex items-center gap-3 text-meg-text-primary-dark font-bold"
                  >
                    <i
                      class="fa-solid fa-gauge-high text-meg-accent"
                      aria-hidden="true"></i> High Performance
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">
                    Ladezeiten unter 1s und optimierte Core Web Vitals für beste
                    UX und SEO.
                  </dd>
                </div>
                <div>
                  <dt
                    class="flex items-center gap-3 text-meg-text-primary-dark font-bold"
                  >
                    <i
                      class="fa-solid fa-code-branch text-meg-accent"
                      aria-hidden="true"></i> Saubere Dokumentation
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">
                    100% nachvollziehbarer Code und Architekturentscheidungen
                    (ADR).
                  </dd>
                </div>
              </dl>
            </div>
            <div class="mt-12">
              <Image
                src="/bento/cert.webp"
                alt="Zertifizierte IT-Qualität durch Markus Waldheim"
                class="rounded-2xl shadow-2xl group-hover:scale-[1.02] transition-transform duration-500"
                width={600}
                height={546}
                loading="eager"
              />
            </div>
          </article>

          <!-- Service Card: DevSecOps -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-violet-500/50 transition-all group"
          >
            <header>
              <h3
                class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500"
              >
                DevSecOps & Automation
              </h3>
            </header>
            <p class="text-meg-text-secondary mb-6">
              Automatisierte Pipelines und Cloud-Native Strategien, die Ihre
              Time-to-Market drastisch verkürzen.
            </p>
            <TrackedButton
              href="/services/devsecops/"
              variant="ghost"
              icon="fa-solid fa-arrow-right"
              class="group-hover:text-violet-400"
              trackEvent="cta_service_devsecops"
              trackCategory="service_card"
              trackLabel="DevSecOps Details"
            >
              Operations skalieren
            </TrackedButton>
            <figure
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                src="/videos/video_devsecops.mp4"
                poster="/videos/video_devsecops-poster.webp"
                loop
                muted
                playsinline
                autoplay
                class="w-full aspect-video object-cover"
                aria-label="Visualisierung einer automatisierten DevSecOps Pipeline"
              ></video>
              <AiImageBadge class="absolute top-3 right-3 z-10" />
            </figure>
          </article>

          <!-- Service Card: Custom Software -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all group"
          >
            <header>
              <h3
                class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400"
              >
                Custom Software
              </h3>
            </header>
            <p class="text-meg-text-secondary mb-6">
              Maßgeschneiderte Software als fertiges Produkt – Web-Apps,
              SaaS-Plattformen und Enterprise-Lösungen, präzise auf Ihre
              Prozesse zugeschnitten.
            </p>
            <TrackedButton
              href="/services/entwicklung/"
              variant="ghost"
              icon="fa-solid fa-arrow-right"
              class="group-hover:text-meg-accent"
              trackEvent="cta_service_development"
              trackCategory="service_card"
              trackLabel="Custom Software anfragen"
            >
              Projekt anfragen
            </TrackedButton>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                src="/videos/video_software.mp4"
                poster="/videos/video_software-poster.webp"
                loop
                muted
                playsinline
                autoplay
                class="w-full aspect-video object-cover"
                aria-label="Code-Visualisierung moderner Softwareentwicklung"
              ></video>
              <AiImageBadge class="absolute top-3 right-3 z-10" />
            </div>
          </article>

          <!-- Service Card: Smart Home & KNX -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-orange-500/50 transition-all group flex flex-col justify-between"
          >
            <div>
              <header>
                <h3
                  class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-500"
                >
                  Smart Home & KNX
                </h3>
              </header>
              <p class="text-meg-text-secondary mb-6">
                KNX-Gebäudeautomation, Rollläden, Fußbodenheizung, Beleuchtung
                und AI-Kamerasicherheit – professionell geplant und umgesetzt.
              </p>
              <TrackedButton
                href="/services/smarthome/"
                variant="ghost"
                icon="fa-solid fa-arrow-right"
                class="group-hover:text-orange-400"
                trackEvent="cta_service_smarthome"
                trackCategory="service_card"
                trackLabel="Smart Home Details"
              >
                Gebäude automatisieren
              </TrackedButton>
            </div>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                src="/videos/video_smarthome.mp4"
                poster="/videos/video_smarthome-poster.webp"
                loop
                muted
                playsinline
                autoplay
                class="w-full aspect-video object-cover"
                aria-label="Smart Home Automation und Gebäudesicherheit"
              ></video>
              <AiImageBadge class="absolute top-3 right-3 z-10" />
            </div>
          </article>

          <!-- Service Card: IT-Service & Cloud -->
          <article
            class="bento-card lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-emerald-500/50 transition-all group flex flex-col justify-between"
          >
            <div>
              <header>
                <h3
                  class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-500"
                >
                  Cloud & IT-Support
                </h3>
              </header>
              <p class="text-meg-text-secondary mb-6">
                Sichere Cloud-Infrastruktur und proaktive Wartung Ihrer
                IT-Systeme – lokal in Augsburg & München.
              </p>
              <TrackedButton
                href="/services/it-service/"
                variant="ghost"
                icon="fa-solid fa-arrow-right"
                class="group-hover:text-emerald-400"
                trackEvent="cta_service_it"
                trackCategory="service_card"
                trackLabel="IT-Service Details"
              >
                Infrastruktur härten
              </TrackedButton>
            </div>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                src="/videos/video_cloud-security.mp4"
                poster="/videos/video_cloud-security-poster.webp"
                loop
                muted
                playsinline
                autoplay
                class="w-full aspect-video object-cover"
                aria-label="Sichere Cloud-Infrastruktur"></video>
              <AiImageBadge class="absolute top-3 right-3 z-10" />
            </div>
          </article>

          <!-- Zertifizierungen Card (Wiederhergestellt in vollem Umfang) -->
          <article
            class="bento-card lg:col-span-6 bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-10 hover:border-meg-accent/30 transition-all duration-500 group shadow-lg"
          >
            <div class="flex flex-col md:flex-row gap-12 items-center">
              <div class="flex-1">
                <span
                  class="text-meg-accent font-bold uppercase tracking-[0.2em] text-xs mb-4 block"
                  >Garantierte Qualität</span
                >
                <h3
                  class="text-3xl font-black tracking-tighter text-meg-text-primary-dark mb-6"
                >
                  Profitieren Sie von <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400"
                    >zertifizierter</span
                  > Expertise
                </h3>
                <ul
                  class="grid grid-cols-1 md:grid-cols-2 gap-6 text-meg-text-secondary"
                >
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-circle-check text-meg-accent mt-1"
                    ></i>
                    <span
