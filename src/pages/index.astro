              Projekt anfragen
            </TrackedButton>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                data-src="/videos/video_software.mp4"
                data-poster="/videos/video_software-poster.webp"
                preload="none"
                loop
                muted
                playsinline
                class="lazy-video w-full aspect-video object-cover"
                aria-label="Code-Visualisierung moderner Softwareentwicklung"
              ></video>
              <AiImageBadge class="absolute bottom-2.5 right-2.5 z-10" />
            </div>
          </article>

          <!-- Service Card: Smart Home & KNX -->
