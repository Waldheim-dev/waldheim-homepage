            class="-m-6"
            alt="Security"
          />
        </div>
      </div>
      <div
        class="bento-card lg:col-span-2 sm:col-span-6 col-span-1 bg-gradient-to-l from-wd-200 to-wd-300 dark:from-gray-400 dark:to-slate-500 rounded-3xl overflow-hidden p-12 text-slate-800 shadow-lg"
