---
import Layout from '../layouts/Layout.astro';
import { SchemaUtils } from '../utils/schema';
import HeroBackground from '../components/HeroBackground.astro';
import PortfolioTop from '../components/PortfolioTop.astro';
import PriceService from '../components/PriceService.astro';
import Blog from '../components/Blog.astro';
import EcodriveClaim from '../components/EcodriveClaim.astro';
import PriceEcodrive from '../components/PriceEcodrive.astro';
import SkillWrapper from '../components/SkillWrapper.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.href
}]);

const titel = 'waldheim.dev: IT-Lösungen für KMU, Vereine & Startups';
const description = 'waldheim.dev: Ihr Partner für hochwertige IT-Dienstleistungen (DevSecOps, Entwicklung, Design, IT-Service) und Verbandssoftware (SEWOBE). Qualität zum fairen Preis (70€/Std.). Kontaktieren Sie uns! (Augsburg, München, DACH)';
const keywords = 'IT-Dienstleistungen, Augsburg, München, DevSecOps, Webentwicklung, IT-Service, Verbandssoftware, Softwareentwicklung, IT Beratung, KMU, Vereine, Startups';
---

<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <HeroBackground title="Nachhaltige IT-Lösungen aus einer Hand"
                  subtitle="Von DevSecOps über Webentwicklung bis zum Smart Home – ich begleite Sie digital. Für Unternehmen & Verbände im Raum Augsburg/München."

                  video="/videos/video_chip.mp4">
    <div class="mt-10 flex items-center justify-center flex-wrap gap-x-6">
      <a
        href="/kontakt"
        class="gsap-fadein gsap-btn flex gap-1 rounded-md bg-sherpa-blue-900  px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-sherpa-blue-900  focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sherpa-blue-600"
      >Jetzt beraten lassen
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="animate-pulse w-5 h-5 gsap-wiggle"
        >
          <path
            d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
          ></path>
          <path
            d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
          ></path>
        </svg>
      </a>
      <a
        href="/referenzen/"
        class="gsap-fadein gsap-btn flex gap-1 transform transform-all transform-ease-in-out text-sm font-semibold leading-6 text-white"
      >Referenzen
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6 gsap-wiggle"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"></path>
        </svg>
      </a>
    </div>
  </HeroBackground>

  <div>
    <main>

      <section
        class="bento-service relative isolate"
      >

        <div
          class="mx-auto max-w-7xl px-6 pb-32 pt-36 sm:pt-60 lg:px-8 lg:pt-32 bento-grid grid lg:grid-cols-6 sm:grid-cols-6 grid-cols-1 gap-4 grid-flow-row"
        >
          <div
            class="realtive lg:row-span-2 sm:row-span-2 lg:col-span-3 sm:col-span-3 col-span-1 "
          >
            <div
              class="bento-card gsap-fadein relative lg:row-span-3 lg:col-span-2 md:col-span-6 sm:col-span-6 col-span-1 h-full"
            >
              <div
                class="blur-sm absolute inset-0 rounded-3xl transition-all -translate-x-0 translate-y-0 bg-conic-180 from-pink-500 via-cyan-500 to-violet-500 animate-rotate_gradient" />
              <div
                class="flex flex-col gap-4 justify-between h-full z-10 relative bg-sherpa-blue-900 text-pancho-200 p-12 shadow-lg rounded-3xl border-1 border-gray-300/30"
              >
                <div class="flex flex-col gap-4">
                  <h2
                    class="text-3xl font-bold tracking-tight sm:text-6xl"
                  >
                    So arbeite ich: Meine Prinzipien für Ihren Erfolg
                  </h2>
                  <p
                    class="relative mt-6 text-lg leading-8 sm:max-w-md lg:max-w-none"
                  >
                    Von der ersten Beratung bis zur finalen Umsetzung – ich stehe für Qualität, Transparenz und
                    Kundenorientierung.
                  </p>
                  <ul
                    role="list"
                    class="mt-8 max-w-xl space-y-8 "
                  >
                    <li class="flex gap-x-3">
                      <svg
                        class="mt-1 h-5 w-5 flex-none "
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span
                      ><strong class="font-semibold "
                      >Qualität:</strong
                      >  Ich liefere ausschließlich Ergebnisse, die meinen hohen Ansprüchen genügen.</span
                      >
                    </li>
                    <li class="flex gap-x-3">
                      <svg
                        class="mt-1 h-5 w-5 flex-none "
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span
                      ><strong class="font-semibold "
                      >Zuverlässigkeit:</strong
                      > Auf meine IT-Lösungen und meinen Support können Sie zählen.</span
                      >
                    </li>
                    <li class="flex gap-x-3">
                      <svg
                        class="mt-1 h-5 w-5 flex-none "
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span
                      ><strong class="font-semibold "
                      >Nachvollziehbarkeit:</strong
                      > Alle Schritte werden detailliert dokumentiert.</span
                      >
                    </li>
                    <li class="flex gap-x-3">
                      <svg
                        class="mt-1 h-5 w-5 flex-none "
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span
                      ><strong class="font-semibold "
                      >Passgenauigkeit:</strong
                      > Ich entwickel Lösungen, die perfekt zu Ihren Anforderungen passen.</span
                      >
                    </li>
                  </ul>
                </div>
                <img
                  src="/bento/cert.webp"
                  loading="lazy"
                  alt="Qualität bei Waldheim.dev"
                />
              </div>
            </div>
          </div>
          <div
            class="bento-card gsap-fadein lg:col-span-3 sm:col-span-3 col-span-1 bg-antique-brass-300 border-1 border-gray-300/30   rounded-3xl overflow-hidden p-12 shadow-lg"
          >
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3
                  class="text-lg -mt-2 font-bold tracking-tight text-slate-800  sm:text-xl"
                >
                  DevSecOps für schnellere & sichere Entwicklung
                </h3>

                <p
                  class="relative mb-6 text-lg text-slate-700  sm:max-w-md lg:max-w-none"
                >
                  Ich automatisiere Ihre Entwicklungspipeline, integrieren Sicherheit von Anfang an und verkürzen Ihre
                  Release-Zyklen.
                </p>
                <a
                  href="/services/devops/"
                  class="border px-3.5 py-2 rounded-3xl text-slate-800 border-slate-800 hover:bg-slate-800 hover:text-white   ::text-slate-800 transition"
                >Zu meinem DevSecOps-Services</a
                >
              </div>
              <figure class=" w-full rounded-2xl overflow-hidden">
              <video
              class="object-contains max-sm:max-w-none w-full"
              preload="none"
              poster=""
              autoplay
              loop
              muted
            >
              <source
                src="/videos/video_devsecops.mp4" type="video/mp4" />
            </video>
            </figure>
            </div>
          </div>
          <div
            class="bento-card gsap-fadein lg:col-span-3 sm:col-span-3 col-span-1 bg-antique-brass-300 border-1 border-gray-300/30 rounded-3xl overflow-hidden p-12 shadow-lg"
          >
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3
                  class="text-lg -mt-2 font-bold tracking-tight text-slate-800  sm:text-xl"
                >
                  Individuelle Softwarelösungen für Ihren Bedarf
                </h3>
                <p
                  class="relative mb-6 text-lg text-slate-700  sm:max-w-md lg:max-w-none"
                >
                  Ich entwickel Webanwendungen, Tools und maßgeschneiderte Software, die perfekt zu Ihren Prozessen
                  passt.
                </p>

                <a
                  href="/services/entwicklung/"
                  class="border px-3.5 py-2 rounded-3xl text-slate-800 border-slate-800 hover:bg-slate-800 hover:text-white   ::text-slate-800 transition"
                >Jetzt Projekt anfragen</a
                >
              </div>
              <figure class=" w-full rounded-2xl overflow-hidden">
              <video
              class="object-contains max-sm:max-w-none w-full"
              preload="none"
              poster=""
              autoplay
              loop
              muted
            >
              <source
                src="/videos/video_software.mp4" type="video/mp4" />
            </video>
            </figure>
            </div>
          </div>
          <div
            class="bento-card gsap-fadein lg:col-span-3 md:col-span-3 sm:col-span-3 col-span-1 bg-antique-brass-300 border-1 border-gray-300/30 rounded-3xl overflow-hidden p-12 shadow-lg"
          >
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3
                  class="text-lg -mt-2 font-bold tracking-tight text-slate-800  sm:text-xl"
                >
                  Branding, Webdesign & UX – aus einem Guss
                </h3>

                <p
                  class="relative mb-6 text-lg text-slate-700  sm:max-w-md lg:max-w-none"
                >
                  Ich entwickel ganzheitliche Designlösungen, die Ihre Marke stärken und Ihre Zielgruppe überzeugen.
                </p>
                <a
                  href="/services/design/"
                  class="border px-3.5 py-2 rounded-3xl text-slate-800 border-slate-800 hover:bg-slate-800 hover:text-white   ::text-slate-800 transition"
                >Design-Philosophie entdecken</a
                >
              </div>
              <img
                src="/bento/design.webp"
                loading="lazy"
                class="-m-6"
                alt="Design"
              />
            </div>
          </div>
          <div
            class="bento-card gsap-fadein lg:col-span-3 md:col-span-3 sm:col-span-3 col-span-1 bg-sherpa-blue-900 text-pancho-200 border-1 border-gray-300/30   rounded-3xl overflow-hidden p-12 shadow-lg"
          >
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3
                  class="text-lg -mt-2 font-bold tracking-tight sm:text-xl"
                >
                  Sichere Cloud-Lösungen & IT-Service
                </h3>
                <p
                  class="relative mb-6 text-lg sm:max-w-md lg:max-w-none"
                >
                  Ich migriere Ihre IT in die Cloud, sorgen für maximale Sicherheit und ermöglichen ortsunabhängiges
                  Arbeiten.
                </p>
                <a
                  href="/services/it-service/"
                  class="border px-3.5 py-2 rounded-3xl text-pancho-200 border-pancho-200 hover:bg-pancho-200 hover:text-sherpa-blue-900 transition"
                >Mehr über Cloud-Services</a
                >
              </div>
              <img
                src="/bento/security.webp"
                loading="lazy"
                class="-m-6"
                alt="Security"
              />
            </div>
          </div>
          
          <div
            class="bento-card gsap-fadein lg:col-span-6 sm:col-span-6 col-span-1 bg-antique-brass-300 border-1 border-gray-300/30   rounded-3xl overflow-hidden p-12 shadow-lg"
          >
            <div class="flex md:flex-row flex-col gap-4 justify-between">
              <div class="flex flex-col col-auto items-start gap-2">
                <p
                  class="text-base font-semibold leading-5 text-sherpa-blue-900 "
                >
                  Ihr Vorteil: Zertifiziertes Know-how
                </p>
                <h3
                  class="text-1xl -mt-2 font-bold tracking-tight text-slate-800  sm:text-2xl"
                >
                  Profitieren Sie von meiner Expertise in agilen Methoden und IT-Projekten.
                </h3>
                <ul
                  role="list"
                  class="mt-8 max-w-xl space-y-8 text-slate-800 "
                >
                  <li class="flex gap-x-3">
                    <svg
                      class="mt-1 h-5 w-5 flex-none text-slate-800 "
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span
                    >Professional <strong
                      class="font-semibold text-slate-800 "
                    >Scrum Master I.</strong
                    > (PSM I) - Scrum.org</span
                    >
                  </li>
                  <li class="flex gap-x-3">
                    <svg
                      class="mt-1 h-5 w-5 flex-none text-slate-800 "
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span
                    >Professional <strong
                      class="font-semibold text-slate-800 "
                    >Scrum Master II.</strong
                    > (PSM II) - Scrum.org</span
                    >
                  </li>
                  <li class="flex gap-x-3">
                    <svg
                      class="mt-1 h-5 w-5 flex-none text-slate-800 "
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span
                    >Professional <strong
                      class="font-semibold text-slate-800 "
                    >Scrum Product Owner I.</strong
                    > (PSPO I.) - Scrum.org</span
                    >
                  </li>
                  <li class="flex gap-x-3">
                    <svg
                      class="mt-1 h-5 w-5 flex-none text-slate-800 "
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span
                    >Ausbilder (IHK) <strong
                      class="font-semibold text-slate-800 "
                    >Ausbilder für Fachinformatik.</strong
                    ></span
                    >
                  </li>
                </ul>
              </div>
              <div class="relative flex gap-2 flex-wrap">
                <img
                  src="/bento/PSMI.png"
                  class="sm:h-40 sm:w-40 w-[33%] aspect-square"
                  loading="lazy"
                  alt="Markus Waldheim - Zertifizierter Professional Scrum Master 1."
                />
                <img
                  src="/bento/PSMII.png"
                  class="sm:h-40 sm:w-40 w-[33%] aspect-square"
                  loading="lazy"
                  alt="Markus Waldheim - Zertifizierter Professional Scrum Master 2."
                />
                <img
                  src="/bento/PSPOI.png"
                  class="sm:h-40 sm:w-40 w-[33%] aspect-square"
                  loading="lazy"
                  alt="Markus Waldheim - Zertifizierter Professional Scrum Product Owner 1."
                />
              </div>
            </div>
          </div>
        </div>
      </section>
      <PortfolioTop />
      <PriceService />

      <Blog limits={4} />
      <SkillWrapper />

      <EcodriveClaim />
      <PriceEcodrive />
    </main>
  </div>
</Layout>
