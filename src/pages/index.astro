            <a
              href="/services/devops"
              class="border px-3.5 py-2 rounded-3xl text-white border-white hover:bg-white hover:text-slate-800 transition"
              >Erfahre mehr</a
            >
          </div>
          <img
            src="/bento/devops.webp"
            loading="lazy"
            class="-mb-6 w-full"
            alt="DevSecOps"
          />
        </div>
      </div>
      <div
        class="bento-card lg:col-span-1 md:col-span-2 sm:col-span-3 col-span-1 bg-gradient-to-br from-wd-50 to-wd-200 rounded-3xl overflow-hidden p-12 text-slate-800 shadow-lg"
      >
        <div class="flex flex-col gap-4 justify-between h-full">
          <div class="flex flex-col items-start gap-2">
            <h3
              class="text-lg -mt-2 font-bold tracking-tight text-slate-800 sm:text-xl"
            >
              Softwareentwicklung
            </h3>
            <p
              class="relative mb-6 text-lg text-slate-700 sm:max-w-md lg:max-w-none"
