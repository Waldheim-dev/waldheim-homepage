                    >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <section
    class="bento-service bg-gradient-to-br from-gray-50 to-gray-100 dark:bg-gradient-to-b dark:to-slate-800 dark:from-slate-800 relative isolate"
  >
    <svg
      class="absolute inset-x-0 top-0 -z-10 h-[64rem] w-full stroke-wd-200 dark:stroke-wds-900 [mask-image:radial-gradient(32rem_32rem_at_center,white,transparent)]"
      aria-hidden="true"
    >
      <defs>
        <pattern
