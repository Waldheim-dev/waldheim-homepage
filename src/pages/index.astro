            class="aspect-[801/1036] w-[50.0625rem] bg-gradient-to-tr from-[#dfece0] to-[#6b9e78] opacity-30"
            style="clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)"
          >
          </div>
        </div>
        <div class="overflow-hidden">
          <div
            class="mx-auto max-w-7xl px-6 pb-32 pt-36 sm:pt-60 lg:px-8 lg:pt-32"
          >
            <div
              class="mx-auto max-w-2xl gap-x-14 lg:mx-0 lg:flex lg:max-w-none lg:items-center"
            >
              <div class="w-full max-w-xl lg:shrink-0 xl:max-w-2xl">
                <h1
                  class="text-6xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-7xl"
                >
                  Dein Design- und Entwicklungs-Berater
                </h1>
                <p
                  class="relative mt-6 text-lg leading-8 text-gray-600 dark:text-gray-200 sm:max-w-md lg:max-w-none"
                >
                  Durch nachhaltige und optimierte Entwicklungen und Design.
                  Durch einsparen von Zeit und Ressourcen zu optimierten
                  Prozessen. Ich helfe Ihnen dabei.
                </p>
                <div class="mt-10 flex items-center flex-wrap gap-x-6">
                  <a
                    href="mailto:kontakt@waldheim.dev"
                    class="flex gap-1 rounded-md bg-wd-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-wd-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wd-600"
                    >Kontaktiere mich
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="animate-pulse w-5 h-5"
                    >
                      <path
                        d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
                      ></path>
                      <path
                        d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
                      ></path>
                    </svg>
                  </a>
                  <a
                    href="/projects/"
                    class="flex gap-1 text-sm font-semibold leading-6 text-wd-900 dark:text-white"
                    >Mein Portfolio
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-6 h-6"
