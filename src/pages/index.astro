          </span>
          = Mein empfohlender Techstack
        </p>
        <script is:inline>
          document.addEventListener('astro:page-load', () => {
            const triggers = document.querySelectorAll(
              '[data-trigger="filter"]'
            );
            const cards = document.querySelectorAll('[data-layer]');
            triggers.forEach((trigger) => {
              trigger.addEventListener('click', () => {
                let filtered = trigger.getAttribute('data-filtered') === 'true';
                const filter = trigger.getAttribute('data-filter');
                filtered = !filtered;
                if (filter === 'all') {
                  filtered = false;
                }
                for (const nextTrigger of triggers) {
                  nextTrigger.classList.remove('bg-primary-300','dark:bg-slate-500');
                  nextTrigger.classList.add('bg-primary-100','dark:bg-slate-700');
                  nextTrigger.setAttribute('data-filtered', 'false');
                }
                if (filtered) {
                  trigger.classList.remove('bg-primary-100','dark:bg-slate-700');
                  trigger.classList.add('bg-primary-300','dark:bg-slate-500');
                  trigger.setAttribute('data-filtered', 'true');
                }
                for (const card of cards) {
                  if (!filtered) {
                    card.style.display = null;
                  } else {
                    if (card.getAttribute('data-layer').includes(filter)) {
                      card.style.display = null;
                    } else {
                      card.style.display = 'none';
                    }
                  }
                }
              });
            });
          });
        </script>
        <script is:inline data-id="table-script" data-plan="card">
          document.addEventListener('astro:page-load', () => {
            const script = document.querySelector('*[data-id="table-script"]');
            const card = document.querySelector('#card');
            const table = document.querySelector('#table');

            const cardView = document.querySelector('.card-view');
            const tableView = document.querySelector('.table-view');

            const dataSort = document.querySelectorAll('[data-sort]');

            if (script.dataset.plan === 'card') {
              tableView.classList.add('hidden');
              cardView.classList.remove('hidden');
            } else {
              cardView.classList.add('hidden');
              tableView.classList.remove('hidden');
            }

            card?.addEventListener('click', () => {
              script.dataset.plan = 'card';
              card.classList.add('bg-primary-500', 'text-white', 'dark:bg-emerald-800');
              table.classList.remove('bg-primary-500', 'text-white', 'dark:bg-emerald-800');
              cardView.classList.remove('hidden');
              tableView.classList.add('hidden');
            });

            table?.addEventListener('click', () => {
              script.dataset.plan = 'table';
              table.classList.add('bg-primary-500', 'text-white', 'dark:bg-emerald-800');
              card.classList.remove('bg-primary-500', 'text-white', 'dark:bg-emerald-800');
              tableView.classList.remove('hidden');
              cardView.classList.add('hidden');
            });

            dataSort.forEach((sort) => {
              sort.classList.add('cursor-pointer');
              sort.classList.add('after:transition-all');
              sort.classList.add('hover:after:content-["↕"]');
              sort.classList.add('relative');
              sort.classList.add('after:absolute');
              sort.classList.add('after:right-2');
              sort.addEventListener('click', () => {
                dataSort.forEach((nextSort) => {
                  nextSort.classList.remove('after:content-["↕"]');
                });
                sort.classList.add('after:content-["↕"]');
                // get all rows of table
                const rows = tableView.querySelectorAll('tbody tr');
                let sortDirection =
                  tableView.getAttribute('data-sortDirection');
                const sorted = tableView.getAttribute('data-sorted');
                // change the direction by same sorted
                if (sorted === sort.getAttribute('data-sort')) {
                  tableView.setAttribute(
                    'data-sortDirection',
                    sortDirection === 'asc' ? 'desc' : 'asc'
                  );
                } else {
                  tableView.setAttribute(
                    'data-sorted',
                    sort.getAttribute('data-sort')
                  );
                  tableView.setAttribute('data-sortDirection', 'asc');
                }
                // sort all rows by sorted
                sortDirection = tableView.getAttribute('data-sortDirection');
                const tbody = tableView.querySelector('tbody');
                tbody.innerHTML = '';
                // convert NodeList to array
                const sortArray = Array.from(rows);
                // sort by sorted of all rows
                const knowledgeNumber = (knowledge) => {
                  if (knowledge === 'basic') {
                    return 1;
                  } else if (knowledge === 'advanced') {
                    return 2;
                  } else if (knowledge === 'expert') {
                    return 3;
                  }
                  return 0;
                };
                const timeDiff = (
                  fixedExperience,
                  isActive,
                  sinceLastRollup
                ) => {
                  const current = new Date();
                  const since = new Date(sinceLastRollup);
                  let dateDiff = current.getFullYear() - since.getFullYear();
                  const months = current.getMonth() - since.getMonth();
                  if (dateDiff <= 0) {
                    switch (true) {
                      case months < 4:
                        dateDiff = 0.25;
                        break;
                      case months < 7:
                        dateDiff = 0.5;
                        break;
                      case months < 10:
                        dateDiff = 0.75;
                        break;
                      default:
                        dateDiff = 1;
                        break;
                    }
                  }
                  return isActive
                    ? dateDiff + fixedExperience
                    : fixedExperience;
                };
                const sortEntrys = sortArray.map((row) => {
                  const data = JSON.parse(row.getAttribute('data-entry'));
                  return {
                    data: {
                      ...data,
                      knowledgebase: knowledgeNumber(data.knowledgebase),
                      fixedExperience: timeDiff(
                        data.fixedExperience,
                        data.isActive,
                        data.sinceLastRollup
                      )
                    },
                    entitie: row
                  };
                });
                sortEntrys.sort((a, b) => {
                  if (sorted === 'name') {
                    a.data[sorted] = a.data[sorted].toUpperCase();
                    b.data[sorted] = b.data[sorted].toUpperCase();
                  }

                  if (sortDirection === 'asc') {
                    return a.data[sorted] > b.data[sorted] ? 1 : -1;
                  } else {
                    return a.data[sorted] < b.data[sorted] ? 1 : -1;
                  }
                });
                sortEntrys.forEach((entry) => {
                  tbody.appendChild(entry.entitie);
                });
              });
            });
          });
        </script>
      </div>
    </div>
    <section class="table-view" data-sorted="name" data-sortDirection="asc">
