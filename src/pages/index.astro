        class='bento-card lg:row-span-3 lg:col-span-2 md:col-span-6 sm:col-span-6 col-span-1 backdrop-blur-sm bg-white/30 dark:bg-white/10 rounded-3xl text-white overflow-hidden p-12 border border-solid border-slate-400  shadow-lg'>
        <div class='flex flex-col gap-4 justify-between h-full'>
          <div class='flex flex-col gap-4'>

            <h2 class='text-3xl font-bold tracking-tight text-white dark:text-gray-50 sm:text-6xl'>Bringt den
              Professionellen Service zu euch</h2>
            <p class='relative mt-6 text-lg leading-8 text-gray-100 dark:text-gray-200 sm:max-w-md lg:max-w-none'>
              Qualität im Service von Anfang an</p>
