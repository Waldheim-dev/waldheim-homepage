---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SchemaUtils } from '../utils/schema';
import HeroBackground from '../components/HeroBackground.astro';
import PortfolioTop from '../components/PortfolioTop.astro';
import PriceService from '../components/PriceService.astro';
import Blog from '../components/Blog.astro';
import SkillWrapper from '../components/SkillWrapper.astro';
import TrackedButton from '../components/TrackedButton.astro';
import Testimonials from '../components/Testimonials.astro';
import FreeTools from '../components/FreeTools.astro';
import SuiteClaim from '../components/SuiteClaim.astro';

// SEO & Meta
const titel = 'IT-Consulting & Softwareentwicklung Augsburg/München | Waldheim.dev';
const description = 'Experte für DevSecOps, Webentwicklung & IT-Strategie. +150% Produktivität durch KI-Workflows. Zertifizierte Qualität für KMU & Startups in Bayern.';
const keywords = 'IT-Consulting Augsburg, Softwareentwicklung München, DevSecOps Experte, B2B Webentwicklung, Scrum Master Augsburg, IT-Sicherheit KMU, Waldheim IT';
const ogImage = 'https://waldheim.dev/waldheim-dev-og.jpg';

// Structured Data: ProfessionalService & Breadcrumbs
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  'name': 'Waldheim.dev - Markus Waldheim',
  'image': 'https://waldheim.dev/waldheim.dev.svg',
  'url': 'https://waldheim.dev',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Augsburg',
    'addressRegion': 'Bayern',
    'addressCountry': 'DE'
  },
  'geo': {
    '@type': 'GeoShape',
    'region': 'DE-BY'
  },
  'areaServed': [
    { '@type': 'City', 'name': 'Augsburg' },
    { '@type': 'City', 'name': 'München' },
    { '@type': 'City', 'name': 'Landsberg am Lech' }
  ],
  'description': 'Senior IT-Consulting, DevSecOps und Individualsoftware. Spezialisiert auf KI-gestützte Effizienzsteigerung (+150%) und agile Transformation.',
  'memberOf': [
    { '@type': 'Organization', 'name': 'Scrum.org', 'description': 'PSM I, PSM II, PSPO I' },
    { '@type': 'Organization', 'name': 'IHK', 'description': 'Zertifizierter Ausbilder' }
  ],
  'priceRange': '€€€'
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}]);
---

<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[professionalServiceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <HeroBackground 
    title="High-End IT-Consulting & Software&shy;entwicklung"
    subtitle="Ich transformiere Ihre IT-Prozesse mit DevSecOps und KI-gestützten Workflows für bis zu 150% mehr Produktivität. Ihr lokaler Partner für messbare Ergebnisse im Raum Augsburg und München."
    video="/videos/video_chip.mp4"
  >
    <div class="mt-10 flex items-center justify-center flex-wrap gap-4">
      <TrackedButton
        href="https://calendly.com/markus-waldheim/30min"
        target="_blank"
        trackEvent="cta_homepage_calendly"
        trackCategory="hero"
        trackLabel="Strategiegespräch buchen"
        variant="primary"
        icon="fa-solid fa-calendar-check animate-pulse"
        iconPosition="left"
      >
        Kostenloses Strategiegespräch
      </TrackedButton>
      <TrackedButton
        href="/referenzen/1/"
        trackEvent="cta_homepage_references"
        trackCategory="hero"
        trackLabel="Referenzen"
        variant="secondary"
        icon="fa-solid fa-arrow-right"
      >
        Case Studies ansehen
      </TrackedButton>
    </div>
    
    <!-- Trust-Bar: Direkte Sichtbarkeit der USPs -->
    <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-6 text-meg-text-secondary text-sm border-t border-meg-border-dark/30 pt-8">
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">10+ Jahre</span>
        <span>IT-Expertise</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">+150%</span>
        <span>Produktivität durch KI</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">PSM I/II & PSPO</span>
        <span>Zertifiziert</span>
      </div>
      <div class="flex flex-col items-center">
        <span class="text-meg-accent font-bold text-lg">90+ Score</span>
        <span>Lighthouse-Performance</span>
      </div>
    </div>
  </HeroBackground>

  <main id="main-content">
    <section class="bento-service relative isolate py-24" aria-labelledby="services-heading">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <h2 id="services-heading" class="sr-only">Meine IT-Services und Prinzipien</h2>
        <div class="grid lg:grid-cols-6 grid-cols-1 gap-6">
          
          <!-- Core Principles Card (Engineering Excellence) -->
          <article class="lg:col-span-3 lg:row-span-2 bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-10 flex flex-col justify-between group hover:border-meg-accent/50 transition-all duration-500">
            <div>
              <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-6">
                Maximale Qualität durch <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Engineering Excellence</span>
              </h2>
              <p class="text-lg text-meg-text-secondary mb-8">
                IT ist kein Selbstzweck, sondern Ihr stärkster Hebel. Ich garantiere Lösungen, die nicht nur funktionieren, sondern Ihr Business skalierbar machen.
              </p>
              <dl class="space-y-6">
                <div>
                  <dt class="flex items-center gap-3 text-meg-text-primary-dark font-bold">
                    <i class="fa-solid fa-shield-halved text-meg-accent" aria-hidden="true"></i> Sicherheit (By Design)
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">Präventive Absicherung Ihrer Infrastruktur ab der ersten Codezeile.</dd>
                </div>
                <div>
                  <dt class="flex items-center gap-3 text-meg-text-primary-dark font-bold">
                    <i class="fa-solid fa-gauge-high text-meg-accent" aria-hidden="true"></i> High Performance
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">Ladezeiten unter 1s und optimierte Core Web Vitals für beste UX und SEO.</dd>
                </div>
                <div>
                  <dt class="flex items-center gap-3 text-meg-text-primary-dark font-bold">
                    <i class="fa-solid fa-code-branch text-meg-accent" aria-hidden="true"></i> Saubere Dokumentation
                  </dt>
                  <dd class="mt-2 ml-8 text-meg-text-secondary">100% nachvollziehbarer Code und Architekturentscheidungen (ADR).</dd>
                </div>
              </dl>
            </div>
            <div class="mt-12">
               <Image 
                 src="/bento/cert.webp" 
                 alt="Zertifizierte IT-Qualität durch Markus Waldheim" 
                 class="rounded-2xl shadow-2xl group-hover:scale-[1.02] transition-transform duration-500" 
                 width={600} 
                 height={546} 
                 loading="eager" 
               />
            </div>
          </article>

          <!-- Service Card: DevSecOps -->
          <article class="lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-violet-500/50 transition-all group">
            <header>
              <h3 class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500">DevSecOps & Automation</h3>
            </header>
            <p class="text-meg-text-secondary mb-6">Automatisierte Pipelines und Cloud-Native Strategien, die Ihre Time-to-Market drastisch verkürzen.</p>
            <TrackedButton 
              href="/services/devsecops/" 
              variant="ghost" 
              icon="fa-solid fa-arrow-right" 
              class="group-hover:text-violet-400"
              trackEvent="cta_service_devsecops"
              trackCategory="service_card"
              trackLabel="DevSecOps Details"
            >
              Operations skalieren
            </TrackedButton>
            <figure class="mt-8 rounded-xl overflow-hidden transition-all duration-700">
               <video 
                 src="/videos/video_devsecops.mp4" 
                 poster="/videos/video_devsecops-poster.webp" 
                 loop muted playsinline autoplay 
                 class="w-full aspect-video object-cover"
                 aria-label="Visualisierung einer automatisierten DevSecOps Pipeline"
               ></video>
            </figure>
          </article>

          <!-- Service Card: Custom Software -->
          <article class="lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all group">
            <header>
              <h3 class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Custom Software</h3>
            </header>
            <p class="text-meg-text-secondary mb-6">Maßgeschneiderte Software als fertiges Produkt – Web-Apps, SaaS-Plattformen und Enterprise-Lösungen, präzise auf Ihre Prozesse zugeschnitten.</p>
            <TrackedButton 
              href="/services/entwicklung/" 
              variant="ghost" 
              icon="fa-solid fa-arrow-right" 
              class="group-hover:text-meg-accent"
              trackEvent="cta_service_development"
              trackCategory="service_card"
              trackLabel="Custom Software anfragen"
            >
              Projekt anfragen
            </TrackedButton>
            <div class="mt-8 rounded-xl overflow-hidden transition-all duration-700">
               <video 
                 src="/videos/video_software.mp4" 
                 poster="/videos/video_software-poster.webp" 
                 loop muted playsinline autoplay 
                 class="w-full aspect-video object-cover"
                 aria-label="Code-Visualisierung moderner Softwareentwicklung"
               ></video>
            </div>
          </article>

          <!-- Service Card: Smart Home & KNX -->
          <article class="lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-orange-500/50 transition-all group flex flex-col justify-between">
            <div>
              <header>
                <h3 class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-500">Smart Home & KNX</h3>
              </header>
              <p class="text-meg-text-secondary mb-6">KNX-Gebäudeautomation, Rollläden, Fußbodenheizung, Beleuchtung und AI-Kamerasicherheit – professionell geplant und umgesetzt.</p>
              <TrackedButton 
                href="/services/smarthome/" 
                variant="ghost" 
                icon="fa-solid fa-arrow-right" 
                class="group-hover:text-orange-400"
                trackEvent="cta_service_smarthome"
                trackCategory="service_card"
                trackLabel="Smart Home Details"
              >
                Gebäude automatisieren
              </TrackedButton>
            </div>
            <div class="mt-8 rounded-xl overflow-hidden transition-all duration-700">
               <video 
                 src="/videos/video_cloud-security.mp4" 
                 poster="/videos/video_cloud-security-poster.webp" 
                 loop muted playsinline autoplay 
                 class="w-full aspect-video object-cover"
                 aria-label="Smart Home Automation und Gebäudesicherheit"
               ></video>
            </div>
          </article>

          <!-- Service Card: IT-Service & Cloud -->
          <article class="lg:col-span-3 bg-meg-surface-dark/60 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-8 hover:border-emerald-500/50 transition-all group flex flex-col justify-between">
            <div>
              <header>
                <h3 class="text-2xl font-bold mb-4 text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-500">Cloud & IT-Support</h3>
              </header>
              <p class="text-meg-text-secondary mb-6">Sichere Cloud-Infrastruktur und proaktive Wartung Ihrer IT-Systeme – lokal in Augsburg & München.</p>
              <TrackedButton 
                href="/services/it-service/" 
                variant="ghost" 
                icon="fa-solid fa-arrow-right" 
                class="group-hover:text-emerald-400"
                trackEvent="cta_service_it"
                trackCategory="service_card"
                trackLabel="IT-Service Details"
              >
                Infrastruktur härten
              </TrackedButton>
            </div>
            <div class="mt-8 rounded-xl overflow-hidden transition-all duration-700">
              <video 
                src="/videos/video_cloud-security.mp4" 
                poster="/videos/video_cloud-security-poster.webp" 
                loop muted playsinline autoplay 
                class="w-full aspect-video object-cover"
                aria-label="Sichere Cloud-Infrastruktur"
              ></video>
            </div>
          </article>

          <!-- Zertifizierungen Card (Wiederhergestellt in vollem Umfang) -->
          <article class="lg:col-span-6 bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-10 hover:border-meg-accent/30 transition-all duration-500 group shadow-lg">
            <div class="flex flex-col md:flex-row gap-12 items-center">
              <div class="flex-1">
                <span class="text-meg-accent font-bold uppercase tracking-[0.2em] text-xs mb-4 block">Garantierte Qualität</span>
                <h3 class="text-3xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
                  Profitieren Sie von <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">zertifizierter</span> Expertise
                </h3>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 text-meg-text-secondary">
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-circle-check text-meg-accent mt-1"></i>
                    <span><strong>Professional Scrum Master II:</strong> Fortgeschrittene agile Führung für komplexe Projekte.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-circle-check text-meg-accent mt-1"></i>
                    <span><strong>Professional Scrum Product Owner I:</strong> Strategisches Backlog-Management & Business-Value.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-circle-check text-meg-accent mt-1"></i>
                    <span><strong>IHK Ausbilder:</strong> Zertifizierte Qualität in der Wissensvermittlung für Fachinformatiker.</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <i class="fa-solid fa-circle-check text-meg-accent mt-1"></i>
                    <span><strong>10+ Jahre Full-Stack:</strong> Tiefgreifendes Verständnis der gesamten IT-Lieferkette.</span>
                  </li>
                </ul>
              </div>
              <div class="w-full md:w-1/3 rounded-2xl overflow-hidden shadow-2xl border border-meg-border-dark/50">
                <video 
                  src="/videos/video_certification.mp4" 
                  poster="/videos/video_certification-poster.webp" 
                  loop muted playsinline autoplay 
                  class="w-full h-auto"
                ></video>
              </div>
            </div>
          </article>

        </div>
      </div>
    </section>

    <PortfolioTop />
    <Testimonials />
    <PriceService />
    <Blog limits={6} />
    <FreeTools />
    <SkillWrapper />
    <SuiteClaim />
  </main>
</Layout>