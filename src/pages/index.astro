---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { SchemaUtils } from '../utils/schema';
import HeroBackground from '../components/HeroBackground.astro';
import PortfolioTop from '../components/PortfolioTop.astro';
import PriceService from '../components/PriceService.astro';
import Blog from '../components/Blog.astro';
import EcodriveClaim from '../components/EcodriveClaim.astro';
import PriceEcodrive from '../components/PriceEcodrive.astro';
import SkillWrapper from '../components/SkillWrapper.astro';
import type { Fragment } from 'astro/runtime/server/index.js';
import PriceSilvacore from '../components/PriceSilvacore.astro';
import PriceSocialverse from '../components/PriceSocialverse.astro';
import SilvacoreClaim from '../components/SilvacoreClaim.astro';
import SocialverseClaim from '../components/SocialverseClaim.astro';
import AetherClaim from '../components/AetherClaim.astro';
import WaetherappClaim from '../components/WaetherappClaim.astro';
import TrackedButton from '../components/TrackedButton.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}]);

// Organization Schema
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Waldheim.dev',
  url: 'https://waldheim.dev',
  logo: 'https://waldheim.dev/waldheim.dev.svg',
  description: 'IT-Dienstleistungen für KMU, Vereine & Startups: DevSecOps, Webentwicklung, Design, IT-Service, Smart Home',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Kundenservice',
    email: 'kontakt@waldheim.dev'
  },
  areaServed: ['Augsburg', 'München', 'Bayern', 'DE', 'AT', 'CH']
};

// WebSite Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'waldheim.dev',
  url: 'https://waldheim.dev',
  description: 'Professionelle IT-Dienstleistungen: DevSecOps, Webentwicklung, Design, IT-Service',
  publisher: {
    '@type': 'Organization',
    name: 'waldheim.dev'
  }
};

const titel = 'Waldheim.dev: IT-Lösungen & Beratung | Augsburg';
const description = 'Waldheim.dev: Ihr Partner für DevSecOps, Webentwicklung und IT-Service in Augsburg & München. Professionelle Qualität zum fairen Preis. Jetzt beraten lassen!';
const keywords = 'IT-Dienstleistungen, Augsburg, München, DevSecOps, Webentwicklung, IT-Service, Verbandssoftware, Softwareentwicklung, IT Beratung, KMU, Vereine, Startups, Cloud, Smart Home';

const ogImage = 'https://waldheim.dev/waldheim-dev-og.jpg';
---

<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[organizationSchema, websiteSchema, breadCrumbSchema]}
  image={ogImage}
>
  <HeroBackground title="Nachhaltige IT-Lösungen aus einer Hand"
                  subtitle="Von DevSecOps über Webentwicklung bis zum Smart Home – ich begleite Sie digital. Für Unternehmen & Verbände im Raum Augsburg/München."

                  video="/videos/video_chip.mp4">
    <div class="mt-10 flex items-center justify-center flex-wrap gap-x-6">
      <TrackedButton
        href="/kontakt/"
        trackEvent="cta_homepage_contact"
        trackCategory="hero"
        trackLabel="Jetzt beraten lassen"
        variant="primary"
        icon="fa-solid fa-envelope animate-pulse"
        iconPosition="left"
      >
        Jetzt beraten lassen
      </TrackedButton>
      <TrackedButton
        href="/referenzen/1/"
        trackEvent="cta_homepage_references"
        trackCategory="hero"
        trackLabel="Referenzen"
        variant="secondary"
        icon="fa-solid fa-arrow-right"
      >
        Referenzen
      </TrackedButton>
    </div>
  </HeroBackground>

  <div>
    <main>

      <section class="bento-service relative isolate">
        <div class="mx-auto max-w-7xl px-6 pb-32 pt-36 sm:pt-60 lg:px-8 lg:pt-32 bento-grid grid lg:grid-cols-6 sm:grid-cols-6 grid-cols-1 gap-4 grid-flow-row">
          <!-- Main Principles Card -->
          <div class="relative lg:row-span-2 sm:row-span-2 lg:col-span-3 sm:col-span-3 col-span-1 group">
            <div class="bento-card gsap-fadein relative h-full">
              <div class="absolute -inset-0.5 bg-gradient-to-r from-meg-accent to-sky-600 rounded-2xl blur opacity-10 group-hover:opacity-30 transition duration-500" />
              <div class="flex flex-col gap-4 justify-between h-full z-10 relative bg-meg-surface-dark/50 backdrop-blur-xl text-meg-text-primary-dark p-10 shadow-sm rounded-2xl border border-meg-border-dark hover:border-meg-accent/30 transition-all duration-300">
                <div class="flex flex-col gap-4">
                  <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">
                    So arbeite ich: Meine <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Prinzipien</span> für Ihren Erfolg
                  </h2>
                  <p class="relative mt-4 text-lg leading-8 sm:max-w-md lg:max-w-none text-meg-text-secondary">
                    Von der ersten Beratung bis zur finalen Umsetzung – ich stehe für Qualität, Transparenz und Kundenorientierung.
                  </p>
                  <ul role="list" class="mt-6 space-y-4">
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-meg-text-primary-dark">Qualität:</strong> Ich liefere ausschließlich Ergebnisse, die meinen hohen Ansprüchen genügen.</span>
                    </li>
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-meg-text-primary-dark">Zuverlässigkeit:</strong> Auf meine IT-Lösungen und meinen Support können Sie zählen.</span>
                    </li>
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-meg-text-primary-dark">Nachvollziehbarkeit:</strong> Alle Schritte werden detailliert dokumentiert.</span>
                    </li>
                    <li class="flex gap-x-3 items-start">
                      <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                      <span><strong class="font-semibold text-meg-text-primary-dark">Passgenauigkeit:</strong> Ich entwickle Lösungen, die perfekt zu Ihren Anforderungen passen.</span>
                    </li>
                  </ul>
                </div>
                <Image 
                  src="/bento/cert.webp" 
                  alt="Qualität bei Waldheim.dev" 
                  class="rounded-xl opacity-90 group-hover:opacity-100 transition-opacity duration-300" 
                  width={600} 
                  height={546}
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            </div>
          </div>
          <!-- DevSecOps Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 sm:col-span-3 col-span-1 bg-meg-surface-dark/50 backdrop-blur-xl text-meg-text-primary-dark border border-meg-border-dark rounded-2xl overflow-hidden p-10 shadow-sm hover:border-violet-500/40 hover:shadow-lg hover:shadow-violet-500/5 transition-all duration-300 group">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>DevSecOps</span> für schnellere & sichere Entwicklung
                </h3>
                <p class="relative mb-6 text-lg text-meg-text-secondary sm:max-w-md lg:max-w-none">
                  Ich automatisiere Ihre Entwicklungspipeline, integriere Sicherheit von Anfang an und verkürze Ihre Release-Zyklen.
                </p>
                <TrackedButton
                  href="/services/devsecops/"
                  trackEvent="cta_service_devsecops"
                  trackCategory="service_card"
                  trackLabel="DevSecOps Services"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full group-hover:bg-violet-500/10 group-hover:border-violet-500/30 group-hover:text-violet-400 transition-all"
                >
                  Zu meinen DevSecOps-Services
                </TrackedButton>
              </div>
              <figure class="w-full rounded-xl overflow-hidden mt-6 ring-1 ring-meg-border-dark group-hover:ring-violet-500/30 transition-all">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1920"
                  height="1080"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_devsecops-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  src="/videos/video_devsecops.mp4"
                >
                  <source src="/videos/video_devsecops.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>

          <!-- Entwicklung Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 sm:col-span-3 col-span-1 bg-meg-surface-dark/50 backdrop-blur-xl text-meg-text-primary-dark border border-meg-border-dark rounded-2xl overflow-hidden p-10 shadow-sm hover:border-meg-accent/40 hover:shadow-lg hover:shadow-meg-accent/5 transition-all duration-300 group">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  Individuelle <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Softwarelösungen</span> für Ihren Bedarf
                </h3>
                <p class="relative mb-6 text-lg text-meg-text-secondary sm:max-w-md lg:max-w-none">
                  Ich entwickle Webanwendungen, Tools und maßgeschneiderte Software, die perfekt zu Ihren Prozessen passt.
                </p>
                <TrackedButton
                  href="/services/entwicklung/"
                  trackEvent="cta_service_development"
                  trackCategory="service_card"
                  trackLabel="Projekt anfragen"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full group-hover:bg-meg-accent/10 group-hover:border-meg-accent/30 group-hover:text-meg-accent transition-all"
                >
                  Jetzt Projekt anfragen
                </TrackedButton>
              </div>
              <figure class="w-full rounded-xl overflow-hidden mt-6 ring-1 ring-meg-border-dark group-hover:ring-meg-accent/30 transition-all">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1920"
                  height="1080"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_software-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  src="/videos/video_software.mp4"
                >
                  <source src="/videos/video_software.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>

          <!-- Design Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 md:col-span-3 sm:col-span-3 col-span-1 bg-meg-surface-dark/50 backdrop-blur-xl text-meg-text-primary-dark border border-meg-border-dark rounded-2xl overflow-hidden p-10 shadow-sm hover:border-rose-500/40 hover:shadow-lg hover:shadow-rose-500/5 transition-all duration-300 group">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500'>Branding, Webdesign & UX</span> – aus einem Guss
                </h3>
                <p class="relative mb-6 text-lg text-meg-text-secondary sm:max-w-md lg:max-w-none">
                  Ich entwickle ganzheitliche Designlösungen, die Ihre Marke stärken und Ihre Zielgruppe überzeugen.
                </p>
                <TrackedButton
                  href="/services/design/"
                  trackEvent="cta_service_design"
                  trackCategory="service_card"
                  trackLabel="Design-Philosophie"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full group-hover:bg-rose-500/10 group-hover:border-rose-500/30 group-hover:text-rose-400 transition-all"
                >
                  Design-Philosophie entdecken
                </TrackedButton>
              </div>
              <figure class="w-full rounded-xl overflow-hidden mt-6 ring-1 ring-meg-border-dark group-hover:ring-rose-500/30 transition-all">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1280"
                  height="720"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_design-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  aria-label="Moderne Webdesign-Prozesse und UI-Komponenten"
                  src="/videos/video_design.mp4"
                >
                  <source src="/videos/video_design.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>
          <!-- IT-Service / Cloud Card -->
          <div class="bento-card gsap-fadein lg:col-span-3 md:col-span-3 sm:col-span-3 col-span-1 bg-meg-surface-dark/50 backdrop-blur-xl text-meg-text-primary-dark border border-meg-border-dark rounded-2xl overflow-hidden p-10 shadow-sm hover:border-emerald-500/40 hover:shadow-lg hover:shadow-emerald-500/5 transition-all duration-300 group">
            <div class="flex flex-col gap-4 justify-between h-full">
              <div class="flex flex-col items-start gap-2">
                <h3 class="text-lg font-bold tracking-tight sm:text-xl">
                  Sichere <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-500'>Cloud-Lösungen</span> & IT-Service
                </h3>
                <p class="relative mb-6 text-lg text-meg-text-secondary">
                  Ich migriere Ihre IT in die Cloud, sorge für maximale Sicherheit und ermögliche ortsunabhängiges Arbeiten.
                </p>
                <TrackedButton
                  href="/services/it-service/"
                  trackEvent="cta_service_it"
                  trackCategory="service_card"
                  trackLabel="Cloud-Services"
                  variant="ghost"
                  icon="fa-solid fa-arrow-right"
                  class="!px-4 !py-2 !rounded-full group-hover:bg-emerald-500/10 group-hover:border-emerald-500/30 group-hover:text-emerald-400 transition-all"
                >
                  Mehr über Cloud-Services
                </TrackedButton>
              </div>
              <figure class="w-full rounded-xl overflow-hidden mt-6 ring-1 ring-meg-border-dark group-hover:ring-emerald-500/30 transition-all">
                <video 
                  class="object-contain max-sm:max-w-none w-full" 
                  width="1280"
                  height="720"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_cloud-security-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  aria-label="Sichere Cloud-Infrastruktur mit Sicherheits-Shields und Datenströmen"
                  src="/videos/video_cloud-security.mp4"
                >
                  <source src="/videos/video_cloud-security.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>
          
          <!-- Certifications Card -->
          <div class="bento-card gsap-fadein lg:col-span-6 sm:col-span-6 col-span-1 bg-meg-surface-dark/50 backdrop-blur-xl text-meg-text-primary-dark border border-meg-border-dark rounded-2xl overflow-hidden p-10 shadow-sm hover:border-meg-accent/30 transition-all duration-300 group">
            <div class="flex md:flex-row flex-col gap-8 justify-between items-start">
              <div class="flex flex-col flex-1 gap-4">
                <p class="text-base font-semibold text-meg-accent">
                  <i class='fa-solid fa-award text-meg-accent mr-2' aria-hidden='true'></i>
                  Ihr Vorteil: Zertifiziertes Know-how
                </p>
                <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">
                  Profitieren Sie von meiner <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Expertise</span> in agilen Methoden
                </h3>
                <ul role="list" class="mt-4 space-y-4 text-meg-text-secondary">
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Professional <strong class="font-semibold text-meg-text-primary-dark">Scrum Master I.</strong> (PSM I) - Scrum.org</span>
                  </li>
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Professional <strong class="font-semibold text-meg-text-primary-dark">Scrum Master II.</strong> (PSM II) - Scrum.org</span>
                  </li>
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Professional <strong class="font-semibold text-meg-text-primary-dark">Scrum Product Owner I.</strong> (PSPO I.) - Scrum.org</span>
                  </li>
                  <li class="flex gap-x-3 items-start">
                    <i class="fa-solid fa-check-circle text-meg-accent text-xl mt-0.5" aria-hidden="true"></i>
                    <span>Ausbilder (IHK) <strong class="font-semibold text-meg-text-primary-dark">Ausbilder für Fachinformatik.</strong></span>
                  </li>
                </ul>
              </div>
              <figure class="w-full md:w-auto rounded-xl overflow-hidden m-[auto] ring-1 ring-meg-border-dark group-hover:ring-meg-accent/30 transition-all">
                <video 
                  class="object-contain w-full md:w-[400px]" 
                  width="1920"
                  height="1080"
                  style="aspect-ratio: 16/9;"
                  preload="none" 
                  poster="/videos/video_certification-poster.webp" 
                  loop 
                  muted 
                  playsinline
                  autoplay
                  src="/videos/video_certification.mp4"
                >
                  <source src="/videos/video_certification.mp4" type="video/mp4" />
                </video>
              </figure>
            </div>
          </div>
        </div>
      </section>
      <PortfolioTop />
      <PriceService />

      <Blog limits={6} />
      <SkillWrapper />

      <EcodriveClaim />
      <PriceEcodrive />

      <SocialverseClaim />
      <PriceSocialverse />

      <SilvacoreClaim />
      <PriceSilvacore />

      <AetherClaim />

      <WaetherappClaim />
    </main>
  </div>
</Layout>
