      </div>
      </div>
      <div class='bento-card lg:col-span-1 md:col-span-2 sm:col-span-3 col-span-1 bg-gradient-to-br from-amber-100 to-amber-200 dark:from-amber-500 dark:to-amber-700 rounded-3xl overflow-hidden p-12 text-slate-800  shadow-lg'>
        <div class='flex flex-col gap-4 justify-between h-full'>
          <div class='flex flex-col items-start gap-2'>
          <h3 class='text-lg -mt-2 font-bold tracking-tight text-slate-800 dark:text-gray-50 sm:text-xl'>
