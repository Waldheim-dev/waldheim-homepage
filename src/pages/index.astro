                  >
                </li>
              </ul>
            </div>
            <img
              src="/bento/cert.webp"
              loading="lazy"
              alt="Qualität bei Waldheim.dev"
            />
          </div>
        </div>
      </div>
      <div
        class="bento-card lg:col-span-1 sm:col-span-6 col-span-1 bg-gradient-to-tr from-wd-400 to-wd-500 dark:from-wd-500 dark:to-wd-800 rounded-3xl text-white overflow-hidden p-12 shadow-lg"
