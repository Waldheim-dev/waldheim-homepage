                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
                <span><strong class="font-semibold text-white">Kundenorientiert.</strong> An Ihre Wünsche angepasst</span>
              </li>
            </ul>
          </div>
          <img src='/bento/cert.webp' loading='lazy' alt='Qualität bei Waldheim.dev'>
        </div>
      </div>
      <div
        class='bento-card lg:col-span-1 sm:col-span-6 col-span-1 bg-gradient-to-tr from-teal-500 to-teal-600 dark:from-teal-600 dark:to-teal-800 rounded-3xl text-white overflow-hidden p-12  shadow-lg'>

