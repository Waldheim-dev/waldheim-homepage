              </p>
              <TrackedButton
                href="/services/smarthome/"
                variant="ghost"
                icon="fa-solid fa-arrow-right"
                class="group-hover:text-orange-400"
                trackEvent="cta_service_smarthome"
                trackCategory="service_card"
                trackLabel="Smart Home Details"
              >
                Gebäude automatisieren
              </TrackedButton>
            </div>
            <div
              class="relative mt-8 rounded-xl overflow-hidden transition-all duration-700"
            >
              <video
                data-src="/videos/video_smarthome.mp4"
                data-poster="/videos/video_smarthome-poster.webp"
                preload="none"
                loop
                muted
                playsinline
                class="lazy-video w-full aspect-video object-cover"
                aria-label="Smart Home Automation und Gebäudesicherheit"
              ></video>
              <AiImageBadge class="absolute bottom-2.5 right-2.5 z-10" />
