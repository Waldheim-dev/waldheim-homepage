      <div class='bento-card lg:col-span-4 sm:col-span-6 col-span-1 bg-gradient-to-l from-gray-300 to-slate-300 dark:from-gray-400 dark:to-slate-500 rounded-3xl overflow-hidden p-12  text-slate-800 shadow-lg'>
