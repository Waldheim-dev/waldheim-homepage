---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';
import SocialverseScreenshots from '../../components/SocialverseScreenshots.astro';
import SocialverseFeatures from '../../components/SocialverseFeatures.astro';
import SocialverseComparison from '../../components/SocialverseComparison.astro';
import PriceSocialverse from '../../components/PriceSocialverse.astro';

const product = getProductInfo('socialverse')!;

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Socialverse',
  link: 'https://waldheim.dev/socialverse'
}]);

const titel = "Socialverse: AI-CRM & Marketing-Automation made in Germany | waldheim.dev";
const description = "Socialverse: DSGVO-konforme Lead-Generierung und Marketing-Automation mit KI. Automatisierte Kampagnen, Lead-Scoring und Multi-Channel-Integration für moderne Unternehmen.";
const keywords = "Socialverse, CRM, Marketing-Automation, AI, Lead-Generierung, DSGVO, GPT-4, Social Media, Campaign Management, Lead-Scoring, KI-Marketing";

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder',
    priceValidUntil: '2026-03-31'
  },
  softwareVersion: product.version,
  releaseNotes: 'Closed Beta - Early Bird 50% Rabatt',
  description: description,
  url: 'https://waldheim.dev/socialverse',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  featureList: 'AI-gestützte Lead-Generierung, Marketing-Automation, DSGVO-konform, Multi-Channel-Integration'
};

const ogImage = 'https://waldheim.dev/socialverse/socialverse.svg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <div class='relative isolate pt-14'>
    <!-- Background Gradient (Purple/Pink) -->
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-purple-500 to-pink-500 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>

    <div class='py-24 sm:py-32 lg:pb-40'>
      <div class='mx-auto max-w-7xl px-6 lg:px-8'>
        <div class='mx-auto max-w-3xl text-center'>
          <!-- Closed Beta Badge -->
          <div class='mt-24 sm:mt-32 lg:mt-16 gsap-fadein'>
            <span class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/30 text-sm font-medium text-purple-300'>
              <i class='fa-solid fa-flask' aria-hidden='true'></i>
              Closed Beta – Q1 2026
              <span class='bg-purple-500 text-white px-2 py-0.5 rounded-full text-xs font-bold'>50% Early Bird</span>
            </span>
          </div>

          <!-- Hero Title with Gradient -->
          <h1 class='text-5xl md:text-7xl font-bold tracking-tight text-white mt-6 gsap-fadein' style='animation-delay: 0.1s'>
            AI-CRM & Marketing-<br />
            <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-500'>Automation</span>
          </h1>

          <p class='mt-6 text-xl leading-8 text-light-300 gsap-fadein max-w-2xl mx-auto' style='animation-delay: 0.2s'>
            Lead-Generierung mit <strong class='text-white'>KI-Scoring</strong>, automatisierte Multi-Channel-Kampagnen und <strong class='text-white'>GPT-4 Content-Generierung</strong>. 
            DSGVO-konform <span class='text-purple-400'>made in Germany 🇩🇪</span>
          </p>

          <!-- Hero CTAs -->
          <div class='mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 gsap-fadein' style='animation-delay: 0.3s'>
            <a
              href='https://portal.waldheim.dev'
              target='_blank'
              rel='noopener noreferrer'
              class='group px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white font-bold text-lg rounded-lg hover:shadow-lg hover:shadow-purple-500/50 transition-all duration-300 inline-flex items-center gap-2'
            >
              <i class='fa-solid fa-user-plus' aria-hidden='true'></i>
              Beta-Zugang anfragen
              <i class='fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform' aria-hidden='true'></i>
            </a>
                        <a
              href='/socialverse/#features'
              class='px-8 py-4 bg-light-500/10 text-white border border-light-500/30 rounded-lg font-semibold hover:bg-light-500/20 transition-all duration-300'
            >
              Features entdecken
              <i class='fa-solid fa-arrow-down animate-bounce' aria-hidden='true'></i>
            </a>
          </div>
        </div>

        <!-- Hero Dashboard Screenshot with Gradient Glow -->
        <div class='relative isolate mt-16 sm:mt-24 gsap-fadein' style='animation-delay: 0.4s'>
          <div class='absolute -inset-4 bg-gradient-to-r from-purple-500 to-pink-500 rounded-2xl blur-xl opacity-20 group-hover:opacity-30 transition-opacity'></div>
          <Image
            src='/socialverse/socialverse_dashboard.webp'
            alt="Socialverse AI-Dashboard mit Lead-Scoring und Campaign Analytics"
            width={1200}
            height={800}
            class='relative z-10 rounded-xl bg-dark-950/50 shadow-2xl ring-1 ring-purple-500/20 w-full'
          />
        </div>
      </div>
    </div>

    <!-- Bottom Gradient -->
    <div class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]' aria-hidden='true'>
      <div
        class='relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-purple-500 to-pink-500 opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'>
      </div>
    </div>
  </div>

  <!-- Screenshot Showcase -->
  <div id='features'>
    <SocialverseScreenshots />
  </div>

  <!-- Features & Roadmap -->
  <SocialverseFeatures />

  <!-- Comparison -->
  <SocialverseComparison />

  <!-- Pricing -->
  <PriceSocialverse />
</Layout>
