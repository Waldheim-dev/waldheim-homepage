---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';
import TailwindCVHero from '../../components/TailwindCVHero.astro';
import TailwindCVFeatures from '../../components/TailwindCVFeatures.astro';

const product = getProductInfo('tailwind-cv')!;

const titel = 'CV Generator | Kostenloser Open-Source Lebenslauf-Builder mit Tailwind CSS v4';
const description = 'Professionellen Lebenslauf im Browser erstellen, gestalten und als A4-PDF exportieren. CV Generator mit Tailwind CSS v4, Vite, 13 Layouts, 10 Farbthemen — komplett Open Source und kostenlos.';
const keywords = 'CV Builder, Lebenslauf erstellen, Tailwind CSS, Open Source, PDF Export, Resume Builder, kostenlos, A4, Vite';
const ogImage = 'https://waldheim.dev/tailwind-cv/tailwind-cv-og.jpg';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CV Generator',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (Browser-based)',
  description,
  softwareVersion: product.version,
  url: 'https://waldheim.dev/tailwind-cv',
  downloadUrl: 'https://github.com/mwaldheim/tailwind-cv',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev',
  },
  license: 'https://opensource.org/licenses/MIT',
};

const breadcrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'tailwind-cv', link: 'https://waldheim.dev/tailwind-cv' },
]);
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[softwareSchema, breadcrumbSchema]}
  image={ogImage}
>
  <main id="main-content">
    <TailwindCVHero />
    <TailwindCVFeatures />

    <!-- Final CTA -->
    <section class="py-24 px-6 bg-meg-surface-dark border-b border-meg-border-dark">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
          Bereit für deinen <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-teal-400">neuen Lebenslauf?</span>
        </h2>
        <p class="text-lg text-meg-text-secondary mb-10 max-w-xl mx-auto">
          tailwind-cv ist MIT-lizenziert und auf GitHub verfügbar. Klone, ändere, nutze —
          keine Anmeldung, keine Kosten, keine Daten die uns gehören.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://mwaldheim.github.io/tailwind-cv/"
            target="_blank"
            rel="noopener noreferrer"
            class="group px-8 py-4 bg-cyan-500 text-white font-bold text-lg rounded-xl hover:bg-cyan-400 hover:shadow-xl hover:shadow-cyan-500/30 transition-all duration-300 hover:scale-[1.02] inline-flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-play text-lg"></i>
            Live Demo starten
          </a>
          <a
            href="https://github.com/mwaldheim/tailwind-cv"
            target="_blank"
            rel="noopener noreferrer"
            class="group px-8 py-4 bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-cyan-500/40 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <i class="fa-brands fa-github text-cyan-400 text-xl"></i>
            GitHub Repository
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
