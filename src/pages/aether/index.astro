---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';
import AetherHero from '../../components/AetherHero.astro';
import AetherFeatures from '../../components/AetherFeatures.astro';
import AetherPricing from '../../components/AetherPricing.astro';
import AetherFAQ from '../../components/AetherFAQ.astro';
import AetherClaim from '../../components/AetherClaim.astro';
import AetherCTA from '../../components/AetherCTA.astro';

const product = getProductInfo('aether')!;

// SEO & Meta
const titel = 'Aether | High-Performance Cloud-Infrastruktur & Hosting';
const description = 'Skalierbare Cloud-Lösungen für Enterprise-Anforderungen. Aether bietet maximale Performance, Low-Latency & höchste Sicherheitsstandards für Ihr Business.';
const keywords = 'Cloud Hosting Deutschland, High Performance Cloud, skalierbare Infrastruktur, Enterprise Hosting Bayern, Low Latency Server, Cloud Native Architektur';
const ogImage = 'https://waldheim.dev/aether/aether-og.jpg';

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Aether Cloud Infrastructure',
  'applicationCategory': 'InfrastructureSoftware',
  'operatingSystem': 'Cloud',
  'description': 'Hochperformante Cloud-Infrastruktur für skalierbare Web-Anwendungen und Microservices.',
  'author': {
    '@type': 'Organization',
    'name': 'Waldheim.dev',
    'url': 'https://waldheim.dev'
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Aether',
  link: 'https://waldheim.dev/aether'
}]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <main id="main-content">
    <!-- Hero: Fokus auf Performance & Skalierung -->
    <AetherHero />

    <!-- Value Proposition -->
    <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark" aria-labelledby="aether-value-heading">
      <div class="mx-auto max-w-7xl">
        <header class="mx-auto max-w-2xl text-center mb-16">
          <h2 id="aether-value-heading" class="text-sm font-bold uppercase tracking-widest text-sky-400 mb-4">
            Next-Gen Hosting
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Power für Ihre <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-indigo-500">Applikationen</span>
          </p>
          <p class="text-xl text-meg-text-secondary">
            Aether ist das Fundament für geschäftskritische Anwendungen, die keine Kompromisse bei der Geschwindigkeit dulden.
          </p>
        </header>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-sky-500/40 transition-all group">
            <i class="fa-solid fa-gauge-high text-sky-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Ultra-Low Latency</h3>
            <p class="text-meg-text-secondary text-sm">Optimierte Routing-Pfade und modernste Hardware für Antwortzeiten im Millisekunden-Bereich.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-sky-500/40 transition-all group">
            <i class="fa-solid fa-up-right-and-down-left-from-center text-sky-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Auto-Scaling</h3>
            <p class="text-meg-text-secondary text-sm">Ihre Infrastruktur wächst automatisch mit Ihrem Traffic – ohne manuelle Eingriffe und Ausfallzeiten.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-sky-500/40 transition-all group">
            <i class="fa-solid fa-shield-halved text-sky-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Enterprise Security</h3>
            <p class="text-meg-text-secondary text-sm">Integrierter DDoS-Schutz, WAF und isolierte Netzwerk-Umgebungen für maximale Sicherheit.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-sky-500/40 transition-all group">
            <i class="fa-solid fa-cloud-sun text-sky-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Green Hosting</h3>
            <p class="text-meg-text-secondary text-sm">Betrieb in CO2-neutralen Rechenzentren mit 100% Ökostrom – Nachhaltigkeit inklusive.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Components -->
    <AetherClaim />
    <AetherFeatures />
    <AetherPricing />
    
    <div class="bg-meg-bg-dark py-24">
      <AetherFAQ />
    </div>

    <AetherCTA />
  </main>
</Layout>