---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import AetherHero from '../../components/AetherHero.astro';
import AetherFeatures from '../../components/AetherFeatures.astro';
import AetherPricing from '../../components/AetherPricing.astro';
import AetherFAQ from '../../components/AetherFAQ.astro';
import AetherCTA from '../../components/AetherCTA.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  {
    name: 'Home',
    link: 'https://waldheim.dev'
  },
  {
    name: 'Aether',
    link: 'https://waldheim.dev/aether'
  }
]);

const titel = 'Aether – High-Performance Data Transmission | waldheim.dev';
const description = 'Sicherer, schneller Dateitransfer ohne Spuren. Von 100 MB (kostenlos) bis 50 GB (Enterprise). Hosting in Deutschland. DSGVO-konform.';
const keywords = 'Dateitransfer, File Sharing, Secure Upload, DSGVO, Deutschland, Developer Tools, CDN, Verschlüsselung, Auto-Burn, Reality Stone';

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Aether',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: [
    {
      '@type': 'Offer',
      name: 'Particle (Free)',
      price: '0',
      priceCurrency: 'EUR',
      billingDuration: 'P1M'
    },
    {
      '@type': 'Offer',
      name: 'Wave',
      price: '8',
      priceCurrency: 'EUR',
      billingDuration: 'P1M'
    },
    {
      '@type': 'Offer',
      name: 'Matter',
      price: '24',
      priceCurrency: 'EUR',
      billingDuration: 'P1M'
    }
  ],
  softwareVersion: '1.0.0',
  releaseNotes: 'Closed Beta - High-Performance Data Transmission',
  description: description,
  url: 'https://waldheim.dev/aether',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  featureList: 'Dateitransfer, TLS 1.3, CDN, Multi-Link, Auto-Burn, DSGVO-konform, Passwortschutz'
};

const ogImage = '/products/aether-og.jpg';
---

<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <AetherHero />
  
  <!-- Intro Section -->
  <section class='py-16 px-6 bg-gradient-to-b from-dark-950 to-dark-900'>
    <div class='mx-auto max-w-4xl'>
      <div class='gsap-fadein prose prose-invert prose-lg max-w-none'>
        <p class='text-xl text-light-300 leading-relaxed text-center'>
          Aether ist unser neuer Dienst für schnellen, sicheren und mystischen Dateitransfer. 
          Entwickelt für Developer, Kreative und Profis, die Dateien ohne Umwege teilen wollen – 
          von flüchtigen Momenten bis zu langfristigen Archiven.
        </p>
      </div>
    </div>
  </section>

  <AetherPricing />
  
  <!-- Pricing Table -->
  <section id='pricing-comparison' class='py-16 px-6 bg-gradient-to-b from-dark-950 to-dark-900'>
    <div class='mx-auto max-w-6xl'>
      <div class='text-center mb-12'>
        <h2 class='gsap-fadein text-3xl md:text-4xl font-bold text-white mb-4'>
          Detaillierter <span class='text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-500'>Vergleich</span>
        </h2>
        <p class='gsap-fadein text-lg text-light-300' style='animation-delay: 0.15s'>
          Alle Features im Überblick
        </p>
      </div>

      <div class='gsap-fadein overflow-x-auto' tabindex='0' role='region' aria-label='Aether Pricing Vergleichstabelle' style='animation-delay: 0.3s'>
        <table class='w-full text-left border-collapse'>
          <thead class='bg-dark-800'>
            <tr>
              <th class='px-6 py-4 text-light-100 font-semibold border-b border-red-500/20'>Feature</th>
              <th class='px-6 py-4 text-light-100 font-semibold border-b border-red-500/20 text-center'>Particle</th>
              <th class='px-6 py-4 text-light-100 font-semibold border-b border-red-500/20 text-center bg-red-900/20'>Wave</th>
              <th class='px-6 py-4 text-light-100 font-semibold border-b border-red-500/20 text-center'>Matter</th>
            </tr>
          </thead>
          <tbody>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>Max. Dateigröße</td>
              <td class='px-6 py-4 text-center text-white font-semibold'>100 MB</td>
              <td class='px-6 py-4 text-center text-white font-semibold bg-red-900/10'>5 GB</td>
              <td class='px-6 py-4 text-center text-white font-semibold'>50 GB</td>
            </tr>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>Speicherdauer</td>
              <td class='px-6 py-4 text-center text-white font-semibold'>24 Stunden</td>
              <td class='px-6 py-4 text-center text-white font-semibold bg-red-900/10'>30 Tage</td>
              <td class='px-6 py-4 text-center text-white font-semibold'>1 Jahr</td>
            </tr>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>Links pro Datei</td>
              <td class='px-6 py-4 text-center text-white font-semibold'>1</td>
              <td class='px-6 py-4 text-center text-white font-semibold bg-red-900/10'>10</td>
              <td class='px-6 py-4 text-center text-white font-semibold'>50</td>
            </tr>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>Passwortschutz</td>
              <td class='px-6 py-4 text-center'>
                <i class='fa-solid fa-xmark text-light-600' aria-label='Nicht enthalten'></i>
              </td>
              <td class='px-6 py-4 text-center bg-red-900/10'>
                <i class='fa-solid fa-check text-red-400' aria-label='Enthalten'></i>
              </td>
              <td class='px-6 py-4 text-center'>
                <i class='fa-solid fa-check text-red-400' aria-label='Enthalten'></i>
              </td>
            </tr>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>Link-Widerruf</td>
              <td class='px-6 py-4 text-center'>
                <i class='fa-solid fa-xmark text-light-600' aria-label='Nicht enthalten'></i>
              </td>
              <td class='px-6 py-4 text-center bg-red-900/10'>
                <i class='fa-solid fa-check text-red-400' aria-label='Enthalten'></i>
              </td>
              <td class='px-6 py-4 text-center'>
                <i class='fa-solid fa-check text-red-400' aria-label='Enthalten'></i>
              </td>
            </tr>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>Echtzeit-Tracking</td>
              <td class='px-6 py-4 text-center'>
                <i class='fa-solid fa-xmark text-light-600' aria-label='Nicht enthalten'></i>
              </td>
              <td class='px-6 py-4 text-center bg-red-900/10'>
                <i class='fa-solid fa-check text-red-400' aria-label='Enthalten'></i>
              </td>
              <td class='px-6 py-4 text-center'>
                <i class='fa-solid fa-check text-red-400' aria-label='Enthalten'></i>
              </td>
            </tr>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>Support</td>
              <td class='px-6 py-4 text-center text-light-400'>Community</td>
              <td class='px-6 py-4 text-center text-white font-semibold bg-red-900/10'>E-Mail</td>
              <td class='px-6 py-4 text-center text-white font-semibold'>Premium</td>
            </tr>
            <tr class='border-b border-red-500/10 hover:bg-dark-900/30 transition-colors'>
              <td class='px-6 py-4 text-light-300'>API-Zugriff</td>
              <td class='px-6 py-4 text-center'>
                <i class='fa-solid fa-xmark text-light-600' aria-label='Nicht enthalten'></i>
              </td>
              <td class='px-6 py-4 text-center bg-red-900/10'>
                <span class='text-xs text-light-500'>Q1 2026</span>
              </td>
              <td class='px-6 py-4 text-center'>
                <span class='text-xs text-light-500'>Q1 2026</span>
              </td>
            </tr>
            <tr class='bg-dark-800/50'>
              <td class='px-6 py-5 text-light-100 font-bold'>Preis</td>
              <td class='px-6 py-5 text-center'>
                <span class='text-2xl font-bold text-white'>Kostenlos</span>
              </td>
              <td class='px-6 py-5 text-center bg-red-900/20'>
                <span class='text-2xl font-bold text-white'>€8</span>
                <span class='text-light-400 text-sm block'>/Monat</span>
              </td>
              <td class='px-6 py-5 text-center'>
                <span class='text-2xl font-bold text-white'>€24</span>
                <span class='text-light-400 text-sm block'>/Monat</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <AetherFeatures />
  <AetherFAQ />
  <AetherCTA />
</Layout>
