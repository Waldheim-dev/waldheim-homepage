---
import { SchemaUtils } from '../../utils/schema';
import Layout from '../../layouts/Layout.astro';
import HeroMetric from '../../components/HeroMetric.astro';
import CTASoft from '../../components/CTASoft.astro';
import SkillWrapper from '../../components/SkillWrapper.astro';
import { getCollection } from 'astro:content';
import Karriere from '../../components/Karriere.astro';

// SEO & Meta
const titel = 'Über Markus Waldheim | Senior IT-Consultant & DevSecOps Experte';
const description = '10+ Jahre IT-Erfahrung, zertifizierter Professional Scrum Master II (PSM II) & Ausbilder. Erfahren Sie mehr über meine Vision für effiziente Softwareentwicklung.';
const keywords = 'Markus Waldheim, IT-Consultant Augsburg, Scrum Master München, DevSecOps Experte Bayern, IT-Ausbilder, Software-Architekt, Agile Transformation';
const ogImage = 'https://waldheim.dev/markus/markus-og.jpg';

// Structured Data: Person
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  'name': 'Markus Waldheim',
  'url': 'https://waldheim.dev/ueber-mich',
  'image': 'https://waldheim.dev/markus/markus_2024_laptop.webp',
  'jobTitle': 'Senior IT Consultant & Software Architect',
  'address': {
    '@type': 'PostalAddress',
    'addressLocality': 'Augsburg',
    'addressRegion': 'Bayern',
    'addressCountry': 'DE'
  },
  'knowsAbout': [
    'DevSecOps', 'Software Architecture', 'Scrum', 'Agile Project Management', 'Astro.js', 'Go (Golang)', 'Cloud Computing'
  ],
  'affiliation': [
    { '@type': 'Organization', 'name': 'Scrum.org' },
    { '@type': 'Organization', 'name': 'IHK Augsburg' }
  ]
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Über mich',
  link: 'https://waldheim.dev/ueber-mich'
}]);
---
<Layout title={titel} description={description} keywords={keywords} schema={[personSchema, breadCrumbSchema]} image={ogImage}>
  <main id="main-content">
    <!-- Hero: Autorität & Persönlichkeit -->
    <HeroMetric 
      title="Strategische IT-Beratung mit über 10 Jahren Praxiserfahrung" 
      subtitle="Als zertifizierter Professional Scrum Master II und Senior Developer schließe ich die Lücke zwischen Business-Vision und technischer Exzellenz. Ansässig im Raum Augsburg, tätig für Visionäre weltweit."
    >
      <img src="/markus/markus_2024_laptop.webp" alt="Markus Waldheim - IT Consultant & Software Architect" class="h-[50vh] m-auto object-contain drop-shadow-2xl" loading="eager" fetchpriority="high"/>
      
      <div slot="cta" class='mt-10 flex items-center flex-wrap gap-6'>
        <a
          href="https://calendly.com/markus-waldheim/30min"
          target="_blank"
          rel="noopener noreferrer"
          class='group flex items-center gap-2 rounded-xl bg-meg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-meg-accent/30 hover:scale-[1.02] transition-all duration-300'
        >
          <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
          Strategiegespräch buchen
          <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
        </a>
        <a
          href="/referenzen/1/"
          class="inline-flex items-center px-8 py-3 bg-meg-surface-dark border border-meg-border-dark hover:border-meg-accent/50 text-meg-text-primary-dark rounded-xl font-semibold transition-all duration-300 hover:shadow-lg hover:shadow-meg-accent/5"
        >
          Portfolio & Case Studies
        </a>
      </div>
    </HeroMetric>

    <!-- Mission & Werte -->
    <section class='py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark' aria-labelledby="mission-heading">
      <div class='mx-auto max-w-7xl'>
        <div class='grid lg:grid-cols-2 gap-16'>
          <div>
            <h2 id="mission-heading" class='text-4xl font-black tracking-tight text-meg-text-primary-dark mb-8'>
              Meine Mission: <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Verschwendung eliminieren</span>, Wert generieren.
            </h2>
            <p class='text-xl leading-8 text-meg-text-secondary mb-6'>
              In über einem Jahrzehnt IT-Entwicklung habe ich eines gelernt: Die teuerste Software ist die, die am Bedarf vorbei entwickelt wird oder durch ineffiziente Prozesse ausgebremst wird.
            </p>
            <p class='text-lg leading-relaxed text-meg-text-secondary mb-8'>
              Ich helfe Unternehmen, ihre digitale DNA zu optimieren. Ob durch **KI-gestützte Automatisierung**, die Ihre Produktivität um bis zu **150%** steigert, oder durch **agile Führung**, die Teams wieder handlungsfähig macht.
            </p>
            
            <!-- Badges / Zertifikate -->
            <div class="flex flex-wrap gap-4 mt-8">
              <div class="px-4 py-2 bg-meg-surface-dark border border-meg-border-dark rounded-lg flex items-center gap-3">
                <i class="fa-solid fa-award text-meg-accent"></i>
                <span class="text-xs font-bold uppercase tracking-widest">PSM II Certified</span>
              </div>
              <div class="px-4 py-2 bg-meg-surface-dark border border-meg-border-dark rounded-lg flex items-center gap-3">
                <i class="fa-solid fa-graduation-cap text-meg-accent"></i>
                <span class="text-xs font-bold uppercase tracking-widest">IHK Ausbilder</span>
              </div>
              <div class="px-4 py-2 bg-meg-surface-dark border border-meg-border-dark rounded-lg flex items-center gap-3">
                <i class="fa-solid fa-code text-meg-accent"></i>
                <span class="text-xs font-bold uppercase tracking-widest">10+ Jahre Dev</span>
              </div>
            </div>
          </div>
          
          <div class='flex flex-col gap-6'>
            <article class='bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group hover:border-meg-accent/30 transition-all'>
              <h3 class="text-2xl font-bold mb-4 text-meg-text-primary-dark">Der menschliche Faktor</h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed">
                Technologie ist nur so gut wie das Team, das sie bedient. Als zertifizierter Ausbilder (IHK) und Scrum Master liegt mein Fokus auch auf dem Wissenstransfer und der Befähigung Ihrer Mitarbeiter.
              </p>
            </article>
            <article class='bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group hover:border-violet-500/30 transition-all'>
              <h3 class="text-2xl font-bold mb-4 text-meg-text-primary-dark">KI als Katalysator</h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed">
                Ich integriere KI-Tools nicht als Spielerei, sondern als messbaren Effizienz-Hebel. Das Ergebnis sind schlankere Pipelines, weniger technische Schulden und ein massiver Speed-Vorteil gegenüber dem Wettbewerb.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- Storytelling: Vom Consultant zum Product Builder -->
    <section class="py-24 px-6 bg-meg-surface-dark/30 border-b border-meg-border-dark" aria-labelledby="story-heading">
      <div class="mx-auto max-w-5xl">
        <div class="relative group">
          <div class="absolute -inset-0.5 bg-gradient-to-r from-meg-accent/20 to-indigo-500/20 rounded-3xl blur opacity-25 group-hover:opacity-40 transition duration-700" aria-hidden="true"></div>
          <div class="relative bg-meg-surface-dark/80 backdrop-blur-xl border border-meg-border-dark/60 p-8 sm:p-12 rounded-3xl">
            <span class="text-meg-accent font-bold uppercase tracking-[0.2em] text-xs mb-4 block font-black">Die Story hinter den Lösungen</span>
            <h2 id="story-heading" class="text-3xl sm:text-4xl font-black text-meg-text-primary-dark tracking-tight mb-6">
              Vom Consultant zum Product Builder: Die Geburtsstunde der <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Waldheim Suite</span>
            </h2>
            <div class="space-y-6 text-slate-300 leading-relaxed text-base">
              <p>
                In über 10 Jahren IT-Beratung und Softwareentwicklung sah ich immer wieder dasselbe Problem: Unternehmen geben zehntausende Euro aus, um das Rad neu zu erfinden. Jedes Projekt brauchte von vorn ein Kundenportal, eine Rechnungsverwaltung, Dateifreigaben und Benutzerrechte.
              </p>
              <p>
                <strong>Meine Vision:</strong> Ein standardisiertes, extrem performantes Fundament, das 90% der typischen B2B-Prozesse out-of-the-box abdeckt – die <strong>Waldheim Suite</strong>. 
              </p>
              <p>
                Durch diese Kombination aus fertigem Produkt und meinen maßgeschneiderten IT-Dienstleistungen profitieren Sie doppelt: Sie starten nicht bei Null, sondern mit einem hochmodernen Kern, und ich passe diesen exakt auf Ihre individuellen Workflows an. Das spart Ihnen Zeit, Kosten und schont Ihre Nerven.
              </p>
            </div>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="/suite/" class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-meg-accent to-sky-600 text-white font-bold text-sm rounded-xl hover:scale-[1.02] hover:shadow-lg hover:shadow-meg-accent/20 transition-all cursor-pointer">
                <i class="fa-solid fa-table-cells-large"></i>
                Die Suite entdecken
              </a>
              <a href="/services/entwicklung/" class="inline-flex items-center gap-2 px-6 py-3 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-sm rounded-xl hover:border-meg-accent/40 transition-all cursor-pointer">
                <i class="fa-solid fa-laptop-code"></i>
                Entwicklungs-Services
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Karriere />

    <SkillWrapper />

    <!-- Soft CTA für Erstkontakt -->
    <CTASoft title="Bereit für das nächste Level Ihrer IT-Strategie?">
      <div class="flex flex-col sm:flex-row gap-4 items-center">
        <a
          href="https://calendly.com/markus-waldheim/30min"
          target="_blank"
          rel="noopener noreferrer"
          class='group flex items-center gap-2 rounded-xl bg-meg-accent px-8 py-4 text-base font-bold text-white shadow-lg hover:shadow-meg-accent/30 hover:scale-[1.02] transition-all duration-300'
        >
          <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
          Jetzt Strategietermin sichern
        </a>
        <span class="text-meg-text-secondary text-sm">oder direkt per</span>
        <a href="/kontakt/" class="text-meg-text-primary-dark font-bold hover:text-meg-accent transition-colors underline decoration-meg-accent underline-offset-4">Kontaktformular</a>
      </div>
    </CTASoft>
  </main>
</Layout>