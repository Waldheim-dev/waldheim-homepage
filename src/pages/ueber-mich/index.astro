---
import { SchemaUtils } from '../../utils/schema';
import Layout from '../../layouts/Layout.astro';
import HeroMetric from '../../components/HeroMetric.astro';
import CTASoft from '../../components/CTASoft.astro';
import SkillWrapper from '../../components/SkillWrapper.astro';
import { getCollection } from 'astro:content';
import Karriere from '../../components/Karriere.astro';


const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
}, {
  name: 'Über mich',
  link: Astro.url.href
}]);


const titel = "Über mich - waldheim.dev: IT-Experte Markus Waldheim"
const description = "Lernen Sie mich kennen: Markus Waldheim, IT-Experte mit Leidenschaft für Qualität. Mein Werdegang, meine Skills und meine Projekte. Ihr Partner für IT-Lösungen in Augsburg, München und darüber hinaus."
const keywords = "Über mich, Markus Waldheim, IT-Experte, Lebenslauf, Skills, Erfahrung, Projekte, Werdegang, Persönlich, Augsburg, München"

---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <HeroMetric title="Erfahrener IT-Experte mit Leidenschaft für Qualität und Innovation" subtitle="Als Entwickler und DevSecOps-Spezialist mit über 10 Jahren Erfahrung begleite ich Unternehmen bei der Optimierung ihrer IT-Prozesse.">
      <img src="/markus/markus_2024_laptop.webp" alt="Markus Waldheim" class="h-[50vh] m-auto object-contain drop-shadow-2xl" loading="lazy"/>
    <div slot="cta" class='mt-10 flex items-center flex-wrap gap-6'>
      <a
        href="https://portal.waldheim.dev"
        target="_blank"
        rel="noopener noreferrer"
        class='group flex items-center gap-2 gsap-fadein rounded-xl bg-meg-accent px-6 py-3 text-sm gsap-wiggle font-semibold text-white shadow-lg hover:shadow-meg-accent/30 hover:scale-[1.02] transition-all duration-300'
      >
        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
        Anfrage im Kundenportal
        <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
      </a>
      <a
        href="/referenzen/1/"
        class="inline-flex items-center px-8 py-3 bg-meg-surface-dark border border-meg-border-dark hover:border-meg-accent/50 text-meg-text-primary-dark rounded-xl font-semibold transition-all duration-300 hover:shadow-lg hover:shadow-meg-accent/5"
      >
        <i class="fa-solid fa-briefcase mr-2 text-meg-accent" aria-hidden="true"></i>
        Gesamtes Portfolio entdecken
      </a>
    </div>
  </HeroMetric>
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl lg:mx-0 lg:max-w-none'>
        <h2 class='gsap-fadein text-4xl sm:text-5xl font-bold tracking-tight text-meg-text-primary-dark mb-4' style='animation-delay: 0s'>
          Mein Antrieb: <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Effizienz</span> und <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Innovation</span>
        </h2>
        <div class='mt-10 flex flex-col gap-x-8 gap-y-12 lg:flex-row'>
          <div class='lg:w-full lg:max-w-2xl lg:flex-auto'>
            <p class='gsap-fadein text-xl leading-8 text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
              Ich bin überzeugt, dass Prozesse kontinuierlich optimiert und beschleunigt werden können. Mein Ziel ist es, Verschwendung zu vermeiden und die bestmöglichen Ergebnisse zu erzielen.
            </p>
            <p class='gsap-fadein text-lg leading-7 text-meg-text-secondary' style='animation-delay: 0.3s'>
              Ob durch die Entwicklung maßgeschneiderter Tools zur Analyse und Optimierung oder durch die Umgestaltung und Automatisierung Ihrer Entwicklungsprozesse – ich finde die effizienteste Lösung für Ihre Anforderungen.
            </p>
          </div>
          <div class='lg:flex lg:flex-auto lg:justify-center'>
            <dl class='w-64 space-y-8 xl:w-80'>
              <div class='gsap-fadein flex flex-col-reverse gap-y-4 bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 shadow-sm group hover:border-meg-accent/30 transition-all duration-300' style='animation-delay: 0.45s'>
                <dt class='text-base leading-7 text-meg-text-secondary group-hover:text-meg-text-primary-dark transition-colors'>
                  <i class='fa-solid fa-rocket text-meg-accent mr-2' aria-hidden='true'></i>
                  Produktivitätssteigerung durch KI-Tools
                </dt>
                <dd class='text-5xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>+150%</dd>
              </div>
              <div class='gsap-fadein flex flex-col-reverse gap-y-4 bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 shadow-sm group hover:border-violet-500/30 transition-all duration-300' style='animation-delay: 0.6s'>
                <dt class='text-base leading-7 text-meg-text-secondary group-hover:text-meg-text-primary-dark transition-colors'>
                  <i class='fa-solid fa-users text-violet-400 mr-2' aria-hidden='true'></i>
                  Bevorzugte Projektmethode
                </dt>
                <dd class='text-5xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Scrum</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Karriere />

  <CTASoft title="Kontaktieren Sie mich um Ihre Vision umzusetzen">
          <a
      href="https://portal.waldheim.dev"
      target="_blank"
      rel="noopener noreferrer"
      class='group flex items-center gap-2 gsap-fadein gsap-wiggle rounded-xl bg-meg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-meg-accent/30 hover:scale-[1.02] transition-all duration-300'
      style='animation-delay: 0.3s'
    >
      <i class="fa-solid fa-envelope" aria-hidden="true"></i>
      Anfrage im Kundenportal
      <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
    </a>
  </CTASoft>

  <SkillWrapper />
</Layout>
