---
import { SchemaUtils } from '../../utils/schema';
import Layout from '../../layouts/Layout.astro';
import HeroMetric from '../../components/HeroMetric.astro';
import CTASoft from '../../components/CTASoft.astro';
import SkillWrapper from '../../components/SkillWrapper.astro';
import { getCollection } from 'astro:content';
import Karriere from '../../components/Karriere.astro';


const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
}, {
  name: 'Über mich',
  link: Astro.url.href
}]);


const titel = "Über mich - waldheim.dev: IT-Experte Markus Waldheim"
const description = "Lernen Sie mich kennen: Markus Waldheim, IT-Experte mit Leidenschaft für Qualität. Mein Werdegang, meine Skills und meine Projekte. Ihr Partner für IT-Lösungen in Augsburg, München und darüber hinaus."
const keywords = "Über mich, Markus Waldheim, IT-Experte, Lebenslauf, Skills, Erfahrung, Projekte, Werdegang, Persönlich, Augsburg, München"

---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <HeroMetric title="Erfahrener IT-Experte mit Leidenschaft für Qualität und Innovation" subtitle="Als Entwickler und DevSecOps-Spezialist mit über 10 Jahren Erfahrung teile ich mein Wissen und unterstütze Unternehmen bei der Optimierung ihrer IT-Prozesse.">
      <img src="/markus/markus_2024_laptop.webp"  alt="Markus Waldheim" class="h-[50vh] m-auto" loading="lazy"/>
    <div slot="cta" class='mt-10 flex items-center flex-wrap gap-x-6'>
      <button
        onclick="openContact()"
        class='flex gap-1 rounded-md bg-primary-600 dark:bg-emerald-800 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600'
      >Kostenloses Erstgespräch
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="animate-pulse w-5 h-5"
        >
          <path
            d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
          ></path>
          <path
            d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
          ></path>
        </svg>
      </button>
      <a
        href="/referenzen/"
        class="flex gap-1 text-sm font-semibold leading-6 text-primary-900 dark:text-white"
      >Meine Referenzen
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"></path>
        </svg>
      </a>
    </div>
  </HeroMetric>
  <div class='py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl lg:mx-0 lg:max-w-none'>
        <h2 class='text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl'>Mein Antrieb: Effizienz und Innovation</h2>
        <div class='mt-6 flex flex-col gap-x-8 gap-y-20 lg:flex-row'>
          <div class='lg:w-full lg:max-w-2xl lg:flex-auto'>
            <p class='text-xl leading-8 text-gray-600 dark:text-slate-400'>Ich bin überzeugt, dass Prozesse kontinuierlich optimiert und beschleunigt werden können. Mein Ziel ist es, Verschwendung zu vermeiden und die bestmöglichen Ergebnisse zu erzielen.</p>
            <p class='mt-10 max-w-xl text-base leading-7 text-gray-700 dark:text-slate-300'>Ob durch die Entwicklung maßgeschneiderter Tools zur Analyse und Optimierung oder durch die Umgestaltung und Automatisierung Ihrer Entwicklungsprozesse – ich finde die effizienteste Lösung für Ihre Anforderungen.</p>
          </div>
          <div class='lg:flex lg:flex-auto lg:justify-center'>
            <dl class='w-64 space-y-8 xl:w-80'>
              <div class='flex flex-col-reverse gap-y-4'>
                <dt class='text-base leading-7 text-gray-600 dark:text-slate-400'>Produktivitätssteigerung durch KI-gestützte Tools</dt>
                <dd class='text-5xl font-semibold tracking-tight text-gray-900 dark:text-white'>+150%</dd>
              </div>
              <div class='flex flex-col-reverse gap-y-4'>
                <dt class='text-base leading-7 text-gray-600 dark:text-slate-400'>Bevorzugte Projektmethode</dt>
                <dd class='text-5xl font-semibold tracking-tight text-gray-900 dark:text-white'>Scrum</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <Karriere />

  <CTASoft title="Kontaktieren Sie mich um deine Vision umzusetzen">
    <button
      onclick="openContact()"
      class='flex gap-1 rounded-md bg-primary-600 dark:bg-emerald-800 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600'
    >Kostenloses Erstgespräch
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="animate-pulse w-5 h-5"
      >
        <path
          d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"
        ></path>
        <path
          d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"
        ></path>
      </svg>
    </button>
  </CTASoft>

  <SkillWrapper />
</Layout>
