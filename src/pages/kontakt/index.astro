---
import Layout from '../../layouts/Layout.astro';
import Contact from '../../components/Contact.astro';
import { SchemaUtils } from '../../utils/schema';
import TrackedButton from '../../components/TrackedButton.astro';

// SEO & Meta
const titel = 'Kontakt & IT-Beratung Augsburg | Jetzt Projekt anfragen';
const description = 'Sichern Sie sich Ihr kostenloses Strategiegespräch. Kontaktieren Sie Markus Waldheim für Softwareentwicklung, DevSecOps & IT-Support in Augsburg & München.';
const keywords = 'IT-Beratung Kontakt, Softwareprojekt anfragen Augsburg, DevSecOps Consulting München, IT-Support Termin, Markus Waldheim Kontakt';
const ogImage = 'https://waldheim.dev/waldheim-dev-og.jpg';

// Structured Data: ContactPage
const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  'name': 'Kontakt - Waldheim.dev',
  'description': 'Kontaktieren Sie Markus Waldheim für IT-Dienstleistungen und Beratung.',
  'mainEntity': {
    '@type': 'ProfessionalService',
    'name': 'Waldheim.dev',
    'image': 'https://waldheim.dev/waldheim.dev.svg',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Augsburg',
      'addressRegion': 'Bayern',
      'addressCountry': 'DE'
    }
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Kontakt',
  link: 'https://waldheim.dev/kontakt'
}]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[contactPageSchema, breadCrumbSchema]}
  image={ogImage}
>
  <main id="main-content" class="bg-meg-bg-dark min-h-screen">
    <section class="py-24 px-6 relative overflow-hidden">
      <!-- Hintergrund-Effekt -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl">
        <div class="absolute top-1/4 left-1/4 size-96 bg-meg-accent/5 blur-3xl rounded-full"></div>
        <div class="absolute bottom-1/4 right-1/4 size-96 bg-violet-500/5 blur-3xl rounded-full"></div>
      </div>

      <div class="mx-auto max-w-7xl relative z-10">
        <header class="text-center mb-16">
          <h1 class="text-4xl md:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Lassen Sie uns Ihre <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">Vision</span> realisieren
          </h1>
          <p class="text-xl text-meg-text-secondary max-w-2xl mx-auto">
            Wählen Sie den Weg, der am besten zu Ihnen passt: Ein direkter Termin für den schnellen Austausch oder eine detaillierte Nachricht für Ihr Projekt.
          </p>
        </header>

        <div class="grid lg:grid-cols-2 gap-12 items-start">
          
          <!-- Option 1: Calendly (Direct Path) -->
          <div class="bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl p-10 flex flex-col h-full hover:border-meg-accent/30 transition-all duration-500">
            <div class="flex items-center gap-4 mb-8">
              <div class="size-14 bg-meg-accent/10 rounded-2xl flex items-center justify-center border border-meg-accent/20 text-meg-accent">
                <i class="fa-solid fa-calendar-check text-2xl"></i>
              </div>
              <div>
                <h2 class="text-2xl font-bold">Direkte Strategie-Session</h2>
                <p class="text-meg-accent text-sm font-bold">Schnellste Antwort</p>
              </div>
            </div>
            
            <p class="text-meg-text-secondary mb-10 leading-relaxed">
              Buchen Sie direkt einen 30-minütigen Slot in meinem Kalender. Ideal für ein erstes Kennenlernen, technische Beratung oder um dringende Engpässe zu besprechen.
            </p>

            <ul class="space-y-4 mb-12 text-meg-text-primary-dark font-medium">
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400"></i> Kostenloses Erstgespräch</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400"></i> Analyse Ihrer aktuellen Situation</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400"></i> Erste Lösungsansätze sofort</li>
            </ul>

            <div class="mt-auto">
              <TrackedButton
                href="https://calendly.com/markus-waldheim/30min"
                target="_blank"
                variant="primary"
                class="w-full !py-4 text-base"
                trackEvent="cta_contact_calendly"
                trackCategory="contact"
                trackLabel="Calendly Booking"
              >
                Termin online buchen
              </TrackedButton>
              <p class="text-center text-meg-text-secondary text-xs mt-4">Kein Account nötig. Bestätigung erfolgt sofort per E-Mail.</p>
            </div>
          </div>

          <!-- Option 2: Formular (Structured Path) -->
          <div class="bg-meg-surface-dark/40 backdrop-blur-xl border border-meg-border-dark rounded-3xl overflow-hidden group hover:border-meg-accent/30 transition-all duration-500">
            <div class="p-8 sm:p-10 pb-0">
               <div class="flex items-center gap-4 mb-6">
                <div class="size-14 bg-violet-500/10 rounded-2xl flex items-center justify-center border border-violet-500/20 text-violet-400">
                  <i class="fa-solid fa-paper-plane text-2xl"></i>
                </div>
                <div>
                  <h2 class="text-2xl font-bold text-meg-text-primary-dark">Projektanfrage</h2>
                  <p class="text-violet-400 text-sm font-bold uppercase tracking-widest">Qualifizierte Nachricht</p>
                </div>
              </div>
              <p class="text-meg-text-secondary text-sm leading-relaxed mb-4">
                Senden Sie mir Details zu Ihrem Vorhaben. Ich analysiere Ihre Anfrage und melde mich innerhalb von 24 Stunden mit einem ersten Einschätzungsvorschlag bei Ihnen.
              </p>
            </div>
            <Contact isEmbedded={true} />
            <div class="px-8 sm:px-10 pb-8">
              <p class="text-[10px] text-meg-text-secondary/50 text-center italic leading-tight">
                Ihre Daten werden sicher verschlüsselt an mein CRM-System (Socialverse API) übertragen und ausschließlich zur Bearbeitung Ihrer Anfrage verwendet.
              </p>
            </div>
          </div>

        </div>

        <!-- Trust Signal / Social Proof -->
        <div class="mt-24 grid md:grid-cols-3 gap-8 text-center border-t border-meg-border-dark pt-16">
          <div>
            <span class="text-meg-accent text-3xl font-black mb-2 block tracking-tighter">98%</span>
            <p class="text-meg-text-secondary text-sm uppercase font-bold tracking-widest">Zufriedene Kunden</p>
          </div>
          <div>
            <span class="text-meg-accent text-3xl font-black mb-2 block tracking-tighter">&lt; 4h</span>
            <p class="text-meg-text-secondary text-sm uppercase font-bold tracking-widest">Reaktionszeit</p>
          </div>
          <div>
            <span class="text-meg-accent text-3xl font-black mb-2 block tracking-tighter">100%</span>
            <p class="text-meg-text-secondary text-sm uppercase font-bold tracking-widest">Datenschutz-Konform</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>