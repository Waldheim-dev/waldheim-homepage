---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
}, {
  name: 'Service',
  link: Astro.url.hostname
}, {
  name: 'Verbandssoftware',
  link: Astro.url.href
}]);

const titel = 'SEWOBE Verbandssoftware - Vertrieb & Support - waldheim.dev';
const description = 'SEWOBE Vertriebspartner: Wir bieten Beratung, Migration, Dienstleistungen und Support für die SEWOBE Verbandssoftware. Optimieren Sie Ihre Verbandsverwaltung';
const keywords = 'Verbandssoftware, SEWOBE, Mitgliederverwaltung, Vereinssoftware, Verbandsverwaltung, CRM, Migration, Support, Dienstleistungen';
---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>

  <div class="relative isolate px-6 pt-14 lg:px-8">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
      <div
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-linear-to-tr from-[#97bea0] to-[#6b9e78] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    <div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-56">
      <div class="text-center">
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">Vereinfachen Sie Ihre
          Vereinsverwaltung mit SEWOBE</h1>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-200">Als offizieller Partner der SEWOBE AG biete
          ich Ihnen umfassende Unterstützung und Service für die führende Softwarelösung für Vereine, Verbände und
          Organisationen.</p>
        <div class="mt-10 flex items-center justify-center gap-x-6">
          <a href="https://www.sewobe.de?partner_id=waldheim.dev" target="_blank" rel="noopener noreferrer"
             class="rounded-md bg-primary-600 dark:bg-emerald-800 dark:hover:bg-emerald-900 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600">SEWOBE
            kostenlos testen</a>
          <a href="/kontakt"
             class="text-sm font-semibold leading-6 text-gray-900 dark:text-gray-300">Persönliche Beratung <span
            aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="mt-16 flow-root sm:mt-24">
        <div
          class="-m-2 rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4">
          <img
            src="/partner/sewobe_dashboard_hightquality.png"
            loading="lazy" width="2432" height="1442" class="rounded-md shadow-2xl ring-1 ring-gray-900/10"
            alt="SEWOBE VereinsMANAGER Dashboard">
        </div>
      </div>
    </div>
    <div
      class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]"
      aria-hidden="true">
      <div
        class="relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-linear-to-tr from-[#6b9e78] to-[#498059] opacity-30 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>

    <div class="py-24 sm:py-32">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:text-center">
          <h2 class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600">SEWOBE Partner</h2>
          <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl">Professionelle
            Unterstützung für Ihre Vereins- und Verbandsverwaltung</p>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">Ich unterstütze Sie von Anfang an bei der
            Einführung und Nutzung von SEWOBE, damit Sie sich voll und ganz auf Ihre Vereinsarbeit konzentrieren
            können.</p>
        </div>
        <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
          <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16">
            <div class="relative pl-16">
              <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">
                <div
                  class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800">
                  <i class="fa-regular text-white fa-cloud-arrow-up"></i>
                </div>
                Datenmigration
              </dt>
              <dd class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400">
                Ich entwickle mit Ihnen einen maßgeschneiderten Migrationsplan und übernehme die sichere Übertragung
                Ihrer Daten in die SEWOBE Software.
              </dd>
            </div>
            <div class="relative pl-16">
              <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">
                <div
                  class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800">
                  <i class="fa-regular text-white fa-puzzle-piece"></i>
                </div>
                Modul-Einrichtung
              </dt>
              <dd class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400">Ich richte die für Sie relevanten
                SEWOBE Module ein und zeige Ihnen, wie Sie die Software optimal für Ihre Bedürfnisse nutzen.
              </dd>
            </div>
            <div class="relative pl-16">
              <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">
                <div
                  class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800">
                  <i class="fa-regular text-white fa-code"></i>
                </div>
                Individuelle Vorlagen
              </dt>
              <dd class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400">Ich passe Vorlagen für E-Mails,
                Formulare und andere Dokumente an Ihr Corporate Design an, um einen einheitlichen Auftritt zu
                gewährleisten.
              </dd>
            </div>
            <div class="relative pl-16">
              <dt class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100">
                <div
                  class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800">
                  <i class="fa-regular text-white fa-headset"></i>
                </div>
                Persönlicher Support
              </dt>
              <dd class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400">Bei Fragen und Problemen stehe ich
                Ihnen mit Rat und Tat zur Seite. Ich biete Ihnen schnelle und kompetente Unterstützung zu fairen
                Konditionen.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <div
      class="relative isolate overflow-hidden px-6 py-24 sm:py-32 lg:overflow-visible lg:px-0">
      <div
        class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:items-start lg:gap-y-10">
        <div
          class="lg:col-span-2 lg:col-start-1 lg:row-start-1 lg:mx-auto lg:grid lg:w-full lg:max-w-7xl lg:grid-cols-2 lg:gap-x-8 lg:px-8">
          <div class="lg:pr-4">
            <div class="lg:max-w-lg">
              <p class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600">SEWOBE Partner</p>
              <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl">Software
                für Vereine & Verbände</h1>
              <p class="mt-6 text-xl leading-8 text-gray-700 dark:text-gray-300">Als offizieller SEWOBE Partner
                unterstütze ich Sie bei der Einführung und langfristigen Nutzung der Software. Profitieren Sie von
                meiner Expertise und meinem individuellen Service.</p>
            </div>
          </div>
        </div>
        <div
          class="-ml-12 -mt-12 p-12 lg:sticky lg:top-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:overflow-hidden">
          <img class="w-[48rem] max-w-none rounded-xl bg-gray-900 shadow-xl ring-1 ring-gray-400/10 sm:w-[57rem]"
               src="/partner/sewobe_dashboard_hightquality.png" alt="SEWOBE VereinsMANAGER" loading="lazy">
        </div>
        <div
          class="lg:col-span-2 lg:col-start-1 lg:row-start-2 lg:mx-auto lg:grid lg:w-full lg:max-w-7xl lg:grid-cols-2 lg:gap-x-8 lg:px-8">
          <div class="lg:pr-4">
            <div class="max-w-xl text-base leading-7 text-gray-700 dark:text-gray-300 lg:max-w-lg">
              <p>Nutzen Sie mit meiner Hilfe das volle Potenzial von SEWOBE für Ihre Organisation. Wir entwickeln
                gemeinsam die besten Konzepte für Ihren individuellen Bedarf. Und auch danach stehe ich Ihnen mit meinem
                Support zu fairen Konditionen zur Seite. Dieses Angebot gilt exklusiv für Neukunden, die über mich einen
                Vertrag mit SEWOBE abschließen.</p>
              <ul role="list" class="mt-8 space-y-8 text-gray-600 dark:text-gray-400">
                <li class="flex gap-x-3">
                  <svg class="mt-1 h-5 w-5 flex-none  text-primary-600 dark:text-emerald-600" viewBox="0 0 20 20"
                       fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd"
                          d="M5.5 17a4.5 4.5 0 01-1.44-8.765 4.5 4.5 0 018.302-3.046 3.5 3.5 0 014.504 4.272A4 4 0 0115 17H5.5zm3.75-2.75a.75.75 0 001.5 0V9.66l1.95 2.1a.75.75 0 101.1-1.02l-3.25-3.5a.75.75 0 00-1.1 0l-3.25 3.5a.75.75 0 101.1 1.02l1.95-2.1v4.59z"
                          clip-rule="evenodd" />
                  </svg>
                  <span><strong class="font-semibold text-gray-900 dark:text-gray-100">Ortsunabhängige Nutzung.</strong> Da es sich um eine Online-Software handelt, können Sie SEWOBE von überall nutzen – ohne Installation.</span>
                </li>
                <li class="flex gap-x-3">
                  <svg class="mt-1 h-5 w-5 flex-none text-primary-600 dark:text-emerald-600" viewBox="0 0 20 20"
                       fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd"
                          d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z"
                          clip-rule="evenodd" />
                  </svg>
                  <span><strong
                    class="font-semibold text-gray-900 dark:text-gray-100">Zertifizierte Sicherheit.</strong> Mit Zertifizierungen für Datensicherheit, Wirtschaftsprüfungen, etc. ist die Software der SEWOBE eine der einzigen, die sich so viel Mühe für Ihre Daten gibt.</span>
                </li>
                <li class="flex gap-x-3">
                  <svg class="mt-1 h-5 w-5 flex-none text-primary-600 dark:text-emerald-600" viewBox="0 0 20 20"
                       fill="currentColor" aria-hidden="true">
                    <path
                      d="M4.632 3.533A2 2 0 016.577 2h6.846a2 2 0 011.945 1.533l1.976 8.234A3.489 3.489 0 0016 11.5H4c-.476 0-.93.095-1.344.267l1.976-8.234z" />
                    <path fill-rule="evenodd"
                          d="M4 13a2 2 0 100 4h12a2 2 0 100-4H4zm11.24 2a.75.75 0 01.75-.75H16a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75h-.01a.75.75 0 01-.75-.75V15zm-2.25-.75a.75.75 0 00-.75.75v.01c0 .414.336.75.75.75H13a.75.75 0 00.75-.75V15a.75.75 0 00-.75-.75h-.01z"
                          clip-rule="evenodd" />
                  </svg>
                  <span><strong class="font-semibold text-gray-900 dark:text-gray-100">Datensicherung.</strong> Datenverlust kann durch das Sicherheitskonzept der Software nicht erfolgen.</span>
                </li>
              </ul>
              <a href="https://www.sewobe.de?partner_id=waldheim.dev" target="_blank" rel="noopener noreferrer"
                 class="mt-8 inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 dark:bg-emerald-800 hover:bg-primary-700 dark:hover:bg-emerald-700">Jetzt
                testen</a>
              <h2 class="mt-16 text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">Kein Server? Kein
                Problem.</h2>
              <p class="mt-6">Die Software wird von der SEWOBE selbst gehostet und dadurch sparen wir uns sowohl
                Hosting-Gebühren, als auch Zeit. Bekommen zudem automatisch regelmäßig Updates ein Lebenslang.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <PriceService />
  <Partner />

</Layout>
