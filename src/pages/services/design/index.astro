---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import Blog from '../../../components/Blog.astro';

// SEO & Meta
const titel = 'UI/UX Design & Branding Augsburg | Conversion-Optimierung';
const description = 'User-centered Design für B2B-Anwendungen. Ich entwickle moderne Brandings, Interfaces & UX-Strategien, die Ihre Zielgruppe in Augsburg & München überzeugen.';
const keywords = 'UI Design Augsburg, UX Consulting München, Webdesign Bayern, Branding für Startups, Interface Design KMU, User Experience Optimierung';
const ogImage = 'https://waldheim.dev/services/design-og.jpg';

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'UI/UX Design & Branding',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Waldheim.dev',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Augsburg',
      'addressRegion': 'Bayern',
      'addressCountry': 'DE'
    }
  },
  'serviceType': 'Design & UX Consulting',
  'areaServed': [
    { '@type': 'City', 'name': 'Augsburg' },
    { '@type': 'City', 'name': 'München' }
  ],
  'description': 'Entwicklung ganzheitlicher Designsysteme, intuitiver User Interfaces und nachhaltiger Markenidentitäten mit Fokus auf Conversion und Barrierefreiheit.',
  'offers': {
    '@type': 'Offer',
    'description': 'Design-Sprints, UI-Konzepte & Brand-Identity Pakete'
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Design',
  link: 'https://waldheim.dev/services/design'
}]);

const faqSchema = SchemaUtils.getFAQSchema([
  {
    question: 'Warum ist UX-Design für mein B2B-Unternehmen wichtig?',
    answer: 'Im B2B-Bereich entscheiden Effizienz und Klarheit. Ein gutes UX-Design reduziert Einarbeitungszeiten für Mitarbeiter und erhöht die Abschlussraten bei Kunden durch eine intuitive Benutzerführung.'
  },
  {
    question: 'Erstellen Sie auch Logos und Marken-Guidelines?',
    answer: 'Ja, ich entwickle ganzheitliche Markenidentitäten – vom Logo über die Typografie bis hin zu digitalen Design-Systemen, die konsistent über alle Plattformen hinweg funktionieren.'
  },
  {
    question: 'Nutzen Sie moderne Tools wie Figma?',
    answer: 'Absolut. Der gesamte Designprozess findet in Figma statt, was eine nahtlose Zusammenarbeit und ein schnelles Prototyping ermöglicht, bevor die erste Zeile Code geschrieben wird.'
  }
]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema, faqSchema]}
  image={ogImage}
>
  <main id="main-content">
    <!-- Hero Section -->
    <ServiceHero 
      title="Design & UX"
      subtitle="Nutzerzentriertes & konversionsstarkes"
      description="Design ist mehr als Ästhetik – es ist das Fundament Ihres Erfolgs. Ich gestalte digitale Erlebnisse, die Ihre Markenwerte transportieren und Ihre Nutzer intuitiv zum Ziel führen."
      gradient="rose"
      icon="fa-palette"
      badge="Design Thinking & User Centered Design"
    />

    <!-- Fokus-Bereiche -->
    <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="design-focus-heading">
      <div class="mx-auto max-w-7xl">
        <header class="mx-auto max-w-2xl text-center mb-16">
          <h2 id="design-focus-heading" class="text-sm font-bold uppercase tracking-widest text-rose-500 mb-4">
            Mein Design-Ansatz
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Form follows <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500">Function</span>
          </p>
          <p class="text-xl text-meg-text-secondary">
            Ich verbinde visuelle Brillanz mit psychologisch fundierter Benutzerführung.
          </p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/40 transition-all group">
            <i class="fa-solid fa-pen-nib text-rose-500 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Corporate Identity</h3>
            <p class="text-meg-text-secondary text-sm">Entwicklung unverwechselbarer Brandings, die Vertrauen schaffen und Ihre Kompetenz im Raum Augsburg/München unterstreichen.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/40 transition-all group">
            <i class="fa-solid fa-wand-magic-sparkles text-rose-500 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">UI/UX Design</h3>
            <p class="text-meg-text-secondary text-sm">Interfaces, die Spaß machen. Ich optimiere User-Flows für maximale Conversion und intuitive Bedienbarkeit Ihrer Software.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/40 transition-all group">
            <i class="fa-solid fa-layer-group text-rose-500 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Design Systems</h3>
            <p class="text-meg-text-secondary text-sm">Skalierbare Komponenten-Bibliotheken in Figma und Code für ein konsistentes Markenerlebnis über alle Touchpoints hinweg.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Design-Prozess Video-Sektion -->
    <section class="py-24 px-6 border-y border-meg-border-dark bg-meg-surface-dark/10">
      <div class="mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="relative">
            <div class="absolute -inset-4 bg-rose-500/10 rounded-3xl blur-2xl"></div>
            <video src="/videos/video_design.mp4" poster="/videos/video_design-poster.webp" loop muted playsinline autoplay class="relative rounded-2xl w-full border border-meg-border-dark shadow-2xl" aria-label="Visualisierung moderner Design-Workflows"></video>
          </div>
          <div>
            <h2 class="text-3xl font-bold mb-6">Vom Wireframe zum <span class="text-rose-500">Pixel-Perfect</span> Resultat</h2>
            <p class="text-meg-text-secondary mb-8 leading-relaxed">
              Mein Design-Prozess ist transparent und kollaborativ. Wir starten mit Ihren Business-Zielen und entwickeln daraus eine visuelle Sprache, die Ihre Kunden nicht nur erreicht, sondern bewegt.
            </p>
            <ul class="space-y-4">
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-rose-400"></i> Analyse der Zielgruppen-Psychologie</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-rose-400"></i> Prototyping für schnelles Feedback</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-rose-400"></i> Strikte WCAG 2.0 AA Barrierefreiheit</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-rose-400"></i> Nahtlose Übergabe an die Entwicklung</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 px-6" aria-labelledby="design-faq-heading">
      <div class="mx-auto max-w-4xl">
        <header class="text-center mb-12">
          <h2 id="design-faq-heading" class="text-3xl font-bold">Fragen zum <span class="text-rose-500">Design-Prozess</span></h2>
        </header>
        <div class="space-y-6">
          {faqSchema.mainEntity.map((faq) => (
            <details class="group border border-meg-border-dark rounded-2xl p-6 bg-meg-surface-dark/50 cursor-pointer hover:border-rose-500/30 transition-all">
              <summary class="flex justify-between items-center font-bold text-meg-text-primary-dark list-none">
                {faq.name}
                <span class="text-rose-500 group-open:rotate-180 transition-transform">
                  <i class="fa-solid fa-chevron-down"></i>
                </span>
              </summary>
              <p class="mt-4 text-meg-text-secondary leading-relaxed border-t border-meg-border-dark pt-4">
                {faq.acceptedAnswer.text}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PriceService />
    <Blog limits={2} />
    <RelatedServices />
    <Partner />
  </main>
</Layout>