---
import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Design',
  link: 'https://waldheim.dev/services/design'
}]);

const titel = "Webdesign, Branding & UX/UI Design | waldheim.dev";
const description = "Webdesign Augsburg & München: Professionelles Branding, UX/UI-Design, Printmedien. Überzeugende Markenauftritte und benutzerfreundliche digitale Erlebnisse aus Bayern.";
const keywords = "Webdesign, Branding, Corporate Design, Logo Design, Printmedien, UI Design, UX Design, User Experience, User Interface, Grafikdesign, Responsive Design";

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Webdesign, Branding & UX/UI Design',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'Design Consulting',
  areaServed: 'DE',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/design-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="Design"
    subtitle="Kreatives & benutzerfreundliches"
    description="Von Webdesign über Branding bis zu Print-Medien – ich gestalte visuelle Erlebnisse, die Ihre Marke zum Leben erwecken. Mit UX/UI-Expertise für digitale Produkte und klassischem Grafikdesign für Print."
    gradient="pink"
    icon="fa-pen-nib"
    badge="Design trifft Funktion"
  />
  <!-- Main Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark' id='leistungen'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-palette mr-2' aria-hidden='true'></i>
          Kreativ-Services
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
          Design, das <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500'>wirkt</span> und begeistert
        </p>
        <p class='gsap-fadein text-xl text-meg-text-secondary' style='animation-delay: 0.3s'>
          Ich gestalte für Sie überzeugende Designs – für Printmedien und digitale Anwendungen.
        </p>
      </div>
      
      <div class='grid md:grid-cols-2 gap-8 max-w-5xl mx-auto'>
        {[
          { title: 'Print-Design', desc: 'Plakate, Flyer, Visitenkarten – hochwertig und zielgruppengerecht.', icon: 'fa-print' },
          { title: 'UI/UX Design', desc: 'Intuitive Benutzeroberflächen unter Berücksichtigung der Barrierefreiheit.', icon: 'fa-mobile-screen' },
          { title: 'Logo Design', desc: 'Einzigartige Logos, passend zu Ihrer Marke und für jeden Einsatzzweck.', icon: 'fa-paint-brush' },
          { title: 'Corporate Design', desc: 'Stimmige Gesamtkonzepte – von der Idee bis zum fertigen Brand-Book.', icon: 'fa-briefcase' }
        ].map((feat, i) => (
          <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/30 hover:shadow-lg hover:shadow-rose-500/5 transition-all duration-300 group' style={`animation-delay: ${0.45 + i * 0.15}s`}>
            <div class='w-14 h-14 bg-rose-500/10 border border-rose-500/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform'>
              <i class={`fa-solid ${feat.icon} text-rose-400 text-2xl`}></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>{feat.title}</h3>
            <p class='text-meg-text-secondary leading-relaxed'>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Design Process Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-diagram-project mr-2' aria-hidden='true'></i>
          Der Ablauf
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Strukturierter <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500'>Prozess</span>
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {[
          { step: '1', title: 'Analyse & Briefing', desc: 'Wir besprechen remote Ihre Ziele, Zielgruppe und Wünsche.' },
          { step: '2', title: 'Konzept & Entwurf', desc: 'Entwicklung erster Designideen auf Basis Ihrer Anforderungen.' },
          { step: '3', title: 'Feedback & Finalisierung', desc: 'Iterative Umsetzung Ihrer Wünsche via Figma oder Miro.' }
        ].map((item, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/20 transition-all shadow-sm group" style={`animation-delay: ${0.45 + i * 0.15}s`}>
            <div class="w-14 h-14 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-6 group-hover:border-rose-500/50 transition-all">
              <span class="text-3xl font-black text-rose-400">{item.step}</span>
            </div>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4">{item.title}</h3>
            <p class="text-meg-text-secondary leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Design Tools Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-toolbox mr-2' aria-hidden='true'></i>
          Werkzeuge
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Professionelle <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500'>Tools</span>
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {[
          { label: 'Design & Prototyping', tools: ['Figma', 'Illustrator', 'Photoshop'] },
          { label: 'UI-Kits & Frameworks', tools: ['TailwindCSS', 'Material Design'] },
          { label: 'Print & Publishing', tools: ['InDesign', 'Affinity Publisher'] }
        ].map((stack, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 hover:border-rose-500/20 transition-all shadow-sm" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <h3 class="text-xs font-bold uppercase tracking-widest text-rose-400 mb-4">{stack.label}</h3>
            <div class="flex flex-wrap gap-2">
              {stack.tools.map(tool => (
                <span class="px-3 py-1 bg-meg-bg-dark/50 border border-meg-border-dark rounded-lg text-sm text-meg-text-secondary font-medium">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Design Principles Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-lightbulb mr-2' aria-hidden='true'></i>
          Philosophie
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Meine <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500'>Prinzipien</span>
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {[
          { title: 'Funktion vor Ästhetik', desc: 'Schönes Design muss vor allem FUNKTIONIEREN. Usability steht an erster Stelle.', icon: 'fa-bullseye' },
          { title: 'Inklusives Design', desc: 'Barrierefreiheit ist Standard. Ich entwickle für ALLE Nutzer.', icon: 'fa-universal-access' },
          { title: 'Mobile First', desc: 'Ich designe zuerst für kleine Bildschirme, dann für Desktop.', icon: 'fa-mobile-screen' },
          { title: 'Iterativer Prozess', desc: 'Feedback-Schleifen statt Einmal-Abnahme. Dialog schafft Qualität.', icon: 'fa-arrows-rotate' }
        ].map((princ, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-rose-500/30 transition-all group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <div class="w-14 h-14 bg-rose-500/10 border border-rose-500/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <i class={`fa-solid ${princ.icon} text-rose-400 text-2xl`}></i>
            </div>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4">{princ.title}</h3>
            <p class="text-meg-text-secondary leading-relaxed">{princ.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-meg-bg-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-rose-400 mb-4" style="animation-delay: 0s">
          FAQ
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Fragen & <span class='text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-pink-500'>Antworten</span>
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {[
          { q: 'Liefern Sie auch Druckdaten?', a: 'Ja! Print-ready PDF (CMYK, 300dpi) inkl. Schnittmarken und Farbprofilen – direkt bereit für die Druckerei.' },
          { q: 'Wie viele Entwürfe erhalte ich?', a: 'Standard: 2-3 Konzepte zur Auswahl. Danach: 2 Revisions-Runden inklusive. Weitere Anpassungen nach Aufwand.' },
          { q: 'Arbeiten Sie mit Brand Guidelines?', a: 'Selbstverständlich! Ich halte mich strikt an bestehende Corporate Design-Vorgaben Ihres Unternehmens.' }
        ].map((faq, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/20 transition-all shadow-sm group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <h3 class="text-lg font-bold text-meg-text-primary-dark mb-4 flex items-start gap-3">
              <span class="text-rose-400 font-black">Q</span> {faq.q}
            </h3>
            <p class="text-meg-text-secondary pl-7 leading-relaxed">
              <span class="text-meg-accent font-bold mr-2">A:</span> {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <PriceService />

  <RelatedServices />

  <Partner />

</Layout>
