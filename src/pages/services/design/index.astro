---
import Layout from '../../../layouts/Layout.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import { SchemaUtils } from '../../../utils/schema';
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
},{
  name: 'Service',
  link: Astro.url.hostname
}, {
  name: 'Design',
  link: Astro.url.href
}]);

const titel = "Webdesign, Branding & UX/UI Design - waldheim.dev"
const description = "Professionelles Webdesign, Branding, Printmedien und UX/UI-Design. Wir schaffen überzeugende Markenauftritte und benutzerfreundliche digitale Erlebnisse."
const keywords = "Webdesign, Branding, Corporate Design, Logo Design, Printmedien, UI Design, UX Design, User Experience, User Interface, Grafikdesign"

---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <div class="relative">
    <div class="mx-auto max-w-7xl lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-8">
      <div class="px-6 pb-24 pt-10 sm:pb-32 lg:col-span-7 lg:px-0 lg:pb-56 lg:pt-48 xl:col-span-6">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <div class="w-12 h-12 border flex justify-center items-center text-primary-700 dark:text-emerald-600 rounded-md border-primary-600 bg-emerald-600/25 pulse">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672 13.684 16.6m0 0-2.51 2.225.569-9.47 5.227 7.917-3.286-.672ZM12 2.25V4.5m5.834.166-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243-1.59-1.59" />
            </svg>
          </div>
          <h1 class="mt-24 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:mt-10 sm:text-6xl">Kreatives Design – digital & Print</h1>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Design ist mehr als nur Optik. Es ist ein Prozess, der Ihre Botschaft visuell kommuniziert. Lassen Sie uns diesen Prozess gemeinsam gestalten – von der ersten Idee bis zum fertigen Produkt.
          </p>
          <div class='mt-10 flex items-center gap-x-6'>
            <a href='mailto:kontakt@waldheim.dev'
               class='rounded-md bg-primary-600 dark:bg-emerald-800 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600'>
              Kostenloses Beratungsgespräch
            </a>
          </div>
        </div>
      </div>
      <div class="relative lg:col-span-5 lg:-mr-8 xl:absolute xl:inset-0 xl:left-1/2 xl:mr-0">
        <img class="aspect-3/2 w-full bg-gray-50 object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full" src="https://images.unsplash.com/photo-1534670007418-fbb7f6cf32c3?q=80&w=2188&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2102&q=80" alt="">
      </div>
    </div>
  </div>


  <div class='py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl lg:text-center'>
        <h2 class='text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600'>Gutes Design</h2>
        <p class='mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl'>
          Design, das wirkt und begeistert
        </p>
        <p class='mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400'>Ich gestalte für Sie überzeugende Designs – für
          Printmedien und digitale Anwendungen.</p>
      </div>
      <div class='mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl'>
        <dl class='grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16'>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-pen-nib'></i>
              </div>
              Professionelles Print-Design
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>
              Von Veranstaltungsplakaten und Flyern bis hin zu Visitenkarten und Briefpapier – ich gestalte Ihre
              Printmedien hochwertig und zielgruppengerecht.
            </dd>
          </div>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-object-ungroup'></i>
              </div>
              Benutzerfreundliches UI/UX Design
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>Ich gestalte intuitive und
              ansprechende Benutzeroberflächen für Ihre Software oder Website – unter Berücksichtigung der
              Barrierefreiheit (BITV 2.0).
            </dd>
          </div>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-crop'></i>
              </div>
              Individuelle Logos
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>Ich entwickle einzigartige Logos in
              verschiedenen Stilen und Formaten – passend zu Ihrer Marke und für jeden Einsatzzweck.
            </dd>
          </div>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-compass-drafting'></i>
              </div>
              Ganzheitliches Corporate Design
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>Ich entwickle ein stimmiges Corporate
              Design für Ihr Unternehmen – von der Visitenkarte bis zum Webauftritt, von der Idee bis zum fertigen
              Konzept.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="overflow-hidden py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2">
        <div class="lg:ml-auto lg:pl-4 lg:pt-4">
          <div class="lg:max-w-lg">
            <h2 class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600">Mehr Design</h2>
            <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl">Ein
              strukturierter Designprozess</p>
            <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">Ich gestalte Ihre Designs nach einem
              bewährten, effizienten Prozess – für optimale Ergebnisse und maximale Transparenz.</p>
            <dl class="mt-10 max-w-xl space-y-8 text-base leading-7 text-gray-600 dark:text-gray-400 lg:max-w-none">
              <div class="relative pl-9">
                <dt class="inline font-semibold text-gray-900 dark:text-gray-100">
                  <svg class="absolute left-1 top-1 h-5 w-5 text-primary-600 dark:text-emerald-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M2.628 1.601C5.028 1.206 7.49 1 10 1s4.973.206 7.372.601a.75.75 0 0 1 .628.74v2.288a2.25 2.25 0 0 1-.659 1.59l-4.682 4.683a2.25 2.25 0 0 0-.659 1.59v3.037c0 .684-.31 1.33-.844 1.757l-1.937 1.55A.75.75 0 0 1 8 18.25v-5.757a2.25 2.25 0 0 0-.659-1.591L2.659 6.22A2.25 2.25 0 0 1 2 4.629V2.34a.75.75 0 0 1 .628-.74Z" clip-rule="evenodd" />
                  </svg>

                  Analyse & Briefing
                </dt>
                <dd class="inline">Wir besprechen Ihre Ziele, Ihre Zielgruppe und Ihre Wünsche. Ich analysiere Ihre
                  bisherigen Materialien (falls vorhanden) und sammle alle notwendigen Informationen.
                </dd>
              </div>
              <div class="relative pl-9">
                <dt class="inline font-semibold text-gray-900 dark:text-gray-100">
                  <svg class="absolute left-1 top-1 h-5 w-5 text-primary-600 dark:text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M6.5 9a2.5 2.5 0 1 1 5 0 2.5 2.5 0 0 1-5 0Z" />
                    <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM9 5a4 4 0 1 0 2.248 7.309l1.472 1.471a.75.75 0 1 0 1.06-1.06l-1.471-1.472A4 4 0 0 0 9 5Z" clip-rule="evenodd" />
                  </svg>

                  Konzept & Entwurf
                </dt>
                <dd class="inline">Auf Basis des Briefings entwickle ich erste Designideen und Konzepte. Dabei berücksichtige
                  ich Ihre individuellen Anforderungen und aktuelle Designtrends.
                </dd>
              </div>
              <div class="relative pl-9">
                <dt class="inline font-semibold text-gray-900 dark:text-gray-100">
                  <svg class="absolute left-1 top-1 h-5 w-5 text-primary-600 dark:text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M3.75 3A1.75 1.75 0 0 0 2 4.75v10.5c0 .966.784 1.75 1.75 1.75h12.5A1.75 1.75 0 0 0 18 15.25v-8.5A1.75 1.75 0 0 0 16.25 5h-4.836a.25.25 0 0 1-.177-.073L9.823 3.513A1.75 1.75 0 0 0 8.586 3H3.75ZM10 8a.75.75 0 0 1 .75.75v1.5h1.5a.75.75 0 0 1 0 1.5h-1.5v1.5a.75.75 0 0 1-1.5 0v-1.5h-1.5a.75.75 0 0 1 0-1.5h1.5v-1.5A.75.75 0 0 1 10 8Z" clip-rule="evenodd" />
                  </svg>

                  Feedback & Umsetzung
                </dt>
                <dd class="inline">Sie erhalten die Entwürfe zur Ansicht und geben mir Ihr Feedback. Ich setze Ihre
                  Änderungswünsche um und finalisiere das Design.
                </dd>
              </div>
            </dl>
          </div>
        </div>
        <div class="flex items-start justify-end lg:order-first">
          <img src="https://images.unsplash.com/photo-1483058712412-4245e9b90334?q=80&w=2340&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Product screenshot" class="w-[48rem] max-w-none rounded-xl shadow-xl ring-1 ring-gray-400/10 sm:w-[57rem]" width="2432" height="1442">
        </div>
      </div>
    </div>
  </div>


  <PriceService />

  <Partner />

</Layout>
