---
import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import { SchemaUtils } from '../../../utils/schema';
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
},{
  name: 'Service',
  link: Astro.url.hostname
}, {
  name: 'Design',
  link: Astro.url.href
}]);

const titel = "Webdesign, Branding & UX/UI Design - waldheim.dev"
const description = "Professionelles Webdesign, Branding, Printmedien und UX/UI-Design. Wir schaffen überzeugende Markenauftritte und benutzerfreundliche digitale Erlebnisse."
const keywords = "Webdesign, Branding, Corporate Design, Logo Design, Printmedien, UI Design, UX Design, User Experience, User Interface, Grafikdesign"

---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <!-- Hero Section -->
  <ServiceHero 
    title="Design"
    subtitle="Kreatives & benutzerfreundliches"
    description="Von Webdesign über Branding bis zu Print-Medien – ich gestalte visuelle Erlebnisse, die Ihre Marke zum Leben erwecken. Mit UX/UI-Expertise für digitale Produkte und klassischem Grafikdesign für Print."
    gradient="pink"
    icon="fa-pen-nib"
    badge="Design trifft Funktion"
  />
  <!-- Main Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900' id='leistungen'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-base font-semibold text-pink-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-palette text-pink-400 mr-2' aria-hidden='true'></i>
          Gutes Design
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
          Design, das <span class='text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-rose-500'>wirkt</span> und begeistert
        </p>
        <p class='gsap-fadein text-xl text-light-300' style='animation-delay: 0.3s'>
          Ich gestalte für Sie überzeugende Designs – für Printmedien und digitale Anwendungen.
        </p>
      </div>
      
      <div class='grid md:grid-cols-2 gap-8 max-w-5xl mx-auto'>
        <div class='gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-2xl p-8 hover:border-pink-500/40 transition-all duration-300' style='animation-delay: 0.45s'>
          <div class='w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-print text-pink-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Professionelles Print-Design</h3>
          <p class='text-light-300'>
            Von Veranstaltungsplakaten und Flyern bis hin zu Visitenkarten und Briefpapier – ich gestalte Ihre
            Printmedien hochwertig und zielgruppengerecht.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-2xl p-8 hover:border-pink-500/40 transition-all duration-300' style='animation-delay: 0.6s'>
          <div class='w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-mobile-screen text-pink-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Benutzerfreundliches UI/UX Design</h3>
          <p class='text-light-300'>
            Ich gestalte intuitive und ansprechende Benutzeroberflächen für Ihre Software oder Website – unter Berücksichtigung der Barrierefreiheit (BITV 2.0).
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-2xl p-8 hover:border-pink-500/40 transition-all duration-300' style='animation-delay: 0.75s'>
          <div class='w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-paint-brush text-pink-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Individuelle Logos</h3>
          <p class='text-light-300'>
            Ich entwickle einzigartige Logos in verschiedenen Stilen und Formaten – passend zu Ihrer Marke und für jeden Einsatzzweck.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-2xl p-8 hover:border-pink-500/40 transition-all duration-300' style='animation-delay: 0.9s'>
          <div class='w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-briefcase text-pink-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Ganzheitliches Corporate Design</h3>
          <p class='text-light-300'>
            Ich entwickle ein stimmiges Corporate Design für Ihr Unternehmen – von der Visitenkarte bis zum Webauftritt, von der Idee bis zum fertigen Konzept.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Design Process Section -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-pink-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-diagram-project text-pink-400 mr-2' aria-hidden='true'></i>
          Mein Prozess
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Strukturierter <span class='text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-rose-500'>Designprozess</span> in 3 Schritten
        </p>
        <p class="gsap-fadein text-xl text-light-300" style="animation-delay: 0.3s">
          Ich gestalte Ihre Designs nach einem bewährten, effizienten Prozess – für optimale Ergebnisse und maximale Transparenz.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.45s">
          <div class="w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6">
            <span class="text-3xl font-bold text-pink-400">1</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Analyse & Briefing</h3>
          <p class="text-light-300">
            Wir besprechen remote Ihre Ziele, Zielgruppe und Wünsche. Ich analysiere bestehende Materialien und sammle alle notwendigen Informationen.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.6s">
          <div class="w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6">
            <span class="text-3xl font-bold text-pink-400">2</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Konzept & Entwurf</h3>
          <p class="text-light-300">
            Auf Basis des Briefings entwickle ich erste Designideen und Konzepte. Dabei berücksichtige ich Ihre Anforderungen und aktuelle Designtrends.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.75s">
          <div class="w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6">
            <span class="text-3xl font-bold text-pink-400">3</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Feedback & Umsetzung</h3>
          <p class="text-light-300">
            Sie erhalten die Entwürfe zur Ansicht (über Figma/Miro) und geben mir Ihr Feedback. Ich setze Ihre Änderungswünsche um und finalisiere das Design.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Design Tools Section -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-950 to-dark-900">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-pink-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-toolbox text-pink-400 mr-2' aria-hidden='true'></i>
          Meine Design-Werkzeuge
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Professionelle <span class='text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-rose-500'>Tools</span> für beste Ergebnisse
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-6" style="animation-delay: 0.3s">
          <h3 class="text-sm font-semibold text-pink-400 mb-3">Design & Prototyping</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">Figma</span>
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">Illustrator</span>
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">Photoshop</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-6" style="animation-delay: 0.45s">
          <h3 class="text-sm font-semibold text-pink-400 mb-3">UI-Kits & Frameworks</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">TailwindCSS</span>
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">Material Design</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-6" style="animation-delay: 0.6s">
          <h3 class="text-sm font-semibold text-pink-400 mb-3">Print & Publishing</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">InDesign</span>
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">Illustrator</span>
            <span class="px-3 py-1 bg-pink-500/10 border border-pink-500/30 rounded-full text-sm text-light-200">Affinity Publisher</span>
          </div>
        </div>
      </div>
      
      <div class="mt-8 text-center">
        <div class="gsap-fadein inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 border border-green-500/30 rounded-full text-sm text-light-200" style="animation-delay: 0.75s">
          <i class='fa-solid fa-house-laptop text-green-400' aria-hidden='true'></i>
          <span>100% Remote Arbeit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Design Principles Section -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-pink-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-lightbulb text-pink-400 mr-2' aria-hidden='true'></i>
          Design-Philosophie
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Meine <span class='text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-rose-500'>Prinzipien</span> für gutes Design
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.3s">
          <div class="w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-bullseye text-pink-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Funktion vor Ästhetik</h3>
          <p class="text-light-300">
            Schönes Design muss vor allem FUNKTIONIEREN. Usability und User Experience stehen an erster Stelle.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.45s">
          <div class="w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-universal-access text-pink-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Barrierefreiheit = Standard</h3>
          <p class="text-light-300">
            Kontraste, Schriftgrößen, Screenreader-Support – ich entwickle für ALLE Nutzer, nicht nur für einige.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.6s">
          <div class="w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-mobile-screen text-pink-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Mobile First</h3>
          <p class="text-light-300">
            70%+ aller Nutzer sind mobil unterwegs. Ich designe zuerst für kleine Bildschirme, dann für Desktop.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.75s">
          <div class="w-14 h-14 bg-pink-500/10 border border-pink-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-arrows-rotate text-pink-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Iterativer Prozess</h3>
          <p class="text-light-300">
            Feedback-Schleifen statt "einmal abgenickt". Design entwickelt sich durch Dialog mit Ihnen weiter.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-900 to-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-pink-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-circle-question text-pink-400 mr-2' aria-hidden='true'></i>
          Häufig gestellte Fragen
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-pink-400 to-rose-500'>Fragen & Antworten</span> zum Design
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-6">
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.3s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-pink-400 mr-3' aria-hidden='true'></i>
            Liefern Sie auch Druckdaten?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Ja! Print-ready PDF (CMYK, 300dpi) inkl. Schnittmarken und Farbprofilen – direkt bereit für die Druckerei.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.45s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-pink-400 mr-3' aria-hidden='true'></i>
            Erstellen Sie auch Illustrationen/Icons?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Icons ja (vektorbasiert, skalierbar). Komplexe Illustrationen (z.B. Character Design) auf Anfrage oder über spezialisierte Partner.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.6s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-pink-400 mr-3' aria-hidden='true'></i>
            Wie viele Entwürfe erhalte ich?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Standard: 2-3 Konzepte zur Auswahl. Danach: 2 Revisions-Runden inklusive. Weitere Anpassungen nach Aufwand.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.75s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-pink-400 mr-3' aria-hidden='true'></i>
            Arbeiten Sie mit Brand Guidelines?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Selbstverständlich! Ich halte mich strikt an bestehende Corporate Design-Vorgaben (Farben, Schriften, Logos, Tonalität).
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-pink-500/20 rounded-xl p-8" style="animation-delay: 0.9s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-pink-400 mr-3' aria-hidden='true'></i>
            Arbeiten Sie vor Ort oder remote?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> 100% remote! Alle Design-Sprints, Feedbackrunden und Abnahmen führe ich über Figma, Miro und Videokonferenzen durch.
          </p>
        </div>
      </div>
    </div>
  </section>


  <PriceService />

  <Partner />

</Layout>
