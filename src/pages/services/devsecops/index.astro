---
import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'DevSecOps',
  link: 'https://waldheim.dev/services/devsecops'
}]);

const titel = 'DevSecOps Beratung Augsburg & München | Waldheim.dev';
const description = 'Professionelle DevSecOps-Beratung in Augsburg & München. CI/CD-Automatisierung, Kubernetes & Security für Ihr Unternehmen. Jetzt beraten lassen!';
const keywords = 'DevSecOps, DevOps, Continuous Integration, Continuous Delivery, CI/CD, Automatisierung, GitHub, GitLab, Sicherheit, Softwareentwicklung, Kubernetes, Docker, GitOps';

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'DevSecOps Beratung & Implementierung',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'DevSecOps Consulting',
  areaServed: 'DE',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/devsecops-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="DevSecOps"
    subtitle="Schneller & sicherer mit"
    description="Automatisierung, Sicherheit und Effizienz für Ihre Softwareentwicklung. Ich optimiere Ihre CI/CD-Pipelines, implementiere Container-Strategien und bringe Security in jeden Schritt Ihres Entwicklungsprozesses."
    gradient="purple"
    icon="fa-shield-check"
    badge="Kubernetes & GitOps Expertise"
  />

  <!-- Main Features Section -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark" id="leistungen">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-violet-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-shield-halved mr-2' aria-hidden='true'></i>
          Service-Fokus
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Zeitersparnis</span> durch Automatisierung
        </p>
        <p class="gsap-fadein text-xl text-meg-text-secondary" style="animation-delay: 0.3s">
          Ich helfe Ihnen, das volle Potenzial von DevSecOps auszuschöpfen.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {[
          { title: 'Containerisierung', desc: 'Isolierte, skalierbare und portable Anwendungen mit Docker & Kubernetes.', icon: 'fa-boxes-stacked' },
          { title: 'Künstliche Intelligenz', desc: 'Integration KI-gestützter Tools zur Code-Analyse und QS – DSGVO-konform.', icon: 'fa-brain' },
          { title: 'Security-Automatisierung', desc: 'Automatisierte Sicherheitschecks in jeder Phase des Prozesses.', icon: 'fa-shield' },
          { title: 'CI/CD & Testing', desc: 'Beschleunigte Zyklen durch automatisierte Builds und Deployments.', icon: 'fa-rocket' }
        ].map((feat, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/30 hover:shadow-lg hover:shadow-violet-500/5 transition-all duration-300 group" style={`animation-delay: ${0.45 + i * 0.15}s`}>
            <div class="w-14 h-14 bg-violet-500/10 border border-violet-500/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <i class={`fa-solid ${feat.icon} text-violet-400 text-2xl`}></i>
            </div>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4">{feat.title}</h3>
            <p class="text-meg-text-secondary leading-relaxed">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack Showcase -->
  <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-violet-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-toolbox mr-2' aria-hidden='true'></i>
          Technologie-Stack
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Moderne <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Werkzeuge</span>
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { label: 'CI/CD & GitOps', tools: ['GitLab CI', 'Flux'] },
          { label: 'Container', tools: ['Docker', 'Kubernetes', 'Helm'] },
          { label: 'Monitoring', tools: ['Prometheus', 'Grafana', 'Loki'] },
          { label: 'Security', tools: ['Trivy', 'SonarQube', 'OWASP'] },
          { label: 'Infrastructure', tools: ['Terraform'] },
          { label: 'Arbeitsweise', tools: ['100% Remote'], icon: 'fa-house-laptop' }
        ].map((stack, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 hover:border-violet-500/20 transition-all shadow-sm" style={`animation-delay: ${0.45 + i * 0.1}s`}>
            <h3 class="text-xs font-bold uppercase tracking-widest text-violet-400 mb-4">{stack.label}</h3>
            <div class="flex flex-wrap gap-2">
              {stack.tools.map(tool => (
                <span class="px-3 py-1 bg-meg-bg-dark/50 border border-meg-border-dark rounded-lg text-sm text-meg-text-secondary font-medium">
                  {stack.icon && <i class={`fa-solid ${stack.icon} mr-1 text-emerald-400`}></i>}
                  {tool}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DevSecOps Workflow -->
  <section class="py-24 px-6 bg-meg-bg-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-violet-400 mb-4" style="animation-delay: 0s">
          Workflow
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          In <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>4 Schritten</span> zum Erfolg
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
        {[
          { step: '1', title: 'Analyse', desc: 'Remote-Check Ihres aktuellen Tech-Stacks.' },
          { step: '2', title: 'Konzept', desc: 'Pipeline-Design passend zu Ihrer Größe.' },
          { step: '3', title: 'Migration', desc: 'Schritt-für-Schritt Einführung mit Quick Wins.' },
          { step: '4', title: 'Training', desc: 'Remote Schulungen für Ihr Team.' }
        ].map((item, i) => (
          <div class="gsap-fadein text-center group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <div class="size-16 bg-meg-surface-dark border border-meg-border-dark rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm group-hover:border-violet-500/50 group-hover:bg-violet-500/5 transition-all duration-500">
              <span class="text-3xl font-black text-violet-400">{item.step}</span>
            </div>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-3">{item.title}</h3>
            <p class="text-meg-text-secondary text-sm px-4">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-violet-400 mb-4" style="animation-delay: 0s">
          FAQ
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Fragen & <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Antworten</span>
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {[
          { q: 'Brauche ich Kubernetes?', a: 'Nein! Docker Compose oder K3s reichen oft völlig aus. Ich wähle immer die passende Lösung für Ihre Anforderungen.' },
          { q: 'Wie lange dauert die Migration?', a: 'Je nach Komplexität 2-6 Wochen. Wir starten mit Quick Wins und bauen die Automatisierung schrittweise aus.' },
          { q: 'Unterstützen Sie alle Plattformen?', a: 'Ja! Ich arbeite remote mit GitHub, GitLab, Bitbucket, Azure DevOps und weiteren.' }
        ].map((faq, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/20 transition-all shadow-sm" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <h3 class="text-lg font-bold text-meg-text-primary-dark mb-4 flex items-start gap-3">
              <span class="text-violet-400 font-black">Q</span>
              {faq.q}
            </h3>
            <p class="text-meg-text-secondary pl-7 leading-relaxed">
              <span class="text-meg-accent font-bold mr-2">A:</span>
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DevSecOps Benefits Bento Grid -->
  <section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-violet-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-rocket mr-2' aria-hidden='true'></i>
          Vorteile
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Optimierter <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Deployment-Prozess</span>
        </p>
        <p class="gsap-fadein text-xl text-meg-text-secondary" style="animation-delay: 0.3s">
          Von der Entwicklung bis zum Betrieb – effizient, sicher und remote
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {[
          { title: 'Performance-Optimierung', desc: 'Ich analysiere und optimiere Ihre Build-Prozesse für maximale Geschwindigkeit und Effizienz.', icon: 'fa-gauge-high' },
          { title: 'Automatisierte Releases', desc: 'Vollautomatische Release-Pipelines für häufige, zuverlässige und qualitativ hochwertige Software-Updates.', icon: 'fa-code-branch' },
          { title: 'Skalierbarkeit & Flexibilität', desc: 'Ihre Infrastruktur wird fit für die Zukunft – skalierbar, flexibel und ortsunabhängig.', icon: 'fa-up-right-and-down-left-from-center' },
          { title: 'Tool-Integration', desc: 'Nahtlose Zusammenarbeit Ihrer Entwicklungstools für einen effizienten Workflow.', icon: 'fa-puzzle-piece' },
          { title: 'Ortsunabhängig', desc: '100% remote Arbeit – sicher und stabil von überall entwickeln und deployen.', icon: 'fa-globe' },
          { title: 'Monitoring & Observability', desc: 'Vollständige Transparenz über Ihre Systeme mit Prometheus, Grafana und Loki.', icon: 'fa-chart-line' }
        ].map((benefit, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/30 transition-all shadow-sm group" style={`animation-delay: ${0.45 + i * 0.1}s`}>
            <div class="w-14 h-14 bg-violet-500/10 border border-violet-500/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <i class={`fa-solid ${benefit.icon} text-violet-400 text-2xl`}></i>
            </div>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4">{benefit.title}</h3>
            <p class="text-meg-text-secondary leading-relaxed text-sm">{benefit.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deployment Strategies Comparison -->
  <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-violet-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-chart-simple mr-2' aria-hidden='true'></i>
          Vergleich
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Deployment-<span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Strategien</span>
        </p>
        <p class="gsap-fadein text-xl text-meg-text-secondary" style="animation-delay: 0.3s">
          Ich helfe Ihnen, die passende Deployment-Methode für Ihre Anforderungen zu finden
        </p>
      </div>
      
      <div tabindex="0" class="overflow-x-auto rounded-2xl border border-meg-border-dark bg-meg-surface-dark/30 backdrop-blur-md shadow-sm" role="region" aria-label="Deployment-Vergleichstabelle">
        <table class="w-full text-left border-collapse">
          <thead class="bg-meg-surface-dark/50 text-meg-text-primary-dark">
            <tr>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark">Feature</th>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark">Native (Skripte/SSH)</th>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark">Docker</th>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark bg-violet-500/5">
                <div class="flex items-center gap-2">
                  Kubernetes
                  <i class="fa-solid fa-star text-violet-400 text-xs" aria-label="Empfohlen" role="img"></i>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="text-meg-text-secondary">
            {[
              { f: 'Deployment-Prinzip', c1: 'Manuelle Skripte, SSH', c2: 'Container-Images', c3: 'Deklarative Manifests (YAML)' },
              { f: 'Skalierung', c1: 'Manuell', c2: 'Mit Tools (Swarm)', c3: 'Automatisch (HPA)', green: true },
              { f: 'Rollback', c1: 'Komplex', c2: 'Via Tags', c3: 'Ein Befehl', green: true },
              { f: 'Komplexität', c1: 'Niedrig', c2: 'Mittel', c3: 'Hoch (ab ~5 Services)', orange: true },
              { f: 'Ideal für', c1: 'Prototypen, MVPs', c2: 'Kleinere Projekte', c3: 'Produktion, Multi-Service' },
              { f: 'Kosten', c1: '€ (Server only)', c2: '€€ (Server + Reg)', c3: '€€€ (Cluster + Ress)', orange: true }
            ].map((row) => (
              <tr class="border-b border-meg-border-dark/50 hover:bg-meg-accent/5 transition-colors">
                <td class="px-6 py-4 font-bold text-meg-text-primary-dark">{row.f}</td>
                <td class="px-6 py-4">{row.c1}</td>
                <td class="px-6 py-4">{row.c2}</td>
                <td class={`px-6 py-4 bg-violet-500/5 font-medium ${row.green ? 'text-emerald-400' : row.orange ? 'text-orange-400' : 'text-meg-text-primary-dark'}`}>{row.c3}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      
      <div class="mt-16 text-center">
        <div class="gsap-fadein inline-flex items-center gap-3 px-4 py-2 bg-meg-surface-dark/50 border border-meg-border-dark rounded-full shadow-sm">
          <i class="fa-solid fa-lightbulb text-violet-400 text-xs"></i>
          <p class="text-meg-text-secondary text-[10px] font-black uppercase tracking-widest">
            Ich berate Sie bei der Wahl der passenden Strategie
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-violet-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-circle-question mr-2' aria-hidden='true'></i>
          Häufig gestellte Fragen
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Fragen & <span class='text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500'>Antworten</span> zu DevSecOps
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-6">
        {[
          { q: 'Brauche ich Kubernetes für DevSecOps?', a: 'Nein! Docker Compose oder K3s reichen oft völlig aus. Ich wähle immer die passende Lösung für Ihre Unternehmensgröße und Anforderungen – ohne unnötige Komplexität.' },
          { q: 'Wie lange dauert die Migration zu DevSecOps?', a: 'Je nach Komplexität 2-6 Wochen. Wir starten mit Quick Wins (z.B. automatisierte Tests) und bauen die Automatisierung schrittweise aus – remote und agil.' },
          { q: 'Was kostet ein CI/CD-Setup?', a: 'Ab 2.500€ für eine Basic-Pipeline (automatisierte Tests + Deploy). Enterprise-Lösungen mit Monitoring, Security-Scans und GitOps auf Anfrage.' },
          { q: 'Unterstützen Sie auch GitLab/Azure DevOps/Bitbucket?', a: 'Ja! Ich bin plattformunabhängig und arbeite remote mit GitHub, GitLab, Bitbucket, Azure DevOps und weiteren Plattformen.' },
          { q: 'Arbeiten Sie vor Ort oder remote?', a: '100% remote! Alle Analysen, Implementierungen und Schulungen führe ich über moderne Remote-Tools durch – deutschlandweit und international.' }
        ].map((faq, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/20 transition-all shadow-sm group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4 flex items-start gap-3">
              <span class="text-violet-400 font-black">Q</span>
              {faq.q}
            </h3>
            <p class="text-meg-text-secondary pl-10 leading-relaxed">
              <strong class="text-meg-text-primary-dark mr-2">A:</strong>
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PriceService />

  <RelatedServices />

  <Partner />
</Layout>
