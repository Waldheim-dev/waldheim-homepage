---
import PromoSuite from '../../../components/PromoSuite.astro';
import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import Blog from '../../../components/Blog.astro';
import { SchemaUtils } from '../../../utils/schema';
import AiImageBadge from '../../../components/AiImageBadge.astro';

// SEO & Meta
const titel = 'DevSecOps & Cloud-Infrastruktur Augsburg & München | CI/CD, Kubernetes & Security';
const description = 'Ihr DevSecOps-Experte in Bayern: Sichere CI/CD-Pipelines, Kubernetes-Cluster, Terraform, GitOps und Cloud-Infrastruktur für schnellere Releases ohne Sicherheitskompromisse. KMU & Startups.';
const keywords = 'DevSecOps Beratung Augsburg, CI/CD Automatisierung Bayern, Kubernetes Consulting München, Cloud Security KMU, GitOps Experte Augsburg, Terraform Bayern, Cloud-Infrastruktur KMU, Sichere Software-Lieferkette';
const ogImage = 'https://waldheim.dev/services/devsecops-og.jpg';

// Structured Data: Professional Service (Specific to DevSecOps)
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'DevSecOps Beratung & Implementierung',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Waldheim.dev',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Augsburg',
      'addressRegion': 'Bayern',
      'addressCountry': 'DE'
    }
  },
  'serviceType': 'IT Consulting',
  'areaServed': [
    { '@type': 'City', 'name': 'Augsburg' },
    { '@type': 'City', 'name': 'München' }
  ],
  'description': 'Automatisierung der Software-Lieferkette, Integration von Sicherheits-Scans (SAST/DAST) und Aufbau hochverfügbarer Kubernetes-Cluster.',
  'offers': {
    '@type': 'Offer',
    'description': 'Individuelles DevSecOps-Audit und Implementierungspakete'
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'DevSecOps',
  link: 'https://waldheim.dev/services/devsecops'
}]);

const faqSchema = SchemaUtils.getFAQSchema([
  {
    question: 'Welche Vorteile bietet DevSecOps für mein Unternehmen?',
    answer: 'Durch die Integration von Sicherheit in den CI/CD-Prozess (Shift-Left) werden Schwachstellen früher erkannt, was die Kosten für Fehlerbehebungen senkt und die Zeit bis zum Release (Time-to-Market) verkürzt.'
  },
  {
    question: 'Unterstützen Sie auch bestehende Infrastrukturen?',
    answer: 'Ja, ich analysiere Ihre aktuelle Pipeline (GitHub, GitLab, Jenkins) und integriere schrittweise Sicherheits-Scans, Containerisierung und automatisierte Deployments – ohne den laufenden Betrieb zu stören.'
  },
  {
    question: 'Bieten Sie auch Kubernetes-Support in Augsburg an?',
    answer: 'Absolut. Ich unterstütze lokale Unternehmen in Augsburg und München bei der Einrichtung, Absicherung und Skalierung von Kubernetes-Clustern (K3s, EKS, GKE).'
  }
]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema, faqSchema]}
  image={ogImage}
>
  <main id="main-content">
    <!-- Hero Section: Fokus auf ROI & Sicherheit -->
    <ServiceHero 
      title="DevSecOps & Cloud"
      subtitle="Sicherheit & Speed für Ihre Software –"
      description="Verkürzen Sie Ihre Release-Zyklen und eliminieren Sie Sicherheitsrisiken durch automatisierte Pipelines. Ich implementiere maßgeschneiderte DevSecOps-Strategien und Cloud-Infrastruktur für KMU und Startups in Augsburg und München."
      gradient="purple"
      icon="fa-shield-halved"
      badge="Kubernetes · GitOps · Terraform · Cloud Security"
    />

    <!-- Value Proposition: Warum DevSecOps? -->
    <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="benefits-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein mx-auto max-w-2xl text-center mb-16">
          <h2 id="benefits-heading" class="text-sm font-bold uppercase tracking-widest text-violet-400 mb-4">
            Der Business-Case
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500">Shift-Left</span> für Ihren Erfolg
          </p>
          <p class="text-xl text-meg-text-secondary">
            Sicherheit ist kein Hindernis, sondern ein Beschleuniger. Entdecken Sie, wie Automatisierung Ihre Entwicklung transformiert.
          </p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-bolt text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Speed-to-Market</h3>
            <p class="text-meg-text-secondary text-sm">Automatisierte Deployments reduzieren manuelle Fehler und bringen Features schneller zum Kunden.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-user-shield text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Risiko-Minimierung</h3>
            <p class="text-meg-text-secondary text-sm">Integrierte SAST/DAST-Scans finden Sicherheitslücken, bevor sie die Produktion erreichen.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-chart-line text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Kosteneffizienz</h3>
            <p class="text-meg-text-secondary text-sm">Frühe Fehlererkennung spart bis zu 40% der Entwicklungskosten für nachträgliche Bugfixes.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-scale-balanced text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Compliance</h3>
            <p class="text-meg-text-secondary text-sm">Lückenlose Dokumentation und automatisierte Audits für höchste regulatorische Ansprüche.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Tech-Expertise -->
    <section class="py-24 px-6 border-y border-meg-border-dark">
      <div class="mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl font-bold mb-6">Expertise in <span class="text-violet-400">Cloud-Native</span> Technologien</h2>
            <p class="text-meg-text-secondary mb-8">
              Ich setze auf bewährte Open-Source-Tools und moderne Standards, um Ihre Infrastruktur zukunftssicher zu gestalten. Mein Fokus liegt auf Transparenz und Portabilität – kein Vendor-Lock-in.
            </p>
            <ul class="space-y-4">
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400"></i>
                <span class="text-meg-text-primary-dark font-semibold">Kubernetes & Docker:</span> Skalierbare Container-Orchestrierung.
              </li>
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400"></i>
                <span class="text-meg-text-primary-dark font-semibold">GitLab & GitHub Actions:</span> Hochperformante CI/CD Pipelines.
              </li>
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400"></i>
                <span class="text-meg-text-primary-dark font-semibold">Terraform:</span> Infrastructure as Code (IaC) für reproduzierbare Umgebungen.
              </li>
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400"></i>
                <span class="text-meg-text-primary-dark font-semibold">Prometheus & Grafana:</span> Full-Stack Observability & Monitoring.
              </li>
            </ul>
          </div>
          <div class="relative bg-meg-surface-dark/30 rounded-3xl p-4 ring-1 ring-meg-border-dark">
            <video src="/videos/video_devsecops.mp4" poster="/videos/video_devsecops-poster.webp" loop muted playsinline autoplay class="rounded-2xl w-full"></video>
            <AiImageBadge class="absolute top-3 right-3 z-10" />
          </div>
        </div>
      </div>
    </section>

    <!-- Workflow: Der Weg zur DevSecOps Excellence -->
    <section class="py-24 px-6" aria-labelledby="workflow-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein text-center mb-16">
          <h2 id="workflow-heading" class="text-3xl font-black tracking-tight">Ihr Fahrplan zum <span class="text-violet-400">Secure Release</span></h2>
        </header>
        <div class="relative">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-meg-border-dark hidden lg:block"></div>
          <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 relative z-10">
            {[
              { step: '01', title: 'Audit', desc: 'Analyse Ihrer aktuellen Lieferkette und Identifikation von Risiken.' },
              { step: '02', title: 'Strategie', desc: 'Entwurf einer Roadmap für Automatisierung und Sicherheitsintegration.' },
              { step: '03', title: 'Build', desc: 'Implementierung der Pipelines und Cloud-Infrastruktur.' },
              { step: '04', title: 'Scale', desc: 'Kontinuierliche Optimierung und Team-Coaching für agilen Betrieb.' }
            ].map((s) => (
              <li class="bg-meg-bg-dark border border-meg-border-dark p-6 rounded-2xl text-center hover:border-violet-500/50 transition-all">
                <span class="text-4xl font-black text-violet-500/20 block mb-4">{s.step}</span>
                <h3 class="text-lg font-bold mb-2">{s.title}</h3>
                <p class="text-sm text-meg-text-secondary">{s.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- SaaS Suite Promotion -->
    <PromoSuite />

    <!-- FAQ -->
    <section class="py-24 px-6 bg-meg-surface-dark/20 border-t border-meg-border-dark">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-3xl font-bold text-center mb-12 gsap-fadein">Häufige Fragen zu <span class="text-violet-400">DevSecOps</span></h2>
        <div class="space-y-6">
          {faqSchema.mainEntity.map((faq) => (
            <details class="group border border-meg-border-dark rounded-2xl p-6 bg-meg-surface-dark/50 cursor-pointer">
              <summary class="flex justify-between items-center font-bold text-meg-text-primary-dark list-none">
                {faq.name}
                <span class="text-violet-400 group-open:rotate-180 transition-transform">
                  <i class="fa-solid fa-chevron-down"></i>
                </span>
              </summary>
              <p class="mt-4 text-meg-text-secondary leading-relaxed border-t border-meg-border-dark pt-4">
                {faq.acceptedAnswer.text}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PriceService />
    <Blog limits={2} />
    <RelatedServices />
    <Partner />
  </main>
</Layout>