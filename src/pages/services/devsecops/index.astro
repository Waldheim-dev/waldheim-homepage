---
import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'DevSecOps',
  link: 'https://waldheim.dev/services/devsecops'
}]);

const titel = 'DevSecOps Services - Automatisierung & Sicherheit | waldheim.dev';
const description = 'DevSecOps-Beratung Augsburg & München: CI/CD-Automatisierung, Kubernetes, GitOps und Security. Wir optimieren Ihre Entwicklungsprozesse remote & vor Ort in Bayern.';
const keywords = 'DevSecOps, DevOps, Continuous Integration, Continuous Delivery, CI/CD, Automatisierung, GitHub, GitLab, Sicherheit, Softwareentwicklung, Kubernetes, Docker, GitOps';

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'DevSecOps Beratung & Implementierung',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'DevSecOps Consulting',
  areaServed: 'DE',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/devsecops-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="DevSecOps"
    subtitle="Schneller & sicherer mit"
    description="Automatisierung, Sicherheit und Effizienz für Ihre Softwareentwicklung. Ich optimiere Ihre CI/CD-Pipelines, implementiere Container-Strategien und bringe Security in jeden Schritt Ihres Entwicklungsprozesses."
    gradient="purple"
    icon="fa-shield-check"
    badge="Kubernetes & GitOps Expertise"
  />

  <!-- Main Features Section -->
  <section class="py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900" id="leistungen">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-purple-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-shield-halved text-purple-400 mr-2' aria-hidden='true'></i>
          DevSecOps: Mehr als nur ein Buzzword
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400'>Zeitersparnis</span> durch Optimierung
        </p>
        <p class="gsap-fadein text-xl text-light-300" style="animation-delay: 0.3s">
          Ich helfe Ihnen, das volle Potenzial von DevSecOps auszuschöpfen. Profitieren Sie von:
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-2xl p-8 hover:border-purple-500/40 transition-all duration-300" style="animation-delay: 0.45s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-boxes-stacked text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Containerisierung (Docker & Kubernetes)</h3>
          <p class="text-light-300">
            Ich sorge für isolierte, skalierbare und portable Anwendungen – egal ob on-premise oder in der Cloud.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-2xl p-8 hover:border-purple-500/40 transition-all duration-300" style="animation-delay: 0.6s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-brain text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Künstliche Intelligenz (KI)</h3>
          <p class="text-light-300">
            Ich integriere KI-gestützte Tools zur Prozessoptimierung, Code-Analyse und Qualitätssicherung – DSGVO-konform.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-2xl p-8 hover:border-purple-500/40 transition-all duration-300" style="animation-delay: 0.75s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-shield text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Security-Automatisierung</h3>
          <p class="text-light-300">
            Ich implementiere automatisierte Sicherheitschecks in jeder Phase des Entwicklungsprozesses – für sichere Software von Anfang an.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-2xl p-8 hover:border-purple-500/40 transition-all duration-300" style="animation-delay: 0.9s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-rocket text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">CI/CD & Testautomatisierung</h3>
          <p class="text-light-300">
            Ich beschleunige Ihre Entwicklungszyklen durch automatisierte Builds, Tests und Deployments. So können Sie sich auf das Wesentliche konzentrieren: Ihre Software.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack Showcase -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-purple-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-toolbox text-purple-400 mr-2' aria-hidden='true'></i>
          Mein DevSecOps-Stack
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Die <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400'>richtigen Tools</span> für Ihren Erfolg
        </p>
        <p class="gsap-fadein text-xl text-light-300" style="animation-delay: 0.3s">
          Ich arbeite ausschließlich remote und setze auf bewährte, moderne Technologien
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-6" style="animation-delay: 0.45s">
          <h3 class="text-sm font-semibold text-purple-400 mb-3">CI/CD & GitOps</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">GitLab CI</span>
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Flux</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-6" style="animation-delay: 0.6s">
          <h3 class="text-sm font-semibold text-purple-400 mb-3">Container & Orchestrierung</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Docker</span>
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Kubernetes</span>
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Helm</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-6" style="animation-delay: 0.75s">
          <h3 class="text-sm font-semibold text-purple-400 mb-3">Monitoring & Observability</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Prometheus</span>
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Grafana</span>
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Loki</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-6" style="animation-delay: 0.9s">
          <h3 class="text-sm font-semibold text-purple-400 mb-3">Security & Compliance</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Trivy</span>
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">SonarQube</span>
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">OWASP</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-6" style="animation-delay: 1.05s">
          <h3 class="text-sm font-semibold text-purple-400 mb-3">Infrastructure as Code</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-purple-500/10 border border-purple-500/30 rounded-full text-sm text-light-200">Terraform</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-6" style="animation-delay: 1.2s">
          <h3 class="text-sm font-semibold text-purple-400 mb-3">Arbeitsweise</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-green-500/10 border border-green-500/30 rounded-full text-sm text-light-200">
              <i class='fa-solid fa-house-laptop mr-1' aria-hidden='true'></i>
              100% Remote
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DevSecOps Workflow -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-950 to-dark-900">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-purple-400 mb-4" style="animation-delay: 0s">
          Strukturierter Prozess
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Mein DevSecOps-Workflow in <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400'>4 Schritten</span>
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-6xl mx-auto">
        <div class="gsap-fadein text-center" style="animation-delay: 0.3s">
          <div class="w-16 h-16 bg-purple-500/10 border border-purple-500/30 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl font-bold text-purple-400">1</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Analyse</h3>
          <p class="text-light-300">
            Ihr aktueller Tech-Stack & Pain Points werden remote analysiert
          </p>
        </div>
        
        <div class="gsap-fadein text-center" style="animation-delay: 0.45s">
          <div class="w-16 h-16 bg-purple-500/10 border border-purple-500/30 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl font-bold text-purple-400">2</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Konzept</h3>
          <p class="text-light-300">
            Pipeline-Design + Tool-Auswahl passend zu Ihrer Größe
          </p>
        </div>
        
        <div class="gsap-fadein text-center" style="animation-delay: 0.6s">
          <div class="w-16 h-16 bg-purple-500/10 border border-purple-500/30 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl font-bold text-purple-400">3</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Migration</h3>
          <p class="text-light-300">
            Schritt-für-Schritt Einführung mit Quick Wins
          </p>
        </div>
        
        <div class="gsap-fadein text-center" style="animation-delay: 0.75s">
          <div class="w-16 h-16 bg-purple-500/10 border border-purple-500/30 rounded-2xl flex items-center justify-center mx-auto mb-6">
            <span class="text-3xl font-bold text-purple-400">4</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Training</h3>
          <p class="text-light-300">
            Ihr Team lernt die neuen Prozesse (remote Schulungen)
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- DevSecOps Benefits Bento Grid -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-900 to-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-purple-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-rocket text-purple-400 mr-2' aria-hidden='true'></i>
          Schnelleres Deployment, höhere Qualität
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Ich optimiere Ihren gesamten <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400'>Deployment-Prozess</span>
        </p>
        <p class="gsap-fadein text-xl text-light-300" style="animation-delay: 0.3s">
          Von der Entwicklung bis zum Betrieb – effizient, sicher und remote
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-8 hover:border-purple-500/40 transition-all" style="animation-delay: 0.45s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-gauge-high text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Performance-Optimierung</h3>
          <p class="text-light-300">
            Ich analysiere und optimiere Ihre Build-Prozesse für maximale Geschwindigkeit und Effizienz.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-8 hover:border-purple-500/40 transition-all" style="animation-delay: 0.6s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-code-branch text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Automatisierte Releases</h3>
          <p class="text-light-300">
            Vollautomatische Release-Pipelines für häufige, zuverlässige und qualitativ hochwertige Software-Updates.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-8 hover:border-purple-500/40 transition-all" style="animation-delay: 0.75s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-up-right-and-down-left-from-center text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Skalierbarkeit & Flexibilität</h3>
          <p class="text-light-300">
            Ihre Infrastruktur wird fit für die Zukunft – skalierbar, flexibel und ortsunabhängig.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-8 hover:border-purple-500/40 transition-all" style="animation-delay: 0.9s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-puzzle-piece text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Tool-Integration</h3>
          <p class="text-light-300">
            Nahtlose Zusammenarbeit Ihrer Entwicklungstools für einen effizienten Workflow.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-8 hover:border-purple-500/40 transition-all" style="animation-delay: 1.05s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-globe text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Ortsunabhängig</h3>
          <p class="text-light-300">
            100% remote Arbeit – sicher und stabil von überall entwickeln und deployen.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-purple-500/20 rounded-xl p-8 hover:border-purple-500/40 transition-all" style="animation-delay: 1.2s">
          <div class="w-14 h-14 bg-purple-500/10 border border-purple-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-chart-line text-purple-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Monitoring & Observability</h3>
          <p class="text-light-300">
            Vollständige Transparenz über Ihre Systeme mit Prometheus, Grafana und Loki.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Deployment Strategies Comparison -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-purple-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-chart-simple text-purple-400 mr-2' aria-hidden='true'></i>
          Deployment-Strategien im Vergleich
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Welches <span class='text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400'>Deployment</span> kann was?
        </p>
        <p class="gsap-fadein text-xl text-light-300" style="animation-delay: 0.3s">
          Ich helfe Ihnen, die passende Deployment-Methode für Ihre Anforderungen zu finden
        </p>
      </div>
      
      <div tabindex="0" class="overflow-x-auto rounded-xl border border-purple-500/20" role="region" aria-label="Deployment-Vergleichstabelle">
        <table class="w-full text-left border-collapse">
          <caption class="sr-only">Deployment-Strategien Vergleich</caption>
          <thead class="bg-dark-900/50">
            <tr>
              <th class="px-6 py-4 text-light-100 font-semibold border-b border-purple-500/20">Feature</th>
              <th class="px-6 py-4 text-light-100 font-semibold border-b border-purple-500/20">Native (Skripte/SSH)</th>
              <th class="px-6 py-4 text-light-100 font-semibold border-b border-purple-500/20">Docker</th>
              <th class="px-6 py-4 text-light-100 font-semibold border-b border-purple-500/20 bg-purple-500/5">
                <div class="flex items-center gap-2">
                  Kubernetes
                  <i class="fa-solid fa-star text-purple-400 text-xs" aria-label="Empfohlen" role="img"></i>
                </div>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-purple-500/10">
              <td class="px-6 py-4 text-light-300 font-medium">Deployment-Prinzip</td>
              <td class="px-6 py-4 text-light-300">Manuelle Skripte, SSH</td>
              <td class="px-6 py-4 text-light-300">Container-Images</td>
              <td class="px-6 py-4 text-light-300 bg-purple-500/5">Deklarative Manifests (YAML)</td>
            </tr>
            
            <tr class="border-b border-purple-500/10">
              <td class="px-6 py-4 text-light-300 font-medium">Skalierung</td>
              <td class="px-6 py-4">
                <i class="fa-solid fa-xmark text-red-400" aria-label="Nicht unterstützt" role="img"></i>
                <span class="text-light-400 ml-2">Manuell</span>
              </td>
              <td class="px-6 py-4">
                <i class="fa-solid fa-check text-yellow-400" aria-label="Teilweise unterstützt" role="img"></i>
                <span class="text-light-400 ml-2">Mit Tools (Swarm)</span>
              </td>
              <td class="px-6 py-4 bg-purple-500/5">
                <i class="fa-solid fa-check text-green-400" aria-label="Vollständig unterstützt" role="img"></i>
                <span class="text-light-400 ml-2">Automatisch (HPA)</span>
              </td>
            </tr>
            
            <tr class="border-b border-purple-500/10">
              <td class="px-6 py-4 text-light-300 font-medium">Rollback</td>
              <td class="px-6 py-4">
                <i class="fa-solid fa-xmark text-red-400" aria-label="Nicht unterstützt" role="img"></i>
                <span class="text-light-400 ml-2">Komplex</span>
              </td>
              <td class="px-6 py-4">
                <i class="fa-solid fa-check text-yellow-400" aria-label="Teilweise unterstützt" role="img"></i>
                <span class="text-light-400 ml-2">Via Tags</span>
              </td>
              <td class="px-6 py-4 bg-purple-500/5">
                <i class="fa-solid fa-check text-green-400" aria-label="Vollständig unterstützt" role="img"></i>
                <span class="text-light-400 ml-2">Ein Befehl</span>
              </td>
            </tr>
            
            <tr class="border-b border-purple-500/10">
              <td class="px-6 py-4 text-light-300 font-medium">Komplexität</td>
              <td class="px-6 py-4 text-green-400">Niedrig</td>
