  }
]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema, faqSchema]}
  image={ogImage}
>
  <main id="main-content">
    <!-- Hero Section: Fokus auf ROI & Sicherheit -->
    <ServiceHero 
      title="DevSecOps, FinOps & AIOps"
      subtitle="Sicherheit, Cloud-Effizienz & 10x AI-Automation –"
      description="Verkürzen Sie Ihre Release-Zyklen, senken Sie Cloud-Kosten durch FinOps und nutzen Sie AIOps sowie eigene AI-Review- & Skill-Automationen (>1.000% Produktivität). Inklusive Hands-on Team-Coaching für KMU und Enterprise-Teams."
      gradient="purple"
      icon="fa-shield-halved"
      badge="DevSecOps · FinOps · AIOps · AI Review & Skills Coaching"
    />

    <!-- Value Proposition: Warum DevSecOps, FinOps & AIOps? -->
    <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="benefits-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein mx-auto max-w-2xl text-center mb-16">
          <h2 id="benefits-heading" class="text-sm font-bold uppercase tracking-widest text-violet-400 mb-4">
            Ganzheitliche Cloud- &amp; Pipeline-Exzellenz
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-fuchsia-500">DevSecOps, FinOps &amp; AIOps</span> vereint
          </p>
          <p class="text-xl text-meg-text-secondary">
            Sicherheit, Kostenkontrolle und KI-gestützte Operations greifen nahtlos ineinander – inklusive Team-Coaching für eigene AI-Automationen.
          </p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-bolt text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Speed-to-Market &amp; GitOps</h3>
            <p class="text-meg-text-secondary text-sm">Automatisierte CI/CD-Pipelines und deklaratives GitOps (FluxCD, ArgoCD, Terraform) bringen Features reproduzierbar und fehlerfrei in Produktion.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-user-shield text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Shift-Left Security &amp; Compliance</h3>
            <p class="text-meg-text-secondary text-sm">Integrierte SAST/DAST-Scans, SBOM, Cosign-Signierung und Supply-Chain-Härtung finden Schwachstellen, bevor sie die Produktion erreichen.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-coins text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">FinOps &amp; Cloud-Kostenkontrolle</h3>
            <p class="text-meg-text-secondary text-sm">Transparenz über Cluster- und Cloud-Ausgaben (OpenCost, Right-Sizing, Auto-Scaling). Eliminieren Sie Überprovisionierung und senken Sie laufende Cloud-Kosten drastisch.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-microchip text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">AIOps &amp; Smart Observability</h3>
            <p class="text-meg-text-secondary text-sm">KI-gestützte Log-, Trace- und Metrik-Korrelation (OpenTelemetry, Prometheus, Loki, Tempo). Intelligente Anomalie-Erkennung und automatisierte Root-Cause-Analyse statt Alert-Fatigue.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-wand-magic-sparkles text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">AI Review &amp; Skill-Automationen</h3>
            <p class="text-meg-text-secondary text-sm">Selbst gebaute AI-Code-Review-Pipelines, Security-Review-Agenten und wiederverwendbare Skills automatisieren PR-Prüfungen, Changelogs und Compliance-Checks.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-violet-500/40 transition-all">
            <i class="fa-solid fa-chalkboard-user text-violet-400 text-3xl mb-6" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">10x DevSecOps &amp; AI Team-Coaching</h3>
            <p class="text-meg-text-secondary text-sm">Praxisnahes Enablement für Ihr Team: Wie Sie mit maßgeschneiderten AI-Skills, Guardrails und Automationen über 1.000% (10x) Produktivität im DevSecOps-Alltag erreichen.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Tech-Expertise -->
    <section class="py-24 px-6 border-y border-meg-border-dark">
      <div class="mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl font-bold mb-6">Expertise in <span class="text-violet-400">Cloud-Native, FinOps &amp; AIOps</span></h2>
            <p class="text-meg-text-secondary mb-8">
              Ich setze auf bewährte Open-Source-Tools, moderne Cloud-Standards und selbst entwickelte AI-Automationen, um Ihre Infrastruktur zukunftssicher, kosteneffizient und hochgradig automatisiert zu betreiben – ohne Vendor-Lock-in.
            </p>
            <ul class="space-y-4">
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i>
                <span><strong class="text-meg-text-primary-dark font-semibold">Kubernetes, FluxCD &amp; Terraform:</strong> Deklarative GitOps- &amp; IaC-Infrastruktur (AWS, Azure, GCP, IONOS).</span>
              </li>
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i>
                <span><strong class="text-meg-text-primary-dark font-semibold">AI Reviews &amp; Skills-Coaching:</strong> Eigene AI-Review-Bots, MCP-Integrationen &amp; Team-Enablement für &gt;1.000% (10x) Produktivität.</span>
              </li>
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i>
                <span><strong class="text-meg-text-primary-dark font-semibold">FinOps &amp; AIOps Stack:</strong> OpenCost, OpenTelemetry, Prometheus, Grafana, Loki &amp; KI-gestützte Incident-Analyse.</span>
              </li>
              <li class="flex items-center gap-3">
                <i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i>
                <span><strong class="text-meg-text-primary-dark font-semibold">GitLab CI &amp; GitHub Actions:</strong> Hochperformante Pipelines mit Trivy, SonarQube &amp; Policy-Guards.</span>
              </li>
              <li class="flex items-start gap-3">
                <i class="fa-solid fa-check text-emerald-400 mt-1" aria-hidden="true"></i>
                <span><strong class="text-meg-text-primary-dark font-semibold">semrel (v0.28.2 Open Source):</strong> Eigenentwickelte Go-native Release- &amp; Supply-Chain-Automation (Workspace 2.0, Cosign v3, SBOM, SLSA, Air-Gap). <a href="/semrel/" class="text-violet-400 font-bold underline hover:text-violet-300">semrel entdecken →</a></span>
              </li>
            </ul>
          </div>
          <div class="relative bg-meg-surface-dark/30 rounded-3xl p-4 ring-1 ring-meg-border-dark">
            <video src="/videos/video_devsecops.mp4" poster="/videos/video_devsecops-poster.webp" loop muted playsinline autoplay class="rounded-2xl w-full"></video>
            <AiImageBadge class="absolute bottom-2.5 right-2.5 z-10" />
          </div>
        </div>
      </div>
    </section>

    <!-- Workflow: Der Weg zur DevSecOps Excellence -->
    <section class="py-24 px-6" aria-labelledby="workflow-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein text-center mb-16">
          <h2 id="workflow-heading" class="text-3xl font-black tracking-tight">Ihr Fahrplan zum <span class="text-violet-400">Secure Release</span></h2>
        </header>
        <div class="relative">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-meg-border-dark hidden lg:block"></div>
          <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 relative z-10">
            {[
              { step: '01', title: 'Audit', desc: 'Analyse Ihrer aktuellen Lieferkette und Identifikation von Risiken.' },
              { step: '02', title: 'Strategie', desc: 'Entwurf einer Roadmap für Automatisierung und Sicherheitsintegration.' },
              { step: '03', title: 'Build', desc: 'Implementierung der Pipelines und Cloud-Infrastruktur.' },
              { step: '04', title: 'Scale', desc: 'Kontinuierliche Optimierung und Team-Coaching für agilen Betrieb.' }
            ].map((s) => (
              <li class="bg-meg-bg-dark border border-meg-border-dark p-6 rounded-2xl text-center hover:border-violet-500/50 transition-all">
                <span class="text-4xl font-black text-violet-400 block mb-4" aria-hidden="true">{s.step}</span>
                <h3 class="text-lg font-bold mb-2">{s.title}</h3>
                <p class="text-sm text-meg-text-secondary">{s.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- SaaS Suite Promotion -->
    <PromoSuite />

    <!-- FAQ -->
    <section class="py-24 px-6 bg-meg-surface-dark/20 border-t border-meg-border-dark">
      <div class="mx-auto max-w-4xl">
        <h2 class="text-3xl font-bold text-center mb-12 gsap-fadein">Häufige Fragen zu <span class="text-violet-400">DevSecOps</span></h2>
        <div class="space-y-6">
          {faqSchema.mainEntity.map((faq) => (
            <details class="group border border-meg-border-dark rounded-2xl p-6 bg-meg-surface-dark/50 cursor-pointer">
              <summary class="flex justify-between items-center font-bold text-meg-text-primary-dark list-none">
                {faq.name}
                <span class="text-violet-400 group-open:rotate-180 transition-transform">
                  <i class="fa-solid fa-chevron-down"></i>
                </span>
              </summary>
              <p class="mt-4 text-meg-text-secondary leading-relaxed border-t border-meg-border-dark pt-4">
                {faq.acceptedAnswer.text}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PriceService />
    <Blog limits={2} />
    <RelatedServices />
    <Partner />
  </main>
</Layout>