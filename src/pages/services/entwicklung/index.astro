---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Softwareentwicklung',
  link: 'https://waldheim.dev/services/entwicklung'
}]);

const titel = 'Softwareentwicklung & Webentwicklung | waldheim.dev';
const description = 'Webentwicklung Augsburg & München: Maßgeschneiderte Web-Apps, Toolings, Scrum/Product Owner Expertise. Professionelle Softwareentwicklung in Bayern.';
const keywords = 'Softwareentwicklung, Webentwicklung, Webanwendungen, Tooling, Individualsoftware, Programmierung, Scrum, Product Owner, Schulungen, TypeScript, React, Angular';

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Softwareentwicklung & Webentwicklung',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'Software Development',
  areaServed: 'DE',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/entwicklung-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="Entwicklung"
    subtitle="Maßgeschneiderte Software- &"
    description="Von individuellen Websites über Webanwendungen bis zu komplexen Microservices – ich entwickle hochwertige Software, die perfekt zu Ihren Bedürfnissen passt. Mit über 10 Jahren Erfahrung und modernsten Technologien."
    gradient="blue"
    icon="fa-code"
    badge="Über 10 Jahre Erfahrung"
  />

  <!-- Main Features Section -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark" id="leistungen">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-laptop-code mr-2' aria-hidden='true'></i>
          Leistungsspektrum
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Gemeinsam realisieren wir Ihre <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Vision</span>!
        </p>
        <p class="gsap-fadein text-xl text-meg-text-secondary" style="animation-delay: 0.3s">
          Individuelle Softwarelösungen, präzise auf Ihre Anforderungen zugeschnitten.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {[
          { title: 'Individuelle Websites', desc: 'Modernste technische Standards mit Astro, React oder WordPress.', icon: 'fa-globe' },
          { title: 'Plugin-Entwicklung', desc: 'Maßgeschneiderte Erweiterungen für Ihre bestehenden Plattformen.', icon: 'fa-plug' },
          { title: 'Microservices', desc: 'Unabhängige, skalierbare Dienste für Ihre IT-Landschaft.', icon: 'fa-server' },
          { title: 'Open Source', desc: 'Engagement in der Community und öffentlich zugängliche Lösungen.', icon: 'fa-brands fa-github' }
        ].map((feat, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/30 hover:shadow-lg hover:shadow-meg-accent/5 transition-all duration-300 group" style={`animation-delay: ${0.45 + i * 0.15}s`}>
            <div class="w-14 h-14 bg-meg-accent/10 border border-meg-accent/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <i class={`${feat.icon.startsWith('fa-') ? 'fa-solid' : ''} ${feat.icon} text-meg-accent text-2xl`}></i>
            </div>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-4">{feat.title}</h3>
            <p class="text-meg-text-secondary leading-relaxed">{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-toolbox mr-2' aria-hidden='true'></i>
          Technologie-Stack
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Moderne <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Frameworks</span>
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {[
          { label: 'Frontend', tools: ['Astro', 'Angular', 'Vue.js', 'TailwindCSS'] },
          { label: 'Backend', tools: ['Node.js', 'Python', 'PHP', 'Go'] },
          { label: 'Datenbanken', tools: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis'] },
          { label: 'CMS', tools: ['WordPress', 'Strapi', 'Contentful'] },
          { label: 'APIs', tools: ['REST', 'GraphQL', 'gRPC'] },
          { label: 'Qualität', tools: ['Playwright', 'Vitest', 'Jest'] }
        ].map((stack, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 hover:border-meg-accent/20 transition-all shadow-sm" style={`animation-delay: ${0.45 + i * 0.1}s`}>
            <h3 class="text-xs font-bold uppercase tracking-widest text-meg-accent mb-4">{stack.label}</h3>
            <div class="flex flex-wrap gap-2">
              {stack.tools.map(tool => (
                <span class="px-3 py-1 bg-meg-bg-dark/50 border border-meg-border-dark rounded-lg text-sm text-meg-text-secondary font-medium">
                  {tool}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
      
      <div class="mt-8 text-center">
        <div class="gsap-fadein inline-flex items-center gap-2 px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full text-[10px] font-black uppercase tracking-widest text-emerald-400" style="animation-delay: 1.35s">
          <i class='fa-solid fa-house-laptop text-green-400' aria-hidden='true'></i>
          <span>100% Remote Arbeit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none">
        <h2 class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0s">
          Meine Mission: <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Qualität & Sicherheit</span>
        </h2>
        <div class="mt-10 flex flex-col gap-x-16 gap-y-12 lg:flex-row">
          <div class="lg:flex-1">
            <p class="gsap-fadein text-xl text-meg-text-secondary mb-8 leading-relaxed" style="animation-delay: 0.15s">
              Ich lege Wert auf Qualität bis ins Detail – für jedes Endgerät und mit einem starken Fokus auf Sicherheit.
            </p>
            <p class="gsap-fadein text-base text-meg-text-secondary leading-relaxed opacity-80" style="animation-delay: 0.3s">
              Viele Agenturen vernachlässigen die Sicherheit. Ich biete Ihnen langfristige, stabile und sichere Softwarelösungen – zu fairen Preisen. Jedes Projekt wird mit einer umfassenden Dokumentation und einem Sicherheitsbericht ausgeliefert.
            </p>
          </div>
          <div class="lg:flex lg:items-center">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <div class="gsap-fadein bg-meg-surface-dark/50 p-6 rounded-2xl border border-meg-border-dark shadow-sm" style="animation-delay: 0.45s">
                <div class="text-5xl font-black text-meg-text-primary-dark mb-2 tracking-tighter">10+</div>
                <div class="text-sm font-bold uppercase tracking-widest text-meg-accent">Jahre Erfahrung</div>
              </div>
              <div class="gsap-fadein bg-meg-surface-dark/50 p-6 rounded-2xl border border-meg-border-dark shadow-sm" style="animation-delay: 0.6s">
                <div class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400 mb-2 tracking-tighter">AI-Driven</div>
                <div class="text-sm font-bold uppercase tracking-widest text-meg-accent">Effizienz-Boost</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality Bento Grid -->
  <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4" style="animation-delay: 0s">
        High-Quality
      </h2>
      <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-16" style="animation-delay: 0.15s">
        Entwicklung mit <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Anspruch</span>
      </p>
      
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-6 lg:grid-rows-2">
        {[
          { span: 'lg:col-span-3', img: '/bento/bento-01-performance.webp', tag: 'Performance', title: 'Lichtgeschwindigkeit', desc: 'Optimierte Prozesse für maximale Ladegeschwindigkeit.' },
          { span: 'lg:col-span-3', img: '/bento/bento-01-releases.webp', tag: 'Releases', title: 'Push to deploy', desc: 'Automatisierte CI/CD-Pipelines für fehlerfreie Updates.' },
          { span: 'lg:col-span-2', img: '/bento/bento-01-speed.webp', tag: 'Barrierefreiheit', title: 'Inklusiv', desc: 'Einhaltung der WCAG-Standards für universellen Zugriff.' },
          { span: 'lg:col-span-2', img: '/bento/bento-01-network.webp', tag: 'Testing', title: 'Zuverlässig', desc: 'Automatisierte Unit-, Integration- und E2E-Tests.' },
          { span: 'lg:col-span-2', img: '/bento/bento-01-integrations.webp', tag: 'Integrationen', title: 'Vernetzt', desc: 'Nahtlose Einbindung Ihrer bestehenden Tool-Landschaft.' }
        ].map((item, i) => (
          <div class={`gsap-fadein relative ${item.span} bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl overflow-hidden hover:border-meg-accent/30 transition-all duration-300 group shadow-sm`} style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <div class="h-48 overflow-hidden">
              <img class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-700" src={item.img} alt={item.title} loading="lazy">
            </div>
            <div class="p-8">
              <h3 class="text-meg-accent text-xs font-bold uppercase tracking-widest mb-2">{item.tag}</h3>
              <p class="text-xl font-bold text-meg-text-primary-dark mb-2">{item.title}</p>
              <p class="text-meg-text-secondary text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Guarantees -->
  <section class="py-24 px-6 bg-meg-bg-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-certificate mr-2' aria-hidden='true'></i>
          Qualitätsversprechen
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Meine <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Garantien</span> für Sie
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {[
          { title: '100% WCAG 2.0 AA', desc: 'Barrierefreiheit bei Web-Projekten', icon: 'fa-universal-access' },
          { title: 'Lighthouse >90', desc: 'Performance & Best Practices', icon: 'fa-gauge-high' },
          { title: 'Automatisierte Tests', desc: 'Min. 70% Code Coverage', icon: 'fa-vial' },
          { title: 'Security Audit', desc: 'OWASP Top 10 Check', icon: 'fa-shield-halved' },
          { title: 'Vollständige Doku', desc: 'Code + User Guide', icon: 'fa-book' },
          { title: 'Git-Repository', desc: 'Mit sauberer History', icon: 'fa-brands fa-git-alt' }
        ].map((item, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-6 text-center shadow-sm hover:border-meg-accent/30 transition-all group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <div class="size-12 bg-meg-accent/10 border border-meg-accent/20 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform">
              <i class={`${item.icon.startsWith('fa-') ? 'fa-solid' : ''} ${item.icon} text-meg-accent text-xl`}></i>
            </div>
            <h3 class="text-lg font-bold text-meg-text-primary-dark mb-2">{item.title}</h3>
            <p class="text-sm text-meg-text-secondary">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4" style="animation-delay: 0s">
          FAQ
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Fragen & <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Antworten</span> zur Entwicklung
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {[
          { q: 'Entwickeln Sie auch Mobile Apps?', a: 'Aktuell fokussiere ich mich auf Progressive Web Apps (PWA), die nativ-ähnliche Erlebnisse auf allen Geräten bieten.' },
          { q: 'WordPress oder Custom-Lösung?', a: 'Das kommt auf Ihr Ziel an. WordPress für Content-Fokus und schnellen Start, Custom für maximale Performance und Skalierbarkeit.' },
          { q: 'Bieten Sie Wartungsverträge an?', a: 'Ja! Sicherheit und Aktualität sind essentiell. Ich biete verschiedene Wartungspakete ab 150€/Monat an.' },
          { q: 'Wie lange dauert ein Projekt?', a: 'Abhängig vom Umfang: Landing Pages 1-2 Wochen, Web-Apps 6-10 Wochen.' }
        ].map((faq, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/20 transition-all shadow-sm group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <h3 class="text-lg font-bold text-meg-text-primary-dark mb-4 flex items-start gap-3">
              <span class="text-meg-accent font-black">Q</span> {faq.q}
            </h3>
            <p class="text-meg-text-secondary pl-7 leading-relaxed">
              <span class="text-meg-accent font-bold mr-2">A:</span> {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="py-12 bg-meg-bg-dark border-t border-meg-border-dark text-center">
    <div class="gsap-fadein inline-flex items-center gap-2 px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full text-[10px] font-black uppercase tracking-widest text-emerald-400">
      <i class='fa-solid fa-house-laptop' aria-hidden='true'></i>
      <span>100% Remote Workflow</span>
    </div>
  </div>

  <PriceService />

  <RelatedServices 
    services={[
      {
        title: "DevSecOps & Automatisierung",
        href: "/services/devsecops/",
        icon: "fa-solid fa-shield-check",
        description: "CI/CD-Pipelines, Kubernetes, GitOps – Automatisierung und Sicherheit für Ihre Entwicklungsprozesse.",
        color: "purple"
      },
      {
        title: "Webdesign & UX/UI",
        href: "/services/design/",
        icon: "fa-solid fa-palette",
        description: "Professionelles Design für Markenidentität, Webseiten und benutzerfreundliche Interfaces.",
        color: "pink"
      },
      {
        title: "Smart Home Beratung",
        href: "/services/smarthome/",
        icon: "fa-solid fa-house-signal",
        description: "Unabhängige Beratung für Ihr individuelles Smart Home System – ohne Herstellerbindung.",
        color: "orange"
      }
    ]}
  />

  <Partner />
</Layout>
