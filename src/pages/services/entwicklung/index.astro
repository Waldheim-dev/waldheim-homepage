---
// This code has been partially generated by an AI.
import PromoSuite from '../../../components/PromoSuite.astro';
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import Blog from '../../../components/Blog.astro';

// SEO & Meta
const titel = 'Webentwicklung, Custom Software & AI-Team-Coaching Augsburg/München';
const description = 'Moderne Webseiten-Entwicklung & Gestaltung, maßgeschneiderte Software-Produkte (SaaS, Web-Apps, APIs) und AI-Engineering-Coaching für >1.000% (10x) Produktivität.';
const keywords = 'Webentwicklung Augsburg, Webdesign München, Custom Software Bayern, AI Engineering Coaching, KI im Entwicklungsprozess, AI Code Review, Skills Automationen, SaaS Entwicklung KMU, Astro Angular Go';
const ogImage = 'https://waldheim.dev/services/entwicklung-og.jpg';

// Structured Data
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Webentwicklung, Custom Software & AI-Engineering Coaching',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Waldheim.dev',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Augsburg',
      'addressRegion': 'Bayern',
      'addressCountry': 'DE'
    }
  },
  'serviceType': 'Web Development, Custom Software & AI Engineering Coaching',
  'areaServed': [
    { '@type': 'City', 'name': 'Augsburg' },
    { '@type': 'City', 'name': 'München' }
  ],
  'description': 'Klassische Webseiten-Entwicklung und Gestaltung, hochwertige Individualsoftware (SaaS, Web-Apps, APIs) sowie Team-Coaching für KI-gestützte Softwareentwicklung mit bis zu 10x (>1.000%) Produktivität.',
  'offers': {
    '@type': 'Offer',
    'description': 'Projektbasierte Entwicklung, AI-Engineering-Coaching & agile Retainer-Modelle'
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Custom Software',
  link: 'https://waldheim.dev/services/entwicklung'
}]);

const faqSchema = SchemaUtils.getFAQSchema([
  {
    question: 'Entwickeln und gestalten Sie auch klassische Unternehmens-Webseiten und Landingpages?',
    answer: 'Ja, absolut! Neben komplexen Web-Apps und SaaS-Plattformen konzipiere, gestalte (UI/UX) und entwickle ich moderne, pfeilschnelle Unternehmens-Webseiten, Produktseiten und Relaunches mit Bestwerten in SEO, Performance (Lighthouse 95–100) und Barrierefreiheit (WCAG 2.1 AA).'
  },
  {
    question: 'Wie erreichen Sie über 1.000% (10x) Produktivität und wie läuft das AI-Team-Coaching ab?',
    answer: 'Durch den konsequenten Einsatz selbst gebauter AI-Engineering-Tools: automatisierte AI Code Reviews, wiederverwendbare Agent-Skills, MCP-Integrationen, Custom Instructions und Spec-Driven Workflows. Im Coaching zeige ich Ihrem Entwicklerteam praxisnah am echten Projektcode, wie es diese Werkzeuge und Workflows adaptiert und seine Delivery-Geschwindigkeit vervielfacht.'
  },
  {
    question: 'Was ist der Unterschied zwischen Custom Software und einer Standard-Lösung?',
    answer: 'Standard-Software wie SAP oder Salesforce deckt 80% der Fälle ab – die verbleibenden 20% kosten Sie teuer an Kompromissen und Workarounds. Custom Software ist präzise auf Ihre Prozesse zugeschnitten: keine unnötigen Features, keine Lizenzkosten pro User und volle Kontrolle über Ihre Daten und Weiterentwicklung.'
  },
  {
    question: 'Welchen Tech-Stack nutzen Sie für moderne Webseiten und Web-Apps?',
    answer: 'Ich setze auf bewährte und zukunftssichere Technologien: Astro.js & Tailwind CSS für performante, inhaltsreiche Webseiten und Portale, Angular & React für komplexe Enterprise-Anwendungen, Go (Golang) für hochverfügbare Backend-Services und APIs sowie PostgreSQL für robuste Datenhaltung.'
  },
  {
    question: 'Können Sie auch bestehende Software oder Webseiten modernisieren?',
    answer: 'Absolut. Ich helfe beim modernen Website-Relaunch ebenso wie bei der schrittweisen Migration von Legacy-Systemen, API-Integration in bestehende Landschaften und der Skalierung von Software-Produkten – ohne Unterbrechung des laufenden Betriebs.'
  }
]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema, faqSchema]}
  image={ogImage}
>
  <main id="main-content">
    <ServiceHero 
      title="Web, Software & AI-Coaching"
      subtitle="Von der Website bis zum 10x AI-Team –"
      description="Ob repräsentative Unternehmens-Website & Gestaltung, maßgeschneiderte SaaS-/Enterprise-Software oder praxisnahes AI-Engineering-Coaching (>1.000% Produktivität durch eigene AI-Reviews & Skill-Automationen): Ich liefere messbare Ergebnisse."
      gradient="blue"
      icon="fa-code"
      badge="10+ Jahre Full-Stack · 10x AI-Engineering (>1.000%)"
    />

    <!-- Produktkategorien -->
    <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="software-products-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein mx-auto max-w-2xl text-center mb-16">
          <h2 id="software-products-heading" class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
            Leistungen &amp; Lösungen
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Web, Custom Software &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">AI-Enablement</span>
          </p>
          <p class="text-xl text-meg-text-secondary">
            Von der klassischen Webpräsenz über komplexe Plattformen bis zum Coaching Ihres Entwicklerteams für maximale KI-Produktivität.
          </p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-palette text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Webseiten-Entwicklung &amp; Gestaltung</h3>
            <p class="text-meg-text-secondary text-sm">Konzeption, individuelles UI/UX-Webdesign und Entwicklung moderner Unternehmens-Webseiten, Landingpages &amp; Relaunches. SEO-optimiert, barrierefrei (WCAG 2.1 AA) und mit Top-Ladezeiten.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-rocket text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Web-Apps &amp; SaaS-Plattformen</h3>
            <p class="text-meg-text-secondary text-sm">Hochperformante Webanwendungen und Software-as-a-Service-Produkte, die Sie vermarkten oder intern nutzen können. Multi-Tenant-fähig, skalierbar, DSGVO-konform.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-chalkboard-user text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">AI-Coaching für Dev-Teams (10x)</h3>
            <p class="text-meg-text-secondary text-sm">Praxisnahes Coaching, wie Sie mit KI im Entwicklungsprozess das Maximum aus Ihrem Team herausholen: Prompt- &amp; Context-Engineering, Agent-Workflows, Custom Instructions und Pair-Programming.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-wand-magic-sparkles text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">AI Review &amp; Skill-Automationen</h3>
            <p class="text-meg-text-secondary text-sm">Aufbau maßgeschneiderter Entwickler-Tools: automatisierte AI Code Reviews, wiederverwendbare Agent-Skills, MCP-Server und Workflow-Automationen für über 1.000% Produktivität.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-gears text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Business-Automatisierung</h3>
            <p class="text-meg-text-secondary text-sm">Digitalisierung Ihrer manuellen Prozesse: ERP-Erweiterungen, Workflow-Automatisierung, individuelle CRM-Lösungen und Reporting-Dashboards für fundierte Entscheidungen.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-plug text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">APIs &amp; Integrationen</h3>
            <p class="text-meg-text-secondary text-sm">RESTful, gRPC und GraphQL-APIs, Drittsystem-Anbindungen (ERP, CRM, DATEV, Payment, IoT) und Microservice-Architekturen für nahtlose Integration in Ihre IT-Landschaft.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-building text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Enterprise-Anwendungen &amp; PWAs</h3>
            <p class="text-meg-text-secondary text-sm">Komplexe Geschäftsanwendungen und Progressive Web Apps: Rollen- &amp; Rechteverwaltung, Audit-Logs, Single Sign-On (SSO), Offline-Fähigkeit und M365/AD-Integration.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-brain text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">KI-Integration in Produkte</h3>
            <p class="text-meg-text-secondary text-sm">Einbindung von LLMs (OpenAI, Claude, Gemini, lokale Ollama-Modelle) direkt in Ihre Kunden-Software: intelligente Suche, Dokument-Analyse und autonome Fach-Agenten.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- KI-Vorteil & Tech-Stack -->
    <section class="py-24 px-6 border-y border-meg-border-dark bg-meg-surface-dark/10">
      <div class="mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="bg-meg-surface-dark/30 rounded-3xl p-8 border border-meg-border-dark shadow-2xl">
            <div class="flex items-center gap-4 mb-8">
              <div class="size-16 bg-meg-accent/10 rounded-2xl flex items-center justify-center border border-meg-accent/20 text-meg-accent">
                <i class="fa-solid fa-brain text-3xl animate-pulse" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="text-2xl font-bold">&gt;1.000% (10x) Produktivität</h3>
                <p class="text-meg-accent font-bold">Eigenes AI-Tooling &amp; Team-Coaching</p>
              </div>
            </div>
            <p class="text-meg-text-secondary mb-6 leading-relaxed">
              Durch selbst entwickelte AI-Engineering-Tools – darunter automatisierte <strong class="text-meg-text-primary-dark font-semibold">AI Code Reviews</strong>, modulare <strong class="text-meg-text-primary-dark font-semibold">Skills-Automationen</strong> und orchestrierte Agenten-Pipelines – erreiche ich in der Umsetzung eine über <strong class="text-meg-text-primary-dark font-semibold">10-fache Produktivität (&gt;1.000%)</strong>. Genau dieses Setup baue ich auf Wunsch auch in Ihrem Team auf und coache Ihre Entwickler im täglichen Einsatz:
            </p>
            <ul class="space-y-4 text-meg-text-primary-dark font-medium">
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i> 10x schnellere Umsetzung von Websites, Features &amp; MVPs</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i> Eigene AI-Review-Bots &amp; wiederverwendbare Agent-Skills</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i> Hands-on Team-Coaching für KI im gesamten SDLC</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400" aria-hidden="true"></i> Höchste Test-Coverage, Clean Code &amp; Security by Design</li>
            </ul>
          </div>
          <div>
            <h2 class="text-3xl font-bold mb-6">Bewährte Technologien – <span class="text-meg-accent">kein Vendor-Lock-in</span></h2>
            <p class="text-meg-text-secondary mb-8">
              Mein Tech-Stack ist auf maximale Wartbarkeit und Zukunftssicherheit ausgelegt. Sie bleiben unabhängig und können Ihr Produkt jederzeit selbst oder mit anderen Partnern weiterentwickeln.
            </p>
            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Frontend</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">Astro, Angular, React, Tailwind CSS</p>
              </div>
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Backend</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">Go, Node.js, Python, PostgreSQL</p>
              </div>
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Mobile & PWA</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">PWA, Capacitor, Flutter</p>
              </div>
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Qualität & Security</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">Playwright, SonarQube, OWASP, Vitest</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Prozess -->
    <section class="py-24 px-6" aria-labelledby="process-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein text-center mb-16">
          <h2 id="process-heading" class="text-3xl font-black tracking-tight">
            Vom <span class="text-meg-accent">ersten Gespräch</span> zum fertigen Produkt
          </h2>
          <p class="mt-4 text-meg-text-secondary text-lg max-w-2xl mx-auto">Transparenter Prozess – Sie wissen immer, wo Ihr Projekt steht.</p>
        </header>
        <div class="relative">
          <div class="absolute top-1/2 left-0 w-full h-0.5 bg-meg-border-dark hidden lg:block" aria-hidden="true"></div>
          <ol class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 relative z-10">
            {[
              { step: '01', title: 'Discovery', desc: 'Anforderungsanalyse, Prozesse verstehen, technische Machbarkeit klären – ohne Kosten.' },
              { step: '02', title: 'Konzept & Architektur', desc: 'Tech-Stack, Datenbankdesign, API-Konzept, UI-Wireframes und verbindliches Angebot.' },
              { step: '03', title: 'Entwicklung & Review', desc: 'Agile Sprints mit wöchentlichen Demos. Frühe und regelmäßige Qualitätssicherung.' },
              { step: '04', title: 'Launch & Betrieb', desc: 'Deployment, Monitoring-Setup, Übergabe der Dokumentation und optionaler Retainer.' }
            ].map((s) => (
              <li class="bg-meg-bg-dark border border-meg-border-dark p-6 rounded-2xl text-center hover:border-meg-accent/50 transition-all">
                <span class="text-4xl font-black text-meg-accent block mb-4" aria-hidden="true">{s.step}</span>
                <h3 class="text-lg font-bold mb-2">{s.title}</h3>
                <p class="text-sm text-meg-text-secondary">{s.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Qualität Bento -->
    <section class="py-24 px-6 bg-meg-surface-dark/10 border-t border-meg-border-dark" aria-labelledby="quality-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein text-center mb-16">
          <h2 id="quality-heading" class="text-3xl font-black tracking-tight">Qualität, die <span class="text-meg-accent">messbar</span> ist</h2>
        </header>
        <div class="grid lg:grid-cols-6 lg:grid-rows-2 gap-4">
          <article class="gsap-fadein lg:col-span-3 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 flex flex-col justify-between hover:border-meg-accent/50 transition-all">
            <div>
              <span class="text-meg-accent font-bold uppercase tracking-widest text-xs">Performance</span>
              <h3 class="text-2xl font-bold mt-4 mb-4 text-meg-text-primary-dark">Lighthouse Score &gt; 90</h3>
              <p class="text-meg-text-secondary text-sm">Garantierte Bestnoten in Performance, SEO und Barrierefreiheit für maximale Sichtbarkeit und Conversion.</p>
            </div>
            <div class="mt-8 flex gap-4">
              <div class="size-12 border-2 border-emerald-500 rounded-full flex items-center justify-center text-emerald-500 font-bold text-sm" aria-label="Performance: 100">100</div>
              <div class="size-12 border-2 border-emerald-500 rounded-full flex items-center justify-center text-emerald-500 font-bold text-sm" aria-label="SEO: 98">98</div>
              <div class="size-12 border-2 border-emerald-500 rounded-full flex items-center justify-center text-emerald-500 font-bold text-sm" aria-label="Accessibility: 100">100</div>
            </div>
          </article>
          <article class="gsap-fadein lg:col-span-3 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <span class="text-meg-accent font-bold uppercase tracking-widest text-xs">Sicherheit</span>
            <h3 class="text-2xl font-bold mt-4 mb-4 text-meg-text-primary-dark">Clean Code & Security Audit</h3>
            <p class="text-meg-text-secondary text-sm">Jede Anwendung durchläuft SAST-Scans, manuelle Security-Reviews und automatisierte Dependency-Checks nach OWASP Top 10.</p>
            <div class="mt-8 bg-meg-bg-dark/50 rounded-xl p-4 border border-meg-border-dark">
              <code class="text-xs text-emerald-400">✓ OWASP Top 10 · SAST · Dependency Audit · MFA-ready</code>
            </div>
          </article>
          <article class="gsap-fadein lg:col-span-2 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <h3 class="font-bold text-meg-text-primary-dark mb-4">100% Dokumentation</h3>
            <p class="text-meg-text-secondary text-xs">OpenAPI-Spezifikationen, Deployment-Guides, Datenbankschemas – alles transparent und wartbar.</p>
          </article>
          <article class="gsap-fadein lg:col-span-2 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <h3 class="font-bold text-meg-text-primary-dark mb-4">Agiles Mindset · PSPO I</h3>
            <p class="text-meg-text-secondary text-xs">Ich bin nicht nur Entwickler, sondern Sparringspartner für Ihre Produktvision und Ihr Backlog-Management.</p>
          </article>
          <article class="gsap-fadein lg:col-span-2 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <h3 class="font-bold text-meg-text-primary-dark mb-4">10+ Jahre Erfahrung</h3>
            <p class="text-meg-text-secondary text-xs">Vom Startup-MVP bis zum Enterprise-System – ich habe alle Fallstricke erlebt und weiß, wie man sie vermeidet.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- SaaS Suite Promotion -->
    <PromoSuite />

    <!-- FAQ -->
    <section class="py-24 px-6" aria-labelledby="software-faq-heading">
      <div class="mx-auto max-w-4xl">
        <header class="gsap-fadein text-center mb-12">
          <h2 id="software-faq-heading" class="gsap-fadein text-3xl font-bold">Häufige Fragen zur <span class="text-meg-accent">Custom Software</span></h2>
        </header>
        <div class="space-y-6">
          {faqSchema.mainEntity.map((faq) => (
            <details class="group border border-meg-border-dark rounded-2xl p-6 bg-meg-surface-dark/50 cursor-pointer hover:border-meg-accent/30 transition-all">
              <summary class="flex justify-between items-center font-bold text-meg-text-primary-dark list-none">
                {faq.name}
                <span class="text-meg-accent group-open:rotate-180 transition-transform">
                  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </span>
              </summary>
              <p class="mt-4 text-meg-text-secondary leading-relaxed border-t border-meg-border-dark pt-4">
                {faq.acceptedAnswer.text}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PriceService />
    <Blog limits={2} />
    <RelatedServices />
    <Partner />
  </main>
</Layout>
