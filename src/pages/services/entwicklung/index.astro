---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Softwareentwicklung',
  link: 'https://waldheim.dev/services/entwicklung'
}]);

const titel = 'Softwareentwicklung & Webentwicklung | waldheim.dev';
const description = 'Webentwicklung Augsburg & München: Maßgeschneiderte Web-Apps, Toolings, Scrum/Product Owner Expertise. Professionelle Softwareentwicklung in Bayern.';
const keywords = 'Softwareentwicklung, Webentwicklung, Webanwendungen, Tooling, Individualsoftware, Programmierung, Scrum, Product Owner, Schulungen, TypeScript, React, Angular';

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Softwareentwicklung & Webentwicklung',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'Software Development',
  areaServed: 'DE',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/entwicklung-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="Entwicklung"
    subtitle="Maßgeschneiderte Software- &"
    description="Von individuellen Websites über Webanwendungen bis zu komplexen Microservices – ich entwickle hochwertige Software, die perfekt zu Ihren Bedürfnissen passt. Mit über 10 Jahren Erfahrung und modernsten Technologien."
    gradient="blue"
    icon="fa-code"
    badge="Über 10 Jahre Erfahrung"
  />

  <!-- Main Features Section -->
  <section class="py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900" id="leistungen">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-blue-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-laptop-code text-blue-400 mr-2' aria-hidden='true'></i>
          Entwicklung
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Gemeinsam realisieren wir Ihre <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Vision</span>!
        </p>
        <p class="gsap-fadein text-xl text-light-300" style="animation-delay: 0.3s">
          Ich entwickle individuelle Websites, Webanwendungen, Plugins und Microservices – präzise auf Ihre
          Anforderungen zugeschnitten.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-2xl p-8 hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.45s">
          <div class="w-14 h-14 bg-blue-500/10 border border-blue-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-globe text-blue-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Individuelle Websites</h3>
          <p class="text-light-300">
            Ob mit WordPress, Astro oder als reine HTML-Lösung – ich setze Ihre Website nach Ihren Wünschen
            und den neuesten technischen Standards um.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-2xl p-8 hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.6s">
          <div class="w-14 h-14 bg-blue-500/10 border border-blue-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-plug text-blue-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Plugin-Entwicklung</h3>
          <p class="text-light-300">
            Benötigen Sie ein spezielles Plugin für WordPress oder eine andere Plattform? Ich entwickle
            maßgeschneiderte Erweiterungen für Ihre bestehende Software.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-2xl p-8 hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.75s">
          <div class="w-14 h-14 bg-blue-500/10 border border-blue-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-server text-blue-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Microservices</h3>
          <p class="text-light-300">
            Ich entwickle unabhängige, skalierbare Microservices, die sich nahtlos in Ihre bestehende
            IT-Landschaft integrieren lassen.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-2xl p-8 hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.9s">
          <div class="w-14 h-14 bg-blue-500/10 border border-blue-500/30 rounded-xl flex items-center justify-center mb-6">
            <i class="fa-brands fa-github text-blue-400 text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-4">Open Source</h3>
          <p class="text-light-300">
            Ich engagiere mich in der Open-Source-Community und entwickle öffentlich zugängliche
            Softwarelösungen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-blue-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-toolbox text-blue-400 mr-2' aria-hidden='true'></i>
          Mein Tech-Stack
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Moderne <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Technologien</span> für Ihr Projekt
        </p>
        <p class="gsap-fadein text-xl text-light-300 mb-6" style="animation-delay: 0.3s">
          Ich arbeite ausschließlich remote mit bewährten und modernen Technologien
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6" style="animation-delay: 0.45s">
          <h3 class="text-sm font-semibold text-blue-400 mb-3">Frontend</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Astro</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Angular</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Vue.js</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">TailwindCSS</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6" style="animation-delay: 0.6s">
          <h3 class="text-sm font-semibold text-blue-400 mb-3">Backend</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Node.js</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Python</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">PHP</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">C#</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6" style="animation-delay: 0.75s">
          <h3 class="text-sm font-semibold text-blue-400 mb-3">Datenbanken</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">PostgreSQL</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">MySQL</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">MongoDB</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Redis</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6" style="animation-delay: 0.9s">
          <h3 class="text-sm font-semibold text-blue-400 mb-3">CMS & Frameworks</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">WordPress</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Strapi</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Contentful</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6" style="animation-delay: 1.05s">
          <h3 class="text-sm font-semibold text-blue-400 mb-3">APIs & Integration</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">REST</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">GraphQL</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">gRPC</span>
          </div>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6" style="animation-delay: 1.2s">
          <h3 class="text-sm font-semibold text-blue-400 mb-3">Testing & Qualität</h3>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Playwright</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Vitest</span>
            <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/30 rounded-full text-sm text-light-200">Jest</span>
          </div>
        </div>
      </div>
      
      <div class="mt-8 text-center">
        <div class="gsap-fadein inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 border border-green-500/30 rounded-full text-sm text-light-200" style="animation-delay: 1.35s">
          <i class='fa-solid fa-house-laptop text-green-400' aria-hidden='true'></i>
          <span>100% Remote Arbeit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-950 to-dark-900">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none">
        <h2 class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0s">
          Meine Mission: <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Qualität, Sicherheit, Nachhaltigkeit</span>
        </h2>
        <div class="mt-10 flex flex-col gap-x-16 gap-y-12 lg:flex-row">
          <div class="lg:flex-1">
            <p class="gsap-fadein text-xl text-light-300 mb-8" style="animation-delay: 0.15s">
              Ich lege Wert auf Qualität bis ins Detail – für jedes Endgerät und mit einem starken Fokus auf
              Sicherheit.
            </p>
            <p class="gsap-fadein text-base text-light-400" style="animation-delay: 0.3s">
              Viele Agenturen vernachlässigen die Sicherheit. Ich nicht! Ich biete Ihnen langfristige, stabile
              und sichere Softwarelösungen – zu fairen Preisen. Jedes Projekt wird mit einer umfassenden
              Dokumentation und einem Sicherheitsbericht ausgeliefert. Auch langfristiger Support und
              Anpassungen sind selbstverständlich.
            </p>
          </div>
          <div class="lg:flex lg:items-center">
            <div class="space-y-8">
              <div class="gsap-fadein" style="animation-delay: 0.45s">
                <div class="text-5xl font-bold text-white mb-2">10+</div>
                <div class="text-light-300">Jahre Erfahrung in Software- und Webentwicklung</div>
              </div>
              <div class="gsap-fadein" style="animation-delay: 0.6s">
                <div class="text-5xl font-bold bg-gradient-to-r from-blue-400 to-cyan-500 text-transparent bg-clip-text mb-2">
                  Effizienzsteigerung
                </div>
                <div class="text-light-300">KI-gestützte Entwicklung</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality Bento Grid -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-900 to-dark-950">
    <div class="mx-auto max-w-7xl">
      <h2 class="gsap-fadein text-base font-semibold text-blue-400 mb-4" style="animation-delay: 0s">
        <i class='fa-solid fa-medal text-blue-400 mr-2' aria-hidden='true'></i>
        High-Quality
      </h2>
      <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-16" style="animation-delay: 0.15s">
        Entwicklung mit <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Qualität</span>
      </p>
      
      <div class="grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
        <div class="gsap-fadein relative lg:col-span-3 bg-gradient-to-br from-dark-900 to-dark-950 border border-blue-500/20 rounded-3xl overflow-hidden hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.3s">
          <img class="h-80 w-full object-cover" src="/bento/bento-01-performance.webp" alt="Lighthouse Performance Score 100 – Optimierte Webentwicklung für maximale Ladegeschwindigkeit" loading="lazy">
          <div class="p-10">
            <h3 class="text-blue-400 font-semibold mb-2">Performance</h3>
            <p class="text-2xl font-bold text-white mb-3">Lichtgeschwindigkeit</p>
            <p class="text-light-300">Die Entwicklung wird in der Performance so optimiert, dass wir keine unnötigen oder langsamen Prozesse haben.</p>
          </div>
        </div>
        
        <div class="gsap-fadein relative lg:col-span-3 bg-gradient-to-br from-dark-900 to-dark-950 border border-blue-500/20 rounded-3xl overflow-hidden hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.45s">
          <img class="h-80 w-full object-cover lg:object-right" src="/bento/bento-01-releases.webp" alt="CI/CD Pipeline mit GitHub Actions – Automatisches Deployment bei jedem Push" loading="lazy">
          <div class="p-10">
            <h3 class="text-blue-400 font-semibold mb-2">Releases</h3>
            <p class="text-2xl font-bold text-white mb-3">Push to deploy</p>
            <p class="text-light-300">Die CI/CD wird so eingerichtet, dass wir bei jedem Push auf das Repository ein automatisches Deployment haben.</p>
          </div>
        </div>
        
        <div class="gsap-fadein relative lg:col-span-2 bg-gradient-to-br from-dark-900 to-dark-950 border border-blue-500/20 rounded-3xl overflow-hidden hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.6s">
          <img class="h-80 w-full object-cover object-left" src="/bento/bento-01-speed.webp" alt="WCAG 2.1 AA Konformität – Barrierefreie Webentwicklung für alle Nutzer" loading="lazy">
          <div class="p-10">
            <h3 class="text-blue-400 font-semibold mb-2">Barrierefreiheit</h3>
            <p class="text-2xl font-bold text-white mb-3">Zugriff für jeden</p>
            <p class="text-light-300">Die Entwicklung erfolgt immer mit der Einhaltung von grundlegenden Barrierefreiheiten.</p>
          </div>
        </div>
        
        <div class="gsap-fadein relative lg:col-span-2 bg-gradient-to-br from-dark-900 to-dark-950 border border-blue-500/20 rounded-3xl overflow-hidden hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.75s">
          <img class="h-80 w-full object-cover" src="/bento/bento-01-network.webp" alt="Playwright Testing Framework – Unit-Tests, Integrationstests und E2E-Tests für zuverlässige Software" loading="lazy">
          <div class="p-10">
            <h3 class="text-blue-400 font-semibold mb-2">Teststrategien</h3>
            <p class="text-2xl font-bold text-white mb-3">Testen ideal je nach Projekt</p>
            <p class="text-light-300">Die Teststrategien werden individuell auf das Projekt angepasst - Unit-Tests, Integrationstests oder End-to-End-Tests.</p>
          </div>
        </div>
        
        <div class="gsap-fadein relative lg:col-span-2 bg-gradient-to-br from-dark-900 to-dark-950 border border-blue-500/20 rounded-3xl overflow-hidden hover:border-blue-500/40 transition-all duration-300" style="animation-delay: 0.9s">
          <img class="h-80 w-full object-cover" src="/bento/bento-01-integrations.webp" alt="API-Integrationen mit Stripe, Sentry, Google Analytics – Moderne Webentwicklung mit Drittanbieter-Tools" loading="lazy">
          <div class="p-10">
            <h3 class="text-blue-400 font-semibold mb-2">Integrationen</h3>
            <p class="text-2xl font-bold text-white mb-3">Einbindung diverser Integrationen</p>
            <p class="text-light-300">Durch die Verbindung Ihrer Tools optimiere ich Ihre Prozesse um unnötige Schritte zu vermeiden.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quality Guarantees -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-blue-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-certificate text-blue-400 mr-2' aria-hidden='true'></i>
          Qualitätsversprechen
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Meine <span class='text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-500'>Garantien</span> für Sie
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6 text-center" style="animation-delay: 0.3s">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-universal-access text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">100% WCAG 2.0 AA</h3>
          <p class="text-sm text-light-300">Barrierefreiheit bei Web-Projekten</p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6 text-center" style="animation-delay: 0.45s">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-gauge-high text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Lighthouse &gt;90</h3>
          <p class="text-sm text-light-300">Performance & Best Practices</p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6 text-center" style="animation-delay: 0.6s">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-vial text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Automatisierte Tests</h3>
          <p class="text-sm text-light-300">Min. 70% Code Coverage</p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6 text-center" style="animation-delay: 0.75s">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-shield-halved text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Security Audit</h3>
          <p class="text-sm text-light-300">OWASP Top 10 Check</p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6 text-center" style="animation-delay: 0.9s">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-book text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Vollständige Doku</h3>
          <p class="text-sm text-light-300">Code + User Guide</p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-blue-500/20 rounded-xl p-6 text-center" style="animation-delay: 1.05s">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-brands fa-git-alt text-blue-400 text-xl"></i>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Git-Repository</h3>
          <p class="text-sm text-light-300">Mit sauberer History</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-900 to-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
