---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import Blog from '../../../components/Blog.astro';

// SEO & Meta
const titel = 'Softwareentwicklung Augsburg & München | Web-Apps & Individualsoftware';
const description = 'Zukunftssichere Softwareentwicklung mit Astro, Angular & Go. +150% Effizienz durch KI-gestützte Workflows. Ihr Partner für skalierbare Web-Apps in Bayern.';
const keywords = 'Softwareentwicklung Augsburg, Webentwicklung München, Individualsoftware Bayern, Web-App Agentur, Astro.js Experte, Go Programmierung, Cloud-Native Apps';
const ogImage = 'https://waldheim.dev/services/entwicklung-og.jpg';

// Structured Data: Professional Service (Specific to Development)
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Individualsoftware- & Webentwicklung',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Waldheim.dev',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Augsburg',
      'addressRegion': 'Bayern',
      'addressCountry': 'DE'
    }
  },
  'serviceType': 'Software Development',
  'areaServed': [
    { '@type': 'City', 'name': 'Augsburg' },
    { '@type': 'City', 'name': 'München' }
  ],
  'description': 'Entwicklung hochperformanter Webanwendungen, Microservices und PWAs mit Fokus auf Sicherheit, Skalierbarkeit und Barrierefreiheit.',
  'offers': {
    '@type': 'Offer',
    'description': 'Projektbasierte Softwareentwicklung & Agile Retainer'
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
}, {
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Softwareentwicklung',
  link: 'https://waldheim.dev/services/entwicklung'
}]);

const faqSchema = SchemaUtils.getFAQSchema([
  {
    question: 'Welchen Tech-Stack nutzen Sie für moderne Web-Apps?',
    answer: 'Ich setze auf performante und zukunftssichere Technologien: Astro.js für statische und inhaltsreiche Seiten, Angular für komplexe Enterprise-Anwendungen und Go (Golang) für hochverfügbare Backend-Services.'
  },
  {
    question: 'Wie garantieren Sie die Qualität der Software?',
    answer: 'Durch 10+ Jahre Erfahrung und strikte Standards: Automatisierte Tests (Playwright, Vitest), CI/CD-Pipelines, OWASP Security-Checks und eine 100%-Dokumentation sind integraler Bestandteil meiner Arbeit.'
  },
  {
    question: 'Bieten Sie auch Unterstützung als externer Product Owner an?',
    answer: 'Ja, durch meine PSPO I Zertifizierung unterstütze ich Sie nicht nur technisch, sondern auch strategisch bei der Produktvision und dem Backlog-Management im Raum Augsburg/München.'
  }
]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema, faqSchema]}
  image={ogImage}
>
  <main id="main-content">
    <!-- Hero Section: Fokus auf Performance & Erfahrung -->
    <ServiceHero 
      title="Softwareentwicklung"
      subtitle="Zukunftssichere & skalierbare"
      description="Ich entwickle Individualsoftware, die mit Ihrem Business wächst. Durch KI-gestützte Workflows liefere ich Ergebnisse in Rekordzeit – bei höchster technischer Qualität und Sicherheit."
      gradient="blue"
      icon="fa-code"
      badge="10+ Jahre Full-Stack Expertise"
    />

    <!-- Leistungen: Nutzenorientiert -->
    <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="dev-services-heading">
      <div class="mx-auto max-w-7xl">
        <header class="mx-auto max-w-2xl text-center mb-16">
          <h2 id="dev-services-heading" class="text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
            Meine Lösungen
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Software, die <span class="text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400">begeistert</span>
          </p>
          <p class="text-xl text-meg-text-secondary">
            Keine Standard-Templates, sondern präzise auf Ihre Geschäftsprozesse zugeschnittene Anwendungen.
          </p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-rocket text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">High-Performance Web-Apps</h3>
            <p class="text-meg-text-secondary text-sm">Entwicklung mit Astro & Angular für Ladezeiten unter 100ms und exzellente User Experience auf allen Geräten.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-gears text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Microservices & APIs</h3>
            <p class="text-meg-text-secondary text-sm">Robuste Backends mit Go (Golang) für maximale Skalierbarkeit und nahtlose Integration in Ihre IT-Landschaft.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/40 transition-all group">
            <i class="fa-solid fa-universal-access text-meg-accent text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Barrierefreie PWAs</h3>
            <p class="text-meg-text-secondary text-sm">Progressive Web Apps nach WCAG 2.0 AA Standard – inklusiv, offline-fähig und performant wie native Apps.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Tech-Stack & KI-Vorteil -->
    <section class="py-24 px-6 border-y border-meg-border-dark bg-meg-surface-dark/10">
      <div class="mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="bg-meg-surface-dark/30 rounded-3xl p-8 border border-meg-border-dark shadow-2xl">
            <div class="flex items-center gap-4 mb-8">
              <div class="size-16 bg-meg-accent/10 rounded-2xl flex items-center justify-center border border-meg-accent/20 text-meg-accent">
                <i class="fa-solid fa-brain text-3xl animate-pulse"></i>
              </div>
              <div>
                <h3 class="text-2xl font-bold">Der KI-Vorteil</h3>
                <p class="text-meg-accent font-bold">+150% Produktivität</p>
              </div>
            </div>
            <p class="text-meg-text-secondary mb-6 leading-relaxed">
              Ich nutze modernste KI-Agenten und spezialisierte LLMs für Code-Generierung, Refactoring und Qualitätssicherung. Für Sie bedeutet das:
            </p>
            <ul class="space-y-4 text-meg-text-primary-dark font-medium">
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400"></i> Drastisch verkürzte Time-to-Market</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400"></i> Höhere Test-Coverage & Code-Qualität</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400"></i> Mehr Zeit für strategische Business-Logik</li>
              <li class="flex items-center gap-3"><i class="fa-solid fa-check text-emerald-400"></i> Faire, ergebnisorientierte Preisgestaltung</li>
            </ul>
          </div>
          <div>
            <h2 class="text-3xl font-bold mb-6">Technologie ohne <span class="text-meg-accent">Kompromisse</span></h2>
            <p class="text-meg-text-secondary mb-8">
              Mein Tech-Stack ist darauf ausgelegt, technische Schulden zu vermeiden und maximale Wartbarkeit zu garantieren.
            </p>
            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Frontend</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">Astro, Angular, React, Tailwind</p>
              </div>
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Backend</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">Go, Node.js, Python, PostgreSQL</p>
              </div>
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Mobile</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">PWA, Capacitor, Flutter</p>
              </div>
              <div class="p-4 border border-meg-border-dark rounded-xl bg-meg-bg-dark/50">
                <span class="text-xs font-bold uppercase text-meg-accent block mb-2">Qualität</span>
                <p class="text-sm font-bold text-meg-text-primary-dark">Playwright, SonarQube, Vitest</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Qualitätsgarantien Bento -->
    <section class="py-24 px-6" aria-labelledby="quality-heading">
      <div class="mx-auto max-w-7xl">
        <header class="text-center mb-16">
          <h2 id="quality-heading" class="text-3xl font-black tracking-tight">Nachweisbare <span class="text-meg-accent">Exzellenz</span></h2>
        </header>
        <div class="grid lg:grid-cols-6 lg:grid-rows-2 gap-4">
          <article class="lg:col-span-3 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 flex flex-col justify-between hover:border-meg-accent/50 transition-all">
            <div>
              <span class="text-meg-accent font-bold uppercase tracking-widest text-xs">Performance</span>
              <h3 class="text-2xl font-bold mt-4 mb-4 text-meg-text-primary-dark">Lighthouse Score > 90</h3>
              <p class="text-meg-text-secondary text-sm">Ich garantiere Bestnoten in Performance, SEO und Best Practices – für maximale Sichtbarkeit und Conversion.</p>
            </div>
            <div class="mt-8 flex gap-4">
              <div class="size-12 border-2 border-emerald-500 rounded-full flex items-center justify-center text-emerald-500 font-bold">100</div>
              <div class="size-12 border-2 border-emerald-500 rounded-full flex items-center justify-center text-emerald-500 font-bold">98</div>
              <div class="size-12 border-2 border-emerald-500 rounded-full flex items-center justify-center text-emerald-500 font-bold">100</div>
            </div>
          </article>
          <article class="lg:col-span-3 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <span class="text-meg-accent font-bold uppercase tracking-widest text-xs">Sicherheit</span>
            <h3 class="text-2xl font-bold mt-4 mb-4 text-meg-text-primary-dark">Clean Code & Security Audit</h3>
            <p class="text-meg-text-secondary text-sm">Jede Anwendung durchläuft automatisierte Security-Checks (SAST) und manuelle Code-Reviews basierend auf den OWASP Top 10.</p>
            <div class="mt-8 bg-meg-bg-dark/50 rounded-xl p-4 border border-meg-border-dark">
              <code class="text-xs text-meg-accent">$ npm audit & security-check --passed</code>
            </div>
          </article>
          <article class="lg:col-span-2 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <h3 class="font-bold text-meg-text-primary-dark mb-4">100% Dokumentation</h3>
            <p class="text-meg-text-secondary text-xs">Von der API-Spezifikation (OpenAPI) bis zum Deployment-Guide – alles bleibt transparent und wartbar.</p>
          </article>
          <article class="lg:col-span-2 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <h3 class="font-bold text-meg-text-primary-dark mb-4">Agiles Mindset</h3>
            <p class="text-meg-text-secondary text-xs">Durch meine PSPO I Zertifizierung agiere ich als Sparringspartner für Ihre Business-Ziele, nicht nur als Umsetzer.</p>
          </article>
          <article class="lg:col-span-2 bg-meg-surface-dark border border-meg-border-dark rounded-3xl p-8 hover:border-meg-accent/50 transition-all">
            <h3 class="font-bold text-meg-text-primary-dark mb-4">10+ Jahre Erfahrung</h3>
            <p class="text-meg-text-secondary text-xs">Vom Startup-MVP bis zum Enterprise-System – ich habe die Fallstricke gesehen und gelöst.</p>
          </article>
        </div>
      </div>
    </section>

    <PriceService />
    <Blog limits={2} />
    <RelatedServices />
    <Partner />
  </main>
</Layout>