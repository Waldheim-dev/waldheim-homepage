---
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pricing from '../../../components/content/Pricing.astro';
import Partner from '../../../components/content/Partner.astro';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="relative">
    <div class="mx-auto max-w-7xl lg:grid lg:grid-cols-12 lg:gap-x-8 lg:px-8">
      <div
        class="px-6 pb-24 pt-10 sm:pb-32 lg:col-span-7 lg:px-0 lg:pb-56 lg:pt-48 xl:col-span-6"
      >
        <div class="mx-auto max-w-2xl lg:mx-0">
          <div class="hidden sm:mt-32 sm:flex lg:mt-16">
            <div
              class="relative rounded-full px-3 py-1 text-sm leading-6 text-gray-500 dark:text-gray-400 ring-1 ring-gray-900/10 hover:ring-gray-900/20 dark:ring-gray-50/10 dark:hover:ring-gray-50/20"
            >
              Entwicklungsprozesse sollten automatisiert werden und sicher sein
            </div>
          </div>
          <h1
            class="mt-24 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:mt-10 sm:text-6xl"
          >
            DevSecOps und GitOps einfacher machen
          </h1>
          <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
            Für einige Firmen sind die Entwicklungsprozesse kostspielig. Doch
            man kann mit wenigen Tricks schon die Entwicklungsprozesse
            optimieren. Es gibt zwar nicht die goldene Lösung, die für jede
            Firman passt. Doch bei Begriffen wie Scrum, DevSecOps und GitOps
            kann man viel für die Entwickler machen, um die Entwicklung zu
            beschleunigen und die Qualität massiv zu verbessern.
          </p>
        </div>
      </div>
      <div
        class="relative lg:col-span-5 lg:-mr-8 xl:absolute xl:inset-0 xl:left-1/2 xl:mr-0"
      >
        <img
          class="aspect-[3/2] w-full bg-gray-50 object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full rounded-bl-2xl"
          src="https://images.unsplash.com/photo-1631624210938-539575f92e3c?q=80&w=2187&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2102&q=80"
          alt=""
        />
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-800 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-2xl lg:text-center">
        <h2
          class="text-base font-semibold leading-7 text-wd-600 dark:text-wd-400"
        >
          Das beste rausholen
        </h2>
        <p
          class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl"
        >
          Zeitersparnis durch Optimierung
        </p>
        <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400">
          Mit AI und skalierten Umgebungen auf höchster Sicherheit arbeiten
        </p>
      </div>
      <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl">
        <dl
          class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16"
        >
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-wd-600"
              >
                <i class="fa-regular text-white fa-circle-nodes"></i>
              </div>
              Docker, Cluster
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Isoliert und skaliert eure Infrastruktur. Mit Docker und
              Kubernetes. Egal ob auf eurem Server oder in der Cloud.
            </dd>
          </div>
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-wd-600"
              >
                <i class="fa-regular text-white fa-brain"></i>
              </div>
              AI
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Nutzen Sie AI um Ihre Prozesse zu optimieren. Nutzen Sie KI heute
              schon DSGVO-Konform.
            </dd>
          </div>
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-wd-600"
              >
                <i class="fa-regular text-white fa-shield"></i>
              </div>
              Security
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Optimieren Sie Ihre Sicherheit. Mit automatisierten Checks und
              modernen Techniken.
            </dd>
          </div>
          <div class="relative pl-16">
            <dt
              class="text-base font-semibold leading-7 text-gray-900 dark:text-gray-100"
            >
              <div
                class="absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-wd-600"
              >
                <i class="fa-regular text-white fa-flask-vial"></i>
              </div>
              Automatisierung und Testabdeckung
            </dt>
            <dd
              class="mt-2 text-base leading-7 text-gray-600 dark:text-gray-400"
            >
              Achten sie auf sinnvolle Tests und automatisieren Sie Ihre
              Prozesse. So können Sie sich auf die eigentliche Programmierung
              konzentrieren.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-800 py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
      <h2 class="text-base/7 font-semibold text-wd-600 dark:text-wd-400">Schneller deployen</h2>
      <p class="mt-2 max-w-lg text-pretty text-4xl font-medium tracking-tight text-gray-950 dark:text-white sm:text-5xl">Alles was du für dein Deployment brauchst.</p>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
        <div class="relative lg:col-span-3">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] max-lg:rounded-t-[calc(2rem+1px)] lg:rounded-tl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left" src="https://tailwindui.com/plus/img/component-images/bento-01-performance.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-wd-600 dark:text-wd-400">Performance</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Bauen in Lichtgeschwindigkeit</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Dank besten Building-Tools holen wir gemeinsam die beste Performance aus euren Tools raus.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-3">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 lg:rounded-tr-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] lg:rounded-tr-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left lg:object-right" src="https://tailwindui.com/plus/img/component-images/bento-01-releases.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-wd-600 dark:text-wd-400">Releases</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Schnelle Deployments</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">So schnell habt ihr bislang nicht in dieser Qualität Releases gebaut. Voll automatisiert.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 lg:rounded-tr-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 lg:rounded-bl-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] lg:rounded-bl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left" src="https://tailwindui.com/plus/img/component-images/bento-01-speed.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-wd-600 dark:text-wd-400">Geschwindigkeit</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Gemacht für Powerusers</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Geht auf das nächste Level der Performance und nutzt die volle Power.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 lg:rounded-bl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 "></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)]">
            <img class="h-80 object-cover object-center" src="https://tailwindui.com/plus/img/component-images/bento-01-integrations.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-wd-600 dark:text-wd-400">Integration</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Nutze die Power deiner Tools</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Nutze das volle Potential und lasse deine Tools zusammen arbeiten.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] max-lg:rounded-b-[calc(2rem+1px)] lg:rounded-br-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-center" src="https://tailwindui.com/plus/img/component-images/bento-01-network.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-wd-600 dark:text-wd-400">Ortunabhängig</h3>
              <p class="mt-2 text-lg/7 font-medium tracking-tight text-gray-950 dark:text-white">Global entwickeln und nutzen</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-gray-300">Frei von Orten kannst du sicher und stabil arbeiten.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
        </div>
      </div>
    </div>
  </div>
  

  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="text-base font-semibold leading-7 text-wd-600 dark:text-wd-400">
          Deployment Vergleiche
        </h2>
        <p
          class="mt-2 text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Welches Deployment kann was?<p></p>
          <p
            class="mx-auto mt-6 max-w-2xl text-center text-lg leading-8 text-gray-600 dark:text-gray-300"
          >
            Vergleichen wir die Deployments und wähken Sie, was sie wollen
          </p>

          <!-- lg+ -->
          <div class="isolate mt-20">
            <div class="relative -mx-8">
              <div class="absolute inset-x-4 inset-y-0 -z-10 flex">
                <div
                  class="flex w-1/4 px-4"
                  style="margin-left: 75%"
                  aria-hidden="true"
                >
                  <div
                    class="w-full rounded-t-xl border-x border-t border-gray-900/10 bg-gray-400/5 dark:border-gray-50/10 dark:bg-slate-700/60"
                  >
                  </div>
                </div>
              </div>
              <table
                class="w-full table-fixed border-separate border-spacing-x-8 text-left"
              >
                <caption class="sr-only"> Deployment Vergleiche </caption>
                <colgroup>
                  <col class="w-1/4" />
                  <col class="w-1/4" />
                  <col class="w-1/4" />
                  <col class="w-1/4" />
                </colgroup>
                <thead>
                  <tr>
                    <td></td>
                    <th scope="col" class="px-6 pt-6 xl:px-8 xl:pt-8">
                      <div
                        class="text-sm font-semibold leading-7 text-gray-900 dark:text-white"
                      >
                        Native Deploy
                      </div>
                    </th>
                    <th scope="col" class="px-6 pt-6 xl:px-8 xl:pt-8">
                      <div
                        class="text-sm font-semibold leading-7 text-gray-900 dark:text-white"
                      >
                        Docker Deploy
                      </div>
                    </th>
                    <th scope="col" class="px-6 pt-6 xl:px-8 xl:pt-8">
                      <div
                        class="text-sm font-semibold leading-7 text-gray-900 dark:text-white"
                      >
                        Cluster Deploy
                      </div>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th
                      scope="colgroup"
                      colspan="4"
                      class="pb-4 pt-8 text-sm font-semibold leading-6 text-gray-900 dark:text-white"
                    >
                      Features
                      <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/10 dark:bg-white/10">
                      </div>
                    </th>
                  </tr>
                  <tr>
                    <th
                      scope="row"
                      class="py-4 text-sm font-normal leading-6 text-gray-900 dark:text-white"
                    >
                      Deployment
                      <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/5 dark:bg-white/5">
                      </div>
                    </th>
                    <td class="px-6 py-4 xl:px-8">
                      <div class="text-center text-sm leading-6 text-gray-500">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mx-auto h-5 w-5 text-gray-400"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z"
                          ></path>
                        </svg>

                        <span class="sr-only">Mit Scripten oder SSH</span>
                      </div>
                    </td>
                    <td class="px-6 py-4 xl:px-8">
                      <div class="text-center text-sm leading-6 text-gray-500">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="1.5"
                          stroke="currentColor"
                          class="mx-auto h-5 w-5 text-gray-400"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5"
                          ></path>
                        </svg>

                        <span class="sr-only">Push-Prinzip mit CI/CD</span>
                      </div>
                    </td>
                    <td class="px-6 py-4 xl:px-8">
                      <div
                        class="text-center text-sm leading-6 text-gray-500"
                        title="Pull-Prinzip mit Flux"
                      >
                      </div>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="mx-auto h-5 w-5 text-gray-400"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"
                        ></path>
                      </svg>
                      <span class="sr-only">Pull-Prinzip mit Flux</span>
                    </td>
                  </tr>
                </tbody>
                <tr>
                  <th
                    scope="row"
                    class="py-4 text-sm font-normal leading-6 text-gray-900 dark:text-white"
                  >
                    Einrichtungszeit
                    <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/5 dark:bg-white/5">
                    </div>
                  </th>
                  <td class="px-6 py-4 xl:px-8">
                    <div class="text-center text-sm leading-6 text-gray-500">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" 
                      class="mx-auto h-5 w-5 text-gray-400">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.042 21.672 13.684 16.6m0 0-2.51 2.225.569-9.47 5.227 7.917-3.286-.672ZM12 2.25V4.5m5.834.166-1.591 1.591M20.25 10.5H18M7.757 14.743l-1.59 1.59M6 10.5H3.75m4.007-4.243-1.59-1.59" />
                      </svg>               
                      <span class="sr-only">Manuelles Installation</span>
                    </div>
                  </td>
                  <td class="px-6 py-4 xl:px-8">
                    <div class="text-center text-sm leading-6 text-gray-500">
                        <img src="/public/brands/docker-icon.svg" class="mx-auto h-5 w-5" alt="Docker" />
                      <span class="sr-only">Mit Docker in wenigen Minuten</span>
                      
                    </div>
                  </td>
                  <td class="px-6 py-4 xl:px-8">
                    <div class="text-center text-sm leading-6 text-gray-500">
                      <img src="/public/brands/terraform.svg" class="mx-auto h-5 w-5" alt="Docker" />
                    <span class="sr-only">Mit Terraform und Helm</span>
                      
                    </div>
                  </td>
                </tr>
                <tr>
                  <th
                    scope="row"
                    class="py-4 text-sm font-normal leading-6 text-gray-900 dark:text-white"
                  >
                    Entwicklung
                    <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/5 dark:bg-white/5">
                    </div>
                  </th>
                  <td class="px-6 py-4 xl:px-8">
                    <svg
                      class="mx-auto h-5 w-5 text-wd-600 dark:text-wd-400"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span class="sr-only">Enthalten</span>
                  </td>
                  <td class="px-6 py-4 xl:px-8">
                    <svg
                      class="mx-auto h-5 w-5 text-wd-600 dark:text-wd-400"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span class="sr-only">Enthalten</span>
                  </td>
                  <td class="px-6 py-4 xl:px-8">
                    <svg
                      class="mx-auto h-5 w-5 text-wd-600 dark:text-wd-400"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span class="sr-only">Enthalten</span>
                  </td>
                </tr>
                <tr>
                  <th
                    scope="row"
                    class="py-4 text-sm font-normal leading-6 text-gray-900 dark:text-white"
                  >
                    Git Integration
                    <div class="absolute inset-x-8 mt-4 h-px bg-gray-900/5 dark:bg-white/5">
                    </div>
                  </th>
                  <td class="px-6 py-4 xl:px-8">
                    <svg
                      class="mx-auto h-5 w-5 text-wd-600 dark:text-wd-400"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                        clip-rule="evenodd"></path>
                    </svg>
                    <span class="sr-only">Enthalten</span>
                  </td>
                  <td class="px-6 py-4 xl:px-8">
                    <svg
                      class="mx-auto h-5 w-5 text-wd-600 dark:text-wd-400"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
