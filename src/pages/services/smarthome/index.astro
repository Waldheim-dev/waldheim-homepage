<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema, faqSchema]}
  image={ogImage}
>
  <main id="main-content">
    <ServiceHero 
      title="Smart Home, KNX & Local AI"
      subtitle="Intelligente Gebäudeautomation & KI-Effizienz –"
      description="Von KNX-Bustechnik über Home Assistant bis zur Optimierung mittels lokaler KI: Ich mache Ihr Gebäude messbar effizienter – mit Fokus auf Energiekosten-Optimierung, adaptive Alltags-Routinen, Heizung, Beschattung und AI-Sicherheit. 100% lokal, ohne Cloud-Zwang."
      gradient="orange"
      icon="fa-house"
      badge="KNX · Lokale KI · Kosten- & Effizienzoptimierung · Routinen"
    />

    <!-- Hauptleistungen -->
    <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="smarthome-services-heading">
      <div class="mx-auto max-w-7xl">
        <header class="gsap-fadein mx-auto max-w-2xl text-center mb-16">
          <h2 id="smarthome-services-heading" class="text-sm font-bold uppercase tracking-widest text-orange-400 mb-4">
            <i class="fa-solid fa-house mr-2" aria-hidden="true"></i>
            Leistungen &amp; Local AI
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Ihr Haus denkt <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-500">lokal mit</span>
          </p>
          <p class="text-xl text-meg-text-secondary">
            Maximaler Wohnkomfort, spürbare Energiekosten-Senkung und smarte Routinen durch KNX, Home Assistant und lokale KI.
          </p>
        </header>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-brain text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">Lokale KI-Optimierung</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">Integration einer 100% lokalen KI (Ollama, Local LLMs &amp; Home Assistant) ohne Cloud-Abhängigkeit. Intelligente Mustererkennung, natürliche Sprachsteuerung und autonome Effizienz-Analysen direkt im eigenen Heimnetz.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-coins text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">Kosten- &amp; Energieeffizienz</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">KI-gestütztes Energiemanagement für PV-Überschuss, dynamische Stromtarife, Wärmepumpen und Großverbraucher. Aufdecken von Stromfressern, Standby-Abschaltung und vorausschauende Lastverschiebung.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-wand-magic-sparkles text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">Adaptive KI-Routinen</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">Smarte Routinen statt starrer Zeitpläne: Das System verknüpft Präsenz, Kalender, Wetterprognose, Sonnenstand und Gewohnheiten für nahtlose Abläufe im Alltag – kontinuierlich im eigenen Smart-Home-Reallabor verfeinert.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-bolt text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">KNX-Gebäudeautomation</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">Planung und Inbetriebnahme professioneller KNX-Installationen für Neubau und Sanierung. Bustopologie, Aktor-/Sensor-Auswahl, ETS5/6-Programmierung und vollständige Dokumentation.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-grid-horizontal text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">Rollläden &amp; Beschattung</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">Wetter- und sonnenstandsgeführte Beschattung hält Räume im Sommer passiv kühl und nutzt im Winter solare Gewinne. Integration per KNX-Jalousieaktoren oder Nachrüstmodulen (Shelly).</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-temperature-half text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">Heizungs- &amp; Klimasteuerung</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">Vorausschauende Regelung von Fußbodenheizung, Heizkörpern und Wärmepumpen. Raumweise Temperaturprofile, Fenster-Offen-Erkennung und KI-gestützte Aufheizkurven senken Heizkosten nachhaltig.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-lightbulb text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">Beleuchtungssteuerung</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">DALI, DMX oder Tasterdimmer via KNX &amp; Zigbee: stimmungsvolle Lichtszenen, präsenzabhängiges Schalten, Human Centric Lighting (HCL) und automatische Nachtbeleuchtung ohne Energieverschwendung.</p>
          </article>
          <article class="gsap-fadein bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/40 transition-all group">
            <i class="fa-solid fa-camera text-orange-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-3">Sicherheit &amp; AI-Kameras</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">Lokales Kamera-Sicherheitssystem mit AI-Personenerkennung (Frigate NVR + Coral TPU), Echtzeit-Benachrichtigungen, Türklingel-Integration und zentralem Home-Assistant-Dashboard – komplett ohne Cloud.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Local AI, Kostenoptimierung & Routinen Deep-Dive -->
    <section class="py-24 px-6 border-t border-meg-border-dark bg-meg-surface-dark/20" aria-labelledby="local-ai-smarthome-heading">
      <div class="mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-12 gap-12 items-center">
