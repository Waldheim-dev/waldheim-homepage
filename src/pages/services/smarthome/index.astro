---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Smart Home',
  link: 'https://waldheim.dev/services/smarthome'
}]);

const titel = "Smart Home Konzepte & Beratung | Unabhängig | waldheim.dev";
const description = "Smart Home Beratung Augsburg & München: Unabhängige Planung und Umsetzung Ihres individuellen Smart Home Systems – ohne Herstellerbindung. Kompetenz aus Bayern.";
const keywords = "Smart Home, Hausautomation, IoT, unabhängige Beratung, Smart Home Installation, Konzepte, Eigenbau, Home Assistant, MQTT, Z-Wave, Zigbee";

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Smart Home Beratung & Konzepte',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'Smart Home Consulting',
  areaServed: 'DE',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/smarthome-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="Smart Home"
    subtitle="Unabhängiges & sicheres"
    description="Keine teuren Systeme mit Herstellerbindung! Ich zeige Ihnen, wie Sie mit Home Assistant & Co. Ihr eigenes Smart Home aufbauen – kostengünstig, sicher und selbstbestimmt. Von der Planung bis zur Umsetzung."
    gradient="orange"
    icon="fa-house-signal"
    badge="Open Source & unabhängig"
  />

  <!-- Main Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900' id='leistungen'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-base font-semibold text-orange-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-home text-orange-400 mr-2' aria-hidden='true'></i>
          Individuelle Smart Home Beratung
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
          Intelligente <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500'>Vernetzung</span> – ganz nach Ihren Vorstellungen
        </p>
        <p class='gsap-fadein text-xl text-light-300' style='animation-delay: 0.3s'>
          Ich unterstütze Sie bei der Planung und Umsetzung Ihres individuellen Smart Homes – mit dem Fokus auf offene Systeme und volle Kontrolle für Sie.
        </p>
      </div>
      
      <div class='grid md:grid-cols-2 gap-8 max-w-5xl mx-auto'>
        <div class='gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-2xl p-8 hover:border-orange-500/40 transition-all duration-300' style='animation-delay: 0.45s'>
          <div class='w-14 h-14 bg-orange-500/10 border border-orange-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-microchip text-orange-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Geräteauswahl & -konfiguration</h3>
          <p class='text-light-300'>
            Oft reichen günstige Geräte wie Raspberry Pis für ein leistungsstarkes Smart Home. Ich berate Sie herstellerunabhängig und helfe Ihnen bei der Auswahl und Konfiguration der passenden Hardware.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-2xl p-8 hover:border-orange-500/40 transition-all duration-300' style='animation-delay: 0.6s'>
          <div class='w-14 h-14 bg-orange-500/10 border border-orange-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-network-wired text-orange-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Zentrale Steuerung & Vernetzung</h3>
          <p class='text-light-300'>
            Ich zeige Ihnen, wie Sie Ihre Geräte zentral steuern – mit etablierten Systemen wie Home Assistant, MQTT und Node-RED. Keine Insellösungen, sondern ein integriertes System!
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-2xl p-8 hover:border-orange-500/40 transition-all duration-300' style='animation-delay: 0.75s'>
          <div class='w-14 h-14 bg-orange-500/10 border border-orange-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-lock text-orange-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Sicherheit & Datenschutz</h3>
          <p class='text-light-300'>
            Ich lege größten Wert auf Sicherheit. Durch lokale Steuerung und den Verzicht auf unnötige Cloud-Dienste behalten Sie die volle Kontrolle über Ihre Daten.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-2xl p-8 hover:border-orange-500/40 transition-all duration-300' style='animation-delay: 0.9s'>
          <div class='w-14 h-14 bg-orange-500/10 border border-orange-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-wrench text-orange-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Wartung, Updates & Support</h3>
          <p class='text-light-300'>
            Ich zeige Ihnen, wie Sie Ihr System selbstständig warten und aktualisieren. Und wenn Sie doch einmal Hilfe benötigen, stehe ich Ihnen zur Seite.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- System Comparison -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-orange-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-scale-balanced text-orange-400 mr-2' aria-hidden='true'></i>
          System-Vergleich
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          Welches Smart Home System <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500'>passt zu Ihnen?</span>
        </p>
      </div>
      
      <div tabindex="0" class="overflow-x-auto rounded-xl border border-orange-500/20">
        <table class="w-full text-left">
          <thead class="bg-dark-800">
            <tr>
              <th class="px-6 py-4 text-light-100">Kriterium</th>
              <th class="px-6 py-4 text-light-100">Google/Alexa</th>
              <th class="px-6 py-4 text-light-100">Apple HomeKit</th>
              <th class="px-6 py-4 text-light-100 bg-orange-500/10">
                <i class='fa-solid fa-crown text-orange-400 mr-2' aria-hidden='true'></i>
                Home Assistant
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-light-500/10">
              <td class="px-6 py-4 text-light-300 font-semibold">Kosten</td>
              <td class="px-6 py-4 text-light-300">€</td>
              <td class="px-6 py-4 text-light-300">€€</td>
              <td class="px-6 py-4 text-green-400 bg-orange-500/5">€ (günstig)</td>
            </tr>
            <tr class="border-t border-light-500/10">
              <td class="px-6 py-4 text-light-300 font-semibold">Datenschutz</td>
              <td class="px-6 py-4">
                <span class="text-red-400"><i class='fa-solid fa-xmark' aria-hidden='true'></i> Cloud</span>
              </td>
              <td class="px-6 py-4">
                <span class="text-orange-400"><i class='fa-solid fa-triangle-exclamation' aria-hidden='true'></i> Cloud</span>
              </td>
              <td class="px-6 py-4 bg-orange-500/5">
                <span class="text-green-400"><i class='fa-solid fa-check' aria-hidden='true'></i> Lokal</span>
              </td>
            </tr>
            <tr class="border-t border-light-500/10">
              <td class="px-6 py-4 text-light-300 font-semibold">Flexibilität</td>
              <td class="px-6 py-4">
                <span class="text-orange-400"><i class='fa-solid fa-triangle-exclamation' aria-hidden='true'></i> Begrenzt</span>
              </td>
              <td class="px-6 py-4">
                <span class="text-orange-400"><i class='fa-solid fa-triangle-exclamation' aria-hidden='true'></i> Begrenzt</span>
              </td>
              <td class="px-6 py-4 bg-orange-500/5">
                <span class="text-green-400"><i class='fa-solid fa-check' aria-hidden='true'></i><i class='fa-solid fa-check' aria-hidden='true'></i><i class='fa-solid fa-check' aria-hidden='true'></i> Sehr hoch</span>
              </td>
            </tr>
            <tr class="border-t border-light-500/10">
              <td class="px-6 py-4 text-light-300 font-semibold">Komplexität</td>
              <td class="px-6 py-4">
                <span class="text-green-400"><i class='fa-solid fa-check' aria-hidden='true'></i> Einfach</span>
              </td>
              <td class="px-6 py-4">
                <span class="text-green-400"><i class='fa-solid fa-check' aria-hidden='true'></i> Einfach</span>
              </td>
              <td class="px-6 py-4 bg-orange-500/5">
                <span class="text-orange-400"><i class='fa-solid fa-triangle-exclamation' aria-hidden='true'></i> Mittel</span>
              </td>
            </tr>
            <tr class="border-t border-light-500/10">
              <td class="px-6 py-4 text-light-300 font-semibold">Automatisierung</td>
              <td class="px-6 py-4">
                <span class="text-orange-400"><i class='fa-solid fa-triangle-exclamation' aria-hidden='true'></i> Basic</span>
              </td>
              <td class="px-6 py-4">
                <span class="text-orange-400"><i class='fa-solid fa-triangle-exclamation' aria-hidden='true'></i> Basic</span>
              </td>
              <td class="px-6 py-4 bg-orange-500/5">
                <span class="text-green-400"><i class='fa-solid fa-check' aria-hidden='true'></i><i class='fa-solid fa-check' aria-hidden='true'></i><i class='fa-solid fa-check' aria-hidden='true'></i> Sehr hoch</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      
      <div class="mt-8 text-center">
        <p class="text-light-300">
          <i class='fa-solid fa-lightbulb text-orange-400 mr-2' aria-hidden='true'></i>
          <strong class="text-white">Empfehlung:</strong> Home Assistant für maximale Kontrolle, Datenschutz und Flexibilität!
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-900 to-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-orange-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-circle-question text-orange-400 mr-2' aria-hidden='true'></i>
          Häufig gestellte Fragen
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500'>Fragen & Antworten</span> zu Smart Home
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-6">
        <div class="gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-xl p-8" style="animation-delay: 0.3s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-orange-400 mr-3' aria-hidden='true'></i>
            Kann ich meine Alexa/Google-Geräte weiter nutzen?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Ja! Home Assistant kann diese einbinden und als Sprachassistent-Schnittstelle nutzen – Sie behalten Ihre gewohnten Geräte.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-xl p-8" style="animation-delay: 0.45s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-orange-400 mr-3' aria-hidden='true'></i>
            Brauche ich technisches Wissen?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Grundkenntnisse helfen, aber ich begleite Sie durch den gesamten Prozess. Optional biete ich auch Schulungen an (2h Workshop = 150€, remote).
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-xl p-8" style="animation-delay: 0.6s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-orange-400 mr-3' aria-hidden='true'></i>
            Was passiert bei Internet-Ausfall?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Lokale Automatisierungen (z.B. Licht-Schalter, Sensoren) laufen weiter! Nur Cloud-abhängige Dienste (z.B. Wetter-Updates) fallen aus.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-xl p-8" style="animation-delay: 0.75s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-orange-400 mr-3' aria-hidden='true'></i>
            Wie sicher ist Home Assistant?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Sehr sicher! Läuft lokal (kein Cloud-Zwang), Updates selbst kontrollierbar, keine Daten an Dritte. Ich helfe bei der sicheren Einrichtung.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-orange-500/20 rounded-xl p-8" style="animation-delay: 0.9s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-orange-400 mr-3' aria-hidden='true'></i>
            Arbeiten Sie vor Ort oder remote?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> 100% remote! Konzeption, Beratung und Support erfolgen über Videocalls. Die Hardware-Installation können Sie selbst vornehmen (mit meiner Anleitung) oder über lokale Partner.
          </p>
        </div>
      </div>
    </div>
  </section>

  <PriceService />

  <RelatedServices 
    services={[
      {
        title: "IT-Service & Cloud",
        href: "/services/it-service/",
        icon: "fa-solid fa-cloud",
        description: "Cloud-Integration für Ihr Smart Home – sicherer Remote-Zugriff von überall.",
        color: "green"
      },
      {
        title: "Webentwicklung & Software",
        href: "/services/entwicklung/",
        icon: "fa-solid fa-code",
        description: "Custom Dashboards und Apps für Ihr Smart Home System – perfekt auf Ihre Bedürfnisse zugeschnitten.",
        color: "blue"
      },
      {
        title: "DevSecOps & Automatisierung",
        href: "/services/devsecops/",
        icon: "fa-solid fa-shield-check",
        description: "Automatisierte Updates, Monitoring und Sicherheit – Ihr Smart Home immer aktuell und geschützt.",
        color: "purple"
      }
    ]}
  />

  <Partner />
</Layout>
