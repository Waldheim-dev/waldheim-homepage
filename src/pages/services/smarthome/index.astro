---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'Smart Home',
  link: 'https://waldheim.dev/services/smarthome'
}]);

const titel = "Smart Home Konzepte & Beratung | Unabhängig | waldheim.dev";
const description = "Smart Home Beratung Augsburg & München: Unabhängige Planung und Umsetzung Ihres individuellen Smart Home Systems – ohne Herstellerbindung. Kompetenz aus Bayern.";
const keywords = "Smart Home, Hausautomation, IoT, unabhängige Beratung, Smart Home Installation, Konzepte, Eigenbau, Home Assistant, MQTT, Z-Wave, Zigbee";

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Smart Home Beratung & Konzepte',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'Smart Home Consulting',
  areaServed: 'DE',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/smarthome-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="Smart Home"
    subtitle="Unabhängiges & sicheres"
    description="Keine teuren Systeme mit Herstellerbindung! Ich zeige Ihnen, wie Sie mit Home Assistant & Co. Ihr eigenes Smart Home aufbauen – kostengünstig, sicher und selbstbestimmt. Von der Planung bis zur Umsetzung."
    gradient="orange"
    icon="fa-house-signal"
    badge="Open Source & unabhängig"
  />

  <!-- Main Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark' id='leistungen'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-orange-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-house mr-2' aria-hidden='true'></i>
          Konzept-Beratung
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
          Intelligente <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500'>Vernetzung</span> – herstellerunabhängig
        </p>
        <p class='gsap-fadein text-xl text-meg-text-secondary' style='animation-delay: 0.3s'>
          Ich unterstütze Sie bei der Planung Ihres individuellen Smart Homes – Fokus auf offene Systeme und volle Kontrolle.
        </p>
      </div>
      
      <div class='grid md:grid-cols-2 gap-8 max-w-5xl mx-auto'>
        {[
          { title: 'Hardware-Beratung', desc: 'Herstellerunabhängige Auswahl passender Geräte (z.B. Raspberry Pi, Zigbee, Z-Wave).', icon: 'fa-microchip' },
          { title: 'Zentrale Steuerung', desc: 'Vernetzung mit Home Assistant, MQTT und Node-RED – keine Insellösungen.', icon: 'fa-network-wired' },
          { title: 'Sicherheit & Privacy', desc: 'Lokale Steuerung ohne Cloud-Zwang für maximale Kontrolle über Ihre Daten.', icon: 'fa-lock' },
          { title: 'Support & Wartung', desc: 'Anleitung zur Selbsthilfe und kompetente Unterstützung bei Erweiterungen.', icon: 'fa-wrench' }
        ].map((feat, i) => (
          <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-orange-500/30 hover:shadow-lg hover:shadow-orange-500/5 transition-all duration-300 group' style={`animation-delay: ${0.45 + i * 0.15}s`}>
            <div class='w-14 h-14 bg-orange-500/10 border border-orange-500/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform'>
              <i class={`fa-solid ${feat.icon} text-orange-400 text-2xl`}></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>{feat.title}</h3>
            <p class='text-meg-text-secondary leading-relaxed'>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- System Comparison -->
  <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-orange-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-scale-balanced mr-2' aria-hidden='true'></i>
          Vergleich
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Smart Home <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500'>Ökosysteme</span>
        </p>
      </div>
      
      <div tabindex="0" class="overflow-x-auto rounded-2xl border border-meg-border-dark bg-meg-surface-dark/30 backdrop-blur-md shadow-sm">
        <table class="w-full text-left border-collapse">
          <thead class="bg-meg-surface-dark/50 text-meg-text-primary-dark">
            <tr>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark">Kriterium</th>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark">Google/Alexa</th>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark">Apple HomeKit</th>
              <th class="px-6 py-4 font-bold border-b border-meg-border-dark bg-orange-500/5 text-orange-400">
                <i class='fa-solid fa-crown mr-2' aria-hidden='true'></i>
                Home Assistant
              </th>
            </tr>
          </thead>
          <tbody class="text-meg-text-secondary">
            {[
              { f: 'Kosten', c1: '€', c2: '€€', c3: '€ (günstig)', c3color: 'text-emerald-400' },
              { f: 'Datenschutz', c1: 'Cloud (kritisch)', c2: 'Cloud', c3: 'Lokal (top)', c3color: 'text-emerald-400' },
              { f: 'Flexibilität', c1: 'Begrenzt', c2: 'Begrenzt', c3: 'Sehr hoch', c3color: 'text-emerald-400' },
              { f: 'Komplexität', c1: 'Einfach', c2: 'Einfach', c3: 'Mittel', c3color: 'text-orange-400' },
              { f: 'Automatisierung', c1: 'Basic', c2: 'Basic', c3: 'Sehr hoch', c3color: 'text-emerald-400' }
            ].map((row) => (
              <tr class="border-b border-meg-border-dark/50 hover:bg-meg-accent/5 transition-colors">
                <td class="px-6 py-4 font-bold text-meg-text-primary-dark">{row.f}</td>
                <td class="px-6 py-4">{row.c1}</td>
                <td class="px-6 py-4">{row.c2}</td>
                <td class={`px-6 py-4 bg-orange-500/5 font-medium ${row.c3color}`}>{row.c3}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      
      <div class="mt-8 text-center">
        <div class="gsap-fadein inline-flex items-center gap-3 px-4 py-2 bg-meg-surface-dark/50 border border-meg-border-dark rounded-full shadow-sm">
          <i class='fa-solid fa-lightbulb text-orange-400 text-xs' aria-hidden='true'></i>
          <p class="text-meg-text-secondary text-[10px] font-black uppercase tracking-widest">
            Empfehlung: <span class="text-meg-text-primary-dark">Home Assistant</span> für maximale Freiheit
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-orange-400 mb-4" style="animation-delay: 0s">
          Support
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Fragen & <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500'>Antworten</span>
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {[
          { q: 'Alexa/Google-Integration?', a: 'Ja! Home Assistant bindet diese als Sprach-Schnittstelle ein. Sie behalten Ihre gewohnten Geräte.' },
          { q: 'Internet-Ausfall?', a: 'Lokale Automatisierungen laufen weiter! Nur Cloud-Dienste (z.B. Wetter) sind kurzzeitig offline.' },
          { q: 'Wie sicher ist das?', a: 'Sehr sicher, da alles lokal läuft. Kein Cloud-Zwang, keine Datenweitergabe an Dritte.' },
          { q: 'Arbeiten Sie vor Ort?', a: 'Ich berate 100% remote. Die Installation ist dank meiner Anleitung oft selbst machbar.' }
        ].map((faq, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/20 transition-all shadow-sm group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <h3 class="text-lg font-bold text-meg-text-primary-dark mb-4 flex items-start gap-3">
              <span class="text-orange-400 font-black">Q</span> {faq.q}
            </h3>
            <p class="text-meg-text-secondary pl-7 leading-relaxed">
              <span class="text-meg-accent font-bold mr-2">A:</span> {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PriceService />

  <RelatedServices 
    services={[
      {
        title: "IT-Service & Cloud",
        href: "/services/it-service/",
        icon: "fa-solid fa-cloud",
        description: "Cloud-Integration für Ihr Smart Home – sicherer Remote-Zugriff von überall.",
        color: "green"
      },
      {
        title: "Webentwicklung & Software",
        href: "/services/entwicklung/",
        icon: "fa-solid fa-code",
        description: "Custom Dashboards und Apps für Ihr Smart Home System – perfekt auf Ihre Bedürfnisse zugeschnitten.",
        color: "blue"
      },
      {
        title: "DevSecOps & Automatisierung",
        href: "/services/devsecops/",
        icon: "fa-solid fa-shield-check",
        description: "Automatisierte Updates, Monitoring und Sicherheit – Ihr Smart Home immer aktuell und geschützt.",
        color: "purple"
      }
    ]}
  />

  <Partner />
</Layout>
