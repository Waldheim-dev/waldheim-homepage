---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';
import Blog from '../../../components/Blog.astro';

// SEO & Meta
const titel = 'Managed IT-Service Augsburg & München | Cloud & Support';
const description = 'Professioneller IT-Service für KMU: Managed Cloud, Netzwerk-Sicherheit & Remote-Support in Augsburg und München. Maximale Verfügbarkeit für Ihre IT.';
const keywords = 'IT-Service Augsburg, IT-Support München, Managed Services Bayern, Cloud Migration KMU, IT-Infrastruktur Wartung, Remote IT-Administration';
const ogImage = 'https://waldheim.dev/services/it-service-og.jpg';

// Structured Data: Professional Service (Specific to IT Support)
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Managed IT-Service & Cloud Support',
  'provider': {
    '@type': 'ProfessionalService',
    'name': 'Waldheim.dev',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': 'Augsburg',
      'addressRegion': 'Bayern',
      'addressCountry': 'DE'
    }
  },
  'serviceType': 'IT Support & Cloud Consulting',
  'areaServed': [
    { '@type': 'City', 'name': 'Augsburg' },
    { '@type': 'City', 'name': 'München' }
  ],
  'description': 'Ganzheitliche IT-Betreuung für Unternehmen: Von der Cloud-Migration bis zum täglichen Support. Fokus auf Sicherheit und Hochverfügbarkeit.',
  'offers': {
    '@type': 'Offer',
    'description': 'Monatliche Managed Service Pakete & On-Demand Support'
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'IT-Service',
  link: 'https://waldheim.dev/services/it-service'
}]);

const faqSchema = SchemaUtils.getFAQSchema([
  {
    question: 'Bieten Sie IT-Support vor Ort in Augsburg an?',
    answer: 'Mein Modell ist "Remote-First", was Ihnen schnellste Reaktionszeiten und geringere Kosten ermöglicht. Für physische Hardware-Einsätze vor Ort in Augsburg oder München arbeite ich mit erfahrenen Partnern zusammen.'
  },
  {
    question: 'Wie schnell helfen Sie bei IT-Problemen?',
    answer: 'In kritischen Fällen garantiere ich eine Remote-Reaktionszeit von unter 2 Stunden. Mein Ziel ist es, Ausfallzeiten für Ihr Unternehmen auf ein absolutes Minimum zu reduzieren.'
  },
  {
    question: 'Unterstützen Sie auch Microsoft 365 und Google Workspace?',
    answer: 'Ja, ich bin spezialisiert auf die Migration und Verwaltung moderner Cloud-Arbeitsplätze inkl. Security-Härtung und Compliance-Checks.'
  }
]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema, faqSchema]}
  image={ogImage}
>
  <main id="main-content">
    <!-- Hero Section: Fokus auf Zuverlässigkeit -->
    <ServiceHero 
      title="Managed IT-Service"
      subtitle="Sorgenfreie IT-Infrastruktur für"
      description="Ich übernehme die Verantwortung für Ihre IT, damit Sie sich auf Ihr Kerngeschäft konzentrieren können. Modern, sicher und dank Remote-First-Ansatz extrem schnell einsatzbereit."
      gradient="green"
      icon="fa-server"
      badge="IT-Support für KMU & Verbände"
    />

    <!-- Leistungen: Managed Services Fokus -->
    <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="it-services-heading">
      <div class="mx-auto max-w-7xl">
        <header class="mx-auto max-w-2xl text-center mb-16">
          <h2 id="it-services-heading" class="text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
            Ihre externe IT-Abteilung
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            Maximale <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent">Verfügbarkeit</span>
          </p>
          <p class="text-xl text-meg-text-secondary">
            Proaktive Wartung statt reaktiver Fehlerbehebung. Ich halte Ihre Systeme am Laufen.
          </p>
        </header>
        
        <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/40 transition-all group">
            <i class="fa-solid fa-cloud-arrow-up text-emerald-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Cloud Migration & Management</h3>
            <p class="text-meg-text-secondary text-sm">Sicherer Umzug Ihrer Daten und Anwendungen in die Cloud (M365, Google, AWS). Ortsunabhängiges Arbeiten für Ihr gesamtes Team.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/40 transition-all group">
            <i class="fa-solid fa-vault text-emerald-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">IT-Sicherheit & Backup</h3>
            <p class="text-meg-text-secondary text-sm">Implementierung von Multi-Faktor-Authentifizierung (MFA), Firewall-Management und automatisierten Offsite-Backups.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/40 transition-all group">
            <i class="fa-solid fa-microchip text-emerald-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">System-Administration</h3>
            <p class="text-meg-text-secondary text-sm">Zentrale Verwaltung Ihrer Windows-, macOS- und Linux-Flotte. Patch-Management und Software-Verteilung aus der Ferne.</p>
          </article>
          <article class="bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/40 transition-all group">
            <i class="fa-solid fa-headset text-emerald-400 text-3xl mb-6 group-hover:scale-110 transition-transform" aria-hidden="true"></i>
            <h3 class="text-xl font-bold mb-4">Priority Remote Support</h3>
            <p class="text-meg-text-secondary text-sm">Schnelle Hilfe per Fernwartung. Kurze Wege, keine Anfahrtskosten und garantierte Reaktionszeiten für Ihre Mitarbeiter.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Remote-First Vorteil -->
    <section class="py-24 px-6 border-y border-meg-border-dark bg-meg-surface-dark/10">
      <div class="mx-auto max-w-7xl">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl font-bold mb-6">Digitale Effizienz durch <span class="text-emerald-400">Remote-Service</span></h2>
            <p class="text-meg-text-secondary mb-8">
              Warum auf den Techniker warten, wenn das Problem in Minuten gelöst sein kann? Mein Remote-First-Ansatz ist der Standard für moderne Unternehmen.
            </p>
            <dl class="space-y-6">
              <div class="flex gap-4">
                <dt class="size-10 bg-emerald-500/10 rounded-lg flex items-center justify-center text-emerald-400 flex-shrink-0">
                  <i class="fa-solid fa-gauge-high"></i>
                </dt>
                <dd>
                  <strong class="text-meg-text-primary-dark block">Höchste Geschwindigkeit</strong>
                  <span class="text-meg-text-secondary text-sm">Sofortiger Start der Fehlerbehebung per gesicherter Fernwartung.</span>
                </dd>
              </div>
              <div class="flex gap-4">
                <dt class="size-10 bg-emerald-500/10 rounded-lg flex items-center justify-center text-emerald-400 flex-shrink-0">
                  <i class="fa-solid fa-euro-sign"></i>
                </dt>
                <dd>
                  <strong class="text-meg-text-primary-dark block">Keine Anfahrtskosten</strong>
                  <span class="text-meg-text-secondary text-sm">Transparente Abrechnung ohne versteckte Nebenkosten für Augsburg/München.</span>
                </dd>
              </div>
              <div class="flex gap-4">
                <dt class="size-10 bg-emerald-500/10 rounded-lg flex items-center justify-center text-emerald-400 flex-shrink-0">
                  <i class="fa-solid fa-network-wired"></i>
                </dt>
                <dd>
                  <strong class="text-meg-text-primary-dark block">Partner-Netzwerk</strong>
                  <span class="text-meg-text-secondary text-sm">Für Hardware-Rollouts und Vor-Ort-Verkabelung greife ich auf ein lokales Experten-Netzwerk zu.</span>
                </dd>
              </div>
            </dl>
          </div>
          <div class="relative group">
            <div class="absolute -inset-4 bg-emerald-500/10 rounded-3xl blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
            <video src="/videos/video_cloud-security.mp4" poster="/videos/video_cloud-security-poster.webp" loop muted playsinline autoplay class="relative rounded-2xl w-full border border-meg-border-dark shadow-2xl"></video>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 px-6" aria-labelledby="it-faq-heading">
      <div class="mx-auto max-w-4xl">
        <header class="text-center mb-12">
          <h2 id="it-faq-heading" class="text-3xl font-bold">Häufige Fragen zum <span class="text-emerald-400">IT-Support</span></h2>
        </header>
        <div class="space-y-6">
          {faqSchema.mainEntity.map((faq) => (
            <details class="group border border-meg-border-dark rounded-2xl p-6 bg-meg-surface-dark/50 cursor-pointer hover:border-emerald-500/30 transition-all">
              <summary class="flex justify-between items-center font-bold text-meg-text-primary-dark list-none">
                {faq.name}
                <span class="text-emerald-400 group-open:rotate-180 transition-transform">
                  <i class="fa-solid fa-chevron-down"></i>
                </span>
              </summary>
              <p class="mt-4 text-meg-text-secondary leading-relaxed border-t border-meg-border-dark pt-4 italic">
                {faq.acceptedAnswer.text}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PriceService />
    <Blog limits={2} />
    <RelatedServices />
    <Partner />
  </main>
</Layout>