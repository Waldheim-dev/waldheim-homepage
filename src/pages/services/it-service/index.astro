---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'IT-Service',
  link: 'https://waldheim.dev/services/it-service'
}]);

const titel = "IT-Service, Support & Netzwerktechnik | Augsburg | waldheim.dev";
const description = "Zuverlässiger IT-Service: Netzwerk, Computer, Server (Windows, macOS, Linux) & Cloud-Migrationen. Ihr Partner für IT-Support in Augsburg, München und Umgebung.";
const keywords = "IT-Service, IT-Support, IT-Wartung, IT-Beratung, IT-Administration, Netzwerktechnik, Windows, macOS, Linux, Server, Cloud-Migration, Augsburg, München, Bayern";

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'IT-Service & Support',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'IT Support',
  areaServed: ['Augsburg', 'München', 'Bayern', 'DE'],
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/it-service-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="IT-Service"
    subtitle="Zuverlässiger & professioneller"
    description="Von Netzwerk-Installation über Server-Wartung bis zur Cloud-Migration – ich kümmere mich um Ihre komplette IT-Infrastruktur. Windows, macOS, Linux – alles aus einer Hand."
    gradient="green"
    icon="fa-server"
    badge="Support für Ihre IT"
  />

  <!-- Main Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark' id='leistungen'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-headset mr-2' aria-hidden='true'></i>
          Support-Fokus
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
          Konzentrieren Sie sich auf Ihr <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Kerngeschäft</span>
        </p>
        <p class='gsap-fadein text-xl text-meg-text-secondary' style='animation-delay: 0.3s'>
          Professionelle IT-Administration spart Zeit und Nerven. Ich biete Ihnen flexible Lösungen – remote und effizient.
        </p>
      </div>
      
      <div class='grid md:grid-cols-2 gap-8 max-w-5xl mx-auto'>
        {[
          { title: 'Installation & Setup', desc: 'Beschaffung und Konfiguration Ihrer IT-Geräte – schnell und zuverlässig.', icon: 'fa-laptop' },
          { title: 'Cloud-Services', desc: 'Auswahl, Einrichtung und Verwaltung moderner Cloud-Dienste für Ihr Team.', icon: 'fa-cloud' },
          { title: 'IT-Sicherheit', desc: 'Maximaler Schutz durch regelmäßige Audits und bewährte Sicherheitsmaßnahmen.', icon: 'fa-shield' },
          { title: 'Wartung & Support', desc: 'Systeme auf dem neuesten Stand halten mit schnellem Priority-Support.', icon: 'fa-wrench' }
        ].map((feat, i) => (
          <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 hover:shadow-lg hover:shadow-emerald-500/5 transition-all duration-300 group' style={`animation-delay: ${0.45 + i * 0.15}s`}>
            <div class='w-14 h-14 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform'>
              <i class={`fa-solid ${feat.icon} text-emerald-400 text-2xl`}></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>{feat.title}</h3>
            <p class='text-meg-text-secondary leading-relaxed'>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Remote & Partner Info -->
  <section class="py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-4xl">
        <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-10 shadow-sm group hover:border-emerald-500/30 transition-all" style="animation-delay: 0s">
          <div class="flex flex-col md:flex-row items-start gap-8">
            <div class="size-16 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-handshake text-emerald-400 text-3xl"></i>
            </div>
            <div>
              <h2 class="text-2xl font-black tracking-tight text-meg-text-primary-dark mb-4">Remote-First mit Partner-Netzwerk</h2>
              <p class="text-meg-text-secondary mb-6 leading-relaxed">
                Ich arbeite ausschließlich <strong class="text-meg-text-primary-dark">remote</strong> und biete IT-Support für Unternehmen deutschlandweit. Für größere Projekte aktiviere ich ein <strong class="text-meg-text-primary-dark">zuverlässiges Partner-Netzwerk</strong> – volle Mannpower bei höchster Qualität.
              </p>
              <div class="flex flex-wrap gap-3">
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-meg-bg-dark/50 border border-meg-border-dark rounded-full text-xs font-bold text-meg-text-secondary uppercase tracking-widest">
                  <i class='fa-solid fa-house-laptop text-emerald-400' aria-hidden='true'></i>
                  100% Remote
                </span>
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-meg-bg-dark/50 border border-meg-border-dark rounded-full text-xs font-bold text-meg-text-secondary uppercase tracking-widest">
                  <i class='fa-solid fa-users text-emerald-400' aria-hidden='true'></i>
                  Partner-Scale
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-meg-bg-dark border-t border-meg-border-dark">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4" style="animation-delay: 0s">
          Support-Check
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Fragen & <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Antworten</span>
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {[
          { q: 'Vor-Ort-Support möglich?', a: 'Ich arbeite 100% remote. Für physische Einsätze vermittle ich gerne Partner aus meinem Netzwerk.' },
          { q: 'Reaktionszeit bei Ausfällen?', a: 'Remote Innerhalb von 4h (regulär) oder <2h mit Priority-Support.' },
          { q: 'Langfristige Bindung?', a: 'Nein, Wartungsverträge sind monatlich kündbar. Volle Flexibilität.' },
          { q: 'Betriebssysteme?', a: 'Windows, macOS und Linux. Auch in Hybrid-Umgebungen.' }
        ].map((faq, i) => (
          <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/20 transition-all shadow-sm group" style={`animation-delay: ${0.3 + i * 0.15}s`}>
            <h3 class="text-lg font-bold text-meg-text-primary-dark mb-4 flex items-start gap-3">
              <span class="text-emerald-400 font-black">Q</span> {faq.q}
            </h3>
            <p class="text-meg-text-secondary pl-7 leading-relaxed">
              <span class="text-meg-accent font-bold mr-2">A:</span> {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PriceService />

  <RelatedServices 
    services={[
      {
        title: "DevSecOps & Automatisierung",
        href: "/services/devsecops/",
        icon: "fa-solid fa-shield-check",
        description: "Automatisierte Deployments, Monitoring und Security – für maximale Verfügbarkeit Ihrer IT-Infrastruktur.",
        color: "purple"
      },
      {
        title: "Webentwicklung & Software",
        href: "/services/entwicklung/",
        icon: "fa-solid fa-code",
        description: "Individuelle Webanwendungen, Dashboards und Tools – perfekt integriert in Ihre IT-Landschaft.",
        color: "blue"
      },
      {
        title: "Smart Home Beratung",
        href: "/services/smarthome/",
        icon: "fa-solid fa-house-signal",
        description: "Unabhängige Smart Home Lösungen – auch für Ihr Home-Office oder kleine Büros.",
        color: "orange"
      }
    ]}
  />

  <Partner />

</Layout>
