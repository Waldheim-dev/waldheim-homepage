---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
},{
  name: 'Service',
  link: Astro.url.hostname
}, {
  name: 'IT-Service',
  link: Astro.url.href
}]);

const titel = "IT-Service, Support & Netzwerktechnik - waldheim.dev"
const description = "Zuverlässiger IT-Service: Netzwerk, Computer, Server (Windows, macOS, Linux) & Cloud-Migrationen. Ihr Partner für IT-Support in Augsburg, München und Umgebung."
const keywords = "IT-Service, IT-Support, IT-Wartung, IT-Beratung, IT-Administration, Netzwerktechnik, Windows, macOS, Linux, Server, Cloud-Migration, Augsburg, München"
---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>

  <div class='relative isolate px-6 pt-14 lg:px-8'>
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-linear-to-tr from-[#97bea0] to-[#6b9e78] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
    <div class='mx-auto max-w-2xl py-32 sm:py-48 lg:py-56'>
      <div class='text-center'>
        <h1 class='text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl'>Umfassender IT-Service – von der Hardware bis zur Cloud</h1>
        <p class='mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300'>Ich unterstütze Sie in allen Bereichen der IT: Von der Beschaffung und Installation von Geräten über die Wartung Ihrer Systeme bis hin zur sicheren Cloud-Verwaltung.</p>
        <div class='mt-10 flex items-center justify-center gap-x-6'>
          <a href="/kontakt"
             class='rounded-md bg-primary-600 bg-emerald-800 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-500 dark:hover:emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600'>Kostenlose Erstberatung</a>
        </div>
      </div>
    </div>
    <div
      class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]'
      aria-hidden='true'>
      <div
        class='relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-linear-to-tr from-[#97bea0] to-[#6b9e78] opacity-30 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
  </div>

  <div class='py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl lg:text-center'>
        <h2 class='text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600'>Professioneller IT-Service</h2>
        <p class='mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl'>
          Konzentrieren Sie sich auf Ihr Kerngeschäft – ich kümmere mich um Ihre IT!
        </p>
        <p class='mt-6 text-lg leading-8 text-gray-600 dark:text-gray-400'>
          Professionelle IT-Administration spart Zeit und Nerven. Ich biete Ihnen flexible Lösungen – von der einmaligen Unterstützung bis zur langfristigen Betreuung.
        </p>
      </div>
      <div class='mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-4xl'>
        <dl class='grid max-w-xl grid-cols-1 gap-x-8 gap-y-10 lg:max-w-none lg:grid-cols-2 lg:gap-y-16'>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-computer'></i>
              </div>
              Geräte-Installation &amp; Konfiguration
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>
              Ich beschaffe, installiere und konfiguriere Ihre IT-Geräte (PCs, Laptops, Server, etc.) – schnell, zuverlässig und nach Ihren individuellen Anforderungen.
            </dd>
          </div>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-cloud'></i>
              </div>
              Cloud-Services &amp; -Verwaltung
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>Ich unterstütze Sie bei der Auswahl, Einrichtung und Verwaltung Ihrer Cloud-Dienste (z.B. E-Mail, Datenspeicherung, Sicherheitslösungen).
            </dd>
          </div>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-lock'></i>
              </div>
              IT-Sicherheit
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>Ich sorge für die Sicherheit Ihrer IT-Systeme und Daten – durch regelmäßige Überprüfungen, Updates und die Implementierung bewährter Sicherheitsmaßnahmen.
            </dd>
          </div>
          <div class='relative pl-16'>
            <dt class='text-base font-semibold leading-7 text-gray-900 dark:text-gray-100'>
              <div class='absolute left-0 top-0 flex h-10 w-10 items-center justify-center rounded-lg bg-primary-600 dark:bg-emerald-800'>
                <i class='fa-regular text-white fa-rotate'></i>
              </div>
              Wartung, Updates &amp; Support
            </dt>
            <dd class='mt-2 text-base leading-7 text-gray-600 dark:text-gray-400'>Ich halte Ihre Systeme auf dem neuesten Stand, führe regelmäßige Wartungsarbeiten durch und stehe Ihnen bei Problemen schnell und kompetent zur Seite.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <PriceService />

  <Partner />

</Layout>
