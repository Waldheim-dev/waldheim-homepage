---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';
import ServiceHero from '../../../components/ServiceHero.astro';
import PriceService from '../../../components/PriceService.astro';
import Partner from '../../../components/Partner.astro';
import RelatedServices from '../../../components/RelatedServices.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Services',
  link: 'https://waldheim.dev/services'
}, {
  name: 'IT-Service',
  link: 'https://waldheim.dev/services/it-service'
}]);

const titel = "IT-Service, Support & Netzwerktechnik | Augsburg | waldheim.dev";
const description = "Zuverlässiger IT-Service: Netzwerk, Computer, Server (Windows, macOS, Linux) & Cloud-Migrationen. Ihr Partner für IT-Support in Augsburg, München und Umgebung.";
const keywords = "IT-Service, IT-Support, IT-Wartung, IT-Beratung, IT-Administration, Netzwerktechnik, Windows, macOS, Linux, Server, Cloud-Migration, Augsburg, München, Bayern";

// Structured Data: Service
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'IT-Service & Support',
  provider: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  serviceType: 'IT Support',
  areaServed: ['Augsburg', 'München', 'Bayern', 'DE'],
  description: description,
  offers: {
    '@type': 'Offer',
    price: '70',
    priceCurrency: 'EUR',
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: '70',
      priceCurrency: 'EUR',
      unitText: 'Stunde'
    }
  }
};

const ogImage = 'https://waldheim.dev/services/it-service-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[serviceSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <ServiceHero 
    title="IT-Service"
    subtitle="Zuverlässiger & professioneller"
    description="Von Netzwerk-Installation über Server-Wartung bis zur Cloud-Migration – ich kümmere mich um Ihre komplette IT-Infrastruktur. Windows, macOS, Linux – alles aus einer Hand."
    gradient="green"
    icon="fa-server"
    badge="Support für Ihre IT"
  />

  <!-- Main Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900' id='leistungen'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-base font-semibold text-green-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-headset text-green-400 mr-2' aria-hidden='true'></i>
          Professioneller IT-Service
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
          Konzentrieren Sie sich auf Ihr <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>Kerngeschäft</span>
        </p>
        <p class='gsap-fadein text-xl text-light-300' style='animation-delay: 0.3s'>
          Professionelle IT-Administration spart Zeit und Nerven. Ich biete Ihnen flexible Lösungen – von der einmaligen Unterstützung bis zur langfristigen Betreuung.
        </p>
      </div>
      
      <div class='grid md:grid-cols-2 gap-8 max-w-5xl mx-auto'>
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style='animation-delay: 0.45s'>
          <div class='w-14 h-14 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-laptop text-green-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Geräte-Installation & Konfiguration</h3>
          <p class='text-light-300'>
            Ich beschaffe, installiere und konfiguriere Ihre IT-Geräte (PCs, Laptops, Server, etc.) – schnell, zuverlässig und nach Ihren individuellen Anforderungen.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style='animation-delay: 0.6s'>
          <div class='w-14 h-14 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-cloud text-green-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Cloud-Services & -Verwaltung</h3>
          <p class='text-light-300'>
            Ich unterstütze Sie bei der Auswahl, Einrichtung und Verwaltung Ihrer Cloud-Dienste (z.B. E-Mail, Datenspeicherung, Sicherheitslösungen).
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style='animation-delay: 0.75s'>
          <div class='w-14 h-14 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-shield text-green-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>IT-Sicherheit</h3>
          <p class='text-light-300'>
            Ich sorge für die Sicherheit Ihrer IT-Systeme und Daten – durch regelmäßige Überprüfungen, Updates und die Implementierung bewährter Sicherheitsmaßnahmen.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style='animation-delay: 0.9s'>
          <div class='w-14 h-14 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-wrench text-green-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Wartung, Updates & Support</h3>
          <p class='text-light-300'>
            Ich halte Ihre Systeme auf dem neuesten Stand, führe regelmäßige Wartungsarbeiten durch und stehe Ihnen bei Problemen schnell und kompetent zur Seite.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Remote & Partner Info -->
  <section class="py-24 px-6 bg-dark-950">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-4xl">
        <div class="gsap-fadein bg-gradient-to-r from-green-500/10 via-emerald-500/10 to-green-500/10 border border-green-500/20 rounded-2xl p-10" style="animation-delay: 0s">
          <div class="flex items-start gap-6">
            <div class="w-16 h-16 bg-green-500/10 border border-green-500/30 rounded-2xl flex items-center justify-center flex-shrink-0">
              <i class="fa-solid fa-handshake text-green-400 text-3xl"></i>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-white mb-4">Remote-First mit Partner-Netzwerk</h2>
              <p class="text-light-300 mb-4">
                Ich arbeite ausschließlich <strong class="text-white">remote</strong> und biete IT-Support für Unternehmen deutschlandweit. Für größere Projekte oder spezialisierte Anforderungen arbeite ich mit einem <strong class="text-white">zuverlässigen Partner-Netzwerk</strong> zusammen – so erhalten Sie auch bei höherem Bedarf die volle Mannpower.
              </p>
              <div class="flex flex-wrap gap-3">
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 border border-green-500/30 rounded-full text-sm text-light-200">
                  <i class='fa-solid fa-house-laptop text-green-400' aria-hidden='true'></i>
                  <span>100% Remote</span>
                </span>
                <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-500/10 border border-green-500/30 rounded-full text-sm text-light-200">
                  <i class='fa-solid fa-users text-green-400' aria-hidden='true'></i>
                  <span>Partner für Zusatzkapazität</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6 bg-gradient-to-b from-dark-950 to-dark-900">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-2xl text-center mb-16">
        <h2 class="gsap-fadein text-base font-semibold text-green-400 mb-4" style="animation-delay: 0s">
          <i class='fa-solid fa-circle-question text-green-400 mr-2' aria-hidden='true'></i>
          Häufig gestellte Fragen
        </h2>
        <p class="gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6" style="animation-delay: 0.15s">
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>Fragen & Antworten</span> zum IT-Service
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-6">
        <div class="gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-xl p-8" style="animation-delay: 0.3s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-green-400 mr-3' aria-hidden='true'></i>
            Bieten Sie auch vor-Ort-Support an?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Nein, ich arbeite ausschließlich remote. Für vor-Ort-Einsätze vermittle ich gerne vertrauenswürdige Partner aus meinem Netzwerk.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-xl p-8" style="animation-delay: 0.45s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-green-400 mr-3' aria-hidden='true'></i>
            Wie schnell reagieren Sie bei Ausfällen?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Remote-Support innerhalb von 4 Stunden (während Geschäftszeiten). Für kritische Systeme biete ich auch Priority-Support mit &lt;2h Reaktionszeit an.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-xl p-8" style="animation-delay: 0.6s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-green-400 mr-3' aria-hidden='true'></i>
            Müssen wir langfristige Verträge abschließen?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Nein! Wartungsverträge sind monatsweise kündbar. Projektbasierte Arbeiten werden individuell abgerechnet.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-xl p-8" style="animation-delay: 0.75s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-green-400 mr-3' aria-hidden='true'></i>
            Welche Betriebssysteme unterstützen Sie?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Windows (10/11, Server 2016-2022), macOS (Ventura+), Linux (Ubuntu, Debian, CentOS). Hybrid-Umgebungen sind kein Problem.
          </p>
        </div>
        
        <div class="gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-xl p-8" style="animation-delay: 0.9s">
          <h3 class="text-xl font-bold text-white mb-4">
            <i class='fa-solid fa-q text-green-400 mr-3' aria-hidden='true'></i>
            Was passiert bei größeren Projekten (z.B. 50+ Geräte)?
          </h3>
          <p class="text-light-300 pl-10">
            <strong class="text-white">A:</strong> Für größere Projekte aktiviere ich mein Partner-Netzwerk. So erhalten Sie die nötige Mannpower, ohne die Qualität zu verlieren – alles remote koordiniert.
          </p>
        </div>
      </div>
    </div>
  </section>

  <PriceService />

  <RelatedServices 
    services={[
      {
        title: "DevSecOps & Automatisierung",
        href: "/services/devsecops/",
        icon: "fa-solid fa-shield-check",
        description: "Automatisierte Deployments, Monitoring und Security – für maximale Verfügbarkeit Ihrer IT-Infrastruktur.",
        color: "purple"
      },
      {
        title: "Webentwicklung & Software",
        href: "/services/entwicklung/",
        icon: "fa-solid fa-code",
        description: "Individuelle Webanwendungen, Dashboards und Tools – perfekt integriert in Ihre IT-Landschaft.",
        color: "blue"
      },
      {
        title: "Smart Home Beratung",
        href: "/services/smarthome/",
        icon: "fa-solid fa-house-signal",
        description: "Unabhängige Smart Home Lösungen – auch für Ihr Home-Office oder kleine Büros.",
        color: "orange"
      }
    ]}
  />

  <Partner />

</Layout>
