---
import Pricing from '../../../components/content/Pricing.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<style>
  .sm\:-top-80 {
    top: 0 !important;
  }
</style>
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="bg-white dark:bg-slate-800">
    <div class="relative isolate pt-14">
      <div
        class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
        aria-hidden="true"
      >
        <div
          class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#6b9e78] to-[#498059] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
          style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
        >
        </div>
      </div>
      <div class="py-24 sm:py-32 lg:pb-40">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-2xl text-center">
            <div class="mt-24 sm:mt-32 lg:mt-16">
              <span
                class="inline-flex items-center space-x-2 text-sm font-medium leading-6 text-gray-500 dark:text-gray-300"
              >
                <span>Aktuell in <span class="version">Preview</span></span>
              </span>
            </div>

            <h1
              class="text-4xl font-bold tracking-tight text-primary-800 dark:text-white sm:text-6xl"
            >
              Effizienz Ihrer Fahrzeuge auf einen Blick
            </h1>
            <p class="mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
              Mehr Übersicht über euren Fuhrpark mit Ecodrive. Einfach und
              schnell. Jetzt testen!
            </p>
            <div class="mt-10 flex items-center justify-center gap-x-6">
              <a
                href="https://www.eco-drive.app"
                target="_blank"
                class="rounded-md bg-primary-500 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wd"
                >Demo ansehen</a
              >
            </div>
          </div>

          <div class="relative isolate">
            <div
              class="blur absolute inset-0 rounded-nd transition-all -translate-x-0 translate-y-0 bg-gradient-to-br from-pink-500 via-cyan-500 to-violet-500 animate-rotate_gradient"
            >
            </div>

            <img
              src="/projects/waldheim-dev/ecodrive/ecodrive_dashboard_light.png"
              alt="App screenshot"
              loading="lazy"
              width="2432"
              height="1442"
              class="relative z-10 mt-16 rounded-md bg-white/5 shadow-2xl ring-1 ring-white/10 sm:mt-24"
            />
          </div>
        </div>
      </div>
      <div
        class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]"
        aria-hidden="true"
      >
        <div
          class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-[#6b9e78] to-[#498059] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]"
          style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
        >
        </div>
      </div>
    </div>
  </div>

  <div class="overflow-hidden bg-white dark:bg-slate-800 py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div
        class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2"
      >
        <div class="lg:pr-8 lg:pt-4">
          <div class="lg:max-w-lg">
            <h2
              class="text-base font-semibold leading-7 text-primary-600 dark:text-primary-400"
            >
              Fahrtenbuch digital
            </h2>
            <p
              class="mt-2 text-3xl font-bold tracking-tight text-primary-800 dark:text-white sm:text-4xl"
            >
              So einfach wars noch nie
            </p>
            <p class="mt-6 text-lg leading-8 text-gray-700 dark:text-gray-300">
              Für Firmen ist ein Fahrtenbuch wichtig. Aber auch privat möchte
              man vielleicht den Konsum seines Fahrzeugs überblicken.
            </p>
            <dl
              class="mt-10 max-w-xl space-y-8 text-base leading-7 text-gray-700 dark:text-gray-300 lg:max-w-none"
            >
              <div class="relative pl-9">
                <dt class="inline font-semibold text-primary-800 dark:text-white">
                  <i class="absolute left-1 top-1 fa-solid fa-car text-primary-500"
                  ></i>
                  Mehrere Fahrzeuge.
                </dt>
                <dd class="inline">
                  Mit der Pro-Version kannst du unbegrenzt viele Fahrzeuge
                  anlegen und verwalten. So behälst du den Überblick über deinen
                  Fuhrpark.
                </dd>
              </div>
              <div class="relative pl-9">
                <dt class="inline font-semibold text-primary-800 dark:text-white">
                  <i
                    class="absolute left-1 top-1 fa-solid fa-chart-line-up-down text-primary-500"
                  ></i>
                  Statistiken überblicken.
                </dt>
                <dd class="inline">
                  Vergleiche dich mit anderen Fahrern und sehe, wie du im
                  Vergleich abschneidest. Auch deinen Verbrauch kannst du mit
                  anderen vergleichen und so sehen, ob du zu viel verbrauchst.
                </dd>
              </div>
              <div class="relative pl-9">
                <dt class="inline font-semibold text-primary-800 dark:text-white">
                  <i
                    class="absolute left-1 top-1 fa-solid fa-lock-hashtag text-primary-500"
                  ></i>
                  DSGVO konform.
                </dt>
                <dd class="inline">
                  Made in Germany. Deine Daten werden auf deutschen Servern
                  gespeichert und unterliegen somit dem deutschen Datenschutz.
                </dd>
              </div>
            </dl>
          </div>
        </div>
        <img
          src="/projects/waldheim-dev/ecodrive/ecodrive_dashboard_dark.png"
          alt="Product screenshot"
          loading="lazy"
          class="w-[48rem] max-w-none rounded-xl shadow-xl ring-1 ring-white/10 sm:w-[57rem] md:-ml-4 lg:-ml-0"
          width="2432"
          height="1442"
        />
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-800 py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
      <h2 class="text-base/7 font-semibold text-primary-600">Steigere jetzt die effizienz</h2>
      <p class="mt-2 max-w-lg text-pretty text-4xl font-semibold tracking-tight text-gray-950 dark:text-white sm:text-5xl">Mit den tollen Funktionen von Ecodrive mehr Transparenz zu deinem Fahrzeug</p>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
        <div class="relative lg:col-span-3">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] max-lg:rounded-t-[calc(2rem+1px)] lg:rounded-tl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left" src="/projects/waldheim-dev/ecodrive/ecodrive_login.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-primary-400">Einfach</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Social Login</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Melde dich einfach mit deinem Social Media an oder erstelle einen Account. Dank dieser Mechanik kannst du weitere Benutzer je nach Modell einladen.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-3">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 lg:rounded-tr-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] lg:rounded-tr-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left lg:object-right" src="/projects/waldheim-dev/ecodrive/ecodrive_dashboard_light.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-primary-400">Übersicht</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Halte alles im Überblick</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Hier werden alle deine Infos für das Fahrzeug zusammen getragen und dargestellt. Nutze es um dir bewusst zu werden, was dein Fahrzeug dich kostet.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 lg:rounded-tr-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 lg:rounded-bl-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] lg:rounded-bl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left" src="/projects/waldheim-dev/ecodrive/ecodrive_settings.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-primary-400">i18n</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Nutzbar für eigentlich jeden!</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Dank Übersetzungsfunktion für jeden Benutzer nutzbar und zentral speicherbar.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 lg:rounded-bl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)]">
            <img class="h-80 object-cover" src="/projects/waldheim-dev/ecodrive/ecodrive_vehicles.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-primary-400">Multiple</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Speichere deinen gesamten Fuhrpark ab</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Vergleiche deine Fahrzeuge untereinander aber auch mit anderen Personen. Wo stehst du im internationalen Bereich?</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-700 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(theme(borderRadius.lg)+1px)] max-lg:rounded-b-[calc(2rem+1px)] lg:rounded-br-[calc(2rem+1px)]">
            <img class="h-80 object-cover" src="/projects/waldheim-dev/ecodrive/ecodrive_add_fuel.png" alt="">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-primary-400">Verbrauch</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Erfasse dein Nutzungsverhalten</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Ermittle deine Kosten, die dich, und deinen Konsum. Wo stehst du im Durchschnitt?</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow ring-1 ring-black/5 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
        </div>
      </div>
    </div>
  </div>


  <Pricing dontShowService="true"/>

