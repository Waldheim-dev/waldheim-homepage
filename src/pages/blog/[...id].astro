---
import { getCollection, render } from 'astro:content';
import { SchemaUtils } from '../../utils/schema';
import Layout from '../../layouts/Layout.astro';
import BlogLayout from '../../layouts/BlogLayout.astro';
export async function getStaticPaths() {
  const blogs = await getCollection('blog');
  // remove prefix _ on id
  return blogs.map((blog) => ({
   params: { id: blog.id.replace(/^_/, '') },
   props: blog
  }))
}

const blog = Astro.props;
const { Content, headings } = await render(blog)

const wordCount = blog.body ? blog.body.split(/\s+/).length : 0;
const readingTime = Math.ceil(wordCount / 200);

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
}, {
  name: 'Blog',
  link: Astro.url.hostname
},{
  name: blog.data.title,
  link: Astro.url.href
}]);
---
<Layout {...blog.data} schema={[breadCrumbSchema]}>
  <BlogLayout {...blog.data} headings={headings} readingTime={readingTime}>
    <Content />
  </BlogLayout>
</Layout>