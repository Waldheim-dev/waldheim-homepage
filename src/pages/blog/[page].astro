---
import Layout from '../../layouts/Layout.astro';
import Blog from '../../components/Blog.astro';
import { getCollection } from 'astro:content';
import { SchemaUtils } from '../../utils/schema';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths({ paginate }) {
  const blogs = (await getCollection('blog'))
    .sort((a, b) => new Date(b.data.pubDate) - new Date(a.data.pubDate));

  // Generate pages from our array of astronauts, with 2 to a page
  return paginate(blogs, { pageSize: 6 });
}
const { page } = Astro.props;
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.hostname
}, {
  name: 'Blog',
  link: Astro.url.href
}]);

const articleSchema = page.data.map((post) => SchemaUtils.getArticleSchema({
  title: post.data.title,
  image: post.data.heroImage,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  description: post.data.description,
  author: post.data.author,
  publisher: SITE_TITLE,
  url: Astro.url.href + post.id
}))

const titel = "IT-Blog - waldheim.dev: Aktuelles & Insights"
const description = "Unser IT-Blog: Aktuelle News, Fachartikel, Insights und Tipps zu DevSecOps, Webentwicklung, Smart Home, IT-Service und mehr. Bleiben Sie auf dem Laufenden!"
const keywords = "IT-Blog, Technologie-Blog, DevSecOps, Webentwicklung, Smart Home, IT-Service, Verbandssoftware, News, Insights"

---

<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema, ...articleSchema]}>
  <Blog blog={page.data}/>
  
  <div class="py-24 gsap-fadein">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <nav class="flex items-center justify-between border-t border-meg-border-dark px-4 py-6 sm:px-6 mt-4 bg-meg-surface-dark/30 backdrop-blur-md rounded-2xl shadow-sm"
      aria-label="Pagination">
<div class="hidden sm:block">
 <p class="text-sm text-meg-text-secondary">
   Zeige
   <span class="font-bold text-meg-text-primary-dark">{ page.start + 1}</span>
   bis
   <span class="font-bold text-meg-text-primary-dark">{ page.end + 1}</span>
   von
   <span class="font-bold text-meg-text-primary-dark">{page.total}</span>
   Ergebnissen
 </p>
</div>
<div class="flex flex-1 justify-between sm:justify-end gap-3">


 {page.url.first ? <a href={page.url.first}
                      class="relative hidden sm:inline-flex cursor-pointer items-center rounded-xl bg-meg-surface-dark border border-meg-border-dark px-4 py-2 text-sm font-bold text-meg-text-primary-dark hover:border-meg-accent/50 hover:bg-meg-accent/5 hover:text-meg-accent transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent shadow-sm">Erste</a> : null}
 {page.url.prev ? <a href={page.url.prev}
                     class="relative inline-flex cursor-pointer items-center rounded-xl bg-meg-surface-dark border border-meg-border-dark px-4 py-2 text-sm font-bold text-meg-text-primary-dark hover:border-meg-accent/50 hover:bg-meg-accent/5 hover:text-meg-accent transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent shadow-sm">
                     <i class="fa-solid fa-chevron-left mr-2 text-xs"></i>
                     Vorherige
                     </a> : null}
 {page.url.next ? <a href={page.url.next}
                     class="relative inline-flex cursor-pointer items-center rounded-xl bg-meg-surface-dark border border-meg-border-dark px-4 py-2 text-sm font-bold text-meg-text-primary-dark hover:border-meg-accent/50 hover:bg-meg-accent/5 hover:text-meg-accent transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent shadow-sm">
                     Nächste
                     <i class="fa-solid fa-chevron-right ml-2 text-xs"></i>
                     </a> : null}
 {page.url.last ? <a href={page.url.last}
                     class="relative hidden sm:inline-flex cursor-pointer items-center rounded-xl bg-meg-surface-dark border border-meg-border-dark px-4 py-2 text-sm font-bold text-meg-text-primary-dark hover:border-meg-accent/50 hover:bg-meg-accent/5 hover:text-meg-accent transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-meg-accent shadow-sm">Letzte</a> : null}
</div>
</nav></div></div>
</Layout>
