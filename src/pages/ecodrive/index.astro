---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import PriceEcodrive from '../../components/PriceEcodrive.astro';
import EcodriveRoadmap from '../../components/EcodriveRoadmap.astro';
import EcodriveFeatures from '../../components/EcodriveFeatures.astro';
import EcodriveScreenshots from '../../components/EcodriveScreenshots.astro';
import EcodriveComparison from '../../components/EcodriveComparison.astro';
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.host
},{
  name: 'Ecodrive',
  link: Astro.url.href
}]);
const titel = "Ecodrive: Nachhaltig & kosteneffizient fahren"
const description = "Ecodrive: Die Software für nachhaltiges und kostenbewusstes Fahren. Protokollierung, Analyse und Kostenübersicht für alle Fahrzeugtypen. Senken Sie Ihren CO2-Fußabdruck und sparen Sie Geld!"
const keywords = "Ecodrive, Nachhaltigkeit, Sprit sparen, Fahrertraining, CO2-Reduktion, Kostenübersicht, Fahrzeugdaten, Protokollierung, umweltfreundliches Fahren"

---
<Layout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <div class='relative isolate pt-14'>
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-linear-to-tr from-[#6b9e78] to-[#498059] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
    <div class='py-24 sm:py-32 lg:pb-40'>
      <div class='mx-auto max-w-7xl px-6 lg:px-8'>
        <div class='mx-auto max-w-2xl text-center'>
          <div class='mt-24 sm:mt-32 lg:mt-16'>
            <span
              class='inline-flex items-center space-x-2 text-sm font-medium leading-6 text-light-300  gsap-fadein '
            >
              <span>Aktuell in <span class='version'>v1.2.0</span></span>
            </span>
          </div>

          <h1
            class='text-4xl font-bold tracking-tight text-light-100  sm:text-6xl gsap-fadein '
          >
            Ecodrive: Fahrzeugkosten im <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>Griff</span>
          </h1>
          <p class='mt-6 text-lg leading-8 text-light-300 gsap-fadein '>
            Mehr Übersicht über Ihren Fuhrpark oder Ihr Privatfahrzeug – einfach, schnell und <strong class='text-white'>kostenlos</strong> mit Ecodrive. 
            Das digitale Fahrtenbuch <strong class='text-white'>made in Germany</strong> 🇩🇪
          </p>
          <div class='mt-10 flex items-center justify-center gap-x-6 gsap-fadein' style='animation-delay: 0.15s'>
            <a
              href='https://www.eco-drive.app'
              target='_blank'
              rel="noopener noreferrer"
              class='inline-flex items-center gap-2 rounded-md bg-gradient-to-r from-green-400 to-emerald-500 px-6 py-3 text-lg font-bold text-dark-950 shadow-lg hover:shadow-green-400/50 transition-all duration-300 hover:scale-105'
            >
              <i class='fa-solid fa-rocket' aria-hidden='true'></i>
              Jetzt kostenlos starten
            </a>
            <a
              href='/ecodrive/#features'
              class='inline-flex items-center gap-2 text-lg font-semibold text-white hover:text-green-400 transition-colors'
            >
              Features entdecken
              <i class='fa-solid fa-arrow-down animate-bounce' aria-hidden='true'></i>
            </a>
          </div>
        </div>

        <div class='relative isolate'>
          <div
            class='blur-sm absolute inset-0 rounded-1xl transition-all -translate-x-0 translate-y-0 bg-conic-180 from-pink-500 via-cyan-500 to-violet-500 animate-rotate_gradient' />

          <img
            src='/ecodrive/ecodrive_dashboard.PNG'
            alt="Ecodrive Dashboard"
            loading="lazy"
            width="2432"
            height="1442"
            class='relative z-10 mt-16 rounded-md bg-pancho-200/5 shadow-2xl ring-1 ring-white/10 sm:mt-24'
          />
        </div>
      </div>
    </div>
    <div
      class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]'
      aria-hidden='true'>
      <div
        class='relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-linear-to-tr from-[#6b9e78] to-[#498059] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'>
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900' id='features'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-base font-semibold text-green-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-rocket text-green-400 mr-2' aria-hidden='true'></i>
          Digitales Fahrtenbuch & mehr
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
          Einfacher <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>geht's nicht!</span>
        </p>
        <p class='gsap-fadein text-xl text-light-300 max-w-3xl mx-auto' style='animation-delay: 0.3s'>
          Ecodrive ist die ideale Lösung für Firmen und Privatpersonen, die den Überblick über Fahrzeugkosten und Fahrdaten behalten möchten. Die integrierte Fahrtenbuchfunktion (verfügbar im Upgrade) erfüllt alle gesetzlichen Anforderungen.
        </p>
      </div>
      
      <div class='grid md:grid-cols-3 gap-8 max-w-6xl mx-auto'>
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style='animation-delay: 0.45s'>
          <div class='w-14 h-14 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-cars text-green-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Mehrere Fahrzeuge verwalten</h3>
          <p class='text-light-300'>
            Mit der Pro-Version können Sie eine unbegrenzte Anzahl von Fahrzeugen anlegen und verwalten – ideal für Fuhrparks jeder Größe.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style='animation-delay: 0.6s'>
          <div class='w-14 h-14 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-chart-line text-green-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>Detaillierte Statistiken</h3>
          <p class='text-light-300'>
            Vergleichen Sie Ihren Verbrauch und Ihre Kosten mit denen anderer Fahrer. Erkennen Sie Einsparpotenziale und optimieren Sie Ihren Fahrstil.
          </p>
        </div>
        
        <div class='gsap-fadein bg-dark-900/50 border border-green-500/20 rounded-2xl p-8 hover:border-green-500/40 transition-all duration-300' style='animation-delay: 0.75s'>
          <div class='w-14 h-14 bg-green-500/10 border border-green-500/30 rounded-xl flex items-center justify-center mb-6'>
            <i class='fa-solid fa-shield-check text-green-400 text-2xl'></i>
          </div>
          <h3 class='text-xl font-bold text-white mb-4'>DSGVO-konform & Made in Germany</h3>
          <p class='text-light-300'>
            Ihre Daten werden auf deutschen Servern gespeichert und unterliegen den strengen deutschen Datenschutzbestimmungen.
          </p>
        </div>
      </div>
    </div>
  </section>


  <EcodriveFeatures />

  <EcodriveScreenshots />

  <EcodriveComparison />

  <PriceEcodrive />

  <EcodriveRoadmap />
</Layout>
