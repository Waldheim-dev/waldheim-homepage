---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';
import PriceEcodrive from '../../components/PriceEcodrive.astro';
import EcodriveRoadmap from '../../components/EcodriveRoadmap.astro';
import EcodriveFeatures from '../../components/EcodriveFeatures.astro';
import EcodriveScreenshots from '../../components/EcodriveScreenshots.astro';
import EcodriveComparison from '../../components/EcodriveComparison.astro';

const product = getProductInfo('ecodrive')!;

// SEO & Meta
const titel = 'Ecodrive | Intelligentes Fuhrparkmanagement & Fahrtenbuch';
const description = 'Optimieren Sie Ihren Fuhrpark mit Ecodrive. DSGVO-konformes digitales Fahrtenbuch, Kostenanalyse & CO2-Tracking. Jetzt kostenlos für Ihr Unternehmen testen!';
const keywords = 'Fuhrparkmanagement Software, digitales Fahrtenbuch Deutschland, Fuhrpark Kosten senken, CO2 Tracking Fahrzeug, Ecodrive App, Flottenmanagement KMU';
const ogImage = 'https://waldheim.dev/ecodrive/og-image.jpg';

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Ecodrive',
  'applicationCategory': 'BusinessApplication',
  'operatingSystem': 'Web, iOS, Android',
  'offers': {
    '@type': 'Offer',
    'price': '0',
    'priceCurrency': 'EUR',
    'availability': 'https://schema.org/OnlineOnly'
  },
  'softwareVersion': product.version,
  'description': 'Intelligente Software für nachhaltiges Fuhrparkmanagement und rechtssichere Fahrtenbuchführung.',
  'author': {
    '@type': 'Organization',
    'name': 'Waldheim.dev',
    'url': 'https://waldheim.dev'
  }
};

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Ecodrive',
  link: 'https://waldheim.dev/ecodrive'
}]);
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <main id="main-content">
    <!-- Hero: Fokus auf Effizienz & Nachhaltigkeit -->
    <section class='relative isolate pt-14 bg-meg-bg-dark overflow-hidden'>
      <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
        <div
          class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-emerald-500/20 to-sky-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
          style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
      </div>

      <div class='py-24 sm:py-32 lg:pb-40'>
        <div class='mx-auto max-w-7xl px-6 lg:px-8'>
          <div class='mx-auto max-w-3xl text-center'>
            <!-- Status & Compliance Badges -->
            <div class='mt-24 sm:mt-32 lg:mt-16 flex flex-wrap justify-center gap-3'>
              <span class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-sm font-bold text-emerald-400 shadow-sm'>
                <i class="fa-solid fa-code-branch"></i>
                v{product.version} Alpha
              </span>
              <span class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-sm font-bold text-meg-text-secondary uppercase tracking-widest'>
                <i class="fa-solid fa-leaf text-emerald-400"></i>
                Eco-Friendly Tech
              </span>
            </div>

            <h1 class='text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mt-8'>
              Fuhrpark-Management<br />
              <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>neu gedacht</span>
            </h1>

            <p class='mt-6 text-xl leading-8 text-meg-text-secondary max-w-2xl mx-auto'>
              Reduzieren Sie Kosten und CO2-Emissionen durch datengestützte Analyse. Das rechtssichere Fahrtenbuch für moderne Flotten – <strong class='text-meg-text-primary-dark'>100% Made in Germany</strong>.
            </p>

            <div class='mt-10 flex flex-col sm:flex-row items-center justify-center gap-4'>
              <a
                href='https://www.eco-drive.app'
                target='_blank'
                rel="noopener noreferrer"
                class='w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-meg-accent px-8 py-4 text-lg font-bold text-white shadow-xl shadow-meg-accent/20 hover:scale-[1.02] transition-all'
              >
                <i class='fa-solid fa-rocket'></i>
                Jetzt kostenlos starten
              </a>
              <a
                href='#features'
                class='w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark px-8 py-4 text-lg font-bold text-meg-text-primary-dark hover:border-meg-accent/50 transition-all'
              >
                Features entdecken
              </a>
            </div>
          </div>

          <div class='relative mt-16 sm:mt-24 group'>
            <div class='absolute -inset-1 bg-gradient-to-r from-emerald-500/20 to-sky-500/20 rounded-2xl blur-2xl opacity-20'></div>
            <img
              src='/ecodrive/ecodrive_dashboard.PNG'
              alt="Ecodrive Dashboard - Fuhrparkverwaltung Übersicht"
              loading="eager"
              width="2432"
              height="1442"
              class='relative z-10 rounded-3xl bg-meg-surface-dark shadow-2xl ring-1 ring-meg-border-dark w-full'
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Key Benefits: Warum Ecodrive? -->
    <section class='py-24 px-6 bg-meg-bg-dark border-y border-meg-border-dark' id='features' aria-labelledby="ecodrive-benefits-heading">
      <div class='mx-auto max-w-7xl'>
        <header class='mx-auto max-w-2xl text-center mb-16'>
          <h2 id="ecodrive-benefits-heading" class='text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4'>
            Ihr Business-Vorteil
          </h2>
          <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
            Effizienz auf <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>vier Rädern</span>
          </p>
        </header>
        
        <div class='grid md:grid-cols-3 gap-8'>
          <article class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 transition-all group'>
            <i class='fa-solid fa-file-invoice-dollar text-emerald-400 text-3xl mb-6' aria-hidden='true'></i>
            <h3 class='text-xl font-bold mb-4'>Kosten-Transparenz</h3>
            <p class='text-meg-text-secondary text-sm'>Vollständige Kontrolle über Treibstoffkosten, Wartung und Reparaturen für jedes Fahrzeug Ihrer Flotte.</p>
          </article>
          <article class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 transition-all group'>
            <i class='fa-solid fa-gavel text-emerald-400 text-3xl mb-6' aria-hidden='true'></i>
            <h3 class='text-xl font-bold mb-4'>Rechtssicheres Fahrtenbuch</h3>
            <p class='text-meg-text-secondary text-sm'>Erfüllen Sie alle Anforderungen des Finanzamts durch automatisierte Protokollierung und Export-Funktionen.</p>
          </article>
          <article class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 transition-all group'>
            <i class='fa-solid fa-chart-area text-emerald-400 text-3xl mb-6' aria-hidden='true'></i>
            <h3 class='text-xl font-bold mb-4'>Smart-Analytics</h3>
            <p class='text-meg-text-secondary text-sm'>KI-gestützte Einsparpotenziale identifizieren und den ökologischen Fußabdruck Ihres Unternehmens reduzieren.</p>
          </article>
        </div>
      </div>
    </section>

    <EcodriveFeatures />
    <EcodriveScreenshots />
    <EcodriveComparison />
    <PriceEcodrive />
    <EcodriveRoadmap />
  </main>
</Layout>