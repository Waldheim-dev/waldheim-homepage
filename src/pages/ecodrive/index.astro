---
import Pricing from '../../components/content/Pricing.astro';
import Roadmap from '../../components/content/Roadmap.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SchemaUtils } from '../../utils/schema';
const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: Astro.url.host
},{
  name: 'Ecodrive',
  link: Astro.url.href
}]);

const titel = "Ecodrive: Nachhaltig & kosteneffizient fahren"
const description = "Ecodrive: Die Software für nachhaltiges und kostenbewusstes Fahren. Protokollierung, Analyse und Kostenübersicht für alle Fahrzeugtypen. Senken Sie Ihren CO2-Fußabdruck und sparen Sie Geld!"
const keywords = "Ecodrive, Nachhaltigkeit, Sprit sparen, Fahrertraining, CO2-Reduktion, Kostenübersicht, Fahrzeugdaten, Protokollierung, umweltfreundliches Fahren"
---

<style>
  .sm\:-top-80 {
    top: 0 !important;
  }
</style>
<BaseLayout title={titel} description={description} keywords={keywords} schema={[breadCrumbSchema]}>
  <div class='relative isolate pt-14'>
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-linear-to-tr from-[#6b9e78] to-[#498059] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
    <div class='py-24 sm:py-32 lg:pb-40'>
      <div class='mx-auto max-w-7xl px-6 lg:px-8'>
        <div class='mx-auto max-w-2xl text-center'>
          <div class='mt-24 sm:mt-32 lg:mt-16'>
            <span
              class='inline-flex items-center space-x-2 text-sm font-medium leading-6 text-gray-500 dark:text-gray-300'
            >
              <span>Aktuell in <span class='version'>v1.0.0</span></span>
            </span>
          </div>

          <h1
            class='text-4xl font-bold tracking-tight text-primary-800 dark:text-white sm:text-6xl'
          >
            Ecodrive: Behalten Sie Ihre Fahrzeugkosten im Griff!
          </h1>
          <p class='mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300'>
            Mehr Übersicht über Ihren Fuhrpark oder Ihr Privatfahrzeug – einfach, schnell und kostenlos mit Ecodrive.
          </p>
          <div class='mt-10 flex items-center justify-center gap-x-6'>
            <a
              href='https://www.eco-drive.app'
              target='_blank'
              rel="noopener noreferrer"
              class='rounded-md bg-primary-500 dark:bg-emerald-800 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-primary-400 dark:hover:bg-emerald-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wd'
            >Ecodrive kostenlos nutzen</a
            >
          </div>
        </div>

        <div class='relative isolate'>
          <div
            class='blur-sm absolute inset-0 rounded-1xl transition-all -translate-x-0 translate-y-0 bg-conic-180 from-pink-500 via-cyan-500 to-violet-500 animate-rotate_gradient' />

          <img
            src='/referenzen/waldheim-dev/ecodrive/ecodrive_dashboard_light.png'
            alt="Ecodrive Dashboard"
            loading="lazy"
            width="2432"
            height="1442"
            class='relative z-10 mt-16 rounded-md bg-white/5 shadow-2xl ring-1 ring-white/10 sm:mt-24'
          />
        </div>
      </div>
    </div>
    <div
      class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]'
      aria-hidden='true'>
      <div
        class='relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-linear-to-tr from-[#6b9e78] to-[#498059] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'>
      </div>
    </div>
  </div>

  <div class="overflow-hidden py-24 sm:py-32">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div
        class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2"
      >
        <div class="lg:pr-8 lg:pt-4">
          <div class="lg:max-w-lg">
            <h2
              class="text-base font-semibold leading-7 text-primary-600 dark:text-emerald-600"
            >
              Digitales Fahrtenbuch & mehr
            </h2>
            <p
              class="mt-2 text-3xl font-bold tracking-tight text-primary-800 dark:text-white sm:text-4xl"
            >
              Einfacher geht's nicht!
            </p>
            <p class="mt-6 text-lg leading-8 text-gray-700 dark:text-gray-300">
              Ecodrive ist die ideale Lösung für Firmen und Privatpersonen, die den Überblick über Fahrzeugkosten und Fahrdaten behalten möchten.  Die integrierte Fahrtenbuchfunktion (verfügbar im Upgrade) erfüllt alle gesetzlichen Anforderungen.
            </p>
            <dl
              class="mt-10 max-w-xl space-y-8 text-base leading-7 text-gray-700 dark:text-gray-300 lg:max-w-none"
            >
              <div class="relative pl-9">
                <dt class="inline font-semibold text-primary-800 dark:text-white">
                  <i class="absolute left-1 top-1 fa-solid fa-car text-primary-500"
                  ></i>
                  Mehrere Fahrzeuge verwalten
                </dt>
                <dd class="inline">
                  Mit der Pro-Version können Sie eine unbegrenzte Anzahl von Fahrzeugen anlegen und verwalten – ideal für Fuhrparks jeder Größe.
                </dd>
              </div>
              <div class="relative pl-9">
                <dt class="inline font-semibold text-primary-800 dark:text-white">
                  <i
                    class="absolute left-1 top-1 fa-solid fa-chart-line-up-down text-primary-500"
                  ></i>
                  Detaillierte Statistiken
                </dt>
                <dd class="inline">
                  Vergleichen Sie Ihren Verbrauch und Ihre Kosten mit denen anderer Fahrer.  Erkennen Sie Einsparpotenziale und optimieren Sie Ihren Fahrstil.
                </dd>
              </div>
              <div class="relative pl-9">
                <dt class="inline font-semibold text-primary-800 dark:text-white">
                  <i
                    class="absolute left-1 top-1 fa-solid fa-lock-hashtag text-primary-500"
                  ></i>
                  DSGVO-konform & Made in Germany
                </dt>
                <dd class="inline">
                  Ihre Daten werden auf deutschen Servern gespeichert und unterliegen den strengen deutschen Datenschutzbestimmungen.
                </dd>
              </div>
            </dl>
          </div>
        </div>
        <img
          src="/referenzen/waldheim-dev/ecodrive/ecodrive_dashboard_dark.png"
          alt="Ecodrive Dashboard Darkmode"
          loading="lazy"
          class="w-[48rem] max-w-none rounded-xl shadow-xl ring-1 ring-white/10 sm:w-[57rem] md:-ml-4 lg:-ml-0"
          width="2432"
          height="1442"
        />
      </div>
    </div>
  </div>

  <div class="py-24 sm:py-32">
    <div class="mx-auto max-w-2xl px-6 lg:max-w-7xl lg:px-8">
      <h2 class="text-base/7 font-semibold text-primary-600 dark:text-emerald-600">Steigern Sie jetzt Ihre Effizienz</h2>
      <p class="mt-2 max-w-lg text-pretty text-4xl font-semibold tracking-tight text-gray-950 dark:text-white sm:text-5xl">Entdecken Sie die vielfältigen Funktionen von Ecodrive – für mehr Transparenz und Kontrolle!</p>
      <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-16 lg:grid-cols-6 lg:grid-rows-2">
        <div class="relative lg:col-span-3">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-t-[calc(2rem+1px)] lg:rounded-tl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left" src="/referenzen/waldheim-dev/ecodrive/ecodrive_login.png" alt="Ecodrive Login">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Einfach</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Social Login</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Melden Sie sich bequem mit Ihrem Social-Media-Konto an oder erstellen Sie einen neuen Account.  Laden Sie weitere Benutzer ein (modellabhängig).</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 max-lg:rounded-t-[2rem] lg:rounded-tl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-3">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 lg:rounded-tr-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] lg:rounded-tr-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left lg:object-right" src="/referenzen/waldheim-dev/ecodrive/ecodrive_dashboard_light.png" alt="Ecodrive Dashboard (Hellmodus)">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Übersichtlich</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Alle Daten auf einen Blick</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Im Dashboard werden alle wichtigen Informationen zu Ihrem Fahrzeug übersichtlich zusammengefasst. Behalten Sie den Überblick über Kosten und Verbrauch.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 lg:rounded-tr-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 lg:rounded-bl-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] lg:rounded-bl-[calc(2rem+1px)]">
            <img class="h-80 object-cover object-left" src="/referenzen/waldheim-dev/ecodrive/ecodrive_settings.png" alt="Ecodrive Einstellungen">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Mehrsprachig</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Für jeden nutzbar</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Dank der integrierten Übersetzungsfunktion ist Ecodrive für Benutzer weltweit zugänglich.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 lg:rounded-bl-[2rem]"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)]">
            <img class="h-80 object-cover" src="/referenzen/waldheim-dev/ecodrive/ecodrive_vehicles.png" alt="Ecodrive Fahrzeugverwaltung">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Flexibel</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Verwalten Sie Ihren Fuhrpark</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Vergleichen Sie Ihre Fahrzeuge untereinander und mit anderen Nutzern. Finden Sie heraus, wo Sie im internationalen Vergleich stehen.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5"></div>
        </div>
        <div class="relative lg:col-span-2">
          <div class="absolute inset-px rounded-lg bg-white dark:bg-slate-900 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
          <div class="relative flex h-full flex-col overflow-hidden rounded-[calc(var(--radius-lg)+1px)] max-lg:rounded-b-[calc(2rem+1px)] lg:rounded-br-[calc(2rem+1px)]">
            <img class="h-80 object-cover" src="/referenzen/waldheim-dev/ecodrive/ecodrive_add_fuel.png" alt="Ecodrive Kraftstofferfassung">
            <div class="p-10 pt-4">
              <h3 class="text-sm/4 font-semibold text-primary-600 dark:text-emerald-600">Verbrauchsdaten</h3>
              <p class="mt-2 text-lg font-medium tracking-tight text-gray-950 dark:text-white">Erfassen Sie Ihr Nutzungsverhalten</p>
              <p class="mt-2 max-w-lg text-sm/6 text-gray-600 dark:text-slate-400">Ermitteln Sie Ihre Kosten und analysieren Sie Ihren Kraftstoffverbrauch. Finden Sie heraus, wo Sie im Vergleich zum Durchschnitt stehen.</p>
            </div>
          </div>
          <div class="pointer-events-none absolute inset-px rounded-lg shadow-sm ring-1 ring-black/5 max-lg:rounded-b-[2rem] lg:rounded-br-[2rem]"></div>
        </div>
      </div>
    </div>
  </div>


  <Pricing dontShowService="true"/>

  <Roadmap />

  <!--<div class='bg-slate-800'>-->
  <!--  <div class='mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8'>-->
  <!--    <h2 class='text-2xl font-bold leading-10 tracking-tight text-white'>Frequently asked questions</h2>-->
  <!--    <p class='mt-6 max-w-2xl text-base leading-7 text-gray-300'>Have a different question and can’t find the answer-->
  <!--      you’re looking for? Reach out to our support team by <a href='#'-->
  <!--                                                              class='font-semibold text-primary-400 hover:text-wd'>sending-->
  <!--        us an email</a> and we’ll get back to you as soon as we can.</p>-->
  <!--    <div class='mt-20'>-->
  <!--      <dl class='space-y-16 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-16 sm:space-y-0 lg:grid-cols-3 lg:gap-x-10'>-->
  <!--        <div>-->
  <!--          <dt class='text-base font-semibold leading-7 text-white'>What&#039;s the best thing ueber-mich Switzerland?</dt>-->
  <!--          <dd class='mt-2 text-base leading-7 text-gray-300'>I don&#039;t know, but the flag is a big plus. Lorem-->
  <!--            ipsum dolor sit amet consectetur adipisicing elit. Quas cupiditate laboriosam fugiat.-->
  <!--          </dd>-->
  <!--        </div>-->

  <!--        &lt;!&ndash; More questions... &ndash;&gt;-->
  <!--      </dl>-->
  <!--    </div>-->
  <!--  </div>-->
  <!--</div>-->
</BaseLayout>
