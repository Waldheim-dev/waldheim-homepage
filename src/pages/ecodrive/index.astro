---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';
import PriceEcodrive from '../../components/PriceEcodrive.astro';
import EcodriveRoadmap from '../../components/EcodriveRoadmap.astro';
import EcodriveFeatures from '../../components/EcodriveFeatures.astro';
import EcodriveScreenshots from '../../components/EcodriveScreenshots.astro';
import EcodriveComparison from '../../components/EcodriveComparison.astro';

const product = getProductInfo('ecodrive')!;

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Ecodrive',
  link: 'https://waldheim.dev/ecodrive'
}]);

const titel = "Ecodrive: Nachhaltig & kosteneffizient fahren | waldheim.dev";
const description = "Ecodrive: Die Software für nachhaltiges und kostenbewusstes Fahren. Protokollierung, Analyse und Kostenübersicht für alle Fahrzeugtypen. Senken Sie Ihren CO2-Fußabdruck und sparen Sie Geld!";
const keywords = "Ecodrive, Nachhaltigkeit, Sprit sparen, Fahrertraining, CO2-Reduktion, Kostenübersicht, Fahrzeugdaten, Protokollierung, umweltfreundliches Fahren, Fahrtenbuch";

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Web, iOS, Android',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/PreOrder'
  },
  softwareVersion: product.version,
  releaseNotes: 'Closed Alpha Version - Registrierung erforderlich',
  description: description,
  url: 'https://waldheim.dev/ecodrive',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  screenshot: 'https://waldheim.dev/ecodrive/screenshot.png'
};

const ogImage = 'https://waldheim.dev/ecodrive/og-image.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <div class='relative isolate pt-14 bg-meg-bg-dark'>
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-emerald-500/20 to-sky-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
    <div class='py-24 sm:py-32 lg:pb-40'>
      <div class='mx-auto max-w-7xl px-6 lg:px-8'>
        <div class='mx-auto max-w-3xl text-center'>
          <div class='mt-24 sm:mt-32 lg:mt-16 gsap-fadein'>
            <span
              class='inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-sm font-bold text-emerald-400 shadow-sm'
            >
              <i class="fa-solid fa-code-branch"></i>
              <span>v{product.version} <span class="opacity-50 font-medium ml-1">Alpha</span></span>
            </span>
          </div>

          <h1
            class='text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mt-8 gsap-fadein '
          >
            Ecodrive: Fuhrpark im <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Griff</span>
          </h1>
          <p class='mt-6 text-lg leading-8 text-meg-text-secondary gsap-fadein max-w-2xl mx-auto'>
            Mehr Übersicht über Ihre Fahrzeuge – einfach, schnell und <strong class='text-meg-text-primary-dark'>kostenlos</strong>. 
            Das digitale Fahrtenbuch <strong class='text-meg-text-primary-dark'>made in Germany</strong> 🇩🇪
          </p>
          <div class='mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 gsap-fadein' style='animation-delay: 0.15s'>
            <a
              href='https://www.eco-drive.app'
              target='_blank'
              rel="noopener noreferrer"
              class='w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-meg-accent px-8 py-4 text-lg font-bold text-white shadow-xl shadow-meg-accent/20 hover:shadow-meg-accent/40 transition-all duration-300 hover:scale-[1.02]'
            >
              <i class='fa-solid fa-rocket' aria-hidden='true'></i>
              Kostenlos starten
            </a>
            <a
              href='/ecodrive/#features'
              class='w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-xl bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark px-8 py-4 text-lg font-bold text-meg-text-primary-dark hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all'
            >
              Features entdecken
              <i class='fa-solid fa-arrow-down animate-bounce' aria-hidden='true'></i>
            </a>
          </div>
        </div>

        <div class='relative isolate mt-16 sm:mt-24 group'>
          <div
            class='absolute -inset-1 bg-gradient-to-r from-emerald-500/20 to-sky-500/20 rounded-2xl blur-2xl opacity-20 group-hover:opacity-40 transition duration-1000' />

          <img
            src='/ecodrive/ecodrive_dashboard.PNG'
            alt="Ecodrive Dashboard Preview"
            loading="eager"
            width="2432"
            height="1442"
            class='relative z-10 rounded-2xl bg-meg-surface-dark shadow-2xl ring-1 ring-meg-border-dark transition-transform duration-700 group-hover:scale-[1.01]'
          />
        </div>
      </div>
    </div>
    <div
      class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]'
      aria-hidden='true'>
      <div
        class='relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-linear-to-tr from-[#6b9e78] to-[#498059] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'>
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark' id='features'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4' style='animation-delay: 0s'>
          <i class='fa-solid fa-rocket mr-2' aria-hidden='true'></i>
          Fuhrpark-Management
        </h2>
        <p class='gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6' style='animation-delay: 0.15s'>
          Einfacher <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>geht's nicht!</span>
        </p>
        <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto' style='animation-delay: 0.3s'>
          Ecodrive ist die ideale Lösung für Firmen und Privatpersonen. Das integrierte Fahrtenbuch erfüllt alle gesetzlichen Anforderungen.
        </p>
      </div>
      
      <div class='grid md:grid-cols-3 gap-8 max-w-6xl mx-auto'>
        {[
          { title: 'Fuhrpark-Verwaltung', desc: 'Unbegrenzte Anzahl von Fahrzeugen anlegen und verwalten – ideal für jede Flotte.', icon: 'fa-cars' },
          { title: 'Smart-Analytics', desc: 'Vergleichen Sie Verbrauch und Kosten. Erkennen Sie Einsparpotenziale sofort.', icon: 'fa-chart-line' },
          { title: 'Privacy First', desc: 'DSGVO-konform auf deutschen Servern. Ihre Daten gehören nur Ihnen.', icon: 'fa-shield-check' }
        ].map((feat, i) => (
          <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-emerald-500/30 hover:shadow-lg hover:shadow-emerald-500/5 transition-all duration-300 group' style={`animation-delay: ${0.45 + i * 0.15}s`}>
            <div class='w-14 h-14 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform'>
              <i class={`fa-solid ${feat.icon} text-emerald-400 text-2xl`}></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-4'>{feat.title}</h3>
            <p class='text-meg-text-secondary leading-relaxed text-sm'>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <EcodriveFeatures />

  <EcodriveScreenshots />

  <EcodriveComparison />

  <PriceEcodrive />

  <EcodriveRoadmap />
</Layout>
