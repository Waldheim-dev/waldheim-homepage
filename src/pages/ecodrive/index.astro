---
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import BaseHead from '../../components/BaseHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<style>
    .sm\:-top-80 {
        top: 0 !important;
    }
</style>
<BaseLayout>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <div class='bg-white dark:bg-slate-800'>

    <div class='relative isolate pt-14'>
      <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80'
           aria-hidden='true'>
        <div
          class='relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
          style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
      </div>
      <div class='py-24 sm:py-32 lg:pb-40'>
        <div class='mx-auto max-w-7xl px-6 lg:px-8'>

          <div class='mx-auto max-w-2xl text-center'>
            <div class='mt-24 sm:mt-32 lg:mt-16'>
                <span class='inline-flex items-center space-x-2 text-sm font-medium leading-6 text-gray-500 dark:text-gray-300'>
                  <span>Aktuell in <span class='version'></span></span>
          </span>
            </div>

            <h1 class='text-4xl font-bold tracking-tight text-gray-800 dark:text-white sm:text-6xl'>Effizienz Ihrer Fahrzeuge auf einen
              Blick</h1>
            <p class='mt-6 text-lg leading-8 text-gray-600 dark:text-gray-300'>Mehr Übersicht über euren Fuhrpark mit Ecodrive</p>
            <div class='mt-10 flex items-center justify-center gap-x-6'>
              <a href='https://www.eco-drive.app' target='_blank'
                 class='rounded-md bg-indigo-500 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-400 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-400'>Demo
                ansehen</a>
            </div>
          </div>
          <img src='/projects/waldheim-dev/ecodrive/ecodrive_dashboard_light.png' alt='App screenshot' loading='lazy'
               width='2432' height='1442' class='mt-16 rounded-md bg-white/5 shadow-2xl ring-1 ring-white/10 sm:mt-24'>
        </div>
      </div>
      <div
        class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]'
        aria-hidden='true'>
        <div
          class='relative left-[calc(50%+3rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
          style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
      </div>
    </div>
  </div>

  <div class='overflow-hidden bg-white dark:bg-slate-800 py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2'>
        <div class='lg:pr-8 lg:pt-4'>
          <div class='lg:max-w-lg'>
            <h2 class='text-base font-semibold leading-7 text-indigo-600 dark:text-indigo-400'>Fahrtenbuch digital</h2>
            <p class='mt-2 text-3xl font-bold tracking-tight text-gray-800 dark:text-white sm:text-4xl'>So einfach wars noch nie</p>
            <p class='mt-6 text-lg leading-8 text-gray-700 dark:text-gray-300'>Für Firmen ist ein Fahrtenbuch wichtig. Aber auch privat
              möchte man vielleicht den Konsum seines Fahrzeugs überblicken.</p>
            <dl class='mt-10 max-w-xl space-y-8 text-base leading-7 text-gray-700 dark:text-gray-300 lg:max-w-none'>
              <div class='relative pl-9'>
                <dt class='inline font-semibold text-gray-800 dark:text-white'>
                  <i class='absolute left-1 top-1 fa-solid fa-car text-indigo-500'></i>
                  Mehrere Fahrzeuge.
                </dt>
                <dd class='inline'>Mit der Pro-Version kannst du unbegrenzt viele Fahrzeuge anlegen und verwalten. So
                  behälst du den Überblick über deinen Fuhrpark.
                </dd>
              </div>
              <div class='relative pl-9'>
                <dt class='inline font-semibold text-gray-800 dark:text-white'>
                  <i class='absolute left-1 top-1 fa-solid fa-chart-line-up-down text-indigo-500'></i>
                  Statistiken überblicken.
                </dt>
                <dd class='inline'>Vergleiche dich mit anderen Fahrern und sehe, wie du im Vergleich abschneidest. Auch
                  deinen Verbrauch kannst du mit anderen vergleichen und so sehen, ob du zu viel verbrauchst.
                </dd>
              </div>
              <div class='relative pl-9'>
                <dt class='inline font-semibold text-gray-800 dark:text-white'>
                  <i class='absolute left-1 top-1 fa-solid fa-lock-hashtag text-indigo-500'></i>
                  DSGVO konform.
                </dt>
                <dd class='inline'>Made in Germany. Deine Daten werden auf deutschen Servern gespeichert und unterliegen
                  somit dem deutschen Datenschutz.
                </dd>
              </div>
            </dl>
          </div>
        </div>
        <img src='/projects/waldheim-dev/ecodrive/ecodrive_dashboard_dark.png' alt='Product screenshot' loading='lazy'
             class='w-[48rem] max-w-none rounded-xl shadow-xl ring-1 ring-white/10 sm:w-[57rem] md:-ml-4 lg:-ml-0'
             width='2432' height='1442'>
      </div>
    </div>
  </div>

  <div class='bg-white dark:bg-slate-800 py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-4xl text-center'>
        <h2 class='text-base font-semibold leading-7 text-indigo-600 dark:text-indigo-400'>Preise</h2>
        <p class='mt-2 text-4xl font-bold tracking-tight text-gray-800 dark:text-white sm:text-5xl'>Preise für alle Teams, Firmen und einzelne Personen</p>
      </div>
      <p class='mx-auto mt-6 max-w-2xl text-center text-lg leading-8 text-gray-700 dark:text-gray-300'>Wähle aus, was dir gefällt und du nutzen willst</p>
      <script is:inline>
        let plan = 'monthly';
        document.addEventListener('DOMContentLoaded', () => {
          const monthly = document.querySelector('#monthly');
          const annual = document.querySelector('#annual');

          const free = document.querySelector('#free');
          const basic = document.querySelector('#basic');
          const pro = document.querySelector('#pro');
          const premium = document.querySelector('#premium');

          monthly.addEventListener('click', () => {
            plan = 'monthly';
            monthly.classList.add('bg-indigo-500', 'text-white');
            annual.classList.remove('bg-indigo-500', 'text-white');

            free.querySelector('.price').innerHTML = '0,-€';
            basic.querySelector('.price').innerHTML = '4,99€';
            pro.querySelector('.price').innerHTML = '14,99€';
            premium.querySelector('.price').innerHTML = '249,99€';

            free.querySelector('.frequency').innerHTML = '/Monat';
            basic.querySelector('.frequency').innerHTML = '/Monat';
            pro.querySelector('.frequency').innerHTML = '/Monat';
            premium.querySelector('.frequency').innerHTML = '/Monat';
          })

          annual.addEventListener('click', () => {
            plan = 'annual';
            annual.classList.add('bg-indigo-500', 'text-white');
            monthly.classList.remove('bg-indigo-500', 'text-white');

            free.querySelector('.price').innerHTML = '0,-€';
            basic.querySelector('.price').innerHTML = '44,46€';
            pro.querySelector('.price').innerHTML = '170,89€';
            premium.querySelector('.price').innerHTML = '2999,88€';

            free.querySelector('.frequency').innerHTML = '/Jahr';
            basic.querySelector('.frequency').innerHTML = '/Jahr';
            pro.querySelector('.frequency').innerHTML = '/Jahr';
            premium.querySelector('.frequency').innerHTML = '/Jahr';
          })
        })
      </script>
      <div class='mt-16 flex justify-center'>
        <fieldset
          class='grid grid-cols-2 gap-x-1 rounded-full bg-white/5 p-1 text-center text-xs font-semibold leading-5 text-gray-800 dark:text-white'>
          <legend class='sr-only'>Zahlungsrythmus</legend>
          <!-- Checked: "bg-indigo-500 text-white" -->
          <label class='cursor-pointer rounded-full px-2.5 py-1 bg-indigo-500 text-white' id='monthly'>
            <input type='radio' name='frequency' value='monthly' class='sr-only'>
            <span>Monatlich</span>
          </label>
          <!-- Checked: "bg-indigo-500 text-white" -->
          <label class='cursor-pointer rounded-full px-2.5 py-1' id='annual'>
            <input type='radio' name='frequency' value='annually' class='sr-only'>
            <span>Jährlich</span>
          </label>
        </fieldset>
      </div>
      <div class='isolate mx-auto mt-10 grid max-w-lg grid-cols-1 gap-8 lg:mx-0 md:max-w-none md:grid-cols-2 lg:grid-cols-4'>
