
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import FormattedDate from '../../components/FormattedDate.astro';


const projects = (await getCollection('project')).sort(
(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const categories = (await getCollection('project_kategorie'));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} >


  <div class='bg-white dark:bg-slate-800 py-24 sm:py-32'>
    <div class='mx-auto max-w-7xl px-6 lg:px-8'>
      <div class='mx-auto max-w-2xl text-center'>
        <h1 class='text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 sm:text-4xl'>Projekte der Waldheim.dev</h1>
        <p class='mt-2 text-lg leading-8 text-gray-600 dark:text-gray-300'>Alle Projekte chronologisch.</p>
      </div>

      <div class='mx-auto max-w-2xl text-center flex flex-wrap justify-center items-center gap-2'>
        <button data-trigger="filter" data-filter="all" data-group="category"
          class="relative z-10 rounded-full bg-gray-200  px-2 py-0.5 font-medium text-gray-600 hover:bg-gray-100">Alle</button>
        {categories.map(category => (
                    <button data-trigger="filter" data-filter={category.id} data-group="category"
                      class="relative z-10 rounded-full bg-gray-400  px-2 py-0.5 font-medium text-gray-600 hover:bg-gray-100">{category.data?.name}</button>
        ))}
      </div>
      <div
        class='mx-auto mt-16 grid max-w-2xl auto-rows-fr grid-cols-1 gap-x-8 gap-y-16 sm:mt-20 lg:mx-0 lg:max-w-none lg:grid-cols-2'>


        {
          projects.map(async (project) => {

            return (
            <div class='bg-gray-900 pb-28 sm:pb-36 xl:pb-16 rounded-2xl sm:min-w-96 max-w-full' data-trigger="entry" data-type={project.data?.category.id}>
              <div
                class='mx-auto flex min-w-5xl flex-col items-center gap-x-8 gap-y-10 px-6'>
                <div class='-mt-8 w-full max-w-1xl xl:-mb-8'>
                  <div class='relative aspect-[16/9] w-68 md:-mx-8 xl:mx-0'>
                    <img class='absolute inset-0 h-full w-full rounded-2xl bg-gray-800 object-cover shadow-2xl'
                         src={project.data.heroImage} alt={project.data.title} loading='lazy'>
                  </div>
                </div>
                <div class='md:min-w-96 xl:flex-auto'>
                  <figure class='relative isolate pt-6 sm:pt-12 text-white'>
                    <FormattedDate date={project.data.pubDate} />
                    <blockquote class='text-xl font-semibold leading-8 text-white sm:text-2xl sm:leading-9'>
                      <p>{project.data.title}</p>
                    </blockquote>
                    <div
                      class="font-medium text-slate-300">
                      {categories.find(category => category.id === project.data?.category.id)?.data.name
                      }</div>
                      
                  <p class='flex flex-wrap items-center gap-y-1 overflow-hidden text-sm leading-6 text-gray-300'>{project.data.shortDescription}</p>
                    <figcaption class='mt-8 text-base'>
                      <a href={`/projects/${project.slug}`}
                         class='rounded-md px-3 py-2 bg-indigo-600 text-white hover:bg-indigo-800'>Projekt ansehen</a>
                    </figcaption>
                  </figure>
                </div>
              </div>
            </div>
              );
          })
        }
      </div>
      <script is:inline>
        const buttons = document.querySelectorAll('button[data-trigger="filter"]');
        const projects = document.querySelectorAll('*[data-trigger="entry"]');

        buttons.forEach(button => {
          button.addEventListener('click', () => {
            buttons.forEach(btn => {btn.classList.remove('bg-gray-200');btn.classList.add('bg-gray-400')});
            button.classList.add('bg-gray-200')
            button.classList.remove('bg-gray-400');

            const filter = button.getAttribute('data-filter');

            projects.forEach(project => {
              const type = project.getAttribute('data-type');
              if (filter === 'all' || filter === type) {
                project.style.removeProperty('display');
              } else {
                project.style.display = 'none';
              }
            });
          });
        });
      </script>
    </div>
  </div>
</BaseLayout>