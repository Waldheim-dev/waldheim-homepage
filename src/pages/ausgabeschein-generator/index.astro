---
import Layout from '../../layouts/Layout.astro';
import { getProductInfo } from '../../consts/productColors';
import { SchemaUtils } from '../../utils/schema';

const productKey = 'ausgabeschein-generator';
const product = getProductInfo(productKey)!;
const pageTitle = `${product.name} - Netbox Plugin | waldheim.dev`;
const pageDescription = 'Open-Source Ausgabeschein-Generator für NetBox: Übergabe-, Rückgabe- und Überlassungsprotokolle mit Geräte-Details, Bibliothek, optionalem Backend und Docker-Setup.';
const keywords = 'Ausgabeschein Generator, Netbox Plugin, Open Source, GitLab, Docker, PDF Generation, IT-Asset Management, Uebergabeprotokoll, Rueckgabeprotokoll, Mobile';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Linux, Docker',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.5', ratingCount: '12' },
  softwareVersion: product.version,
  description: pageDescription,
  url: 'https://waldheim.dev/ausgabeschein-generator',
  downloadUrl: 'https://gitlab.com/mwaldheim/ausgabeschein-generator',
  author: { '@type': 'Organization', name: 'waldheim.dev', url: 'https://waldheim.dev' },
  license: 'Open Source'
};

const breadcrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: product.name, link: 'https://waldheim.dev/ausgabeschein-generator' }
]);
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} schema={[softwareSchema, breadcrumbSchema]}>
  <section class='relative py-24 sm:py-32 px-6 overflow-hidden bg-meg-bg-dark border-b border-meg-border-dark'>
    <div class='mx-auto max-w-7xl'><div class='text-center mb-16 gsap-fadein'>
      <div class='mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark shadow-sm backdrop-blur-md'><i class='fa-solid fa-clipboard-list text-meg-accent' aria-hidden='true'></i><span class='text-meg-text-primary-dark font-bold text-sm tracking-tight'>Netbox Plugin</span><span class='bg-meg-accent/20 text-meg-accent px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-tighter ml-2'>v{product.version}</span></div>
      <h1 class='text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-8'>Ausgabeschein <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Generator</span></h1>
      <p class='text-xl md:text-2xl text-meg-text-secondary max-w-3xl mx-auto mb-10 leading-relaxed'>Erstelle Übergabe-, Rückgabe- und Überlassungsprotokolle in Sekunden. Open Source, NetBox-ready und optimiert für Desktop wie Mobile.</p>
      <div class='flex flex-col sm:flex-row gap-4 justify-center items-center'><a href='https://gitlab.com/mwaldheim/ausgabeschein-generator' target='_blank' rel='noopener noreferrer' class='w-full sm:w-auto group px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all duration-300 hover:scale-[1.02] inline-flex items-center justify-center gap-2'><i class='fa-brands fa-gitlab text-2xl' aria-hidden='true'></i><span>Auf GitLab ansehen</span></a><a href='https://suite.waldheim.dev' target='_blank' rel='noopener noreferrer' class='w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all duration-300 inline-flex items-center justify-center gap-2'><span>Customizing anfragen</span><i class='fa-solid fa-arrow-right' aria-hidden='true'></i></a></div>
    </div></div>
  </section>

  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark'><div class='mx-auto max-w-7xl'><div class='text-center mb-16 gsap-fadein'><h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>Produkt-Preview</h2><p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>Die wichtigsten <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Workflows</span> auf einen Blick</p><p class='text-meg-text-secondary max-w-3xl mx-auto text-lg leading-relaxed'>Vom Suchen des Assets bis zum druckfertigen Protokoll: v3 bildet den kompletten Ausgabeprozess transparent ab und ergänzt zentrale Bibliotheks-Workflows.</p></div>
    <div class='grid md:grid-cols-2 gap-6'>
      <article class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl overflow-hidden shadow-sm hover:border-meg-accent/30 transition-all duration-300'><img src='/products/ausgabeschein-generator/device-details.png' alt='v3 Geräte-Detailansicht mit NetBox-Stammdaten, Schnittstellen und IP-Adressen' class='w-full h-64 object-cover object-top' loading='lazy' decoding='async' /><div class='p-6'><h3 class='text-xl font-bold text-meg-text-primary-dark mb-2'>NetBox-Details statt Datenschatten</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Mandant, Status, Plattform, Standort, IP-Adressen und Schnittstellen direkt am ausgewählten Gerät prüfen.</p></div></article>
      <article class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl overflow-hidden shadow-sm hover:border-meg-accent/30 transition-all duration-300'><img src='/products/ausgabeschein-generator/print-preview-v3.png' alt='v3 Druckvorschau eines Ausgabeprotokolls mit Geräte- und Mitarbeiterdaten' class='w-full h-64 object-cover object-top' loading='lazy' decoding='async' /><div class='p-6'><h3 class='text-xl font-bold text-meg-text-primary-dark mb-2'>Saubere Druckvorschau</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Alle relevanten NetBox-Informationen strukturiert aufbereiten und sofort als PDF exportieren oder drucken.</p></div></article>
      <article class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl overflow-hidden shadow-sm hover:border-meg-accent/30 transition-all duration-300'><img src='/products/ausgabeschein-generator/library-backend.png' alt='Gerätebibliothek mit Favoriten, Zuletzt verwendet, Archiv, Sammelmappe und zentraler Synchronisierung' class='w-full h-64 object-cover object-top' loading='lazy' decoding='async' /><div class='p-6'><h3 class='text-xl font-bold text-meg-text-primary-dark mb-2'>Bibliothek mit optionalem Backend</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Favoriten, zuletzt verwendete Geräte, Archiv und Sammelmappe lokal oder zentral synchronisieren und als JSON importieren/exportieren.</p></div></article>
      <article class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl overflow-hidden shadow-sm hover:border-meg-accent/30 transition-all duration-300'><img src='/products/ausgabeschein-generator/settings-v3.png' alt='v3 Einstellungsdialog mit aktivierbaren Protokolltypen, Bibliotheksfunktionen und Sprachen' class='w-full h-64 object-cover object-top' loading='lazy' decoding='async' /><div class='p-6'><h3 class='text-xl font-bold text-meg-text-primary-dark mb-2'>Konfigurierbar bis ins Detail</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Protokolltypen, Texte, Standard-Sprache und optionale Bibliotheksfunktionen passend zum Betrieb aktivieren.</p></div></article>
    </div>
  </div></section>

  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark'><div class='mx-auto max-w-7xl'><div class='text-center mb-16 gsap-fadein'><h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>V3 im Überblick</h2><p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>Vom <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Suchfeld</span> bis zum Backend</p><p class='text-meg-text-secondary max-w-3xl mx-auto text-lg leading-relaxed'>Alle Bausteine für einen nachvollziehbaren Geräte- und Übergabeprozess: lokal, zentral synchronisiert oder als komplett containerisiertes Setup.</p></div><div class='grid md:grid-cols-2 lg:grid-cols-3 gap-6'>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-magnifying-glass text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Suchen &amp; auswählen</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Read-only-Suche nach Gerätename, numerischer ID, Asset-Tag und Seriennummer mit Treffer-Ranking und Stammdaten-Vorschau.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-file-signature text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Drei Protokolltypen</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Ausgabe, Rückgabe und Überlassung mit Druckvorschau, PDF-/JSON-Export, Signaturfeldern und konfigurierbaren Texten.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-globe text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>34 Sprachen</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Mehrsprachige Oberfläche inklusive RTL-Sprachen, Standardsprache und Sprachwechsel für internationale Teams.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-box-archive text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Bibliothek &amp; Exporte</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Favoriten, zuletzt verwendet, Archiv und Sammelmappe. Bibliotheksdaten als JSON importieren oder exportieren.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-shield-halved text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Serverseitig geschützt</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Optionaler Same-Origin-Proxy hält das NetBox-Token aus dem Browser fern. Die App schreibt keine NetBox-Daten.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-mobile-screen-button text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Responsive &amp; offline-fähig</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Für Desktop, Tablet und mobile Ausgabeplätze optimiert. Service Worker unterstützt den produktiven Browserbetrieb.</p></div>
  </div></div></section>

  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark'><div class='mx-auto max-w-7xl'><div class='text-center mb-16 gsap-fadein'><h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>Asset Management</h2><p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>Perfekt für <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>NetBox</span></p></div><div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8'>
    {[{ icon: 'fa-plug', title: 'NetBox Integration', desc: 'Nahtloser Zugriff auf deine NetBox-Devices und User-Daten.' },{ icon: 'fa-brands fa-osi', title: 'Open Source', desc: 'Transparenz und Flexibilität durch GitLab Open Source Lizenz.' },{ icon: 'fa-layer-group', title: 'Gerätebibliothek', desc: 'Favoriten, zuletzt verwendet, Archiv und Sammelmappe für wiederkehrende Ausgabeprozesse.' },{ icon: 'fa-file-pdf', title: 'PDF Generation', desc: 'Professionelle Ausgabequittungen direkt als PDF exportieren.' },{ icon: 'fa-code', title: 'Highly Adaptable', desc: 'Konfigurierbare Texte, Protokolltypen, Sprachen und Runtime-Einstellungen.' },{ icon: 'fa-server', title: 'Optionales Backend', desc: 'Same-Origin-NetBox-Proxy, zentrale Bibliothek und sichere Live-Einstellungen ohne Token im Browser.' },{ icon: 'fa-brands fa-docker', title: 'Docker Support', desc: 'Frontend und optionales Go-Backend gemeinsam per Docker Compose betreiben.' }].map((feat, i) => (<div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${i * 0.1}s`}><div class='size-14 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-inner'><i class={`fa-solid ${feat.icon} text-2xl text-meg-accent`} aria-hidden='true'></i></div><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>{feat.title}</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>{feat.desc}</p></div>))}
  </div></div></section>

  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark'><div class='mx-auto max-w-5xl'><div class='text-center mb-16 gsap-fadein'><h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>Setup</h2><p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>Drei Wege, ein <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>klarer Betrieb</span></p></div><div class='grid md:grid-cols-3 gap-6'>
    <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm'><p class='text-xs font-black uppercase tracking-widest text-meg-accent mb-2'>Frontend-only</p><h3 class='text-2xl font-bold text-meg-text-primary-dark mb-3'>Release laden</h3><p class='text-meg-text-secondary text-sm mb-6'>ZIP entpacken, <code class='text-meg-accent'>server.json</code> konfigurieren und die SPA auf deinem Webserver ausliefern.</p><a href='https://gitlab.com/mwaldheim/ausgabeschein-generator/-/releases' target='_blank' rel='noopener noreferrer' class='inline-flex items-center gap-2 px-4 py-2 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-sm rounded-lg hover:border-meg-accent/50 transition-all'><i class='fa-brands fa-gitlab'></i><span>Zu den Releases</span></a></div>
    <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm'><p class='text-xs font-black uppercase tracking-widest text-meg-accent mb-2'>Optionales Backend</p><h3 class='text-2xl font-bold text-meg-text-primary-dark mb-3'>Zentral synchronisieren</h3><p class='text-meg-text-secondary text-sm mb-6'>Go-Service als Same-Origin-Reverse-Proxy ergänzen. NetBox-Token und Bibliotheksdaten bleiben serverseitig.</p><div class='bg-meg-bg-dark rounded-xl p-4 border border-meg-border-dark font-mono text-xs text-meg-text-secondary'><span class='text-meg-accent'>frontend</span> + <span class='text-meg-accent'>backend</span><br/><span class='opacity-50'>/api/health · /api/config</span><br/><span class='opacity-50'>/api/library · /api/netbox/*</span></div></div>
    <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm'><p class='text-xs font-black uppercase tracking-widest text-meg-accent mb-2'>Docker Compose</p><h3 class='text-2xl font-bold text-meg-text-primary-dark mb-3'>Beides zusammen starten</h3><p class='text-meg-text-secondary text-sm mb-6'>Multi-Stage-Frontend, Go-Backend und persistenter Datenspeicher in einem reproduzierbaren Setup.</p><div class='bg-meg-bg-dark rounded-xl p-4 border border-meg-border-dark font-mono text-xs text-meg-text-secondary overflow-x-auto'><pre><code>docker compose up -d

frontend :8088
backend  :8080</code></pre></div></div>
  </div><div class='mt-12 gsap-fadein bg-meg-accent/5 border border-meg-accent/20 rounded-2xl p-8'><div class='flex items-start gap-4'><i class='fa-solid fa-circle-info text-2xl text-meg-accent mt-1'></i><p class='text-meg-text-secondary text-sm leading-relaxed'><strong>Wichtig:</strong> Die Anwendung ist eine SPA. Alle Requests müssen serverseitig an die <code class='text-meg-accent font-black'>index.html</code> geleitet werden.</p></div></div></div></section>

  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark'><div class='mx-auto max-w-4xl text-center gsap-fadein'><h2 class='text-4xl md:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-8'>Optimierte <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Asset-Ausgabe</span></h2><p class='text-xl text-meg-text-secondary mb-12 max-w-2xl mx-auto'>Starte jetzt oder kontaktiere mich für individuellen NetBox-Support.</p><div class='flex flex-col sm:flex-row gap-4 justify-center items-center'><a href='https://gitlab.com/mwaldheim/ausgabeschein-generator' target='_blank' rel='noopener noreferrer' class='w-full sm:w-auto px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all hover:scale-[1.02] inline-flex items-center justify-center gap-2'><i class='fa-brands fa-gitlab text-2xl'></i><span>GitLab Repository</span></a><a href='https://suite.waldheim.dev' target='_blank' rel='noopener noreferrer' class='w-full sm:w-auto px-8 py-4 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all inline-flex items-center justify-center gap-2'><span>Fragen? Kundenportal</span><i class='fa-solid fa-arrow-right'></i></a></div></div></section>
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-t border-meg-border-dark'><div class='mx-auto max-w-7xl'><div class='text-center mb-16 gsap-fadein'><h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>Deployment-Optionen</h2><p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>Passt in deine <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Infrastruktur</span></p><p class='text-meg-text-secondary max-w-3xl mx-auto text-lg leading-relaxed'>Der Generator kann als statische Web-App starten oder mit dem optionalen Backend in bestehende Proxy- und Container-Umgebungen integriert werden.</p></div><div class='grid md:grid-cols-2 lg:grid-cols-3 gap-6'>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-server text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Nginx oder Apache</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Den Build aus <code class='text-meg-accent'>dist/ausgabeschein-generator</code> statisch ausliefern und SPA-Routen auf <code class='text-meg-accent'>index.html</code> zurückführen. Optional <code class='text-meg-accent'>/api/</code> an das Go-Backend proxien.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-docker text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Docker Compose</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Frontend- und Backend-Container gemeinsam bauen und starten. Nginx liefert die UI, der JSON-Store bleibt im persistenten Volume.</p><code class='mt-4 block text-xs text-meg-accent font-mono'>docker compose up -d --build</code></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-route text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Traefik</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Frontend-Service per Host-Regel und TLS exponieren. Nginx routet <code class='text-meg-accent'>/api/*</code> intern weiter, damit alles unter derselben Origin bleibt.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-cubes text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Getrennte Services</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>Nginx und Go-Backend können auf separaten Hosts oder Plattform-Services laufen. Wichtig: UI und <code class='text-meg-accent'>/api/*</code> müssen unter einer Origin erreichbar sein.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-laptop-code text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Lokale Entwicklung</h3><p class='text-meg-text-secondary text-sm leading-relaxed'><code class='text-meg-accent'>pnpm run startDB</code> stellt Demo-Geräte unter Port 3004 bereit, <code class='text-meg-accent'>pnpm run start:review</code> die Angular-App unter Port 4200.</p></div>
    <div class='bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-7'><i class='fa-solid fa-box-open text-2xl text-meg-accent mb-5'></i><h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>Release-Artefakte</h3><p class='text-meg-text-secondary text-sm leading-relaxed'>GitLab-Releases liefern das Frontend-ZIP sowie Linux-Binaries für amd64 und arm64 inklusive Checksums für reproduzierbare Deployments.</p></div>
  </div><div class='mt-10 bg-meg-accent/5 border border-meg-accent/20 rounded-2xl p-7'><p class='text-meg-text-secondary text-sm leading-relaxed'><strong class='text-meg-text-primary-dark'>Betriebshinweis:</strong> Eine produktive <code class='text-meg-accent'>server.json</code> mit echtem NetBox-Token gehört in Secret-/Config-Management und niemals in Git, Screenshots oder den Browser.</p></div></div></section>
</Layout>
