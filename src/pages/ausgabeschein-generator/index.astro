---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS, getProductInfo } from '../../consts/productColors';
import { SchemaUtils } from '../../utils/schema';

const productKey = 'ausgabeschein-generator';
const product = getProductInfo(productKey)!;
const colors = product.colors;

const pageTitle = `${product.name} - Netbox Plugin | waldheim.dev`;
const pageDescription = 'Netbox Plugin für effiziente Ausgabeschein-Verwaltung. Open Source, GitLab-basiert und einfach zu integrieren. Docker-Support, PDF-Generation.';
const keywords = 'Ausgabeschein Generator, Netbox Plugin, Open Source, GitLab, Docker, PDF Generation, IT-Asset Management';

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Linux, Docker',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    ratingCount: '12'
  },
  softwareVersion: product.version,
  description: pageDescription,
  url: 'https://waldheim.dev/ausgabeschein-generator',
  downloadUrl: 'https://gitlab.com/mwaldheim/ausgabeschein-generator',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  license: 'Open Source'
};

const breadcrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: product.name, link: 'https://waldheim.dev/ausgabeschein-generator' }
]);
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={keywords}
  schema={[softwareSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class='relative py-24 sm:py-32 px-6 overflow-hidden bg-meg-bg-dark border-b border-meg-border-dark'>
    <div class='mx-auto max-w-7xl'>
      <div class='text-center mb-16 gsap-fadein'>
        <div class='mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark shadow-sm backdrop-blur-md'>
          <i class='fa-solid fa-clipboard-list text-meg-accent' aria-hidden='true'></i>
          <span class='text-meg-text-primary-dark font-bold text-sm tracking-tight'>Netbox Plugin</span>
          <span class='bg-meg-accent/20 text-meg-accent px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-tighter ml-2'>v{product.version}</span>
        </div>
        
        <h1 class='text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-8'>
          Ausgabeschein <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Generator</span>
        </h1>
        
        <p class='text-xl md:text-2xl text-meg-text-secondary max-w-3xl mx-auto mb-10 leading-relaxed'>
          Automatisierte Ausgabeschein-Verwaltung für IT-Assets. Nahtlos integriert in Netbox.
        </p>

        <div class='flex flex-col sm:flex-row gap-4 justify-center items-center'>
          <a
            href='https://gitlab.com/mwaldheim/ausgabeschein-generator'
            target='_blank'
            rel='noopener noreferrer'
            class='w-full sm:w-auto group px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all duration-300 hover:scale-[1.02] inline-flex items-center justify-center gap-2'
          >
            <i class='fa-brands fa-gitlab text-2xl' aria-hidden='true'></i>
            <span>Auf GitLab ansehen</span>
          </a>
          
          <a
            href='https://portal.waldheim.dev'
            target='_blank'
            rel='noopener noreferrer'
            class='w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all duration-300 inline-flex items-center justify-center gap-2'
          >
            <span>Customizing anfragen</span>
            <i class='fa-solid fa-arrow-right' aria-hidden='true'></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark'>
    <div class='mx-auto max-w-7xl'>
      <div class='text-center mb-16 gsap-fadein'>
        <h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>
          Asset Management
        </h2>
        <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          Perfekt für <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Netbox</span>
        </p>
      </div>

      <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8'>
        {[
          { icon: 'fa-plug', title: 'Netbox Integration', desc: 'Nahtloser Zugriff auf deine Netbox-Devices und User-Daten.' },
          { icon: 'fa-brands fa-osi', title: 'Open Source', desc: 'Transparenz und Flexibilität durch GitLab Open Source Lizenz.' },
          { icon: 'fa-rocket', title: 'Fast Setup', desc: 'Schnelle Einrichtung als Angular-App oder Netbox-Plugin.' },
          { icon: 'fa-file-pdf', title: 'PDF Generation', desc: 'Professionelle Ausgabequittungen direkt als PDF exportieren.' },
          { icon: 'fa-code', title: 'Highly Adaptable', desc: 'Einfach erweiterbar durch modulare Angular-Architektur.' },
          { icon: 'fa-brands fa-docker', title: 'Docker Support', desc: 'Optimiert für den Einsatz in Docker-Umgebungen.' }
        ].map((feat, i) => (
          <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${i * 0.1}s`}>
            <div class='size-14 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-inner'>
              <i class={`fa-solid ${feat.icon} text-2xl text-meg-accent`} aria-hidden='true'></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>{feat.title}</h3>
            <p class='text-meg-text-secondary text-sm leading-relaxed'>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
    </div>
  </section>

  <!-- Installation Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark'>
    <div class='mx-auto max-w-5xl'>
      <div class='text-center mb-16 gsap-fadein'>
        <h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>
          Setup
        </h2>
        <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Installation</span> in 3 Schritten
        </p>
      </div>

      <div class='grid gap-8'>
        <!-- Step 1 -->
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group hover:border-meg-accent/30 transition-all'>
          <div class='flex flex-col md:flex-row items-start gap-6'>
            <div class='size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center shrink-0 shadow-inner group-hover:border-meg-accent/50 transition-all'>
              <span class='text-2xl font-black text-meg-accent'>1</span>
            </div>
            <div class='flex-1'>
              <h3 class='text-2xl font-bold text-meg-text-primary-dark mb-3'>Release laden</h3>
              <p class='text-meg-text-secondary text-sm mb-6'>Lade die neueste Version von GitLab herunter.</p>
              <a href='https://gitlab.com/mwaldheim/ausgabeschein-generator/-/releases' target='_blank' class='inline-flex items-center gap-2 px-4 py-2 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-sm rounded-lg hover:border-meg-accent/50 transition-all'>
                <i class='fa-brands fa-gitlab'></i>
                <span>Zu den Releases</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group hover:border-meg-accent/30 transition-all'>
          <div class='flex flex-col md:flex-row items-start gap-6'>
            <div class='size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center shrink-0 shadow-inner group-hover:border-meg-accent/50 transition-all'>
              <span class='text-2xl font-black text-meg-accent'>2</span>
            </div>
            <div class='flex-1'>
              <h3 class='text-2xl font-bold text-meg-text-primary-dark mb-3'>Entpacken</h3>
              <p class='text-meg-text-secondary text-sm mb-6'>Kopiere den <code class="text-meg-accent">browser</code>-Ordner auf deinen Webserver.</p>
              <div class='bg-meg-bg-dark rounded-xl p-4 border border-meg-border-dark font-mono text-xs text-meg-text-secondary'>
                <span class='text-meg-accent'>dist/</span><br/>
                <span class='ml-4'>└── browser/</span><br/>
                <span class='ml-8 opacity-50'>├── index.html</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group hover:border-meg-accent/30 transition-all'>
          <div class='flex flex-col md:flex-row items-start gap-6'>
            <div class='size-12 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center shrink-0 shadow-inner group-hover:border-meg-accent/50 transition-all'>
              <span class='text-2xl font-black text-meg-accent'>3</span>
            </div>
            <div class='flex-1'>
              <h3 class='text-2xl font-bold text-meg-text-primary-dark mb-3'>Config</h3>
              <p class='text-meg-text-secondary text-sm mb-6'>Konfiguriere deine Nginx/Apache Site als SPA.</p>
              <div class='bg-meg-bg-dark rounded-xl p-4 border border-meg-border-dark font-mono text-xs text-meg-text-secondary overflow-x-auto'>
                <pre><code>location / &#123;
    try_files $uri $uri/ /index.html;
&#125;</code></pre>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Hinweis -->
      <div class='mt-12 gsap-fadein bg-meg-accent/5 border border-meg-accent/20 rounded-2xl p-8'>
        <div class='flex items-start gap-4'>
          <i class='fa-solid fa-circle-info text-2xl text-meg-accent mt-1'></i>
          <p class='text-meg-text-secondary text-sm leading-relaxed'>
            <strong>Wichtig:</strong> Die Anwendung ist eine SPA. Alle Requests müssen serverseitig an die <code class='text-meg-accent font-black'>index.html</code> geleitet werden.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark'>
    <div class='mx-auto max-w-4xl text-center gsap-fadein'>
      <h2 class='text-4xl md:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-8'>
        Optimierte <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Asset-Ausgabe</span>
      </h2>
      <p class='text-xl text-meg-text-secondary mb-12 max-w-2xl mx-auto'>
        Starte jetzt oder kontaktiere mich für individuellen Netbox-Support.
      </p>
      
      <div class='flex flex-col sm:flex-row gap-4 justify-center items-center'>
        <a
          href='https://gitlab.com/mwaldheim/ausgabeschein-generator'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full sm:w-auto px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all hover:scale-[1.02] inline-flex items-center justify-center gap-2'
        >
          <i class='fa-brands fa-gitlab text-2xl'></i>
          <span>GitLab Repository</span>
        </a>
        
        <a
          href='https://portal.waldheim.dev'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full sm:w-auto px-8 py-4 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all inline-flex items-center justify-center gap-2'
        >
          <span>Fragen? Kundenportal</span>
          <i class='fa-solid fa-arrow-right'></i>
        </a>
      </div>
    </div>
  </section>
</Layout>
