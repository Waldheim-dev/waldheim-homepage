---
import Layout from '../../layouts/Layout.astro';
import { PRODUCTS, getProductInfo } from '../../consts/productColors';
import { SchemaUtils } from '../../utils/schema';

const productKey = 'astro-ai-llms-txt';
const product = getProductInfo(productKey)!;
const colors = product.colors;

const pageTitle = `${product.name} - NPM Package | waldheim.dev`;
const pageDescription = 'Automatische Generierung von KI-optimierten llms.txt Dateien für Astro-Projekte. AI-Summarization mit Ollama, OpenAI & Gemini. SEO-freundlich.';
const keywords = 'Astro Integration, llms.txt, AI Crawler, SEO, NPM Package, Ollama, OpenAI, Gemini, AI Summarization';

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Cross-platform',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.8',
    ratingCount: '24'
  },
  softwareVersion: product.version,
  description: pageDescription,
  url: 'https://waldheim.dev/astro-ai-llms-txt',
  downloadUrl: 'https://www.npmjs.com/package/@waldheimdev/astro-ai-llms-txt',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  license: 'MIT'
};

const breadcrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: product.name, link: 'https://waldheim.dev/astro-ai-llms-txt' }
]);
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={keywords}
  schema={[softwareSchema, breadcrumbSchema]}
>
  <!-- Hero Section -->
  <section class='relative py-24 sm:py-32 px-6 overflow-hidden bg-meg-bg-dark border-b border-meg-border-dark'>
    <div class='mx-auto max-w-7xl'>
      <div class='text-center mb-16 gsap-fadein'>
        <div class='mb-8 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark shadow-sm backdrop-blur-md'>
          <i class='fa-solid fa-sparkles text-meg-accent' aria-hidden='true'></i>
          <span class='text-meg-text-primary-dark font-bold text-sm tracking-tight'>Astro Integration</span>
          <span class='bg-meg-accent/20 text-meg-accent px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-tighter ml-2'>v{product.version}</span>
        </div>
        
        <h1 class='text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-8'>
          Astro AI <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>llms.txt</span> Generator
        </h1>
        
        <p class='text-xl md:text-2xl text-meg-text-secondary max-w-3xl mx-auto mb-10 leading-relaxed'>
          ✨ KI-optimierte llms.txt für bessere AI-Crawler-Indexierung. Automatisch bei jedem Build.
        </p>

        <div class='flex flex-col sm:flex-row gap-4 justify-center items-center'>
          <a
            href='https://www.npmjs.com/package/@waldheimdev/astro-ai-llms-txt'
            target='_blank'
            rel='noopener noreferrer'
            class='w-full sm:w-auto group px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all duration-300 hover:scale-[1.02] inline-flex items-center justify-center gap-2'
          >
            <i class='fa-brands fa-npm text-2xl' aria-hidden='true'></i>
            <span>Auf NPM ansehen</span>
          </a>
          
          <a
            href='#installation'
            class='w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all duration-300 inline-flex items-center justify-center gap-2'
          >
            <span>Installation</span>
            <i class='fa-solid fa-download' aria-hidden='true'></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark'>
    <div class='mx-auto max-w-7xl'>
      <div class='text-center mb-16 gsap-fadein'>
        <h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>
          Core Features
        </h2>
        <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          Magisch einfach, <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>KI-optimiert</span>
        </p>
      </div>

      <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-8'>
        {[
          { icon: 'fa-robot', title: 'AI Summarization', desc: 'Unterstützt Ollama, OpenAI und Gemini. Summarization für jede Seite.' },
          { icon: 'fa-database', title: 'Smart Caching', desc: 'SHA256-basiertes Caching spart API-Kosten und Build-Zeit.' },
          { icon: 'fa-tags', title: 'Content Extraction', desc: 'Präzise Extraktion von Titeln, Beschreibungen und Inhalten.' },
          { icon: 'fa-folder-tree', title: 'Section Grouping', desc: 'Strukturiert llms.txt nach Web-Sektionen (z.B. Blog, Docs).' },
          { icon: 'fa-shield-halved', title: 'Robust & Safe', desc: 'Normalisierung, Error-Detection und Build-Sicherheit.' },
          { icon: 'fa-bug', title: 'Debug Logging', desc: 'Detailliertes Feedback für Entwicklung und Troubleshooting.' }
        ].map((feat, i) => (
          <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 hover:border-meg-accent/30 transition-all duration-300 group shadow-sm' style={`animation-delay: ${i * 0.1}s`}>
            <div class='size-14 bg-meg-bg-dark border border-meg-border-dark rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-inner'>
              <i class={`fa-solid ${feat.icon} text-2xl text-meg-accent`} aria-hidden='true'></i>
            </div>
            <h3 class='text-xl font-bold text-meg-text-primary-dark mb-3'>{feat.title}</h3>
            <p class='text-meg-text-secondary text-sm leading-relaxed'>{feat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Installation Section -->
  <section id='installation' class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark'>
    <div class='mx-auto max-w-4xl'>
      <div class='text-center mb-16 gsap-fadein'>
        <h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>
          Setup
        </h2>
        <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          Blitzschnelle <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Installation</span>
        </p>
      </div>

      <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 mb-8 shadow-sm group hover:border-meg-accent/30 transition-all'>
        <h3 class='text-xl font-bold text-meg-text-primary-dark mb-6 flex items-center gap-2'>
          <i class="fa-solid fa-terminal text-meg-accent"></i>
          Package hinzufügen
        </h3>
        <div class='bg-meg-bg-dark rounded-xl p-6 font-mono text-sm text-meg-text-secondary border border-meg-border-dark shadow-inner overflow-x-auto'>
          <code>
            <span class="text-meg-accent"># npm</span><br/>
            npm install @waldheimdev/astro-ai-llms-txt<br/><br/>
            <span class="text-meg-accent"># pnpm</span><br/>
            pnpm add @waldheimdev/astro-ai-llms-txt
          </code>
        </div>
      </div>

      <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm group hover:border-meg-accent/30 transition-all'>
        <h3 class='text-xl font-bold text-meg-text-primary-dark mb-6 flex items-center gap-2'>
          <i class="fa-solid fa-gear text-meg-accent"></i>
          Konfiguration
        </h3>
        <div class='bg-meg-bg-dark rounded-xl p-6 font-mono text-sm text-meg-text-secondary border border-meg-border-dark shadow-inner overflow-x-auto'>
          <pre><code>import llmsTxt from '@waldheimdev/astro-ai-llms-txt';

export default &#123;
  integrations: [
    llmsTxt(&#123;
      projectName: '🚀 My Project',
      aiProvider: 'ollama',
      aiModel: 'llama3',
      site: 'https://my-domain.com',
    &#125;),
  ],
&#125;;</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- Output Example Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark border-b border-meg-border-dark'>
    <div class='mx-auto max-w-4xl'>
      <div class='text-center mb-16 gsap-fadein'>
        <h2 class='text-sm font-bold uppercase tracking-widest text-meg-accent mb-4'>
          Resultat
        </h2>
        <p class='text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          Der <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>Output</span>
        </p>
      </div>

      <div class='gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-8 shadow-sm'>
        <h3 class='text-xl font-bold text-meg-text-primary-dark mb-6'>Beispiel llms.txt</h3>
        <div class='bg-meg-bg-dark rounded-xl p-6 font-mono text-sm text-meg-text-secondary border border-meg-border-dark shadow-inner overflow-x-auto'>
          <pre><code># 🚀 My Project
{"{">"}"} KI-optimized overview for LLMs. 🧠

## Blog
- [/blog/post-1]: Post title summary...
- [/blog/post-2]: Post title summary...</code></pre>
        </div>
        <p class='text-xs text-meg-text-secondary mt-6 opacity-70 italic'>
          <strong>Hinweis:</strong> llms.txt ergänzt robots.txt und sitemap.xml. Mehr auf <a href='https://llmstxt.org' target='_blank' rel='noopener noreferrer' class='text-meg-accent hover:underline'>llmstxt.org</a>
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class='py-24 sm:py-32 px-6 bg-meg-bg-dark'>
    <div class='mx-auto max-w-4xl text-center gsap-fadein'>
      <h2 class='text-4xl md:text-6xl font-black tracking-tighter text-meg-text-primary-dark mb-8'>
        Ready for <span class='text-transparent bg-clip-text bg-gradient-to-r from-meg-accent to-sky-400'>AI-Indexierung</span>?
      </h2>
      <p class='text-xl text-meg-text-secondary mb-12 max-w-2xl mx-auto'>
        Optimiere deine Astro-Seite jetzt für die Zukunft der Suche.
      </p>
      
      <div class='flex flex-col sm:flex-row gap-4 justify-center items-center'>
        <a
          href='https://www.npmjs.com/package/@waldheimdev/astro-ai-llms-txt'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full sm:w-auto px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all hover:scale-[1.02] inline-flex items-center justify-center gap-2'
        >
          <i class='fa-brands fa-npm text-2xl' aria-hidden='true'></i>
          <span>NPM Package</span>
        </a>
        
        <a
          href='https://portal.waldheim.dev'
          target='_blank'
          rel='noopener noreferrer'
          class='w-full sm:w-auto px-8 py-4 bg-meg-surface-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all inline-flex items-center justify-center gap-2'
        >
          <span>Fragen? Support</span>
          <i class='fa-solid fa-arrow-right' aria-hidden='true'></i>
        </a>
      </div>
    </div>
  </section>
</Layout>
