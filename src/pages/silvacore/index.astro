---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';
import PriceSilvacore from '../../components/PriceSilvacore.astro';
import SilvaCoreProblem from '../../components/SilvaCoreProblem.astro';
import SilvacoreFeatures from '../../components/SilvacoreFeatures.astro';
import SilvacoreAudience from '../../components/SilvacoreAudience.astro';
import SilvacoreTech from '../../components/SilvacoreTech.astro';
import SilvacoreCTA from '../../components/SilvacoreCTA.astro';
import SilvacoreComparison from '../../components/SilvacoreComparison.astro';
import SilvacoreScreenshots from '../../components/SilvacoreScreenshots.astro';
import SilvacoreRoadmap from '../../components/SilvacoreRoadmap.astro';

const product = getProductInfo('silvacore')!;

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Silvacore',
  link: 'https://waldheim.dev/silvacore'
}]);

const titel = "Silvacore: Professionelle WEG-Verwaltung | Waldheim.dev";
const description = "Silvacore: Die moderne Cloud-Lösung für WEG-Verwaltung in Deutschland. Rechtssicher, DSGVO-konform und Made in Germany. Jetzt kostenlos starten!";
const keywords = "WEG-Verwaltung, Wohnungseigentümergemeinschaft, Hausverwaltung, DSGVO, Nebenkostenabrechnung, HKVO, Property Management, Immobilienverwaltung, Cloud-Verwaltung";

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter (1 WEG)',
      price: '0',
      priceCurrency: 'EUR',
      billingDuration: 'P1M'
    },
    {
      '@type': 'Offer',
      name: 'Pro (unbegrenzt WEGs)',
      price: '5',
      priceCurrency: 'EUR',
      billingDuration: 'P1M'
    }
  ],
  softwareVersion: product.version,
  releaseNotes: 'Closed Alpha - Vollständige WEG-Verwaltung',
  description: description,
  url: 'https://waldheim.dev/silvacore',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  featureList: 'WEG-Verwaltung, DSGVO-konform, Nebenkostenabrechnung, Protokollverwaltung, Cloud-basiert'
};

const ogImage = 'https://waldheim.dev/silvacore/silvacore-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <section class='relative isolate pt-14 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark'>
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-emerald-500/20 to-sky-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
    
    <div class='max-w-7xl mx-auto py-24 sm:py-32'>
      <div class='text-center mb-16'>
        <div class='gsap-fadein mb-8' style='animation-delay: 0s'>
          <span class='inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-4 py-2 rounded-full text-sm font-bold shadow-sm'>
            <i class='fa-solid fa-flask' aria-hidden='true'></i>
            Aktuell in <span class="text-white opacity-90 font-black ml-1">Closed Alpha</span>
          </span>
        </div>

        <h1 class='gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-8' style='animation-delay: 0.15s'>
          Ihre <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>WEG-Verwaltung</span><br/>
          Professionell. Fair. Transparent.
        </h1>
        
        <p class='gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto mb-10 leading-relaxed' style='animation-delay: 0.3s'>
          Die moderne Cloud-Lösung für Wohnungseigentümergemeinschaften.<br/>
          Rechtssicher, DSGVO-konform und <strong class='text-meg-text-primary-dark'>made in Germany 🇩🇪</strong>
        </p>
        
        <!-- Trust Badges -->
        <div class='gsap-fadein flex flex-wrap items-center justify-center gap-6 text-sm text-meg-text-secondary mb-12' style='animation-delay: 0.45s'>
          <div class='flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl shadow-sm'>
            <i class='fa-solid fa-shield-check text-emerald-400' aria-hidden='true'></i>
            <span class="font-semibold">DSGVO-konform</span>
          </div>
          <div class='flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl shadow-sm'>
            <i class='fa-solid fa-flag text-emerald-400' aria-hidden='true'></i>
            <span class="font-semibold">Made in Germany</span>
          </div>
          <div class='flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl shadow-sm'>
            <i class='fa-solid fa-server text-emerald-400' aria-hidden='true'></i>
            <span class="font-semibold">99,9% Uptime</span>
          </div>
        </div>

        <div class='gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4 mb-10' style='animation-delay: 0.6s'>
          <a
            href='/silvacore/#pricing'
            class='w-full sm:w-auto group px-8 py-4 bg-emerald-600 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-emerald-500/20 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]'
          >
            <i class='fa-solid fa-rocket' aria-hidden='true'></i>
            Jetzt kostenlos starten
            <i class='fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform' aria-hidden='true'></i>
          </a>
          <a
            href='/silvacore/#features'
            class='w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-emerald-500/50 transition-all duration-300 inline-flex items-center justify-center gap-2'
          >
            Features entdecken
            <i class='fa-solid fa-arrow-down animate-bounce' aria-hidden='true'></i>
          </a>
        </div>
        
        <!-- SaaS vs Self-Hosted Hint -->
        <p class='gsap-fadein text-sm text-meg-text-secondary opacity-70 italic' style='animation-delay: 0.75s'>
          <i class='fa-solid fa-info-circle text-emerald-400 mr-1' aria-hidden='true'></i>
          Wählen Sie zwischen <strong class='text-meg-text-primary-dark'>managed SaaS</strong> (sofort loslegen) oder <strong class='text-meg-text-primary-dark'>self-hosted</strong> (volle Kontrolle)
        </p>
      </div>

      <div class='gsap-fadein relative max-w-5xl mx-auto mt-16 group' style='animation-delay: 0.9s'>
        <div class='absolute -inset-4 bg-gradient-to-r from-emerald-500/20 to-sky-500/20 rounded-2xl blur-2xl opacity-20 group-hover:opacity-40 transition duration-1000'></div>
        <Image
          src='/silvacore/silvacore_dashboard.webp'
          alt="Silvacore Dashboard Preview"
          width={2291}
          height={1304}
          class='relative z-10 rounded-2xl shadow-2xl border border-meg-border-dark w-full transition-transform duration-700 group-hover:scale-[1.01] bg-meg-surface-dark'
        />
      </div>
    </div>
  </section>
    
    <div class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]' aria-hidden='true'>
      <div
        class='relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-green-400/30 to-emerald-500/30 opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'>
      </div>
    </div>
  </section>

  <!-- Problem & Lösung Section -->
  <SilvaCoreProblem />

  <!-- Main Features Section -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-y border-meg-border-dark" id="features">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class='gsap-fadein' style='animation-delay: 0s'>
          <h2 class="text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
            <i class='fa-solid fa-building mr-2' aria-hidden='true'></i>
            Kernfunktionen
          </h2>
          <p class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6">
            <span class='text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-meg-accent'>Einfacher</span> geht's nicht!
          </p>
          <p class="text-xl text-meg-text-secondary mb-10 leading-relaxed">
            Silvacore ist ein praktisches Tool um Ihre Immobilien effizient und DSGVO-konform zu verwalten. Behalten Sie den Überblick.
          </p>
          
          <div class="space-y-6">
            {[
              { title: 'Stammdaten-Verwaltung', desc: 'Verwalten Sie Eigentümer, Mieter und Verträge zentral und übersichtlich.', icon: 'fa-users' },
              { title: 'Finanzen & Abrechnung', desc: 'Umfassende Übersicht über Einnahmen und Ausgaben sowie einfache Abrechnung.', icon: 'fa-chart-line' },
              { title: 'Privacy & Security', desc: 'Volle Erfüllung aller DSGVO-Anforderungen und sichere Datenverarbeitung.', icon: 'fa-lock' }
            ].map((item, i) => (
              <div class="gsap-fadein flex gap-4 bg-meg-surface-dark/50 backdrop-blur-md p-6 rounded-2xl border border-meg-border-dark shadow-sm group hover:border-emerald-500/30 transition-all" style={`animation-delay: ${0.15 + i * 0.15}s`}>
                <div class='flex-shrink-0 size-12 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform'>
                  <i class={`fa-solid ${item.icon} text-emerald-400 text-xl`}></i>
                </div>
                <div>
                  <h3 class="font-bold text-meg-text-primary-dark text-lg mb-1">{item.title}</h3>
                  <p class="text-meg-text-secondary text-sm leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <div class='gsap-fadein group' style='animation-delay: 0.6s'>
          <div class='relative'>
            <div class='absolute -inset-4 bg-gradient-to-r from-emerald-500/10 to-meg-accent/10 blur-3xl -z-10 group-hover:opacity-100 transition-opacity opacity-0'></div>
            <img
              src="/silvacore/silvacore_users.webp"
              alt="Silvacore Benutzerverwaltung"
              loading="lazy"
              class="rounded-2xl shadow-2xl border border-meg-border-dark w-full transition-transform duration-700 group-hover:scale-[1.01] bg-meg-surface-dark"
              width="2432"
              height="1442"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alle Features -->
  <SilvacoreFeatures />

  <!-- Screenshots & Einblicke -->
  <SilvacoreScreenshots />

  <!-- Product Roadmap - Zukünftige Killer-Features -->
  <SilvacoreRoadmap />

  <!-- Für wen ist Silvacore -->
  <SilvacoreAudience />

  <!-- Warum Silvacore - Vergleich -->
  <SilvacoreComparison />

  <!-- Technologie & Sicherheit -->
  <SilvacoreTech />

  <!-- Preise -->
  <PriceSilvacore />

  <!-- CTA / So starten Sie -->
  <SilvacoreCTA />
</Layout>
