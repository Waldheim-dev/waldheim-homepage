---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';
import PriceSilvacore from '../../components/PriceSilvacore.astro';
import SilvaCoreProblem from '../../components/SilvaCoreProblem.astro';
import SilvacoreFeatures from '../../components/SilvacoreFeatures.astro';
import SilvacoreAudience from '../../components/SilvacoreAudience.astro';
import SilvacoreTech from '../../components/SilvacoreTech.astro';
import SilvacoreCTA from '../../components/SilvacoreCTA.astro';
import SilvacoreComparison from '../../components/SilvacoreComparison.astro';
import SilvacoreScreenshots from '../../components/SilvacoreScreenshots.astro';
import SilvacoreRoadmap from '../../components/SilvacoreRoadmap.astro';

const product = getProductInfo('silvacore')!;

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([{
  name: 'Home',
  link: 'https://waldheim.dev'
},{
  name: 'Silvacore',
  link: 'https://waldheim.dev/silvacore'
}]);

const titel = "Silvacore: Professionelle WEG-Verwaltung | 1. WEG kostenlos | waldheim.dev";
const description = "Die moderne Cloud-Lösung für Wohnungseigentümergemeinschaften in Deutschland. Rechtssicher, DSGVO-konform und made in Germany. 1. WEG kostenlos, jede weitere nur 5 € / Monat.";
const keywords = "WEG-Verwaltung, Wohnungseigentümergemeinschaft, Hausverwaltung, DSGVO, Nebenkostenabrechnung, HKVO, Property Management, Immobilienverwaltung, Cloud-Verwaltung";

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: [
    {
      '@type': 'Offer',
      name: 'Starter (1 WEG)',
      price: '0',
      priceCurrency: 'EUR',
      billingDuration: 'P1M'
    },
    {
      '@type': 'Offer',
      name: 'Pro (unbegrenzt WEGs)',
      price: '5',
      priceCurrency: 'EUR',
      billingDuration: 'P1M'
    }
  ],
  softwareVersion: product.version,
  releaseNotes: 'Closed Alpha - Vollständige WEG-Verwaltung',
  description: description,
  url: 'https://waldheim.dev/silvacore',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  featureList: 'WEG-Verwaltung, DSGVO-konform, Nebenkostenabrechnung, Protokollverwaltung, Cloud-basiert'
};

const ogImage = 'https://waldheim.dev/silvacore/silvacore-og.jpg';
---
<Layout 
  title={titel} 
  description={description} 
  keywords={keywords} 
  schema={[softwareSchema, breadCrumbSchema]}
  image={ogImage}
>
  <!-- Hero Section -->
  <section class='relative isolate pt-14 pb-20 px-6 bg-gradient-to-b from-dark-950 via-dark-900 to-dark-950'>
    <div class='absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80' aria-hidden='true'>
      <div
        class='relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-green-400/30 to-emerald-500/30 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'></div>
    </div>
    
    <div class='max-w-7xl mx-auto py-24 sm:py-32'>
      <div class='text-center mb-16'>
        <div class='gsap-fadein mb-6' style='animation-delay: 0s'>
          <span class='inline-flex items-center gap-2 bg-green-500/10 border border-green-500/30 text-green-400 px-4 py-2 rounded-full text-sm font-semibold'>
            <i class='fa-solid fa-flask' aria-hidden='true'></i>
            Aktuell in Closed Alpha
          </span>
        </div>

        <h1 class='gsap-fadein text-5xl md:text-7xl font-bold text-white mb-6' style='animation-delay: 0.15s'>
          Ihre <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>WEG-Verwaltung</span><br/>
          Professionell. Fair. Transparent.
        </h1>
        
        <p class='gsap-fadein text-xl text-light-300 max-w-3xl mx-auto mb-8' style='animation-delay: 0.3s'>
          Die moderne Cloud-Lösung für Wohnungseigentümergemeinschaften in Deutschland.<br/>
          Rechtssicher, DSGVO-konform und <strong class='text-white'>made in Germany 🇩🇪</strong>
        </p>
        
        <!-- Trust Badges -->
        <div class='gsap-fadein flex flex-wrap items-center justify-center gap-6 text-sm text-light-300 mb-10' style='animation-delay: 0.45s'>
          <div class='flex items-center gap-2'>
            <i class='fa-solid fa-shield-check text-green-400' aria-hidden='true'></i>
            <span>DSGVO-konform</span>
          </div>
          <div class='flex items-center gap-2'>
            <i class='fa-solid fa-flag text-green-400' aria-hidden='true'></i>
            <span>Made in Germany</span>
          </div>
          <div class='flex items-center gap-2'>
            <i class='fa-solid fa-server text-green-400' aria-hidden='true'></i>
            <span>99,9% Uptime</span>
          </div>
        </div>

        <div class='gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4 mb-6' style='animation-delay: 0.6s'>
          <a
            href='/silvacore/#pricing'
            class='group px-8 py-4 bg-gradient-to-r from-green-400 to-emerald-500 text-dark-950 font-semibold text-lg rounded-lg hover:shadow-lg hover:shadow-green-400/50 transition-all duration-300 inline-flex items-center gap-2'
          >
            <i class='fa-solid fa-rocket' aria-hidden='true'></i>
            Jetzt kostenlos starten
            <i class='fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform' aria-hidden='true'></i>
          </a>
          <a
            href='/silvacore/#features'
            class='px-8 py-4 bg-light-500/10 text-white border border-light-500/30 rounded-lg font-semibold hover:bg-light-500/20 transition-all duration-300 inline-flex items-center gap-2'
          >
            Features entdecken
            <i class='fa-solid fa-arrow-down animate-bounce' aria-hidden='true'></i>
          </a>
        </div>
        
        <!-- SaaS vs Self-Hosted Hint -->
        <p class='gsap-fadein text-sm text-light-400' style='animation-delay: 0.75s'>
          <i class='fa-solid fa-info-circle text-green-400 mr-1' aria-hidden='true'></i>
          Wählen Sie zwischen <strong class='text-white'>managed SaaS</strong> (sofort loslegen) oder <strong class='text-white'>self-hosted</strong> (volle Kontrolle)
        </p>
      </div>

      <div class='gsap-fadein relative max-w-5xl mx-auto' style='animation-delay: 0.9s'>
        <div class='absolute inset-0 bg-gradient-to-r from-green-400/20 via-emerald-500/20 to-green-400/20 blur-3xl -z-10'></div>
        <Image
          src='/silvacore/silvacore_dashboard.png'
          alt="Silvacore Dashboard-Übersicht mit Statistiken zu WEGs, Finanzen und aktuellen Aufgaben. Zeigt eine moderne, benutzerfreundliche Oberfläche mit Echtzeitdaten."
          width={2291}
          height={1304}
          class='rounded-2xl shadow-2xl border border-light-500/20'
        />
      </div>
    </div>
    
    <div class='absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]' aria-hidden='true'>
      <div
        class='relative left-[calc(50%+3rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 bg-gradient-to-tr from-green-400/30 to-emerald-500/30 opacity-20 sm:left-[calc(50%+36rem)] sm:w-[72.1875rem]'
        style='clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)'>
      </div>
    </div>
  </section>

  <!-- Problem & Lösung Section -->
  <SilvaCoreProblem />

  <!-- Bestehende Features Section -->
  <section class="py-24 sm:py-32 px-6 bg-gradient-to-b from-dark-950 to-dark-900" id="features">
    <div class="max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class='gsap-fadein' style='animation-delay: 0s'>
          <h2 class="text-base font-semibold text-green-400 mb-4">
            <i class='fa-solid fa-building text-green-400 mr-2' aria-hidden='true'></i>
            WEG Verwaltung
          </h2>
          <p class="text-4xl md:text-5xl font-bold text-white mb-6">
            <span class='text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-500'>Einfacher</span> geht's nicht!
          </p>
          <p class="text-xl text-light-300 mb-10">
            Silvacore ist ein praktisches Tool um deine Immobilien effizient und DSGVO-konform zu verwalten. 
            Behalte den Überblick über Mieter, Verträge und Finanzen – alles an einem Ort.
          </p>
          
          <div class="space-y-6">
            <div class="gsap-fadein flex gap-4" style='animation-delay: 0.15s'>
              <div class='flex-shrink-0 w-12 h-12 bg-green-500/10 border border-green-500/30 rounded-lg flex items-center justify-center'>
                <i class="fa-solid fa-users text-green-400 text-xl"></i>
              </div>
              <div>
                <h3 class="font-semibold text-white text-lg mb-2">Eigentümer, Mieter & Verträge verwalten</h3>
                <p class="text-light-300">
                  Verwalte alle Daten deiner Eigentümer, Mieter und Verträge zentral und übersichtlich.
                </p>
              </div>
            </div>
            
            <div class="gsap-fadein flex gap-4" style='animation-delay: 0.3s'>
              <div class='flex-shrink-0 w-12 h-12 bg-green-500/10 border border-green-500/30 rounded-lg flex items-center justify-center'>
                <i class="fa-solid fa-chart-line text-green-400 text-xl"></i>
              </div>
              <div>
                <h3 class="font-semibold text-white text-lg mb-2">Finanzübersicht & Abrechnung</h3>
                <p class="text-light-300">
                  Behalte die Finanzen im Blick! Silvacore bietet eine umfassende Übersicht über Einnahmen und Ausgaben sowie eine einfache Abrechnung.
                </p>
              </div>
            </div>
            
            <div class="gsap-fadein flex gap-4" style='animation-delay: 0.45s'>
              <div class='flex-shrink-0 w-12 h-12 bg-green-500/10 border border-green-500/30 rounded-lg flex items-center justify-center'>
                <i class="fa-solid fa-lock text-green-400 text-xl"></i>
              </div>
              <div>
                <h3 class="font-semibold text-white text-lg mb-2">DSGVO-konform & sicher</h3>
                <p class="text-light-300">
                  Silvacore erfüllt alle Anforderungen der DSGVO und sorgt für eine sichere Speicherung und Verarbeitung deiner Daten.
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class='gsap-fadein' style='animation-delay: 0.6s'>
          <div class='relative'>
            <div class='absolute inset-0 bg-gradient-to-r from-green-400/20 to-emerald-500/20 blur-3xl -z-10'></div>
            <img
              src="/silvacore/silvacore_users.png"
              alt="Silvacore Benutzerverwaltung mit detaillierten Ansichten zu Eigentümern, Rechtevergabe und mandantenfähiger Zugriffskontrolle"
              loading="lazy"
              class="rounded-2xl shadow-2xl border border-light-500/20"
              width="2432"
              height="1442"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alle Features -->
  <SilvacoreFeatures />

  <!-- Screenshots & Einblicke -->
  <SilvacoreScreenshots />

  <!-- Product Roadmap - Zukünftige Killer-Features -->
  <SilvacoreRoadmap />

  <!-- Für wen ist Silvacore -->
  <SilvacoreAudience />

  <!-- Warum Silvacore - Vergleich -->
  <SilvacoreComparison />

  <!-- Technologie & Sicherheit -->
  <SilvacoreTech />

  <!-- Preise -->
  <PriceSilvacore />

  <!-- CTA / So starten Sie -->
  <SilvacoreCTA />
</Layout>
