---
import PromoServices from '../../../components/PromoServices.astro';
import InteractiveHeroCanvas from '../../../components/InteractiveHeroCanvas.astro';
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
  { name: 'Properties', link: 'https://waldheim.dev/suite/properties' },
]);

const titel = 'Properties – Schlanke WEG-Verwaltung mit Owner Portal | Waldheim Suite';
const description = 'Properties: Schlanke, cloud-basierte WEG-Verwaltung mit Owner Portal, Tickets, KI-gestuetzter Uebersetzung, automatisierten E-Mails sowie WEG-Abrechnung, Mahnwesen, Jahresabrechnung, Wirtschaftsplan und Ruecklagenkonto.';
const keywords = 'WEG Verwaltung Software, Owner Portal, Mahnwesen WEG, Jahresabrechnung WEG, Wirtschaftsplan, Ruecklagenkonto, Hausverwaltung Cloud, Properties, Waldheim Suite';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Waldheim Properties',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite/properties',
  author: { '@type': 'Organization', name: 'Waldheim.dev', url: 'https://waldheim.dev' },
};

const features = [
  { icon: 'fa-building', title: 'WEG-Basisdaten', description: 'Objekte, Einheiten und Eigentuemer digital pflegen. Jeder Datensatz bleibt tenant-sicher und revisionsfaehig im Cloud-Betrieb.' },
  { icon: 'fa-id-card', title: 'Owner Portal', description: 'Eigentuemer sehen Tickets, Dokumente, Zahlstatus und wichtige Beschluesse in einem Self-Service-Workspace statt per E-Mail-Pingpong.' },
  { icon: 'fa-ticket', title: 'Ticketing fuer Verwaltung', description: 'Anfragen, Maengel und Rueckfragen laufen ueber eine zentrale Queue mit Status, Prioritaet und nachvollziehbarer Historie.' },
  { icon: 'fa-file-invoice-dollar', title: 'WEG-Abrechnung', description: 'Hausgeld-Sollstellungen, offene Posten und Abrechnungslaeufe in einem durchgaengigen Prozess fuer den Verwalteralltag.' },
  { icon: 'fa-bell', title: 'Mahnwesen', description: 'Stufenbasierte Mahnlaeufe mit automatisierten Benachrichtigungen und klarer Nachverfolgung aller Forderungen.' },
  { icon: 'fa-calendar-days', title: 'Jahresabrechnung', description: 'Jahresabrechnungen je Objekt strukturiert erstellen, pruefen und fuer Eigentuemer bereitstellen.' },
  { icon: 'fa-chart-pie', title: 'Wirtschaftsplan', description: 'Planwerte, Kategorien und Verteilung je Wirtschaftsjahr transparent steuern und als Entscheidungsgrundlage aufbereiten.' },
  { icon: 'fa-piggy-bank', title: 'Ruecklagenkonto', description: 'Ruecklagenbewegungen, Salden und zweckgebundene Mittel pro Objekt nachvollziehbar verwalten.' },
  { icon: 'fa-language', title: 'KI-Uebersetzung', description: 'Kommunikation fuer internationale Eigentuemer automatisch in die passende Sprache uebertragen.' },
  { icon: 'fa-envelope-circle-check', title: 'Automatisierte E-Mails', description: 'Ereignisbasierte Mails fuer Faelligkeiten, Mahnungen, Beschluesse und Dokumentbereitstellung ohne manuelle Serienarbeit.' },
];

const problems = [
  { icon: 'fa-folder-open', text: 'Eigentuemerlisten, Hausgeld, Mahnungen und Beschluesse liegen verteilt in Excel, E-Mail und Papierordnern.' },
  { icon: 'fa-clock', text: 'Kleine Verwalterteams verlieren zu viel Zeit mit manuellen Rueckfragen, Uebersetzungen und wiederkehrenden Mailaufgaben.' },
  { icon: 'fa-eye-slash', text: 'Ohne Owner Portal und Ticketing fehlt Transparenz fuer Eigentuemer und Nachvollziehbarkeit fuer die Verwaltung.' },
];

const integrations = [
  { icon: 'fa-atom', label: 'Aether', desc: 'Beschluesse, Abrechnungen und Belege direkt am Objekt verknuepft', color: 'rose' },
  { icon: 'fa-coins', label: 'Treasury', desc: 'WEG-Abrechnung, Mahnwesen und Ruecklagen mit Finanzkontext', color: 'yellow' },
  { icon: 'fa-tower-broadcast', label: 'Relay', desc: 'Automatisierte, mehrsprachige E-Mails fuer Eigentuemerkommunikation', color: 'cyan' },
  { icon: 'fa-id-card', label: 'CustomerPortal', desc: 'Owner Portal fuer Self-Service, Tickets und Dokumentzugriff', color: 'sky' },
];
---

<Layout title={titel} description={description} keywords={keywords} schema={[softwareSchema, breadCrumbSchema]}>

  <nav class="pt-20 px-6 bg-meg-bg-dark" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-meg-text-secondary">
        <li><a href="/suite/" class="hover:text-meg-accent transition-colors font-semibold">Waldheim Suite</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li class="text-orange-400 font-bold">Properties</li>
      </ol>
    </div>
  </nav>

  <section class="relative isolate pt-6 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden">
    
    <!-- Three.js Interactive WebGL Background -->
    <InteractiveHeroCanvas particleColor="#f97316" lineColor="#f43f5e" />

    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-orange-500/20 to-amber-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    <div class="max-w-7xl mx-auto py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center gsap-fadein">
        <div class="gsap-fadein mb-4">
          <span class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-3 py-1.5 rounded-full text-xs font-bold">
            <i class="fa-solid fa-table-cells-large text-[10px]" aria-hidden="true"></i>
            Teil der Waldheim Suite
          </span>
        </div>
        <div class="gsap-fadein mb-6 flex flex-wrap justify-center gap-2" style="animation-delay: 0.1s">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/10 border border-orange-500/20 text-sm font-bold text-orange-400">
            <i class="fa-solid fa-building" aria-hidden="true"></i>
            v0.11.3 · Jetzt nutzbar
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-shield-halved text-orange-400" aria-hidden="true"></i>
            Rechtssicher & DSGVO-konform
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-flag text-orange-400" aria-hidden="true"></i>
            Made in Germany
          </span>
        </div>
        <h1 class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Immobilien verwalten.<br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-orange-400 to-amber-500">Nicht ertragen.</span>
        </h1>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed" style="animation-delay: 0.3s">
          Properties ist auf schlanke WEG-Verwaltung ausgelegt: wenig Administration, dafuer Cloud-Prozesse,
          Owner Portal, Ticketing, KI-Uebersetzung und automatisierte Kommunikation fuer internationale Eigentuemer.
        </p>
        <div class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.45s">
          <a href="https://suite.waldheim.dev" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto group px-8 py-4 bg-orange-500 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-orange-500/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]">
            <i class="fa-solid fa-building" aria-hidden="true"></i>
            Demo ausprobieren
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a href="/suite/" class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-orange-500/40 transition-all duration-300 inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Alle Module
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-meg-surface-dark border-b border-meg-border-dark">
    <div class="max-w-5xl mx-auto">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-red-400 mb-8 text-center">
        <i class="fa-solid fa-triangle-exclamation mr-2" aria-hidden="true"></i>
        Der Alltag ohne Properties
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {problems.map((p, i) => (
          <div class="gsap-fadein flex gap-4 bg-red-500/5 border border-red-500/20 rounded-2xl p-5" style={`animation-delay: ${i * 0.1}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <i class={`fa-solid ${p.icon} text-red-400`} aria-hidden="true"></i>
            </div>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="prop-dashboard">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-orange-400 mb-4">
            <i class="fa-solid fa-gauge-high mr-2" aria-hidden="true"></i>Portfolio-Dashboard
          </p>
          <h2 id="prop-dashboard" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
            Alle Objekte.<br />
            <span class="text-orange-400">Ein Überblick.</span>
          </h2>
          <p class="gsap-fadein text-lg text-meg-text-secondary mb-8 leading-relaxed" style="animation-delay: 0.3s">
            Properties aggregiert offene Tickets, Faelligkeiten, Mahnstatus, Ruecklagen und Jahreskennzahlen
            auf einem zentralen Dashboard und reduziert manuelle Verwaltungsarbeit spuerbar.
          </p>
          <ul class="space-y-3">
            {[
              'WEG-Abrechnung und Jahresabrechnung in einem durchgaengigen Ablauf',
              'Owner Portal mit Ticketing und Dokumentzugriff fuer Eigentuemer',
              'Mahnwesen mit regelbasierten Erinnerungen und Eskalationsstufen',
              'Wirtschaftsplan und Ruecklagenkonto transparent pro Objekt steuern',
            ].map((item) => (
              <li class="flex items-center gap-3 text-meg-text-secondary text-sm">
                <i class="fa-solid fa-check text-orange-400 text-xs" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="gsap-fadein" style="animation-delay: 0.2s">
          <div class="bg-meg-surface-dark/60 border border-orange-500/20 rounded-3xl p-6 shadow-2xl shadow-orange-500/5">
            <div class="flex items-center justify-between mb-5">
              <p class="text-sm font-bold text-meg-text-primary-dark">Properties · Portfolio</p>
              <span class="text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-circle text-[6px] animate-pulse" aria-hidden="true"></i>Live
              </span>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-5">
              {[
                { label: 'Objekte', value: '12', sub: '6 WEGs aktiv', color: 'orange' },
                { label: 'Offene Tickets', value: '9', sub: '2 mit hoher Prioritaet', color: 'amber' },
                { label: 'Offene Mahnungen', value: '4', sub: 'Stufe 1/2', color: 'red' },
                { label: 'Ruecklage', value: 'EUR 184k', sub: 'gesamt verfuegbar', color: 'green' },
              ].map((k) => (
                <div class={`bg-meg-bg-dark/60 border border-${k.color}-500/10 rounded-xl p-3`}>
                  <p class="text-[10px] text-meg-text-secondary mb-1">{k.label}</p>
                  <p class={`text-xl font-black text-${k.color}-400`}>{k.value}</p>
                  <p class="text-[10px] text-meg-text-secondary">{k.sub}</p>
                </div>
              ))}
            </div>
            <div class="space-y-2">
              {[
                { label: 'Jahresabrechnung 2025 fuer WEG Seebogen freigegeben', time: 'heute', color: 'orange' },
                { label: 'Ticket #1492: Aufzugstoerung, Dienstleister informiert', time: 'vor 2 Std', color: 'red' },
                { label: 'Automail: Mahnstufe 1 an 3 Eigentuemer gesendet', time: 'vor 30 Min', color: 'yellow' },
              ].map((e) => (
                <div class="flex items-center gap-3 text-xs">
                  <i class={`fa-solid fa-circle-dot text-${e.color}-400`} aria-hidden="true"></i>
                  <span class="text-meg-text-secondary flex-1">{e.label}</span>
                  <span class="text-meg-text-secondary shrink-0">{e.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6 bg-meg-surface-dark border-b border-meg-border-dark" aria-labelledby="prop-features">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-orange-400 mb-4">
          <i class="fa-solid fa-list-check mr-2" aria-hidden="true"></i>Was Properties kann
        </p>
        <h2 id="prop-features" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">Vom Vertrag bis zur Abrechnung.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {features.map((feat, i) => (
          <div class="gsap-fadein bg-meg-bg-dark/50 border border-meg-border-dark rounded-2xl p-5 hover:border-orange-500/40 hover:shadow-lg hover:shadow-orange-500/10 transition-all group" style={`animation-delay: ${i * 0.07}s`}>
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-orange-500/10 border border-orange-500/20 mb-4 group-hover:bg-orange-500/20 transition-colors">
              <i class={`fa-solid ${feat.icon} text-orange-400 text-lg`} aria-hidden="true"></i>
            </div>
            <h3 class="text-base font-bold text-meg-text-primary-dark mb-2">{feat.title}</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="prop-integrations">
    <div class="max-w-5xl mx-auto text-center">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-orange-400 mb-4">
        <i class="fa-solid fa-plug mr-2" aria-hidden="true"></i>Nahtlos integriert
      </p>
      <h2 id="prop-integrations" class="gsap-fadein text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.1s">
        Properties ist keine Insel.
      </h2>
      <p class="gsap-fadein text-meg-text-secondary mb-12 max-w-2xl mx-auto" style="animation-delay: 0.2s">Verträge in Aether, Finanzen in Treasury, Mieter-Kommunikation über Relay – alles verbunden.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integrations.map((int, i) => (
          <div class={`gsap-fadein bg-meg-surface-dark/50 border border-${int.color}-500/20 rounded-2xl p-5 text-left`} style={`animation-delay: ${i * 0.1}s`}>
            <div class={`inline-flex items-center justify-center w-10 h-10 rounded-xl bg-${int.color}-500/10 border border-${int.color}-500/20 mb-4`}>
              <i class={`fa-solid ${int.icon} text-${int.color}-400`} aria-hidden="true"></i>
            </div>
            <p class={`font-bold text-sm text-${int.color}-400 mb-1`}>{int.label}</p>
            <p class="text-xs text-meg-text-secondary leading-relaxed">{int.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Custom Consulting & Development Promotion -->
  <PromoServices />

  <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="cta-prop">
    <div class="max-w-4xl mx-auto text-center">
      <div class="gsap-fadein relative group">
        <div class="absolute -inset-0.5 bg-linear-to-r from-orange-500/20 to-amber-500/20 rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-700" aria-hidden="true"></div>
        <div class="relative bg-meg-surface-dark/60 border border-orange-500/20 rounded-3xl p-12">
          <i class="fa-solid fa-building text-4xl text-orange-400 mb-6" aria-hidden="true"></i>
          <h2 id="cta-prop" class="text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4">Zettelwirtschaft war gestern.</h2>
          <p class="text-xl text-meg-text-secondary mb-8 max-w-xl mx-auto">Nutzen Sie Properties ab sofort in der Waldheim Suite – inkl. Haupt-/Unterzähler-Kaskade, Owner Portal und druckbarer Jahresabrechnung.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://suite.waldheim.dev" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-orange-500 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-orange-500/30 transition-all duration-300 hover:scale-[1.02]">
              <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>Zur Demo
            </a>
            <a href="/suite/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-orange-500/40 transition-all">
              Alle Module ansehen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
