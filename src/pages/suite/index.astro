---
import ROICalculator from '../../components/ROICalculator.astro';
import InteractiveHeroCanvas from '../../components/InteractiveHeroCanvas.astro';
import Layout from '../../layouts/Layout.astro';
import PromoServices from '../../components/PromoServices.astro';

import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';

const suite = getProductInfo('suite')!;

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
]);

// SEO & Meta
const titel = 'Waldheim Suite | Modulare ERP- & CRM-Suite für den Mittelstand';
const description =
  'Modulare Business-Suite für den DACH-Mittelstand: Portal, CRM, ERP, DMS, Ecodrive & Treasury in einer Plattform. DSGVO-konform & E-Rechnung-ready.';
const keywords =
  'Business Software Suite Deutschland, E-Rechnungspflicht 2025 Software, ERP CRM integriert, Cloud-Native Business Apps, ZUGFeRD Rechnungssoftware, Mittelstand SaaS';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Waldheim Suite',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite',
  author: {
    '@type': 'Organization',
    name: 'Waldheim.dev',
    url: 'https://waldheim.dev',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/OnlineOnly',
  },
};

const modules = [
  {
    href: '/suite/portal/',
    icon: 'fa-id-card',
    color: 'sky',
    title: 'Customer Portal',
    subtitle: 'Identität, Billing & Self-Service',
    description:
      'Zentrales Owner- und Kundenportal mit SSO, In-App-Ticket-System & Antwort-Flows, Rechnungsverwaltung, Abo-Steuerung und Self-Service.',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/socialverse/',
    icon: 'fa-users-gear',
    color: 'violet',
    title: 'Socialverse CRM',
    subtitle: 'Pipeline, Deals & Kontakte',
    description:
      'Professionelles CRM mit Deal-Pipeline, Custom Fields, Kontakt-Aktivitäten-Timeline, Kampagnen, Revenue-Workflows und KPI-Dashboard.',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/forge/',
    icon: 'fa-building-columns',
    color: 'green',
    title: 'Silvacore ERP',
    subtitle: 'Produkte, Angebote & E-Rechnung',
    description:
      'ERP mit Produktkatalog, Angeboten (1-Klick-Rechnungskonvertierung), Multi-Line Invoice Composer sowie XRechnung 3.0 & ZUGFeRD PDF/A-3b.',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/aether/',
    icon: 'fa-atom',
    color: 'rose',
    title: 'Aether',
    subtitle: 'Dokumente, Assets & Wissen',
    description:
      'Zentrales Dokumentenmanagement mit geschützter Ordnerhierarchie, Explorer-Ansicht, XRechnung-Belegarchiv und verknüpften Wissensobjekten.',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/ecodrive/',
    icon: 'fa-leaf',
    color: 'emerald',
    title: 'Ecodrive',
    subtitle: 'Flotten, TCO & CO₂',
    description:
      'Intelligentes Flottenmanagement mit Fahrzeugakte, Fahrtenbuch, bidirektionalem Odometer-Rechner, TCO-/Ersatzanalyse und ESG-Kennzahlen.',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/treasury/',
    icon: 'fa-coins',
    color: 'yellow',
    title: 'Treasury',
    subtitle: 'Finanzen, Bankimport & DATEV',
    description:
      'Liquiditätsvorschau, Kostenstellen-Budgets, CAMT.053-/CSV-Bankimport mit Duplikatschutz, Mahnwesen und DATEV-Buchungsstapel-Export (EXTF 700).',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/properties/',
    icon: 'fa-building',
    color: 'orange',
    title: 'Properties',
    subtitle: 'WEG-Verwaltung & Zählerkaskade',
    description:
      'Objekte, Einheiten, Haupt-/Unterzähler-Kaskade, Owner Portal, WEG-Abrechnung, druckbare Jahresabrechnung (PDF), Wirtschaftsplan und Rücklagen.',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/relay/',
    icon: 'fa-tower-broadcast',
    color: 'cyan',
    title: 'Relay',
    subtitle: 'Tasks, Boards & Multi-Channel',
    description:
      'Aufgaben-, Subtask-, Zeiterfassungs- und Board-Management kombiniert mit gebrandetem SMTP-TLS-Versand, Push und In-App-Notifications.',
    badge: 'Jetzt nutzbar',
  },
  {
    href: '/suite/conductor/',
    icon: 'fa-gears',
    color: 'indigo',
    title: 'Conductor',
    subtitle: 'Workflows & Automatisierung',
    description:
      'Visueller Workflow-Builder, Template-Management und Event-Trigger für prozessübergreifende Automatisierungen über alle Suite-Module.',
    badge: 'Release Candidate',
  },
];

const includedFeatures = [
  'Alle 9 Suite-Module inklusive',
  'Unbegrenzte Mandanten-Isolation',
  'Single Sign-On & App Switcher',
  'Owner Portal & Ticketing',
  'DSGVO-konform (Server in DE)',
  'E-Rechnung (XRechnung / ZUGFeRD)',
  'Audit-Log & Rollenverwaltung',
];

const faqItems = [
  {
    question: 'Was ist in einem Seat enthalten?',
    answer:
      'Ein Seat gibt einem Benutzer vollen Zugang zu allen 9 Modulen der Suite (Portal, CRM, ERP, Aether, Ecodrive, Treasury, Properties, Relay, Conductor). Module sind nicht einzeln buchbar – die Suite kommt als vollständiges Paket.',
  },
  {
    question: 'Wie funktioniert die Mandantentrennung?',
    answer:
      'Jede Organisation erhält einen eigenen, vollständig isolierten Tenant. Ihre Daten sind strikt von denen anderer Kunden getrennt – technisch auf Datenbankebene und organisatorisch.',
  },
  {
    question: 'Unterstützt die Suite die E-Rechnungspflicht?',
    answer:
      'Ja. Forge ERP erzeugt XRechnung (EN 16931-konform) und ZUGFeRD PDF/A-3b Hybrid-Rechnungen direkt aus der Auftragsverwaltung – ohne Zusatzkosten.',
  },
  {
    question: 'Wo werden die Daten gespeichert?',
    answer:
      'Alle Server stehen in Deutschland in DSGVO-konformen Rechenzentren. Backups, Verschlüsselung in transit und at rest sind standardmäßig aktiviert.',
  },
  {
    question: 'Kann ich monatlich kündigen?',
    answer:
      'Ja. Abonnements laufen monatlich über Stripe und können jederzeit zum Ende des Abrechnungszeitraums gekündigt werden. Es gibt keine Mindestlaufzeit.',
  },
  {
    question: 'Wie läuft die Migration bestehender Daten ab?',
    answer:
      'Wir bieten strukturierte Migrations-Rezepte für gängige Systeme. Für größere Umgebungen führen wir ein Migration Assessment durch und begleiten den Rollout.',
  },
];

const integrationItems = [
  {
    icon: 'fa-solid fa-file-invoice',
    label: 'XRechnung / ZUGFeRD',
    desc: 'E-Rechnungspflicht ab 2025',
  },
  {
    icon: 'fa-brands fa-stripe-s',
    label: 'Stripe Billing',
    desc: 'Abonnements & Zahlungen',
  },
  {
    icon: 'fa-brands fa-google',
    label: 'Google Calendar',
    desc: 'Kalender-Sync via OAuth',
  },
  {
    icon: 'fa-brands fa-microsoft',
    label: 'Microsoft 365',
    desc: 'Calendar & Mail-Integration',
  },
  {
    icon: 'fa-brands fa-facebook',
    label: 'Facebook Pages',
    desc: 'Social Posting & Analytics',
  },
  {
    icon: 'fa-brands fa-linkedin',
    label: 'LinkedIn',
    desc: 'Kampagnen & Lead-Gen',
  },
  {
    icon: 'fa-brands fa-instagram',
    label: 'Instagram',
    desc: 'Content & Reichweite',
  },
  {
    icon: 'fa-solid fa-bell',
    label: 'Web Push',
    desc: 'Browser-Benachrichtigungen',
  },
  { icon: 'fa-solid fa-code', label: 'REST API', desc: 'Offene Schnittstelle' },
  {
    icon: 'fa-solid fa-book',
    label: 'API-Docs',
    desc: 'OpenAPI Spec verfügbar',
  },
  {
    icon: 'fa-solid fa-link',
    label: 'Webhooks',
    desc: 'Event-basierte Integration',
  },
];

const complianceItems = [
  {
    icon: 'fa-file-invoice',
    label: 'XRechnung / EN 16931',
    desc: 'E-Rechnungspflicht ab 2025 erfüllt',
  },
  {
    icon: 'fa-shield-halved',
    label: 'DSGVO-konform',
    desc: 'Server in Deutschland, Auftragsverarbeitung',
  },
  {
    icon: 'fa-clipboard-list',
    label: 'Audit Trail',
    desc: 'Vollständige Nachvollziehbarkeit aller Aktionen',
  },
  {
    icon: 'fa-lock',
    label: 'Tenant-Isolation',
    desc: 'Vollständige Datentrennung auf DB-Ebene',
  },
  {
    icon: 'fa-key',
    label: 'MFA & SSO',
    desc: 'TOTP-MFA, sichere Session-Verwaltung',
  },
  {
    icon: 'fa-chart-bar',
    label: 'Reporting & KPIs',
    desc: 'Cross-Suite Kennzahlen auf einem Blick',
  },
];
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[softwareSchema, breadCrumbSchema]}
>
  <!-- Hero Section -->
  <section
    class="relative isolate pt-14 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden"
  >
    <!-- Three.js Interactive WebGL Background -->
    <InteractiveHeroCanvas particleColor="#0ea5e9" lineColor="#6366f1" />

    <div
      class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
      aria-hidden="true"
    >
      <div
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-sky-500/25 to-indigo-500/25 opacity-40 sm:left-[calc(50%-30rem)] sm:w-288.75"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      >
      </div>
    </div>

    <div class="max-w-7xl mx-auto py-24 sm:py-32">
      <div class="text-center">
        <div class="gsap-fadein mb-8 flex flex-wrap justify-center gap-3">
          <span
            class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 px-4 py-2 rounded-full text-sm font-bold shadow-sm"
          >
            <i
              class="fa-solid fa-circle text-[6px] animate-pulse"
              aria-hidden="true"></i>
            v{suite.version} · Release Candidate · Jetzt live nutzbar
          </span>
          <span
            class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-4 py-2 rounded-full text-sm font-bold shadow-sm"
          >
            <i class="fa-solid fa-rocket text-xs" aria-hidden="true"></i>
            Kurz vor v1.0 Stable
          </span>
        </div>

        <h1
          class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-8"
          style="animation-delay: 0.15s"
        >
          Eine Suite statt<br />
          Nur noch <span
            class="text-transparent bg-clip-text bg-linear-to-r from-meg-accent to-sky-400"
            >eine Plattform</span
          >.
        </h1>

        <p
          class="gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto mb-10 leading-relaxed"
          style="animation-delay: 0.3s"
        >
          Die Waldheim Suite vereint CRM, ERP und Flottenmanagement in einer
          nahtlosen SaaS-Lösung. Vollständig <strong
            class="text-meg-text-primary-dark">DSGVO-konform</strong
          >, bereit für die <strong class="text-meg-text-primary-dark"
            >XRechnung</strong
          > und optimiert für den deutschen Mittelstand.
        </p>

        <div
          class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4 mb-12"
          style="animation-delay: 0.45s"
        >
          <a
            href="https://suite.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto group px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            Zur Demo
            <i
              class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"
              aria-hidden="true"></i>
          </a>
          <a
            href="/suite/preise/"
            class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-tag" aria-hidden="true"></i>
            Preise ansehen
          </a>
        </div>

        <div
          class="gsap-fadein flex flex-wrap items-center justify-center gap-6 text-sm text-meg-text-secondary"
          style="animation-delay: 0.6s"
        >
          <div
            class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl"
          >
            <i
              class="fa-solid fa-shield-halved text-meg-accent"
              aria-hidden="true"></i>
            <span class="font-semibold">DSGVO-konform</span>
          </div>
          <div
            class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl"
          >
            <i class="fa-solid fa-flag text-meg-accent" aria-hidden="true"></i>
            <span class="font-semibold">Server in Deutschland</span>
          </div>
          <div
            class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl"
          >
            <i class="fa-solid fa-key text-meg-accent" aria-hidden="true"></i>
            <span class="font-semibold">Single Sign-On</span>
          </div>
          <div
            class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl"
          >
            <i class="fa-solid fa-cubes text-meg-accent" aria-hidden="true"></i>
            <span class="font-semibold">9 Module</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem-Solution Section -->
  <section
    class="py-24 sm:py-32 px-6 bg-meg-surface-dark border-b border-meg-border-dark"
    aria-labelledby="problem-heading"
  >
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p
          class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4"
        >
          <i class="fa-solid fa-triangle-exclamation mr-2" aria-hidden="true"
          ></i>
          Das Problem
        </p>
        <h2
          id="problem-heading"
          class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4"
          style="animation-delay: 0.15s"
        >
          Tool-Flickenteppich kostet Zeit und Geld.
        </h2>
        <p
          class="gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto"
          style="animation-delay: 0.3s"
        >
          Viele Mittelständler nutzen 5–10 isolierte Tools: CRM hier, ERP dort,
          Faktura woanders. Die Folge: Datendopplung, manuelle Übertragungen,
          fehlende Transparenz.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
        {
          [
            {
              icon: 'fa-puzzle-piece',
              label: 'Isolierte Insellösungen',
              desc: 'CRM, ERP, Billing, HR – jedes Tool lebt sein eigenes Leben. Keine gemeinsame Datenbasis, kein durchgängiger Prozess.',
            },
            {
              icon: 'fa-arrows-spin',
              label: 'Manuelle Datenübertragung',
              desc: 'Kontakte in Excel exportieren, in das nächste System importieren, Fehler bereinigen – täglich. Das kostet Stunden, die fehlen.',
            },
            {
              icon: 'fa-eye-slash',
              label: 'Kein Gesamtüberblick',
              desc: 'Wer möchte wissen, wie profitabel ein Kunde wirklich ist? Das erfordert heute 4 verschiedene Systeme und ein Tabellenkalkulierblatt.',
            },
          ].map((p, i) => (
            <div
              class={`gsap-fadein bg-red-500/5 border border-red-500/20 rounded-2xl p-6`}
              style={`animation-delay: ${i * 0.1}s`}
            >
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 mb-4">
                <i
                  class={`fa-solid ${p.icon} text-red-400 text-xl`}
                  aria-hidden="true"
                />
              </div>
              <h3 class="text-meg-text-primary-dark font-bold mb-2">
                {p.label}
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed">
                {p.desc}
              </p>
            </div>
          ))
        }
      </div>
      <div class="flex justify-center mb-8">
        <div class="flex items-center gap-4">
          <div class="w-16 h-px bg-meg-border-dark"></div>
          <div
            class="bg-meg-accent/10 border border-meg-accent/20 rounded-full p-3"
          >
            <i
              class="fa-solid fa-arrow-down text-meg-accent text-xl"
              aria-hidden="true"></i>
          </div>
          <div class="w-16 h-px bg-meg-border-dark"></div>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          [
            {
              icon: 'fa-layer-group',
              label: 'Eine Plattform, alle Prozesse',
              desc: 'CRM, ERP, Dokumente, Billing, Flotte und Support in einer Suite. Gleiche Datenbasis, nahtlose Übergaben zwischen Modulen.',
            },
            {
              icon: 'fa-bolt',
              label: 'Echtzeitdaten, kein Sync-Aufwand',
              desc: 'Ein Auftrag in ERP erzeugt automatisch einen Kontext in CRM. Kein Export, kein Import, kein Tabellenchaos – direkt verfügbar.',
            },
            {
              icon: 'fa-chart-line',
              label: 'Cross-Suite KPIs auf einen Blick',
              desc: 'Revenue pro Kunde, Support-Aufwand, Projektprofitabilität – alles live im Dashboard, ohne BI-Tool dazwischen.',
            },
          ].map((s, i) => (
            <div
              class={`gsap-fadein bg-meg-accent/5 border border-meg-accent/20 rounded-2xl p-6`}
              style={`animation-delay: ${i * 0.1}s`}
            >
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-meg-accent/10 border border-meg-accent/20 mb-4">
                <i
                  class={`fa-solid ${s.icon} text-meg-accent text-xl`}
                  aria-hidden="true"
                />
              </div>
              <h3 class="text-meg-text-primary-dark font-bold mb-2">
                {s.label}
              </h3>
              <p class="text-meg-text-secondary text-sm leading-relaxed">
                {s.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- App Shell & App Switch Section -->
  <section
    class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-b border-meg-border-dark"
    aria-labelledby="appshell-heading"
  >
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p
            class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4"
          >
            <i class="fa-solid fa-table-cells-large mr-2" aria-hidden="true"
            ></i>
            App Shell & App Switch
          </p>
          <h2
            id="appshell-heading"
            class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6"
            style="animation-delay: 0.15s"
          >
            Eine Shell.<br />Alle Module.<br />Ein Login.
          </h2>
          <p
            class="gsap-fadein text-lg text-meg-text-secondary mb-8 leading-relaxed"
            style="animation-delay: 0.3s"
          >
            Die zentrale App Shell ist das Herzstück der Waldheim Suite. Sie
            verbindet alle Module über einen gemeinsamen Navigationsrahmen – mit
            blitzschnellem App Switcher, Tenant-Wechsel und globalem Command
            Palette.
          </p>
          <ul class="space-y-4">
            {
              [
                {
                  icon: 'fa-table-cells-large',
                  label: 'App Switcher',
                  desc: 'Sofortiger Wechsel zwischen allen Modulen ohne Reload',
                },
                {
                  icon: 'fa-building',
                  label: 'Tenant-Wechsel',
                  desc: 'Mehrere Organisationen in einer Session verwalten',
                },
                {
                  icon: 'fa-magnifying-glass',
                  label: 'Command Palette',
                  desc: 'Globale Suche und Navigation per Tastatur (⌘K)',
                },
                {
                  icon: 'fa-bell',
                  label: 'Unified Notifications',
                  desc: 'Benachrichtigungen aus allen Modulen zentral gebündelt',
                },
              ].map((f, i) => (
                <li
                  class={`gsap-fadein flex items-start gap-4`}
                  style={`animation-delay: ${i * 0.1}s`}
                >
                  <div class="shrink-0 w-10 h-10 rounded-xl bg-meg-accent/10 border border-meg-accent/20 flex items-center justify-center">
                    <i
                      class={`fa-solid ${f.icon} text-meg-accent text-sm`}
                      aria-hidden="true"
                    />
                  </div>
                  <div>
                    <p class="text-meg-text-primary-dark font-bold text-sm">
                      {f.label}
                    </p>
                    <p class="text-meg-text-secondary text-sm">{f.desc}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="gsap-fadein" style="animation-delay: 0.2s">
          <div
            class="bg-meg-surface-dark/60 border border-meg-border-dark rounded-3xl p-6 shadow-2xl"
          >
            <div
              class="flex items-center gap-3 mb-4 pb-4 border-b border-meg-border-dark"
            >
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
              </div>
              <div
                class="flex-1 bg-meg-bg-dark/60 rounded-lg px-4 py-1.5 text-xs text-meg-text-secondary"
              >
                suite.waldheim.dev
              </div>
              <div class="flex items-center gap-2">
                <div
