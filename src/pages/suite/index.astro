---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import { getProductInfo } from '../../consts/productColors';

const suite = getProductInfo('suite')!;

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
]);

const titel = 'Waldheim Suite – Die integrierte Business-Suite | Waldheim.dev';
const description =
  'Die Waldheim Suite: Socialverse CRM, Forge ERP, Aether Dokumentenmanagement, Ecodrive Flottenmanagement und Customer Portal – vereint in einer integrierten SaaS-Plattform mit Single Sign-On und App Switcher.';
const keywords =
  'Waldheim Suite, Business Suite, ERP, CRM, Flottenmanagement, Dokumentenmanagement, Forge, Socialverse, Ecodrive, Aether, SaaS, Enterprise, Single Sign-On, Multi-Tenant';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Waldheim Suite',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev',
  },
};

const modules = [
  {
    href: '/suite/socialverse/',
    icon: 'fa-users-gear',
    color: 'violet',
    title: 'Socialverse CRM',
    subtitle: 'Pipeline, Deals & Kontakte',
    description: 'Professionelles CRM mit Deal-Pipeline, Kontaktmanagement, Kampagnen, Revenue-Workflows und KPI-Dashboard für Ihren Vertrieb.',
    badge: 'Beta',
  },
  {
    href: '/suite/forge/',
    icon: 'fa-hammer',
    color: 'amber',
    title: 'Forge ERP',
    subtitle: 'Produkte, Projekte & Aufträge',
    description: 'Enterprise-Ressourcenplanung mit Produktkatalog, Projektmanagement, Zeiterfassung, Angeboten und Auftragsabwicklung.',
    badge: 'Beta',
  },
  {
    href: '/suite/aether/',
    icon: 'fa-folder-open',
    color: 'rose',
    title: 'Aether',
    subtitle: 'Dokumente, Assets & Wissen',
    description: 'Zentrales Dokumentenmanagement mit Ordnerstruktur, Explorer-Ansicht, XRechnung-Export und verknüpften Wissensobjekten.',
    badge: 'Beta',
  },
  {
    href: '/suite/ecodrive/',
    icon: 'fa-car-side',
    color: 'teal',
    title: 'Ecodrive',
    subtitle: 'Flotten, Routen & CO₂',
    description: 'Intelligentes Flottenmanagement mit Fahrzeugverwaltung, Routenplanung, GPS-Tracking, CO₂-Reporting und ESG-Kennzahlen.',
    badge: 'Beta',
  },
  {
    href: '/suite/portal/',
    icon: 'fa-headset',
    color: 'emerald',
    title: 'Customer Portal',
    subtitle: 'Tickets, Rechnungen & Support',
    description: 'Self-Service-Portal für Kunden: Ticket-System, Rechnungsverwaltung, Abo-Verwaltung, Stripe-Integration und Support-Queue.',
    badge: 'Live',
  },
  {
    href: '/suite/nexus/',
    icon: 'fa-shield-halved',
    color: 'indigo',
    title: 'Nexus Admin',
    subtitle: 'Tenants, Audit & Plattform',
    description: 'Super-Admin-Konsole für Tenant-Management, Audit Trail, Plattform-KPIs, Revenue-Übersicht und Benutzer-Administration.',
    badge: 'Live',
  },
];

const pricingFeatures = [
  'Socialverse CRM · Kampagnen · Segmente · Workflows',
  'Forge ERP · Projekte · Zeiterfassung · XRechnung / EN 16931',
  'Aether Dokumente & Asset-Management',
  'Ecodrive Fuhrpark · GPS-Tracking · CO₂',
  'Customer Portal · Support-Tickets · Stripe Billing',
  'Nexus Admin · Audit Trail · MFA + SSO · DSGVO',
];

const pricingExamples = [
  { seats: 5, label: 'Starter', total: 245 },
  { seats: 10, label: 'Team', total: 490 },
  { seats: 20, label: 'Scale', total: 980 },
];

const usps = [
  {
    icon: 'fa-key',
    title: 'Single Sign-On',
    description: 'Ein Login für alle Module. Keine separaten Accounts, keine Reibungsverluste – einmal authentifiziert, überall Zugriff.',
  },
  {
    icon: 'fa-building-lock',
    title: 'Multi-Tenant',
    description: 'Vollständige Mandantentrennung auf Datenbankebene. Ihre Daten bleiben sicher isoliert von anderen Organisationen.',
  },
  {
    icon: 'fa-grid-2',
    title: 'App Switcher',
    description: 'Blitzschnell zwischen allen Modulen wechseln – direkt aus der App-Shell ohne Reload und ohne erneuten Login.',
  },
];

const techStack = [
  { icon: 'fa-atom', label: 'React 19', desc: 'Modernste UI-Architektur' },
  { icon: 'fa-wand-magic-sparkles', label: 'Framer Motion', desc: 'Flüssige Animationen' },
  { icon: 'fa-server', label: 'Go API', desc: 'Hochperformantes Backend' },
  { icon: 'fa-shield-check', label: 'DSGVO', desc: 'Server in Deutschland' },
  { icon: 'fa-palette', label: 'waldheim-ui', desc: 'Eigenes Design System' },
];

const complianceItems = [
  { icon: 'fa-file-invoice', label: 'XRechnung / EN 16931', desc: 'E-Rechnungspflicht ab 2025 erfüllt' },
  { icon: 'fa-shield-halved', label: 'DSGVO-konform', desc: 'Server in Deutschland, Auftragsverarbeitung' },
  { icon: 'fa-clipboard-list', label: 'Audit Trail', desc: 'Vollständige Nachvollziehbarkeit aller Aktionen' },
  { icon: 'fa-lock', label: 'Tenant-Isolation', desc: 'Vollständige Datentrennung auf DB-Ebene' },
  { icon: 'fa-key', label: 'MFA & SSO', desc: 'TOTP-MFA, sichere Session-Verwaltung' },
  { icon: 'fa-chart-bar', label: 'Reporting & KPIs', desc: 'Cross-Suite Kennzahlen auf einem Blick' },
];
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[softwareSchema, breadCrumbSchema]}
>
  <!-- Hero Section -->
  <section class="relative isolate pt-14 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
      <div
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-sky-500/25 to-indigo-500/25 opacity-40 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      ></div>
    </div>

    <div class="max-w-7xl mx-auto py-24 sm:py-32">
      <div class="text-center">
        <div class="gsap-fadein mb-8">
          <span class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-4 py-2 rounded-full text-sm font-bold shadow-sm">
            <i class="fa-solid fa-circle text-[6px] animate-pulse" aria-hidden="true"></i>
            Early Access
          </span>
        </div>

        <h1 class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Die integrierte<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-cyan-400">Business-Suite</span>
        </h1>

        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-3xl mx-auto mb-10 leading-relaxed" style="animation-delay: 0.3s">
          CRM, ERP, Dokumentenmanagement, Flottenmanagement und Kundenportal – alle verbunden durch
          <strong class="text-meg-text-primary-dark">Single Sign-On</strong>, Multi-Tenant-Architektur und
          einen blitzschnellen <strong class="text-meg-text-primary-dark">App Switcher</strong>.
        </p>

        <div class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4 mb-12" style="animation-delay: 0.45s">
          <a
            href="https://portal.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto group px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-grid-2" aria-hidden="true"></i>
            Zum Kundenportal
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a
            href="/kontakt/"
            class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 backdrop-blur-md border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:bg-meg-surface-dark hover:border-meg-accent/50 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            Frühen Zugang anfragen
          </a>
        </div>

        <div class="gsap-fadein flex flex-wrap items-center justify-center gap-6 text-sm text-meg-text-secondary" style="animation-delay: 0.6s">
          <div class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl">
            <i class="fa-solid fa-shield-check text-meg-accent" aria-hidden="true"></i>
            <span class="font-semibold">DSGVO-konform</span>
          </div>
          <div class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl">
            <i class="fa-solid fa-flag text-meg-accent" aria-hidden="true"></i>
            <span class="font-semibold">Server in Deutschland</span>
          </div>
          <div class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl">
            <i class="fa-solid fa-key text-meg-accent" aria-hidden="true"></i>
            <span class="font-semibold">Single Sign-On</span>
          </div>
          <div class="flex items-center gap-2 bg-meg-surface-dark/50 border border-meg-border-dark px-4 py-2 rounded-xl">
            <i class="fa-solid fa-cubes text-meg-accent" aria-hidden="true"></i>
            <span class="font-semibold">6+ Module</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Module Grid -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="modules-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          <i class="fa-solid fa-cubes mr-2" aria-hidden="true"></i>
          Die Module
        </p>
        <h2 id="modules-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.15s">
          Alles, was Ihr Business braucht
        </h2>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto" style="animation-delay: 0.3s">
          Modular einsetzbar, nahtlos integriert. Starten Sie mit einem Modul und erweitern Sie jederzeit.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {modules.map((mod, i) => (
          <a
            href={mod.href}
            class={`gsap-fadein group relative bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-border-dark rounded-2xl p-6 hover:border-${mod.color}-500/40 hover:shadow-lg hover:shadow-${mod.color}-500/10 transition-all duration-300`}
            style={`animation-delay: ${i * 0.1}s`}
          >
            <div class={`inline-flex items-center justify-center w-12 h-12 rounded-xl bg-${mod.color}-500/10 border border-${mod.color}-500/20 mb-4`}>
              <i class={`fa-solid ${mod.icon} text-${mod.color}-400 text-xl`} aria-hidden="true"></i>
            </div>
            <div class="flex items-start justify-between mb-2">
              <div>
                <h3 class="text-lg font-bold text-meg-text-primary-dark">{mod.title}</h3>
                <p class={`text-sm text-${mod.color}-400 font-semibold`}>{mod.subtitle}</p>
              </div>
              <span class={`text-xs font-bold px-2 py-1 rounded-lg bg-${mod.color}-500/10 border border-${mod.color}-500/20 text-${mod.color}-400`}>
                {mod.badge}
              </span>
            </div>
            <p class="text-meg-text-secondary text-sm leading-relaxed mb-4">{mod.description}</p>
            <span class={`inline-flex items-center gap-1 text-xs font-semibold text-${mod.color}-400 group-hover:gap-2 transition-all`}>
              Mehr erfahren
              <i class="fa-solid fa-arrow-right text-[10px]" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- USP Section -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="usp-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          <i class="fa-solid fa-star mr-2" aria-hidden="true"></i>
          Plattform-Vorteile
        </p>
        <h2 id="usp-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">
          Eine Plattform. Alles verbunden.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {usps.map((usp, i) => (
          <div class="gsap-fadein text-center" style={`animation-delay: ${i * 0.15}s`}>
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-meg-accent/10 border border-meg-accent/20 mb-6">
              <i class={`fa-solid ${usp.icon} text-meg-accent text-2xl`} aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-meg-text-primary-dark mb-3">{usp.title}</h3>
            <p class="text-meg-text-secondary leading-relaxed">{usp.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="tech-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          <i class="fa-solid fa-microchip mr-2" aria-hidden="true"></i>
          Technologie
        </p>
        <h2 id="tech-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">
          Gebaut für die Zukunft
        </h2>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto mt-4" style="animation-delay: 0.3s">
          Modernste Technologie-Architektur für maximale Performance, Sicherheit und Entwicklerfreundlichkeit.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-4">
        {techStack.map((tech, i) => (
          <div class="gsap-fadein flex items-center gap-3 bg-meg-surface-dark/50 border border-meg-border-dark rounded-xl px-5 py-3 hover:border-meg-accent/30 transition-all" style={`animation-delay: ${i * 0.1}s`}>
            <i class={`fa-solid ${tech.icon} text-meg-accent text-lg`} aria-hidden="true"></i>
            <div>
              <p class="text-meg-text-primary-dark font-bold text-sm">{tech.label}</p>
              <p class="text-meg-text-secondary text-xs">{tech.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Section -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="compliance-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          <i class="fa-solid fa-shield-halved mr-2" aria-hidden="true"></i>
          Compliance & Sicherheit
        </p>
        <h2 id="compliance-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.15s">
          Sicherheit ist kein Feature – sie ist Standard.
        </h2>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto" style="animation-delay: 0.3s">
          E-Rechnungspflicht, DSGVO, Audit Trail und Mandantentrennung: Die Waldheim Suite erfüllt alle regulatorischen Anforderungen für den DACH-Mittelstand.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {complianceItems.map((item, i) => (
          <div class="gsap-fadein flex items-start gap-4 bg-meg-surface-dark/50 border border-meg-border-dark rounded-2xl p-6 hover:border-meg-accent/30 transition-all" style={`animation-delay: ${i * 0.1}s`}>
            <div class="shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-xl bg-meg-accent/10 border border-meg-accent/20">
              <i class={`fa-solid ${item.icon} text-meg-accent`} aria-hidden="true"></i>
            </div>
            <div>
              <h3 class="text-meg-text-primary-dark font-bold text-sm mb-1">{item.label}</h3>
              <p class="text-meg-text-secondary text-xs leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-24 sm:py-32 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="pricing-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-meg-accent mb-4">
          <i class="fa-solid fa-tag mr-2" aria-hidden="true"></i>
          Preise
        </p>
        <h2 id="pricing-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.15s">
          Transparent. Modular. Skalierbar.
        </h2>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto" style="animation-delay: 0.3s">
          Starten Sie klein und wachsen Sie mit der Suite. Alle Preise pro Monat, jährliche Abrechnung möglich.
        </p>
      </div>
      <div class="max-w-3xl mx-auto">
        <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-violet-500/30 rounded-3xl p-10 shadow-2xl shadow-violet-500/10 text-center">
          <p class="text-sm font-bold uppercase tracking-widest text-violet-400 mb-4">Waldheim Suite · Vollständiger Zugang, alle Module</p>
          <div class="flex items-baseline justify-center gap-3 mb-2">
            <span class="text-6xl font-black text-violet-400">€49</span>
            <div class="text-left">
              <p class="text-meg-text-secondary text-sm font-semibold">/Seat</p>
              <p class="text-meg-text-secondary text-sm">/Monat</p>
            </div>
          </div>
          <p class="text-meg-text-secondary mb-8">
            Flat-Rate, linear skalierend · keine Mindestlaufzeit · volle Suite, alle Module
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left mb-10">
            {pricingFeatures.map(f => (
              <li class="flex items-start gap-3 text-sm text-meg-text-secondary">
                <i class="fa-solid fa-circle-check text-violet-400 mt-0.5 shrink-0" aria-hidden="true"></i>
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <div class="grid grid-cols-3 gap-4 mb-10">
            {pricingExamples.map(ex => (
              <div class="rounded-2xl bg-meg-surface-dark/60 border border-meg-border-dark px-4 py-5">
                <p class="text-xs font-bold uppercase tracking-wider text-meg-text-secondary mb-1">{ex.label}</p>
                <p class="text-3xl font-black text-meg-text-primary-dark">€{ex.total}</p>
                <p class="text-xs text-meg-text-secondary mt-1">{ex.seats} Seats · /Monat</p>
              </div>
            ))}
          </div>
          <a
            href="/kontakt/"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-violet-500 text-white font-bold text-sm rounded-xl hover:shadow-xl hover:shadow-violet-500/30 hover:scale-[1.02] transition-all duration-300 w-full sm:w-auto"
          >
            <i class="fa-solid fa-rocket" aria-hidden="true"></i>
            Suite Demo anfragen
          </a>
        </div>
        <p class="text-center text-meg-text-secondary text-sm mt-8">
          Alle Preise zzgl. MwSt. · Jahresabrechnung auf Anfrage. · Enterprise-Konditionen individuell verhandelbar.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="cta-heading">
    <div class="max-w-4xl mx-auto text-center">
      <div class="gsap-fadein bg-meg-surface-dark/50 backdrop-blur-xl border border-meg-accent/20 rounded-3xl p-12 shadow-2xl shadow-meg-accent/5">
        <i class="fa-solid fa-rocket text-4xl text-meg-accent mb-6" aria-hidden="true"></i>
        <h2 id="cta-heading" class="text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
          Bereit für die Suite?
        </h2>
        <p class="text-xl text-meg-text-secondary mb-8 max-w-2xl mx-auto">
          Registrieren Sie sich im Kundenportal und erhalten Sie frühen Zugang zu allen Modulen der Waldheim Suite.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="https://portal.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto group px-8 py-4 bg-meg-accent text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-meg-accent/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-grid-2" aria-hidden="true"></i>
            Zum Kundenportal
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a
            href="/suite/preise/"
            class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-meg-accent/50 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-tag" aria-hidden="true"></i>
            Preise ansehen
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
