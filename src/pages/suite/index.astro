  <!-- Hero Section -->
  <section
    class="relative isolate px-6 py-10 sm:py-16 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden"
  >
    <div
      class="absolute -top-32 right-0 -z-10 size-[28rem] rounded-full bg-sky-500/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div
      class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)] lg:gap-16"
