<script>
  // Pricing Calculator Logic
  const seatsInput = document.getElementById('calc-seats') as HTMLInputElement;
  const seatsDisplay = document.getElementById('calc-seats-display')!;
  const discountToggle = document.getElementById(
    'calc-discount',
  ) as HTMLInputElement;
  const unitsInput = document.getElementById('calc-units') as HTMLInputElement;
  const totalEl = document.getElementById('calc-total')!;
  const originalPriceEl = document.getElementById('calc-original-price')!;
  const discountBadge = document.getElementById('calc-discount-badge')!;
  const breakdownSeats = document.getElementById('calc-breakdown-seats')!;
  const breakdownBase = document.getElementById('calc-breakdown-base')!;
  const breakdownUnitsRow = document.getElementById(
    'calc-breakdown-units-row',
  )!;
  const breakdownUnitsLabel = document.getElementById(
    'calc-breakdown-units-label',
  )!;
  const breakdownUnitsVal = document.getElementById(
    'calc-breakdown-units-val',
  )!;
  const breakdownDiscountRow = document.getElementById(
    'calc-breakdown-discount-row',
  )!;
  const breakdownDiscountVal = document.getElementById(
    'calc-breakdown-discount-val',
  )!;
  const tierBtns =
    document.querySelectorAll<HTMLButtonElement>('.calc-tier-btn');

  let currentPrice = 29;

  function updateCalc() {
    const seats = parseInt(seatsInput.value) || 1;
    const units = parseInt(unitsInput.value) || 0;
    const discount = discountToggle.checked;

    seatsDisplay.textContent = seats.toString();

    const basePrice = seats * currentPrice;
    const unitsAddon = units > 0 ? 15 + Math.round(units * 0.5) : 0;
    const subtotal = basePrice + unitsAddon;
    const discountAmt = discount ? Math.round(subtotal * 0.4) : 0;
    const total = subtotal - discountAmt;

    breakdownSeats.textContent = `${seats} Seat${seats > 1 ? 's' : ''} × €${currentPrice}`;
    breakdownBase.textContent = `€${basePrice}`;

    if (units > 0) {
      breakdownUnitsRow.classList.remove('hidden');
      breakdownUnitsLabel.textContent = `Immobilien-Add-on (${units} Einh.)`;
      breakdownUnitsVal.textContent = `€${unitsAddon}`;
    } else {
      breakdownUnitsRow.classList.add('hidden');
    }

    if (discount) {
      originalPriceEl.classList.remove('hidden');
      originalPriceEl.textContent = `€${subtotal}`;
      discountBadge.classList.remove('hidden');
      breakdownDiscountRow.classList.remove('hidden');
      breakdownDiscountVal.textContent = `–€${discountAmt}`;
    } else {
      originalPriceEl.classList.add('hidden');
      discountBadge.classList.add('hidden');
      breakdownDiscountRow.classList.add('hidden');
    }

    totalEl.textContent = `€${total}`;
  }

  tierBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentPrice = parseInt(btn.dataset.price || '29');
      tierBtns.forEach((b) => {
        b.className =
          'calc-tier-btn py-2.5 px-3 rounded-xl border text-xs font-bold transition-all border-meg-border-dark text-meg-text-secondary hover:border-meg-accent/40';
      });
      btn.className =
        'calc-tier-btn py-2.5 px-3 rounded-xl border text-xs font-bold transition-all border-meg-accent bg-meg-accent/10 text-meg-accent';
      updateCalc();
    });
  });

  seatsInput?.addEventListener('input', updateCalc);
  discountToggle?.addEventListener('change', updateCalc);
  unitsInput?.addEventListener('input', updateCalc);

  // Initial calculation
  updateCalc();
</script>
