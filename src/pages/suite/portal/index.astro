---
import PromoServices from '../../../components/PromoServices.astro';
import InteractiveHeroCanvas from '../../../components/InteractiveHeroCanvas.astro';
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
  { name: 'Customer Portal', link: 'https://waldheim.dev/suite/portal' },
]);

const titel = 'Customer Portal – Tickets, Rechnungen & Support | Waldheim Suite';
const description =
  'Das Waldheim Customer Portal: Self-Service für Kunden mit Ticket-System, Rechnungsverwaltung, Abo-Verwaltung und Support-Queue. Teil der Waldheim Suite.';
const keywords =
  'Customer Portal, Tickets, Rechnungen, Support, Abo, Self-Service, Helpdesk, Waldheim Suite';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Customer Portal',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite/portal',
  author: { '@type': 'Organization', name: 'waldheim.dev', url: 'https://waldheim.dev' },
};

const features = [
  {
    icon: 'fa-ticket',
    title: 'Ticket-System mit SLA',
    description: 'Anfragen landen automatisch in der richtigen Queue, mit Priorisierung, Eskalationsstufe und kompletter Kommunikationshistorie pro Fall.',
  },
  {
    icon: 'fa-file-invoice-dollar',
    title: 'Rechnungen & Zahlungsstatus',
    description: 'Kunden sehen sofort, welche Rechnungen offen, bezahlt oder überfällig sind und laden Belege direkt herunter.',
  },
  {
    icon: 'fa-repeat',
    title: 'Abo- und Modulverwaltung',
    description: 'Laufende Subscriptions, aktive Module, Upgrades und Verlängerungen im Self-Service statt über E-Mail-Pingpong.',
  },
  {
    icon: 'fa-headset',
    title: 'Support-Workspace',
    description: 'Status, letzte Antwort, Verantwortlicher und SLA-Risiken in einer Ansicht. Keine verlorenen Fälle mehr.',
  },
  {
    icon: 'fa-user-shield',
    title: 'Identität & Zugriffe',
    description: 'Rollen, Nutzerzugänge und Freigaben zentral steuern, ohne separaten Admin-Prozess außerhalb der Suite.',
  },
  {
    icon: 'fa-bell',
    title: 'Benachrichtigungen über Relay',
    description: 'Ticket-Updates, Rechnungen und Abo-Änderungen werden kanalübergreifend per E-Mail oder In-App ausgeliefert.',
  },
  {
    icon: 'fa-credit-card',
    title: 'Billing-Transparenz',
    description: 'Offene Forderungen, Payment-Methoden und Zahlungsereignisse aus Stripe direkt im Kundenkontext sichtbar.',
  },
  {
    icon: 'fa-chart-line',
    title: 'Service-Dashboard',
    description: 'Offene Tickets, Antwortzeiten, Zahlungsstatus und Modulnutzung in einem operativen Überblick für Kunden und Teams.',
  },
];

const problems = [
  {
    icon: 'fa-envelope-open-text',
    text: 'Support läuft über verstreute Postfächer. Niemand sieht den vollständigen Verlauf, Rückfragen gehen verloren und Kunden müssen alles doppelt erklären.',
  },
  {
    icon: 'fa-file-circle-question',
    text: 'Rechnungen, Abos und Zugänge liegen in verschiedenen Systemen. Für jede Änderung braucht es ein Ticket oder eine E-Mail an das Backoffice.',
  },
  {
    icon: 'fa-hourglass-half',
    text: 'Kunden wissen nicht, wann eine Antwort kommt. Teams erkennen SLA-Risiken erst, wenn die Eskalation schon da ist.',
  },
];

const integrations = [
  { icon: 'fa-coins', label: 'Treasury', desc: 'Zahlungsstatus und Forderungen landen direkt im Kundenkonto', color: 'yellow' },
  { icon: 'fa-tower-broadcast', label: 'Relay', desc: 'Status-Updates und Hinweise laufen zentral über einen Notification-Hub', color: 'cyan' },
  { icon: 'fa-atom', label: 'Aether', desc: 'Rechnungen, Verträge und Belege sind direkt am Vorgang verknüpft', color: 'rose' },
  { icon: 'fa-users-gear', label: 'Socialverse CRM', desc: 'Account-Kontext und Kundenhistorie fließen in Support und Success ein', color: 'violet' },
];
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[softwareSchema, breadCrumbSchema]}
>
  <!-- Breadcrumb -->
  <nav class="pt-20 px-6 bg-meg-bg-dark" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-meg-text-secondary">
        <li><a href="/suite/" class="hover:text-meg-accent transition-colors font-semibold">Waldheim Suite</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li class="text-emerald-400 font-bold">Customer Portal</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative isolate pt-6 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden">
    
    <!-- Three.js Interactive WebGL Background -->
    <InteractiveHeroCanvas particleColor="#0ea5e9" lineColor="#3b82f6" />

    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
      <div
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-emerald-500/20 to-green-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      ></div>
    </div>
    <div class="max-w-7xl mx-auto py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center gsap-fadein">
        <div class="gsap-fadein mb-4">
          <span class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-3 py-1.5 rounded-full text-xs font-bold">
            <i class="fa-solid fa-table-cells-large text-[10px]" aria-hidden="true"></i>
            Teil der Waldheim Suite
          </span>
        </div>
        <div class="gsap-fadein mb-6 flex flex-wrap justify-center gap-2" style="animation-delay: 0.1s">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-sm font-bold text-emerald-400">
            <i class="fa-solid fa-headset" aria-hidden="true"></i>
            v0.11.3 · Jetzt nutzbar
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-shield-halved text-emerald-400" aria-hidden="true"></i>
            Identität, Billing, Support
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-clock text-emerald-400" aria-hidden="true"></i>
            SLA-Transparenz
          </span>
        </div>
        <h1 class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Ein Portal.<br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-emerald-400 to-green-500">Alle Kundenprozesse.</span>
        </h1>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed" style="animation-delay: 0.3s">
          Das Customer Portal bündelt Support, Rechnungen, Abos und Zugänge in einem klaren Self-Service-Workspace.
          Kunden finden Antworten schneller, und Ihr Team verliert keine Zeit mehr in E-Mail-Schleifen.
        </p>
        <div class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.45s">
          <a
            href="https://suite.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto group px-8 py-4 bg-emerald-600 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-emerald-500/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            Zum Portal
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a
            href="/suite/"
            class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-emerald-500/40 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Alle Module
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-meg-surface-dark border-b border-meg-border-dark">
    <div class="max-w-5xl mx-auto">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-red-400 mb-8 text-center">
        <i class="fa-solid fa-triangle-exclamation mr-2" aria-hidden="true"></i>
        Der Alltag ohne Customer Portal
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {problems.map((p, i) => (
          <div class="gsap-fadein flex gap-4 bg-red-500/5 border border-red-500/20 rounded-2xl p-5" style={`animation-delay: ${i * 0.1}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <i class={`fa-solid ${p.icon} text-red-400`} aria-hidden="true"></i>
            </div>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="portal-dashboard-heading">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
            <i class="fa-solid fa-gauge-high mr-2" aria-hidden="true"></i>
            Kunden-Workspace
          </p>
          <h2 id="portal-dashboard-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
            Support, Billing und Zugang.<br />
            <span class="text-emerald-400">Ein Kontext.</span>
          </h2>
          <p class="gsap-fadein text-lg text-meg-text-secondary mb-8 leading-relaxed" style="animation-delay: 0.3s">
            Kunden sehen auf einen Blick offene Fälle, letzte Antworten, Rechnungen und aktive Module.
            Interne Teams arbeiten auf derselben Wahrheit statt in getrennten Backoffice-Tools.
          </p>
          <ul class="space-y-3">
            {[
              'Tickets mit Priorität, SLA-Timer und Verantwortlichem',
              'Rechnungen, Verträge und Belege direkt im Vorgang verlinkt',
              'Self-Service für Abos, Nutzer und Zugriffe',
              'Benachrichtigungen über Relay statt unkoordinierter E-Mails',
            ].map((item) => (
              <li class="flex items-center gap-3 text-meg-text-secondary text-sm">
                <i class="fa-solid fa-check text-emerald-400 text-xs" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="gsap-fadein" style="animation-delay: 0.2s">
          <div class="bg-meg-surface-dark/60 border border-emerald-500/20 rounded-3xl p-6 shadow-2xl shadow-emerald-500/5">
            <div class="flex items-center justify-between mb-5">
              <p class="text-sm font-bold text-meg-text-primary-dark">Customer Portal · Übersicht</p>
              <span class="text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-circle text-[6px] animate-pulse" aria-hidden="true"></i>Live
              </span>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-5">
              {[
                { label: 'Offene Tickets', value: '4', sub: '1 kritisch', color: 'emerald' },
                { label: 'Antwortzeit', value: '1h 12m', sub: 'unter SLA', color: 'green' },
                { label: 'Offene Rechnungen', value: '€ 2.480', sub: '2 Belege', color: 'yellow' },
                { label: 'Aktive Module', value: '5', sub: 'inkl. CRM & ERP', color: 'cyan' },
              ].map((k) => (
                <div class={`bg-meg-bg-dark/60 border border-${k.color}-500/10 rounded-xl p-3`}>
                  <p class="text-[10px] text-meg-text-secondary mb-1">{k.label}</p>
                  <p class={`text-xl font-black text-${k.color}-400`}>{k.value}</p>
                  <p class="text-[10px] text-meg-text-secondary">{k.sub}</p>
                </div>
              ))}
            </div>
            <div class="space-y-2">
              {[
                { label: 'Ticket #2481: SSO-Rolle angepasst', time: 'vor 12 Min', color: 'emerald' },
                { label: 'Rechnung INV-2026-048 bereitgestellt', time: 'heute', color: 'yellow' },
                { label: 'Upgrade: Relay Modul freigeschaltet', time: 'gestern', color: 'cyan' },
              ].map((entry) => (
                <div class="flex items-center gap-3 text-xs bg-meg-bg-dark/40 rounded-xl px-3 py-2">
                  <i class={`fa-solid fa-circle-dot text-${entry.color}-400`} aria-hidden="true"></i>
                  <span class="text-meg-text-secondary flex-1 truncate">{entry.label}</span>
                  <span class="text-meg-text-secondary shrink-0">{entry.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-24 sm:py-32 px-6 bg-meg-surface-dark border-b border-meg-border-dark" aria-labelledby="portal-features-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
          <i class="fa-solid fa-list-check mr-2" aria-hidden="true"></i>
          Was Customer Portal kann
        </p>
        <h2 id="portal-features-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">
          Kundenservice ohne Reibung
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {features.map((feat, i) => (
          <div class="gsap-fadein bg-meg-bg-dark/50 border border-meg-border-dark rounded-2xl p-5 hover:border-emerald-500/40 hover:shadow-lg hover:shadow-emerald-500/10 transition-all group" style={`animation-delay: ${i * 0.07}s`}>
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 mb-4 group-hover:bg-emerald-500/20 transition-colors">
              <i class={`fa-solid ${feat.icon} text-emerald-400 text-xl`} aria-hidden="true"></i>
            </div>
            <h3 class="text-base font-bold text-meg-text-primary-dark mb-2">{feat.title}</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="portal-integrations-heading">
    <div class="max-w-5xl mx-auto text-center">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
        <i class="fa-solid fa-plug mr-2" aria-hidden="true"></i>Nahtlos integriert
      </p>
      <h2 id="portal-integrations-heading" class="gsap-fadein text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.1s">
        Das Portal ist Ihr Suite-Eingang.
      </h2>
      <p class="gsap-fadein text-meg-text-secondary mb-12 max-w-2xl mx-auto" style="animation-delay: 0.2s">
        Support, Billing und Dokumente werden nicht kopiert, sondern direkt aus den Suite-Modulen angebunden.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integrations.map((int, i) => (
          <div class={`gsap-fadein bg-meg-surface-dark/50 border border-${int.color}-500/20 rounded-2xl p-5 text-left`} style={`animation-delay: ${i * 0.1}s`}>
            <div class={`inline-flex items-center justify-center w-10 h-10 rounded-xl bg-${int.color}-500/10 border border-${int.color}-500/20 mb-4`}>
              <i class={`fa-solid ${int.icon} text-${int.color}-400`} aria-hidden="true"></i>
            </div>
            <p class={`font-bold text-sm text-${int.color}-400 mb-1`}>{int.label}</p>
            <p class="text-xs text-meg-text-secondary leading-relaxed">{int.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <!-- Custom Consulting & Development Promotion -->
  <PromoServices />

  <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="cta-portal-heading">
    <div class="max-w-4xl mx-auto text-center">
      <div class="gsap-fadein relative group">
        <div class="absolute -inset-0.5 bg-linear-to-r from-emerald-500/20 to-green-500/20 rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-700" aria-hidden="true"></div>
        <div class="relative bg-meg-surface-dark/60 border border-emerald-500/20 rounded-3xl p-12">
        <i class="fa-solid fa-headset text-4xl text-emerald-400 mb-6" aria-hidden="true"></i>
        <h2 id="cta-portal-heading" class="text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
          Kundenkontakt endlich zentralisieren
        </h2>
        <p class="text-xl text-meg-text-secondary mb-8 max-w-xl mx-auto">
          Geben Sie Ihren Kunden einen klaren Self-Service-Zugang für Support, Rechnungen und Module statt verteilter Prozesse.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://suite.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-emerald-600 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-emerald-500/30 transition-all duration-300 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            Zur Demo
          </a>
          <a href="/suite/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-emerald-500/40 transition-all">
            Alle Module ansehen
          </a>
        </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
