---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
  { name: 'Relay', link: 'https://waldheim.dev/suite/relay' },
]);

const titel = 'Relay – Kommunikation & Benachrichtigungen | Waldheim Suite';
const description = 'Relay: Zentraler Kommunikations-Hub für E-Mail, Push, SMS und In-App-Notifications aus allen Suite-Modulen. Ein Ort. Alle Kanäle. Volle Kontrolle. Teil der Waldheim Suite.';
const keywords = 'Relay, Benachrichtigungen, E-Mail, Push Notifications, SMS, Kommunikation, Multi-Channel, Waldheim Suite';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Waldheim Relay',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite/relay',
  author: { '@type': 'Organization', name: 'Waldheim.dev', url: 'https://waldheim.dev' },
};

const features = [
  { icon: 'fa-envelope', title: 'Transaktionale E-Mails', description: 'Bestellbestätigungen, Rechnungen, Passwort-Resets – alle systemgenerierten E-Mails aus einem Versandkanal, mit Template-Editor und Zustellbarkeits-Monitoring.' },
  { icon: 'fa-bell', title: 'In-App-Notifications', description: 'Echtzeit-Benachrichtigungen direkt in der Suite-Shell. Mit Prioritätsstufen, Read-Status, Archiv und direktem Sprung zur Quelle.' },
  { icon: 'fa-mobile-screen-button', title: 'Web Push', description: 'Browser-Push-Notifications für zeitkritische Events – auch wenn der Nutzer gerade nicht in der App ist. Opt-in-konform nach DSGVO.' },
  { icon: 'fa-comment-sms', title: 'SMS (optional)', description: 'Für kritische Eskalationen oder Zwei-Faktor-Codes. Anbindung an gängige SMS-Provider wie Twilio oder Sinch in wenigen Schritten.' },
  { icon: 'fa-sliders', title: 'Nutzer-Präferenzen', description: 'Jeder Nutzer entscheidet selbst: E-Mail, Push, SMS oder In-App – pro Ereignistyp konfigurierbar. Kein Spam, keine erzwungenen Kanäle.' },
  { icon: 'fa-palette', title: 'Template-Editor', description: 'Drag-and-Drop-Editor für E-Mail-Templates mit Branding, Variablen-Interpolation und Vorschau in allen Clients.' },
  { icon: 'fa-timeline', title: 'Notification-Log', description: 'Vollständige Zustellhistorie aller Nachrichten mit Delivery-Status, Bounce-Tracking, Öffnungsraten und Fehlerprotokoll.' },
  { icon: 'fa-plug', title: 'Suite-weite Integration', description: 'Alle Module senden Events an Relay: CRM-Deals, ERP-Aufträge, Treasury-Mahnungen, Properties-Schadensmeldungen – ein Hub für alles.' },
];

const problems = [
  { icon: 'fa-inbox', text: 'E-Mails kommen aus 5 verschiedenen Tools – unterschiedliches Branding, verschiedene Versandserver, kein zentrales Log.' },
  { icon: 'fa-bell-slash', text: 'Wichtige Ereignisse im System verpassen Nutzer, weil es keine zuverlässige Benachrichtigung gibt.' },
  { icon: 'fa-toggle-off', text: 'Kein Nutzer kann steuern, über welchen Kanal er informiert werden möchte – Opt-out nicht möglich, Spam-Beschwerden vorprogrammiert.' },
];

const channels = [
  { icon: 'fa-envelope', label: 'E-Mail', desc: 'Transaktional & Marketing', color: 'cyan', rate: '98.2%', rateLabel: 'Zustellrate' },
  { icon: 'fa-bell', label: 'In-App', desc: 'Echtzeit-Notifications', color: 'sky', rate: '100%', rateLabel: 'Sofort' },
  { icon: 'fa-mobile-screen-button', label: 'Web Push', desc: 'Browser-Notifications', color: 'teal', rate: 'Opt-in', rateLabel: 'DSGVO-konform' },
  { icon: 'fa-comment-sms', label: 'SMS', desc: 'Kritische Eskalationen', color: 'emerald', rate: 'Optional', rateLabel: 'Eigener Provider' },
];

const integrations = [
  { icon: 'fa-network-wired', label: 'Socialverse CRM', desc: 'Deal-Updates, Follow-up-Reminder, Kampagnen-Notifications', color: 'violet' },
  { icon: 'fa-building-columns', label: 'Silvacore ERP', desc: 'Auftragsbestätigungen, Lieferavisen, Projektstatus-Updates', color: 'green' },
  { icon: 'fa-coins', label: 'Treasury', desc: 'Mahnungen, Budgetalarm, Fälligkeitserinnerungen', color: 'yellow' },
  { icon: 'fa-building', label: 'Properties', desc: 'Mieter-Kommunikation, NK-Abrechnungen, Vertragshinweise', color: 'orange' },
];
---

<Layout title={titel} description={description} keywords={keywords} schema={[softwareSchema, breadCrumbSchema]}>

  <nav class="pt-20 px-6 bg-meg-bg-dark" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-meg-text-secondary">
        <li><a href="/suite/" class="hover:text-meg-accent transition-colors font-semibold">Waldheim Suite</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li class="text-cyan-400 font-bold">Relay</li>
      </ol>
    </div>
  </nav>

  <section class="relative isolate pt-6 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-cyan-500/20 to-sky-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    <div class="max-w-7xl mx-auto py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <div class="gsap-fadein mb-4">
          <span class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-3 py-1.5 rounded-full text-xs font-bold">
            <i class="fa-solid fa-table-cells-large text-[10px]" aria-hidden="true"></i>
            Teil der Waldheim Suite
          </span>
        </div>
        <div class="gsap-fadein mb-6 flex flex-wrap justify-center gap-2" style="animation-delay: 0.1s">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-sm font-bold text-cyan-400">
            <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
            In Entwicklung
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-plug text-cyan-400" aria-hidden="true"></i>
            4 Kanäle
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-shield-halved text-cyan-400" aria-hidden="true"></i>
            DSGVO Opt-in
          </span>
        </div>
        <h1 class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Ein Hub.<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-sky-500">Alle Kanäle.</span>
        </h1>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed" style="animation-delay: 0.3s">
          Relay ist der zentrale Kommunikations-Hub der Waldheim Suite. E-Mail, Push, SMS und In-App –
          alle Benachrichtigungen aus allen Modulen, gesteuert aus einer Plattform.
        </p>
        <div class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.45s">
          <a href="https://suite.waldheim.dev" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto group px-8 py-4 bg-cyan-500 text-slate-900 font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-cyan-500/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]">
            <i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i>
            Frühen Zugang anfragen
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a href="/suite/" class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-cyan-500/40 transition-all duration-300 inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Alle Module
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-meg-surface-dark border-b border-meg-border-dark">
    <div class="max-w-5xl mx-auto">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-red-400 mb-8 text-center">
        <i class="fa-solid fa-triangle-exclamation mr-2" aria-hidden="true"></i>
        Der Alltag ohne Relay
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {problems.map((p, i) => (
          <div class="gsap-fadein flex gap-4 bg-red-500/5 border border-red-500/20 rounded-2xl p-5" style={`animation-delay: ${i * 0.1}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <i class={`fa-solid ${p.icon} text-red-400`} aria-hidden="true"></i>
            </div>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="relay-channels">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-cyan-400 mb-4">
          <i class="fa-solid fa-satellite-dish mr-2" aria-hidden="true"></i>
          Verfügbare Kanäle
        </p>
        <h2 id="relay-channels" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">
          Jeden Kanal.<br /><span class="text-cyan-400">Aus einer Hand.</span>
        </h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        {channels.map((ch, i) => (
          <div class={`gsap-fadein bg-meg-surface-dark/50 border border-${ch.color}-500/20 rounded-2xl p-6 text-center hover:border-${ch.color}-500/50 hover:shadow-lg hover:shadow-${ch.color}-500/10 transition-all group`} style={`animation-delay: ${i * 0.1}s`}>
            <div class={`inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-${ch.color}-500/10 border border-${ch.color}-500/20 mb-4 group-hover:scale-110 transition-transform`}>
              <i class={`fa-solid ${ch.icon} text-${ch.color}-400 text-2xl`} aria-hidden="true"></i>
            </div>
            <h3 class={`font-black text-lg text-${ch.color}-400 mb-1`}>{ch.label}</h3>
            <p class="text-meg-text-secondary text-sm mb-3">{ch.desc}</p>
            <div class={`bg-${ch.color}-500/10 border border-${ch.color}-500/20 rounded-lg px-3 py-1.5`}>
              <p class={`text-sm font-black text-${ch.color}-400`}>{ch.rate}</p>
              <p class="text-[10px] text-meg-text-secondary">{ch.rateLabel}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-cyan-400 mb-4">
            <i class="fa-solid fa-gauge-high mr-2" aria-hidden="true"></i>
            Notification Center
          </p>
          <h3 class="gsap-fadein text-3xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
            Volle Kontrolle.<br /><span class="text-cyan-400">Für jeden Nutzer.</span>
          </h3>
          <p class="gsap-fadein text-meg-text-secondary mb-8 leading-relaxed" style="animation-delay: 0.3s">
            Nutzer entscheiden selbst pro Ereignistyp, über welchen Kanal sie informiert werden wollen.
            Relay speichert alle Notifications im In-App-Log und liefert vollständige Delivery-Reports.
          </p>
          <ul class="space-y-3">
            {[
              'Delivery-Status für jede Nachricht auditierbar',
              'Bounce-Tracking und automatisches Retry',
              'Öffnungsraten und Click-Tracking für E-Mails',
              'DSGVO-konformes Opt-in und Opt-out pro Kanal',
            ].map((item) => (
              <li class="flex items-center gap-3 text-meg-text-secondary text-sm">
                <i class="fa-solid fa-check text-cyan-400 text-xs" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="gsap-fadein" style="animation-delay: 0.2s">
          <div class="bg-meg-surface-dark/60 border border-cyan-500/20 rounded-3xl p-6 shadow-2xl shadow-cyan-500/5">
            <div class="flex items-center justify-between mb-5">
              <p class="text-sm font-bold text-meg-text-primary-dark">Relay · Notification-Log</p>
              <span class="text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-circle text-[6px] animate-pulse" aria-hidden="true"></i>Live
              </span>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-5">
              {[
                { label: 'Heute versandt', value: '1.247', color: 'cyan' },
                { label: 'Zugestellt', value: '99.1%', color: 'green' },
                { label: 'Bounced', value: '11', color: 'red' },
              ].map((k) => (
                <div class={`bg-meg-bg-dark/60 border border-${k.color}-500/10 rounded-xl p-3 text-center`}>
                  <p class="text-[10px] text-meg-text-secondary mb-1">{k.label}</p>
                  <p class={`text-lg font-black text-${k.color}-400`}>{k.value}</p>
                </div>
              ))}
            </div>
            <div class="space-y-2">
              {[
                { label: 'E-Mail: "Rechnung #4821 bereit"', channel: 'E-Mail', time: 'vor 1 Min', color: 'cyan', status: 'Zugestellt' },
                { label: 'Push: "Deal "Acme" in Phase 3"', channel: 'Push', time: 'vor 4 Min', color: 'sky', status: 'Zugestellt' },
                { label: 'In-App: Budgetalarm Treasury', channel: 'In-App', time: 'vor 9 Min', color: 'teal', status: 'Gelesen' },
              ].map((e) => (
                <div class="flex items-center gap-3 text-xs bg-meg-bg-dark/40 rounded-xl px-3 py-2">
                  <i class={`fa-solid fa-circle-dot text-${e.color}-400 shrink-0`} aria-hidden="true"></i>
                  <span class="text-meg-text-secondary flex-1 truncate">{e.label}</span>
                  <span class={`shrink-0 text-[10px] font-bold text-${e.color}-400`}>{e.status}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6 bg-meg-surface-dark border-b border-meg-border-dark" aria-labelledby="relay-features">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-cyan-400 mb-4">
          <i class="fa-solid fa-list-check mr-2" aria-hidden="true"></i>Was Relay kann
        </p>
        <h2 id="relay-features" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">
          Mehr als nur E-Mail.
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {features.map((feat, i) => (
          <div class="gsap-fadein bg-meg-bg-dark/50 border border-meg-border-dark rounded-2xl p-5 hover:border-cyan-500/40 hover:shadow-lg hover:shadow-cyan-500/10 transition-all group" style={`animation-delay: ${i * 0.07}s`}>
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-cyan-500/10 border border-cyan-500/20 mb-4 group-hover:bg-cyan-500/20 transition-colors">
              <i class={`fa-solid ${feat.icon} text-cyan-400 text-lg`} aria-hidden="true"></i>
            </div>
            <h3 class="text-base font-bold text-meg-text-primary-dark mb-2">{feat.title}</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="relay-integrations">
    <div class="max-w-5xl mx-auto text-center">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-cyan-400 mb-4">
        <i class="fa-solid fa-plug mr-2" aria-hidden="true"></i>Wer sendet über Relay?
      </p>
      <h2 id="relay-integrations" class="gsap-fadein text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.1s">
        Jedes Modul. Ein Versandkanal.
      </h2>
      <p class="gsap-fadein text-meg-text-secondary mb-12 max-w-2xl mx-auto" style="animation-delay: 0.2s">
        Alle Suite-Module sind nativ an Relay angebunden. Kein eigener Mailer, kein eigener Template-Stack.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integrations.map((int, i) => (
          <div class={`gsap-fadein bg-meg-surface-dark/50 border border-${int.color}-500/20 rounded-2xl p-5 text-left`} style={`animation-delay: ${i * 0.1}s`}>
            <div class={`inline-flex items-center justify-center w-10 h-10 rounded-xl bg-${int.color}-500/10 border border-${int.color}-500/20 mb-4`}>
              <i class={`fa-solid ${int.icon} text-${int.color}-400`} aria-hidden="true"></i>
            </div>
            <p class={`font-bold text-sm text-${int.color}-400 mb-1`}>{int.label}</p>
            <p class="text-xs text-meg-text-secondary leading-relaxed">{int.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="cta-relay">
    <div class="max-w-4xl mx-auto text-center">
      <div class="gsap-fadein relative group">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-cyan-500/20 to-sky-500/20 rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-700" aria-hidden="true"></div>
        <div class="relative bg-meg-surface-dark/60 border border-cyan-500/20 rounded-3xl p-12">
          <i class="fa-solid fa-tower-broadcast text-4xl text-cyan-400 mb-6" aria-hidden="true"></i>
          <h2 id="cta-relay" class="text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
            Kommunikation zentralisieren.
          </h2>
          <p class="text-xl text-meg-text-secondary mb-8 max-w-xl mx-auto">
            Beantragen Sie frühen Zugang zu Relay und steuern Sie alle Kanäle aus einer Plattform.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://suite.waldheim.dev" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-cyan-500 text-slate-900 font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-cyan-500/30 transition-all duration-300 hover:scale-[1.02]">
              <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>Zum Kundenportal
            </a>
            <a href="/suite/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-cyan-500/40 transition-all">
              Alle Module ansehen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
