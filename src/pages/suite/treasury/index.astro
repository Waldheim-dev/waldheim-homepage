---
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
  { name: 'Treasury', link: 'https://waldheim.dev/suite/treasury' },
]);

const titel = 'Treasury – Finanzen & Liquiditätsplanung | Waldheim Suite';
const description = 'Treasury: Tagesaktuelle Liquiditätsvorschau, Budgetcontrolling, Kostenstellen, Cashflow-Analyse und DATEV-Export – direkt verknüpft mit ERP und Billing. Teil der Waldheim Suite.';
const keywords = 'Treasury, Finanzplanung, Liquiditätsplanung, Budgetcontrolling, Kostenstellen, Cashflow, DATEV-Export, Waldheim Suite';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Waldheim Treasury',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite/treasury',
  author: { '@type': 'Organization', name: 'Waldheim.dev', url: 'https://waldheim.dev' },
};

const features = [
  { icon: 'fa-water', title: 'Liquiditätsvorschau', description: 'Rollende 7-, 30- und 90-Tage-Prognose auf Basis offener Eingangs- und Ausgangsrechnungen. Engpässe sichtbar, bevor sie entstehen.' },
  { icon: 'fa-layer-group', title: 'Kostenstellen & Budgets', description: 'Budgetzuteilung pro Kostenstelle, Projekt oder Abteilung. Plan-/Ist-Vergleich in Echtzeit, Warnmeldung bei Überschreitung.' },
  { icon: 'fa-file-invoice-dollar', title: 'Rechnungsworkflow', description: 'Vollständiger Eingangs- und Ausgangsrechnungsworkflow mit Buchungsvorschlag, Freigabestufen und Belegarchiv in Aether.' },
  { icon: 'fa-rotate', title: 'Wiederkehrende Zahlungen', description: 'Mieten, Lizenzen, Abos und Daueraufträge im Fälligkeitskalender mit automatischer Erinnerung.' },
  { icon: 'fa-triangle-exclamation', title: 'Mahnwesen', description: 'Automatischer Mahnlauf mit konfigurierbaren Stufen. Offene Forderungen im Blick, Eskalation per Relay an den Vertrieb.' },
  { icon: 'fa-scale-balanced', title: 'Soll-/Ist-Analyse', description: 'Monatliche, quartalsweise und jährliche Plan-/Ist-Gegenüberstellung pro Kostenstelle, Projekt oder Gesamtunternehmen.' },
  { icon: 'fa-chart-line', title: 'Cashflow-Bericht', description: 'Interaktiver Cashflow-Verlauf mit Drill-Down auf Buchungsposition. Trends erkennen, bevor sie zum Problem werden.' },
  { icon: 'fa-file-export', title: 'DATEV-Export', description: 'Ein-Klick-Export aller Buchungen im DATEV-Format für Ihren Steuerberater. Revisionssicher, DSGVO-konform.' },
];

const problems = [
  { icon: 'fa-clock', text: 'Monatsabschluss dauert 2–3 Tage, weil Zahlen aus CRM, ERP und Billing manuell zusammengeführt werden.' },
  { icon: 'fa-eye-slash', text: 'Niemand weiß genau, wie viel Liquidität in 30 Tagen noch da ist.' },
  { icon: 'fa-file-excel', text: 'Budgets stecken in Excel – versioniert, verstreut, nie wirklich aktuell.' },
];

const integrations = [
  { icon: 'fa-building-columns', label: 'Silvacore ERP', desc: 'Aufträge & Ausgangsrechnungen fließen automatisch ins Treasury', color: 'green' },
  { icon: 'fa-atom', label: 'Aether', desc: 'Belege und Rechnungsdokumente direkt im DMS verknüpft', color: 'rose' },
  { icon: 'fa-id-card', label: 'CustomerPortal', desc: 'Stripe-Zahlungen und Abo-Umsätze in Echtzeit sichtbar', color: 'sky' },
  { icon: 'fa-tower-broadcast', label: 'Relay', desc: 'Mahnungen und Budgetalarme per E-Mail oder Push', color: 'cyan' },
];
---

<Layout title={titel} description={description} keywords={keywords} schema={[softwareSchema, breadCrumbSchema]}>

  <nav class="pt-20 px-6 bg-meg-bg-dark" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-meg-text-secondary">
        <li><a href="/suite/" class="hover:text-meg-accent transition-colors font-semibold">Waldheim Suite</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li class="text-yellow-400 font-bold">Treasury</li>
      </ol>
    </div>
  </nav>

  <section class="relative isolate pt-6 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden">
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-yellow-500/20 to-amber-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
    <div class="max-w-7xl mx-auto py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <div class="gsap-fadein mb-4">
          <span class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-3 py-1.5 rounded-full text-xs font-bold">
            <i class="fa-solid fa-table-cells-large text-[10px]" aria-hidden="true"></i>
            Teil der Waldheim Suite
          </span>
        </div>
        <div class="gsap-fadein mb-6 flex flex-wrap justify-center gap-2" style="animation-delay: 0.1s">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-yellow-500/10 border border-yellow-500/20 text-sm font-bold text-yellow-400">
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            In Entwicklung
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-file-export text-yellow-400" aria-hidden="true"></i>
            DATEV-Export
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-shield-halved text-yellow-400" aria-hidden="true"></i>
            DSGVO-konform
          </span>
        </div>
        <h1 class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Schluss mit dem<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-amber-500">Excel-Chaos.</span>
        </h1>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed" style="animation-delay: 0.3s">
          Treasury bringt Liquidität, Budgets und Cashflow in Echtzeit auf einen Screen –
          direkt verknüpft mit ERP-Aufträgen, Billing-Umsätzen und Ihrem Steuerberater.
        </p>
        <div class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.45s">
          <a href="https://suite.waldheim.dev" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto group px-8 py-4 bg-yellow-500 text-slate-900 font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-yellow-500/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]">
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            Demo ausprobieren
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a href="/suite/" class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-yellow-500/40 transition-all duration-300 inline-flex items-center justify-center gap-2">
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Alle Module
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-meg-surface-dark border-b border-meg-border-dark">
    <div class="max-w-5xl mx-auto">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-red-400 mb-8 text-center">
        <i class="fa-solid fa-triangle-exclamation mr-2" aria-hidden="true"></i>
        Der Alltag ohne Treasury
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {problems.map((p, i) => (
          <div class="gsap-fadein flex gap-4 bg-red-500/5 border border-red-500/20 rounded-2xl p-5" style={`animation-delay: ${i * 0.1}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <i class={`fa-solid ${p.icon} text-red-400`} aria-hidden="true"></i>
            </div>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="treasury-dashboard">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-yellow-400 mb-4">
            <i class="fa-solid fa-gauge-high mr-2" aria-hidden="true"></i>
            Live-Dashboard
          </p>
          <h2 id="treasury-dashboard" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
            Vollständige Finanzkontrolle.<br />
            <span class="text-yellow-400">Ohne Überraschungen.</span>
          </h2>
          <p class="gsap-fadein text-lg text-meg-text-secondary mb-8 leading-relaxed" style="animation-delay: 0.3s">
            Treasury aggregiert automatisch Einnahmen aus Silvacore ERP, Stripe-Zahlungen aus dem CustomerPortal
            und offene Rechnungen aus Aether – und zeigt jederzeit, wie es wirklich um Ihre Liquidität steht.
          </p>
          <ul class="space-y-3">
            {[
              'Tagesaktuelle Liquiditätsvorschau für 7 / 30 / 90 Tage',
              'Budgetwarnungen bevor die Grenze überschritten wird',
              'Automatischer DATEV-Export – ein Klick, kein Nacharbeiten',
              'Vollständig auditierbare Buchungshistorie',
            ].map((item) => (
              <li class="flex items-center gap-3 text-meg-text-secondary text-sm">
                <i class="fa-solid fa-check text-yellow-400 text-xs" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="gsap-fadein" style="animation-delay: 0.2s">
          <div class="bg-meg-surface-dark/60 border border-yellow-500/20 rounded-3xl p-6 shadow-2xl shadow-yellow-500/5">
            <div class="flex items-center justify-between mb-5">
              <p class="text-sm font-bold text-meg-text-primary-dark">Treasury · Finanzübersicht</p>
              <span class="text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-circle text-[6px] animate-pulse" aria-hidden="true"></i>Live
              </span>
            </div>
            <div class="grid grid-cols-3 gap-3 mb-5">
              {[
                { label: 'Liquidität', value: '€ 84.2k', sub: '+12% ggü. Vormonat', color: 'yellow' },
                { label: 'Offene ER', value: '€ 18.4k', sub: '7 Rechnungen', color: 'orange' },
                { label: 'Budget Rest', value: '€ 31.1k', sub: 'von € 50k', color: 'green' },
              ].map((k) => (
                <div class={`bg-meg-bg-dark/60 border border-${k.color}-500/10 rounded-xl p-3`}>
                  <p class="text-[10px] text-meg-text-secondary mb-1">{k.label}</p>
                  <p class={`text-lg font-black text-${k.color}-400`}>{k.value}</p>
                  <p class="text-[10px] text-meg-text-secondary opacity-60">{k.sub}</p>
                </div>
              ))}
            </div>
            <div class="mb-5">
              <p class="text-[10px] font-bold text-meg-text-secondary uppercase tracking-wider mb-3">Cashflow – letzte 6 Monate</p>
              <div class="flex items-end gap-2 h-14">
                {[55, 72, 48, 88, 65, 91].map((h) => (
                  <div class="flex-1 rounded-t-md bg-yellow-500/40 hover:bg-yellow-500/70 transition-colors" style={`height:${h}%`}></div>
                ))}
              </div>
              <div class="flex justify-between mt-1">
                {['Dez','Jan','Feb','Mär','Apr','Mai'].map((m) => (
                  <span class="text-[9px] text-meg-text-secondary flex-1 text-center">{m}</span>
                ))}
              </div>
            </div>
            <div class="space-y-2">
              {[
                { label: 'DATEV-Export erzeugt', time: 'vor 3 Min', color: 'yellow' },
                { label: 'Budget "Marketing" → 92% ausgeschöpft', time: 'vor 1 Std', color: 'orange' },
                { label: 'Zahlung "Mietkosten Mai" fällig', time: 'morgen', color: 'red' },
              ].map((e) => (
                <div class="flex items-center gap-3 text-xs">
                  <i class={`fa-solid fa-circle-dot text-${e.color}-400`} aria-hidden="true"></i>
                  <span class="text-meg-text-secondary flex-1">{e.label}</span>
                  <span class="text-meg-text-secondary opacity-60 shrink-0">{e.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6 bg-meg-surface-dark border-b border-meg-border-dark" aria-labelledby="treasury-features">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-yellow-400 mb-4">
          <i class="fa-solid fa-list-check mr-2" aria-hidden="true"></i>Was Treasury kann
        </p>
        <h2 id="treasury-features" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">Alles für Ihre Finanzen.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {features.map((feat, i) => (
          <div class="gsap-fadein bg-meg-bg-dark/50 border border-meg-border-dark rounded-2xl p-5 hover:border-yellow-500/40 hover:shadow-lg hover:shadow-yellow-500/10 transition-all group" style={`animation-delay: ${i * 0.07}s`}>
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-yellow-500/10 border border-yellow-500/20 mb-4 group-hover:bg-yellow-500/20 transition-colors">
              <i class={`fa-solid ${feat.icon} text-yellow-400 text-lg`} aria-hidden="true"></i>
            </div>
            <h3 class="text-base font-bold text-meg-text-primary-dark mb-2">{feat.title}</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="treasury-integrations">
    <div class="max-w-5xl mx-auto text-center">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-yellow-400 mb-4">
        <i class="fa-solid fa-plug mr-2" aria-hidden="true"></i>Nahtlos integriert
      </p>
      <h2 id="treasury-integrations" class="gsap-fadein text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.1s">
        Treasury kennt Ihre Zahlen – bevor Sie fragen.
      </h2>
      <p class="gsap-fadein text-meg-text-secondary mb-12 max-w-2xl mx-auto" style="animation-delay: 0.2s">Daten fließen automatisch aus allen verbundenen Modulen. Kein manueller Import, kein Datenverlust.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integrations.map((int, i) => (
          <div class={`gsap-fadein bg-meg-surface-dark/50 border border-${int.color}-500/20 rounded-2xl p-5 text-left`} style={`animation-delay: ${i * 0.1}s`}>
            <div class={`inline-flex items-center justify-center w-10 h-10 rounded-xl bg-${int.color}-500/10 border border-${int.color}-500/20 mb-4`}>
              <i class={`fa-solid ${int.icon} text-${int.color}-400`} aria-hidden="true"></i>
            </div>
            <p class={`font-bold text-sm text-${int.color}-400 mb-1`}>{int.label}</p>
            <p class="text-xs text-meg-text-secondary leading-relaxed">{int.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="cta-treasury">
    <div class="max-w-4xl mx-auto text-center">
      <div class="gsap-fadein relative group">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-yellow-500/20 to-amber-500/20 rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-700" aria-hidden="true"></div>
        <div class="relative bg-meg-surface-dark/60 border border-yellow-500/20 rounded-3xl p-12">
          <i class="fa-solid fa-coins text-4xl text-yellow-400 mb-6" aria-hidden="true"></i>
          <h2 id="cta-treasury" class="text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4">Kein Excel-Monatsabschluss mehr.</h2>
          <p class="text-xl text-meg-text-secondary mb-8 max-w-xl mx-auto">Beantragen Sie frühen Zugang zu Treasury und sehen Sie Ihre Finanzen in Echtzeit.</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="https://suite.waldheim.dev" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-yellow-500 text-slate-900 font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-yellow-500/30 transition-all duration-300 hover:scale-[1.02]">
              <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>Zur Demo
            </a>
            <a href="/suite/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-yellow-500/40 transition-all">
              Alle Module ansehen
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
