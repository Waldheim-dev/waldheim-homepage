---
import PromoServices from '../../../components/PromoServices.astro';
import InteractiveHeroCanvas from '../../../components/InteractiveHeroCanvas.astro';
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
  { name: 'Ecodrive', link: 'https://waldheim.dev/suite/ecodrive' },
]);

const titel = 'Ecodrive – Flotte, Einsatz & ESG | Waldheim Suite';
const description =
  'Ecodrive steuert Flotten, Einsätze, CO₂-Daten und ESG-Reporting in einem operativen Modul statt in Fahrtenbüchern und Tabellen. Teil der Waldheim Suite.';
const keywords =
  'Ecodrive, Flottenmanagement, ESG Reporting, CO2 Tracking, Routenplanung, Fahrtenbuch, Waldheim Suite';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ecodrive',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite/ecodrive',
  author: { '@type': 'Organization', name: 'waldheim.dev', url: 'https://waldheim.dev' },
};

const features = [
  {
    icon: 'fa-car-side',
    title: 'Flottenübersicht',
    description: 'Fahrzeuge, Verfügbarkeit, Laufleistung, Leasingstatus und Einsatzkontext in einer operativen Sicht.',
  },
  {
    icon: 'fa-route',
    title: 'Touren & Disposition',
    description: 'Einsätze und Routen für Teams oder Fahrzeuge planen, bündeln und hinsichtlich Aufwand und Distanz optimieren.',
  },
  {
    icon: 'fa-leaf',
    title: 'CO₂-Monitoring',
    description: 'Emissionen pro Fahrzeug, Einsatz, Fahrer oder Zeitraum direkt nachvollziehen statt periodisch schätzen.',
  },
  {
    icon: 'fa-screwdriver-wrench',
    title: 'Wartung & Service',
    description: 'Serviceintervalle, Prüfungen und kritische Fahrzeugzustände werden sichtbar, bevor Verfügbarkeit ausfällt.',
  },
  {
    icon: 'fa-gas-pump',
    title: 'Verbrauch & Kosten',
    description: 'Kraftstoff, Ladezyklen und fahrzeugbezogene Kosten fließen in die operative und finanzielle Bewertung ein.',
  },
  {
    icon: 'fa-clipboard-list',
    title: 'Digitales Fahrtenbuch',
    description: 'Fahrten, Strecken, Zweck und Verbrauch werden sauber dokumentiert und auditierbar abgelegt.',
  },
  {
    icon: 'fa-chart-pie',
    title: 'ESG-Reporting',
    description: 'Berichte für Nachhaltigkeit und Management entstehen direkt aus operativen Daten statt aus manueller Nachpflege.',
  },
  {
    icon: 'fa-bolt',
    title: 'Alarmierung & Automationen',
    description: 'Warnungen für Wartung, Ausfälle oder Emissionsgrenzen lassen sich direkt über Relay und Conductor orchestrieren.',
  },
];

const problems = [
  {
    icon: 'fa-road',
    text: 'Fahrtenbücher, Serviceintervalle und Einsatzplanung werden in separaten Excel-Dateien oder Papierlisten gepflegt. Niemand vertraut den Zahlen wirklich.',
  },
  {
    icon: 'fa-triangle-exclamation',
    text: 'Wartungen und Ausfälle überraschen den Betrieb, weil es keine zentrale Sicht auf Fahrzeugzustand und Verfügbarkeit gibt.',
  },
  {
    icon: 'fa-leaf',
    text: 'CO₂- und ESG-Berichte entstehen manuell im Nachgang. Daten fehlen, Annahmen häufen sich und die Aussagekraft leidet.',
  },
];

const integrations = [
  { icon: 'fa-building-columns', label: 'Silvacore ERP', desc: 'Fahrzeuge und Einsätze können direkt mit Projekten oder Aufträgen verknüpft werden', color: 'green' },
  { icon: 'fa-coins', label: 'Treasury', desc: 'Verbrauch, Betriebskosten und Fuhrparkkosten landen im Finanzkontext', color: 'yellow' },
  { icon: 'fa-tower-broadcast', label: 'Relay', desc: 'Service- und Ausfallwarnungen gehen automatisch an Verantwortliche', color: 'cyan' },
  { icon: 'fa-gears', label: 'Conductor', desc: 'Wartungen, Eskalationen und Reports lassen sich workflowbasiert automatisieren', color: 'indigo' },
];
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[softwareSchema, breadCrumbSchema]}
>
  <nav class="pt-20 px-6 bg-meg-bg-dark" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-meg-text-secondary">
        <li><a href="/suite/" class="hover:text-meg-accent transition-colors font-semibold">Waldheim Suite</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li class="text-emerald-400 font-bold">Ecodrive</li>
      </ol>
    </div>
  </nav>

  <section class="relative isolate pt-6 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden">
    
    <!-- Three.js Interactive WebGL Background -->
    <InteractiveHeroCanvas particleColor="#10b981" lineColor="#06b6d4" />

    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
      <div
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-emerald-500/20 to-teal-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      ></div>
    </div>
    <div class="max-w-7xl mx-auto py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center gsap-fadein">
        <div class="gsap-fadein mb-4">
          <span class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-3 py-1.5 rounded-full text-xs font-bold">
            <i class="fa-solid fa-table-cells-large text-[10px]" aria-hidden="true"></i>
            Teil der Waldheim Suite
          </span>
        </div>
        <div class="gsap-fadein mb-6 flex flex-wrap justify-center gap-2" style="animation-delay: 0.1s">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-sm font-bold text-emerald-400">
            <i class="fa-solid fa-car-side" aria-hidden="true"></i>
            Closed Alpha
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-leaf text-emerald-400" aria-hidden="true"></i>
            ESG-ready
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-screwdriver-wrench text-emerald-400" aria-hidden="true"></i>
            Wartungslogik
          </span>
        </div>
        <h1 class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Flotte steuern.<br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-emerald-400 to-teal-500">Emissionen verstehen.</span>
        </h1>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed" style="animation-delay: 0.3s">
          Ecodrive verbindet Einsatzplanung, Flottenzustand und CO₂-Daten in einem Modul. So wird Mobilität operativ führbar
          und Nachhaltigkeit messbar, statt bloß nachträglich berichtet.
        </p>
        <div class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.45s">
          <a
            href="https://suite.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto group px-8 py-4 bg-emerald-600 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-emerald-500/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            Demo ausprobieren
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a
            href="/suite/"
            class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-emerald-500/40 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Alle Module
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-meg-surface-dark border-b border-meg-border-dark">
    <div class="max-w-5xl mx-auto">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-red-400 mb-8 text-center">
        <i class="fa-solid fa-triangle-exclamation mr-2" aria-hidden="true"></i>
        Der Alltag ohne Ecodrive
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {problems.map((p, i) => (
          <div class="gsap-fadein flex gap-4 bg-red-500/5 border border-red-500/20 rounded-2xl p-5" style={`animation-delay: ${i * 0.1}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <i class={`fa-solid ${p.icon} text-red-400`} aria-hidden="true"></i>
            </div>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="eco-dashboard-heading">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
            <i class="fa-solid fa-gauge-high mr-2" aria-hidden="true"></i>
            Fleet & ESG Dashboard
          </p>
          <h2 id="eco-dashboard-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
            Mobilität in Echtzeit.<br />
            <span class="text-emerald-400">Nicht im Rückspiegel.</span>
          </h2>
          <p class="gsap-fadein text-lg text-meg-text-secondary mb-8 leading-relaxed" style="animation-delay: 0.3s">
            Ecodrive zeigt Verfügbarkeit, Einsätze, Wartungsrisiken und Emissionen auf einem Dashboard.
            Dadurch lässt sich der Betrieb steuern und ESG-Berichtspflicht aus operativen Daten erfüllen.
          </p>
          <ul class="space-y-3">
            {[
              'Verfügbarkeiten und Services auf Fahrzeugniveau live sichtbar',
              'Emissionen und Verbrauch direkt pro Einsatz auswertbar',
              'Eskalationen und Wartungswarnungen laufen automatisiert',
              'Fuhrparkkosten treffen direkt auf Finanz- und Projektkontext',
            ].map((item) => (
              <li class="flex items-center gap-3 text-meg-text-secondary text-sm">
                <i class="fa-solid fa-check text-emerald-400 text-xs" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="gsap-fadein" style="animation-delay: 0.2s">
          <div class="bg-meg-surface-dark/60 border border-emerald-500/20 rounded-3xl p-6 shadow-2xl shadow-emerald-500/5">
            <div class="flex items-center justify-between mb-5">
              <p class="text-sm font-bold text-meg-text-primary-dark">Ecodrive · Flotte</p>
              <span class="text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-circle text-[6px] animate-pulse" aria-hidden="true"></i>Live
              </span>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-5">
              {[
                { label: 'Aktive Fahrzeuge', value: '28', sub: '4 E-Vans, 24 PKW', color: 'emerald' },
                { label: 'CO₂ / Monat', value: '3.4 t', sub: '-11% ggü. Vorjahr', color: 'green' },
                { label: 'Service fällig', value: '5', sub: 'innerhalb 14 Tage', color: 'yellow' },
                { label: 'Tour-Effizienz', value: '91%', sub: '+6% ggü. letzter Woche', color: 'cyan' },
              ].map((k) => (
                <div class={`bg-meg-bg-dark/60 border border-${k.color}-500/10 rounded-xl p-3`}>
                  <p class="text-[10px] text-meg-text-secondary mb-1">{k.label}</p>
                  <p class={`text-xl font-black text-${k.color}-400`}>{k.value}</p>
                  <p class="text-[10px] text-meg-text-secondary opacity-60">{k.sub}</p>
                </div>
              ))}
            </div>
            <div class="space-y-2">
              {[
                { label: 'Servicewarnung: Van 12 in 320 km fällig', time: 'vor 6 Min', color: 'yellow' },
                { label: 'Tour „Region Süd“ um 14% optimiert', time: 'heute', color: 'green' },
                { label: 'Einsatz 348 an Projekt „Nordpark“ gebucht', time: 'heute', color: 'cyan' },
              ].map((entry) => (
                <div class="flex items-center gap-3 text-xs bg-meg-bg-dark/40 rounded-xl px-3 py-2">
                  <i class={`fa-solid fa-circle-dot text-${entry.color}-400`} aria-hidden="true"></i>
                  <span class="text-meg-text-secondary flex-1 truncate">{entry.label}</span>
                  <span class="text-meg-text-secondary opacity-60 shrink-0">{entry.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6 bg-meg-surface-dark border-b border-meg-border-dark" aria-labelledby="eco-features-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
          <i class="fa-solid fa-list-check mr-2" aria-hidden="true"></i>
          Was Ecodrive kann
        </p>
        <h2 id="eco-features-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">
          Flotte und ESG zusammen denken
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {features.map((feat, i) => (
          <div class="gsap-fadein bg-meg-bg-dark/50 border border-meg-border-dark rounded-2xl p-5 hover:border-emerald-500/40 hover:shadow-lg hover:shadow-emerald-500/10 transition-all group" style={`animation-delay: ${i * 0.07}s`}>
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 mb-4 group-hover:bg-emerald-500/20 transition-colors">
              <i class={`fa-solid ${feat.icon} text-emerald-400 text-xl`} aria-hidden="true"></i>
            </div>
            <h3 class="text-base font-bold text-meg-text-primary-dark mb-2">{feat.title}</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="eco-integrations-heading">
    <div class="max-w-5xl mx-auto text-center">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-emerald-400 mb-4">
        <i class="fa-solid fa-plug mr-2" aria-hidden="true"></i>Nahtlos integriert
      </p>
      <h2 id="eco-integrations-heading" class="gsap-fadein text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.1s">
        Einsatzdaten bleiben nicht isoliert.
      </h2>
      <p class="gsap-fadein text-meg-text-secondary mb-12 max-w-2xl mx-auto" style="animation-delay: 0.2s">
        Mobilität, Kosten, Kommunikation und Automationen greifen direkt ineinander statt separat betrieben zu werden.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integrations.map((int, i) => (
          <div class={`gsap-fadein bg-meg-surface-dark/50 border border-${int.color}-500/20 rounded-2xl p-5 text-left`} style={`animation-delay: ${i * 0.1}s`}>
            <div class={`inline-flex items-center justify-center w-10 h-10 rounded-xl bg-${int.color}-500/10 border border-${int.color}-500/20 mb-4`}>
              <i class={`fa-solid ${int.icon} text-${int.color}-400`} aria-hidden="true"></i>
            </div>
            <p class={`font-bold text-sm text-${int.color}-400 mb-1`}>{int.label}</p>
            <p class="text-xs text-meg-text-secondary leading-relaxed">{int.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Custom Consulting & Development Promotion -->
  <PromoServices />

  <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="cta-eco-heading">
    <div class="max-w-4xl mx-auto text-center">
      <div class="gsap-fadein relative group">
        <div class="absolute -inset-0.5 bg-linear-to-r from-emerald-500/20 to-teal-500/20 rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-700" aria-hidden="true"></div>
        <div class="relative bg-meg-surface-dark/60 border border-emerald-500/20 rounded-3xl p-12">
        <i class="fa-solid fa-leaf text-4xl text-emerald-400 mb-6" aria-hidden="true"></i>
        <h2 id="cta-eco-heading" class="text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
          Mobilität messbar steuern
        </h2>
        <p class="text-xl text-meg-text-secondary mb-8 max-w-xl mx-auto">
          Bauen Sie Ihre Flotten- und ESG-Steuerung auf belastbare operative Daten statt auf manuelle Nacharbeit.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://suite.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-emerald-600 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-emerald-500/30 transition-all duration-300 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            Zur Demo
          </a>
          <a href="/suite/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-emerald-500/40 transition-all">
            Alle Module ansehen
          </a>
        </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
