---
import PromoServices from '../../../components/PromoServices.astro';
import InteractiveHeroCanvas from '../../../components/InteractiveHeroCanvas.astro';
import Layout from '../../../layouts/Layout.astro';
import { SchemaUtils } from '../../../utils/schema';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  { name: 'Home', link: 'https://waldheim.dev' },
  { name: 'Waldheim Suite', link: 'https://waldheim.dev/suite' },
  { name: 'Silvacore ERP', link: 'https://waldheim.dev/suite/forge' },
]);

const titel = 'Silvacore ERP – Aufträge, Projekte & Ressourcen | Waldheim Suite';
const description =
  'Silvacore ERP verbindet Aufträge, Projekte, Ressourcen, Beschaffung und Margensteuerung in einem operativen Kernsystem. Teil der Waldheim Suite.';
const keywords =
  'Silvacore ERP, Aufträge, Projekte, Ressourcenplanung, Beschaffung, ERP, Operations, Waldheim Suite';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Silvacore ERP',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: 'https://waldheim.dev/suite/forge',
  author: { '@type': 'Organization', name: 'waldheim.dev', url: 'https://waldheim.dev' },
};

const features = [
  {
    icon: 'fa-file-signature',
    title: 'Auftragssteuerung',
    description: 'Vom gewonnenen Deal bis zur Ausführung laufen Aufträge, Status und Verantwortlichkeiten in einem durchgängigen Prozess.',
  },
  {
    icon: 'fa-diagram-project',
    title: 'Projektplanung',
    description: 'Phasen, Meilensteine, Budgets und Teams zentral verwalten statt in getrennten PM-Tools und Tabellen.',
  },
  {
    icon: 'fa-users-cog',
    title: 'Ressourcen & Auslastung',
    description: 'Kapazitäten, Verfügbarkeiten und Team-Auslastung werden live sichtbar, bevor Engpässe eskalieren.',
  },
  {
    icon: 'fa-cart-flatbed',
    title: 'Beschaffung & Material',
    description: 'Bedarfe, Bestellungen und Lieferstatus an Projekt- oder Auftragskontext binden statt separat nachzuverfolgen.',
  },
  {
    icon: 'fa-wallet',
    title: 'Budget & Marge',
    description: 'Plan- und Ist-Kosten inklusive Deckungsbeitrag auf Projekt- und Auftragsniveau im Blick behalten.',
  },
  {
    icon: 'fa-clipboard-list',
    title: 'Operative Aufgaben',
    description: 'Offene To-dos, Freigaben und Lieferhindernisse direkt am Prozess statt in Chat-Nachrichten.',
  },
  {
    icon: 'fa-chart-column',
    title: 'Operations Dashboard',
    description: 'Laufende Projekte, Auslastung, Termine und Profitabilität in einem Cockpit für Führung und Delivery.',
  },
  {
    icon: 'fa-link',
    title: 'Suite-Übergaben',
    description: 'CRM, Treasury, Aether und Relay hängen direkt an Aufträgen und Projekten statt nur indirekt über Exporte.',
  },
];

const problems = [
  {
    icon: 'fa-table-cells',
    text: 'Aufträge, Ressourcen und Projektstände leben in verschiedenen Tabellen. Niemand sieht zuverlässig, was wirklich in Ausführung ist.',
  },
  {
    icon: 'fa-person-circle-exclamation',
    text: 'Auslastungsprobleme werden zu spät erkannt. Teams sind entweder überplant oder sitzen ohne klar priorisierte Arbeit da.',
  },
  {
    icon: 'fa-money-bill-trend-up',
    text: 'Margen kippen im Projektverlauf, weil Budget, Material und Zeiteinsatz nicht im selben System zusammenlaufen.',
  },
];

const integrations = [
  { icon: 'fa-users-gear', label: 'Socialverse CRM', desc: 'Gewonnene Deals fließen direkt als Aufträge oder Projekte ein', color: 'violet' },
  { icon: 'fa-coins', label: 'Treasury', desc: 'Budget, Kosten und Zahlungsstatus werden finanziell durchgeschleift', color: 'yellow' },
  { icon: 'fa-atom', label: 'Aether', desc: 'Dokumente, Lieferscheine und Projektakten bleiben direkt verknüpft', color: 'rose' },
  { icon: 'fa-tower-broadcast', label: 'Relay', desc: 'Status-Updates und operative Hinweise erreichen Teams und Kunden automatisch', color: 'cyan' },
];
---

<Layout
  title={titel}
  description={description}
  keywords={keywords}
  schema={[softwareSchema, breadCrumbSchema]}
>
  <nav class="pt-20 px-6 bg-meg-bg-dark" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto">
      <ol class="flex items-center gap-2 text-sm text-meg-text-secondary">
        <li><a href="/suite/" class="hover:text-meg-accent transition-colors font-semibold">Waldheim Suite</a></li>
        <li aria-hidden="true"><i class="fa-solid fa-chevron-right text-xs opacity-40"></i></li>
        <li class="text-green-400 font-bold">Silvacore ERP</li>
      </ol>
    </div>
  </nav>

  <section class="relative isolate pt-6 pb-20 px-6 bg-meg-bg-dark border-b border-meg-border-dark overflow-hidden">
    
    <!-- Three.js Interactive WebGL Background -->
    <InteractiveHeroCanvas particleColor="#22c55e" lineColor="#10b981" />

    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl" aria-hidden="true">
      <div
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-green-500/20 to-emerald-500/20 opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75"
        style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
      ></div>
    </div>
    <div class="max-w-7xl mx-auto py-16 sm:py-24">
      <div class="mx-auto max-w-3xl text-center gsap-fadein">
        <div class="gsap-fadein mb-4">
          <span class="inline-flex items-center gap-2 bg-meg-accent/10 border border-meg-accent/20 text-meg-accent px-3 py-1.5 rounded-full text-xs font-bold">
            <i class="fa-solid fa-table-cells-large text-[10px]" aria-hidden="true"></i>
            Teil der Waldheim Suite
          </span>
        </div>
        <div class="gsap-fadein mb-6 flex flex-wrap justify-center gap-2" style="animation-delay: 0.1s">
          <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-500/10 border border-green-500/20 text-sm font-bold text-green-400">
            <i class="fa-solid fa-hammer" aria-hidden="true"></i>
            Closed Alpha
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-users-cog text-green-400" aria-hidden="true"></i>
            Operations Core
          </span>
          <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-meg-surface-dark border border-meg-border-dark text-xs font-semibold text-meg-text-secondary">
            <i class="fa-solid fa-chart-column text-green-400" aria-hidden="true"></i>
            Margen im Blick
          </span>
        </div>
        <h1 class="gsap-fadein text-5xl md:text-7xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
          Aufträge steuern.<br />
          <span class="text-transparent bg-clip-text bg-linear-to-r from-green-400 to-emerald-500">Nicht hinterherlaufen.</span>
        </h1>
        <p class="gsap-fadein text-xl text-meg-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed" style="animation-delay: 0.3s">
          Silvacore ERP ist das operative Rückgrat der Suite: Aufträge, Projekte, Ressourcen und Marge
          laufen in einem System zusammen, statt in Tabellen und Statusmeetings zu verschwinden.
        </p>
        <div class="gsap-fadein flex flex-col sm:flex-row items-center justify-center gap-4" style="animation-delay: 0.45s">
          <a
            href="https://suite.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto group px-8 py-4 bg-green-700 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-green-500/30 transition-all duration-300 inline-flex items-center justify-center gap-2 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            Demo ausprobieren
            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
          </a>
          <a
            href="/suite/"
            class="w-full sm:w-auto px-8 py-4 bg-meg-surface-dark/50 border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-green-500/40 transition-all duration-300 inline-flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
            Alle Module
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 px-6 bg-meg-surface-dark border-b border-meg-border-dark">
    <div class="max-w-5xl mx-auto">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-red-400 mb-8 text-center">
        <i class="fa-solid fa-triangle-exclamation mr-2" aria-hidden="true"></i>
        Der Alltag ohne Silvacore ERP
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {problems.map((p, i) => (
          <div class="gsap-fadein flex gap-4 bg-red-500/5 border border-red-500/20 rounded-2xl p-5" style={`animation-delay: ${i * 0.1}s`}>
            <div class="shrink-0 w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center">
              <i class={`fa-solid ${p.icon} text-red-400`} aria-hidden="true"></i>
            </div>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="forge-dashboard-heading">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-green-400 mb-4">
            <i class="fa-solid fa-gauge-high mr-2" aria-hidden="true"></i>
            Operations Cockpit
          </p>
          <h2 id="forge-dashboard-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark mb-6" style="animation-delay: 0.15s">
            Was läuft gerade?<br />
            <span class="text-green-400">Sie sehen es sofort.</span>
          </h2>
          <p class="gsap-fadein text-lg text-meg-text-secondary mb-8 leading-relaxed" style="animation-delay: 0.3s">
            Das ERP zeigt, welche Aufträge aktiv sind, wo Ressourcen knapp werden und welche Projekte Budget oder Termine riskieren.
            Statt Status einzusammeln, kann Ihr Team operativ handeln.
          </p>
          <ul class="space-y-3">
            {[
              'Auftragsstatus, Projektphase und Ressourcenlage in einem Blick',
              'Budgetabweichungen früh statt am Monatsende erkennen',
              'Gewonnene Deals aus dem CRM direkt operativ übernehmen',
              'Dokumente, Aufgaben und Kommunikation bleiben am Prozess',
            ].map((item) => (
              <li class="flex items-center gap-3 text-meg-text-secondary text-sm">
                <i class="fa-solid fa-check text-green-400 text-xs" aria-hidden="true"></i>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="gsap-fadein" style="animation-delay: 0.2s">
          <div class="bg-meg-surface-dark/60 border border-green-500/20 rounded-3xl p-6 shadow-2xl shadow-green-500/5">
            <div class="flex items-center justify-between mb-5">
              <p class="text-sm font-bold text-meg-text-primary-dark">Silvacore ERP · Operations</p>
              <span class="text-xs bg-green-500/10 text-green-400 border border-green-500/20 px-2 py-1 rounded-lg font-bold flex items-center gap-1.5">
                <i class="fa-solid fa-circle text-[6px] animate-pulse" aria-hidden="true"></i>Live
              </span>
            </div>
            <div class="grid grid-cols-2 gap-3 mb-5">
              {[
                { label: 'Aktive Aufträge', value: '41', sub: '7 kritisch', color: 'green' },
                { label: 'Auslastung', value: '83%', sub: 'kommende 2 Wochen', color: 'emerald' },
                { label: 'Budget at Risk', value: '€ 24k', sub: '3 Projekte', color: 'yellow' },
                { label: 'Deckungsbeitrag', value: '18.4%', sub: '+1.7% ggü. Plan', color: 'cyan' },
              ].map((k) => (
                <div class={`bg-meg-bg-dark/60 border border-${k.color}-500/10 rounded-xl p-3`}>
                  <p class="text-[10px] text-meg-text-secondary mb-1">{k.label}</p>
                  <p class={`text-xl font-black text-${k.color}-400`}>{k.value}</p>
                  <p class="text-[10px] text-meg-text-secondary">{k.sub}</p>
                </div>
              ))}
            </div>
            <div class="space-y-2">
              {[
                { label: 'Projekt „Campus Nord“ überschreitet Materialbudget', time: 'vor 26 Min', color: 'yellow' },
                { label: 'Auftrag ERP-4182 an Team Süd disponiert', time: 'heute', color: 'green' },
                { label: 'Lieferung für Baustufe 2 verzögert', time: 'heute', color: 'red' },
              ].map((entry) => (
                <div class="flex items-center gap-3 text-xs bg-meg-bg-dark/40 rounded-xl px-3 py-2">
                  <i class={`fa-solid fa-circle-dot text-${entry.color}-400`} aria-hidden="true"></i>
                  <span class="text-meg-text-secondary flex-1 truncate">{entry.label}</span>
                  <span class="text-meg-text-secondary shrink-0">{entry.time}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 sm:py-32 px-6 bg-meg-surface-dark border-b border-meg-border-dark" aria-labelledby="forge-features-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-green-400 mb-4">
          <i class="fa-solid fa-list-check mr-2" aria-hidden="true"></i>
          Was Silvacore ERP kann
        </p>
        <h2 id="forge-features-heading" class="gsap-fadein text-4xl md:text-5xl font-black tracking-tighter text-meg-text-primary-dark" style="animation-delay: 0.15s">
          Operative Kontrolle statt Statusblindflug
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {features.map((feat, i) => (
          <div class="gsap-fadein bg-meg-bg-dark/50 border border-meg-border-dark rounded-2xl p-5 hover:border-green-500/40 hover:shadow-lg hover:shadow-green-500/10 transition-all group" style={`animation-delay: ${i * 0.07}s`}>
            <div class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-green-500/10 border border-green-500/20 mb-4 group-hover:bg-green-500/20 transition-colors">
              <i class={`fa-solid ${feat.icon} text-green-400 text-xl`} aria-hidden="true"></i>
            </div>
            <h3 class="text-base font-bold text-meg-text-primary-dark mb-2">{feat.title}</h3>
            <p class="text-meg-text-secondary text-sm leading-relaxed">{feat.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 px-6 bg-meg-bg-dark border-b border-meg-border-dark" aria-labelledby="forge-integrations-heading">
    <div class="max-w-5xl mx-auto text-center">
      <p class="gsap-fadein text-sm font-bold uppercase tracking-widest text-green-400 mb-4">
        <i class="fa-solid fa-plug mr-2" aria-hidden="true"></i>Nahtlos integriert
      </p>
      <h2 id="forge-integrations-heading" class="gsap-fadein text-3xl md:text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4" style="animation-delay: 0.1s">
        Delivery, Finance und Doku im selben Fluss.
      </h2>
      <p class="gsap-fadein text-meg-text-secondary mb-12 max-w-2xl mx-auto" style="animation-delay: 0.2s">
        Das ERP ist nicht nur ein Backoffice-System, sondern der operative Kern zwischen Vertrieb, Finanzen und Ausführung.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integrations.map((int, i) => (
          <div class={`gsap-fadein bg-meg-surface-dark/50 border border-${int.color}-500/20 rounded-2xl p-5 text-left`} style={`animation-delay: ${i * 0.1}s`}>
            <div class={`inline-flex items-center justify-center w-10 h-10 rounded-xl bg-${int.color}-500/10 border border-${int.color}-500/20 mb-4`}>
              <i class={`fa-solid ${int.icon} text-${int.color}-400`} aria-hidden="true"></i>
            </div>
            <p class={`font-bold text-sm text-${int.color}-400 mb-1`}>{int.label}</p>
            <p class="text-xs text-meg-text-secondary leading-relaxed">{int.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Custom Consulting & Development Promotion -->
  <PromoServices />

  <section class="py-24 px-6 bg-meg-bg-dark" aria-labelledby="cta-forge-heading">
    <div class="max-w-4xl mx-auto text-center">
      <div class="gsap-fadein relative group">
        <div class="absolute -inset-0.5 bg-linear-to-r from-green-500/20 to-emerald-500/20 rounded-3xl blur opacity-30 group-hover:opacity-50 transition duration-700" aria-hidden="true"></div>
        <div class="relative bg-meg-surface-dark/60 border border-green-500/20 rounded-3xl p-12">
        <i class="fa-solid fa-hammer text-4xl text-green-400 mb-6" aria-hidden="true"></i>
        <h2 id="cta-forge-heading" class="text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-4">
          Operations planbar machen
        </h2>
        <p class="text-xl text-meg-text-secondary mb-8 max-w-xl mx-auto">
          Geben Sie Ihren Teams ein ERP, das Übergaben reduziert, Marge sichtbar macht und Projekte operativ führbar hält.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="https://suite.waldheim.dev"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-green-700 text-white font-bold text-lg rounded-xl hover:shadow-xl hover:shadow-green-500/30 transition-all duration-300 hover:scale-[1.02]"
          >
            <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i>
            Zur Demo
          </a>
          <a href="/suite/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-meg-bg-dark border border-meg-border-dark text-meg-text-primary-dark font-bold text-lg rounded-xl hover:border-green-500/40 transition-all">
            Alle Module ansehen
          </a>
        </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
