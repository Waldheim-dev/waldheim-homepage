---
import Layout from '../../layouts/Layout.astro';
import { SchemaUtils } from '../../utils/schema';
import ObsidianGeminiHero from '../../components/ObsidianGeminiHero.astro';
import ObsidianGeminiFeatures from '../../components/ObsidianGeminiFeatures.astro';
import ObsidianGeminiTech from '../../components/ObsidianGeminiTech.astro';
import CTAPlain from '../../components/CTAPlain.astro';

const breadCrumbSchema = SchemaUtils.getBreadcrumbSchema([
  {
    name: 'Home',
    link: 'https://waldheim.dev'
  },
  {
    name: 'Obsidian Gemini Agent',
    link: 'https://waldheim.dev/obsidian-gemini-agent'
  }
]);

const titel = 'Gemini AI Agent für Obsidian: Autonomes KI-Plugin | waldheim.dev';
const description =
  'Bringen Sie Google Gemini direkt in Ihren Obsidian Wissens-Workflow. Autonomer Agent mit Function Calling, Kontext-Mentions (#) und Privacy-First Design. Open Source!';
const keywords =
  'Obsidian, Gemini, AI Agent, KI Plugin, Zettelkasten, PKM, Google Gemini, Function Calling, Privacy-First, Open Source, Wissensmanagement';

// Structured Data: Software Application
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Obsidian Gemini AI Agent',
  applicationCategory: 'Utilities',
  operatingSystem: 'Windows, macOS, Linux',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock'
  },
  softwareVersion: '1.0.0',
  description: description,
  url: 'https://waldheim.dev/obsidian-gemini-agent',
  author: {
    '@type': 'Organization',
    name: 'waldheim.dev',
    url: 'https://waldheim.dev'
  },
  sourceCode: {
    '@type': 'CreativeWork',
    url: 'https://github.com/Waldheim-dev/obsidian-gemini-agent',
    license: 'https://opensource.org/licenses/MIT'
  }
};

const ogImage = 'https://waldheim.dev/obsidian-gemini-agent/og-image.jpg';
---

<Layout title={titel} description={description} keywords={keywords} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(breadCrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  <!-- Hero Section -->
  <ObsidianGeminiHero />

  <!-- Features Section -->
  <ObsidianGeminiFeatures />

  <!-- How to Start Section -->
  <section class='py-24 px-6 bg-meg-bg-dark'>
    <div class='mx-auto max-w-7xl'>
      <div class='mx-auto max-w-2xl text-center mb-16'>
        <h2 class='gsap-fadein text-sm font-bold uppercase tracking-widest text-indigo-400 mb-4'>
          Quick Start
        </h2>
        <h3 class='gsap-fadein text-4xl font-black tracking-tighter text-meg-text-primary-dark mb-6'>
          In 3 Schritten zum <span class='text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-violet-500'>Smart Vault</span>
        </h3>
      </div>

      <div class='grid md:grid-cols-3 gap-8'>
        {[
          {
            step: '01',
            title: 'Download',
            description: 'Laden Sie das Plugin über die Obsidian Community Plugins herunter (suchen Sie nach "Gemini AI Agent").',
            icon: 'fa-download'
          },
          {
            step: '02',
            title: 'API-Key holen',
            description: 'Holen Sie sich einen kostenlosen API-Key im Google AI Studio und hinterlegen Sie ihn sicher im Plugin.',
            icon: 'fa-key'
          },
          {
            step: '03',
            title: 'Aktivieren',
            description: 'Aktivieren Sie den ✨ Auto-Modus und erleben Sie eine neue Dimension der Notizverwaltung.',
            icon: 'fa-circle-check'
          }
        ].map((item, index) => (
          <div class='gsap-fadein relative p-8 rounded-2xl bg-meg-surface-dark border border-meg-border-dark group hover:border-indigo-500/30 transition-all' style={`animation-delay: ${index * 0.1}s`}>
            <div class='absolute -top-4 -left-4 size-10 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-black text-lg shadow-lg group-hover:scale-110 transition-transform'>
              {item.step}
            </div>
            <div class='mb-6 mt-2'>
              <i class={`fa-solid ${item.icon} text-indigo-400 text-3xl`} aria-hidden='true'></i>
            </div>
            <h4 class='text-xl font-bold text-meg-text-primary-dark mb-4'>{item.title}</h4>
            <p class='text-meg-text-secondary leading-relaxed'>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technology & Privacy -->
  <ObsidianGeminiTech />

  <!-- Final CTA -->
  <CTAPlain
    title="Bereit für KI-gestütztes Denken?"
    description="Der Gemini AI Agent ist vollständig Open Source und kostenlos verfügbar. Starten Sie noch heute."
    primaryCTA={{
      label: 'GitHub Repository',
      href: 'https://github.com/Waldheim-dev/obsidian-gemini-agent',
      target: '_blank'
    }}
    secondaryCTA={{
      label: 'Case Study & Architektur ansehen',
      href: '/referenzen/waldheim-dev/obsidian-gemini-agent/',
      target: '_self'
    }}
  />
</Layout>
