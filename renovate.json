{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for waldheim.dev homepage with Minor/Patch automerge and AutoRebase",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    ":automergeDigest",
    ":rebaseStalePrs"
  ],
  "enabledManagers": ["npm"],
  "ignorePaths": [".gitlab-ci.yml", ".devcontainer/**"],
  "rebaseWhen": "behind-base-branch",
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": false,
  "ignoreTests": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "labels": ["dependencies", "renovate"],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Group and automerge all minor, patch, pin, and digest npm updates directly to main",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep TypeScript on 6.x until typescript-eslint and @astrojs/check support TS 7+",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Keep pnpm overrides compatible with transitive consumers",
      "matchPackageNames": ["fast-uri"],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "Keep js-yaml override on 4.x for cosmiconfig compatibility",
      "matchPackageNames": ["js-yaml"],
      "allowedVersions": "<5.0.0"
    }
  ]
}
