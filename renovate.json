{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for waldheim.dev homepage with Minor/Patch automerge and AutoRebase",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    ":automergeDigest",
    ":rebaseStalePrs"
  ],
  "enabledManagers": ["npm"],
  "ignorePaths": [".gitlab-ci.yml", ".devcontainer/**"],
  "rebaseWhen": "behind-base-branch",
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": false,
  "ignoreTests": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "labels": ["dependencies", "renovate"],
  "rangeStrategy": "bump",
  "commitBodyTable": true,
  "group": {
    "commitMessageTopic": "{{{groupName}}} ({{#each upgrades}}{{{depName}}} {{{prettyNewVersion}}}{{#unless @last}}, {{/unless}}{{/each}})",
    "commitMessageExtra": ""
  },
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "branch",
    "ignoreTests": true,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Automerge individual minor, patch, pin, and digest npm updates directly to main with fix(deps) commits for changelog visibility",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "semanticCommitType": "fix",
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "List major updates in Dependency Dashboard for manual approval",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "semanticCommitType": "fix",
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Keep TypeScript on 6.x until typescript-eslint and @astrojs/check support TS 7+",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Keep pnpm overrides compatible with transitive consumers",
      "matchPackageNames": ["fast-uri"],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "Keep js-yaml override on 4.x for cosmiconfig compatibility",
      "matchPackageNames": ["js-yaml"],
      "allowedVersions": "<5.0.0"
    },
    {
      "description": "Keep uuid override on 11.x for @lhci/cli compatibility",
      "matchPackageNames": ["uuid"],
      "allowedVersions": "<12.0.0"
    }
  ]
}
