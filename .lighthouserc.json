{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/ecodrive/",
        "http://localhost:4321/silvacore/",
        "http://localhost:4321/socialverse/",
        "http://localhost:4321/services/devsecops/",
        "http://localhost:4321/services/entwicklung/",
        "http://localhost:4321/services/design/",
        "http://localhost:4321/services/it-service/",
        "http://localhost:4321/services/smarthome/",
        "http://localhost:4321/ausgabeschein-generator/",
        "http://localhost:4321/astro-ai-llms-txt/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.75}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.85}],
        "categories:seo": ["error", {"minScore": 0.90}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
